    {"op": "Wait", "line": 112, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Hiro003"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "我瞪大了双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative019"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "在那纯白无垢的房间里，<br>\n一滩血泊扩散开来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative020"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "血泊的鲜红，<br>\n绘成了绚烂的蝴蝶图案。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative021"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "以倒伏在地的白衣少女为中心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative022"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "白衣少女身上正被<br>\n无数只赤红的蝴蝶簇拥着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative023"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "那些玷污纯白的赤色群影，<br>\n酿出无声的寒意，冰冷宣告着生命的终结。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative024"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "已经断气了。<br>\n倒在地上的是本应该袭击了我的人——梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative025"]}},
    {"op": "Gosub", "line": 132, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
