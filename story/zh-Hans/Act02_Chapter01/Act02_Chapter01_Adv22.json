    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "140_3"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_32_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "月代雪——<br>\n【她】，和其他人截然不同。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "她像是一个无法在这个世界上拥有归属的存在。<br>\n仿佛空气凝结成型一般，漂浮在人间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "虚幻得像是一触碰就会烟消云散。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative003"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "她的眼神意味深长。<br>\n她的身影显得无喜无悲。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative004"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "并且——她被这个世界厌弃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative005"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "在某种意义上，“与他人截然不同”即等同于“不正确”。<br>\n或许也正因如此，我才会被她所吸引。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative006"]}},
    {"op": "ResetText", "line": 28, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 29, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 30, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 32, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "400_1"}},
    {"op": "ModifyBackgroundExtended", "line": 33, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 34, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "一旦暴露在人群之中，她就会遭到迫害。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative007"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "所以我们自然就选择了学校天台这个<br>\n避人耳目的地方，作为我们的秘密集合点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative008"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "然后，我对她说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative009"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "我会保护你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Hiro001"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "即使我开口，<br>\n小雪的眼神总是望向某个遥远的地方，<br>\n或是投向另一个朋友。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative010"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "所以我选择了托付。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative011"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "明明已经，选择把她托付给了另一个朋友——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative012"]}},
    {"op": "ModifyBackgroundExtended", "line": 50, "indent": 0, "params": {"TintColor": "#000000", "Duration": 2.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "ResetText", "line": 52, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 54, "indent": 0, "params": {"FadeOutDuration": 1.0}},
    {"op": "Wait", "line": 55, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PlaySfxModified", "line": 58, "indent": 0, "params": {"SfxPath": "Sfx_120", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 59, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PlayBgm", "line": 60, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "啊啊啊啊啊！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Miria001"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "不要啊啊啊啊！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Hanna001"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "呀啊，呜呀啊啊啊啊啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Coco001"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "怎么会这样……！", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Margo001"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "某种物体破碎的声音和少女们的哀嚎声响起，<br>\n打断了旧日时光的梦境。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative013"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "——不知昏迷了多久，<br>\n我的意识开始急速复苏。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative014"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "（到底，发生了什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Hiro002"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "我一边按着疼痛的头部，<br>\n一边用手肘支撑着地面，但无法立即站起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative015"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "醒醒，希罗。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Margo002"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "我虽然视野一片模糊，<br>\n还是在玛格的搀扶下走出了房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative016"]}},
    {"op": "StopBgm", "line": 82, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "模糊的视线逐渐清晰起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative017"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "我为了再次确认房间的状况，<br>\n回头一看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv22_Narrative018"]}},
