    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "（情况仍然对我极为不利）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv25_Hiro003"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "而我也<br>\n依旧心怀对她们的憎恨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv25_Narrative011"]}},
