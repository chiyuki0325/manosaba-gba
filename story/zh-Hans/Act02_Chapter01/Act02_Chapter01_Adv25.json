    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（我一定要把她揪出来）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv25_Hiro005"]}},
