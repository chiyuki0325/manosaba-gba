    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 166, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "真凶进入房间时，<br>\n白色颜料已经干了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,Arms3,Eyes2_Angry_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 170, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "所以才没有留下真凶的脚印……<br>\n难道不是这样吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 174, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "……不，这不对吧……？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 178, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "既然小梅的脚印有留下来，<br>\n凶手作案时颜料不太可能已经干透了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Miria005"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR3,ArmL8,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 182, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "再加上，在房间外面<br>\n也没有发现白色颜料的脚印……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Miria006"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 186, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "所以小梅进来的时候，<br>\n颜料应该还没有干透吧……？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Miria007"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 190, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "而且，发现尸体的时候，<br>\n现场不只有希罗的脚印，<br>\n希罗自己身上也沾到了颜料……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Eyes_Normal_Open02,Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 194, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "毕竟我们赶到现场的时候，<br>\n颜料根本就还没干透。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 198, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "除了你之外，很难想像还有谁会是凶手。<br>\n……至少目前是这样。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Leia006"]}},
    {"op": "Damage", "line": 201, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL9,Eyes2_Normal_Closed1,Mouth2_Angry_Closed1,Sweat2-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 204, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "（看来很多人都确认了<br>\n　颜料没有干）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL9,Eyes2_Normal_Closed1,Mouth2_Angry_Closed1,Sweat2-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 208, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "（的确，看到那样的现场，<br>\n　怀疑我是凶手也是理所当然的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 211, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Angry_Closed1,Sweat1-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 212, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "（……不管是真是假，<br>\n　我得制造些除我之外的嫌疑人才行……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 215, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Angry_Closed1,Sweat1-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 216, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "（回想一下，<br>\n　有一个人可以不踩到地板<br>\n　就进入房间……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 219, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Angry_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 220, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "（看一看魔女图鉴就能马上明白了。<br>\n　如果是她的话——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro010"]}},
    {"op": "GotoModified", "line": 223, "indent": 0, "params": {"Path": ".Judge6-4-1"}},
    {"op": "label", "name": "Judge6-4-4", "line": 226, "indent": 0},
    {"op": "Gosub", "line": 228, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 229, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "Gosub", "line": 230, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 233, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "不一定是在房间里杀的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,Arms3,Eyes2_Angry_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 237, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "凶手可能是在其他地方杀害了梅露露，<br>\n然后把尸体转移到了诺亚的房间。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro012"]}},
    {"op": "ModifyCharacterExtended", "line": 240, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Smile1,ArmR2,ArmL5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 241, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "哎呀，那房间里的血迹<br>\n又该怎么解释呢？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 245, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "现场可是留下了大量的血迹哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 249, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "【梅露露是在房间里遇害的】，<br>\n这么推测才更合理吧～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 253, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "而且，希罗身上<br>\n也沾了很多飞溅的血迹呢。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Noah001"]}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Default,Angle01/Arms>Arms01,Angle01/Option_Arms>Option_Arms01_03,Angle01/Head/Facial/Eyes>Eyes_Neutral_Open,Angle01/Head/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 257, "indent": 0, "params": {"Index": 0, "LookCharacterId": "AnAn", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "『加上地板的颜料，染成了红白两色』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_AnAn002"]}},
    {"op": "ModifyCharacterExtended", "line": 260, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Default,Angle01/Option_Arms-,ArmR-Option-Off,ArmR2,ArmL6,Angle01/Head/Facial/Eyes>Eyes_Normal_Closed,Angle01/Head/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 261, "indent": 0, "params": {"Index": 0, "LookCharacterId": "AnAn", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "……真喜庆。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_AnAn003"]}},
    {"op": "Damage", "line": 264, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR8,ArmL4,Eyes1_Angry_Open1,Mouth1_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 267, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "（红白色搭配<br>\n　并不一定就代表喜庆……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 272, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL9,Eyes2_Normal_Closed1,Mouth2_Angry_Closed1,Sweat2-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 273, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "（的确，看到那样的现场，<br>\n　怀疑我是凶手也是理所当然的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 276, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Angry_Closed1,Sweat1-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 277, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "（……不管是真是假，<br>\n　我得制造些除我之外的嫌疑人才行……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Angry_Closed1,Sweat1-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 281, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "（回想一下，<br>\n　有一个人可以不踩到地板<br>\n　就进入房间……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 284, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Angry_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 285, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "（看一看魔女图鉴就能马上明白了。<br>\n　如果是她的话——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro017"]}},
    {"op": "GotoModified", "line": 289, "indent": 0, "params": {"Path": ".Judge6-4-1"}},
