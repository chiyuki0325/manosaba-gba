    {"op": "ShowUI", "line": 300, "indent": 0, "params": {"UINames": ["ControlPanel"]}},
    {"op": "StopBgm", "line": 302, "indent": 0, "params": {}},
    {"op": "GosubToObjectionCutIn", "line": 303, "indent": 0, "params": {"CutInKind": "Hiro", "Index": 1}},
    {"op": "Gosub", "line": 304, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 306, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR8,ArmL4,Eyes1_Angry_Open1,Mouth1_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 307, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "等一下，<br>\n看来大家都忘记了一件事。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro018"]}},
    {"op": "PlaySfxModified", "line": 311, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 313, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 314, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "欸……！？<br>\n什么意思……！？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Miria008"]}},
    {"op": "ModifyCharacterExtended", "line": 317, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 318, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "聚集在这里的各位，<br>\n都是可以使用魔法的少女……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 321, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,Arms3,Eyes2_Angry_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 322, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "而我们之中……<br>\n不是正好有一个人会用【不留下脚印的魔法】吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro020"]}},
    {"op": "PlaySfxModified", "line": 326, "indent": 0, "params": {"SfxPath": "Sfx_Common_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 328, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR8,ArmL7,Angle01/Facial/Eyes>Eyes_Surprised_Lifeless01,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 329, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "……啊！<br>\n那、那是……！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Miria009"]}},
    {"op": "ModifyCharacterExtended", "line": 332, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Painful_Open1,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 333, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "看来你已经意识到了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro021"]}},
    {"op": "PlaySfxModified", "line": 337, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 339, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR6,Arms3,Eyes1_Angry_Open1,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 340, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "【远野汉娜】——<br>\n就是飘浮魔法的能力者。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 343, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR6,Arms3,Eyes1_Angry_Open1,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 344, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "如果是她的话，应该能轻易闯入房间才对。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro023"]}},
    {"op": "PlaySfxModified", "line": 348, "indent": 0, "params": {"SfxPath": "Sfx_Common_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 350, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default,ArmR1,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Smile_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 351, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 352, "indent": 0, "params": {"Text": "你……你说我吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 354, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 355, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "的确，如果是汉娜的话<br>\n就有可能做到了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Sherry003"]}},
    {"op": "PlaySfxModified", "line": 359, "indent": 0, "params": {"SfxPath": "Sfx_Common_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 363, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Surprised1,ArmR3,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 364, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 365, "indent": 0, "params": {"Text": "……等、等、等、等一下！？<br>\n怎么连你也在乱说！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 367, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR6,ArmL8,Eyes1_Normal_Open3,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 368, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 369, "indent": 0, "params": {"Text": "如果你有异议的话，不妨说来听听。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro024"]}},
    {"op": "PlaySfxModified", "line": 372, "indent": 0, "params": {"SfxPath": "Sfx_Common_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 376, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 377, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left", "ZoomLevel": 3}},
    {"op": "PrintTextModified", "line": 378, "indent": 0, "params": {"Text": "有、有、有异议！<br>\n因、因为我根本做不到啊！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hanna003"]}},
    {"op": "StopBgm", "line": 380, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 383, "indent": 0, "params": {"SfxPath": "Sfx_Common_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 385, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1,ArmR2,ArmL2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 386, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 387, "indent": 0, "params": {"Text": "本小姐可是有完美的不在场证明哦！<br>\n现在就来告诉你们！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 389, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 390, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 391, "indent": 0, "params": {"Text": "（……从她的语气来看，<br>\n　她似乎对自己的不在场证明非常有自信）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro025"]}},
    {"op": "ModifyCharacterExtended", "line": 393, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 394, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 395, "indent": 0, "params": {"Text": "（接下来的证词，恐怕很难被推翻）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro026"]}},
    {"op": "ModifyCharacterExtended", "line": 397, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Angry_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 398, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 399, "indent": 0, "params": {"Text": "（但是……即便如此，<br>\n　也一定还有其他应对的办法才对）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro027"]}},
    {"op": "ModifyCharacterExtended", "line": 401, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR2,ArmL4,Eyes1_Angry_Open1,Mouth1_Normal_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 402, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "（得想办法搅乱讨论……<br>\n　哪怕是再细微的矛盾点，也要揪出来，<br>\n　借此套出更多情报……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro028"]}},
