    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR3,ArmL8,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 31, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 32, "indent": 0, "params": {"Text": "当时大叔我呢，<br>\n是听小蕾的吩咐，<br>\n在案发现场寻找<br>\n遗留下来的痕迹。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0201Trial04_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 35, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 36, "indent": 0, "params": {"Text": "记得她确实<br>\n被使唤得够呛。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0201Trial04_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Default,Angle01/Arms>Arms01,Angle01/Option_Arms>Option_Arms01_01,Angle01/Head/Facial/Eyes>Eyes_Pensive_Open,Angle01/Head/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 39, "indent": 0, "params": {"Index": 0, "LookCharacterId": "AnAn", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 40, "indent": 0, "params": {"Text": "『奴隶吗？』", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0201Trial04_AnAn001"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 43, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 44, "indent": 0, "params": {"Text": "说明当时<br>\n有靠谱的领队<br>\n作出了有效的指示！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0201Trial04_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 47, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 48, "indent": 0, "params": {"Text": "那么，<br>\n调查的结果<br>\n究竟如何呢？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0201Trial04_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 51, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 52, "indent": 0, "params": {"Text": "案发现场的地板<br>\n全部被白色颜料<br>\n覆盖……<br>\n而且，除了小梅和小希的<br>\n脚印之外，<br>\n<link=\"Objection_02_01_04_01\">没有留下其他痕迹</link>。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0201Trial04_Miria002"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 55, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 56, "indent": 0, "params": {"Text": "换句话说，<br>\n除了原本就在<br>\n房间里的小希，<br>\n没有人能轻易<br>\n<link=\"Objection_02_01_04_02\">潜入房间</link>。<br>\n又不是会用<br>\n<link=\"Objection_02_01_04_03\">魔法</link>……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0201Trial04_Miria003"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 59, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 60, "indent": 0, "params": {"Text": "没错……<br>\n所以，<br>\n希罗你<br>\n就是这起案件的<br>\n凶手！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0201Trial04_Leia003"]}},
