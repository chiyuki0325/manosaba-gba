    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "（我要指出这一点，推进讨论）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro003"]}},
