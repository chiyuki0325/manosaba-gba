    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "（不可否认，目前我的确相当可疑）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Angry_Closed1,Sweat1-1"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "（但是……即使真相还不明朗，<br>\n　至少现在有一个推理是错误的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial04_Hiro002"]}},
