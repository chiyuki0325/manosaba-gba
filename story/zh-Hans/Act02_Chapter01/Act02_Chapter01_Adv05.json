    {"op": "ModifyBackgroundExtended", "line": 85, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 86, "indent": 0, "params": {"WaitMode": "1"}},
