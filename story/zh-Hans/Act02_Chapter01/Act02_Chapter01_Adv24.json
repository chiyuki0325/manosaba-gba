    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "21_1"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 23, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "看守把我押送到了<br>\n位于地下层的惩罚室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative001"]}},
    {"op": "HidePrinter", "line": 27, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 30, "indent": 0, "params": {"SfxPath": "Sfx_121", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 31, "indent": 0, "params": {"WaitMode": "1.25"}},
    {"op": "StopSfx", "line": 32, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 33, "indent": 0, "params": {"SfxPath": "Sfx_121", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 34, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "火把的火焰不断摇曳。<br>\n不知从何处传来秒针滴答般的滴水声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative002"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "（3600次。大约就是一个小时吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro001"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro002"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "不论时间过了多久，我的愤怒还是无法平息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative003"]}},
    {"op": "PlaySfxModified", "line": 45, "indent": 0, "params": {"SfxPath": "Sfx_62", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "这时，古老的金属发出了吱呀声。<br>\n沉重的门被小心翼翼地打开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative004"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "门口出现两个人影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "……看来我们可以进去了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia001"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "我想你的衣服可能被颜料弄脏了，<br>\n所以带来了换洗衣物和毛巾。<br>\n出去时用吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia002"]}},
    {"op": "HideAllCharacters", "line": 57, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "希罗，那个，你没事吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema001"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "……谢谢。<br>\n我应该向你们好好表达谢意才对。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro003"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "但是，我看起来像没事的样子吗？<br>\n照这样下去，我只能等着被处刑了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro004"]}},
    {"op": "HideAllCharacters", "line": 66, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR1"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "艾玛也带来了毛巾，<br>\n站在我身边帮我擦拭污渍。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative006"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "这样下去太惨了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema002"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "……来者偏偏是樱羽艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative007"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "但是，如果说有谁会来探望，我想应该就是她了。<br>\n这一点让我心情更加复杂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative008"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "艾玛咬着嘴唇，<br>\n痛苦地低着头，继续帮我擦拭污渍。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative009"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "希罗，为什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema003"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "什么为什么？<br>\n你是想问我为什么杀了梅露露吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "不……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema004"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "但听起来你就是在怀疑我啊？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro006"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "……怎么会……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema005"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Scale": [1.0], "Duration": 1.0, "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "Wait", "line": 96, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "希罗……让你经历这样的事，<br>\n我真的很抱歉。我本想保护你的……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia003"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "……不需要保护。<br>\n在你们眼中，我可能就是凶手。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro007"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "我冷冷地瞪视着两人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative010"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "——当然，在我看来，<br>\n你们也可能是凶手。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "这、这怎么可能！<br>\n我——", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia004"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "只是说有这种可能。<br>\n我只需在审判中证明自己的清白。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro009"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "这个所谓的先行投票真是残酷。<br>\n它在少女们心中种下了分裂的种子。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro010"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "不过，多亏如此，我的决心更加坚定了。<br>\n我会独自生存下去，不依靠任何人。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "我的眼神，想必正闪烁着阴冷的光芒吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative011"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "当然，选择合作也是一种方法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative012"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "若解释事件前后的情况，<br>\n或许能获得推理的线索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative013"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "但在不知谁是真凶的情况下，<br>\n这反而可能给凶手提供消息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative014"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "（凶手无疑正试图陷害我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro012"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "（那么，这两个主动接近我的人，<br>\n　很可能就是凶手）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro013"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "（善意是敌人。牵绊是毒药。<br>\n　我再也不会被这些东西绊倒了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro014"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "希、希罗。别把自己孤立起来！<br>\n如果大家一起合作的话，一定能——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema006"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "合作？<br>\n这就是合作的结果。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro015"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "我感到头晕目眩。<br>\n我无法接受艾玛口中那些漂亮话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative015"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "艾玛，我最不相信的就是你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro016"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "希罗……为什么？<br>\n求你了，请听我解释——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema007"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "闭嘴！！<br>\n我不想看到你的脸，也不想听到你的声音！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro017"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "如果你还有一丝在乎我的心，<br>\n就给我滚出去！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "ModifyCamera", "line": 149, "indent": 0, "params": {"Offset": [0.0, 3.5], "Zoom": 0.6000000238418579, "EasingTypeName": "SmoothStep", "Duration": 0.10000000149011612, "Lazy": 0}},
    {"op": "Wait", "line": 150, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "——到此为止！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia005"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "蕾雅一声高喊，<br>\n盖过了我的怒吼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative016"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "什么……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro019"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "一种不可思议的现象，让我不由得屏住了呼吸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative017"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "我被声音吸引，将视线落在了蕾雅身上，<br>\n发现自己无法将目光从她脸上移开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "……吓到你了吧。这就是我的魔法。<br>\n我可以【引导视线】。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "人们常说，<br>\n不知为何无法将目光从舞台上的我身上移开呢。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia007"]}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "我想让你稍微信任我一点。<br>\n所以我想，不妨把我的魔法揭露给你看。<br>", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia008"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "蕾雅温柔地笑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative019"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "……能解除吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro020"]}},
    {"op": "ModifyCamera", "line": 178, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.4000000059604645, "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "我刚提出要求，视线就恢复了自由。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative020"]}},
    {"op": "UpdateWitchBook", "line": 183, "indent": 0, "params": {"Id": "Leia", "Category": "Profile", "Version": 4}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "看来你们之间<br>\n曾经发生过什么事呢。<br>\n能和我说说吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia009"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "……我拒绝。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "……我明白了。<br>\n现在，还是让你静一静比较好。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Leia010"]}},
    {"op": "HideAllCharacters", "line": 195, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "蕾雅说完，就劝艾玛一起离开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative021"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "艾玛似乎被我的激烈的态度吓到，<br>\n在蕾雅的催促下拖着沉重的脚步离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "希罗……待会见……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Ema008"]}},
    {"op": "HideAllCharacters", "line": 205, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 208, "indent": 0, "params": {"SfxPath": "Sfx_62", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "随后门被关上，再次恢复了寂静。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative023"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "（……这是最糟糕的情况……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro022"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "（但我真的能说，<br>\n　人不是我杀的吗……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro023"]}},
    {"op": "ResetText", "line": 216, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 217, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 218, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 220, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "10_1"}},
    {"op": "ModifyBackgroundExtended", "line": 222, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 223, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "紧接着，脑海中闪过<br>\n自己失控的样子——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative024"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "（说不定是我失去理智，把梅露露给……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro024"]}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "（反正这样下去都要被处刑了，<br>\n　还不如死掉重来……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro025"]}},
    {"op": "ResetText", "line": 231, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 232, "indent": 0, "params": {"Duration": 0.30000001192092896, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 233, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "HideActors", "line": 235, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 237, "indent": 0, "params": {"Duration": 0.30000001192092896, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 238, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "下一个瞬间，我又清醒了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative025"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "（自杀……？我吗……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro026"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "一种让我不寒而栗的<br>\n嫌恶感传遍全身。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Narrative026"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "（我在想什么啊。<br>\n　无论如何，绝对不可以【自杀】）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro027"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "（我绝对不会用这种<br>\n　夺走了朋友生命的禁忌方式！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro028"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "（我没有杀害梅露露。<br>\n　我没有——！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv24_Hiro029"]}},
    {"op": "Gosub", "line": 252, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
