  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-8", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我们来到监牢二楼的图书室，<br>\n发现雪莉、汉娜和艾玛正待在阅读区。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "诺亚被图书室中央的大树吸引住了，<br>\n开始构思要画些什么，<br>\n于是我独自走向雪莉她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "你们在做什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "Wait", "line": 29, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "纪律委员大驾光临了哇……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "我可不是什么纪律委员。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "每天巡视好几次我们的房间，<br>\n不是纪律委员是什么啊……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna002"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "啊，希罗！我们今天<br>\n正在调查图书室的各种书籍呢！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "嗯，想着也许能更了解一些<br>\n这座监牢的情况。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "但都是些看不懂的书，<br>\n正头疼着呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Ema002"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "如果能掌握规律的话，<br>\n或许就能大致解读了～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry002"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "（我也大致浏览了一下图书室的书，<br>\n　确实都是些看不懂的东西……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro003"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "啊，对了对了。<br>\n希罗，请看这个！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry003"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "雪莉指着桌上的一本厚书。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 60, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "那是一本装帧华丽、看起来就有什么特殊内情的书。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "这本书似乎记载了<br>\n有关魔女和魔法的内容。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry004"]}},
    {"op": "Wait", "line": 72, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "StopBgm", "line": 74, "indent": 0, "params": {"FadeOutDuration": 1.0}},
    {"op": "PlaySfxModified", "line": 77, "indent": 0, "params": {"SfxPath": "Sfx_43", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 79, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "我也注意到了翻开的那一页。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative005"]}},
    {"op": "ResetText", "line": 83, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 84, "indent": 0, "params": {"BgmPath": "Bgm_36_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 86, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "510_1"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "用独特文字写就的如此厚重的书籍……<br>\n看来并不只是装饰品那么简单。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro004"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "看来监牢的运营方似乎拥有与我们不同的<br>\n文化和历史。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro005"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "（恐怕是魔女……相关的东西吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro006"]}},
    {"op": "ModifyBackgroundExtended", "line": 94, "indent": 0, "params": {"Id": "Stills", "Scale": [2.0], "Duration": 0.30000001192092896, "Lazy": 0, "ScenePosition": [80.0, 30.0], "AppearanceAndTransition": "510_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "……我很在意这幅画。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro007"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "我指着的这幅画上，<br>\n众多魔女手牵手围在一起，<br>\n一名威严十足的魔女正在降临。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative006"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "这画的不是【魔女安息仪式】吗？<br>\n就是魔女召唤大魔女的仪式之类的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry005"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "……原来如此？<br>\n虽然不太了解，但确实在一般的传说中，<br>\n魔女似乎也有首领。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro008"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "对魔女来说【大魔女】是<br>\n不可或缺的存在……对，也就是说！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry006"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "也就是说……！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry007"]}},
    {"op": "HideActors", "line": 108, "indent": 0, "params": {"ActorIds": ["Stills", "Stills-Middle"], "Lazy": 0}},
    {"op": "Wait", "line": 109, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR3,ArmL3"}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "雪莉竖起食指，正要说些什么，<br>\n却静止了一会，发出嗯～～的声音陷入苦思。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1,ArmR3,ArmL3"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "嗯～！如果能解读出文字的话，<br>\n就能知道里面写了什么详细内容了～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry008"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "虽然轻率推理很危险……<br>\n但如果按照这本书来考虑的话<br>\n运营方可能也是魔女一方。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro009"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "典狱长之前说到一半停下了：<br>\n“只要找到大魔女，诅咒就能……”什么的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro010"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "那么，这个荒唐的游戏<br>\n很可能是魔女一方为了召唤大魔女而举行的仪式。<br>", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "EmoteJumpDouble", "line": 126, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "Wait", "line": 127, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "啊～！就是这个～！<br>\n我也想说这个来着！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry009"]}},
    {"op": "AnimateActorExtended", "line": 131, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "ScenePositionX": "50", "ScenePositionY": "50"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "希罗真不赖啊～！<br>\n说不定我们能组成名侦探搭档什么的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry010"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "我还是免了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro012"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "雪莉亲昵地贴近，<br>\n但我并不讨厌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative008"]}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "不过，即便如此……<br>\n为何我们非得被绑架到这里来呢？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna003"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "一直在读另一本书的汉娜<br>\n烦躁地开口道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "关于这点我也有几个假设。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro013"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "想要召唤大魔女的运营方，<br>\n特意聚集了这么多预备魔女的理由……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro014"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "我竖起食指，<br>\n吸引雪莉和汉娜的注意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative010"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "第一种假设，召唤大魔女需要少女死亡。<br>\n很简单——就是所谓的祭品。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro015"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "太糟糕了哇……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna004"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "无视汉娜寒毛耸立的样子，<br>\n我平静地竖起第二根手指。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative011"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "第二种……这可能有点跳跃。<br>\n目的并不是杀害少女。<br>\n而是让少女们聚在一起。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "比如说，如果她们是为了召唤大魔女<br>\n而【正在寻找某种魔法】呢？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "请稍等。<br>\n第二种可能性，当真存在吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna005"]}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "若只是想了解魔法的话<br>\n没必要大费周章<br>\n将我们囚禁在这种地方吧……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "规则手册不是写着吗。<br>\n随着魔女化程度加深，魔法会进化。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro018"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "就目前看来，每个人的魔法都不一样。<br>\n魔法会进化成什么样，运营方肯定也不知道。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro019"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "如果我们的魔法进化后<br>\n出现了运营方想要的魔法呢？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro020"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "这座监牢就是<br>\n促进我们尽快魔女化的养殖场……<br>\n这样考虑的话，有些地方就说得通了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro021"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "嗯……关于魔法和魔女还有很多不明之处<br>\n所以无法断定，但也不能否定呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Sherry011"]}},
    {"op": "HideAllCharacters", "line": 189, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "汉娜似乎无言以对，<br>\n有些愕然地看着我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "……希罗。<br>\n你是什么时候想到这些的？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna007"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "关于召唤大魔女的仪式我刚刚才知道。<br>\n当然是刚刚才想到的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "真、真不想和你敌对呢……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hanna008"]}},
    {"op": "HideAllCharacters", "line": 204, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "StopBgm", "line": 207, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "……是啊。<br>\n希罗很厉害的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Ema003"]}},
    {"op": "HideAllCharacters", "line": 211, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "一直沉默的艾玛开口了。<br>\n我看向艾玛……又移开了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 215, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "我也不想和你们敌对。<br>\n我该走了。时间有限——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro023"]}},
    {"op": "HideAllCharacters", "line": 219, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "我向她们告别，<br>\n朝着大树前的诺亚走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 223, "indent": 0, "params": {"Scale": [0.10000000149011612], "Lazy": 0, "ScenePosition": [53.0], "IdAndAppearance": "Noah"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "诺亚举着喷漆，<br>\n似乎想给大树上色。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative015"]}},
    {"op": "Wait", "line": 227, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 228, "indent": 0, "params": {"Scale": [3.5], "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "12_1", "SubId": "Middle"}},
    {"op": "PlayBgm", "line": 229, "indent": 0, "params": {"BgmPath": "Bgm_34_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 230, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "——喂，诺亚，你想干什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro024"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "啊，希罗。<br>\n嘿嘿，那个啊，我在想如果把这棵树涂得五颜六色<br>\n一定会超级棒的。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Noah001"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "大家肯定会很高兴的～！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Noah002"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "驳回。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro025"]}},
    {"op": "ModifyCharacterExtended", "line": 245, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "欸～不行吗～？明明一定会变得很漂亮的～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Noah003"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "……快走吧。<br>\n在图书室要保持安静。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro026"]}},
    {"op": "HideAllCharacters", "line": 251, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "我半拖着依依不舍的诺亚<br>\n离开了图书室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative016"]}},
    {"op": "ResetText", "line": 255, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 256, "indent": 0, "params": {"FadeOutDuration": 1.2000000476837158}},
    {"op": "ModifyBackgroundExtended", "line": 258, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 259, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "（魔法会变强……吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro027"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "（也许，强大得超乎想象的魔法<br>\n　会在我们之中诞生……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Hiro028"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "一丝微弱的骚动，悄然在我心中萌生。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv13_Narrative017"]}},
    {"op": "Gosub", "line": 272, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 274, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv12", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv13_Narrative001": "我们来到监牢二楼的图书室，<br>\n发现雪莉、汉娜和艾玛正待在阅读区。",
  "0201Adv13_Narrative002": "诺亚被图书室中央的大树吸引住了，<br>\n开始构思要画些什么，<br>\n于是我独自走向雪莉她们。",
  "0201Adv13_Hiro001": "你们在做什么？",
  "0201Adv13_Hanna001": "纪律委员大驾光临了哇……",
  "0201Adv13_Hiro002": "我可不是什么纪律委员。",
  "0201Adv13_Hanna002": "每天巡视好几次我们的房间，<br>\n不是纪律委员是什么啊……",
  "0201Adv13_Sherry001": "啊，希罗！我们今天<br>\n正在调查图书室的各种书籍呢！",
  "0201Adv13_Ema001": "嗯，想着也许能更了解一些<br>\n这座监牢的情况。",
  "0201Adv13_Ema002": "但都是些看不懂的书，<br>\n正头疼着呢。",
  "0201Adv13_Sherry002": "如果能掌握规律的话，<br>\n或许就能大致解读了～",
  "0201Adv13_Hiro003": "（我也大致浏览了一下图书室的书，<br>\n　确实都是些看不懂的东西……）",
  "0201Adv13_Sherry003": "啊，对了对了。<br>\n希罗，请看这个！",
  "0201Adv13_Narrative003": "雪莉指着桌上的一本厚书。",
  "0201Adv13_Narrative004": "那是一本装帧华丽、看起来就有什么特殊内情的书。",
  "0201Adv13_Sherry004": "这本书似乎记载了<br>\n有关魔女和魔法的内容。",
  "0201Adv13_Narrative005": "我也注意到了翻开的那一页。",
  "0201Adv13_Hiro004": "用独特文字写就的如此厚重的书籍……<br>\n看来并不只是装饰品那么简单。",
  "0201Adv13_Hiro005": "看来监牢的运营方似乎拥有与我们不同的<br>\n文化和历史。",
  "0201Adv13_Hiro006": "（恐怕是魔女……相关的东西吧）",
  "0201Adv13_Hiro007": "……我很在意这幅画。",
  "0201Adv13_Narrative006": "我指着的这幅画上，<br>\n众多魔女手牵手围在一起，<br>\n一名威严十足的魔女正在降临。",
  "0201Adv13_Sherry005": "这画的不是【魔女安息仪式】吗？<br>\n就是魔女召唤大魔女的仪式之类的。",
  "0201Adv13_Hiro008": "……原来如此？<br>\n虽然不太了解，但确实在一般的传说中，<br>\n魔女似乎也有首领。",
  "0201Adv13_Sherry006": "对魔女来说【大魔女】是<br>\n不可或缺的存在……对，也就是说！",
  "0201Adv13_Sherry007": "也就是说……！",
  "0201Adv13_Narrative007": "雪莉竖起食指，正要说些什么，<br>\n却静止了一会，发出嗯～～的声音陷入苦思。",
  "0201Adv13_Sherry008": "嗯～！如果能解读出文字的话，<br>\n就能知道里面写了什么详细内容了～",
  "0201Adv13_Hiro009": "虽然轻率推理很危险……<br>\n但如果按照这本书来考虑的话<br>\n运营方可能也是魔女一方。",
  "0201Adv13_Hiro010": "典狱长之前说到一半停下了：<br>\n“只要找到大魔女，诅咒就能……”什么的。",
  "0201Adv13_Hiro011": "那么，这个荒唐的游戏<br>\n很可能是魔女一方为了召唤大魔女而举行的仪式。<br>",
  "0201Adv13_Sherry009": "啊～！就是这个～！<br>\n我也想说这个来着！",
  "0201Adv13_Sherry010": "希罗真不赖啊～！<br>\n说不定我们能组成名侦探搭档什么的！",
  "0201Adv13_Hiro012": "我还是免了。",
  "0201Adv13_Narrative008": "雪莉亲昵地贴近，<br>\n但我并不讨厌。",
  "0201Adv13_Hanna003": "不过，即便如此……<br>\n为何我们非得被绑架到这里来呢？",
  "0201Adv13_Narrative009": "一直在读另一本书的汉娜<br>\n烦躁地开口道。",
  "0201Adv13_Hiro013": "关于这点我也有几个假设。",
  "0201Adv13_Hiro014": "想要召唤大魔女的运营方，<br>\n特意聚集了这么多预备魔女的理由……",
  "0201Adv13_Narrative010": "我竖起食指，<br>\n吸引雪莉和汉娜的注意。",
  "0201Adv13_Hiro015": "第一种假设，召唤大魔女需要少女死亡。<br>\n很简单——就是所谓的祭品。",
  "0201Adv13_Hanna004": "太糟糕了哇……",
  "0201Adv13_Narrative011": "无视汉娜寒毛耸立的样子，<br>\n我平静地竖起第二根手指。",
  "0201Adv13_Hiro016": "第二种……这可能有点跳跃。<br>\n目的并不是杀害少女。<br>\n而是让少女们聚在一起。",
  "0201Adv13_Hiro017": "比如说，如果她们是为了召唤大魔女<br>\n而【正在寻找某种魔法】呢？",
  "0201Adv13_Hanna005": "请稍等。<br>\n第二种可能性，当真存在吗？",
  "0201Adv13_Hanna006": "若只是想了解魔法的话<br>\n没必要大费周章<br>\n将我们囚禁在这种地方吧……！",
  "0201Adv13_Hiro018": "规则手册不是写着吗。<br>\n随着魔女化程度加深，魔法会进化。",
  "0201Adv13_Hiro019": "就目前看来，每个人的魔法都不一样。<br>\n魔法会进化成什么样，运营方肯定也不知道。",
  "0201Adv13_Hiro020": "如果我们的魔法进化后<br>\n出现了运营方想要的魔法呢？",
  "0201Adv13_Hiro021": "这座监牢就是<br>\n促进我们尽快魔女化的养殖场……<br>\n这样考虑的话，有些地方就说得通了。",
  "0201Adv13_Sherry011": "嗯……关于魔法和魔女还有很多不明之处<br>\n所以无法断定，但也不能否定呢。",
  "0201Adv13_Narrative012": "汉娜似乎无言以对，<br>\n有些愕然地看着我。",
  "0201Adv13_Hanna007": "……希罗。<br>\n你是什么时候想到这些的？",
  "0201Adv13_Hiro022": "关于召唤大魔女的仪式我刚刚才知道。<br>\n当然是刚刚才想到的。",
  "0201Adv13_Hanna008": "真、真不想和你敌对呢……",
  "0201Adv13_Ema003": "……是啊。<br>\n希罗很厉害的。",
  "0201Adv13_Narrative013": "一直沉默的艾玛开口了。<br>\n我看向艾玛……又移开了视线。",
  "0201Adv13_Hiro023": "我也不想和你们敌对。<br>\n我该走了。时间有限——",
  "0201Adv13_Narrative014": "我向她们告别，<br>\n朝着大树前的诺亚走去。",
  "0201Adv13_Narrative015": "诺亚举着喷漆，<br>\n似乎想给大树上色。",
  "0201Adv13_Hiro024": "——喂，诺亚，你想干什么？",
  "0201Adv13_Noah001": "啊，希罗。<br>\n嘿嘿，那个啊，我在想如果把这棵树涂得五颜六色<br>\n一定会超级棒的。",
  "0201Adv13_Noah002": "大家肯定会很高兴的～！",
  "0201Adv13_Hiro025": "驳回。",
  "0201Adv13_Noah003": "欸～不行吗～？明明一定会变得很漂亮的～",
  "0201Adv13_Hiro026": "……快走吧。<br>\n在图书室要保持安静。",
  "0201Adv13_Narrative016": "我半拖着依依不舍的诺亚<br>\n离开了图书室。",
  "0201Adv13_Hiro027": "（魔法会变强……吗）",
  "0201Adv13_Hiro028": "（也许，强大得超乎想象的魔法<br>\n　会在我们之中诞生……）",
  "0201Adv13_Narrative017": "一丝微弱的骚动，悄然在我心中萌生。"
}
}
