    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "在会客厅听完典狱长的讲话后……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "我们按照规定，<br>\n回到了分配有各自囚犯编号的，位于地下的房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "为什么会变成这样……<br>\n完全搞不懂啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Ema001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "与我同室的艾玛坐在床上，<br>\n脸色苍白，垂头丧气的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative003"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "魔女，是什么啊……？<br>\n我们到底会怎么样……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Ema002"]}},
    {"op": "HideAllCharacters", "line": 28, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我用余光瞥了艾玛一眼，<br>\n随即又回到自己的事情上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative004"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "我坐在房间里的椅子上，<br>\n用手机确认【魔女图鉴】的内容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative005"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "刚才只是粗略地看了一遍，<br>\n我打算再次仔细了解一下这里的规则。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative006"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "我将各种信息牢记于心。<br>\n最让我在意的是关于【魔女化】的内容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative007"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "（我们会因为受到精神压力而加深魔女化程度……<br>\n　仅此而已，没有更多详情了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro001"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（不管怎么样，我已经成功压抑住了冲动，<br>\n　接下来只能避免在生活中积攒压力了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "希罗很冷静呢。<br>\n真厉害啊。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "——没什么厉害的。<br>\n还有，别跟我说话。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "……对不起。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Ema004"]}},
    {"op": "HideAllCharacters", "line": 54, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "我努力不去看艾玛，<br>\n在胸前紧紧握拳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative008"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "（在此之外，对我更不利的是<br>\n　和艾玛长期同处一室的这种环境）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro004"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "（这必定会给我带来压力。<br>\n　也许需要想些办法）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro005"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "（总之，到了放风时间<br>\n　尽量出去走走会比较好）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro006"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "我叹了口气，<br>\n从口袋里掏出刚才发现的另一样东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative009"]}},
    {"op": "SpawnExtended", "line": 69, "indent": 0, "params": {"Path": "Clue", "Params": ["10-1"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "这是我初中时常用的，<br>\n本应送给【她】了的钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative010"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "（为什么它会出现在这里……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro007"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "虽然想不通原因，<br>\n但我正好需要一支笔，倒也算是件好事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative011"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "为了整理思绪，<br>\n我习惯每天写日记。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative012"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "幸运的是，这个房间里有一个<br>\n可以用来写字的小本子，<br>\n我决定从今天开始把它当作我的日记本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative013"]}},
    {"op": "DestroySpawnedExtended", "line": 81, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 82, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 85, "indent": 0, "params": {"SfxPath": "Sfx_111", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "首先，我记下了今天发生的事情。<br>\n随着书写的动作，我的头脑逐渐清晰起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "欸？这个不是希罗以前用的……？<br>", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Ema005"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "艾玛注意到了我的动作，<br>\n不由自主地开口问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative015"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "——啧。我不禁咂舌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "不知怎么就在口袋里了。<br>\n你那边没有什么东西吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "呃，我这边倒是没什么特别的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Ema006"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "艾玛慌张地翻找着自己的口袋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative017"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（为什么偏偏是这支钢笔……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro009"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我握紧钢笔，想着不如折断它了事，<br>\n但……我还是没能下手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Hiro010"]}},
    {"op": "HideAllCharacters", "line": 115, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "我强迫自己摆脱感伤，继续集中精神写日记。<br>\n面无表情地，只是机械地移动着笔尖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative019"]}},
    {"op": "PlaySfxModified", "line": 120, "indent": 0, "params": {"SfxPath": "Sfx_111", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "——监狱生活第二轮，第一天。<br>\n成功回避了死亡，我还活着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative020"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "——但看样子，<br>\n我的魔女化程度似乎正在加深。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative021"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "——只要避免积攒压力，平静生活下去，<br>\n应该就不会变得冲动吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative022"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "——魔女化是不是只会逐渐加深？<br>\n没有什么预防的办法吗？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative023"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "——留给我的时限到底还有多少……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative024"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "——为了不堕为魔女，<br>\n我必须更深入了解这座监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv06_Narrative025"]}},
    {"op": "Gosub", "line": 134, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 136, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv07", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv06_Narrative001": "在会客厅听完典狱长的讲话后……",
  "0201Adv06_Narrative002": "我们按照规定，<br>\n回到了分配有各自囚犯编号的，位于地下的房间。",
  "0201Adv06_Ema001": "为什么会变成这样……<br>\n完全搞不懂啊……",
  "0201Adv06_Narrative003": "与我同室的艾玛坐在床上，<br>\n脸色苍白，垂头丧气的样子。",
  "0201Adv06_Ema002": "魔女，是什么啊……？<br>\n我们到底会怎么样……",
  "0201Adv06_Narrative004": "我用余光瞥了艾玛一眼，<br>\n随即又回到自己的事情上。",
  "0201Adv06_Narrative005": "我坐在房间里的椅子上，<br>\n用手机确认【魔女图鉴】的内容。",
  "0201Adv06_Narrative006": "刚才只是粗略地看了一遍，<br>\n我打算再次仔细了解一下这里的规则。",
  "0201Adv06_Narrative007": "我将各种信息牢记于心。<br>\n最让我在意的是关于【魔女化】的内容。",
  "0201Adv06_Hiro001": "（我们会因为受到精神压力而加深魔女化程度……<br>\n　仅此而已，没有更多详情了）",
  "0201Adv06_Hiro002": "（不管怎么样，我已经成功压抑住了冲动，<br>\n　接下来只能避免在生活中积攒压力了）",
  "0201Adv06_Ema003": "希罗很冷静呢。<br>\n真厉害啊。",
  "0201Adv06_Hiro003": "——没什么厉害的。<br>\n还有，别跟我说话。",
  "0201Adv06_Ema004": "……对不起。",
  "0201Adv06_Narrative008": "我努力不去看艾玛，<br>\n在胸前紧紧握拳。",
  "0201Adv06_Hiro004": "（在此之外，对我更不利的是<br>\n　和艾玛长期同处一室的这种环境）",
  "0201Adv06_Hiro005": "（这必定会给我带来压力。<br>\n　也许需要想些办法）",
  "0201Adv06_Hiro006": "（总之，到了放风时间<br>\n　尽量出去走走会比较好）",
  "0201Adv06_Narrative009": "我叹了口气，<br>\n从口袋里掏出刚才发现的另一样东西。",
  "0201Adv06_Narrative010": "这是我初中时常用的，<br>\n本应送给【她】了的钢笔。",
  "0201Adv06_Hiro007": "（为什么它会出现在这里……？）",
  "0201Adv06_Narrative011": "虽然想不通原因，<br>\n但我正好需要一支笔，倒也算是件好事。",
  "0201Adv06_Narrative012": "为了整理思绪，<br>\n我习惯每天写日记。",
  "0201Adv06_Narrative013": "幸运的是，这个房间里有一个<br>\n可以用来写字的小本子，<br>\n我决定从今天开始把它当作我的日记本。",
  "0201Adv06_Narrative014": "首先，我记下了今天发生的事情。<br>\n随着书写的动作，我的头脑逐渐清晰起来。",
  "0201Adv06_Ema005": "欸？这个不是希罗以前用的……？<br>",
  "0201Adv06_Narrative015": "艾玛注意到了我的动作，<br>\n不由自主地开口问道。",
  "0201Adv06_Narrative016": "——啧。我不禁咂舌。",
  "0201Adv06_Hiro008": "不知怎么就在口袋里了。<br>\n你那边没有什么东西吗？",
  "0201Adv06_Ema006": "呃，我这边倒是没什么特别的……",
  "0201Adv06_Narrative017": "艾玛慌张地翻找着自己的口袋。",
  "0201Adv06_Hiro009": "（为什么偏偏是这支钢笔……）",
  "0201Adv06_Narrative018": "我握紧钢笔，想着不如折断它了事，<br>\n但……我还是没能下手。",
  "0201Adv06_Hiro010": "…………",
  "0201Adv06_Narrative019": "我强迫自己摆脱感伤，继续集中精神写日记。<br>\n面无表情地，只是机械地移动着笔尖。",
  "0201Adv06_Narrative020": "——监狱生活第二轮，第一天。<br>\n成功回避了死亡，我还活着。",
  "0201Adv06_Narrative021": "——但看样子，<br>\n我的魔女化程度似乎正在加深。",
  "0201Adv06_Narrative022": "——只要避免积攒压力，平静生活下去，<br>\n应该就不会变得冲动吧。",
  "0201Adv06_Narrative023": "——魔女化是不是只会逐渐加深？<br>\n没有什么预防的办法吗？",
  "0201Adv06_Narrative024": "——留给我的时限到底还有多少……",
  "0201Adv06_Narrative025": "——为了不堕为魔女，<br>\n我必须更深入了解这座监牢。"
}
}
