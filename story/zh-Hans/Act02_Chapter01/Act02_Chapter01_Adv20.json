    {"op": "label", "name": "Scene2-1-15", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "又过了一天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "日子平静地过去，<br>\n除了监牢的卫生环境不佳外，<br>\n没有发生什么麻烦事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "（……好，就祈祷一切都按照正规进行，平安无事吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "我从简陋的床上起身，<br>\n揉了揉眼睛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative003"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（不知为何，我内心的不安感<br>\n　似乎在逐渐增强）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（也许在这种地方过着平安无事的日子，<br>\n　反而才是异常……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro003"]}},
    {"op": "HideAllCharacters", "line": 28, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "啊，希、希罗，早上好。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Ema001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "早上好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro004"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "艾玛似乎已经起床了，<br>\n我冷淡地回应了她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "回应别人的问候是一种礼貌，我才不得不回应。<br>\n所以我的压力之源，正是同室的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative005"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "我这么想着，片刻后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative006"]}},
    {"op": "StopBgm", "line": 43, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "呜哇啊啊啊！！！！", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Unknown001"]}},
    {"op": "PlayBgm", "line": 49, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 51, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "听到这声尖叫，<br>\n我立刻从床上跳了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "！？这声音是！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "不，不知道！<br>\n我们之中有谁是这种音色吗……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "在我们中几乎没有发出过声音的少女，<br>\n那就只有——她了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro006"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "总之就在隔壁。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro007"]}},
    {"op": "HideAllCharacters", "line": 69, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "我们跑向了<br>\n夏目安安和城崎诺亚的房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative008"]}},
    {"op": "ResetText", "line": 73, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 74, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 75, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 77, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 78, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 79, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "到达现场的有我、艾玛，<br>\n还有莲见蕾雅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative009"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "看来其他人<br>\n都已经不在地下层了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative010"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "希罗，你也听到了吗！？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia001"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "当然了……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "看到眼前的景象，<br>\n我不禁瞪大了眼睛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "这是怎么回事……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "——诺亚！！！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro010"]}},
    {"op": "ResetText", "line": 105, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 106, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 107, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 108, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 109, "indent": 0, "params": {"Scale": [1.600000023841858], "Duration": 0.0, "Lazy": 0, "ScenePosition": [20.0, 60.0], "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 110, "indent": 0, "params": {"TintColor": "#ffffff80", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 111, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 112, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "我犹豫着是否该进入房间。<br>\n因为房间内被涂成了一片雪白。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative012"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "从墙壁到地板，一切都彻底被白色覆盖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative013"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "能在一夜之间做到这种程度，<br>\n毫无疑问只有诺亚的魔法能做到。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "啊，是希罗～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah001"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "快看快看～<br>\n这样就可以画很多画了吧？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah002"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "诺亚一看到我，<br>\n就带着满脸天真笑容迎了上来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "不是和我约好，只能在画室里画画吗！<br>\n呃……这是不正确的！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 133, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "但是，但是啊，这也没办法嘛？<br>\n因为晚上一直被关在这里，<br>\n实在忍不住了嘛。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah003"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "诺亚像是在闹别扭般说道，<br>\n仿佛自己真有正当理由似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative016"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "这让我头疼不已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative017"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "（果然……所谓的预备魔女<br>\n　都有些脱离常轨之处吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro012"]}},
    {"op": "HideAllCharacters", "line": 147, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "呜……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_AnAn001"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "循声望去，<br>\n房间深处的床上有个蠕动的影子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 20.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-", "SubId": "Middle"}},
    {"op": "Wait", "line": 156, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 30.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "是夏目安安。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative019"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "哈啊……哈啊……哈啊……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_AnAn002"]}},
    {"op": "HideAllCharacters", "line": 165, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "安安看起来很不舒服……！<br>\n可能是因为颜料的气味……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Ema003"]}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "啊……<br>\n说起来，刚才好像听到了什么声音……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "她就在你旁边尖叫啊！为什么没注意到！<br>\n快点把房间恢复原状！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "……不要。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah005"]}},
    {"op": "HideAllCharacters", "line": 183, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "可能是我一时热血上头，说得太严厉了，<br>\n诺亚的情绪完全低落了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative020"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "就在蕾雅和艾玛把安安搬出去，<br>\n房间变空之际——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Angry1,ArmL5", "SubId": "Middle"}},
    {"op": "PlaySfxModified", "line": 192, "indent": 0, "params": {"SfxPath": "Sfx_15", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "留下脚印了，<br>\n要弄得更白才行～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah006"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "她竟然<br>\n又开始在室内喷洒颜料。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [55.0], "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "Wait", "line": 205, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PlaySfxModified", "line": 208, "indent": 0, "params": {"SfxPath": "Sfx_117", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Surprised1,ArmL2", "SubId": "Middle"}},
    {"op": "Wait", "line": 211, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "HideAllCharacters", "line": 213, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "希罗！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Ema004"]}},
    {"op": "HideAllCharacters", "line": 220, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "我不由得打了诺亚一巴掌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Surprised1", "SubId": "Middle"}},
    {"op": "Wait", "line": 225, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Cry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "诺亚呆呆地看着我，然后……<br>\n眼眶满溢泪水，随时都要哭出来似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "……最讨厌希罗了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah007"]}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "讨厌就讨厌吧。<br>\n诺亚做了不正确的事，都是诺亚不好！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro015"]}},
    {"op": "HideAllCharacters", "line": 238, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "你们两个冷静点！<br>\n总之现在先把安安<br>\n送到医务室去！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia002"]}},
    {"op": "StopBgm", "line": 243, "indent": 0, "params": {"FadeOutDuration": 1.0}},
    {"op": "HideAllCharacters", "line": 244, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 246, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Noah.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "我和诺亚各自气鼓鼓地转过身去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative025"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "不过，必须先把身体不适的安安带走，<br>\n这是毋庸置疑的……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative026"]}},
    {"op": "HideAllCharacters", "line": 253, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "于是我们决定前往医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative027"]}},
    {"op": "ResetText", "line": 257, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 258, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 259, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 261, "indent": 0, "params": {"TintColor": "#FFFFFF00", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 262, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "7_2"}},
    {"op": "ModifyBackgroundExtended", "line": 263, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 264, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 266, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 268, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "……幸好没什么大碍。<br>\n在这里休息一会应该就能稳定下来了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 272, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "太好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Ema005"]}},
    {"op": "HideAllCharacters", "line": 278, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro016"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "我稍微远离安安的床，<br>\n独自站在一旁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative028"]}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "我对自己有些震惊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative029"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "因为我发现自己<br>\n把监督诺亚当成了自己的职责。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative030"]}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "诺亚对此产生了反抗，<br>\n而我也变得情绪化。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative031"]}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "我用手机向所有人告知了这次的事件，<br>\n然后深深地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative032"]}},
    {"op": "ModifyCharacterExtended", "line": 292, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "那个，安安，<br>\n对不起……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah008"]}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "诺亚似乎终于意识到事态的严重性，显得很懊悔。<br>\n她萎靡不振，紧贴在安安的床边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative033"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "诺亚不是故意的哦。<br>\n但是，就是忍不住想画画……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah009"]}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "不是故意的，<br>\n也不行。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro017"]}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "如果无法控制自己，<br>\n那就暂时禁止画画。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro018"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "我不由自主地插嘴了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative034"]}},
    {"op": "ModifyCharacterExtended", "line": 308, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "诺亚顿时脸一皱，<br>\n瞪向我这边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative035"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "不、不要！那不行！<br>\n诺亚会注意的！一定没问题的！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah010"]}},
    {"op": "ModifyCharacterExtended", "line": 314, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "诺亚不画画的话，<br>\n就要迷失自我了！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah011"]}},
    {"op": "ModifyCharacterExtended", "line": 318, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "看着安安，你还能说出这种话吗！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro019"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "我语气严厉地<br>\n指着安安的病床。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative036"]}},
    {"op": "ModifyCharacterExtended", "line": 324, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Cry1"}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "呜呜呜呜……！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah012"]}},
    {"op": "HideAllCharacters", "line": 328, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 329, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "希、希罗！你冷静一点。<br>\n安安会被吵醒的哦。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Ema006"]}},
    {"op": "HideAllCharacters", "line": 333, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "艾玛的制止让我感到屈辱。<br>\n我紧紧握住自己的一只手臂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative037"]}},
    {"op": "ModifyCharacterExtended", "line": 337, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 338, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "诺亚，已经在反省了……！<br>\n已经知道自己对安安做了不好的事情了……！<br>", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah013"]}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "诺亚会照顾安安的！<br>\n会一直陪在她身边直到她康复！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah014"]}},
    {"op": "PrintTextModified", "line": 344, "indent": 0, "params": {"Text": "你以为这样就能解决问题吗！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro020"]}},
    {"op": "ModifyCharacterExtended", "line": 346, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 348, "indent": 0, "params": {"Text": "那该怎么办嘛！？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Noah015"]}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "已经无法挽回了！<br>\n犯下的事实是无法改变的！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 352, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [85.0], "IdAndAppearance": "Leia.Normal1,ArmR4"}},
    {"op": "Wait", "line": 353, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 354, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Normal1,ArmR4"}},
    {"op": "Wait", "line": 355, "indent": 0, "params": {"WaitMode": "0.25"}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Duration": 0.20000000298023224, "Lazy": 0, "ScenePosition": [85.0], "IdAndAppearance": "Leia.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "蕾雅拍了拍我的肩膀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative038"]}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [85.0], "IdAndAppearance": "Leia.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "……好了，希罗。<br>\n诺亚自告奋勇照顾病人，作为反省的表现来说，是件好事。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia004"]}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "所幸安安的情况也没那么糟糕。<br>\n能不能网开一面呢。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 366, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [85.0], "IdAndAppearance": "Leia.Pensive1,ArmR1"}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "你们现在最好不要待在一起。<br>\n看样子双方都无法冷静下来……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [85.0], "IdAndAppearance": "Leia.Smile1,ArmR1"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "我们出去透透气吧。<br>\n艾玛也一起来好吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia007"]}},
    {"op": "HideAllCharacters", "line": 374, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 375, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 377, "indent": 0, "params": {"Text": "嗯、嗯。希罗我们走吧……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Ema007"]}},
    {"op": "HideAllCharacters", "line": 379, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 381, "indent": 0, "params": {"Text": "在两人的催促下，<br>\n我被带出了房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative039"]}},
    {"op": "ResetText", "line": 383, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 384, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 385, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 387, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 388, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 389, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 391, "indent": 0, "params": {"Text": "脑子里其实明白，<br>\n生气也于事无补。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative040"]}},
    {"op": "PrintTextModified", "line": 393, "indent": 0, "params": {"Text": "……是我的错。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Hiro022"]}},
    {"op": "PrintTextModified", "line": 395, "indent": 0, "params": {"Text": "在离开房间的最后一刻，我轻声呢喃道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative041"]}},
    {"op": "ModifyCharacterExtended", "line": 397, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 399, "indent": 0, "params": {"Text": "希罗责任感很强这一点，<br>\n我觉得很了不起哦。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia008"]}},
    {"op": "ModifyCharacterExtended", "line": 401, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "而且……老实说我也有点生气。<br>\n多亏你代替我发火了，我才能冷静下来。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Leia009"]}},
    {"op": "ModifyCharacterExtended", "line": 405, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 407, "indent": 0, "params": {"Text": "蕾雅像是找到了同谋一样，<br>\n对我微笑着……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative042"]}},
    {"op": "PrintTextModified", "line": 409, "indent": 0, "params": {"Text": "但我却无法回以笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv20_Narrative043"]}},
    {"op": "Gosub", "line": 411, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 413, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv21", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv20_Narrative001": "又过了一天。",
  "0201Adv20_Narrative002": "日子平静地过去，<br>\n除了监牢的卫生环境不佳外，<br>\n没有发生什么麻烦事。",
  "0201Adv20_Hiro001": "（……好，就祈祷一切都按照正规进行，平安无事吧）",
  "0201Adv20_Narrative003": "我从简陋的床上起身，<br>\n揉了揉眼睛。",
  "0201Adv20_Hiro002": "（不知为何，我内心的不安感<br>\n　似乎在逐渐增强）",
  "0201Adv20_Hiro003": "（也许在这种地方过着平安无事的日子，<br>\n　反而才是异常……）",
  "0201Adv20_Ema001": "啊，希、希罗，早上好。",
  "0201Adv20_Hiro004": "早上好。",
  "0201Adv20_Narrative004": "艾玛似乎已经起床了，<br>\n我冷淡地回应了她。",
  "0201Adv20_Narrative005": "回应别人的问候是一种礼貌，我才不得不回应。<br>\n所以我的压力之源，正是同室的艾玛。",
  "0201Adv20_Narrative006": "我这么想着，片刻后——",
  "0201Adv20_Unknown001": "呜哇啊啊啊！！！！",
  "0201Adv20_Narrative007": "听到这声尖叫，<br>\n我立刻从床上跳了下来。",
  "0201Adv20_Hiro005": "！？这声音是！？",
  "0201Adv20_Ema002": "不，不知道！<br>\n我们之中有谁是这种音色吗……！",
  "0201Adv20_Hiro006": "在我们中几乎没有发出过声音的少女，<br>\n那就只有——她了。",
  "0201Adv20_Hiro007": "总之就在隔壁。",
  "0201Adv20_Narrative008": "我们跑向了<br>\n夏目安安和城崎诺亚的房间。",
  "0201Adv20_Narrative009": "到达现场的有我、艾玛，<br>\n还有莲见蕾雅。",
  "0201Adv20_Narrative010": "看来其他人<br>\n都已经不在地下层了。",
  "0201Adv20_Leia001": "希罗，你也听到了吗！？",
  "0201Adv20_Hiro008": "当然了……！",
  "0201Adv20_Narrative011": "看到眼前的景象，<br>\n我不禁瞪大了眼睛。",
  "0201Adv20_Hiro009": "这是怎么回事……",
  "0201Adv20_Hiro010": "——诺亚！！！！",
  "0201Adv20_Narrative012": "我犹豫着是否该进入房间。<br>\n因为房间内被涂成了一片雪白。",
  "0201Adv20_Narrative013": "从墙壁到地板，一切都彻底被白色覆盖。",
  "0201Adv20_Narrative014": "能在一夜之间做到这种程度，<br>\n毫无疑问只有诺亚的魔法能做到。",
  "0201Adv20_Noah001": "啊，是希罗～",
  "0201Adv20_Noah002": "快看快看～<br>\n这样就可以画很多画了吧？",
  "0201Adv20_Narrative015": "诺亚一看到我，<br>\n就带着满脸天真笑容迎了上来。",
  "0201Adv20_Hiro011": "不是和我约好，只能在画室里画画吗！<br>\n呃……这是不正确的！！",
  "0201Adv20_Noah003": "但是，但是啊，这也没办法嘛？<br>\n因为晚上一直被关在这里，<br>\n实在忍不住了嘛。",
  "0201Adv20_Narrative016": "诺亚像是在闹别扭般说道，<br>\n仿佛自己真有正当理由似的。",
  "0201Adv20_Narrative017": "这让我头疼不已。",
  "0201Adv20_Hiro012": "（果然……所谓的预备魔女<br>\n　都有些脱离常轨之处吗）",
  "0201Adv20_AnAn001": "呜……",
  "0201Adv20_Narrative018": "循声望去，<br>\n房间深处的床上有个蠕动的影子。",
  "0201Adv20_Narrative019": "是夏目安安。",
  "0201Adv20_AnAn002": "哈啊……哈啊……哈啊……",
  "0201Adv20_Ema003": "安安看起来很不舒服……！<br>\n可能是因为颜料的气味……",
  "0201Adv20_Noah004": "啊……<br>\n说起来，刚才好像听到了什么声音……",
  "0201Adv20_Hiro013": "她就在你旁边尖叫啊！为什么没注意到！<br>\n快点把房间恢复原状！",
  "0201Adv20_Noah005": "……不要。",
  "0201Adv20_Narrative020": "可能是我一时热血上头，说得太严厉了，<br>\n诺亚的情绪完全低落了下来。",
  "0201Adv20_Narrative021": "就在蕾雅和艾玛把安安搬出去，<br>\n房间变空之际——",
  "0201Adv20_Noah006": "留下脚印了，<br>\n要弄得更白才行～",
  "0201Adv20_Narrative022": "她竟然<br>\n又开始在室内喷洒颜料。",
  "0201Adv20_Hiro014": "——！",
  "0201Adv20_Ema004": "希罗！",
  "0201Adv20_Narrative023": "我不由得打了诺亚一巴掌。",
  "0201Adv20_Narrative024": "诺亚呆呆地看着我，然后……<br>\n眼眶满溢泪水，随时都要哭出来似的。",
  "0201Adv20_Noah007": "……最讨厌希罗了。",
  "0201Adv20_Hiro015": "讨厌就讨厌吧。<br>\n诺亚做了不正确的事，都是诺亚不好！",
  "0201Adv20_Leia002": "你们两个冷静点！<br>\n总之现在先把安安<br>\n送到医务室去！",
  "0201Adv20_Narrative025": "我和诺亚各自气鼓鼓地转过身去。",
  "0201Adv20_Narrative026": "不过，必须先把身体不适的安安带走，<br>\n这是毋庸置疑的……",
  "0201Adv20_Narrative027": "于是我们决定前往医务室。",
  "0201Adv20_Leia003": "……幸好没什么大碍。<br>\n在这里休息一会应该就能稳定下来了。",
  "0201Adv20_Ema005": "太好了……",
  "0201Adv20_Hiro016": "…………",
  "0201Adv20_Narrative028": "我稍微远离安安的床，<br>\n独自站在一旁。",
  "0201Adv20_Narrative029": "我对自己有些震惊。",
  "0201Adv20_Narrative030": "因为我发现自己<br>\n把监督诺亚当成了自己的职责。",
  "0201Adv20_Narrative031": "诺亚对此产生了反抗，<br>\n而我也变得情绪化。",
  "0201Adv20_Narrative032": "我用手机向所有人告知了这次的事件，<br>\n然后深深地叹了口气。",
  "0201Adv20_Noah008": "那个，安安，<br>\n对不起……",
  "0201Adv20_Narrative033": "诺亚似乎终于意识到事态的严重性，显得很懊悔。<br>\n她萎靡不振，紧贴在安安的床边。",
  "0201Adv20_Noah009": "诺亚不是故意的哦。<br>\n但是，就是忍不住想画画……",
  "0201Adv20_Hiro017": "不是故意的，<br>\n也不行。",
  "0201Adv20_Hiro018": "如果无法控制自己，<br>\n那就暂时禁止画画。",
  "0201Adv20_Narrative034": "我不由自主地插嘴了。",
  "0201Adv20_Narrative035": "诺亚顿时脸一皱，<br>\n瞪向我这边。",
  "0201Adv20_Noah010": "不、不要！那不行！<br>\n诺亚会注意的！一定没问题的！",
  "0201Adv20_Noah011": "诺亚不画画的话，<br>\n就要迷失自我了！",
  "0201Adv20_Hiro019": "看着安安，你还能说出这种话吗！",
  "0201Adv20_Narrative036": "我语气严厉地<br>\n指着安安的病床。",
  "0201Adv20_Noah012": "呜呜呜呜……！",
  "0201Adv20_Ema006": "希、希罗！你冷静一点。<br>\n安安会被吵醒的哦。",
  "0201Adv20_Narrative037": "艾玛的制止让我感到屈辱。<br>\n我紧紧握住自己的一只手臂。",
  "0201Adv20_Noah013": "诺亚，已经在反省了……！<br>\n已经知道自己对安安做了不好的事情了……！<br>",
  "0201Adv20_Noah014": "诺亚会照顾安安的！<br>\n会一直陪在她身边直到她康复！",
  "0201Adv20_Hiro020": "你以为这样就能解决问题吗！？",
  "0201Adv20_Noah015": "那该怎么办嘛！？",
  "0201Adv20_Hiro021": "已经无法挽回了！<br>\n犯下的事实是无法改变的！",
  "0201Adv20_Narrative038": "蕾雅拍了拍我的肩膀。",
  "0201Adv20_Leia004": "……好了，希罗。<br>\n诺亚自告奋勇照顾病人，作为反省的表现来说，是件好事。",
  "0201Adv20_Leia005": "所幸安安的情况也没那么糟糕。<br>\n能不能网开一面呢。",
  "0201Adv20_Leia006": "你们现在最好不要待在一起。<br>\n看样子双方都无法冷静下来……",
  "0201Adv20_Leia007": "我们出去透透气吧。<br>\n艾玛也一起来好吗？",
  "0201Adv20_Ema007": "嗯、嗯。希罗我们走吧……？",
  "0201Adv20_Narrative039": "在两人的催促下，<br>\n我被带出了房间。",
  "0201Adv20_Narrative040": "脑子里其实明白，<br>\n生气也于事无补。",
  "0201Adv20_Hiro022": "……是我的错。",
  "0201Adv20_Narrative041": "在离开房间的最后一刻，我轻声呢喃道。",
  "0201Adv20_Leia008": "希罗责任感很强这一点，<br>\n我觉得很了不起哦。",
  "0201Adv20_Leia009": "而且……老实说我也有点生气。<br>\n多亏你代替我发火了，我才能冷静下来。",
  "0201Adv20_Narrative042": "蕾雅像是找到了同谋一样，<br>\n对我微笑着……",
  "0201Adv20_Narrative043": "但我却无法回以笑容。"
}
}
