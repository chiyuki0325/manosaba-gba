    {"op": "Wait", "line": 193, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 195, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 196, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale * 2}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [100.0, 40.0], "AppearanceAndTransition": "1_2"}},
