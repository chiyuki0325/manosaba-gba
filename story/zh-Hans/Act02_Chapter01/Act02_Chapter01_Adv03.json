    {"op": "HideActors", "line": 199, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Duration": 0.5, "Lazy": 0}},
    {"op": "Wait", "line": 200, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PlayBgm", "line": 202, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "噫……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema007"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "（这座监牢的看守……<br>\n　就是上次杀死我的怪物）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro013"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "希、希罗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema008"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "脸色苍白的艾玛紧紧抓住了我的手臂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative023"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "涌上一股甩开她的冲动。<br>\n但我还是忍下来了，决定暂时按兵不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative024"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "我眯起眼睛，仔细观察着看守。<br>\n不出所料，那显然是某种非人的东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative025"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "……现在只能接受现实。<br>\n反抗那个怪物是错误的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative026"]}},
    {"op": "ModifyBackgroundExtended", "line": 218, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "PlaySfxModified", "line": 219, "indent": 0, "params": {"SfxPath": "Sfx_5", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "等到看守从我们身边经过后，<br>\n我才不动声色地挣脱了艾玛的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative027"]}},
    {"op": "ResetText", "line": 223, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 224, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 225, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "HideActors", "line": 227, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Lazy": 0}},
    {"op": "PlaySfxModified", "line": 230, "indent": 0, "params": {"SfxPath": "Sfx_119", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 232, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 233, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 234, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "然后独自一人走向过道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative028"]}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Scale": [0.75], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "呀啊啊啊！怪物别碰我！好恶心！<br>\n好了，好了啦，我走就是！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Coco001"]}},
    {"op": "HideAllCharacters", "line": 242, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "我看到泽渡可可<br>\n正在逃避看守。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative029"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "其他被囚禁的少女们<br>\n也陆续走出来，来到过道上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative030"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "所有人的名字，我都已经记在脑子里了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "等、等我一下，希罗！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema009"]}},
    {"op": "HideAllCharacters", "line": 254, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "如预料中的一样，艾玛追了上来。<br>\n我转身，直视着艾玛的脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative032"]}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 259, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "居然在这种地方遇到你，<br>\n我真的吓了一跳……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema010"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "我一点也不惊讶。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro014"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "虽然发生了很多事，<br>\n我们能不能还像以前那样做朋友……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 267, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "抱歉，我没有那个打算。<br>\n我无法原谅你，这一点不会改变。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 271, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Cry1"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema012"]}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "艾玛这副很受伤的表情，令我更加火大。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative033"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "说完了？那我走了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro016"]}},
    {"op": "HideAllCharacters", "line": 279, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "即使是第二次经历，<br>\n还是想把她推开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative034"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "我转身快步走向过道——这时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative035"]}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "我不会放弃的——啊、", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema013"]}},
    {"op": "PlaySfxModified", "line": 292, "indent": 0, "params": {"SfxPath": "Sfx_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 294, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "听到喊声我回头，<br>\n发现艾玛摔倒了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative036"]}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "呜、啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema014"]}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "她被坚硬的石地板擦伤了膝盖，<br>\n痛得皱起了脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative037"]}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "（这就是艾玛的本性）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro017"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "上次我推她的时候，<br>\n她摔得很夸张，表现出的严重性比我的力道大多了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative038"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "这次我甚至没有推她，<br>\n她还是试图用摔倒来引起我的注意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative039"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "（我不会再上当了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro018"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "把颤抖的手紧握成拳，<br>\n我无视艾玛继续往前走。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative040"]}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "随着憎恨涌上心头，<br>\n我的胸口一阵阵发紧发痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative041"]}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "（……再也不想见到她了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro019"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "我抬头看着从地下层通往一楼的楼梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative042"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "（接下来，我会被看守杀死）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro020"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "我拥有一种神奇的力量。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative043"]}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "按照在这座监牢中听到的说法，<br>\n或许可以称之为【魔法】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative044"]}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "——我的【魔法】是【死亡回溯】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative045"]}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "只要死亡，<br>\n就会回到死亡当天早上醒来的时刻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative046"]}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "意识到自己拥有这种魔法，<br>\n是在小时候溺水死亡的时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative047"]}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "经历了好几次同样的死亡，<br>\n才终于发现自己拥有这种魔法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative048"]}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "后来我还理解到，这是其他人做不到的事。<br>\n从那时起，我开始对这种魔法感到厌恶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative049"]}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "因为这是不正确的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative050"]}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "不过，被看守砍下头颅而死属于意料之外，<br>\n既然已经回溯了，那也没办法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative051"]}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "（首先得避免因失控而被看守杀死）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro021"]}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "我一边在心中坚定立誓，一边登上楼梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative052"]}},
    {"op": "PlaySfxModified", "line": 345, "indent": 0, "params": {"SfxPath": "Sfx_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 346, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "Gosub", "line": 348, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 350, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv03_Narrative001": "——我眨眨眼，望向天花板。",
  "0201Adv03_Narrative002": "刚才的梦让我一时间有些混乱，<br>\n但我很快就理解了现状。",
  "0201Adv03_Hiro001": "——这是【回溯了】吗……",
  "0201Adv03_Hiro002": "那就得从头开始了。",
  "0201Adv03_Narrative003": "我向着熟悉的天花板，<br>\n如此喃喃自语道。",
  "0201Adv03_Narrative004": "我被安排睡在昏暗牢狱中的<br>\n双层床上铺。",
  "0201Adv03_Narrative005": "然后。",
  "0201Adv03_Ema001": "咦，怎、怎么回事，这里是……？",
  "0201Adv03_Narrative006": "下铺睡着的是<br>\n樱羽艾玛。",
  "0201Adv03_Ema002": "牢、牢房……！？为什么！？",
  "0201Adv03_Ema003": "我说，这里究竟是什么地方！？",
  "0201Adv03_Narrative007": "当艾玛抓住铁栅栏大喊时，<br>\n四周几乎同时响起了少女们夹杂着尖叫的声音。",
  "0201Adv03_Hiro003": "（吵死了）",
  "0201Adv03_Narrative008": "喧闹声让我心烦意乱。<br>\n为了让自己冷静下来，我深深地吸了一口气。",
  "0201Adv03_Narrative009": "我早已知道，<br>\n和我同室的是艾玛。",
  "0201Adv03_Narrative010": "我早已知道，<br>\n我会和最不想见到的人再会。",
  "0201Adv03_Narrative011": "已经是第二次了，我不会有丝毫动摇。",
  "0201Adv03_Hiro004": "（没事，我能作出正确行动）",
  "0201Adv03_Hiro005": "（——即使看到她那张脸，我也能保持冷静）",
  "0201Adv03_Narrative012": "我坐起身，<br>\n轻盈地从床上一跃而下。",
  "0201Adv03_Hiro006": "啊，艾玛。",
  "0201Adv03_Narrative013": "我在她背后向她搭话。<br>\n艾玛吓得肩头一颤，转过身来。",
  "0201Adv03_Ema004": "——！！",
  "0201Adv03_Narrative014": "艾玛惊愕地看着我。<br>\n我甚至还能对这样的她露出微笑。",
  "0201Adv03_Hiro007": "没什么好惊讶的。<br>\n你我成为了室友。<br>\n仅此而已。",
  "0201Adv03_Ema005": "欸？欸……？",
  "0201Adv03_Narrative015": "本以为自己可以保持平静。<br>\n但心里还是不由得泛起了波澜。",
  "0201Adv03_Hiro008": "（为什么你又出现在我面前）",
  "0201Adv03_Narrative016": "心中涌起焦躁，<br>\n难以忍受的窒息感使得我从艾玛身上移开视线。",
  "0201Adv03_Hiro009": "啊，你看，快开始了。",
  "0201Adv03_Narrative017": "我不顾还在目瞪口呆的艾玛，<br>\n边说边指向房间里的显示屏幕。",
  "0201Adv03_Warden001": "啊……喂喂……看得见画面吗……？<br>\n毕竟机器有好些年头了，故障特别多……唉呀呀。",
  "0201Adv03_Warden002": "大家好，我是典狱长。",
  "0201Adv03_Warden003": "我想给大家作详细说明，<br>\n请各位到会客厅来集合。",
  "0201Adv03_Warden004": "我会给大家打开牢房的锁，<br>\n之后请大家跟着带路的看守。",
  "0201Adv03_Warden005": "想反抗也没问题……<br>\n只不过小命不保罢了……嗯……",
  "0201Adv03_Narrative018": "看着屏幕上播放的画面，<br>\n我思考着。",
  "0201Adv03_Narrative019": "不该存在于世上的怪物。<br>\n还有，最重要的是——与艾玛的再会。",
  "0201Adv03_Narrative020": "上次，我在这个时候，<br>\n被摆在眼前的事实乱了阵脚。",
  "0201Adv03_Narrative021": "但我必须恢复冷静。<br>\n我开始深呼吸，尽可能地平息心中的躁动。",
  "0201Adv03_Hiro010": "（虽说内心产生了动摇，<br>\n　但我那时确实不应该那么做）",
  "0201Adv03_Hiro011": "（为什么当时会<br>\n　冲动到那个地步……）",
  "0201Adv03_Narrative022": "我清晰记得自己到底有多么冲动鲁莽。<br>\n那根本就不像平时的我。",
  "0201Adv03_Hiro012": "（必须保持理智。<br>\n　——【那个】马上要来了）",
  "0201Adv03_Ema006": "典狱长……？看守……？",
  "0201Adv03_Ema007": "噫……",
  "0201Adv03_Hiro013": "（这座监牢的看守……<br>\n　就是上次杀死我的怪物）",
  "0201Adv03_Ema008": "希、希罗……",
  "0201Adv03_Narrative023": "脸色苍白的艾玛紧紧抓住了我的手臂。",
  "0201Adv03_Narrative024": "涌上一股甩开她的冲动。<br>\n但我还是忍下来了，决定暂时按兵不动。",
  "0201Adv03_Narrative025": "我眯起眼睛，仔细观察着看守。<br>\n不出所料，那显然是某种非人的东西。",
  "0201Adv03_Narrative026": "……现在只能接受现实。<br>\n反抗那个怪物是错误的。",
  "0201Adv03_Narrative027": "等到看守从我们身边经过后，<br>\n我才不动声色地挣脱了艾玛的手。",
  "0201Adv03_Narrative028": "然后独自一人走向过道。",
  "0201Adv03_Coco001": "呀啊啊啊！怪物别碰我！好恶心！<br>\n好了，好了啦，我走就是！！",
  "0201Adv03_Narrative029": "我看到泽渡可可<br>\n正在逃避看守。",
  "0201Adv03_Narrative030": "其他被囚禁的少女们<br>\n也陆续走出来，来到过道上。",
  "0201Adv03_Narrative031": "所有人的名字，我都已经记在脑子里了。",
  "0201Adv03_Ema009": "等、等我一下，希罗！",
  "0201Adv03_Narrative032": "如预料中的一样，艾玛追了上来。<br>\n我转身，直视着艾玛的脸。",
  "0201Adv03_Ema010": "居然在这种地方遇到你，<br>\n我真的吓了一跳……",
  "0201Adv03_Hiro014": "我一点也不惊讶。",
  "0201Adv03_Ema011": "虽然发生了很多事，<br>\n我们能不能还像以前那样做朋友……",
  "0201Adv03_Hiro015": "抱歉，我没有那个打算。<br>\n我无法原谅你，这一点不会改变。",
  "0201Adv03_Ema012": "——",
  "0201Adv03_Narrative033": "艾玛这副很受伤的表情，令我更加火大。",
  "0201Adv03_Hiro016": "说完了？那我走了。",
  "0201Adv03_Narrative034": "即使是第二次经历，<br>\n还是想把她推开。",
  "0201Adv03_Narrative035": "我转身快步走向过道——这时。",
  "0201Adv03_Ema013": "我不会放弃的——啊、",
  "0201Adv03_Narrative036": "听到喊声我回头，<br>\n发现艾玛摔倒了。",
  "0201Adv03_Ema014": "呜、啊……",
  "0201Adv03_Narrative037": "她被坚硬的石地板擦伤了膝盖，<br>\n痛得皱起了脸。",
  "0201Adv03_Hiro017": "（这就是艾玛的本性）",
  "0201Adv03_Narrative038": "上次我推她的时候，<br>\n她摔得很夸张，表现出的严重性比我的力道大多了。",
  "0201Adv03_Narrative039": "这次我甚至没有推她，<br>\n她还是试图用摔倒来引起我的注意。",
  "0201Adv03_Hiro018": "（我不会再上当了）",
  "0201Adv03_Narrative040": "把颤抖的手紧握成拳，<br>\n我无视艾玛继续往前走。",
  "0201Adv03_Narrative041": "随着憎恨涌上心头，<br>\n我的胸口一阵阵发紧发痛。",
  "0201Adv03_Hiro019": "（……再也不想见到她了）",
  "0201Adv03_Narrative042": "我抬头看着从地下层通往一楼的楼梯。",
  "0201Adv03_Hiro020": "（接下来，我会被看守杀死）",
  "0201Adv03_Narrative043": "我拥有一种神奇的力量。",
  "0201Adv03_Narrative044": "按照在这座监牢中听到的说法，<br>\n或许可以称之为【魔法】。",
  "0201Adv03_Narrative045": "——我的【魔法】是【死亡回溯】。",
  "0201Adv03_Narrative046": "只要死亡，<br>\n就会回到死亡当天早上醒来的时刻。",
  "0201Adv03_Narrative047": "意识到自己拥有这种魔法，<br>\n是在小时候溺水死亡的时候。",
  "0201Adv03_Narrative048": "经历了好几次同样的死亡，<br>\n才终于发现自己拥有这种魔法。",
  "0201Adv03_Narrative049": "后来我还理解到，这是其他人做不到的事。<br>\n从那时起，我开始对这种魔法感到厌恶。",
  "0201Adv03_Narrative050": "因为这是不正确的。",
  "0201Adv03_Narrative051": "不过，被看守砍下头颅而死属于意料之外，<br>\n既然已经回溯了，那也没办法。",
  "0201Adv03_Hiro021": "（首先得避免因失控而被看守杀死）",
  "0201Adv03_Narrative052": "我一边在心中坚定立誓，一边登上楼梯。"
}
}
