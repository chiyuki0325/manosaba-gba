    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "ModifyBackgroundExtended", "line": 18, "indent": 0, "params": {"Id": "Stills", "Lazy": 0, "AppearanceAndTransition": "370_1"}},
    {"op": "Wait", "line": 19, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"Id": "Stills", "Lazy": 0, "AppearanceAndTransition": "370_2"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyBackgroundExtended", "line": 22, "indent": 0, "params": {"Id": "Stills", "Lazy": 0, "AppearanceAndTransition": "370_1"}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 24, "indent": 0, "params": {"Id": "Stills", "Lazy": 0, "AppearanceAndTransition": "370_2"}},
    {"op": "Wait", "line": 25, "indent": 0, "params": {"WaitMode": "1.6"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "——我眨眨眼，望向天花板。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "刚才的梦让我一时间有些混乱，<br>\n但我很快就理解了现状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative002"]}},
    {"op": "ModifyBackgroundExtended", "line": 31, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "370_1"}},
    {"op": "Wait", "line": 32, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "——这是【回溯了】吗……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "那就得从头开始了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro002"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "我向着熟悉的天花板，<br>\n如此喃喃自语道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative003"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "我被安排睡在昏暗牢狱中的<br>\n双层床上铺。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative004"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "然后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative005"]}},
    {"op": "ResetText", "line": 44, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 47, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 50, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "370_2"}},
    {"op": "Wait", "line": 51, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "咦，怎、怎么回事，这里是……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema001"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "下铺睡着的是<br>\n樱羽艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "牢、牢房……！？为什么！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema002"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "我说，这里究竟是什么地方！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema003"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "当艾玛抓住铁栅栏大喊时，<br>\n四周几乎同时响起了少女们夹杂着尖叫的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative007"]}},
    {"op": "ResetText", "line": 63, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 64, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "370_1"}},
    {"op": "Wait", "line": 65, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（吵死了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro003"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "喧闹声让我心烦意乱。<br>\n为了让自己冷静下来，我深深地吸了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative008"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "我早已知道，<br>\n和我同室的是艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative009"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "我早已知道，<br>\n我会和最不想见到的人再会。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative010"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "已经是第二次了，我不会有丝毫动摇。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative011"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "（没事，我能作出正确行动）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro004"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "（——即使看到她那张脸，我也能保持冷静）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro005"]}},
    {"op": "ResetText", "line": 81, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 82, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 83, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 84, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlaySfxModified", "line": 87, "indent": 0, "params": {"SfxPath": "Sfx_178", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "我坐起身，<br>\n轻盈地从床上一跃而下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "啊，艾玛。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro006"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "我在她背后向她搭话。<br>\n艾玛吓得肩头一颤，转过身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "——！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema004"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "艾玛惊愕地看着我。<br>\n我甚至还能对这样的她露出微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "没什么好惊讶的。<br>\n你我成为了室友。<br>\n仅此而已。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "欸？欸……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema005"]}},
    {"op": "HideAllCharacters", "line": 111, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "本以为自己可以保持平静。<br>\n但心里还是不由得泛起了波澜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative015"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "（为什么你又出现在我面前）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro008"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "心中涌起焦躁，<br>\n难以忍受的窒息感使得我从艾玛身上移开视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "啊，你看，快开始了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro009"]}},
    {"op": "HideAllCharacters", "line": 123, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "我不顾还在目瞪口呆的艾玛，<br>\n边说边指向房间里的显示屏幕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative017"]}},
    {"op": "PlaySfxModified", "line": 128, "indent": 0, "params": {"SfxPath": "Sfx_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 131, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "ModifyTextPrinter", "line": 133, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 134, "indent": 0, "params": {"Scale": [1.2999999523162842], "Lazy": 0, "AppearanceAndTransition": "25_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 135, "indent": 0, "params": {"Scale": [1.399999976158142], "Lazy": 0, "IdAndAppearance": "Warden.1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 136, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "啊……喂喂……看得见画面吗……？<br>\n毕竟机器有好些年头了，故障特别多……唉呀呀。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Warden001"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "大家好，我是典狱长。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Warden002"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "我想给大家作详细说明，<br>\n请各位到会客厅来集合。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Warden003"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "我会给大家打开牢房的锁，<br>\n之后请大家跟着带路的看守。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Warden004"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "想反抗也没问题……<br>\n只不过小命不保罢了……嗯……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Warden005"]}},
    {"op": "PlaySfxModified", "line": 151, "indent": 0, "params": {"SfxPath": "Sfx_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 152, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 153, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "ModifyTextPrinter", "line": 154, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "HideActors", "line": 157, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Warden-Middle"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 158, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 159, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "看着屏幕上播放的画面，<br>\n我思考着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative018"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "不该存在于世上的怪物。<br>\n还有，最重要的是——与艾玛的再会。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative019"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "上次，我在这个时候，<br>\n被摆在眼前的事实乱了阵脚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "但我必须恢复冷静。<br>\n我开始深呼吸，尽可能地平息心中的躁动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative021"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "（虽说内心产生了动摇，<br>\n　但我那时确实不应该那么做）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro010"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "（为什么当时会<br>\n　冲动到那个地步……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro011"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "我清晰记得自己到底有多么冲动鲁莽。<br>\n那根本就不像平时的我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Narrative022"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "（必须保持理智。<br>\n　——【那个】马上要来了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Hiro012"]}},
    {"op": "StopBgm", "line": 179, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 182, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "典狱长……？看守……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv03_Ema006"]}},
    {"op": "PlaySfxModified", "line": 189, "indent": 0, "params": {"SfxPath": "Sfx_5", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 191, "indent": 0, "params": {}},
