    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "——第四天早晨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "我坐起身，<br>\n轻盈地从双层床上跳下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我看到艾玛<br>\n也已经坐起身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "你该不会……一夜没睡吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "啊，希罗，早上好……<br>\n其实我睡了一会，但还是担心玛格，<br>\n很快就醒了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "不用担心玛格。<br>\n昨天我也去医务室探望了几次，<br>\n她已经完全恢复精神了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "是吗！？太好了～～", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "希罗，给你添麻烦了，对不起……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "……虽然你们也有部分责任，<br>\n但这是看守干的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "今天是怎么了？总觉得希罗和平常有点不一样。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro004"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "艾玛的说法让我感到恼火，我冷冷地瞪了她一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative004"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "和平常不一样？<br>\n你对我了解多少？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "……对不起。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema005"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "（只会道歉也让人火大。<br>\n　向我道歉有什么用？<br>\n　艾玛对【她】做过的事已经无法挽回了——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro006"]}},
    {"op": "HideAllCharacters", "line": 63, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "感觉再和艾玛交谈下去，<br>\n可能又会控制不住情绪，<br>\n于是我急忙朝门口走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "啊，希罗等等！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema006"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "什么事？我已经没有什么要和你说……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro007"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "艾玛有些尴尬地<br>\n向我递出笔记本和钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "这是你忘的东西吧。你一直随身带着的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema007"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro008"]}},
    {"op": "PlaySfxModified", "line": 92, "indent": 0, "params": {"SfxPath": "Sfx_115", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 94, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "我几乎是抢夺般从艾玛手中拿过东西。<br>\n我感到自己的烦躁情绪在加剧，这不是好兆头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative007"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "（这个环境果然让人压力很大）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro009"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "这几天，我算是把魔女化导致的冲动<br>\n抑制下来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative008"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "保持这个势头的话，我应该不会堕为魔女，<br>\n但面对这种无计可施的状况，我还是越来越焦躁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative009"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "（不知道自己什么时候又会像之前一样失控。<br>\n　明明我不应该再积攒压力）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro010"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "（都是艾玛在这里害的……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro011"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "我半是迁怒地瞪着艾玛，<br>\n然后突然想到了什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "……说起来，你的魔法是什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro012"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "欸？我的魔法？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "也、也是啊。大家都有神奇的力量……<br>\n那一定就是所谓魔女的魔法吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema009"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "但是我却没有任何神奇的力量。<br>\n说不定是弄错了什么才把我关进这里的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Ema010"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "（……不可能搞错。<br>\n　是她自己都没有察觉，还是在隐瞒？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro013"]}},
    {"op": "HideAllCharacters", "line": 127, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "我转过脸不看艾玛，<br>\n注视着手中的钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative011"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "（艾玛是危险的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro014"]}},
    {"op": "ResetText", "line": 133, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 134, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 135, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PlaySfxModified", "line": 138, "indent": 0, "params": {"SfxPath": "Sfx_119", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Angry1"}},
    {"op": "ModifyBackgroundExtended", "line": 141, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 142, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 143, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "走到地下过道时，<br>\n诺亚已经在那里埋伏我了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative012"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "希罗，你是不是，忘记约定了？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Noah001"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "被她埋怨的眼神盯着，<br>\n我脸颊冒汗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "（说起来，我确实答应过<br>\n　要帮诺亚找画画的地方）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "……我没忘。只是因为玛格的事有点忙。<br>\n来，我们先去吃早餐吧。约定的事之后再说。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Smile1,ArmR3,ArmL3"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "太好了！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Noah002"]}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "（虽然感觉行动会受到很多限制，但也没办法……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Hiro017"]}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "我决定和诺亚一起<br>\n探索这座监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv11_Narrative014"]}},
