    {"op": "ModifyCamera", "line": 143, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 144, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Lazy": 0, "AppearanceAndTransition": "30_1"}},
    {"op": "ModifyBackgroundExtended", "line": 145, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 146, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "直播就这样简单地结束了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Surprised1"}},
