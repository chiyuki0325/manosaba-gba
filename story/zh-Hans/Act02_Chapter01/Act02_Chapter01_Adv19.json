    {"op": "PlayBgm", "line": 16, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "第二天晚餐后——<br>\n我和诺亚来到了淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "在标有囚犯编号的储物柜里，每天都放着一模一样的衣服。<br>\n我们每天只能穿这个。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative002"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "就算已经使用好几次这个储物柜了，<br>\n每次看到还是会不由自主地因厌恶而咂舌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Normal1,ArmL2"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "把我们当换装娃娃吗……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Angry1,ArmL2"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "诺亚讨厌洗澡。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Noah001"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "我都帮你洗了，就别任性了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1,ArmL2"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "每天都要洗吗？<br>\n三天洗一次不行吗？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Noah002"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "不行。每天都要洗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Angry1,ArmL2"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "小气鬼～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Noah003"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "这不是什么小气。这座监牢的卫生状况<br>\n本来就不太好。所以我们应当保持清洁……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro004"]}},
    {"op": "HideAllCharacters", "line": 49, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "我刚一开始向诺亚啰啰嗦嗦地说教时，<br>\n手中的智能手机闪烁起来，提示有新的通知。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative004"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "查看后发现，和之前预告的一样，<br>\n原来是泽渡可可开始了直播。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative005"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "直播画面上显示着可可。<br>\n诺亚也凑过来看我的手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [70.0, 40.0], "IdAndAppearance": "Noah.Normal1,ArmL2"}},
    {"op": "Wait", "line": 58, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0, 40.0], "IdAndAppearance": "Noah"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "啊，是可可。<br>\n她在哪里呢？？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Noah004"]}},
    {"op": "ResetText", "line": 63, "indent": 0, "params": {}},
