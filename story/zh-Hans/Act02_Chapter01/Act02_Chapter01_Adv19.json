    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "（【杀死魔女的药】……？<br>\n　真的存在那种东西吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro006"]}},
    {"op": "UpdateWitchBook", "line": 155, "indent": 0, "params": {"Id": "15", "Category": "Note", "Version": 1}},
