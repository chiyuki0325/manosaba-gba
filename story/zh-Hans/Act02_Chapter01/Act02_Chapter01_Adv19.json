    {"op": "ResetText", "line": 159, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 160, "indent": 0, "params": {"SlotNumber": 17, "Wait": 0}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "可可说的是真的吗？<br>\n要不要去找可可问问看？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro007"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative008"]}},
