    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 70, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.25, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 71, "indent": 0, "params": {"WaitMode": "0.25"}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Scale": [1.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Noah"}},
