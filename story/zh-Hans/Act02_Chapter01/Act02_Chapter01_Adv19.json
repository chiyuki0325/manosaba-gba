    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "泽渡可可不值得信任。<br>\n不用理会她。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro008"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "（即使【杀死魔女的药】的事是真的，<br>\n　也不太可能得到更多信息）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro009"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "（也许只是说些危言耸听的话<br>\n　博人眼球罢了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "总之，现在最要紧的事洗澡。<br>\n快点洗完吧，诺亚。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Angry1"}},
