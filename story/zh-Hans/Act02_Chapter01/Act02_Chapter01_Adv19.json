    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 0.0, 1.0], "IdAndAppearance": "Coco.Smile1"}},
    {"op": "ModifyCamera", "line": 76, "indent": 0, "params": {"Offset": [0.0, 2.0], "Zoom": 0.25, "Duration": 0.0, "Lazy": 0}},
    {"op": "Wait", "line": 77, "indent": 0, "params": {"WaitMode": "0.25"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "大家好～我是可可哦～！<br>\n今天我提前预告过了，大家都在看吧～？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco001"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "（确实，不知道她在哪里。<br>\n　是故意设法不让人知道她的位置吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Hiro005"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "嘿嘿嘿～<br>\n今天我要宣布一件大事哦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco002"]}},
    {"op": "StopBgm", "line": 91, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "锵锵～！大家看看这个！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco003"]}},
    {"op": "PlayBgm", "line": 95, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "其实这个啊，是【杀死魔女的药】哦～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "它的名字叫【特雷德基姆】。<br>\n效果有我亲自担保！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco005"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "我本来还在犹豫要不要告诉大家这个信息……<br>\n因为如果说出来的话，<br>\n我可能也会陷入危险的境地吧。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco006"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "但是、但是！我已经拿到【杀死魔女的药】了！<br>\n再也不会被这种东西杀死了！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco007"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "信不信由你们！<br>\n总之，如果不使用这种【杀死魔女的药】，<br>\n就绝对无法杀死魔女！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco008"]}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "以上就是可可的重大宣布啦～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv19_Coco009"]}},
    {"op": "ResetText", "line": 137, "indent": 0, "params": {}},
