    {"op": "Wait", "line": 181, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 182, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL7,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 185, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "对于这件凶器，希罗你有什么要解释的吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia010"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Angry_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 189, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "……不知道。<br>\n我从没见过那东西。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Middle,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 193, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "明白了，你否认和凶器有关联。<br>\n嗯，这也许是更明智的选择。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia011"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR2,ArmL4,Eyes1_Normal_Open3,Mouth1_Determined_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 199, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "……您的见解如此高明，真是让我受益匪浅。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 203, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "最后，是梅露露的尸体的情况。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia012"]}},
    {"op": "ModifyCharacterExtended", "line": 206, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 207, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "我自作主张，对尸体进行了一些检查。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia013"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 211, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "从尸体状况来看，死亡时间应该已经超过20分钟……<br>\n但不会超过1小时。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia014"]}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 215, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "当然，因为没有检查的专业设备，<br>\n这只是我的粗略估计。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia015"]}},
    {"op": "PlaySfxModified", "line": 219, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL6,Eyes2_Normal_Open3,Mouth2_Determined_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 222, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "……你进行了【验尸】？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 225, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 226, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "嗯，<br>\n以前为了进入角色，我学习过一些相关知识。<br>\n虽然只是外行人依样画葫芦……但应该没有弄错。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia016"]}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 230, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "如大家所见，死因显然是胸部的刺伤。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia017"]}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR8,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 236, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "另外，<br>\n还有一件我也搞不懂的怪事……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia018"]}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR8,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 240, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "……她的眼睛变得像【义眼】一样。<br>\n准确来说，眼球似乎逐渐变成矿物状的物质……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia019"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Angry_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 244, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "（眼球变成矿物……？<br>\n　这可不是寻常现象）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro012"]}},
    {"op": "PlaySfxModified", "line": 248, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 251, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "……啊，那个问题<br>\n你们没必要在意啦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 254, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 255, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "你知道些什么吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia020"]}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 259, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "嗯……【魔女】死后就会变成那样……或者说，<br>\n魔女要死的话，就只能变成那样。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 263, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "……不过，现在这个问题不重要吧。<br>\n反正死因是刺伤，不是吗？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Coco005"]}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 267, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "……嗯。<br>\n从尸体状况来看，被刺穿心脏<br>\n是直接死因。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia021"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 271, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "至于眼睛……<br>\n说不定是有人出于某些原因，<br>\n在她死后对尸体进行了破坏。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia022"]}},
    {"op": "PlaySfxModified", "line": 275, "indent": 0, "params": {"SfxPath": "Sfx_Common_2", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 277, "indent": 0, "params": {"Position": {"expression": ",{characterPositionY}"}, "Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Warden.8"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 278, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "……关于这一点，<br>\n我也来作证好了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Warden001"]}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 282, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "梅露露大人眼睛的异变，<br>\n是消除魔女不死特性的药物<br>\n产生的副作用导致的……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Warden002"]}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 286, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "从眼球变化的程度来看，<br>\n梅露露大人胸口被贯穿的时间<br>\n应该是在药物生效之前。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Warden003"]}},
    {"op": "ModifyCharacterExtended", "line": 289, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 290, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "恐怕毒药是涂在剑刃上的。<br>\n请各位注意不要乱碰，以免受伤中毒哦。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Warden004"]}},
    {"op": "ModifyCharacterExtended", "line": 293, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default,ArmR1,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Smile_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 294, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "呀！？<br>\n我、我刚才摸到了欸！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 297, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Middle,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 298, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "……汉娜，记得把手洗干净哦。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia023"]}},
    {"op": "ModifyCharacterExtended", "line": 301, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 302, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "我刚才已经洗过了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 306, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "……各位只需要认定<br>\n【在剑刃上涂抹药物，并刺伤胸口的人物】<br>\n是凶手就行了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Warden005"]}},
    {"op": "SpawnExtended", "line": 315, "indent": 0, "params": {"Path": "Clue", "Params": ["6-3"]}},
    {"op": "UpdateWitchBook", "line": 316, "indent": 0, "params": {"Id": "6-3", "Category": "Clue", "Version": 1}},
    {"op": "ShowToastUI", "line": 317, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "Wait", "line": 318, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 319, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 321, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 322, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "……好了，我调查到的现场情况<br>\n大致就这些了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia024"]}},
    {"op": "ModifyCharacterExtended", "line": 326, "indent": 0, "params": {"Position": {"expression": ",{hiddenCharacterPositionY}"}, "Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "ModifyCharacterExtended", "line": 328, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 329, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "大家有什么意见吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia025"]}},
    {"op": "StopBgm", "line": 332, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 335, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 337, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 338, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left"}},
