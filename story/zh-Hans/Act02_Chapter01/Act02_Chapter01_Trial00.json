    {"op": "GosubToModifyPerspectiveStageCamera", "line": 345, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left", "ZoomLevel": 3}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "她倒在了现场……<br>\n不觉得很可疑吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 348, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 349, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "……客观来看，这的确很可疑。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 352, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 353, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "但我真的不是凶手。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 357, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "那么……我们一起来梳理一下<br>\n大家目前掌握的情况吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia026"]}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 361, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "如果希罗不是凶手……<br>\n那么，案件中一定会存在一些矛盾之处！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia027"]}},
    {"op": "StopBgm", "line": 364, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 366, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL9,Eyes2_Normal_Closed1,Mouth2_Angry_Closed1,Sweat2-1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 367, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "（为了避免审判<br>\n　沦为单方面的批判……<br>\n　我必须坚决作出反驳）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR8,ArmL4,Eyes1_Angry_Open1,Mouth1_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 371, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "（必须纠正<br>\n　她们那些指责我的错误观点……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro016"]}},
