    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（通过投票来决定凶手，<br>\n　并将其处刑。这就是魔女审判）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "（……对于行动受限的我来说，<br>\n　所谓的审判不过是徒有虚名，<br>\n　根本没有任何公平可言……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro002"]}},
