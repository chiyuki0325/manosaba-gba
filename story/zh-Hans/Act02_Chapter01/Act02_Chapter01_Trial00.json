    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "（周围确实没有足迹……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro007"]}},
