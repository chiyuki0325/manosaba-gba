    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（……简直不可理喻。<br>\n　这种闹剧，我可没心情奉陪）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro003"]}},
    {"op": "PlaySfxModified", "line": 83, "indent": 0, "params": {"SfxPath": "Sfx_Common_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
