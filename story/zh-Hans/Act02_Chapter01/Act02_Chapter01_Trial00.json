    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "（那么……我要奋力一搏。<br>\n　直到最后一刻，都要朝着正确的方向前进……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro005"]}},
    {"op": "PlayBgm", "line": 123, "indent": 0, "params": {"BgmPath": "Bgm_45_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 126, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "……那么，首先由我来说明<br>\n现场的情况吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 130, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "现场发现了被害人冰上梅露露的尸体。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 134, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "发现尸体时，二阶堂希罗就在现场……<br>\n没错吧？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL6,Eyes2_Normal_Open3,Mouth2_Determined_Open1"}},
