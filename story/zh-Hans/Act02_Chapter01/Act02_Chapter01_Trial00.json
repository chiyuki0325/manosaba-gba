    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "现、现在就下结论<br>\n是不是太早了点呢……？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Miria002"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 90, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "毕竟现在还不确定<br>\n人就是小希杀的……！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Miria003"]}},
    {"op": "PlaySfxModified", "line": 94, "indent": 0, "params": {"SfxPath": "Sfx_Common_2", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
