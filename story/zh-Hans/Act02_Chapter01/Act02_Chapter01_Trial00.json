    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "……没错。<br>\n当时我的确在现场。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro006"]}},
