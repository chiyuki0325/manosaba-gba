    {"op": "GosubToModifyPerspectiveStageCamera", "line": 97, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "……嗯，米莉亚说得对。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open01,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 101, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "对、对吧……！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 105, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "况且，就算希罗是凶手，<br>\n我们也应该弄清楚<br>\n到底发生了什么，不是吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR15,ArmL4,Angle01/Facial/Eyes>Eyes_Wink_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 109, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "我赞成这个观点！<br>\n让我们整理一下<br>\n希罗是如何杀害梅露露的，怎么样！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Sherry001"]}},
