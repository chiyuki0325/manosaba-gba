    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "这是可可当时拍下的现场照片。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia007"]}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "正如照片所示，希罗倒在梅露露身旁，<br>\n周围也没有第三者的足迹……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Leia008"]}},
