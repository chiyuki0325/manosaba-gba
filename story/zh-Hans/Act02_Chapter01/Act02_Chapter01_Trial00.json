    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "（【除我之外，没有人能杀害梅露露】……<br>\n　她是这个意思吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Hiro008"]}},
