    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "因为……这不是【现行犯】吗？<br>\n凶手不是已经很明显了嘛。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Trial00_Coco002"]}},
