    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "来到医务室，<br>\n玛格、梅露露和安安也在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "看到我和诺亚进来，<br>\n梅露露有些拘谨地走了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "啊，啊……希、希罗小姐……！<br>\n之前真是非常感谢你的照顾……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我不记得照顾过你。<br>\n玛格的情况怎么样？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "啊，是……<br>\n玛格小姐的伤口已经愈合，<br>\n气色也好多了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 34, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "躺在床上的玛格坐了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative003"]}},
    {"op": "HidePrinter", "line": 38, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 39, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 40, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 41, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [48.0, 56.0], "AppearanceAndTransition": "7_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 42, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 20.0], "IdAndAppearance": "Margo.Normal1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 44, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Margo-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 45, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 46, "indent": 0, "params": {"ActorIds": ["Margo-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 47, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "呵呵，多亏了梅露露呢。<br>\n一直守在我身边照顾我……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo001"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "当然也要感谢希罗。<br>\n多亏了你们的悉心照料。<br>\n真的非常感谢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo002"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "伤势很重，不能掉以轻心。<br>\n尽量保持静养比较好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0, 20.0], "IdAndAppearance": "Margo.Smile1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "我之前好像有点误会希罗了呢。<br>\n你其实很体贴的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo003"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "我只是在说理所当然的事情。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro003"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "玛格小姐，请你还是躺下吧……<br>\n伤口可能会裂开的……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru003"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "真是的，梅露露。<br>\n你真爱担心呢♡", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo004"]}},
    {"op": "HideActors", "line": 65, "indent": 0, "params": {"ActorIds": ["Margo-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 66, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 67, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 68, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "梅露露轻轻扶着玛格的身体，<br>\n玛格就乖乖重新躺下了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "你已经吃过药了，<br>\n请先睡一觉吧。<br>\n现在还是需要静养的时期……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru004"]}},
    {"op": "SpawnExtended", "line": 79, "indent": 0, "params": {"Path": "Clue", "Params": ["6-4"]}},
    {"op": "Wait", "line": 80, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "梅露露手里拿着的瓶子，<br>\n看起来像是安眠药。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 86, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 87, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "玛格已经开始昏昏欲睡了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative006"]}},
    {"op": "HidePrinter", "line": 91, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 92, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 93, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 94, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [48.0, 56.0], "AppearanceAndTransition": "7_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 95, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 20.0], "IdAndAppearance": "Margo.Normal1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 97, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Margo-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 98, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 99, "indent": 0, "params": {"ActorIds": ["Margo-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "……希罗呀。<br>\n别太责怪艾玛她们哦。<br>\n我也曾经有过类似的想法。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo005"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "你也想越狱？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro004"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "是啊。考虑如何离开这里<br>\n不是很正常吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo006"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "反抗看守很危险。<br>\n还是安分一点比较好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0, 20.0], "IdAndAppearance": "Margo.Pensive1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "……你说得对。<br>\n这次的事让我明白事情没那么简单，<br>\n我打算再多调查一下这里。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo007"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "希罗真的很可靠呢。<br>\n让我们一起对抗魔女吧——", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Margo008"]}},
    {"op": "HideActors", "line": 116, "indent": 0, "params": {"ActorIds": ["Margo-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 117, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 118, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 119, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "看着玛格闭眼入睡后，<br>\n我将视线转向梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "你一直在照顾玛格吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro006"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "是、是的。因为是影响日常生活的重伤，<br>\n所以需要各种照料……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru005"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "啊，我绝对没有觉得麻烦……！<br>\n是我自愿的……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru006"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "我仔细观察着强调这点的梅露露，<br>\n注意到她眼下似乎有了黑眼圈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "（……太爱操心也是个问题啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "既然玛格睡着了，你也稍微休息一下吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "好、好的。不过安安小姐也……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru007"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "安安正睡在玛格旁边的床上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative009"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "安安为什么在这里？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "好像是贫血了。<br>\n看她很难受，<br>\n所以就让她休息一下。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru008"]}},
    {"op": "HideAllCharacters", "line": 156, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "不知何时，<br>\n诺亚已经来到了安安的床边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative010"]}},
    {"op": "HidePrinter", "line": 160, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 161, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 162, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 163, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [48.0, 66.0], "AppearanceAndTransition": "7_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 164, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 40.0], "IdAndAppearance": "AnAn.Normal1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 166, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "AnAn-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 167, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 168, "indent": 0, "params": {"ActorIds": ["AnAn-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 169, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "安安没事吧？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Noah001"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "『勿要管吾辈。勿要与吾辈说话』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn001"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "喂喂，我想在那个素描本上画画。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Noah002"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "『这是吾辈的东西。不允许擅自使用』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn002"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "但是画画很好玩的哦？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Noah003"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0, 40.0], "IdAndAppearance": "AnAn.Angry1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "『吾辈不觉得有趣』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn003"]}},
    {"op": "HideActors", "line": 185, "indent": 0, "params": {"ActorIds": ["AnAn-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 186, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 187, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 188, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "我瞥了一眼诺亚缠着安安的样子，<br>\n转向了梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "安安没什么问题吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro010"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "那个……她有点发烧，<br>\n可能是因为环境剧烈变化导致疲劳过度。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru009"]}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "虽然有点担心……但休息一下应该就会好起来的。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru010"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "这样啊。那最好不要太吵闹。<br>\n玛格也睡着了，我们出去吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro011"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "来，诺亚……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro012"]}},
    {"op": "ResetText", "line": 207, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 208, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "AnimateActorExtended", "line": 210, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionX": "40|45|50", "Duration": "0.5|0.5|0.5"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "我刚喊她，诺亚已经朝着入口走去了。<br>\n起初我以为她只是心血来潮，但她的动作有些奇怪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative012"]}},
    {"op": "AnimateActorExtended", "line": 214, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionX": "55|60|65", "Duration": "0.5|0.5|0.5"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "咦？奇怪？<br>\n诺亚明明想和安安玩的，<br>\n为什么身体自己动起来了……？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Noah004"]}},
    {"op": "HideAllCharacters", "line": 218, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "我察觉到了什么，直直地盯着安安。<br>\n安安尴尬地移开了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "你做了什么？<br>\n根据你的回答，我可能需要进一步追问。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro013"]}},
    {"op": "HideAllCharacters", "line": 226, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 228, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 229, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 230, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 231, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [48.0, 66.0], "AppearanceAndTransition": "7_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 232, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 40.0], "IdAndAppearance": "AnAn.Surprised1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 234, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "AnAn-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 235, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 236, "indent": 0, "params": {"ActorIds": ["AnAn-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 237, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "安安慌忙开始在素描本上写字。<br>\n然后把内容给我看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative014"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "『吾辈拥有轻度的【洗脑】魔法。<br>\n　只是对诺亚说，让她出去而已。<br>\n　只要不反复使用就不会对人体有影响』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn004"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "嗯……挺有意思的。<br>\n能不能给我演示一下？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro014"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "安安虽然脸色发白，但还是点了点头，<br>\n然后将视线转向诺亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0, 40.0], "IdAndAppearance": "AnAn.Normal1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "……吾辈口渴了。<br>\n诺亚，【用魔法给吾辈倒茶】。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn005"]}},
    {"op": "HideActors", "line": 251, "indent": 0, "params": {"ActorIds": ["AnAn-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 252, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 253, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 254, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "…………", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Noah005"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro015"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn006"]}},
    {"op": "HideAllCharacters", "line": 264, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "怎么了。这不是什么都没发生吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro016"]}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "奇、奇怪。不应该这样的。<br>\n诺亚，给吾辈倒茶——", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn007"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "AnimateActorExtended", "line": 271, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionX": "70|75|80", "Duration": "0.5|0.5|0.5"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "那个，可能是你误会了诺亚的魔法？<br>\n诺亚的魔法呢，虽然是可以操控液体，<br>\n但只能【画画】哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Noah006"]}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "诺亚一边后退一边说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative016"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "虽然很想给你倒茶，<br>\n但好像做不到呢。诺亚必须得出去了，<br>\n拜拜～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Noah007"]}},
    {"op": "HideAllCharacters", "line": 279, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "诺亚一边挥手<br>\n一边离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative017"]}},
    {"op": "UpdateWitchBook", "line": 283, "indent": 0, "params": {"Id": "AnAn", "Category": "Profile", "Version": 5}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "……好吧，我相信你。让她出去的洗脑<br>\n看来确实有效。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro017"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "不过，这并不是什么值得称赞的行为。<br>\n不要随意使用。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Hiro018"]}},
    {"op": "HideAllCharacters", "line": 291, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 293, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 294, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 295, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 296, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [48.0, 66.0], "AppearanceAndTransition": "7_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 297, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 298, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 40.0], "IdAndAppearance": "AnAn.Surprised1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 299, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "AnAn-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 300, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 301, "indent": 0, "params": {"ActorIds": ["AnAn-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 302, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_AnAn008"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "安安连连点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative018"]}},
    {"op": "HideActors", "line": 308, "indent": 0, "params": {"ActorIds": ["AnAn-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 309, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 310, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 311, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 313, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "安安小姐，我这就给你倒茶……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Meruru011"]}},
    {"op": "HideAllCharacters", "line": 317, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "背对着忙碌的梅露露，<br>\n我也跟着诺亚离开了医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv14_Narrative019"]}},
    {"op": "Gosub", "line": 326, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 328, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv12", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv14_Narrative001": "来到医务室，<br>\n玛格、梅露露和安安也在。",
  "0201Adv14_Narrative002": "看到我和诺亚进来，<br>\n梅露露有些拘谨地走了过来。",
  "0201Adv14_Meruru001": "啊，啊……希、希罗小姐……！<br>\n之前真是非常感谢你的照顾……",
  "0201Adv14_Hiro001": "我不记得照顾过你。<br>\n玛格的情况怎么样？",
  "0201Adv14_Meruru002": "啊，是……<br>\n玛格小姐的伤口已经愈合，<br>\n气色也好多了。",
  "0201Adv14_Narrative003": "躺在床上的玛格坐了起来。",
  "0201Adv14_Margo001": "呵呵，多亏了梅露露呢。<br>\n一直守在我身边照顾我……",
  "0201Adv14_Margo002": "当然也要感谢希罗。<br>\n多亏了你们的悉心照料。<br>\n真的非常感谢。",
  "0201Adv14_Hiro002": "伤势很重，不能掉以轻心。<br>\n尽量保持静养比较好。",
  "0201Adv14_Margo003": "我之前好像有点误会希罗了呢。<br>\n你其实很体贴的。",
  "0201Adv14_Hiro003": "我只是在说理所当然的事情。",
  "0201Adv14_Meruru003": "玛格小姐，请你还是躺下吧……<br>\n伤口可能会裂开的……",
  "0201Adv14_Margo004": "真是的，梅露露。<br>\n你真爱担心呢♡",
  "0201Adv14_Narrative004": "梅露露轻轻扶着玛格的身体，<br>\n玛格就乖乖重新躺下了。",
  "0201Adv14_Meruru004": "你已经吃过药了，<br>\n请先睡一觉吧。<br>\n现在还是需要静养的时期……",
  "0201Adv14_Narrative005": "梅露露手里拿着的瓶子，<br>\n看起来像是安眠药。",
  "0201Adv14_Narrative006": "玛格已经开始昏昏欲睡了。",
  "0201Adv14_Margo005": "……希罗呀。<br>\n别太责怪艾玛她们哦。<br>\n我也曾经有过类似的想法。",
  "0201Adv14_Hiro004": "你也想越狱？",
  "0201Adv14_Margo006": "是啊。考虑如何离开这里<br>\n不是很正常吗？",
  "0201Adv14_Hiro005": "反抗看守很危险。<br>\n还是安分一点比较好。",
  "0201Adv14_Margo007": "……你说得对。<br>\n这次的事让我明白事情没那么简单，<br>\n我打算再多调查一下这里。",
  "0201Adv14_Margo008": "希罗真的很可靠呢。<br>\n让我们一起对抗魔女吧——",
  "0201Adv14_Narrative007": "看着玛格闭眼入睡后，<br>\n我将视线转向梅露露。",
  "0201Adv14_Hiro006": "你一直在照顾玛格吗。",
  "0201Adv14_Meruru005": "是、是的。因为是影响日常生活的重伤，<br>\n所以需要各种照料……",
  "0201Adv14_Meruru006": "啊，我绝对没有觉得麻烦……！<br>\n是我自愿的……！",
  "0201Adv14_Narrative008": "我仔细观察着强调这点的梅露露，<br>\n注意到她眼下似乎有了黑眼圈。",
  "0201Adv14_Hiro007": "（……太爱操心也是个问题啊）",
  "0201Adv14_Hiro008": "既然玛格睡着了，你也稍微休息一下吧。",
  "0201Adv14_Meruru007": "好、好的。不过安安小姐也……",
  "0201Adv14_Narrative009": "安安正睡在玛格旁边的床上。",
  "0201Adv14_Hiro009": "安安为什么在这里？",
  "0201Adv14_Meruru008": "好像是贫血了。<br>\n看她很难受，<br>\n所以就让她休息一下。",
  "0201Adv14_Narrative010": "不知何时，<br>\n诺亚已经来到了安安的床边。",
  "0201Adv14_Noah001": "安安没事吧？",
  "0201Adv14_AnAn001": "『勿要管吾辈。勿要与吾辈说话』",
  "0201Adv14_Noah002": "喂喂，我想在那个素描本上画画。",
  "0201Adv14_AnAn002": "『这是吾辈的东西。不允许擅自使用』",
  "0201Adv14_Noah003": "但是画画很好玩的哦？",
  "0201Adv14_AnAn003": "『吾辈不觉得有趣』",
  "0201Adv14_Narrative011": "我瞥了一眼诺亚缠着安安的样子，<br>\n转向了梅露露。",
  "0201Adv14_Hiro010": "安安没什么问题吧？",
  "0201Adv14_Meruru009": "那个……她有点发烧，<br>\n可能是因为环境剧烈变化导致疲劳过度。",
  "0201Adv14_Meruru010": "虽然有点担心……但休息一下应该就会好起来的。",
  "0201Adv14_Hiro011": "这样啊。那最好不要太吵闹。<br>\n玛格也睡着了，我们出去吧。",
  "0201Adv14_Hiro012": "来，诺亚……",
  "0201Adv14_Narrative012": "我刚喊她，诺亚已经朝着入口走去了。<br>\n起初我以为她只是心血来潮，但她的动作有些奇怪。",
  "0201Adv14_Noah004": "咦？奇怪？<br>\n诺亚明明想和安安玩的，<br>\n为什么身体自己动起来了……？",
  "0201Adv14_Narrative013": "我察觉到了什么，直直地盯着安安。<br>\n安安尴尬地移开了视线。",
  "0201Adv14_Hiro013": "你做了什么？<br>\n根据你的回答，我可能需要进一步追问。",
  "0201Adv14_Narrative014": "安安慌忙开始在素描本上写字。<br>\n然后把内容给我看。",
  "0201Adv14_AnAn004": "『吾辈拥有轻度的【洗脑】魔法。<br>\n　只是对诺亚说，让她出去而已。<br>\n　只要不反复使用就不会对人体有影响』",
  "0201Adv14_Hiro014": "嗯……挺有意思的。<br>\n能不能给我演示一下？",
  "0201Adv14_Narrative015": "安安虽然脸色发白，但还是点了点头，<br>\n然后将视线转向诺亚。",
  "0201Adv14_AnAn005": "……吾辈口渴了。<br>\n诺亚，【用魔法给吾辈倒茶】。",
  "0201Adv14_Noah005": "…………",
  "0201Adv14_Hiro015": "…………",
  "0201Adv14_AnAn006": "…………",
  "0201Adv14_Hiro016": "怎么了。这不是什么都没发生吗。",
  "0201Adv14_AnAn007": "奇、奇怪。不应该这样的。<br>\n诺亚，给吾辈倒茶——",
  "0201Adv14_Noah006": "那个，可能是你误会了诺亚的魔法？<br>\n诺亚的魔法呢，虽然是可以操控液体，<br>\n但只能【画画】哦。",
  "0201Adv14_Narrative016": "诺亚一边后退一边说道。",
  "0201Adv14_Noah007": "虽然很想给你倒茶，<br>\n但好像做不到呢。诺亚必须得出去了，<br>\n拜拜～",
  "0201Adv14_Narrative017": "诺亚一边挥手<br>\n一边离开了。",
  "0201Adv14_Hiro017": "……好吧，我相信你。让她出去的洗脑<br>\n看来确实有效。",
  "0201Adv14_Hiro018": "不过，这并不是什么值得称赞的行为。<br>\n不要随意使用。",
  "0201Adv14_AnAn008": "……！",
  "0201Adv14_Narrative018": "安安连连点头。",
  "0201Adv14_Meruru011": "安安小姐，我这就给你倒茶……！",
  "0201Adv14_Narrative019": "背对着忙碌的梅露露，<br>\n我也跟着诺亚离开了医务室。"
}
}
