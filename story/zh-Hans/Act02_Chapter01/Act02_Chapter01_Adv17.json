  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-12", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "在巡视监牢二楼时，<br>\n我发现了一处不自然的地方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "地图上明确显示对面有一个房间，<br>\n但却找不到能进入房间的门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "整面都是墙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "这个房间似乎没有门……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "是不是被魔法消除了呢？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah001"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（……倒是无法否定这个可能性。图书室里有棵大树，<br>\n　外面还有一直悬着彩虹的花田）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro002"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "（这座监牢里不可思议的地方实在太多了。<br>\n　不得不接受这个现实啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro003"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "嗯——", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah002"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "诺亚稍作思考，<br>\n拿出了彩色喷漆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative004"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "诺亚，你要干什——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Normal1,ArmL5"}},
    {"op": "PlaySfxModified", "line": 47, "indent": 0, "params": {"SfxPath": "Sfx_15", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "还没来得及阻止，<br>\n诺亚就在墙上画出了一扇门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Smile1,ArmL1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "锵锵！因为没有门所以我就画了一个！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah003"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "这可不是“锵锵”就能蒙混过去的吧。<br>\n在这种地方涂鸦——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro005"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "墙上描绘出的大门，<br>\n精细得难以称之为涂鸦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative006"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "如此栩栩如生，<br>\n让我意识到诺亚的画技是多么惊人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative007"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "然后那扇门——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 64, "indent": 0, "params": {"SfxPath": "Sfx_22", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "自然而然地打开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative009"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "欸——！？真的开了！欸——！？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "……看来你的魔法与监牢的某种不可思议力量产生了互动，<br>\n起到了正面作用。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "嗯、嗯。诺亚也很惊讶。<br>\n虽然我会画画，但画的画从来没有变成真东西过。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "其实诺亚<br>\n在其他地方也试过，<br>\n但那些都没有变成真正的门哦？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah006"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "（那么，这只是让我们能进入这个房间而已。<br>\n　不过，能进入原本进不去的房间，<br>\n　也许也很重要）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro007"]}},
    {"op": "HideAllCharacters", "line": 87, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "我们虽然有些困惑，<br>\n但还是穿过诺亚画的门，走了进去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative010"]}},
    {"op": "ResetText", "line": 91, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 92, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 93, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 95, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "29_1"}},
    {"op": "ModifyBackgroundExtended", "line": 96, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 97, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "地上放着画布，<br>\n到处散落着许多素描。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative011"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "木桌上杂乱地摆放着调色板和画笔，<br>\n四处还有飞溅的颜料痕迹……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "哇……！！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah007"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "Wait", "line": 110, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "这里面正是<br>\n诺亚梦寐以求的画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "Wait", "line": 115, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "是画画的地方耶！<br>\n诺亚可以在这里画画吗！？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah008"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "啊，当然可以。<br>\n在这里你应该能尽情享受艺术创作了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro008"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "空气中混合着干燥的颜料香气，<br>\n和略显陈旧的木头气息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative014"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "里面还有一个可以俯瞰中庭的阳台。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative015"]}},
    {"op": "EmoteJumpDouble", "line": 127, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "发现了一个超棒的地方！<br>\n好耶，好耶！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah009"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "看着天真无邪地蹦跳的诺亚，<br>\n我的嘴角也不禁微微上扬。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative016"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "我们四处看了看，<br>\n但这个房间并不像是什么特别重要的地方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative017"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "（这么说来，就像诺亚的魔法起作用让门出现一样，<br>\n　可能是某人的魔法让门消失了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro009"]}},
    {"op": "ResetText", "line": 141, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 142, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 143, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 145, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 147, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 148, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "我们在画室里待了一会，<br>\n这期间其他少女们似乎也注意到了<br>\n这个房间的存在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative018"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "许多少女来到了画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "哎呀这是……<br>\n诺亚，你找到了个好地方啊。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Leia001"]}},
    {"op": "HideAllCharacters", "line": 158, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "嗯！<br>\n我要把这里命名为【诺亚的画室】！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah010"]}},
    {"op": "ShowToastUI", "line": 167, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 168, "indent": 0, "params": {"Id": "F2", "Category": "Map", "Version": 2}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "这里真是太适合做手工了～！<br>\n也让我用用这里哇！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "真是个氛围不错的地方。<br>\n阳台的景色也很好，真让人放松啊。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Miria001"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "虽然在娱乐室看电影也不错，<br>\n不过大叔我也可以偶尔来这里坐坐吗？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Miria002"]}},
    {"op": "HideAllCharacters", "line": 181, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "当然可以啦～！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Noah011"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "（虽然这里并不是诺亚专用的房间……<br>\n　不过既然是诺亚打开的，那就随她吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro010"]}},
    {"op": "HideAllCharacters", "line": 188, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "少女们轮流来到这里，<br>\n一团和气地交流后又各自离开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative020"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "我也终于<br>\n久违地从压抑中解脱了出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Narrative021"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "（也许我们真的发现了一个好地方）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv17_Hiro011"]}},
    {"op": "Gosub", "line": 201, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
