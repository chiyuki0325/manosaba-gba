{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter01/Act02_Chapter01_Adv21",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-16", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "我和诺亚的事<br>\n很快就被所有少女知道了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "毕竟是我自己告诉所有人的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "希罗……你在做什么呢？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hanna001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "打扫卫生。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro001"]}},
    {"op": "HideAllCharacters", "line": 26, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "我一直在擦拭会客厅里那些神秘的装饰品。<br>\n全神贯注地擦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（从以前这个习惯就一直改不掉。<br>\n　一遇到什么事就立刻用打扫来逃避）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "（我只想重新回到正确。回到规则。回到节律。<br>\n　回到健全）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "即使彻底把室内打扫得干干净净，<br>\n刚才和诺亚的对话还是一直萦绕在心头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative004"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "（……我被她讨厌了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro004"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "（管它呢。<br>\n　为这种事心情低落……可不像我的作风）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "希罗，没关系的！<br>\n打扫会有看守来做的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Sherry001"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "我知道。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro006"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "嘴上回答着，我加大了擦拭的力度，<br>\n没有回头看雪莉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "难得的放风时间，<br>\n要不要和我一起去探索一下！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Sherry002"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "我拒绝。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "啊……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Sherry003"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "雪莉依然保持着笑容，<br>\n但看起来很茫然，好像不理解我的行为。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative006"]}},
    {"op": "HideActors", "line": 61, "indent": 0, "params": {"ActorIds": ["Sherry"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "（有个空瓶子……这是在晾干吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro008"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "壁炉前放着一个空瓶，<br>\n那是之前在医务室看到梅露露拿着的安眠药瓶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative007"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "里面是空的，<br>\n所以能够推测它是已经洗干净了，正在晾干。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative008"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "（这个瓶子看来<br>\n　就这样放着比较好）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "话说回来，希罗！<br>\n昨天我又去图书室调查了，<br>\n试着解读那些文字！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "你有好好听人说话吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro010"]}},
    {"op": "PlaySfxModified", "line": 80, "indent": 0, "params": {"SfxPath": "Sfx_118", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 82, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "不一会，传来了一声沉重的响声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR11,ArmL10"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "一看，原来是雪莉<br>\n用怪力从图书室搬来了大量的书，<br>\n然后把书都堆在了会客厅的桌子上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 90, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "似乎是些古老的书籍，<br>\n书堆摇摇欲坠，扬起了灰尘。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Angry1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "咳……！刚打扫完就……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro011"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "雪莉毫不在意，一边念叨着一边开始<br>\n对照笔记和书本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "（……看来暂时是<br>\n　没法打扫这个房间了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro012"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "我放弃了这里，准备打扫别的房间，<br>\n于是朝着房间出口走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative013"]}},
    {"op": "ResetText", "line": 109, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 110, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 111, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 113, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 114, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 115, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "——那之后我想了想。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "正要出门，冷不丁被人搭话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "一看，是奈叶香<br>\n正靠墙站着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative015"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "我不会和你联手。<br>\n不过，看起来你是拥有力量的。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka002"]}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "……力量？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro013"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "也许你能改变些什么。<br>\n……我就是这么觉得。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka003"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "我想确认一下，<br>\n你的【幻视】能看到未来吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro014"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "奈叶香犹豫了一下，<br>\n摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative016"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "……我的【幻视】主要<br>\n能看到人或物的过去。<br>\n不过，在极其限定的情况下，偶尔也能看到未来。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "如果是多次接触过的对象，<br>\n也有时能看到未来……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka005"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "奈叶香话说到一半，<br>\n面露悲色地低下了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative017"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "（多次接触？是亲人吗……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro015"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "也许我从你身上<br>\n感觉到了什么。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka006"]}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "从我身上……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro016"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "（是魔力之类的吗……？<br>\n　难道是因为魔女化造成的影响……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro017"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "我稍作思考。<br>\n然后抬起头，凝视着奈叶香。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "关于【魔女化】，你知道些什么吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro018"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "奈叶香以前说过，<br>\n她掌握了很多关于这座监牢的信息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative019"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "现在我想尽可能多获得一些<br>\n关于【魔女化】的信息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative020"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "我恳切地问道。<br>\n奈叶香再次面露难色。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative021"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "虽然我把握得也不是很清楚……<br>\n但我只知道，在转化为【残骸】的过程中，<br>\n每个人都会有不同的表现。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka007"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "如果因为某些契机，被强烈刺激到内心的创伤，<br>\n就会迅速魔女化。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka008"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "但如果仅仅只是积攒过多压力，<br>\n应该还是能较长时间保持理性。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka009"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "也就是说，取决于自己心灵有多坚强吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Nanoka010"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "是这样吗……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro019"]}},
    {"op": "HideAllCharacters", "line": 179, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "我稍稍放心了些。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative022"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "之前我险些失控，<br>\n但如今已经能克制住自己，保持理性。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative023"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "我确信自己已经挺过来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative024"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "（如果取决于自己内心的坚强程度，<br>\n　那我之后一定不会堕为魔女）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro020"]}},
    {"op": "StopBgm", "line": 189, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "正在我悄悄下定决心的时候，<br>\n奈叶香已经不知不觉间离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative025"]}},
    {"op": "ResetText", "line": 197, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 198, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 199, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 201, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 203, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 204, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 205, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 207, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "那天下午——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative026"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "我在地下巡视检查<br>\n各个少女房间的情况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative027"]}},
    {"op": "PlaySfxModified", "line": 214, "indent": 0, "params": {"SfxPath": "Sfx_119", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "打开栅栏门往里看，<br>\n确认每个房间是否有变化。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative028"]}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "（665，黑部奈叶香。<br>\n　664，宝生玛格——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro021"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "空无一人的房间没有什么变化，<br>\n每个牢房的结构都差不多。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative029"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "湿度很高，光线昏暗，床铺这类的家具都很硬，<br>\n有一股陈旧的气味。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative030"]}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "每天多次的巡视<br>\n并不受其他少女的欢迎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative031"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "但是，在这个充满异常的监牢里，<br>\n需要尽可能多一点规律。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative032"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "另外，确认状况是否有变，<br>\n也是巡视的意义之一。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative033"]}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "……呼。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro022"]}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "来到隔壁房间前，<br>\n我犹豫了一下要不要往里看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative034"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "（661，城崎诺亚——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro023"]}},
    {"op": "PlaySfxModified", "line": 243, "indent": 0, "params": {"SfxPath": "Sfx_119", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 245, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 246, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 247, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "HideAllCharacters", "line": 249, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 250, "indent": 0, "params": {"Scale": [1.600000023841858], "Duration": 0.10000000149011612, "Lazy": 0, "ScenePosition": [20.0, 60.0], "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 251, "indent": 0, "params": {"TintColor": "#ffffff80", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 253, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 254, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "被涂成白色的室内，<br>\n没有人影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative035"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "还未干透的颜料散发出的刺激性气味<br>\n扑鼻而来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative036"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "（安安已经康复了，<br>\n　我看到她和诺亚一起去了画室）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro024"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "（那两个人看起来虽然那样，实际上可能关系还不错。<br>\n　也许只是我一个人在大惊小怪……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro025"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "看到她们一起去画室的时候，<br>\n由于在意自己和诺亚之间的隔阂，<br>\n没敢向她们搭话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative037"]}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "（已经回不去了、吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro026"]}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "在环境恶劣，却整齐有序的牢房中，<br>\n我走进这个被格格不入的白色完全覆盖的房间……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative038"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "凝视着自己的手掌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative039"]}},
    {"op": "StopBgm", "line": 272, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "后悔可真不像我的作风。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro027"]}},
    {"op": "HideAllCharacters", "line": 278, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "话音刚落——<br>\n突然间，背脊一阵发凉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative040"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "感觉到有人正无声无息地站在我的背后。<br>\n还没来得及回头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative041"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "——对不起。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Unknown001"]}},
    {"op": "ResetText", "line": 293, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 294, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 295, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 296, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnShake", "line": 297, "indent": 0, "params": {"ActorId": "MainBackground"}},
    {"op": "SpawnBlur", "line": 298, "indent": 0, "params": {"ActorId": "MainBackground"}},
    {"op": "Wait", "line": 299, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PlaySfxModified", "line": 300, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 301, "indent": 0, "params": {"Rotation": [0.0, 0.0, -20.0], "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 302, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [0.0, 70.0], "AppearanceAndTransition": "1_1"}},
    {"op": "Wait", "line": 303, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro028"]}},
    {"op": "SpawnBlur", "line": 309, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 2.0, "FadeDuration": 3.0}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "伴随着钝重的冲击，视野开始摇晃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative042"]}},
    {"op": "PlayBgm", "line": 313, "indent": 0, "params": {"BgmPath": "Bgm_27_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 319, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 320, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 321, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 322, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyBackgroundExtended", "line": 323, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.30000001192092896, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 324, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 325, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.30000001192092896, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 326, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 327, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.30000001192092896, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 328, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 329, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 330, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "（怎么……回事……？<br>\n　被人……攻击了？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro029"]}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "（被、谁……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro030"]}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "剧烈的疼痛让我眼前一黑，<br>\n身体无法自由活动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative043"]}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "膝盖瘫软，支撑不住身体，<br>\n最终，脸颊贴在了房间冰冷的地板上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative044"]}},
    {"op": "StopBgm", "line": 348, "indent": 0, "params": {"FadeOutDuration": 2.0}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "很痛吧……", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Unknown002"]}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "但是，很抱歉，<br>\n必须请你去死才行……", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Unknown003"]}},
    {"op": "PrintTextModified", "line": 357, "indent": 0, "params": {"Text": "（这个声音是……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Hiro031"]}},
    {"op": "PrintTextModified", "line": 359, "indent": 0, "params": {"Text": "在逐渐模糊的意识中，我努力从记忆中搜寻这个声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative045"]}},
    {"op": "PrintTextModified", "line": 361, "indent": 0, "params": {"Text": "然而在得出准确答案之前，<br>\n我的意识就坠入了黑暗——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv21_Narrative046"]}},
    {"op": "Gosub", "line": 363, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 365, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv22", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv21_Narrative001": "我和诺亚的事<br>\n很快就被所有少女知道了。",
  "0201Adv21_Narrative002": "毕竟是我自己告诉所有人的。",
  "0201Adv21_Hanna001": "希罗……你在做什么呢？",
  "0201Adv21_Hiro001": "打扫卫生。",
  "0201Adv21_Narrative003": "我一直在擦拭会客厅里那些神秘的装饰品。<br>\n全神贯注地擦。",
  "0201Adv21_Hiro002": "（从以前这个习惯就一直改不掉。<br>\n　一遇到什么事就立刻用打扫来逃避）",
  "0201Adv21_Hiro003": "（我只想重新回到正确。回到规则。回到节律。<br>\n　回到健全）",
  "0201Adv21_Narrative004": "即使彻底把室内打扫得干干净净，<br>\n刚才和诺亚的对话还是一直萦绕在心头。",
  "0201Adv21_Hiro004": "（……我被她讨厌了）",
  "0201Adv21_Hiro005": "（管它呢。<br>\n　为这种事心情低落……可不像我的作风）",
  "0201Adv21_Sherry001": "希罗，没关系的！<br>\n打扫会有看守来做的！",
  "0201Adv21_Hiro006": "我知道。",
  "0201Adv21_Narrative005": "嘴上回答着，我加大了擦拭的力度，<br>\n没有回头看雪莉。",
  "0201Adv21_Sherry002": "难得的放风时间，<br>\n要不要和我一起去探索一下！？",
  "0201Adv21_Hiro007": "我拒绝。",
  "0201Adv21_Sherry003": "啊……？",
  "0201Adv21_Narrative006": "雪莉依然保持着笑容，<br>\n但看起来很茫然，好像不理解我的行为。",
  "0201Adv21_Hiro008": "（有个空瓶子……这是在晾干吗？）",
  "0201Adv21_Narrative007": "壁炉前放着一个空瓶，<br>\n那是之前在医务室看到梅露露拿着的安眠药瓶。",
  "0201Adv21_Narrative008": "里面是空的，<br>\n所以能够推测它是已经洗干净了，正在晾干。",
  "0201Adv21_Hiro009": "（这个瓶子看来<br>\n　就这样放着比较好）",
  "0201Adv21_Sherry004": "话说回来，希罗！<br>\n昨天我又去图书室调查了，<br>\n试着解读那些文字！",
  "0201Adv21_Hiro010": "你有好好听人说话吗？",
  "0201Adv21_Narrative009": "不一会，传来了一声沉重的响声。",
  "0201Adv21_Narrative010": "一看，原来是雪莉<br>\n用怪力从图书室搬来了大量的书，<br>\n然后把书都堆在了会客厅的桌子上。",
  "0201Adv21_Narrative011": "似乎是些古老的书籍，<br>\n书堆摇摇欲坠，扬起了灰尘。",
  "0201Adv21_Hiro011": "咳……！刚打扫完就……",
  "0201Adv21_Narrative012": "雪莉毫不在意，一边念叨着一边开始<br>\n对照笔记和书本。",
  "0201Adv21_Hiro012": "（……看来暂时是<br>\n　没法打扫这个房间了）",
  "0201Adv21_Narrative013": "我放弃了这里，准备打扫别的房间，<br>\n于是朝着房间出口走去。",
  "0201Adv21_Nanoka001": "——那之后我想了想。",
  "0201Adv21_Narrative014": "正要出门，冷不丁被人搭话。",
  "0201Adv21_Narrative015": "一看，是奈叶香<br>\n正靠墙站着。",
  "0201Adv21_Nanoka002": "我不会和你联手。<br>\n不过，看起来你是拥有力量的。",
  "0201Adv21_Hiro013": "……力量？",
  "0201Adv21_Nanoka003": "也许你能改变些什么。<br>\n……我就是这么觉得。",
  "0201Adv21_Hiro014": "我想确认一下，<br>\n你的【幻视】能看到未来吗？",
  "0201Adv21_Narrative016": "奈叶香犹豫了一下，<br>\n摇了摇头。",
  "0201Adv21_Nanoka004": "……我的【幻视】主要<br>\n能看到人或物的过去。<br>\n不过，在极其限定的情况下，偶尔也能看到未来。",
  "0201Adv21_Nanoka005": "如果是多次接触过的对象，<br>\n也有时能看到未来……",
  "0201Adv21_Narrative017": "奈叶香话说到一半，<br>\n面露悲色地低下了头。",
  "0201Adv21_Hiro015": "（多次接触？是亲人吗……？）",
  "0201Adv21_Nanoka006": "也许我从你身上<br>\n感觉到了什么。",
  "0201Adv21_Hiro016": "从我身上……？",
  "0201Adv21_Hiro017": "（是魔力之类的吗……？<br>\n　难道是因为魔女化造成的影响……）",
  "0201Adv21_Narrative018": "我稍作思考。<br>\n然后抬起头，凝视着奈叶香。",
  "0201Adv21_Hiro018": "关于【魔女化】，你知道些什么吗？",
  "0201Adv21_Narrative019": "奈叶香以前说过，<br>\n她掌握了很多关于这座监牢的信息。",
  "0201Adv21_Narrative020": "现在我想尽可能多获得一些<br>\n关于【魔女化】的信息。",
  "0201Adv21_Narrative021": "我恳切地问道。<br>\n奈叶香再次面露难色。",
  "0201Adv21_Nanoka007": "虽然我把握得也不是很清楚……<br>\n但我只知道，在转化为【残骸】的过程中，<br>\n每个人都会有不同的表现。",
  "0201Adv21_Nanoka008": "如果因为某些契机，被强烈刺激到内心的创伤，<br>\n就会迅速魔女化。",
  "0201Adv21_Nanoka009": "但如果仅仅只是积攒过多压力，<br>\n应该还是能较长时间保持理性。",
  "0201Adv21_Nanoka010": "也就是说，取决于自己心灵有多坚强吧。",
  "0201Adv21_Hiro019": "是这样吗……",
  "0201Adv21_Narrative022": "我稍稍放心了些。",
  "0201Adv21_Narrative023": "之前我险些失控，<br>\n但如今已经能克制住自己，保持理性。",
  "0201Adv21_Narrative024": "我确信自己已经挺过来了。",
  "0201Adv21_Hiro020": "（如果取决于自己内心的坚强程度，<br>\n　那我之后一定不会堕为魔女）",
  "0201Adv21_Narrative025": "正在我悄悄下定决心的时候，<br>\n奈叶香已经不知不觉间离开了。",
  "0201Adv21_Narrative026": "那天下午——",
  "0201Adv21_Narrative027": "我在地下巡视检查<br>\n各个少女房间的情况。",
  "0201Adv21_Narrative028": "打开栅栏门往里看，<br>\n确认每个房间是否有变化。",
  "0201Adv21_Hiro021": "（665，黑部奈叶香。<br>\n　664，宝生玛格——）",
  "0201Adv21_Narrative029": "空无一人的房间没有什么变化，<br>\n每个牢房的结构都差不多。",
  "0201Adv21_Narrative030": "湿度很高，光线昏暗，床铺这类的家具都很硬，<br>\n有一股陈旧的气味。",
  "0201Adv21_Narrative031": "每天多次的巡视<br>\n并不受其他少女的欢迎。",
  "0201Adv21_Narrative032": "但是，在这个充满异常的监牢里，<br>\n需要尽可能多一点规律。",
  "0201Adv21_Narrative033": "另外，确认状况是否有变，<br>\n也是巡视的意义之一。",
  "0201Adv21_Hiro022": "……呼。",
  "0201Adv21_Narrative034": "来到隔壁房间前，<br>\n我犹豫了一下要不要往里看。",
  "0201Adv21_Hiro023": "（661，城崎诺亚——）",
  "0201Adv21_Narrative035": "被涂成白色的室内，<br>\n没有人影。",
  "0201Adv21_Narrative036": "还未干透的颜料散发出的刺激性气味<br>\n扑鼻而来。",
  "0201Adv21_Hiro024": "（安安已经康复了，<br>\n　我看到她和诺亚一起去了画室）",
  "0201Adv21_Hiro025": "（那两个人看起来虽然那样，实际上可能关系还不错。<br>\n　也许只是我一个人在大惊小怪……）",
  "0201Adv21_Narrative037": "看到她们一起去画室的时候，<br>\n由于在意自己和诺亚之间的隔阂，<br>\n没敢向她们搭话。",
  "0201Adv21_Hiro026": "（已经回不去了、吗）",
  "0201Adv21_Narrative038": "在环境恶劣，却整齐有序的牢房中，<br>\n我走进这个被格格不入的白色完全覆盖的房间……",
  "0201Adv21_Narrative039": "凝视着自己的手掌。",
  "0201Adv21_Hiro027": "后悔可真不像我的作风。",
  "0201Adv21_Narrative040": "话音刚落——<br>\n突然间，背脊一阵发凉。",
  "0201Adv21_Narrative041": "感觉到有人正无声无息地站在我的背后。<br>\n还没来得及回头。",
  "0201Adv21_Unknown001": "——对不起。",
  "0201Adv21_Hiro028": "——",
  "0201Adv21_Narrative042": "伴随着钝重的冲击，视野开始摇晃。",
  "0201Adv21_Hiro029": "（怎么……回事……？<br>\n　被人……攻击了？）",
  "0201Adv21_Hiro030": "（被、谁……）",
  "0201Adv21_Narrative043": "剧烈的疼痛让我眼前一黑，<br>\n身体无法自由活动。",
  "0201Adv21_Narrative044": "膝盖瘫软，支撑不住身体，<br>\n最终，脸颊贴在了房间冰冷的地板上。",
  "0201Adv21_Unknown002": "很痛吧……",
  "0201Adv21_Unknown003": "但是，很抱歉，<br>\n必须请你去死才行……",
  "0201Adv21_Hiro031": "（这个声音是……）",
  "0201Adv21_Narrative045": "在逐渐模糊的意识中，我努力从记忆中搜寻这个声音。",
  "0201Adv21_Narrative046": "然而在得出准确答案之前，<br>\n我的意识就坠入了黑暗——"
}
}
