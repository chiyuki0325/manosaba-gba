    {"op": "PrintTextModified", "line": 12, "indent": 0, "params": {"Text": "——我非常重要的朋友自杀了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "她叫月代雪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative002"]}},
    {"op": "ResetText", "line": 16, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 17, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "150_1"}},
    {"op": "ModifyBackgroundExtended", "line": 18, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 19, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "当我推开房门时，<br>\n那根上吊绳还静静地悬挂在原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "我抬头怒视那根为她准备好的绞索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative004"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "我将背脊挺得笔直，<br>\n视线穿过那为了扼住她的咽喉而存在的圆环——<br>\n过于刺眼的憎恶，让我咬紧了牙关。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "我无法原谅。<br>\n无法原谅小雪的生命，就这么被区区一根绳子夺走。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "对我而言，这是不可饶恕的行为。<br>\n对我而言，这是不正确的行为。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "我最崇尚的就是【正确】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative008"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "这个世界上，<br>\n不该允许有哪怕一丝一毫的错误存在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "清澈的湖水中若是掺入一滴毒素，<br>\n生灵便会死绝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "精致的画布上若是划出一道划痕，<br>\n艺术的价值便随之泯灭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "完美的和声中若是混进一个错误的音符，<br>\n就会沦为刺耳的不协和音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "祈盼着正确的大脑中<br>\n若是寄生了一只害虫——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "整个世界，便会崩塌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative014"]}},
    {"op": "ModifyBackgroundExtended", "line": 45, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "150_2"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "——在绞索圆环的彼端，<br>\n我看见了造就这个错误世界的罪魁祸首。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative015"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "樱羽艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative016"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "从那一刻起，<br>\n“自杀”成为了在我心中最不可触碰的【禁忌】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv02_Narrative017"]}},
    {"op": "Gosub", "line": 53, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
