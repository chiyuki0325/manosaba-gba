    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-2", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "手机上弹出了典狱长发出的通知，<br>\n用餐时间到了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "牢房一开锁，<br>\n我就迅速动身前往食堂，<br>\n甚至没有回头看一眼正在打盹的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative002"]}},
    {"op": "ResetText", "line": 20, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 21, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 22, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 24, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "4_1"}},
    {"op": "ModifyBackgroundExtended", "line": 25, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 26, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "我已经完全记住了<br>\n时间表和监牢的地图。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "哪怕一秒钟我都不想浪费，<br>\n正打算疾步走向食堂，途中——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro001"]}},
    {"op": "ResetText", "line": 38, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 39, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 40, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["40", "200", "true", "0.3", "#000000"], "ScenePosition": [20.0, 50.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 41, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [-20.0, 36.0], "AppearanceAndTransition": "4_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Rotation": [0.0, 0.0, 40.0], "Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [33.0, 52.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR3", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 43, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Alisa-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 44, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 45, "indent": 0, "params": {"ActorIds": ["Alisa-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 46, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "在玄关大厅，<br>\n看守从玄关方向突然出现。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative005"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "异形怪物就在眼前，<br>\n我身体瞬间僵硬起来，不由得停下脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative006"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "你这混蛋，恶心死了放开我！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Alisa001"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "可别小看我啊！？<br>\n当心我弄死你！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "紫藤亚里沙被看守扛了起来，<br>\n正在挥动四肢拼命挣扎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative007"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "我和亚里沙对上了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative008"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "看、看什么看！你那是什么眼神！<br>\n你小子给我记住了！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Alisa003"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro002"]}},
    {"op": "HideActors", "line": 70, "indent": 0, "params": {"ActorIds": ["Hiro"], "Lazy": 0}},
    {"op": "PlaySfxModified", "line": 73, "indent": 0, "params": {"SfxPath": "Sfx_111", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "我默默拿出笔记本，<br>\n飞快记下几笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative009"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "（典型的不良少女，还有改造的余地）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro003"]}},
    {"op": "HideActors", "line": 79, "indent": 0, "params": {"ActorIds": ["Alisa-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 80, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 81, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PlaySfxModified", "line": 84, "indent": 0, "params": {"SfxPath": "Sfx_97", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "看守把亚里沙拖到了地下层。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative010"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "（她还想做逃跑这种愚蠢的事）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro004"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "按照规则，<br>\n在规定的放风时间之外走出监牢的人，<br>\n会被关进惩罚室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative011"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "（这就是为什么不遵守规则的人令人厌烦）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro005"]}},
    {"op": "StopBgm", "line": 94, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "无语地叹了口气。<br>\n我不再多想这件事，继续向食堂走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative012"]}},
    {"op": "ResetText", "line": 98, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 99, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 102, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyBackgroundExtended", "line": 103, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 104, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "我站在食堂入口，<br>\n逐个指着陆续进来的少女们开始点数。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative013"]}},
    {"op": "PlayBgm", "line": 108, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "……橘雪莉、远野汉娜，OK。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Duration": 0.20000000298023224, "Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "Wait", "line": 115, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "莲见蕾雅、佐伯米莉亚、宝生玛格，OK。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "Wait", "line": 120, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "冰上梅露露、樱羽艾玛、泽渡可可，可以进去了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Pensive"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "喂喂，她那是把自己当什么人了啊？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "我想，希罗大概是在点名吧……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Pensive"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "点什么鬼名啦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Coco002"]}},
    {"op": "HideAllCharacters", "line": 137, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "Wait", "line": 139, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "黑部奈叶香、夏目安安……就没人了吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro009"]}},
    {"op": "HideAllCharacters", "line": 143, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "我看向入口，<br>\n似乎不会再有人进来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative014"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "刚才我有看到，紫藤亚里沙被关进惩罚室了。<br>\n那么现在还少一个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative015"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "城崎诺亚去哪了？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro010"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "啊，城崎诺亚说她不吃饭了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Ema002"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "……是吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 158, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "既然不来那也没办法。<br>\n我环视一圈聚集在食堂的少女们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative016"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "大家都是初次来到食堂，都一样感到困惑。<br>\n当然，我也是第一次来，但已经调查好各种信息了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "这边的取餐处上摆放着食物，<br>\n大家自行取餐就好。。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro012"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "虽然卖相不佳，但我已经提前试毒了。<br>\n没有混入奇怪的东西。可以放心食用。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro013"]}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "所以你到底当自己是谁啊？校长吗你。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Coco003"]}},
    {"op": "HideAllCharacters", "line": 175, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "啊，还有座位似乎没有特别规定，<br>\n可以随意就座。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro014"]}},
    {"op": "HideAllCharacters", "line": 180, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "除了我和艾玛，其他人都是第一次见面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative018"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "刚才听完典狱长的讲话后，<br>\n大家也没怎么聊天，<br>\n就回到了标有各自囚犯编号的房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative019"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "不过似乎凭直觉感受到了彼此的气场，<br>\n自然而然三三两两地聚集起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative020"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "我迅速取了食物，独自坐下。<br>\n这时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative021"]}},
    {"op": "PlaySfxModified", "line": 191, "indent": 0, "params": {"SfxPath": "Sfx_112", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "可以坐你旁边吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia001"]}},
    {"op": "HideAllCharacters", "line": 197, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "蕾雅面带柔和的微笑，<br>\n在我旁边放下托盘。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "无所谓。你看起来还算个能沟通的人。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro015"]}},
    {"op": "HideAllCharacters", "line": 206, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "我大致能猜到蕾雅<br>\n为什么会来我这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative023"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "蕾雅和我一样，她也具有团队领头人的气质，<br>\n大概是在警惕我这个属性相近的人吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative024"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "不过是首领互争地盘而已。<br>\n这种情况我经历过几次。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative025"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "不过，还有一个意想不到的人<br>\n也坐到了我旁边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 216, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "是黑部奈叶香。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative027"]}},
    {"op": "HideAllCharacters", "line": 220, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "我也要坐在这里吃。行吗？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "行，请便。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro016"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "奈叶香并没有开始用餐，<br>\n而是用阴沉的眼神紧盯着我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative028"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "（是在怀疑我吗……有意思）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro017"]}},
    {"op": "HideAllCharacters", "line": 232, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "我故意不理会她的视线，<br>\n优雅地开始用餐。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Fearful1"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "呃……这味道真够呛的。<br>\n你居然能面不改色地吃下去。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia002"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "无论味道多么糟糕，都不应该表现在脸上，这样有失礼节。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "啊，确实，你说得对。抱歉。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "话说回来，希罗，<br>\n你对这座监牢有什么看法？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia004"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "有没有什么逃脱的方法呢？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 254, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "看守比你想像的要危险得多。<br>\n不应该违抗它们。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro019"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "应该优先掌握<br>\n关于这座监牢和魔女的知识。<br>\n啊，还有一点。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro020"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "我习惯在用餐时保持安静。<br>\n请不要向我搭话。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro021"]}},
    {"op": "ResetText", "line": 262, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "Wait", "line": 264, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 265, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "Wait", "line": 266, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "…………", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia006"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "…………", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "冷清的餐桌上，<br>\n我们三人沉默着进食。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative030"]}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "我一边往嘴里送着浓稠的饭菜，<br>\n一边用余光迅速观察着各个座位。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative031"]}},
    {"op": "HideAllCharacters", "line": 276, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 279, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "——可可和米莉亚、玛格坐在一起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative032"]}},
    {"op": "HideAllCharacters", "line": 284, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 286, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "——安安和梅露露坐在一起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative033"]}},
    {"op": "HideAllCharacters", "line": 290, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 292, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 293, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "——艾玛和雪莉、汉娜坐在一起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative034"]}},
    {"op": "HideAllCharacters", "line": 297, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "在彼此之间互相试探的<br>\n尴尬氛围中——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative035"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "突然，<br>\n汉娜站了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative036"]}},
    {"op": "ModifyCharacterExtended", "line": 303, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Hanna.Smile"}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "这就是我的魔法哇哇哇～", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 307, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "AnimateActorExtended", "line": 308, "indent": 0, "params": {"ActorIds": ["Hanna"], "Loop": 0, "ScenePositionY": "70|65|70", "Duration": "1|0.5|3"}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "话音刚落，<br>\n她的身体就轻飘飘地浮了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative037"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "虽然只有大约10厘米高，<br>\n但亲眼目睹她确实飘浮在空中，<br>\n她口中的【魔法】一词顿时具有了说服力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative038"]}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "（原来如此。<br>\n　远野汉娜拥有【飘浮】魔法）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro022"]}},
    {"op": "HideAllCharacters", "line": 316, "indent": 0, "params": {"Lazy": 0}},
    {"op": "UpdateWitchBook", "line": 318, "indent": 0, "params": {"Id": "Hanna", "Category": "Profile", "Version": 6}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "我迅速扫视了一圈所有人的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative039"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "虽然有几个少女显得很惊讶，<br>\n但看起来，几乎所有人都接受了魔法的存在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative040"]}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "当然也包括我在内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative041"]}},
    {"op": "ModifyCharacterExtended", "line": 326, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "是魔法展示会吗！<br>\n那么我也要来一个厉害的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 330, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "似乎受到刺激，雪莉一边宣布着，一边站了起来。<br>\n她拿起托盘上的苹果——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative042"]}},
    {"op": "ModifyCharacterExtended", "line": 334, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Ema003"]}},
    {"op": "HideAllCharacters", "line": 338, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 339, "indent": 0, "params": {}},
    {"op": "SpawnBlur", "line": 340, "indent": 0, "params": {"ActorId": "MainBackground", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 341, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [70.0, 30.0], "IdAndAppearance": "Sherry.Normal1,ArmR8", "SubId": "Middle"}},
    {"op": "PlaySfxModified", "line": 344, "indent": 0, "params": {"SfxPath": "Sfx_16", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "干净利落地把苹果捏得粉碎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative043"]}},
    {"op": "SpawnBlur", "line": 348, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 349, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 350, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8"}},
    {"op": "PrintTextModified", "line": 352, "indent": 0, "params": {"Text": "震惊！<br>\n雪莉的魔法竟然是【怪力】！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Sherry002"]}},
    {"op": "UpdateWitchBook", "line": 354, "indent": 0, "params": {"Id": "Sherry", "Category": "Profile", "Version": 6}},
    {"op": "HideAllCharacters", "line": 356, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 357, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR8"}},
    {"op": "ModifyCharacterExtended", "line": 358, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "我的苹果……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 364, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR1"}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "大家也来展示自己的魔法吧～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 368, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 370, "indent": 0, "params": {"Text": "当然，没有人回应雪莉的提议。<br>\n所有人都不发一言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative044"]}},
    {"op": "ModifyCharacterExtended", "line": 372, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 374, "indent": 0, "params": {"Text": "我不能使用魔法。因为我不是魔女。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro023"]}},
    {"op": "HideAllCharacters", "line": 376, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 377, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 379, "indent": 0, "params": {"Text": "啊，是这样啊……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 381, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 383, "indent": 0, "params": {"Text": "雪莉垂头丧气地回到座位上，<br>\n这时我站了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative045"]}},
    {"op": "ModifyCharacterExtended", "line": 385, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 387, "indent": 0, "params": {"Text": "我吃好了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro024"]}},
    {"op": "HideAllCharacters", "line": 389, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 390, "indent": 0, "params": {"Text": "说完，我走向取餐处，<br>\n开始往盘子里盛食物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative046"]}},
    {"op": "ModifyCharacterExtended", "line": 392, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 393, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 395, "indent": 0, "params": {"Text": "希罗，你不是已经吃完了吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia007"]}},
    {"op": "PrintTextModified", "line": 397, "indent": 0, "params": {"Text": "啊，这不是我的。<br>\n是给城崎诺亚的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro025"]}},
    {"op": "PrintTextModified", "line": 399, "indent": 0, "params": {"Text": "啊……原来如此。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia008"]}},
    {"op": "ModifyCharacterExtended", "line": 401, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "蕾雅轻轻一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative047"]}},
    {"op": "PrintTextModified", "line": 405, "indent": 0, "params": {"Text": "你真是个体贴的人啊。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Leia009"]}},
    {"op": "HideAllCharacters", "line": 407, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 409, "indent": 0, "params": {"Text": "（……体贴？我吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro026"]}},
    {"op": "PrintTextModified", "line": 411, "indent": 0, "params": {"Text": "我差点冷哼一声。<br>\n我只是想保持自己的正确而已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative048"]}},
    {"op": "PrintTextModified", "line": 413, "indent": 0, "params": {"Text": "（城崎诺亚没有来吃饭。<br>\n　人应该要吃饭。仅此而已）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Hiro027"]}},
    {"op": "PrintTextModified", "line": 415, "indent": 0, "params": {"Text": "我端着盛好食物的托盘，<br>\n离开了食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv07_Narrative049"]}},
    {"op": "Gosub", "line": 417, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 419, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv08", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv07_Narrative001": "手机上弹出了典狱长发出的通知，<br>\n用餐时间到了。",
  "0201Adv07_Narrative002": "牢房一开锁，<br>\n我就迅速动身前往食堂，<br>\n甚至没有回头看一眼正在打盹的艾玛。",
  "0201Adv07_Narrative003": "我已经完全记住了<br>\n时间表和监牢的地图。",
  "0201Adv07_Narrative004": "哪怕一秒钟我都不想浪费，<br>\n正打算疾步走向食堂，途中——",
  "0201Adv07_Hiro001": "——",
  "0201Adv07_Narrative005": "在玄关大厅，<br>\n看守从玄关方向突然出现。",
  "0201Adv07_Narrative006": "异形怪物就在眼前，<br>\n我身体瞬间僵硬起来，不由得停下脚步。",
  "0201Adv07_Alisa001": "你这混蛋，恶心死了放开我！",
  "0201Adv07_Alisa002": "可别小看我啊！？<br>\n当心我弄死你！！",
  "0201Adv07_Narrative007": "紫藤亚里沙被看守扛了起来，<br>\n正在挥动四肢拼命挣扎。",
  "0201Adv07_Narrative008": "我和亚里沙对上了视线。",
  "0201Adv07_Alisa003": "看、看什么看！你那是什么眼神！<br>\n你小子给我记住了！！",
  "0201Adv07_Hiro002": "…………",
  "0201Adv07_Narrative009": "我默默拿出笔记本，<br>\n飞快记下几笔。",
  "0201Adv07_Hiro003": "（典型的不良少女，还有改造的余地）",
  "0201Adv07_Narrative010": "看守把亚里沙拖到了地下层。",
  "0201Adv07_Hiro004": "（她还想做逃跑这种愚蠢的事）",
  "0201Adv07_Narrative011": "按照规则，<br>\n在规定的放风时间之外走出监牢的人，<br>\n会被关进惩罚室。",
  "0201Adv07_Hiro005": "（这就是为什么不遵守规则的人令人厌烦）",
  "0201Adv07_Narrative012": "无语地叹了口气。<br>\n我不再多想这件事，继续向食堂走去。",
  "0201Adv07_Narrative013": "我站在食堂入口，<br>\n逐个指着陆续进来的少女们开始点数。",
  "0201Adv07_Hiro006": "……橘雪莉、远野汉娜，OK。",
  "0201Adv07_Hiro007": "莲见蕾雅、佐伯米莉亚、宝生玛格，OK。",
  "0201Adv07_Hiro008": "冰上梅露露、樱羽艾玛、泽渡可可，可以进去了。",
  "0201Adv07_Coco001": "喂喂，她那是把自己当什么人了啊？",
  "0201Adv07_Ema001": "我想，希罗大概是在点名吧……",
  "0201Adv07_Coco002": "点什么鬼名啦。",
  "0201Adv07_Hiro009": "黑部奈叶香、夏目安安……就没人了吗？",
  "0201Adv07_Narrative014": "我看向入口，<br>\n似乎不会再有人进来了。",
  "0201Adv07_Narrative015": "刚才我有看到，紫藤亚里沙被关进惩罚室了。<br>\n那么现在还少一个人。",
  "0201Adv07_Hiro010": "城崎诺亚去哪了？",
  "0201Adv07_Ema002": "啊，城崎诺亚说她不吃饭了。",
  "0201Adv07_Hiro011": "……是吗。",
  "0201Adv07_Narrative016": "既然不来那也没办法。<br>\n我环视一圈聚集在食堂的少女们。",
  "0201Adv07_Narrative017": "大家都是初次来到食堂，都一样感到困惑。<br>\n当然，我也是第一次来，但已经调查好各种信息了。",
  "0201Adv07_Hiro012": "这边的取餐处上摆放着食物，<br>\n大家自行取餐就好。。",
  "0201Adv07_Hiro013": "虽然卖相不佳，但我已经提前试毒了。<br>\n没有混入奇怪的东西。可以放心食用。",
  "0201Adv07_Coco003": "所以你到底当自己是谁啊？校长吗你。",
  "0201Adv07_Hiro014": "啊，还有座位似乎没有特别规定，<br>\n可以随意就座。",
  "0201Adv07_Narrative018": "除了我和艾玛，其他人都是第一次见面。",
  "0201Adv07_Narrative019": "刚才听完典狱长的讲话后，<br>\n大家也没怎么聊天，<br>\n就回到了标有各自囚犯编号的房间。",
  "0201Adv07_Narrative020": "不过似乎凭直觉感受到了彼此的气场，<br>\n自然而然三三两两地聚集起来。",
  "0201Adv07_Narrative021": "我迅速取了食物，独自坐下。<br>\n这时——",
  "0201Adv07_Leia001": "可以坐你旁边吗？",
  "0201Adv07_Narrative022": "蕾雅面带柔和的微笑，<br>\n在我旁边放下托盘。",
  "0201Adv07_Hiro015": "无所谓。你看起来还算个能沟通的人。",
  "0201Adv07_Narrative023": "我大致能猜到蕾雅<br>\n为什么会来我这里。",
  "0201Adv07_Narrative024": "蕾雅和我一样，她也具有团队领头人的气质，<br>\n大概是在警惕我这个属性相近的人吧。",
  "0201Adv07_Narrative025": "不过是首领互争地盘而已。<br>\n这种情况我经历过几次。",
  "0201Adv07_Narrative026": "不过，还有一个意想不到的人<br>\n也坐到了我旁边。",
  "0201Adv07_Narrative027": "是黑部奈叶香。",
  "0201Adv07_Nanoka001": "我也要坐在这里吃。行吗？",
  "0201Adv07_Hiro016": "行，请便。",
  "0201Adv07_Narrative028": "奈叶香并没有开始用餐，<br>\n而是用阴沉的眼神紧盯着我。",
  "0201Adv07_Hiro017": "（是在怀疑我吗……有意思）",
  "0201Adv07_Narrative029": "我故意不理会她的视线，<br>\n优雅地开始用餐。",
  "0201Adv07_Leia002": "呃……这味道真够呛的。<br>\n你居然能面不改色地吃下去。",
  "0201Adv07_Hiro018": "无论味道多么糟糕，都不应该表现在脸上，这样有失礼节。",
  "0201Adv07_Leia003": "啊，确实，你说得对。抱歉。",
  "0201Adv07_Leia004": "话说回来，希罗，<br>\n你对这座监牢有什么看法？",
  "0201Adv07_Leia005": "有没有什么逃脱的方法呢？",
  "0201Adv07_Hiro019": "看守比你想像的要危险得多。<br>\n不应该违抗它们。",
  "0201Adv07_Hiro020": "应该优先掌握<br>\n关于这座监牢和魔女的知识。<br>\n啊，还有一点。",
  "0201Adv07_Hiro021": "我习惯在用餐时保持安静。<br>\n请不要向我搭话。",
  "0201Adv07_Leia006": "…………",
  "0201Adv07_Nanoka002": "…………",
  "0201Adv07_Narrative030": "冷清的餐桌上，<br>\n我们三人沉默着进食。",
  "0201Adv07_Narrative031": "我一边往嘴里送着浓稠的饭菜，<br>\n一边用余光迅速观察着各个座位。",
  "0201Adv07_Narrative032": "——可可和米莉亚、玛格坐在一起。",
  "0201Adv07_Narrative033": "——安安和梅露露坐在一起。",
  "0201Adv07_Narrative034": "——艾玛和雪莉、汉娜坐在一起。",
  "0201Adv07_Narrative035": "在彼此之间互相试探的<br>\n尴尬氛围中——",
  "0201Adv07_Narrative036": "突然，<br>\n汉娜站了起来。",
  "0201Adv07_Hanna001": "这就是我的魔法哇哇哇～",
  "0201Adv07_Narrative037": "话音刚落，<br>\n她的身体就轻飘飘地浮了起来。",
  "0201Adv07_Narrative038": "虽然只有大约10厘米高，<br>\n但亲眼目睹她确实飘浮在空中，<br>\n她口中的【魔法】一词顿时具有了说服力。",
  "0201Adv07_Hiro022": "（原来如此。<br>\n　远野汉娜拥有【飘浮】魔法）",
  "0201Adv07_Narrative039": "我迅速扫视了一圈所有人的表情。",
  "0201Adv07_Narrative040": "虽然有几个少女显得很惊讶，<br>\n但看起来，几乎所有人都接受了魔法的存在。",
  "0201Adv07_Narrative041": "当然也包括我在内。",
  "0201Adv07_Sherry001": "是魔法展示会吗！<br>\n那么我也要来一个厉害的！",
  "0201Adv07_Narrative042": "似乎受到刺激，雪莉一边宣布着，一边站了起来。<br>\n她拿起托盘上的苹果——",
  "0201Adv07_Ema003": "啊……",
  "0201Adv07_Narrative043": "干净利落地把苹果捏得粉碎。",
  "0201Adv07_Sherry002": "震惊！<br>\n雪莉的魔法竟然是【怪力】！",
  "0201Adv07_Ema004": "我的苹果……",
  "0201Adv07_Sherry003": "大家也来展示自己的魔法吧～！",
  "0201Adv07_Narrative044": "当然，没有人回应雪莉的提议。<br>\n所有人都不发一言。",
  "0201Adv07_Hiro023": "我不能使用魔法。因为我不是魔女。",
  "0201Adv07_Sherry004": "啊，是这样啊……",
  "0201Adv07_Narrative045": "雪莉垂头丧气地回到座位上，<br>\n这时我站了起来。",
  "0201Adv07_Hiro024": "我吃好了。",
  "0201Adv07_Narrative046": "说完，我走向取餐处，<br>\n开始往盘子里盛食物。",
  "0201Adv07_Leia007": "希罗，你不是已经吃完了吗？",
  "0201Adv07_Hiro025": "啊，这不是我的。<br>\n是给城崎诺亚的。",
  "0201Adv07_Leia008": "啊……原来如此。",
  "0201Adv07_Narrative047": "蕾雅轻轻一笑。",
  "0201Adv07_Leia009": "你真是个体贴的人啊。",
  "0201Adv07_Hiro026": "（……体贴？我吗？）",
  "0201Adv07_Narrative048": "我差点冷哼一声。<br>\n我只是想保持自己的正确而已。",
  "0201Adv07_Hiro027": "（城崎诺亚没有来吃饭。<br>\n　人应该要吃饭。仅此而已）",
  "0201Adv07_Narrative049": "我端着盛好食物的托盘，<br>\n离开了食堂。"
}
}
