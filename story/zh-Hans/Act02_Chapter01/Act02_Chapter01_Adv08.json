  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-3", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 12, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 15, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "我端着食物托盘，<br>\n站在诺亚的房间门口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative001"]}},
    {"op": "PlayBgm", "line": 19, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "这到底是怎么回事……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro001"]}},
    {"op": "AnimateActorExtended", "line": 23, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 24, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["200", "200", "true", "0.5", "#000000cc"], "ScenePosition": [-7.0, 50.0], "Rotation": [0.0, 0.0, -10.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 25, "indent": 0, "params": {"Scale": [1.5], "TintColor": "#ff0000", "Lazy": 0, "ScenePosition": [10.0, 80.0], "AppearanceAndTransition": "1_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Scale": [1.149999976158142], "Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Smile1,ArmL5", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 27, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Noah-Front"], "Enable": 1}},
    {"op": "ModifyBackgroundExtended", "line": 28, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 29, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "我惊呆了。<br>\n——房间内部被喷漆涂成了整面鲜红色。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "你这是要干什么！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "我严厉地质问道，<br>\n诺亚一脸疑惑地转过身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmL5", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "嗯？慌慌张张的，有什么事吗？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah001"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "为什么把房间涂成红色！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro003"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "喷漆颜料的气味充满了整个房间，<br>\n让人不禁屏住呼吸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "因为它怎么都不肯变成诺亚想画的样子，<br>\n所以就想把它涂掉。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah002"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Flushed,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "然后，就全都变成这样子了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah003"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "看着稍微有些害羞的诺亚，<br>\n我的视野开始摇晃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative005"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "（这是错误的，这是错误的，这是错误的！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "把它清理掉！立刻！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "欸～为什么啊？<br>\n诺亚只是在画画而已啊？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "不论这对你来说是爱好还是艺术，<br>\n熏人的气味已经飘到过道里了，<br>\n这对其他人来说就是一种骚扰行为。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Pensive1,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "……是这样啊，我没注意到……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah005"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "看着垂头丧气的诺亚，<br>\n我深深地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "虽然我很想让你想做什么就做什么，<br>\n但是，到这种程度，已经不能坐视不理了。<br>\n不过，清理起来应该会很麻烦，所以我也会帮忙。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro007"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "淋浴房里应该有肥皂，<br>\n用肥皂来擦的话……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmL5", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "啊，不用。不需要那种东西的。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah006"]}},
    {"op": "PlaySfxModified", "line": 92, "indent": 0, "params": {"SfxPath": "Sfx_113", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 94, "indent": 0, "params": {"Scale": [1.5], "TintColor": "#ffffff", "Duration": 3.0, "Lazy": 0, "ScenePosition": [10.0, 80.0], "AppearanceAndTransition": "1_1", "SubId": "Front"}},
    {"op": "Wait", "line": 95, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "诺亚轻描淡写地说着，<br>\n然后将所有的红色<br>\n都哧溜溜地收进了喷漆罐里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative007"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "看到这明显超出常理的液体移动，<br>\n我恍然大悟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "（魔法……她的魔法是让画动起来……<br>\n　不，是能操控液体……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro009"]}},
    {"op": "UpdateWitchBook", "line": 105, "indent": 0, "params": {"Id": "Noah", "Category": "Profile", "Version": 8}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Smile1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "你看，干净了吧～！这样可以了吗？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah007"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "房间里已经恢复原状了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "嗯……是啊。那就这样吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmL5", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "那我就开始画下一幅画啦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah008"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "不行不行，你有没有听我说话？<br>\n这里禁止画画。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Pensive1,ArmL5", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "欸——那不可能的啊？<br>\n因为诺亚不画画就活不下去啊。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah009"]}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "忍耐一下吧。<br>\n这里是大家一起生活的地方。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro012"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Angry1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "唔——我忍不了——", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah010"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "诺亚鼓起腮帮子，<br>\n显然心情变得很糟糕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative010"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "（真是的……这种不愿意顾及他人的态度，<br>\n真的很像【小雪】）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro013"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "突然，这个想法浮现在脑海中，<br>\n使我的感情泛起涟漪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative011"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "——不能放着她不管。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative012"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "……好吧。<br>\n我来帮你另找一个能进行艺术创作的地方。<br>\n这样可以吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmR4,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "不能在这里画吗？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah011"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "不行。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Angry1,ArmR1,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "小气鬼～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah012"]}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "随你怎么说。只要我在，<br>\n就不许你擅自行动。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro016"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "啊，对了，我给你带来了这个。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro017"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "我这才想起自己还端着食物托盘，<br>\n赶紧递给了她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative013"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "刚刚还气鼓鼓的诺亚，立刻露出了笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Smile1,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "哇，是饭啊！说起来我肚子饿了！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah013"]}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmR4,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "谢谢你，呃……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah014"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "希罗。我叫二阶堂希罗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Smile1,ArmR1,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "谢谢你，希罗！<br>\n那个，诺亚的名字是——", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah015"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "我知道。你的名字是城崎诺亚。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Surprised1,ArmR1,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "欸，为什么会知道呢？希罗好厉害啊。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Noah016"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "……下次要准时去吃饭。<br>\n就算你不愿意，我也会强行把你带去的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Hiro020"]}},
    {"op": "HideActors", "line": 191, "indent": 0, "params": {"ActorIds": ["Noah-Front", "MainBackground-Front", "Hiro"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 192, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 193, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "既然已经把食物托盘交给她了，我的任务就完成了。<br>\n我移开视线，回到了自己的房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv08_Narrative015"]}},
    {"op": "Gosub", "line": 197, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 199, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv09", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv08_Narrative001": "我端着食物托盘，<br>\n站在诺亚的房间门口。",
  "0201Adv08_Hiro001": "这到底是怎么回事……",
  "0201Adv08_Narrative002": "我惊呆了。<br>\n——房间内部被喷漆涂成了整面鲜红色。",
  "0201Adv08_Hiro002": "你这是要干什么！？",
  "0201Adv08_Narrative003": "我严厉地质问道，<br>\n诺亚一脸疑惑地转过身来。",
  "0201Adv08_Noah001": "嗯？慌慌张张的，有什么事吗？",
  "0201Adv08_Hiro003": "为什么把房间涂成红色！",
  "0201Adv08_Narrative004": "喷漆颜料的气味充满了整个房间，<br>\n让人不禁屏住呼吸。",
  "0201Adv08_Noah002": "因为它怎么都不肯变成诺亚想画的样子，<br>\n所以就想把它涂掉。",
  "0201Adv08_Noah003": "然后，就全都变成这样子了。",
  "0201Adv08_Narrative005": "看着稍微有些害羞的诺亚，<br>\n我的视野开始摇晃。",
  "0201Adv08_Hiro004": "（这是错误的，这是错误的，这是错误的！）",
  "0201Adv08_Hiro005": "把它清理掉！立刻！",
  "0201Adv08_Noah004": "欸～为什么啊？<br>\n诺亚只是在画画而已啊？",
  "0201Adv08_Hiro006": "不论这对你来说是爱好还是艺术，<br>\n熏人的气味已经飘到过道里了，<br>\n这对其他人来说就是一种骚扰行为。",
  "0201Adv08_Noah005": "……是这样啊，我没注意到……",
  "0201Adv08_Narrative006": "看着垂头丧气的诺亚，<br>\n我深深地叹了口气。",
  "0201Adv08_Hiro007": "虽然我很想让你想做什么就做什么，<br>\n但是，到这种程度，已经不能坐视不理了。<br>\n不过，清理起来应该会很麻烦，所以我也会帮忙。",
  "0201Adv08_Hiro008": "淋浴房里应该有肥皂，<br>\n用肥皂来擦的话……",
  "0201Adv08_Noah006": "啊，不用。不需要那种东西的。",
  "0201Adv08_Narrative007": "诺亚轻描淡写地说着，<br>\n然后将所有的红色<br>\n都哧溜溜地收进了喷漆罐里。",
  "0201Adv08_Narrative008": "看到这明显超出常理的液体移动，<br>\n我恍然大悟。",
  "0201Adv08_Hiro009": "（魔法……她的魔法是让画动起来……<br>\n　不，是能操控液体……？）",
  "0201Adv08_Noah007": "你看，干净了吧～！这样可以了吗？",
  "0201Adv08_Narrative009": "房间里已经恢复原状了。",
  "0201Adv08_Hiro010": "嗯……是啊。那就这样吧。",
  "0201Adv08_Noah008": "那我就开始画下一幅画啦。",
  "0201Adv08_Hiro011": "不行不行，你有没有听我说话？<br>\n这里禁止画画。",
  "0201Adv08_Noah009": "欸——那不可能的啊？<br>\n因为诺亚不画画就活不下去啊。",
  "0201Adv08_Hiro012": "忍耐一下吧。<br>\n这里是大家一起生活的地方。",
  "0201Adv08_Noah010": "唔——我忍不了——",
  "0201Adv08_Narrative010": "诺亚鼓起腮帮子，<br>\n显然心情变得很糟糕。",
  "0201Adv08_Hiro013": "（真是的……这种不愿意顾及他人的态度，<br>\n真的很像【小雪】）",
  "0201Adv08_Narrative011": "突然，这个想法浮现在脑海中，<br>\n使我的感情泛起涟漪。",
  "0201Adv08_Narrative012": "——不能放着她不管。",
  "0201Adv08_Hiro014": "……好吧。<br>\n我来帮你另找一个能进行艺术创作的地方。<br>\n这样可以吗？",
  "0201Adv08_Noah011": "不能在这里画吗？",
  "0201Adv08_Hiro015": "不行。",
  "0201Adv08_Noah012": "小气鬼～",
  "0201Adv08_Hiro016": "随你怎么说。只要我在，<br>\n就不许你擅自行动。",
  "0201Adv08_Hiro017": "啊，对了，我给你带来了这个。",
  "0201Adv08_Narrative013": "我这才想起自己还端着食物托盘，<br>\n赶紧递给了她。",
  "0201Adv08_Narrative014": "刚刚还气鼓鼓的诺亚，立刻露出了笑容。",
  "0201Adv08_Noah013": "哇，是饭啊！说起来我肚子饿了！",
  "0201Adv08_Noah014": "谢谢你，呃……",
  "0201Adv08_Hiro018": "希罗。我叫二阶堂希罗。",
  "0201Adv08_Noah015": "谢谢你，希罗！<br>\n那个，诺亚的名字是——",
  "0201Adv08_Hiro019": "我知道。你的名字是城崎诺亚。",
  "0201Adv08_Noah016": "欸，为什么会知道呢？希罗好厉害啊。",
  "0201Adv08_Hiro020": "……下次要准时去吃饭。<br>\n就算你不愿意，我也会强行把你带去的。",
  "0201Adv08_Narrative015": "既然已经把食物托盘交给她了，我的任务就完成了。<br>\n我移开视线，回到了自己的房间。"
}
}
