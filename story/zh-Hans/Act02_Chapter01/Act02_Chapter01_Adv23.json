{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter01/Act02_Chapter01_Adv23",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-18", "line": 4, "indent": 0},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "梅露露的尸体被发现后不久——<br>\n手机就收到了典狱长的消息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative001"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "『唉……收到一份报告。<br>\n　据说发生了一起令人痛心的凶杀案啊』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative002"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "『这到底是怎么回事……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative003"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "『总之，请大家立即前往会客厅集合。<br>\n　不遵守者将会被看守带走……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative004"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "虽然大家还在无所适从，<br>\n但我们只能服从出现在此的看守，别无他法……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative005"]}},
    {"op": "ResetText", "line": 24, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 26, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "ModifyBackgroundExtended", "line": 27, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 28, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 30, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "会客厅里12名少女全都聚集在一起，<br>\n除了梅露露以外。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative006"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "一具明显死于他杀的尸体。大家应该都是第一次目睹吧。<br>\n当然，我也是。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative007"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "她们每个人都脸色苍白。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "真的发生了呢，凶杀案！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Sherry001"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "……除了一个人以外。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative009"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 45, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 60.0], "AppearanceAndTransition": "5_1", "SubId": "Middle"}},
    {"op": "Wait", "line": 46, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "AnimateActorExtended", "line": 48, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "有的人在哭泣，<br>\n有的人在强忍呕吐感，<br>\n有的人一直发出小声的悲鸣。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative010"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "这些少女们看我的眼神……<br>\n明显变了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative011"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "那眼神充满恐惧，<br>\n就像在看杀人犯一样——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative012"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "（那是什么眼神……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro001"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "我因为极度不适<br>\n而想要对她们大吼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative013"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "但是，即使仍然处于混乱之中，<br>\n我还是搞清楚了一些状况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative014"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "我倒在了尸体所在的房间里。<br>\n而且全身沾满了白色颜料和飞溅的血迹，一副凄惨的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative015"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "（现在不管我说什么，<br>\n　都只会加深她们的恐惧而已）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro002"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "而且我的后脑勺遭受重击，<br>\n直到刚才还处于昏迷状态。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative016"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "从自己身上散发出的不详的血腥味，<br>\n让我胃中翻江倒海，头痛欲裂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative017"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "——感觉糟透了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative018"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "（现在只能静观事态发展……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro003"]}},
    {"op": "HideActors", "line": 75, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Duration": 0.0, "Lazy": 0}},
    {"op": "PlaySfxModified", "line": 78, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "听到典狱长的扑翅声响起，<br>\n我们之间的气氛变得更加紧张。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "唉……结果还是<br>\n发生了凶杀案……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden001"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "今晚，将会举行【魔女审判】。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden002"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "请各位务必从在押囚犯当中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden003"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "我们会用特殊方法行刑，<br>\n令不会轻易死亡的魔女永久地安息。<br>\n那会是非常……非常残酷的方法。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden004"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "另外，有件事要向全体囚犯通告。<br>\n如果没有选出凶手，将会对所有人处刑。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden005"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "听完典狱长平淡地解释这些内容，<br>\n她们喧闹起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 96, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "全员处决也太荒唐了哇……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "喂，你这只臭鸟在胡说什么！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "与此同时，典狱长也显得很困惑，<br>\n歪着头开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "我只是按照主人的命令，<br>\n转达这些早已定好的事项而已……<br>", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden006"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "只是，决定这些事项的人，也就是主人都被杀害了，<br>\n我也感到很惊讶，不知该如何是好。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden007"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "嘈杂声更加强烈了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative022"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "（冰上梅露露向典狱长下达命令……！？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro004"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "大家都还没有理解情况时，<br>\n奈叶香迈出一步说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Warden.1"}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "也就是说，监牢管理方……<br>\n在背后牵线的【幕后黑手】，【魔女】的真实身份，<br>\n就是冰上梅露露？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "大概就是这样吧……？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden008"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "……这样。原来是这样啊。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Nanoka002"]}},
    {"op": "HideAllCharacters", "line": 141, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "（冰上梅露露……<br>\n　明明表现得那么会关心人，居然是魔女吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro005"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "老实说，<br>\n我不知道该如何看待这件事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative024"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "虽然我和梅露露交谈过几次，<br>\n但并没有多亲密。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative025"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "即便如此，她被杀害的样子仍在我脑海中挥之不去，<br>\n即使听说她是邪恶一方，我的心还是隐隐作痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative026"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "（即使相处的时间这么短，原来也会产生感情……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "虽然梅露露大人不在了，<br>\n但监牢的规定并不会因此消失……<br>\n只能像以前一样继续运营下去了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden009"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "仔细想想，<br>\n这里几乎都是由我来管理的。<br>\n即使没有梅露露大人也能运转。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden010"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "说不定因为那个很会使唤鸟的上司消失了，<br>\n反而工作更顺畅了呢……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden011"]}},
    {"op": "StopBgm", "line": 167, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "一直在嘀咕着什么的典狱长<br>\n突然展开了翅膀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative027"]}},
    {"op": "PlayBgm", "line": 171, "indent": 0, "params": {"BgmPath": "Bgm_10_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "这是个好机会。<br>\n现在让我们引入之前就一直在准备的机制，<br>\n【先行投票】吧！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden012"]}},
    {"op": "HideAllCharacters", "line": 175, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "先行、投票……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Ema001"]}},
    {"op": "HideAllCharacters", "line": 180, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "是的。在调查之前先进行投票，<br>\n将最可疑的囚犯拘禁起来。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden013"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "这样一来，调查期间就不会发生犯人做手脚的情况，<br>\n也更容易确定凶手。<br>\n也就是说审判能更早结束。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden014"]}},
    {"op": "HideAllCharacters", "line": 187, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "你是想尽快结束吧？<br>\n嗯……我倒是能理解你的心情。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Margo001"]}},
    {"op": "HideAllCharacters", "line": 192, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "那么各位，<br>\n请拿出自己的手机，票选出心中认为最可疑的囚犯吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden015"]}},
    {"op": "HideAllCharacters", "line": 197, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "……等等等等。<br>\n这不是什么都没变吗。<br>\n反而更糟了吧……？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "虽然手机确实带在身上……<br>\n但是……唔唔……对不起。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Leia001"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "少女们虽然犹豫不决，<br>\n但还是拿出了手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative028"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "我只能呆呆地站在那里，<br>\n看着这一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative029"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "（如果搞什么先行投票的话，<br>\n　不管怎么想都——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro007"]}},
    {"op": "HideAllCharacters", "line": 214, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 217, "indent": 0, "params": {"SfxPath": "Sfx_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 219, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Middle"}},
    {"op": "Wait", "line": 220, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyTextPrinter", "line": 222, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PlaySfxModified", "line": 225, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "会客厅的大屏幕突然亮起来，<br>\n紧接着响起一阵滑稽的庆祝音效。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative030"]}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "屏幕上显示的是……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, 5.0], "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "由于获得了压倒性多数的投票，<br>\n最终决定是二阶堂希罗小姐！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden016"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "我们将拘禁你直到魔女审判开庭哦～。<br>\n那么就请各位<br>\n努力找出凶手吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Warden017"]}},
    {"op": "HideAllCharacters", "line": 237, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 238, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyTextPrinter", "line": 239, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 240, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Middle"}},
    {"op": "Wait", "line": 241, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlaySfxModified", "line": 244, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "开、开什么玩笑——唔！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, -20.0], "IdAndAppearance": "Jailer.1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "我的抗议声<br>\n被有着许多长长手臂的看守打断了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative032"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "我不仅被堵住了嘴，<br>\n双臂还被从腋下擒抱，动弹不得。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative033"]}},
    {"op": "SpawnBlur", "line": 256, "indent": 0, "params": {"ActorId": "Jailer-Middle"}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Scale": [0.75], "Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "希罗……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Scale": [0.75], "Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "希罗……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Noah001"]}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "看守的腕力非同寻常，<br>\n无论我如何挣扎都纹丝不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative034"]}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "在这种状态下，<br>\n我瞪视着在场的所有少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative035"]}},
    {"op": "HideAllCharacters", "line": 273, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Scale": [0.75], "Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Fearful1"}},
    {"op": "ModifyCharacterExtended", "line": 275, "indent": 0, "params": {"Scale": [0.75], "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "噫……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Miria001"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "好可怕～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Coco002"]}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "我被选中了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative036"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "被这里的少女们<br>\n认定为杀人凶手——【魔女】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative037"]}},
    {"op": "HideAllCharacters", "line": 285, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "（好啊……你们全都是我的敌人……！！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Hiro009"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "胸中刚刚萌生的<br>\n那一丝情感碎片已经荡然无存。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative038"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "我被看守带走的同时，<br>\n用仿佛要射杀所有人的眼神一直瞪视着她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv23_Narrative039"]}},
    {"op": "UpdateWitchBook", "line": 293, "indent": 0, "params": {"Id": "Meruru", "Category": "Profile", "Version": 6}},
    {"op": "Wait", "line": 294, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "Gosub", "line": 296, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 298, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv24", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv23_Narrative001": "梅露露的尸体被发现后不久——<br>\n手机就收到了典狱长的消息。",
  "0201Adv23_Narrative002": "『唉……收到一份报告。<br>\n　据说发生了一起令人痛心的凶杀案啊』",
  "0201Adv23_Narrative003": "『这到底是怎么回事……』",
  "0201Adv23_Narrative004": "『总之，请大家立即前往会客厅集合。<br>\n　不遵守者将会被看守带走……』",
  "0201Adv23_Narrative005": "虽然大家还在无所适从，<br>\n但我们只能服从出现在此的看守，别无他法……",
  "0201Adv23_Narrative006": "会客厅里12名少女全都聚集在一起，<br>\n除了梅露露以外。",
  "0201Adv23_Narrative007": "一具明显死于他杀的尸体。大家应该都是第一次目睹吧。<br>\n当然，我也是。",
  "0201Adv23_Narrative008": "她们每个人都脸色苍白。",
  "0201Adv23_Sherry001": "真的发生了呢，凶杀案！",
  "0201Adv23_Narrative009": "……除了一个人以外。",
  "0201Adv23_Narrative010": "有的人在哭泣，<br>\n有的人在强忍呕吐感，<br>\n有的人一直发出小声的悲鸣。",
  "0201Adv23_Narrative011": "这些少女们看我的眼神……<br>\n明显变了。",
  "0201Adv23_Narrative012": "那眼神充满恐惧，<br>\n就像在看杀人犯一样——",
  "0201Adv23_Hiro001": "（那是什么眼神……！）",
  "0201Adv23_Narrative013": "我因为极度不适<br>\n而想要对她们大吼。",
  "0201Adv23_Narrative014": "但是，即使仍然处于混乱之中，<br>\n我还是搞清楚了一些状况。",
  "0201Adv23_Narrative015": "我倒在了尸体所在的房间里。<br>\n而且全身沾满了白色颜料和飞溅的血迹，一副凄惨的样子。",
  "0201Adv23_Hiro002": "（现在不管我说什么，<br>\n　都只会加深她们的恐惧而已）",
  "0201Adv23_Narrative016": "而且我的后脑勺遭受重击，<br>\n直到刚才还处于昏迷状态。",
  "0201Adv23_Narrative017": "从自己身上散发出的不详的血腥味，<br>\n让我胃中翻江倒海，头痛欲裂。",
  "0201Adv23_Narrative018": "——感觉糟透了。",
  "0201Adv23_Hiro003": "（现在只能静观事态发展……）",
  "0201Adv23_Narrative019": "听到典狱长的扑翅声响起，<br>\n我们之间的气氛变得更加紧张。",
  "0201Adv23_Warden001": "唉……结果还是<br>\n发生了凶杀案……",
  "0201Adv23_Warden002": "今晚，将会举行【魔女审判】。",
  "0201Adv23_Warden003": "请各位务必从在押囚犯当中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑。",
  "0201Adv23_Warden004": "我们会用特殊方法行刑，<br>\n令不会轻易死亡的魔女永久地安息。<br>\n那会是非常……非常残酷的方法。",
  "0201Adv23_Warden005": "另外，有件事要向全体囚犯通告。<br>\n如果没有选出凶手，将会对所有人处刑。",
  "0201Adv23_Narrative020": "听完典狱长平淡地解释这些内容，<br>\n她们喧闹起来。",
  "0201Adv23_Hanna001": "全员处决也太荒唐了哇……！",
  "0201Adv23_Alisa001": "喂，你这只臭鸟在胡说什么！！",
  "0201Adv23_Narrative021": "与此同时，典狱长也显得很困惑，<br>\n歪着头开口说道。",
  "0201Adv23_Warden006": "我只是按照主人的命令，<br>\n转达这些早已定好的事项而已……<br>",
  "0201Adv23_Warden007": "只是，决定这些事项的人，也就是主人都被杀害了，<br>\n我也感到很惊讶，不知该如何是好。",
  "0201Adv23_Narrative022": "嘈杂声更加强烈了。",
  "0201Adv23_Hiro004": "（冰上梅露露向典狱长下达命令……！？）",
  "0201Adv23_Narrative023": "大家都还没有理解情况时，<br>\n奈叶香迈出一步说道。",
  "0201Adv23_Nanoka001": "也就是说，监牢管理方……<br>\n在背后牵线的【幕后黑手】，【魔女】的真实身份，<br>\n就是冰上梅露露？",
  "0201Adv23_Warden008": "大概就是这样吧……？",
  "0201Adv23_Nanoka002": "……这样。原来是这样啊。",
  "0201Adv23_Hiro005": "（冰上梅露露……<br>\n　明明表现得那么会关心人，居然是魔女吗）",
  "0201Adv23_Narrative024": "老实说，<br>\n我不知道该如何看待这件事。",
  "0201Adv23_Narrative025": "虽然我和梅露露交谈过几次，<br>\n但并没有多亲密。",
  "0201Adv23_Narrative026": "即便如此，她被杀害的样子仍在我脑海中挥之不去，<br>\n即使听说她是邪恶一方，我的心还是隐隐作痛。",
  "0201Adv23_Hiro006": "（即使相处的时间这么短，原来也会产生感情……）",
  "0201Adv23_Warden009": "虽然梅露露大人不在了，<br>\n但监牢的规定并不会因此消失……<br>\n只能像以前一样继续运营下去了。",
  "0201Adv23_Warden010": "仔细想想，<br>\n这里几乎都是由我来管理的。<br>\n即使没有梅露露大人也能运转。",
  "0201Adv23_Warden011": "说不定因为那个很会使唤鸟的上司消失了，<br>\n反而工作更顺畅了呢……",
  "0201Adv23_Narrative027": "一直在嘀咕着什么的典狱长<br>\n突然展开了翅膀。",
  "0201Adv23_Warden012": "这是个好机会。<br>\n现在让我们引入之前就一直在准备的机制，<br>\n【先行投票】吧！",
  "0201Adv23_Ema001": "先行、投票……？",
  "0201Adv23_Warden013": "是的。在调查之前先进行投票，<br>\n将最可疑的囚犯拘禁起来。",
  "0201Adv23_Warden014": "这样一来，调查期间就不会发生犯人做手脚的情况，<br>\n也更容易确定凶手。<br>\n也就是说审判能更早结束。",
  "0201Adv23_Margo001": "你是想尽快结束吧？<br>\n嗯……我倒是能理解你的心情。",
  "0201Adv23_Warden015": "那么各位，<br>\n请拿出自己的手机，票选出心中认为最可疑的囚犯吧。",
  "0201Adv23_Coco001": "……等等等等。<br>\n这不是什么都没变吗。<br>\n反而更糟了吧……？",
  "0201Adv23_Leia001": "虽然手机确实带在身上……<br>\n但是……唔唔……对不起。",
  "0201Adv23_Narrative028": "少女们虽然犹豫不决，<br>\n但还是拿出了手机。",
  "0201Adv23_Narrative029": "我只能呆呆地站在那里，<br>\n看着这一切。",
  "0201Adv23_Hiro007": "（如果搞什么先行投票的话，<br>\n　不管怎么想都——）",
  "0201Adv23_Narrative030": "会客厅的大屏幕突然亮起来，<br>\n紧接着响起一阵滑稽的庆祝音效。",
  "0201Adv23_Narrative031": "屏幕上显示的是……",
  "0201Adv23_Warden016": "由于获得了压倒性多数的投票，<br>\n最终决定是二阶堂希罗小姐！",
  "0201Adv23_Warden017": "我们将拘禁你直到魔女审判开庭哦～。<br>\n那么就请各位<br>\n努力找出凶手吧。",
  "0201Adv23_Hiro008": "开、开什么玩笑——唔！",
  "0201Adv23_Narrative032": "我的抗议声<br>\n被有着许多长长手臂的看守打断了。",
  "0201Adv23_Narrative033": "我不仅被堵住了嘴，<br>\n双臂还被从腋下擒抱，动弹不得。",
  "0201Adv23_Ema002": "希罗……！",
  "0201Adv23_Noah001": "希罗……",
  "0201Adv23_Narrative034": "看守的腕力非同寻常，<br>\n无论我如何挣扎都纹丝不动。",
  "0201Adv23_Narrative035": "在这种状态下，<br>\n我瞪视着在场的所有少女。",
  "0201Adv23_Miria001": "噫……",
  "0201Adv23_Coco002": "好可怕～",
  "0201Adv23_Narrative036": "我被选中了。",
  "0201Adv23_Narrative037": "被这里的少女们<br>\n认定为杀人凶手——【魔女】。",
  "0201Adv23_Hiro009": "（好啊……你们全都是我的敌人……！！）",
  "0201Adv23_Narrative038": "胸中刚刚萌生的<br>\n那一丝情感碎片已经荡然无存。",
  "0201Adv23_Narrative039": "我被看守带走的同时，<br>\n用仿佛要射杀所有人的眼神一直瞪视着她们。"
}
}
