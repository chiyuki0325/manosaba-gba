  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-11", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "19_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我和诺亚从正门走出来，<br>\n踏上了石砖小径。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "从窗户向外看去，可以看到类似别墅的建筑。<br>\n我们朝那个方向走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative002"]}},
    {"op": "HidePrinter", "line": 24, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 25, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 26, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 27, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [48.0, 56.0], "AppearanceAndTransition": "16_1", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 28, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.5, "FadeDuration": 0.0}},
    {"op": "ChangeActorMaskability", "line": 29, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 30, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 31, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "由于监牢宅邸坐落在高台上，<br>\n远处望去尽是高墙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative003"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "在凝视围墙的同时，<br>\n诺亚的眼睛渐渐闪耀起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative004"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "好～高啊。<br>\n可以画很多很多画呢～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "我之前也出去过几次，<br>\n探索了周围。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative005"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "看来，高高的围墙似乎环绕着整个岛屿，<br>\n恐怕非常难以逃脱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative006"]}},
    {"op": "HideActors", "line": 43, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 44, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 45, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 46, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（竟然能绑架13名少女，真是规模庞大的犯罪。<br>\n　背后恐怕有大型组织在运作）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro001"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "（不可能轻易让我们逃脱吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro002"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "——就在这时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 55, "indent": 0, "params": {"SfxPath": "Sfx_55", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 57, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Duration": 0.20000000298023224, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "附近的灌木丛中传来了树叶摩擦的声音。<br>\n紧接着，奈叶香猛地冲了出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative008"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro003"]}},
    {"op": "SpawnBlur", "line": 65, "indent": 0, "params": {"ActorId": "MainBackground"}},
    {"op": "PlaySfxModified", "line": 66, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, 10.0], "IdAndAppearance": "Nanoka"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "奈叶香的手<br>\n朝我猛地伸了过来——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative009"]}},
    {"op": "SpawnShake", "line": 71, "indent": 0, "params": {"ActorId": "MainBackground"}},
    {"op": "PlaySfxModified", "line": 73, "indent": 0, "params": {"SfxPath": "Sfx_116", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "我瞬间闪身躲开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 80, "indent": 0, "params": {"SfxPath": "Sfx_116", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnBlur", "line": 82, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 0.0, "FadeDuration": 0.30000001192092896}},
    {"op": "ModifyBackgroundExtended", "line": 83, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "19_1"}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "呃！", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "失去平衡的奈叶香<br>\n摔倒在地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "……看来你很擅长运动啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro004"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "为什么要突然袭击我？<br>\n根据你的回答，我可能会把你交给看守。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro005"]}},
    {"op": "ResetText", "line": 97, "indent": 0, "params": {}},
    {"op": "Wait", "line": 98, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [70.0, 0.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 25.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "Wait", "line": 102, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "奈叶香不甘心地爬起上身，<br>\n保持单膝跪地的姿势，低声说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative012"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "……我只是想触碰你而已。<br>\n并没有要伤害你的意思。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "触碰？那能有什么用。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro006"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "……我的魔法是【幻视】。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "能看到触碰对象的过去或未来的景象。<br>\n不过，这个魔法并不能随意发动……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "……原来如此。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro007"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "（话说回来，明明可以不用这种<br>\n　容易树敌的方式去触碰别人……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro008"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "（这与她给人的印象不符，显得很笨拙。<br>\n　是因为不太习惯和人周旋吗……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "嗯，我大致明白了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro010"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "突然被关在这样的监牢里，<br>\n你却能保持如此冷静，肯定是有原因的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro011"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "……正如你所察觉的。<br>\n我通过【幻视】提前看到了监牢的信息。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka005"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "我想问你几个问题。<br>\n你那把枪是怎么一回事？<br>\n只要你告诉我，就不追究你刚才的袭击了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro012"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "我看到，过去监牢内的囚犯用魔法制作了这把枪，并隐藏了起来。<br>\n所以，被抓来这里后，我马上就把它收走了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka006"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "这把魔法步枪可装填六发子弹，<br>\n并且每天都会自动恢复一颗子弹。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka007"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "（原来如此……在这座监牢里，能掌握信息优势<br>\n　确实是很大的强项……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro013"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "很有趣。还知道些什么吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro014"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "我回答你关于枪的问题，你就不追究我的袭击，这不是说好的吗？<br>\n我不会再回答更多问题。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka008"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "但你也可能在撒谎。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro015"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "你觉得撒谎<br>\n对我有什么好处？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka009"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "谁知道呢。不过谨慎点总没错。<br>\n毕竟我们才刚认识。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro016"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "两人沉默，对视数秒，<br>\n最后，奈叶香像是放弃了似的叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative013"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "……好吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka010"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "我会告诉你我警惕的人的魔法。<br>\n但我无法证明，你得自己去验证。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka011"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "那个人的名字是【佐伯米莉亚】……<br>\n她是我到目前为止最警惕的对象。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka012"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "奈叶香皱着眉头开始讲述，<br>\n就像是在回忆什么令人不快的事情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative014"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "她……不，那家伙甚至不是少女。<br>\n——是恶魔。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka013"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "她原本拥有【互换】的魔法。<br>\n目前是一个男性用魔法夺取了她的身体。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka014"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "那家伙一定就是【幕后黑手】……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka015"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "看着奈叶香如此厌恶地讲述，<br>\n我明白她所说的一切都不是谎言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative015"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "……确实，这是很重要的事实。<br>\n你知道那个男性的身份吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro017"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我只能看到一些片段，所以详细情况我也不清楚。<br>\n那家伙是个夺取少女身体的极恶之徒，<br>\n我看到的只有这些。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka016"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "（……虽然她说是亲眼所见，但既然只是片段信息，<br>\n　还是只信一半比较好）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro018"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "我明白了。我相信你。<br>\n感谢你提供的有价值的信息。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro019"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "而且你试图接近我，<br>\n说明你还有不知道的信息。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro020"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "我顺便问一下，你从一开始<br>\n就怀疑我吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro021"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "……你最初的行动让人摸不着头脑。<br>\n老实说，我曾经怀疑你是幕后黑手。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka017"]}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1,Arms3"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "绝无可能。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 186, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "依我看，你的行动<br>\n才更加可疑。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro023"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "迅速回收枪支的行动，以及你那下定决心的表情。<br>\n就像是事先准备好了行动计划一样。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro024"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "我双臂交叉，俯视着她说着，<br>\n与奈叶香阴郁的眼神交汇。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative016"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "再追问也是徒劳的。我不打算与你合作。<br>\n……反正，大家都会死。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka018"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "（大家都会死？<br>\n　她是通过幻视得到这个信息的吗……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro025"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "我们互相瞪视着，谁都不愿退让，<br>\n紧张的气氛弥漫开来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative017"]}},
    {"op": "HideAllCharacters", "line": 200, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "喂喂，希罗。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah002"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "打破这种紧张气氛的<br>\n是诺亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative018"]}},
    {"op": "HideAllCharacters", "line": 207, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 208, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Angry1,Arms1"}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "她似乎没有注意到发生了什么，<br>\n拉了拉我的袖子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative019"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "难道说只有在放风时间<br>\n才能画画吗？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah003"]}},
    {"op": "ModifyCharacterExtended", "line": 215, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "……很遗憾。<br>\n画画只能在放风时间进行。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro026"]}},
    {"op": "ModifyCharacterExtended", "line": 219, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "欸——", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah004"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "诺亚失望地耷拉下脑袋，<br>\n但很快又抬了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 225, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "……如果没有和希罗约定的话，<br>\n诺亚可能会一直躲在房间里画画。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "但是多亏了希罗，<br>\n诺亚发现了好多好多有趣的地方！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah006"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "谢谢你，希罗！<br>\n诺亚画画时会遵守约定的！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah007"]}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "……是吗。那就好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro027"]}},
    {"op": "HideAllCharacters", "line": 239, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 241, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Nanoka"}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "不知什么时候奈叶香已经站了起来。<br>\n不过，她似乎不打算再对我出手了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative021"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "……看来你不是坏人。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Nanoka019"]}},
    {"op": "HideAllCharacters", "line": 247, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 249, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "奈叶香轻声嘟哝，<br>\n然后消失在了灌木丛的另一边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative022"]}},
    {"op": "UpdateWitchBook", "line": 253, "indent": 0, "params": {"Id": "Nanoka", "Category": "Profile", "Version": 6}},
    {"op": "UpdateWitchBook", "line": 254, "indent": 0, "params": {"Id": "Miria", "Category": "Profile", "Version": 6}},
    {"op": "ResetText", "line": 256, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 257, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 258, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 260, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "22_1"}},
    {"op": "ModifyBackgroundExtended", "line": 261, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 262, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "Wait", "line": 264, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlayBgm", "line": 266, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "与奈叶香分别后，<br>\n我和诺亚终于来到了目的地前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative023"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "三栋原木小屋风格的建筑并排而立。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative024"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "（大概是接待贵宾的<br>\n　招待所吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro028"]}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "（看起来比监牢宅邸要新一些。<br>\n　似乎没怎么使用过——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro029"]}},
    {"op": "ModifyCharacterExtended", "line": 276, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 277, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "希罗！我们进去看看吧。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Noah008"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "……也好。如果门没锁的话，我也想看看。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro030"]}},
    {"op": "ResetText", "line": 282, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 283, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 284, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "HideAllCharacters", "line": 286, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 289, "indent": 0, "params": {"SfxPath": "Sfx_22", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 291, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "23_3"}},
    {"op": "ModifyBackgroundExtended", "line": 292, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 293, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "门轻易就打开了，<br>\n于是我们走进了挂着【<ruby=\"UNDINE\">水精</ruby>之室】牌子的<br>\n招待所中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 297, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "一开门就看到了泽渡可可。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative026"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "看到我们出现，她的身体瞬间颤抖了一下，<br>\n但很快就装作若无其事般露出笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 303, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "啊，是希罗亲和诺亚啊。辛苦啦～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco001"]}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "那我就先……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco002"]}},
    {"op": "AnimateActorExtended", "line": 311, "indent": 0, "params": {"ActorIds": ["Coco"], "Loop": 0, "ScenePositionX": "70"}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "可可。你在这里做什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro031"]}},
    {"op": "ModifyCharacterExtended", "line": 315, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 316, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "没、没、没什么特别的啦～？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco003"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "（……她在隐瞒些什么）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro032"]}},
    {"op": "ModifyCharacterExtended", "line": 324, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmL2"}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "我们才刚认识不久嘛，<br>\n希望你别那么追根究底啦～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 328, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "我对你没兴趣，所以也不打算追问那么多。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro033"]}},
    {"op": "ModifyCharacterExtended", "line": 332, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Angry1,ArmL2"}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "哇，真讨厌。话说回来，<br>\n希罗亲有在看我的直播吗？<br>\n我从到这第一天就在播了哦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco005"]}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "直播……嗯，看过了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro034"]}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "就这么点感想啊。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco006"]}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "没什么特别的感想。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro035"]}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "回想起第一天的直播，<br>\n她并不像是在向我们传达什么，<br>\n而是一直在重复一些奇怪的言行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative028"]}},
    {"op": "PrintTextModified", "line": 344, "indent": 0, "params": {"Text": "老实说虽然有点在意，<br>\n但她也不是我想过多接触的类型。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative029"]}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "唔……明天可是有重大发表的，<br>\n到时候你一定会为我着迷的！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco007"]}},
    {"op": "PrintTextModified", "line": 348, "indent": 0, "params": {"Text": "绝对要看哦！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco008"]}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "她这番意味深长的话莫名地让我在意，<br>\n我故意摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative030"]}},
    {"op": "PrintTextModified", "line": 352, "indent": 0, "params": {"Text": "还是算了吧。<br>\n要是被施了什么奇怪的法术就麻烦了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro036"]}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "我不知道你的魔法是什么，<br>\n说不定和直播有关。<br>\n万一看了就被洗脑了呢。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro037"]}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Angry1,ArmL1"}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "才不是洗脑呢！<br>\n我的魔法是【千里眼】！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco009"]}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "千里眼……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro038"]}},
    {"op": "ModifyCharacterExtended", "line": 362, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Surprised1,ArmR9"}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "可可似乎意识到自己不小心说漏嘴了，<br>\n尴尬地移开了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 366, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmR1,ArmL2"}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "糟糕说漏嘴了……不、不过也行吧。<br>\n反正被知道了也不会少块肉……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco010"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "无论通过直播还是照片，只要有人认知到了泽渡可可这个人，<br>\n我就能俯瞰到正在观察我的人。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco011"]}},
    {"op": "PrintTextModified", "line": 374, "indent": 0, "params": {"Text": "意思就是说，你能获得这座监牢外面的信息吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Hiro039"]}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "差不多吧？只要有人在某处看着我就行？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco012"]}},
    {"op": "ModifyCharacterExtended", "line": 378, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Smile1,ArmR4"}},
    {"op": "PrintTextModified", "line": 380, "indent": 0, "params": {"Text": "而且，通过我的千里眼，<br>\n还获得了一个超～厉害的情报哦～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco013"]}},
    {"op": "ModifyCharacterExtended", "line": 382, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 384, "indent": 0, "params": {"Text": "怎么样，我的魔法很厉害吧？<br>\n——记得看直播哦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Coco014"]}},
    {"op": "HideAllCharacters", "line": 386, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "可可离开了招待所。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative032"]}},
    {"op": "UpdateWitchBook", "line": 390, "indent": 0, "params": {"Id": "Coco", "Category": "Profile", "Version": 4}},
    {"op": "ModifyCharacterExtended", "line": 392, "indent": 0, "params": {"Scale": [0.5], "Lazy": 0, "ScenePosition": [62.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 394, "indent": 0, "params": {"Text": "至于诺亚……正在拿典狱长模样的摆件玩耍。<br>\n我深深地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv16_Narrative033"]}},
    {"op": "Gosub", "line": 401, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 403, "indent": 0, "params": {"Path": "Act02_Chapter01/Act02_Chapter01_Adv12", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv16_Narrative001": "我和诺亚从正门走出来，<br>\n踏上了石砖小径。",
  "0201Adv16_Narrative002": "从窗户向外看去，可以看到类似别墅的建筑。<br>\n我们朝那个方向走去。",
  "0201Adv16_Narrative003": "由于监牢宅邸坐落在高台上，<br>\n远处望去尽是高墙。",
  "0201Adv16_Narrative004": "在凝视围墙的同时，<br>\n诺亚的眼睛渐渐闪耀起来。",
  "0201Adv16_Noah001": "好～高啊。<br>\n可以画很多很多画呢～",
  "0201Adv16_Narrative005": "我之前也出去过几次，<br>\n探索了周围。",
  "0201Adv16_Narrative006": "看来，高高的围墙似乎环绕着整个岛屿，<br>\n恐怕非常难以逃脱。",
  "0201Adv16_Hiro001": "（竟然能绑架13名少女，真是规模庞大的犯罪。<br>\n　背后恐怕有大型组织在运作）",
  "0201Adv16_Hiro002": "（不可能轻易让我们逃脱吧）",
  "0201Adv16_Narrative007": "——就在这时。",
  "0201Adv16_Narrative008": "附近的灌木丛中传来了树叶摩擦的声音。<br>\n紧接着，奈叶香猛地冲了出来。",
  "0201Adv16_Hiro003": "！",
  "0201Adv16_Narrative009": "奈叶香的手<br>\n朝我猛地伸了过来——",
  "0201Adv16_Narrative010": "我瞬间闪身躲开。",
  "0201Adv16_Nanoka001": "呃！",
  "0201Adv16_Narrative011": "失去平衡的奈叶香<br>\n摔倒在地。",
  "0201Adv16_Hiro004": "……看来你很擅长运动啊。",
  "0201Adv16_Hiro005": "为什么要突然袭击我？<br>\n根据你的回答，我可能会把你交给看守。",
  "0201Adv16_Narrative012": "奈叶香不甘心地爬起上身，<br>\n保持单膝跪地的姿势，低声说道。",
  "0201Adv16_Nanoka002": "……我只是想触碰你而已。<br>\n并没有要伤害你的意思。",
  "0201Adv16_Hiro006": "触碰？那能有什么用。",
  "0201Adv16_Nanoka003": "……我的魔法是【幻视】。",
  "0201Adv16_Nanoka004": "能看到触碰对象的过去或未来的景象。<br>\n不过，这个魔法并不能随意发动……",
  "0201Adv16_Hiro007": "……原来如此。",
  "0201Adv16_Hiro008": "（话说回来，明明可以不用这种<br>\n　容易树敌的方式去触碰别人……）",
  "0201Adv16_Hiro009": "（这与她给人的印象不符，显得很笨拙。<br>\n　是因为不太习惯和人周旋吗……？）",
  "0201Adv16_Hiro010": "嗯，我大致明白了。",
  "0201Adv16_Hiro011": "突然被关在这样的监牢里，<br>\n你却能保持如此冷静，肯定是有原因的。",
  "0201Adv16_Nanoka005": "……正如你所察觉的。<br>\n我通过【幻视】提前看到了监牢的信息。",
  "0201Adv16_Hiro012": "我想问你几个问题。<br>\n你那把枪是怎么一回事？<br>\n只要你告诉我，就不追究你刚才的袭击了。",
  "0201Adv16_Nanoka006": "我看到，过去监牢内的囚犯用魔法制作了这把枪，并隐藏了起来。<br>\n所以，被抓来这里后，我马上就把它收走了。",
  "0201Adv16_Nanoka007": "这把魔法步枪可装填六发子弹，<br>\n并且每天都会自动恢复一颗子弹。",
  "0201Adv16_Hiro013": "（原来如此……在这座监牢里，能掌握信息优势<br>\n　确实是很大的强项……）",
  "0201Adv16_Hiro014": "很有趣。还知道些什么吗？",
  "0201Adv16_Nanoka008": "我回答你关于枪的问题，你就不追究我的袭击，这不是说好的吗？<br>\n我不会再回答更多问题。",
  "0201Adv16_Hiro015": "但你也可能在撒谎。",
  "0201Adv16_Nanoka009": "你觉得撒谎<br>\n对我有什么好处？",
  "0201Adv16_Hiro016": "谁知道呢。不过谨慎点总没错。<br>\n毕竟我们才刚认识。",
  "0201Adv16_Narrative013": "两人沉默，对视数秒，<br>\n最后，奈叶香像是放弃了似的叹了口气。",
  "0201Adv16_Nanoka010": "……好吧。",
  "0201Adv16_Nanoka011": "我会告诉你我警惕的人的魔法。<br>\n但我无法证明，你得自己去验证。",
  "0201Adv16_Nanoka012": "那个人的名字是【佐伯米莉亚】……<br>\n她是我到目前为止最警惕的对象。",
  "0201Adv16_Narrative014": "奈叶香皱着眉头开始讲述，<br>\n就像是在回忆什么令人不快的事情。",
  "0201Adv16_Nanoka013": "她……不，那家伙甚至不是少女。<br>\n——是恶魔。",
  "0201Adv16_Nanoka014": "她原本拥有【互换】的魔法。<br>\n目前是一个男性用魔法夺取了她的身体。",
  "0201Adv16_Nanoka015": "那家伙一定就是【幕后黑手】……",
  "0201Adv16_Narrative015": "看着奈叶香如此厌恶地讲述，<br>\n我明白她所说的一切都不是谎言。",
  "0201Adv16_Hiro017": "……确实，这是很重要的事实。<br>\n你知道那个男性的身份吗？",
  "0201Adv16_Nanoka016": "我只能看到一些片段，所以详细情况我也不清楚。<br>\n那家伙是个夺取少女身体的极恶之徒，<br>\n我看到的只有这些。",
  "0201Adv16_Hiro018": "（……虽然她说是亲眼所见，但既然只是片段信息，<br>\n　还是只信一半比较好）",
  "0201Adv16_Hiro019": "我明白了。我相信你。<br>\n感谢你提供的有价值的信息。",
  "0201Adv16_Hiro020": "而且你试图接近我，<br>\n说明你还有不知道的信息。",
  "0201Adv16_Hiro021": "我顺便问一下，你从一开始<br>\n就怀疑我吗？",
  "0201Adv16_Nanoka017": "……你最初的行动让人摸不着头脑。<br>\n老实说，我曾经怀疑你是幕后黑手。",
  "0201Adv16_Hiro022": "绝无可能。",
  "0201Adv16_Hiro023": "依我看，你的行动<br>\n才更加可疑。",
  "0201Adv16_Hiro024": "迅速回收枪支的行动，以及你那下定决心的表情。<br>\n就像是事先准备好了行动计划一样。",
  "0201Adv16_Narrative016": "我双臂交叉，俯视着她说着，<br>\n与奈叶香阴郁的眼神交汇。",
  "0201Adv16_Nanoka018": "再追问也是徒劳的。我不打算与你合作。<br>\n……反正，大家都会死。",
  "0201Adv16_Hiro025": "（大家都会死？<br>\n　她是通过幻视得到这个信息的吗……？）",
  "0201Adv16_Narrative017": "我们互相瞪视着，谁都不愿退让，<br>\n紧张的气氛弥漫开来。",
  "0201Adv16_Noah002": "喂喂，希罗。",
  "0201Adv16_Narrative018": "打破这种紧张气氛的<br>\n是诺亚。",
  "0201Adv16_Narrative019": "她似乎没有注意到发生了什么，<br>\n拉了拉我的袖子。",
  "0201Adv16_Noah003": "难道说只有在放风时间<br>\n才能画画吗？",
  "0201Adv16_Hiro026": "……很遗憾。<br>\n画画只能在放风时间进行。",
  "0201Adv16_Noah004": "欸——",
  "0201Adv16_Narrative020": "诺亚失望地耷拉下脑袋，<br>\n但很快又抬了起来。",
  "0201Adv16_Noah005": "……如果没有和希罗约定的话，<br>\n诺亚可能会一直躲在房间里画画。",
  "0201Adv16_Noah006": "但是多亏了希罗，<br>\n诺亚发现了好多好多有趣的地方！",
  "0201Adv16_Noah007": "谢谢你，希罗！<br>\n诺亚画画时会遵守约定的！",
  "0201Adv16_Hiro027": "……是吗。那就好。",
  "0201Adv16_Narrative021": "不知什么时候奈叶香已经站了起来。<br>\n不过，她似乎不打算再对我出手了。",
  "0201Adv16_Nanoka019": "……看来你不是坏人。",
  "0201Adv16_Narrative022": "奈叶香轻声嘟哝，<br>\n然后消失在了灌木丛的另一边。",
  "0201Adv16_Narrative023": "与奈叶香分别后，<br>\n我和诺亚终于来到了目的地前。",
  "0201Adv16_Narrative024": "三栋原木小屋风格的建筑并排而立。",
  "0201Adv16_Hiro028": "（大概是接待贵宾的<br>\n　招待所吧）",
  "0201Adv16_Hiro029": "（看起来比监牢宅邸要新一些。<br>\n　似乎没怎么使用过——）",
  "0201Adv16_Noah008": "希罗！我们进去看看吧。",
  "0201Adv16_Hiro030": "……也好。如果门没锁的话，我也想看看。",
  "0201Adv16_Narrative025": "门轻易就打开了，<br>\n于是我们走进了挂着【<ruby=\"UNDINE\">水精</ruby>之室】牌子的<br>\n招待所中。",
  "0201Adv16_Narrative026": "一开门就看到了泽渡可可。",
  "0201Adv16_Narrative027": "看到我们出现，她的身体瞬间颤抖了一下，<br>\n但很快就装作若无其事般露出笑容。",
  "0201Adv16_Coco001": "啊，是希罗亲和诺亚啊。辛苦啦～",
  "0201Adv16_Coco002": "那我就先……",
  "0201Adv16_Hiro031": "可可。你在这里做什么？",
  "0201Adv16_Coco003": "没、没、没什么特别的啦～？",
  "0201Adv16_Hiro032": "（……她在隐瞒些什么）",
  "0201Adv16_Coco004": "我们才刚认识不久嘛，<br>\n希望你别那么追根究底啦～",
  "0201Adv16_Hiro033": "我对你没兴趣，所以也不打算追问那么多。",
  "0201Adv16_Coco005": "哇，真讨厌。话说回来，<br>\n希罗亲有在看我的直播吗？<br>\n我从到这第一天就在播了哦。",
  "0201Adv16_Hiro034": "直播……嗯，看过了。",
  "0201Adv16_Coco006": "就这么点感想啊。",
  "0201Adv16_Hiro035": "没什么特别的感想。",
  "0201Adv16_Narrative028": "回想起第一天的直播，<br>\n她并不像是在向我们传达什么，<br>\n而是一直在重复一些奇怪的言行。",
  "0201Adv16_Narrative029": "老实说虽然有点在意，<br>\n但她也不是我想过多接触的类型。",
  "0201Adv16_Coco007": "唔……明天可是有重大发表的，<br>\n到时候你一定会为我着迷的！",
  "0201Adv16_Coco008": "绝对要看哦！",
  "0201Adv16_Narrative030": "她这番意味深长的话莫名地让我在意，<br>\n我故意摇了摇头。",
  "0201Adv16_Hiro036": "还是算了吧。<br>\n要是被施了什么奇怪的法术就麻烦了。",
  "0201Adv16_Hiro037": "我不知道你的魔法是什么，<br>\n说不定和直播有关。<br>\n万一看了就被洗脑了呢。",
  "0201Adv16_Coco009": "才不是洗脑呢！<br>\n我的魔法是【千里眼】！",
  "0201Adv16_Hiro038": "千里眼……？",
  "0201Adv16_Narrative031": "可可似乎意识到自己不小心说漏嘴了，<br>\n尴尬地移开了视线。",
  "0201Adv16_Coco010": "糟糕说漏嘴了……不、不过也行吧。<br>\n反正被知道了也不会少块肉……",
  "0201Adv16_Coco011": "无论通过直播还是照片，只要有人认知到了泽渡可可这个人，<br>\n我就能俯瞰到正在观察我的人。",
  "0201Adv16_Hiro039": "意思就是说，你能获得这座监牢外面的信息吗？",
  "0201Adv16_Coco012": "差不多吧？只要有人在某处看着我就行？",
  "0201Adv16_Coco013": "而且，通过我的千里眼，<br>\n还获得了一个超～厉害的情报哦～",
  "0201Adv16_Coco014": "怎么样，我的魔法很厉害吧？<br>\n——记得看直播哦。",
  "0201Adv16_Narrative032": "可可离开了招待所。",
  "0201Adv16_Narrative033": "至于诺亚……正在拿典狱长模样的摆件玩耍。<br>\n我深深地叹了口气。"
}
}
