{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter01/Act02_Chapter01_Adv27",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-1-22", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_32_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "审判结束后，<br>\n我来到了玛格的房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "我很在意玛格提到过的，可可留下的语音备忘录。<br>\n想再检查看看这里还有没有其他线索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "在这座监牢中度过的数日间，<br>\n这里没有留下任何她存在过的痕迹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative003"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "这是一个有些冷清的房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative004"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（不知为何。<br>\n　我总觉得她像是会给房间添上更多装饰的人）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（……话说回来，没有线索啊。<br>\n　明天直接去问可可应该更快）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "老实说还有一个原因。搜查有些难以进行了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative005"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "因为我刚进这个房间，<br>\n艾玛就跟着进来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative006"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "艾玛似乎是在<br>\n寻找玛格的遗物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Cry1,ArmR3"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "呜呜……玛格……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema001"]}},
    {"op": "HideAllCharacters", "line": 38, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "她眼里噙着泪水，<br>\n在玛格的床边翻找着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative008"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "（真是一厢情愿的感伤之举。<br>\n　对于玛格——那个魔女……根本就没有半点同情的余地）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro003"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（她是个犯下杀人罪，甚至不惜陷害我，<br>\n　只为逃避罪责的卑鄙小人）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro004"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "（口口声声说着【爱】，<br>\n　实际不过是自私地杀害了梅露露罢了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro005"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "我是这么想的。<br>\n我明明是这么想的……但不知为何，<br>\n我的拳头一直在颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative009"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "就像在强忍着什么一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative010"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "理所当然地，<br>\n我和艾玛没有对话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative011"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "正当我准备离开<br>\n这尴尬的空间时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema002"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "我用余光瞥见艾玛似乎发现了什么东西，<br>\n然后迅速将它藏进了怀里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative013"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "（她藏了什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro006"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "这让我非常在意，<br>\n于是我转向了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "我要走了，<br>\n你还打算继续找下去？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro007"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "啊，嗯。<br>\n我想再看看有没有别的东西——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "梅露露死了，<br>\n玛格被处刑了，<br>\n你会为此感到伤心吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro008"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "这……当然难过啊。<br>\n或许她们两人确实都做了不可饶恕的事。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Cry1,ArmR3"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "但对我来说，只要有人不在了，<br>\n我就会觉得悲伤、觉得寂寞……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema005"]}},
    {"op": "HideAllCharacters", "line": 82, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "乍看之下，<br>\n艾玛似乎是真情流露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative015"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "然而，面对泪流满面的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative016"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "我脑海中浮现的是，<br>\n那段和艾玛亲密无间的时光——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative017"]}},
    {"op": "ResetText", "line": 94, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 95, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 96, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 97, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 98, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "400_1"}},
    {"op": "ModifyBackgroundExtended", "line": 99, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlaySfxModified", "line": 103, "indent": 0, "params": {"SfxPath": "Sfx_57", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "那是小学三四年级的时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative018"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "呜呜，呜呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema006"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "艾玛，原来你在这里啊。<br>\n因为你班会的时候不在，大家都在找你……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro009"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "啊，希罗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema007"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "你的室内鞋还没找到。<br>\n到底是谁这么过分藏起来的……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro010"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "就在这时，我注意到她脚上穿的，<br>\n正是她大喊“丢了”的那双鞋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative019"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "找到了吗！<br>\n那我得赶快告诉大家！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro011"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "啊，是哦。对不起……<br>\n不过我就知道<br>\n希罗一定会找到我。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema008"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "最近希罗，<br>\n都不怎么和我玩了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema009"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "但是最了解我的，<br>\n果然还是希罗啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Ema010"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "面对嬉皮笑脸的艾玛，<br>\n当时的我感到了一丝寒意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative020"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "她或许只是为了引起我的注意，<br>\n才一直藏在天台上，<br>\n等着我出现——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative021"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "甚至所谓“鞋子丢了”的事件，<br>\n也可能全是她编造的——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative022"]}},
    {"op": "ResetText", "line": 135, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 136, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 139, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 141, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 142, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "（不只是这次。<br>\n　类似的事发生过好多次）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro012"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "（正因为相处时间长，我才明白。<br>\n　艾玛绝不是大家以为的“好孩子”）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro013"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "（她曾冷眼旁观小雪被霸凌，<br>\n　对她见死不救，这便是证据）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro014"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "（艾玛，是邪恶的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro015"]}},
    {"op": "ResetText", "line": 155, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 156, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 157, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 158, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "400_1"}},
    {"op": "ModifyBackgroundExtended", "line": 159, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 160, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "上初中以后，<br>\n月代雪加入了我们——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative023"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "有一次，趁艾玛不在时，<br>\n她悄悄在我耳边低语。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative024"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "艾玛她啊，<br>\n总有一天会成为带来灾祸的魔女哦。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Yuki001"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "她会杀死很多人。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Yuki002"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "会让大家都变得不幸。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Yuki003"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "很可怕吧。<br>\n那一天终将到来。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Yuki004"]}},
    {"op": "ResetText", "line": 178, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 179, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 180, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 182, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 184, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 185, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "小雪总是喜欢用转弯抹角的说法，<br>\n所以当时我以为是某种隐喻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative025"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "但现在我明白了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative026"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "（我应该制裁的恶——【魔女】，<br>\n　就在我的眼前）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro016"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "（为了避免发生更大的悲剧，<br>\n　我必须负起责任纠正你）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro017"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "（如果你就是不该存在于这个世界的魔女，<br>\n　那么——就由我来杀死你）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro018"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "（这就是我必须完成的使命）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Hiro019"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "原以为已经成功压抑的黑暗，<br>\n正在悄然渗出，逐渐膨胀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative027"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "我满怀冰冷的杀意，<br>\n久久注视着艾玛的背影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0201Adv27_Narrative028"]}},
    {"op": "UpdateWitchBook", "line": 207, "indent": 0, "params": {"Id": "Ema", "Category": "Profile", "Version": 5}},
    {"op": "SetCustomVariable", "line": 213, "indent": 0, "params": {"Expression": "g_gameProgress = max(7, g_gameProgress)"}},
    {"op": "Gosub", "line": 214, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 216, "indent": 0, "params": {"Path": "Act02_Chapter02/Act02_Chapter02_Adv01", "SoftReset": 1}}
  ],
  "translations": {
  "0201Adv27_Narrative001": "审判结束后，<br>\n我来到了玛格的房间。",
  "0201Adv27_Narrative002": "我很在意玛格提到过的，可可留下的语音备忘录。<br>\n想再检查看看这里还有没有其他线索。",
  "0201Adv27_Narrative003": "在这座监牢中度过的数日间，<br>\n这里没有留下任何她存在过的痕迹。",
  "0201Adv27_Narrative004": "这是一个有些冷清的房间。",
  "0201Adv27_Hiro001": "（不知为何。<br>\n　我总觉得她像是会给房间添上更多装饰的人）",
  "0201Adv27_Hiro002": "（……话说回来，没有线索啊。<br>\n　明天直接去问可可应该更快）",
  "0201Adv27_Narrative005": "老实说还有一个原因。搜查有些难以进行了。",
  "0201Adv27_Narrative006": "因为我刚进这个房间，<br>\n艾玛就跟着进来了。",
  "0201Adv27_Narrative007": "艾玛似乎是在<br>\n寻找玛格的遗物。",
  "0201Adv27_Ema001": "呜呜……玛格……",
  "0201Adv27_Narrative008": "她眼里噙着泪水，<br>\n在玛格的床边翻找着。",
  "0201Adv27_Hiro003": "（真是一厢情愿的感伤之举。<br>\n　对于玛格——那个魔女……根本就没有半点同情的余地）",
  "0201Adv27_Hiro004": "（她是个犯下杀人罪，甚至不惜陷害我，<br>\n　只为逃避罪责的卑鄙小人）",
  "0201Adv27_Hiro005": "（口口声声说着【爱】，<br>\n　实际不过是自私地杀害了梅露露罢了）",
  "0201Adv27_Narrative009": "我是这么想的。<br>\n我明明是这么想的……但不知为何，<br>\n我的拳头一直在颤抖。",
  "0201Adv27_Narrative010": "就像在强忍着什么一样。",
  "0201Adv27_Narrative011": "理所当然地，<br>\n我和艾玛没有对话。",
  "0201Adv27_Narrative012": "正当我准备离开<br>\n这尴尬的空间时。",
  "0201Adv27_Ema002": "…………",
  "0201Adv27_Narrative013": "我用余光瞥见艾玛似乎发现了什么东西，<br>\n然后迅速将它藏进了怀里。",
  "0201Adv27_Hiro006": "（她藏了什么……？）",
  "0201Adv27_Narrative014": "这让我非常在意，<br>\n于是我转向了艾玛。",
  "0201Adv27_Hiro007": "我要走了，<br>\n你还打算继续找下去？",
  "0201Adv27_Ema003": "啊，嗯。<br>\n我想再看看有没有别的东西——",
  "0201Adv27_Hiro008": "梅露露死了，<br>\n玛格被处刑了，<br>\n你会为此感到伤心吗？",
  "0201Adv27_Ema004": "这……当然难过啊。<br>\n或许她们两人确实都做了不可饶恕的事。",
  "0201Adv27_Ema005": "但对我来说，只要有人不在了，<br>\n我就会觉得悲伤、觉得寂寞……",
  "0201Adv27_Narrative015": "乍看之下，<br>\n艾玛似乎是真情流露。",
  "0201Adv27_Narrative016": "然而，面对泪流满面的艾玛。",
  "0201Adv27_Narrative017": "我脑海中浮现的是，<br>\n那段和艾玛亲密无间的时光——",
  "0201Adv27_Narrative018": "那是小学三四年级的时候。",
  "0201Adv27_Ema006": "呜呜，呜呜……",
  "0201Adv27_Hiro009": "艾玛，原来你在这里啊。<br>\n因为你班会的时候不在，大家都在找你……",
  "0201Adv27_Ema007": "啊，希罗……",
  "0201Adv27_Hiro010": "你的室内鞋还没找到。<br>\n到底是谁这么过分藏起来的……",
  "0201Adv27_Narrative019": "就在这时，我注意到她脚上穿的，<br>\n正是她大喊“丢了”的那双鞋。",
  "0201Adv27_Hiro011": "找到了吗！<br>\n那我得赶快告诉大家！",
  "0201Adv27_Ema008": "啊，是哦。对不起……<br>\n不过我就知道<br>\n希罗一定会找到我。",
  "0201Adv27_Ema009": "最近希罗，<br>\n都不怎么和我玩了。",
  "0201Adv27_Ema010": "但是最了解我的，<br>\n果然还是希罗啊！",
  "0201Adv27_Narrative020": "面对嬉皮笑脸的艾玛，<br>\n当时的我感到了一丝寒意。",
  "0201Adv27_Narrative021": "她或许只是为了引起我的注意，<br>\n才一直藏在天台上，<br>\n等着我出现——",
  "0201Adv27_Narrative022": "甚至所谓“鞋子丢了”的事件，<br>\n也可能全是她编造的——",
  "0201Adv27_Hiro012": "（不只是这次。<br>\n　类似的事发生过好多次）",
  "0201Adv27_Hiro013": "（正因为相处时间长，我才明白。<br>\n　艾玛绝不是大家以为的“好孩子”）",
  "0201Adv27_Hiro014": "（她曾冷眼旁观小雪被霸凌，<br>\n　对她见死不救，这便是证据）",
  "0201Adv27_Hiro015": "（艾玛，是邪恶的）",
  "0201Adv27_Narrative023": "上初中以后，<br>\n月代雪加入了我们——",
  "0201Adv27_Narrative024": "有一次，趁艾玛不在时，<br>\n她悄悄在我耳边低语。",
  "0201Adv27_Yuki001": "艾玛她啊，<br>\n总有一天会成为带来灾祸的魔女哦。",
  "0201Adv27_Yuki002": "她会杀死很多人。",
  "0201Adv27_Yuki003": "会让大家都变得不幸。",
  "0201Adv27_Yuki004": "很可怕吧。<br>\n那一天终将到来。",
  "0201Adv27_Narrative025": "小雪总是喜欢用转弯抹角的说法，<br>\n所以当时我以为是某种隐喻。",
  "0201Adv27_Narrative026": "但现在我明白了。",
  "0201Adv27_Hiro016": "（我应该制裁的恶——【魔女】，<br>\n　就在我的眼前）",
  "0201Adv27_Hiro017": "（为了避免发生更大的悲剧，<br>\n　我必须负起责任纠正你）",
  "0201Adv27_Hiro018": "（如果你就是不该存在于这个世界的魔女，<br>\n　那么——就由我来杀死你）",
  "0201Adv27_Hiro019": "（这就是我必须完成的使命）",
  "0201Adv27_Narrative027": "原以为已经成功压抑的黑暗，<br>\n正在悄然渗出，逐渐膨胀。",
  "0201Adv27_Narrative028": "我满怀冰冷的杀意，<br>\n久久注视着艾玛的背影。"
}
}
