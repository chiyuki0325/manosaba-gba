  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-4-b2", "line": 12, "indent": 0},
    {"op": "StopBgm", "line": 14, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "ModifyBackgroundExtended", "line": 21, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 22, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 24, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "希罗！？你要去哪……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "那边好像也有什么东西。<br>\n我去看看。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro001"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "你先去追典狱长吧，<br>\n我随后就到。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "好吧，我会的。<br>\n你千万要小心。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Leia002"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "你也要小心。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro003"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "我与蕾雅就这样分开了。<br>\n我朝着影子离开的方向——湖的深处走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative001"]}},
    {"op": "ModifyBackgroundExtended", "line": 46, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "哈啊，哈啊，哈啊……到底去哪了？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro004"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "寂静无声的湖面，<br>\n让人感觉有点毛骨悚然。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "（是我看错了……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro005"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "如果是那样，就没有待在这里的理由了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "（得去追蕾雅才行）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro006"]}},
    {"op": "HideAllCharacters", "line": 62, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 63, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "正当我这样想着，转过身时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative004"]}},
    {"op": "StopBgm", "line": 67, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 70, "indent": 0, "params": {"SfxPath": "Sfx_156", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 72, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro007"]}},
    {"op": "PlayBgm", "line": 76, "indent": 0, "params": {"BgmPath": "Bgm_27_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（是什么时候……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro008"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "水声使我一惊，回头一看，<br>\n那里站着一名少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "而且是素未谋面的少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "你是……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro009"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "我一开口，那少女就像一团烟雾一般消失了。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "（怎么回事……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro010"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "完全搞不懂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative008"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "总之，最好先把这里有个陌生少女的事<br>\n告诉其他人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "我正要转身去追蕾雅，就在此时。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative010"]}},
    {"op": "SpawnShake", "line": 99, "indent": 0, "params": {"ActorId": "Camera", "ShakeCount": 2, "ShakeAmplitude": 0.10000000149011612, "AmplitudeVariation": 0.15000000596046448}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "Wait", "line": 101, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro011"]}},
    {"op": "PlayBgm", "line": 107, "indent": 0, "params": {"BgmPath": "Bgm_27_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 110, "indent": 0, "params": {"SfxPath": "Sfx_142", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 10.0], "IdAndAppearance": "Hiro.Fearful1"}},
    {"op": "Wait", "line": 113, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ResetText", "line": 115, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Duration": 0.20000000298023224, "Lazy": 0, "ScenePosition": [50.0, -50.0], "IdAndAppearance": "Hiro.Fearful1"}},
    {"op": "ModifyBackgroundExtended", "line": 117, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 118, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 119, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "有什么东西扯住了我的脚，我无法浮出水面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "（到底怎么回事……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro012"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "我慌乱地环顾昏暗的水下，<br>\n刚才那少女正抓住我的脚微笑着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "终于……终于抓到下一个了。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl001"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "（下一个……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro013"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "我还在思考她那欣喜的语气是什么意思时，<br>\n身体已不断被拖往水深处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "（要窒息了……这么下去我会……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro014"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "我向着逐渐远去的水面伸出手，<br>\n却怎么也够不着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative014"]}},
    {"op": "PlayBgm", "line": 137, "indent": 0, "params": {"BgmPath": "Bgm_27_3", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "（啊啊……这样下去，会死……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro015"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "呵呵，没关系的……就这样放松身体，交给我吧。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl002"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "她的嗓音温柔，如同安抚幼儿一般，<br>\n引导我走向这次生命的终点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative015"]}},
    {"op": "ResetText", "line": 145, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 147, "indent": 0, "params": {"FadeOutDuration": 1.5}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "Wait", "line": 150, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "ModifyBackgroundExtended", "line": 152, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "ModifyBackgroundExtended", "line": 154, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 155, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "Wait", "line": 158, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlayBgm", "line": 160, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "唔！哈啊……哈啊……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro016"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "醒来时，我发现自己身处湖畔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "（为什么……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro017"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "通常情况下，<br>\n应该是在上一次睡着的地方醒来才对。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative017"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "（总之得先回监牢）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro018"]}},
    {"op": "HideAllCharacters", "line": 174, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "虽然感觉到了一种奇妙的异样，<br>\n我还是朝监牢走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative018"]}},
    {"op": "ModifyBackgroundExtended", "line": 178, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "4_1"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "一回到监牢，<br>\n一股阴郁的气氛扑面而来，<br>\n我不禁皱起了眉头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "（怎么回事……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro019"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "无论怎么想，情况都不对劲。<br>\n正当我打算找人问问时，<br>\n看到蕾雅和米莉亚一起朝这边走来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Miria.Pensive1,ArmR10"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "（啊，正好可以……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro020"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "蕾雅、米莉亚……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "米莉亚，你要振作一点。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Cry1"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "对不起……对不起。<br>\n我知道自己必须振作起来，可是……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "米莉亚泪如雨下，<br>\n她身旁的蕾雅也面色沉痛地低着头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative021"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "你们两个，到底发生什么事了？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro022"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Leia004"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Miria002"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "为什么都不回答我？<br>\n你们听得见吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro023"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "我反复呼喊，<br>\n她们连看都不看我一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative022"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "简直就像，<br>\n真的听不到我的声音一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "（这不可能……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro024"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "我们该回去了。<br>\n大家一定也在担心吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "……嗯，好。<br>\n但我还是无法相信……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Miria003"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "小希竟然……死了……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro025"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "（我……死了？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro026"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "这不可能。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative024"]}},
    {"op": "HideActors", "line": 243, "indent": 0, "params": {"ActorIds": ["Miria"], "Lazy": 0}},
    {"op": "HideActors", "line": 244, "indent": 0, "params": {"ActorIds": ["Leia"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "我想追上她们问个清楚，<br>\n双脚却像被钉在地上一样动弹不得。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative025"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "（不，这不可能……一定哪里搞错了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro027"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "我怎么会已经死了……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro028"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "呵呵，没有搞错哦。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl003"]}},
    {"op": "HideAllCharacters", "line": 256, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro029"]}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "我猛地回头看向声音响起的方向，<br>\n只见那里站着一名少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative026"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "就是在湖边见到的，那个少女。<br>\n把我拖入湖底的，那个少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative027"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "……为什么你会在这。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro030"]}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "想着在我消失之前，<br>\n先告诉你一声。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl004"]}},
    {"op": "ModifyCharacterExtended", "line": 269, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "消失……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro031"]}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "面对茫然的我，<br>\n她露出了无比愉悦的笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative028"]}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "你已经死在那个湖里了。<br>\n作为替代我的祭品。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl005"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "多亏你，<br>\n我终于可以从这里解脱了。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl006"]}},
    {"op": "ModifyCharacterExtended", "line": 279, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1"}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "（祭品……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro032"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "一股恶寒爬满全身，令我不由得颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative029"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "接下来轮到你了。<br>\n直到献上下一个祭品前，<br>\n你会永～远被囚禁在这座监牢里哦。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl007"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "少女说完，<br>\n身影便渐渐淡去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative030"]}},
    {"op": "ModifyCharacterExtended", "line": 289, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "等、等等！<br>\n我还有话想问……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro033"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "后面的你就自己查吧。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl008"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "没事。<br>\n反正你的时间多得是呢。名副其实，多得要死。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Girl009"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "少女只留下一声轻笑，<br>\n便彻底消失了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 299, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1"}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "（为什么……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro034"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "——那时候，要是不去追什么影子就好了。<br>\n——说到底，当初要是不去什么湖边就好了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative032"]}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "（……不，<br>\n　那个少女说的也不一定是真的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro035"]}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "为了抓住最后一缕希望，<br>\n我朝着大家可能会在的会客厅走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative033"]}},
    {"op": "HideAllCharacters", "line": 311, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 313, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "大家！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro036"]}},
    {"op": "PrintTextModified", "line": 317, "indent": 0, "params": {"Text": "我一边扯着前所未有的大嗓门呼喊，<br>\n一边冲进了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative034"]}},
    {"op": "HideAllCharacters", "line": 319, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 321, "indent": 0, "params": {"Text": "会客室里除了米莉亚与蕾雅，<br>\n所有幸存成员都到齐了。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative035"]}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "每个人都神情沉痛，<br>\n没有一个人看向我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative036"]}},
    {"op": "PrintTextModified", "line": 325, "indent": 0, "params": {"Text": "你们听不到我的声音吗！<br>\n喂，其实你们听得见的吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro037"]}},
    {"op": "ModifyCharacterExtended", "line": 327, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 328, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 329, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "……要是我当时跟着小希就好了……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Miria005"]}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "我也是……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Leia006"]}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "希罗怎么会就这么死掉……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Ema001"]}},
    {"op": "PrintTextModified", "line": 337, "indent": 0, "params": {"Text": "艾玛！我就在这里！<br>\n我没有死！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro038"]}},
    {"op": "ModifyCharacterExtended", "line": 341, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Cry1"}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "呜呜，希罗……怎么会，<br>\n我不要……我不要这样……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Ema002"]}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "艾玛……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Miria006"]}},
    {"op": "PrintTextModified", "line": 347, "indent": 0, "params": {"Text": "艾玛的眼泪大颗大颗滚落，<br>\n哭着瘫坐在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative037"]}},
    {"op": "HideAllCharacters", "line": 349, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "艾玛！不是的！我还活着！！<br>\n这一定是，什么恶作剧——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro039"]}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "（这太奇怪了……<br>\n　奇怪，太奇怪了，太奇怪了太奇怪了！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro040"]}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "我在这里！我就在这里啊！<br>\n我根本没死！<br>\n所以……拜托了，谁都好，注意到我吧……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Hiro041"]}},
    {"op": "ResetText", "line": 357, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 358, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 359, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 360, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "无论我如何哭喊，如何尖叫，<br>\n我的声音都传不到任何人耳中——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative038"]}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "在连死亡都不被允许的绝望笼罩下，<br>\n我被囚禁在这座监牢之中，直到永远。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad02_Narrative039"]}},
    {"op": "ProcessBadEnd", "line": 370, "indent": 0, "params": {"Number": 22}}
  ],
  "translations": {
  "0204Bad02_Leia001": "希罗！？你要去哪……",
  "0204Bad02_Hiro001": "那边好像也有什么东西。<br>\n我去看看。",
  "0204Bad02_Hiro002": "你先去追典狱长吧，<br>\n我随后就到。",
  "0204Bad02_Leia002": "好吧，我会的。<br>\n你千万要小心。",
  "0204Bad02_Hiro003": "你也要小心。",
  "0204Bad02_Narrative001": "我与蕾雅就这样分开了。<br>\n我朝着影子离开的方向——湖的深处走去。",
  "0204Bad02_Hiro004": "哈啊，哈啊，哈啊……到底去哪了？",
  "0204Bad02_Narrative002": "寂静无声的湖面，<br>\n让人感觉有点毛骨悚然。",
  "0204Bad02_Hiro005": "（是我看错了……？）",
  "0204Bad02_Narrative003": "如果是那样，就没有待在这里的理由了。",
  "0204Bad02_Hiro006": "（得去追蕾雅才行）",
  "0204Bad02_Narrative004": "正当我这样想着，转过身时。",
  "0204Bad02_Hiro007": "！",
  "0204Bad02_Hiro008": "（是什么时候……）",
  "0204Bad02_Narrative005": "水声使我一惊，回头一看，<br>\n那里站着一名少女。",
  "0204Bad02_Narrative006": "而且是素未谋面的少女。",
  "0204Bad02_Hiro009": "你是……",
  "0204Bad02_Narrative007": "我一开口，那少女就像一团烟雾一般消失了。<br>",
  "0204Bad02_Hiro010": "（怎么回事……？）",
  "0204Bad02_Narrative008": "完全搞不懂。",
  "0204Bad02_Narrative009": "总之，最好先把这里有个陌生少女的事<br>\n告诉其他人。",
  "0204Bad02_Narrative010": "我正要转身去追蕾雅，就在此时。<br>",
  "0204Bad02_Hiro011": "——！",
  "0204Bad02_Narrative011": "有什么东西扯住了我的脚，我无法浮出水面。",
  "0204Bad02_Hiro012": "（到底怎么回事……！）",
  "0204Bad02_Narrative012": "我慌乱地环顾昏暗的水下，<br>\n刚才那少女正抓住我的脚微笑着。",
  "0204Bad02_Girl001": "终于……终于抓到下一个了。",
  "0204Bad02_Hiro013": "（下一个……？）",
  "0204Bad02_Narrative013": "我还在思考她那欣喜的语气是什么意思时，<br>\n身体已不断被拖往水深处。",
  "0204Bad02_Hiro014": "（要窒息了……这么下去我会……！）",
  "0204Bad02_Narrative014": "我向着逐渐远去的水面伸出手，<br>\n却怎么也够不着。",
  "0204Bad02_Hiro015": "（啊啊……这样下去，会死……）",
  "0204Bad02_Girl002": "呵呵，没关系的……就这样放松身体，交给我吧。",
  "0204Bad02_Narrative015": "她的嗓音温柔，如同安抚幼儿一般，<br>\n引导我走向这次生命的终点。",
  "0204Bad02_Hiro016": "唔！哈啊……哈啊……",
  "0204Bad02_Narrative016": "醒来时，我发现自己身处湖畔。",
  "0204Bad02_Hiro017": "（为什么……）",
  "0204Bad02_Narrative017": "通常情况下，<br>\n应该是在上一次睡着的地方醒来才对。",
  "0204Bad02_Hiro018": "（总之得先回监牢）",
  "0204Bad02_Narrative018": "虽然感觉到了一种奇妙的异样，<br>\n我还是朝监牢走去。",
  "0204Bad02_Narrative019": "一回到监牢，<br>\n一股阴郁的气氛扑面而来，<br>\n我不禁皱起了眉头。",
  "0204Bad02_Hiro019": "（怎么回事……？）",
  "0204Bad02_Narrative020": "无论怎么想，情况都不对劲。<br>\n正当我打算找人问问时，<br>\n看到蕾雅和米莉亚一起朝这边走来。",
  "0204Bad02_Hiro020": "（啊，正好可以……）",
  "0204Bad02_Hiro021": "蕾雅、米莉亚……",
  "0204Bad02_Leia003": "米莉亚，你要振作一点。",
  "0204Bad02_Miria001": "对不起……对不起。<br>\n我知道自己必须振作起来，可是……",
  "0204Bad02_Narrative021": "米莉亚泪如雨下，<br>\n她身旁的蕾雅也面色沉痛地低着头。",
  "0204Bad02_Hiro022": "你们两个，到底发生什么事了？",
  "0204Bad02_Leia004": "……",
  "0204Bad02_Miria002": "……",
  "0204Bad02_Hiro023": "为什么都不回答我？<br>\n你们听得见吧？",
  "0204Bad02_Narrative022": "我反复呼喊，<br>\n她们连看都不看我一眼。",
  "0204Bad02_Narrative023": "简直就像，<br>\n真的听不到我的声音一样。",
  "0204Bad02_Hiro024": "（这不可能……）",
  "0204Bad02_Leia005": "我们该回去了。<br>\n大家一定也在担心吧。",
  "0204Bad02_Miria003": "……嗯，好。<br>\n但我还是无法相信……",
  "0204Bad02_Miria004": "小希竟然……死了……",
  "0204Bad02_Hiro025": "……",
  "0204Bad02_Hiro026": "（我……死了？）",
  "0204Bad02_Narrative024": "这不可能。",
  "0204Bad02_Narrative025": "我想追上她们问个清楚，<br>\n双脚却像被钉在地上一样动弹不得。",
  "0204Bad02_Hiro027": "（不，这不可能……一定哪里搞错了）",
  "0204Bad02_Hiro028": "我怎么会已经死了……",
  "0204Bad02_Girl003": "呵呵，没有搞错哦。",
  "0204Bad02_Hiro029": "！？",
  "0204Bad02_Narrative026": "我猛地回头看向声音响起的方向，<br>\n只见那里站着一名少女。",
  "0204Bad02_Narrative027": "就是在湖边见到的，那个少女。<br>\n把我拖入湖底的，那个少女。",
  "0204Bad02_Hiro030": "……为什么你会在这。",
  "0204Bad02_Girl004": "想着在我消失之前，<br>\n先告诉你一声。",
  "0204Bad02_Hiro031": "消失……？",
  "0204Bad02_Narrative028": "面对茫然的我，<br>\n她露出了无比愉悦的笑容。",
  "0204Bad02_Girl005": "你已经死在那个湖里了。<br>\n作为替代我的祭品。",
  "0204Bad02_Girl006": "多亏你，<br>\n我终于可以从这里解脱了。",
  "0204Bad02_Hiro032": "（祭品……）",
  "0204Bad02_Narrative029": "一股恶寒爬满全身，令我不由得颤抖。",
  "0204Bad02_Girl007": "接下来轮到你了。<br>\n直到献上下一个祭品前，<br>\n你会永～远被囚禁在这座监牢里哦。",
  "0204Bad02_Narrative030": "少女说完，<br>\n身影便渐渐淡去。",
  "0204Bad02_Hiro033": "等、等等！<br>\n我还有话想问……！",
  "0204Bad02_Girl008": "后面的你就自己查吧。",
  "0204Bad02_Girl009": "没事。<br>\n反正你的时间多得是呢。名副其实，多得要死。",
  "0204Bad02_Narrative031": "少女只留下一声轻笑，<br>\n便彻底消失了。",
  "0204Bad02_Hiro034": "（为什么……）",
  "0204Bad02_Narrative032": "——那时候，要是不去追什么影子就好了。<br>\n——说到底，当初要是不去什么湖边就好了。",
  "0204Bad02_Hiro035": "（……不，<br>\n　那个少女说的也不一定是真的）",
  "0204Bad02_Narrative033": "为了抓住最后一缕希望，<br>\n我朝着大家可能会在的会客厅走去。",
  "0204Bad02_Hiro036": "大家！！",
  "0204Bad02_Narrative034": "我一边扯着前所未有的大嗓门呼喊，<br>\n一边冲进了会客厅。",
  "0204Bad02_Narrative035": "会客室里除了米莉亚与蕾雅，<br>\n所有幸存成员都到齐了。<br>",
  "0204Bad02_Narrative036": "每个人都神情沉痛，<br>\n没有一个人看向我。",
  "0204Bad02_Hiro037": "你们听不到我的声音吗！<br>\n喂，其实你们听得见的吧？",
  "0204Bad02_Miria005": "……要是我当时跟着小希就好了……",
  "0204Bad02_Leia006": "我也是……",
  "0204Bad02_Ema001": "希罗怎么会就这么死掉……",
  "0204Bad02_Hiro038": "艾玛！我就在这里！<br>\n我没有死！！",
  "0204Bad02_Ema002": "呜呜，希罗……怎么会，<br>\n我不要……我不要这样……",
  "0204Bad02_Miria006": "艾玛……",
  "0204Bad02_Narrative037": "艾玛的眼泪大颗大颗滚落，<br>\n哭着瘫坐在地上。",
  "0204Bad02_Hiro039": "艾玛！不是的！我还活着！！<br>\n这一定是，什么恶作剧——！",
  "0204Bad02_Hiro040": "（这太奇怪了……<br>\n　奇怪，太奇怪了，太奇怪了太奇怪了！）",
  "0204Bad02_Hiro041": "我在这里！我就在这里啊！<br>\n我根本没死！<br>\n所以……拜托了，谁都好，注意到我吧……",
  "0204Bad02_Narrative038": "无论我如何哭喊，如何尖叫，<br>\n我的声音都传不到任何人耳中——",
  "0204Bad02_Narrative039": "在连死亡都不被允许的绝望笼罩下，<br>\n我被囚禁在这座监牢之中，直到永远。"
}
}
