    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "好。一起去找它吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv02_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Leia.Smile1,ArmR1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "没有必要次次都配合蕾雅演戏。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv02_Narrative011"]}},
