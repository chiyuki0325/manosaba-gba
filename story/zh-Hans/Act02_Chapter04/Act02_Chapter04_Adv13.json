    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "橘雪莉。<br>\n远野汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 64, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1", "SubId": "Middle"}},
