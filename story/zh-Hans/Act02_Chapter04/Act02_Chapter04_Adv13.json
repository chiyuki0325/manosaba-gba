    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "审判庭里少女们已经到齐了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
