    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "佐伯米莉亚。<br>\n紫藤亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative011"]}},
    {"op": "HideAllCharacters", "line": 70, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Fearful1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "还有我……共五人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative012"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "直到那时我才终于意识到——<br>\n艾玛不在了，蕾雅不在了——已是事实。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative013"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "——她们，被杀了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative014"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "已经不在这个世界上的任何地方了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative015"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "我环视周围的四名少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative016"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "（被杀了，被杀了，<br>\n　她们被杀了——！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Hiro005"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "我的大脑仍然无法正常运作，<br>\n只有她们被杀死这个事实，正不断压垮我的胸口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative017"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "（无论多么痛苦，<br>\n　也必须接受现实）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Hiro006"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "我按住呼吸困难的胸口，<br>\n逼迫自己抬起头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative018"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "我不能被感情所控制。<br>\n必须让自己思考清晰。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative019"]}},
