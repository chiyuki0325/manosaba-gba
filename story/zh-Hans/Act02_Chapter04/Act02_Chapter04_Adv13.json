    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "那之后的过程，<br>\n我已经不太记得了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "多半是因为查明发生了凶杀案，<br>\n大家被叫到会客厅集合……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "多半是典狱长提出<br>\n要举行魔女审判……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative003"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "于是在审判前的先行投票中我又一次获得最高票数，<br>\n直到审判开始前我都要被关押在惩罚室里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative004"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "完全无法思考。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative005"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "在我的脑海里，<br>\n不断盘旋着<br>\n艾玛的尸体和蕾雅的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative006"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（艾玛，死了……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Hiro001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "（蕾雅，死了……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Hiro002"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "即使是亲眼所见，<br>\n我也难以接受这就是现实。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Narrative007"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（我还来不及向艾玛道歉……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Hiro003"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "（我还有来不及对蕾雅说的话……）<br>", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv13_Hiro004"]}},
