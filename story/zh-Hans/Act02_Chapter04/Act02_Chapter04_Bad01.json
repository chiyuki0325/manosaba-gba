{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter04/Act02_Chapter04_Bad01",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-4-b1", "line": 8, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "偶尔配合蕾雅一次，或许也不错。<br>\n我没想太多，回握住了她的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative001"]}},
    {"op": "PlayBgm", "line": 20, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Surprised1,ArmR2"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "！！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "蕾雅猛地抬起头，露出吃惊的神情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "明明是她自己先摆出求爱的架势的，<br>\n大概是以为我会无视她吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Flushed1,ArmR2"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "希罗，你……？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "她凑近我，<br>\n仿佛想从我眼中看穿我的真意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 36, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Leia.Flushed1,ArmR1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "……怎么了？<br>\n不是要去找典狱长吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "ScenePosition": [65.0, 50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "是啊……那就走吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia003"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "她愣了好一阵子，<br>\n随后带着些许喜悦的笑容点了点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 49, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "我牵起她的手，只是一时心血来潮。<br>\n其中并无更深的含义。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative006"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "然而，在我握住她向我伸来的手时，<br>\n与她目光交汇的瞬间，<br>\n我却被某种奇妙的感觉席卷。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative007"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "虽说无法用言语清楚地表达……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative008"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "但那一刻，就像是拼图终于找到了最后一块，<br>\n就像是卡住的齿轮终于啮合在一起。<br>\n这一刻，似乎在我和蕾雅之间，产生了某种连结。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "得在放风时间结束前，<br>\n找到典狱长才行。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro002"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "那就先从监牢内部找起吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia004"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "我与蕾雅并肩前行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative010"]}},
    {"op": "ResetText", "line": 68, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 70, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 71, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 72, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 74, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 76, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 77, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "几天后的夜晚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative011"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "我像往常一样写下日记。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative012"]}},
    {"op": "PlaySfxModified", "line": 84, "indent": 0, "params": {"SfxPath": "Sfx_111", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "游说典狱长以失败告终。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative013"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "不论如何恳求它停止魔女审判，<br>\n那只猫头鹰都毫不理会。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative014"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "蕾雅虽然有些沮丧，<br>\n但她向我表示了感激。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative015"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "她说，是因为有我在身边。<br>\n她说，是我的坚强支撑着她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative016"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "老实说，这种让人牙酸的话真叫人受不了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative017"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "可我也是一样的。<br>\n今天一整天与她同行，终于令我明白。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative018"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "虽然我自己绝对说不出这种腻歪话——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative019"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "但是，在和蕾雅同行的时间里，我的确得到了内心的安稳。<br>\n有她在我身边，真是太好了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative020"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "——写到这里，我放下了笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative021"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "无意间看到自己的指甲，我痛苦地咬住了嘴唇。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative022"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "今早明明才刚剪短的指甲，不知何时已悄然生长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative023"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我不想承认。<br>\n我自己也出现了魔女化的征兆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative024"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "（时间所剩无几了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro003"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "大魔女的线索依旧没有头绪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative025"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "游说典狱长也已失败。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative026"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "那么，我该怎么办？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative027"]}},
    {"op": "StopBgm", "line": 119, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "要怎样才能，拯救大家？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative028"]}},
    {"op": "ResetText", "line": 123, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 124, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 125, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 126, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 128, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "StopBgm", "line": 130, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 131, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 132, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 134, "indent": 0, "params": {"BgmPath": "Bgm_40_1_Loop", "IntroBgmPath": "Bgm_40_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "又过了几天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative029"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "看来时限将近的人，并不止我一个。<br>\n每个人的精神压力都已接近极限。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative030"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "就在刚才，亚里沙和其他少女们<br>\n又为了一点琐事争吵起来。<br>\n现在杀意一触即发。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative031"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "再这样下去，不久后又会发生凶杀案。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative032"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "这几天，我不断思考。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative033"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "如何才能拯救她们。<br>\n到底什么才是她们需要的【救赎】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative034"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "最终，我得出了一个答案。<br>\n今天，我准备将这个答案向蕾雅分享。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative035"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "或许她会……<br>\n不，几乎可以肯定她会否定我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative036"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "但那也无妨。<br>\n就算孤身一人，我也会完成。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative037"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "不过，如果蕾雅能与我并肩同行的话——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative038"]}},
    {"op": "PlaySfxModified", "line": 157, "indent": 0, "params": {"SfxPath": "Sfx_73", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "久等了，希罗。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia005"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "不好意思，突然把你叫出来。<br>\n我有话想对你说。<br>\n其实——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro004"]}},
    {"op": "ResetText", "line": 165, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 166, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 167, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 168, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 169, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 171, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "ModifyBackgroundExtended", "line": 173, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 174, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "——蕾雅接受了我的答案。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative039"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "紧接着，我们开始了行动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative040"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "亚里沙死了。<br>\n米莉亚死了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative041"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "雪莉死了。<br>\n汉娜死了。<br>\n艾玛也死了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative042"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "只剩下我与蕾雅二人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative043"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "阳光温柔洒落在中庭里。<br>\n我坐在地上，让蕾雅枕着我的膝盖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative044"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "仿佛时间停滞般的宁静笼罩着我们，<br>\n唯有树影在缓缓摇曳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative045"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "我轻抚她柔软的发丝，<br>\n每当我的手指拂过，<br>\n她都会像被挠痒似的微微眯起眼睛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative046"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [35.0, 40.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [65.0, 30.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "大家都死了呢。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Smile1"}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "是啊。都死了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro005"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "目光相交，我们相视而笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative047"]}},
    {"op": "HideAllCharacters", "line": 203, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "我……我与蕾雅两人，完成了这一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative048"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "我们一起，杀了所有人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative049"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "为了将她们从大魔女的诅咒中解放。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative050"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "所以，必须杀死她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative051"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "这，就是我得出的答案。<br>\n唯一能拯救大家的方法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative052"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "我们缜密地制定计划，<br>\n逐一夺走少女们的生命。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative053"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "是因为蕾雅在我身边才能做到。<br>\n她既聪明又果断。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative054"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "所以，杀死少女们的过程，<br>\n比我想像中要容易许多。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative055"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "这不是其他人能做到的事。<br>\n唯有我与蕾雅，才能完成。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative056"]}},
    {"op": "ModifyCharacterExtended", "line": 223, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "蕾雅，谢谢你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro006"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "我握住她的手。<br>\n而她轻轻地摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative057"]}},
    {"op": "HideAllCharacters", "line": 229, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [35.0, 40.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [65.0, 30.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "没关系的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia007"]}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "我原以为，你会反对我的计划。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro007"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "确实……在听到这个提议时我很震惊。<br>\n不过，我认为你的想法是对的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia008"]}},
    {"op": "ModifyCharacterExtended", "line": 241, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "留给我们的救赎，<br>\n已经只剩下“死”了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia009"]}},
    {"op": "ModifyCharacterExtended", "line": 245, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "大家都到极限了。<br>\n……这一点我也一样。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia010"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "她露出一丝自嘲的微笑。<br>\n接着，像是在告解自己的罪行般继续说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative058"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "……我曾经对艾玛怀有杀意。<br>\n一开始是源于嫉妒。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia011"]}},
    {"op": "ModifyCharacterExtended", "line": 253, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "嫉妒？对艾玛？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "嗯。<br>\n因为，你总是那么在意艾玛啊。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia012"]}},
    {"op": "ModifyCharacterExtended", "line": 261, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "如果那样继续下去，<br>\n就算今天我们没有这么做，我迟早也会杀了她。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia013"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro009"]}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "我啊，我想让希罗，<br>\n只看着我一个人。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia014"]}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "蕾雅的语气似带着一丝玩笑，<br>\n但眼神却无比认真。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative059"]}},
    {"op": "ModifyCharacterExtended", "line": 271, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Flushed1"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "我不知该作何反应。<br>\n这时，她再次开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative060"]}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "所以我其实很高兴。<br>\n你愿意告诉我。<br>\n还愿意选我成为你的共犯。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia015"]}},
    {"op": "ModifyCharacterExtended", "line": 277, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "啊……原来如此。<br>\n我能和魔女化抵抗到最后，<br>\n或许正是因为这个原因吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia016"]}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "因为希罗，选择了我。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia017"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "蕾雅深深凝视着我。<br>\n她的双瞳，正闪耀着宝石般的光芒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative061"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "她的眼睛让我明白，留给我们的时间已经不多了。<br>\n那并非比喻，她的瞳孔正逐渐硬化，<br>\n如同真正的宝石。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative062"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "这应该是药的副作用。<br>\n蕾雅饮下的药，<br>\n正是藏在监牢中的【杀死魔女的药】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative063"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "我们曾经立下誓言。<br>\n当一切结束之时，便亲手让帷幕落下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative064"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "……谢谢你。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia018"]}},
    {"op": "ModifyCharacterExtended", "line": 295, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Cry1"}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "再等等我。<br>\n我还有话，想对你说……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro010"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "应该道谢的，是我才对……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 301, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Smile1"}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "虽然只是短短的时间，但我真的很高兴能与你同行。<br>\n能在这监牢中遇见你，真的太好了……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro012"]}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "那些羞于启齿的话语，如今终于倾泻而出。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative065"]}},
    {"op": "HideAllCharacters", "line": 307, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "话音刚落。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative066"]}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "蕾雅已悄然没了呼吸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative067"]}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "不知她是否听见了我的心声——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative068"]}},
    {"op": "ResetText", "line": 318, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 319, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 320, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 321, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 323, "indent": 0, "params": {"TintColor": "#dfd1a2", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyCharacterExtended", "line": 324, "indent": 0, "params": {"Scale": [1.0], "TintColor": "#dfd1a2", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Leia.Smile1,ArmR2"}},
    {"op": "ModifyBackgroundExtended", "line": 326, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 327, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "希罗，<br>\n请你跟我一起去吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Leia019"]}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "不知为何，<br>\n蕾雅突然单膝跪地，<br>\n郑重而优雅地向我伸出了手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative069"]}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "那动作<br>\n宛如向公主求爱的王子一般。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative070"]}},
    {"op": "ResetText", "line": 339, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 340, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 341, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 342, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 343, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 345, "indent": 0, "params": {"TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "ModifyBackgroundExtended", "line": 347, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 348, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "当我牵起她的手的那一刻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative071"]}},
    {"op": "PrintTextModified", "line": 352, "indent": 0, "params": {"Text": "似乎感受到了我和蕾雅之间的某种连结。<br>\n就像是拼图终于找到了最后一块。<br>\n就像是卡住的齿轮终于啮合在一起。一种奇妙的感受。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative072"]}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "如今我终于明白。<br>\n那就是悟到自己正与命中注定的另一半<br>\n相遇的瞬间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative073"]}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "但如今，一切都已失去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative074"]}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "我已经永远失去了名为莲见蕾雅的另一半。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative075"]}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Hiro.Smile1"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "我也马上就去找你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Hiro013"]}},
    {"op": "HideAllCharacters", "line": 364, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "我取出药瓶，一口饮尽瓶中液体。<br>\n与蕾雅喝下的一样——是【杀死魔女的药】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative076"]}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "这样，我应该也能彻底死去吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative077"]}},
    {"op": "PrintTextModified", "line": 370, "indent": 0, "params": {"Text": "是否死亡回溯的魔法不会再发动，<br>\n就此迎来终焉呢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative078"]}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "我闭上双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative079"]}},
    {"op": "ResetText", "line": 374, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 375, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 376, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 377, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PrintTextModified", "line": 379, "indent": 0, "params": {"Text": "静静等待帷幕落下那一刻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad01_Narrative080"]}},
    {"op": "ProcessBadEnd", "line": 385, "indent": 0, "params": {"Number": 21}}
  ],
  "translations": {
  "0204Bad01_Narrative001": "偶尔配合蕾雅一次，或许也不错。<br>\n我没想太多，回握住了她的手。",
  "0204Bad01_Leia001": "！！",
  "0204Bad01_Narrative002": "蕾雅猛地抬起头，露出吃惊的神情。",
  "0204Bad01_Narrative003": "明明是她自己先摆出求爱的架势的，<br>\n大概是以为我会无视她吧。",
  "0204Bad01_Leia002": "希罗，你……？",
  "0204Bad01_Narrative004": "她凑近我，<br>\n仿佛想从我眼中看穿我的真意。",
  "0204Bad01_Hiro001": "……怎么了？<br>\n不是要去找典狱长吗？",
  "0204Bad01_Leia003": "是啊……那就走吧。",
  "0204Bad01_Narrative005": "她愣了好一阵子，<br>\n随后带着些许喜悦的笑容点了点头。",
  "0204Bad01_Narrative006": "我牵起她的手，只是一时心血来潮。<br>\n其中并无更深的含义。",
  "0204Bad01_Narrative007": "然而，在我握住她向我伸来的手时，<br>\n与她目光交汇的瞬间，<br>\n我却被某种奇妙的感觉席卷。",
  "0204Bad01_Narrative008": "虽说无法用言语清楚地表达……",
  "0204Bad01_Narrative009": "但那一刻，就像是拼图终于找到了最后一块，<br>\n就像是卡住的齿轮终于啮合在一起。<br>\n这一刻，似乎在我和蕾雅之间，产生了某种连结。",
  "0204Bad01_Hiro002": "得在放风时间结束前，<br>\n找到典狱长才行。",
  "0204Bad01_Leia004": "那就先从监牢内部找起吧。",
  "0204Bad01_Narrative010": "我与蕾雅并肩前行。",
  "0204Bad01_Narrative011": "几天后的夜晚。",
  "0204Bad01_Narrative012": "我像往常一样写下日记。",
  "0204Bad01_Narrative013": "游说典狱长以失败告终。",
  "0204Bad01_Narrative014": "不论如何恳求它停止魔女审判，<br>\n那只猫头鹰都毫不理会。",
  "0204Bad01_Narrative015": "蕾雅虽然有些沮丧，<br>\n但她向我表示了感激。",
  "0204Bad01_Narrative016": "她说，是因为有我在身边。<br>\n她说，是我的坚强支撑着她。",
  "0204Bad01_Narrative017": "老实说，这种让人牙酸的话真叫人受不了。",
  "0204Bad01_Narrative018": "可我也是一样的。<br>\n今天一整天与她同行，终于令我明白。",
  "0204Bad01_Narrative019": "虽然我自己绝对说不出这种腻歪话——",
  "0204Bad01_Narrative020": "但是，在和蕾雅同行的时间里，我的确得到了内心的安稳。<br>\n有她在我身边，真是太好了。",
  "0204Bad01_Narrative021": "——写到这里，我放下了笔。",
  "0204Bad01_Narrative022": "无意间看到自己的指甲，我痛苦地咬住了嘴唇。",
  "0204Bad01_Narrative023": "今早明明才刚剪短的指甲，不知何时已悄然生长。",
  "0204Bad01_Narrative024": "我不想承认。<br>\n我自己也出现了魔女化的征兆。",
  "0204Bad01_Hiro003": "（时间所剩无几了）",
  "0204Bad01_Narrative025": "大魔女的线索依旧没有头绪。",
  "0204Bad01_Narrative026": "游说典狱长也已失败。",
  "0204Bad01_Narrative027": "那么，我该怎么办？",
  "0204Bad01_Narrative028": "要怎样才能，拯救大家？",
  "0204Bad01_Narrative029": "又过了几天。",
  "0204Bad01_Narrative030": "看来时限将近的人，并不止我一个。<br>\n每个人的精神压力都已接近极限。",
  "0204Bad01_Narrative031": "就在刚才，亚里沙和其他少女们<br>\n又为了一点琐事争吵起来。<br>\n现在杀意一触即发。",
  "0204Bad01_Narrative032": "再这样下去，不久后又会发生凶杀案。",
  "0204Bad01_Narrative033": "这几天，我不断思考。",
  "0204Bad01_Narrative034": "如何才能拯救她们。<br>\n到底什么才是她们需要的【救赎】。",
  "0204Bad01_Narrative035": "最终，我得出了一个答案。<br>\n今天，我准备将这个答案向蕾雅分享。",
  "0204Bad01_Narrative036": "或许她会……<br>\n不，几乎可以肯定她会否定我。",
  "0204Bad01_Narrative037": "但那也无妨。<br>\n就算孤身一人，我也会完成。",
  "0204Bad01_Narrative038": "不过，如果蕾雅能与我并肩同行的话——",
  "0204Bad01_Leia005": "久等了，希罗。",
  "0204Bad01_Hiro004": "不好意思，突然把你叫出来。<br>\n我有话想对你说。<br>\n其实——",
  "0204Bad01_Narrative039": "——蕾雅接受了我的答案。",
  "0204Bad01_Narrative040": "紧接着，我们开始了行动。",
  "0204Bad01_Narrative041": "亚里沙死了。<br>\n米莉亚死了。",
  "0204Bad01_Narrative042": "雪莉死了。<br>\n汉娜死了。<br>\n艾玛也死了。",
  "0204Bad01_Narrative043": "只剩下我与蕾雅二人。",
  "0204Bad01_Narrative044": "阳光温柔洒落在中庭里。<br>\n我坐在地上，让蕾雅枕着我的膝盖。",
  "0204Bad01_Narrative045": "仿佛时间停滞般的宁静笼罩着我们，<br>\n唯有树影在缓缓摇曳。",
  "0204Bad01_Narrative046": "我轻抚她柔软的发丝，<br>\n每当我的手指拂过，<br>\n她都会像被挠痒似的微微眯起眼睛。",
  "0204Bad01_Leia006": "大家都死了呢。",
  "0204Bad01_Hiro005": "是啊。都死了。",
  "0204Bad01_Narrative047": "目光相交，我们相视而笑。",
  "0204Bad01_Narrative048": "我……我与蕾雅两人，完成了这一切。",
  "0204Bad01_Narrative049": "我们一起，杀了所有人。",
  "0204Bad01_Narrative050": "为了将她们从大魔女的诅咒中解放。",
  "0204Bad01_Narrative051": "所以，必须杀死她们。",
  "0204Bad01_Narrative052": "这，就是我得出的答案。<br>\n唯一能拯救大家的方法。",
  "0204Bad01_Narrative053": "我们缜密地制定计划，<br>\n逐一夺走少女们的生命。",
  "0204Bad01_Narrative054": "是因为蕾雅在我身边才能做到。<br>\n她既聪明又果断。",
  "0204Bad01_Narrative055": "所以，杀死少女们的过程，<br>\n比我想像中要容易许多。",
  "0204Bad01_Narrative056": "这不是其他人能做到的事。<br>\n唯有我与蕾雅，才能完成。",
  "0204Bad01_Hiro006": "蕾雅，谢谢你。",
  "0204Bad01_Narrative057": "我握住她的手。<br>\n而她轻轻地摇了摇头。",
  "0204Bad01_Leia007": "没关系的。",
  "0204Bad01_Hiro007": "我原以为，你会反对我的计划。",
  "0204Bad01_Leia008": "确实……在听到这个提议时我很震惊。<br>\n不过，我认为你的想法是对的。",
  "0204Bad01_Leia009": "留给我们的救赎，<br>\n已经只剩下“死”了。",
  "0204Bad01_Leia010": "大家都到极限了。<br>\n……这一点我也一样。",
  "0204Bad01_Narrative058": "她露出一丝自嘲的微笑。<br>\n接着，像是在告解自己的罪行般继续说道。",
  "0204Bad01_Leia011": "……我曾经对艾玛怀有杀意。<br>\n一开始是源于嫉妒。",
  "0204Bad01_Hiro008": "嫉妒？对艾玛？",
  "0204Bad01_Leia012": "嗯。<br>\n因为，你总是那么在意艾玛啊。",
  "0204Bad01_Leia013": "如果那样继续下去，<br>\n就算今天我们没有这么做，我迟早也会杀了她。",
  "0204Bad01_Hiro009": "！",
  "0204Bad01_Leia014": "我啊，我想让希罗，<br>\n只看着我一个人。",
  "0204Bad01_Narrative059": "蕾雅的语气似带着一丝玩笑，<br>\n但眼神却无比认真。",
  "0204Bad01_Narrative060": "我不知该作何反应。<br>\n这时，她再次开口说道。",
  "0204Bad01_Leia015": "所以我其实很高兴。<br>\n你愿意告诉我。<br>\n还愿意选我成为你的共犯。",
  "0204Bad01_Leia016": "啊……原来如此。<br>\n我能和魔女化抵抗到最后，<br>\n或许正是因为这个原因吧。",
  "0204Bad01_Leia017": "因为希罗，选择了我。",
  "0204Bad01_Narrative061": "蕾雅深深凝视着我。<br>\n她的双瞳，正闪耀着宝石般的光芒。",
  "0204Bad01_Narrative062": "她的眼睛让我明白，留给我们的时间已经不多了。<br>\n那并非比喻，她的瞳孔正逐渐硬化，<br>\n如同真正的宝石。",
  "0204Bad01_Narrative063": "这应该是药的副作用。<br>\n蕾雅饮下的药，<br>\n正是藏在监牢中的【杀死魔女的药】。",
  "0204Bad01_Narrative064": "我们曾经立下誓言。<br>\n当一切结束之时，便亲手让帷幕落下。",
  "0204Bad01_Leia018": "……谢谢你。",
  "0204Bad01_Hiro010": "再等等我。<br>\n我还有话，想对你说……",
  "0204Bad01_Hiro011": "应该道谢的，是我才对……",
  "0204Bad01_Hiro012": "虽然只是短短的时间，但我真的很高兴能与你同行。<br>\n能在这监牢中遇见你，真的太好了……",
  "0204Bad01_Narrative065": "那些羞于启齿的话语，如今终于倾泻而出。",
  "0204Bad01_Narrative066": "话音刚落。",
  "0204Bad01_Narrative067": "蕾雅已悄然没了呼吸。",
  "0204Bad01_Narrative068": "不知她是否听见了我的心声——",
  "0204Bad01_Leia019": "希罗，<br>\n请你跟我一起去吧。",
  "0204Bad01_Narrative069": "不知为何，<br>\n蕾雅突然单膝跪地，<br>\n郑重而优雅地向我伸出了手。",
  "0204Bad01_Narrative070": "那动作<br>\n宛如向公主求爱的王子一般。",
  "0204Bad01_Narrative071": "当我牵起她的手的那一刻。",
  "0204Bad01_Narrative072": "似乎感受到了我和蕾雅之间的某种连结。<br>\n就像是拼图终于找到了最后一块。<br>\n就像是卡住的齿轮终于啮合在一起。一种奇妙的感受。",
  "0204Bad01_Narrative073": "如今我终于明白。<br>\n那就是悟到自己正与命中注定的另一半<br>\n相遇的瞬间。",
  "0204Bad01_Narrative074": "但如今，一切都已失去。",
  "0204Bad01_Narrative075": "我已经永远失去了名为莲见蕾雅的另一半。",
  "0204Bad01_Hiro013": "我也马上就去找你。",
  "0204Bad01_Narrative076": "我取出药瓶，一口饮尽瓶中液体。<br>\n与蕾雅喝下的一样——是【杀死魔女的药】。",
  "0204Bad01_Narrative077": "这样，我应该也能彻底死去吧。",
  "0204Bad01_Narrative078": "是否死亡回溯的魔法不会再发动，<br>\n就此迎来终焉呢。",
  "0204Bad01_Narrative079": "我闭上双眼。",
  "0204Bad01_Narrative080": "静静等待帷幕落下那一刻。"
}
}
