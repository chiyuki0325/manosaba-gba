    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "ScenePosition": [-20.0], "IdAndAppearance": "Sherry"}},
    {"op": "Wait", "line": 232, "indent": 0, "params": {"WaitMode": "1.1"}},
