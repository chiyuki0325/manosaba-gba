    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我和蕾雅来到了招待所的<br>\n【<ruby=\"UNDINE\">水精</ruby>之室】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "虽然没发现典狱长……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "哎呀，真巧啊！<br>\n这不是蕾雅和希罗吗！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "但发现了雪莉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "雪莉该不会是<br>\n来探索地下的？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "答对了！<br>\n说到调查的话，果然还是这里最合适！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "正好你们来了，<br>\n要不要一起去地下探索？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry003"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "典狱长确实有可能在地下。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "是啊，毕竟那里<br>\n有不少能操控监牢机关的装置。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "好吧，我也去。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "太好了！<br>\n那我们赶紧出发吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry004"]}},
    {"op": "ResetText", "line": 57, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 58, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 59, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 60, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 62, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "31_2"}},
    {"op": "ModifyBackgroundExtended", "line": 63, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 64, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "——我们沿着秘密楼梯，下楼来到半地下层，<br>\n三人一同乘上了电梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative004"]}},
    {"op": "ModifyBackgroundExtended", "line": 68, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "31_2"}},
    {"op": "Wait", "line": 69, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia"}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry"}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "……然而。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative005"]}},
    {"op": "PlaySfxModified", "line": 78, "indent": 0, "params": {"SfxPath": "Sfx_146", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "Wait", "line": 83, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "警示音响起，<br>\n电梯纹丝不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "啊，对了，<br>\n这台电梯只能乘坐两个人……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry005"]}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "毕竟这么老旧了……<br>\n没办法，我在这里等着，<br>\n你们两个去吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Leia003"]}},
    {"op": "HideActors", "line": 96, "indent": 0, "params": {"ActorIds": ["Leia"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "蕾雅发挥她的绅士风度，<br>\n飒爽地走出电梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative007"]}},
    {"op": "ResetText", "line": 100, "indent": 0, "params": {}},
    {"op": "Wait", "line": 101, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlayBgm", "line": 104, "indent": 0, "params": {"BgmPath": "Ambi_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 106, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 107, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 108, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 109, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 110, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "于是，<br>\n电梯终于慢慢启动了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative008"]}},
    {"op": "ModifyBackgroundExtended", "line": 114, "indent": 0, "params": {"Scale": [3.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 60.0], "AppearanceAndTransition": "31_2"}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyBackgroundExtended", "line": 117, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 118, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "电梯成功启动了，希罗！<br>\n地下探索，出发出发！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry006"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "（老实说……宁愿在外面等的是我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "StopBgm", "line": 125, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "FadeOutDuration": 10.0}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "话说，<br>\n这个电梯里是不是有点热？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry007"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "雪莉一边用手向自己扇风，<br>\n一边说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative009"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro004"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "我假装没听见。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative010"]}},
    {"op": "ResetText", "line": 135, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 136, "indent": 0, "params": {"SlotNumber": 23, "Wait": 0}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "这里的氛围好诡异啊。<br>\n感觉像是会就这么直接通往异世界……<br>\n你听说过吗？关于电梯的都市怪谈。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry008"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "这里全是怪事，<br>\n试试照我说的，说不定真的能行哦！<br>\n异世界耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry009"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro006"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "都说到这里了，实在是心痒痒！<br>\n要不要试试看！？<br>\n异世界电梯耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "我实在是好奇得不得了啦！<br>\n来吧来吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry011"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "我——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative011"]}},
    {"op": "AddChoice", "line": 160, "indent": 0, "params": {"ChoiceSummary": "阻止了雪莉", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0204Adv08_Choice001"]}},
    {"op": "GotoModified", "line": 161, "indent": 1, "params": {"Path": ".Choice2-4-3"}},
    {"op": "AddChoice", "line": 163, "indent": 0, "params": {"ChoiceSummary": "没有阻止雪莉", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0204Adv08_Choice002"]}},
    {"op": "GotoModified", "line": 164, "indent": 1, "params": {"Path": "Act02_Chapter04/Act02_Chapter04_Bad03", "ResetState": ["-"]}},
    {"op": "StopForChoice", "line": 166, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice2-4-3", "line": 168, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 170, "indent": 0, "params": {"Number": 23}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "别胡闹了。<br>\n我们是来探索地下设施的，<br>\n别忘了正事。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro008"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "我终于忍不住开口，制止了雪莉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Flushed1"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "嘿嘿☆　说得也是哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry012"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "（真是的……本来以为只要我不理睬，她就能稍微安静一会……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro009"]}},
    {"op": "StopBgm", "line": 185, "indent": 0, "params": {"BgmPath": "Ambi_5_1"}},
    {"op": "PlaySfxModified", "line": 186, "indent": 0, "params": {"SfxPath": "Sfx_68", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 188, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "好耶！我们到了哦，希罗！<br>\n地下探索正式开始！加油努力冲！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Sherry013"]}},
    {"op": "EmoteJumpDouble", "line": 195, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "雪莉高举拳头，<br>\n兴奋地跳了起来——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative013"]}},
    {"op": "PlaySfxModified", "line": 200, "indent": 0, "params": {"SfxPath": "Sfx_147", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 202, "indent": 0, "params": {"Scale": [3.0], "Lazy": 0, "ScenePosition": [50.0, 60.0], "AppearanceAndTransition": "31_3"}},
    {"op": "Wait", "line": 203, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "她的拳头直接撞上电梯轿厢顶部，<br>\n把电梯顶板的盖子砸开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Narrative014"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "唉……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro010"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "（坐个电梯就已经这么累了……<br>\n　有种不祥的预感）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv08_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 213, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 215, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 216, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 217, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 218, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 220, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "26_1"}},
