    {"op": "ModifyBackgroundExtended", "line": 113, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 114, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PlaySfxModified", "line": 117, "indent": 0, "params": {"SfxPath": "Sfx_157", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 120, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "31_2"}},
    {"op": "ModifyBackgroundExtended", "line": 121, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 122, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "电梯门开启，<br>\n却没有人进来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "够了。<br>\n差不多该继续探索地下的正事了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro005"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "……要去下面，必须去下面……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry004"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "你在听吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro006"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "要去……地……去……异世……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry005"]}},
    {"op": "PlaySfxModified", "line": 141, "indent": 0, "params": {"SfxPath": "Sfx_157", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 143, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 144, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 145, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 146, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "HideAllCharacters", "line": 147, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "雪莉一边念叨着什么，<br>\n一边按下了通往地下的按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative007"]}},
    {"op": "PlayBgm", "line": 152, "indent": 0, "params": {"BgmPath": "Ambi_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 154, "indent": 0, "params": {"Scale": [3.0], "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "31_2"}},
    {"op": "ModifyBackgroundExtended", "line": 155, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 156, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "……带、……你去。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro007"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "（到底怎么回事？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro008"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "就在刚才，她还为了异世界什么什么的在那大惊小怪，<br>\n现在却安静得有些怪异。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative008"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "（就那么想去异世界吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro009"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "虽然觉得以雪莉的性格，<br>\n应该不至于为这点小事消沉，<br>\n但她的样子确实很反常。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative009"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "我正想着这些有的没的，<br>\n电梯停下了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 177, "indent": 0, "params": {"SfxPath": "Sfx_68", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 178, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "StopBgm", "line": 180, "indent": 0, "params": {"BgmPath": "Ambi_5_1"}},
    {"op": "PlaySfxModified", "line": 183, "indent": 0, "params": {"SfxPath": "Sfx_157", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 185, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 186, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 187, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 188, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyBackgroundExtended", "line": 189, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "HideAllCharacters", "line": 190, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyBackgroundExtended", "line": 192, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 193, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "……好黑啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro010"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "门外，<br>\n是连一丝光线都不存在的极致黑暗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative011"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "就连我也忍不住犹豫<br>\n要不要下电梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative012"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "可雪莉却毫不在意，<br>\n迈步踏向黑暗中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative013"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry007"]}},
    {"op": "PlayBgm", "line": 205, "indent": 0, "params": {"BgmPath": "Bgm_27_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "什……喂，等等！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro011"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "雪莉仿佛能看见路一般，<br>\n径直向前走得飞快。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative014"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "眨眼间，她的身影就被黑暗吞没，<br>\n再也看不见了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative015"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "我慌忙追了上去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative016"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "真是的，又自顾自地——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro012"]}},
    {"op": "AnimateActorExtended", "line": 219, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
