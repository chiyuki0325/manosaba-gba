    {"op": "AnimateActorExtended", "line": 225, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 226, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "……希罗！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "……欸？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro013"]}},
    {"op": "HideActors", "line": 238, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "HideActors", "line": 239, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "突然，雪莉的声音响起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative017"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "但那声音不知为何，却是从我背后——<br>\n电梯里传来的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative018"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "雪莉应该是在我前面先下的电梯才对。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative019"]}},
    {"op": "ShowActors", "line": 247, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "ShowActors", "line": 248, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "希罗！快点，快点回来……！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry009"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "怎么回事？<br>\n雪莉怎么会还在电梯里？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative020"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "我搞不懂。<br>\n但有一点可以确定的是——<br>\n我最好回到电梯里去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative021"]}},
    {"op": "HideActors", "line": 256, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "HideActors", "line": 257, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "不行……不会让你回去。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Girl001"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "这声音和雪莉一模一样。<br>\n但声音里的森森寒意，<br>\n令我毛骨悚然。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 265, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "（不能回头）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro014"]}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro015"]}},
    {"op": "ShowActors", "line": 273, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "ShowActors", "line": 274, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "希罗！赶紧啊！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry010"]}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "我猛然转身，<br>\n电梯却在我眼前开始缓缓上升。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "（怎么会……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro016"]}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "等等！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro017"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "希罗，快点！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry011"]}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "我拼命伸出手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative024"]}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "只差一点。<br>\n只差一点点就——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative025"]}},
    {"op": "StopBgm", "line": 291, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 292, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 293, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "HideActors", "line": 294, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "Wait", "line": 296, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlayBgm", "line": 298, "indent": 0, "params": {"BgmPath": "Bgm_27_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "呵呵……不行哦。<br>\n不让你回去、不让你回、不准你回、不准你逃。", "AuthorId": "Girl", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Girl002"]}},
    {"op": "SpawnShake", "line": 304, "indent": 0, "params": {"ActorId": "Camera", "ShakeCount": 1, "ShakeAmplitude": 0.10000000149011612, "AmplitudeVariation": 0.15000000596046448}},
    {"op": "ModifyCharacterExtended", "line": 306, "indent": 0, "params": {"TintColor": "#FFFFFF", "Lazy": 0, "IdAndAppearance": "Hiro.Fearful1"}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "噫！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro018"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "黑暗中伸出的手缠上了我的身体。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 312, "indent": 0, "params": {"TintColor": "#CCCCCC", "Duration": 3.0, "Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "不要！住手，放开我！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro019"]}},
    {"op": "ShowActors", "line": 316, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "ShowActors", "line": 317, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "希罗！希罗！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry012"]}},
    {"op": "HideActors", "line": 321, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "HideActors", "line": 322, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 324, "indent": 0, "params": {"TintColor": "#999999", "Duration": 3.0, "Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "我越是挣扎，<br>\n纠缠上来的手就越是增多，<br>\n它们正试图将我拖入黑暗深处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative027"]}},
    {"op": "StopBgm", "line": 328, "indent": 0, "params": {}},
    {"op": "Wait", "line": 329, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlayBgm", "line": 331, "indent": 0, "params": {"BgmPath": "Bgm_27_3", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "——就在这里，一起度过吧。<br>\n——一同融化在这黑暗。<br>\n——永远，在这黑暗中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative028"]}},
    {"op": "ModifyCharacterExtended", "line": 335, "indent": 0, "params": {"TintColor": "#666666", "Duration": 3.0, "Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 337, "indent": 0, "params": {"Text": "不要不要不要不要不要不要不要！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro020"]}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "我试图挣脱那些在脑中不断回响的低语，却无能为力。<br>\n我的身体、我的视野、我的意识，<br>\n全都被黑暗逐一蚕食。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 341, "indent": 0, "params": {"TintColor": "#444444", "Duration": 3.0, "Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "啊，啊啊……啊啊！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 345, "indent": 0, "params": {"TintColor": "#333333", "Duration": 3.0, "Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 347, "indent": 0, "params": {"Text": "（不行，再这样下去我会……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 349, "indent": 0, "params": {"TintColor": "#222222", "Duration": 3.0, "Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "救救……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro023"]}},
    {"op": "ShowActors", "line": 353, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "ShowActors", "line": 354, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "……希罗！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry013"]}},
    {"op": "HideActors", "line": 358, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Lazy": 0}},
    {"op": "HideActors", "line": 359, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "Wait", "line": 361, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyCharacterExtended", "line": 363, "indent": 0, "params": {"TintColor": "#000000", "Duration": 3.0, "Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "StopBgm", "line": 365, "indent": 0, "params": {}},
    {"op": "Wait", "line": 367, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlaySfxModified", "line": 370, "indent": 0, "params": {"SfxPath": "Sfx_157", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 372, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 374, "indent": 0, "params": {"Text": "随着雪莉撕心裂肺的呼喊戛然而止，<br>\n我再也未能见到光明。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative030"]}},
    {"op": "ProcessBadEnd", "line": 380, "indent": 0, "params": {"Number": 23}}
  ],
  "translations": {
  "0204Bad03_Hiro001": "反正就算我制止，你也不会听吧……<br>\n那就随你便好了。",
  "0204Bad03_Sherry001": "希罗你很懂我嘛！<br>\n那么那么，我先暂时回地面一趟哦！",
  "0204Bad03_Narrative001": "雪莉在中途停下电梯，<br>\n随即按下了去上层的按钮。",
  "0204Bad03_Narrative002": "电梯门一开，<br>\n映入眼帘的是一脸惊讶的蕾雅。",
  "0204Bad03_Leia001": "……咦？地下探索这就结束了吗？",
  "0204Bad03_Sherry002": "不是的！在那之前我还有点想试试看的事！",
  "0204Bad03_Narrative003": "橘雪莉立刻关上电梯门，<br>\n然后反复按着按钮。",
  "0204Bad03_Hiro002": "……你只是在随便乱按而已吧？",
  "0204Bad03_Sherry003": "才不是呢！我有好好按照顺序来的！",
  "0204Bad03_Narrative004": "电梯一再升起又降下，反复不停。",
  "0204Bad03_Hiro003": "（总感觉开始有点恶心想吐了……）",
  "0204Bad03_Narrative005": "我正想着是不是该劝她适可而止时，<br>\n电梯终于停住了。",
  "0204Bad03_Hiro004": "（结束了吗？）",
  "0204Bad03_Narrative006": "电梯门开启，<br>\n却没有人进来。",
  "0204Bad03_Hiro005": "够了。<br>\n差不多该继续探索地下的正事了。",
  "0204Bad03_Sherry004": "……要去下面，必须去下面……",
  "0204Bad03_Hiro006": "你在听吗？",
  "0204Bad03_Sherry005": "要去……地……去……异世……",
  "0204Bad03_Narrative007": "雪莉一边念叨着什么，<br>\n一边按下了通往地下的按钮。",
  "0204Bad03_Sherry006": "……带、……你去。",
  "0204Bad03_Hiro007": "？",
  "0204Bad03_Hiro008": "（到底怎么回事？）",
  "0204Bad03_Narrative008": "就在刚才，她还为了异世界什么什么的在那大惊小怪，<br>\n现在却安静得有些怪异。",
  "0204Bad03_Hiro009": "（就那么想去异世界吗？）",
  "0204Bad03_Narrative009": "虽然觉得以雪莉的性格，<br>\n应该不至于为这点小事消沉，<br>\n但她的样子确实很反常。",
  "0204Bad03_Narrative010": "我正想着这些有的没的，<br>\n电梯停下了。",
  "0204Bad03_Hiro010": "……好黑啊。",
  "0204Bad03_Narrative011": "门外，<br>\n是连一丝光线都不存在的极致黑暗。",
  "0204Bad03_Narrative012": "就连我也忍不住犹豫<br>\n要不要下电梯。",
  "0204Bad03_Narrative013": "可雪莉却毫不在意，<br>\n迈步踏向黑暗中。",
  "0204Bad03_Sherry007": "……",
  "0204Bad03_Hiro011": "什……喂，等等！",
  "0204Bad03_Narrative014": "雪莉仿佛能看见路一般，<br>\n径直向前走得飞快。",
  "0204Bad03_Narrative015": "眨眼间，她的身影就被黑暗吞没，<br>\n再也看不见了。",
  "0204Bad03_Narrative016": "我慌忙追了上去。",
  "0204Bad03_Hiro012": "真是的，又自顾自地——",
  "0204Bad03_Sherry008": "……希罗！",
  "0204Bad03_Hiro013": "……欸？",
  "0204Bad03_Narrative017": "突然，雪莉的声音响起。",
  "0204Bad03_Narrative018": "但那声音不知为何，却是从我背后——<br>\n电梯里传来的。",
  "0204Bad03_Narrative019": "雪莉应该是在我前面先下的电梯才对。",
  "0204Bad03_Sherry009": "希罗！快点，快点回来……！",
  "0204Bad03_Narrative020": "怎么回事？<br>\n雪莉怎么会还在电梯里？",
  "0204Bad03_Narrative021": "我搞不懂。<br>\n但有一点可以确定的是——<br>\n我最好回到电梯里去。",
  "0204Bad03_Girl001": "不行……不会让你回去。",
  "0204Bad03_Narrative022": "这声音和雪莉一模一样。<br>\n但声音里的森森寒意，<br>\n令我毛骨悚然。",
  "0204Bad03_Hiro014": "（不能回头）",
  "0204Bad03_Hiro015": "——！",
  "0204Bad03_Sherry010": "希罗！赶紧啊！！",
  "0204Bad03_Narrative023": "我猛然转身，<br>\n电梯却在我眼前开始缓缓上升。",
  "0204Bad03_Hiro016": "（怎么会……！）",
  "0204Bad03_Hiro017": "等等！",
  "0204Bad03_Sherry011": "希罗，快点！！",
  "0204Bad03_Narrative024": "我拼命伸出手。",
  "0204Bad03_Narrative025": "只差一点。<br>\n只差一点点就——",
  "0204Bad03_Girl002": "呵呵……不行哦。<br>\n不让你回去、不让你回、不准你回、不准你逃。",
  "0204Bad03_Hiro018": "噫！？",
  "0204Bad03_Narrative026": "黑暗中伸出的手缠上了我的身体。<br>",
  "0204Bad03_Hiro019": "不要！住手，放开我！",
  "0204Bad03_Sherry012": "希罗！希罗！",
  "0204Bad03_Narrative027": "我越是挣扎，<br>\n纠缠上来的手就越是增多，<br>\n它们正试图将我拖入黑暗深处。",
  "0204Bad03_Narrative028": "——就在这里，一起度过吧。<br>\n——一同融化在这黑暗。<br>\n——永远，在这黑暗中。",
  "0204Bad03_Hiro020": "不要不要不要不要不要不要不要！",
  "0204Bad03_Narrative029": "我试图挣脱那些在脑中不断回响的低语，却无能为力。<br>\n我的身体、我的视野、我的意识，<br>\n全都被黑暗逐一蚕食。",
  "0204Bad03_Hiro021": "啊，啊啊……啊啊！",
  "0204Bad03_Hiro022": "（不行，再这样下去我会……）",
  "0204Bad03_Hiro023": "救救……",
  "0204Bad03_Sherry013": "……希罗！",
  "0204Bad03_Narrative030": "随着雪莉撕心裂肺的呼喊戛然而止，<br>\n我再也未能见到光明。"
}
}
