    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "Wait", "line": 58, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "电梯门一开，<br>\n映入眼帘的是一脸惊讶的蕾雅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative002"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "……咦？地下探索这就结束了吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Leia001"]}},
    {"op": "HideAllCharacters", "line": 64, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "不是的！在那之前我还有点想试试看的事！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry002"]}},
    {"op": "ResetText", "line": 69, "indent": 0, "params": {}},
