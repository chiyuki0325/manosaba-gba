    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "反正就算我制止，你也不会听吧……<br>\n那就随你便好了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "希罗你很懂我嘛！<br>\n那么那么，我先暂时回地面一趟哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "雪莉在中途停下电梯，<br>\n随即按下了去上层的按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative001"]}},
    {"op": "ResetText", "line": 34, "indent": 0, "params": {}},
