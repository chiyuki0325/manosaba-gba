    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyBackgroundExtended", "line": 79, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 80, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "橘雪莉立刻关上电梯门，<br>\n然后反复按着按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative003"]}},
    {"op": "PlayBgm", "line": 85, "indent": 0, "params": {"BgmPath": "Ambi_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "……你只是在随便乱按而已吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Angry1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "才不是呢！我有好好按照顺序来的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Sherry003"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "电梯一再升起又降下，反复不停。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "（总感觉开始有点恶心想吐了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro003"]}},
    {"op": "PlaySfxModified", "line": 100, "indent": 0, "params": {"SfxPath": "Sfx_68", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 101, "indent": 0, "params": {"BgmPath": "Ambi_5_1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "我正想着是不是该劝她适可而止时，<br>\n电梯终于停住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（结束了吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad03_Hiro004"]}},
    {"op": "StopBgm", "line": 109, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "ResetText", "line": 111, "indent": 0, "params": {}},
