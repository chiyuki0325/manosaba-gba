  "path": "Act02_Chapter04/Act02_Chapter04_Adv06",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-4-6", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "18_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我和蕾雅来到了一处<br>\n离监牢不远的围墙前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "这是因为我们走到监牢外，在附近四处走动时，<br>\n偶然发现了亚里沙的身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "我们一路跟着亚里沙，<br>\n才来到了围墙前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "嗨，亚里沙。你在这里做什么呢？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "是你们啊……<br>\n关你们什么事？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "确实无关。<br>\n我们有我们的事要做，现在只是在找典狱长而已。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro001"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "亚里沙有看到典狱长吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "典狱长啊……今天没见到。<br>\n不过再往远处走一点，<br>\n能看到很多长得很像它的鸟在飞来飞去。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa002"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "那些家伙好像是负责监视，<br>\n但完全听不懂人话。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa003"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "这样啊。你是怎么发现的？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "……我烦躁得要死，<br>\n就朝它们丢火焰，把它们打下来了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa004"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "（又是这么激进的做法……<br>\n　看来亚里沙也已经被逼到绝境，<br>\n　身心俱疲了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "啊啊，可恶，要是能爬上这堵墙就好了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa005"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "亚里沙仰望着围墙，<br>\n无意识地念叨着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative004"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "原来如此。你是在寻找逃出去的方法？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "废话。<br>\n我可是从第一天开始就在想办法。<br>\n不赶紧离开这破地方，迟早要疯掉。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa006"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "这堵墙，我已经试着爬过无数次了。<br>\n但无论用什么方法，都会在半途被某种力量摔下来。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa007"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "我轻轻触碰围墙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative005"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "（难道被施加了某种魔法？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "要是再出不去……我可能，<br>\n就来不及了……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa008"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "来不及了，是指？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro006"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "……魔女化。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa009"]}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "亚里沙低声吐出的单词，<br>\n超出我的预料，让我不禁震惊得绷紧了身体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative006"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "我自己清楚。<br>\n我已经开始魔女化了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa010"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "魔女化程度加深后会产生杀人冲动？<br>\n一开始我也觉得这很荒谬。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa011"]}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "但是，在这里每天都这么痛苦，有时和别人一不小心对上眼，<br>\n就忍不住想：“啊，干脆杀了她吧”……什么的。<br>\n也许过不了多久，我就再也不能维持自我了……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa012"]}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Smile1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "所以啊，<br>\n你们最好别太靠近我。<br>\n我已经不知道自己会对谁产生杀意了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa013"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "亚里沙……至少我知道，<br>\n你并不希望发生这种事。<br>", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Smile1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "哈，你们嘴里说出来的话，<br>\n真是句句都那么虚伪。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa014"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "莲见、二阶堂。我最讨厌你们这种人了。<br>\n所以如果我真的成为魔女，<br>\n第一个要杀的就是你们吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa015"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "快滚！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Alisa016"]}},
    {"op": "HideActors", "line": 118, "indent": 0, "params": {"ActorIds": ["Alisa"], "Lazy": 0}},
    {"op": "Wait", "line": 119, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "……蕾雅，我们走吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro007"]}},
    {"op": "HideAllCharacters", "line": 123, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "我用平静的声音催促蕾雅。<br>\n我并没有感到愤怒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative007"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "正如蕾雅所说，亚里沙不想伤害他人。<br>\n正因如此，才希望我们疏远她，<br>\n我们应该尊重她这份心意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "或许，亚里沙其实是个心地善良的人呢……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Leia004"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "现在才发现吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 137, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "（……不只是亚里沙。<br>\n　我们之中的每一个人，都不想杀人）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro009"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "回想起昨天大家快乐玩耍的场面，<br>\n胸口更觉沉重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative009"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "（无论是互相残杀，还是彼此指控其他人是魔女，<br>\n　都不是我们心中所愿）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Hiro010"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "然而——那个【时刻】终会到来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative010"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "直到那个【时刻】降临，<br>\n我们只能恐惧着，抗争着，迷茫着，<br>\n静肃等待生命流逝到尽头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative011"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "我握紧拳头，迈步向前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative012"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "为了藏起指甲，我唯有把拳头越攥越紧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv06_Narrative013"]}},
    {"op": "UpdateWitchBook", "line": 153, "indent": 0, "params": {"Id": "Alisa", "Category": "Profile", "Version": 7}},
    {"op": "UpdateWitchBook", "line": 154, "indent": 0, "params": {"Id": "Hiro", "Category": "Profile", "Version": 3}},
    {"op": "Gosub", "line": 161, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 163, "indent": 0, "params": {"Path": "Act02_Chapter04/Act02_Chapter04_Adv03", "SoftReset": 1}}
  ],
  "translations": {
  "0204Adv06_Narrative001": "我和蕾雅来到了一处<br>\n离监牢不远的围墙前。",
  "0204Adv06_Narrative002": "这是因为我们走到监牢外，在附近四处走动时，<br>\n偶然发现了亚里沙的身影。",
  "0204Adv06_Narrative003": "我们一路跟着亚里沙，<br>\n才来到了围墙前。",
  "0204Adv06_Leia001": "嗨，亚里沙。你在这里做什么呢？",
  "0204Adv06_Alisa001": "是你们啊……<br>\n关你们什么事？",
  "0204Adv06_Hiro001": "确实无关。<br>\n我们有我们的事要做，现在只是在找典狱长而已。",
  "0204Adv06_Leia002": "亚里沙有看到典狱长吗？",
  "0204Adv06_Alisa002": "典狱长啊……今天没见到。<br>\n不过再往远处走一点，<br>\n能看到很多长得很像它的鸟在飞来飞去。",
  "0204Adv06_Alisa003": "那些家伙好像是负责监视，<br>\n但完全听不懂人话。",
  "0204Adv06_Hiro002": "这样啊。你是怎么发现的？",
  "0204Adv06_Alisa004": "……我烦躁得要死，<br>\n就朝它们丢火焰，把它们打下来了。",
  "0204Adv06_Hiro003": "（又是这么激进的做法……<br>\n　看来亚里沙也已经被逼到绝境，<br>\n　身心俱疲了……）",
  "0204Adv06_Alisa005": "啊啊，可恶，要是能爬上这堵墙就好了。",
  "0204Adv06_Narrative004": "亚里沙仰望着围墙，<br>\n无意识地念叨着。",
  "0204Adv06_Hiro004": "原来如此。你是在寻找逃出去的方法？",
  "0204Adv06_Alisa006": "废话。<br>\n我可是从第一天开始就在想办法。<br>\n不赶紧离开这破地方，迟早要疯掉。",
  "0204Adv06_Alisa007": "这堵墙，我已经试着爬过无数次了。<br>\n但无论用什么方法，都会在半途被某种力量摔下来。",
  "0204Adv06_Narrative005": "我轻轻触碰围墙。",
  "0204Adv06_Hiro005": "（难道被施加了某种魔法？）",
  "0204Adv06_Alisa008": "要是再出不去……我可能，<br>\n就来不及了……",
  "0204Adv06_Hiro006": "来不及了，是指？",
  "0204Adv06_Alisa009": "……魔女化。",
  "0204Adv06_Narrative006": "亚里沙低声吐出的单词，<br>\n超出我的预料，让我不禁震惊得绷紧了身体。",
  "0204Adv06_Alisa010": "我自己清楚。<br>\n我已经开始魔女化了。",
  "0204Adv06_Alisa011": "魔女化程度加深后会产生杀人冲动？<br>\n一开始我也觉得这很荒谬。",
  "0204Adv06_Alisa012": "但是，在这里每天都这么痛苦，有时和别人一不小心对上眼，<br>\n就忍不住想：“啊，干脆杀了她吧”……什么的。<br>\n也许过不了多久，我就再也不能维持自我了……",
  "0204Adv06_Alisa013": "所以啊，<br>\n你们最好别太靠近我。<br>\n我已经不知道自己会对谁产生杀意了。",
  "0204Adv06_Leia003": "亚里沙……至少我知道，<br>\n你并不希望发生这种事。<br>",
  "0204Adv06_Alisa014": "哈，你们嘴里说出来的话，<br>\n真是句句都那么虚伪。",
  "0204Adv06_Alisa015": "莲见、二阶堂。我最讨厌你们这种人了。<br>\n所以如果我真的成为魔女，<br>\n第一个要杀的就是你们吧。",
  "0204Adv06_Alisa016": "快滚！",
  "0204Adv06_Hiro007": "……蕾雅，我们走吧。",
  "0204Adv06_Narrative007": "我用平静的声音催促蕾雅。<br>\n我并没有感到愤怒。",
  "0204Adv06_Narrative008": "正如蕾雅所说，亚里沙不想伤害他人。<br>\n正因如此，才希望我们疏远她，<br>\n我们应该尊重她这份心意。",
  "0204Adv06_Leia004": "或许，亚里沙其实是个心地善良的人呢……",
  "0204Adv06_Hiro008": "现在才发现吗？",
  "0204Adv06_Hiro009": "（……不只是亚里沙。<br>\n　我们之中的每一个人，都不想杀人）",
  "0204Adv06_Narrative009": "回想起昨天大家快乐玩耍的场面，<br>\n胸口更觉沉重。",
  "0204Adv06_Hiro010": "（无论是互相残杀，还是彼此指控其他人是魔女，<br>\n　都不是我们心中所愿）",
  "0204Adv06_Narrative010": "然而——那个【时刻】终会到来。",
  "0204Adv06_Narrative011": "直到那个【时刻】降临，<br>\n我们只能恐惧着，抗争着，迷茫着，<br>\n静肃等待生命流逝到尽头。",
  "0204Adv06_Narrative012": "我握紧拳头，迈步向前。",
  "0204Adv06_Narrative013": "为了藏起指甲，我唯有把拳头越攥越紧。"
}
}
