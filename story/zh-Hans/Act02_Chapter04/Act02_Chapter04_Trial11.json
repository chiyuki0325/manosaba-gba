    {"op": "PlayBgm", "line": 17, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 21, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S01", "Wait": 0}},
    {"op": "Wait", "line": 22, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "我——所做的事情……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "我，到底……做了什么？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna002"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "不是的，我……没有错。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna003"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "嗯，错的是……她。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna004"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "一切的一切……都是那个人的错。<br>\n本小姐……【我】，没有错……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna005"]}},
    {"op": "ResetText", "line": 38, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 39, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 40, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 46, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S02", "Wait": 0}},
    {"op": "Wait", "line": 47, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "我……杀了蕾雅。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna006"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "在地下捡起冰块。<br>\n从后面……袭击了她。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna007"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "在电梯出口处，<br>\n蕾雅流着血倒下……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna008"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "然后……艾玛拿着人字梯走过来……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna009"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "不等她出声喊我，<br>\n我，就拿起了蕾雅的剑……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna010"]}},
    {"op": "ResetText", "line": 61, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 62, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S02", "Wait": 0, "LogWarning": 1}},
    {"op": "ModifyBackgroundExtended", "line": 63, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 64, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 65, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 68, "indent": 0, "params": {"TintColor": "#FF0000FF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 71, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 73, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyBackgroundExtended", "line": 75, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 76, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "SpawnExtended", "line": 83, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S03", "Wait": 0}},
    {"op": "Wait", "line": 84, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "等我回过神来，那里只剩……两具尸体。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna011"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "所以我，满脑子都是……把尸体藏起来……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna012"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "我把蕾雅……藏在电梯顶上。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna013"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "可是，集合时间快到了……<br>\n到时如果我不在的话会被怀疑……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna014"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "所以想把艾玛，藏在人字梯挡住的地方……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna015"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "但是之后大家来了的话，马上就会暴露……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna016"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "必须想办法……<br>\n让别人找不到艾玛的尸体……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna017"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "所以……我想让尸体消失……<br>\n就把碰巧带着的舞台服……<br>\n给艾玛穿上了……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna018"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "为了让换上了舞台服的艾玛不令人怀疑，<br>\n我给蕾雅戴上了她带来的王冠……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna019"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "再次回到地下，<br>\n我就第一个乘上电梯……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna020"]}},
    {"op": "ResetText", "line": 108, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 109, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S03", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 110, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 115, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S04", "Wait": 0}},
    {"op": "Wait", "line": 116, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "然后对尸体穿着的礼服、上面的刺绣……<br>\n对缝进刺绣的自己的头发，施了魔法……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna021"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "头发把她的尸体抬了起来……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna022"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "然后尸体向着电梯顶板上方飘浮……<br>\n被空无一物的黑暗吞没……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna023"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "如果能一直这样飘浮下去，<br>\n就不会被任何人发现了……我这么想着。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna024"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "所以我拼命地念着魔法。<br>\n祈求魔法能一直持续……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna025"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "……但是。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna026"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "凭我这半吊子的魔法，根本做不到。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna027"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "她的尸体失去浮力，坠落下来。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna028"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "然后……在地下，被发现了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna029"]}},
    {"op": "ResetText", "line": 138, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 139, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S04", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 140, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 146, "indent": 0, "params": {"Path": "Reenact_Ch02_E04_S05", "Wait": 0}},
    {"op": "Wait", "line": 147, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "一切……一切都完了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna030"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "……不是的。<br>\n我根本不想杀人的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna031"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "我不想骗人的。<br>\n我不想撒谎的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna032"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "我不想嫁祸别人的。<br>\n我不想做个坏孩子的……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna033"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "不是我的错……不是、我的、错……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna034"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "……呐，我呀。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna035"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "真的、把两条人命都……杀死了吗……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna036"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "……骗人，怎么会……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna037"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "我……<br>\n【本小姐】我……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna038"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "明明这么可爱……明明是最完美的……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna039"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "【大小姐】……却……竟然……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Trial11_Hanna040"]}},
    {"op": "ResetText", "line": 177, "indent": 0, "params": {}},
