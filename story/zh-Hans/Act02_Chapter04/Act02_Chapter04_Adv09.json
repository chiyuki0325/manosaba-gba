    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "放风时间就快结束了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 19, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "结果还是没找到典狱长……<br>\n抱歉啊，希罗，让你白跑一趟……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Leia001"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "蕾雅沮丧地垂下肩膀，<br>\n显得有些泄气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "没关系，以后有时间再找吧。<br>\n今天就算是出来散散心了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "有希罗在我身边真好。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Leia002"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "蕾雅抬起头，笑着对我说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative003"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "是你的坚强支撑着我。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "能走到现在，<br>\n一定是因为希罗一直在我身边。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "虽然中断了一段时间，<br>\n表演舞台剧这件事也要继续推进。<br>\n好，继续加油吧！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "总是说些肉麻的话啊，你这人……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Hiro002"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "而且，你还真的打算继续做舞台剧啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "当然！<br>\n这可是我的动力之源！<br>\n希罗也能帮忙的话就更好了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "在我能力范围内的事，我会帮忙的……<br>\n让大家都有事可做，也对精神健康有益。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Hiro004"]}},
    {"op": "HideAllCharacters", "line": 59, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "我无奈地叹了口气，<br>\n但心里却有些释然。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "至少，蕾雅身上没有魔女化的迹象。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative005"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "或许是因为有我在，<br>\n某种程度上帮助她<br>\n维持了精神上的平衡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 69, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（不过，仍然不能掉以轻心。<br>\n　任何人，随时都有可能因某个契机<br>\n　滋生出魔女的杀意……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "该回房间了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Leia007"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "嗯。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Hiro006"]}},
    {"op": "HideAllCharacters", "line": 80, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "尽管内心告诫自己不能放松警惕，<br>\n但我仍然因为与蕾雅并肩而行而感到安心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative007"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "有蕾雅在身边真好。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative008"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "虽然我自己没法主动说出这么害羞的话，<br>\n但我想，她和我一定是同样的心情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv09_Narrative009"]}},
    {"op": "Gosub", "line": 88, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
