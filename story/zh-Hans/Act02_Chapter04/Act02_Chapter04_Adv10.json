  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-4-10", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "那晚，<br>\n回到房间后，我照例开始写日记。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative001"]}},
    {"op": "ResetText", "line": 17, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 20, "indent": 0, "params": {"SfxPath": "Sfx_111", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "——监牢生活第二轮，第××天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "——仍然找不到和大魔女有关的线索，<br>\n时间浑浑噩噩地流逝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative003"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "——明明应该是由我来找到拯救她们的方法。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative004"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "——留给我的时间已经不多了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative005"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "（别焦躁。<br>\n　焦躁，只会把自己逼入绝境）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "为了让心情平复下来，<br>\n我放下钢笔，深吸一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative006"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "然后，我看向了躺在床上的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative007"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "呜……呜呜……呃……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema001"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "她的呼吸浅而急速，<br>\n似乎正被噩梦折磨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative008"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "听见艾玛发出痛苦的呻吟，<br>\n我便走到她身旁，轻轻摇醒了她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "艾玛，没事吧？要不要起来……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "话音未落，我不经意触摸到艾玛肩头，<br>\n顿时一惊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative010"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "（发高烧了……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro003"]}},
    {"op": "ResetText", "line": 55, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 56, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 57, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "HideAllCharacters", "line": 59, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 61, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "7_1"}},
    {"op": "ModifyBackgroundExtended", "line": 62, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "我立刻把艾玛送往医务室，<br>\n并通知了大家。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative011"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "少女们纷纷赶到了医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "艾玛，你没事吧！<br>\n有什么想吃的？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "嘘，吵闹是不好的！<br>\n她现在一定很难受。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 77, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "她烧得很厉害，<br>\n到底是什么原因呢……真让人担心。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia"}},
    {"op": "Wait", "line": 83, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "可能是太累了吧。<br>\n艾玛，现在不能勉强自己，要好好休息。<br>\n记得多喝水哦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia"}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria"}},
    {"op": "Wait", "line": 90, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "药在哪里……有没有药……！<br>\n可恶，要是冰上在的话，<br>\n就知道哪个是退烧药了……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Alisa001"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "大家……对不起……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema002"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "（……艾玛真是深受大家喜爱啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro004"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "站着稍远处望着围在艾玛床边的少女们，<br>\n我再次强烈感受到这一点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative013"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "于是，<br>\n我们全心全意地照顾艾玛——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative014"]}},
    {"op": "ResetText", "line": 106, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 107, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 108, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 109, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 110, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlaySfxModified", "line": 113, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "『各位，马上就到就寝时间了』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative015"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "『之后属于禁止外出时间，<br>\n　请迅速回到牢房内』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative016"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "不久后，我们的手机<br>\n收到了典狱长的通知。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa"}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "啧，该回去了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Alisa002"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "虽然很担心艾玛的状况，<br>\n但也只能回去了……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "如果身体状况不佳，<br>\n艾玛可以被允许留在医务室。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro005"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "有一人陪护也是允许的，<br>\n今晚就由我留下来陪护艾玛吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro006"]}},
    {"op": "HideAllCharacters", "line": 135, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "好，就拜托你了，希罗。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Leia002"]}},
    {"op": "HideAllCharacters", "line": 140, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "少女们陆续朝出口走去，<br>\n唯独汉娜仍留在艾玛床边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "……那个，艾玛。<br>\n这个是，我为你做的……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hanna002"]}},
    {"op": "SpawnExtended", "line": 151, "indent": 0, "params": {"Path": "Clue", "Params": ["9-11"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "希望能让你稍微打起精神来……<br>", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 155, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "哇，汉娜好厉害。<br>\n谢谢……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema003"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "艾玛虽然仍显得痛苦，<br>\n但她还是笑着接过汉娜递过来的人偶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative019"]}},
    {"op": "DestroySpawnedExtended", "line": 161, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "HideAllCharacters", "line": 162, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "汉娜依依不舍地，<br>\n离开了艾玛身旁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "……呼，总算安静下来了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro007"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我在艾玛身旁坐下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative021"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "希罗，给你添麻烦了，对不起……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema004"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "别想太多。<br>\n现在专心把身体养好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 176, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "嗯，好……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema005"]}},
    {"op": "ResetText", "line": 180, "indent": 0, "params": {}},
    {"op": "Wait", "line": 181, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "那两个人，虽然一开始关系那么紧张，<br>\n但现在好像变得亲近多了，让人松了一口气。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Miria002"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "是啊是啊。<br>\n本来以为她们之间好像有什么过节，<br>\n不过现在看来终究还是朋友嘛。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Sherry003"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "嗯，交给希罗肯定没问题的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Leia003"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "少女们的谈话声逐渐远去。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "（真是的，这么光明正大地议论我们……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro009"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "我这么想着，看向艾玛，<br>\n却见她手里握着人偶，轻声笑着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative023"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "可爱是可爱啦，但汉娜的品味有点独特呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema006"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "确实。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro010"]}},
    {"op": "HideAllCharacters", "line": 205, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "但我真的很开心。<br>\n能收到汉娜做的这个人偶，<br>\n真的、真的，特别开心。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema007"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "艾玛的眼角涌起泪珠，<br>\n顺着脸颊缓缓滑落。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative024"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "她自己似乎也对这眼泪感到意外。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative025"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "咦……这是为什么……？<br>\n我一点也不想哭的啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "你太累了。该睡了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro011"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "嗯……我好像，<br>\n总是被希罗帮助呢。<br>\n不管是以前，还是现在……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema009"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "看着艾玛露出苦笑，我的心一阵刺痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative026"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "（为什么要露出这样的表情？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro012"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "（明明我曾经对你说过那么过分的话，<br>\n　甚至把你逼入绝境）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro013"]}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "（艾玛，你的真面目是……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro014"]}},
    {"op": "HideAllCharacters", "line": 231, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "不久后，艾玛沉沉睡去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative027"]}},
    {"op": "StopBgm", "line": 235, "indent": 0, "params": {"FadeOutDuration": 5.0}},
    {"op": "ResetText", "line": 237, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 238, "indent": 0, "params": {"SlotNumber": 24, "Wait": 0}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "然而，杀意却趁机涌上我的心头——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative028"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "我感到自己的魔女化进程正在加速。<br>\n这是理性即将崩溃的征兆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative029"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "这杀意正在向我低语。<br>\n只要现在趁机掐死她，就能立刻摆脱万千心结。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative030"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "即使脑中还有一丝念头，知道不可为之，<br>\n但我却无法反抗杀意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative031"]}},
    {"op": "StopBgm", "line": 248, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "我的手伸向艾玛。<br>\n她安稳的呼吸拂过我的指尖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative032"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "耳边回响着自己剧烈的心跳声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative033"]}},
    {"op": "PlaySfxModified", "line": 255, "indent": 0, "params": {"SfxPath": "Sfx_35", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "AddChoice", "line": 257, "indent": 0, "params": {"ChoiceSummary": "杀死艾玛", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0204Adv10_Choice001"]}},
    {"op": "GotoModified", "line": 258, "indent": 1, "params": {"Path": "Act02_Chapter04/Act02_Chapter04_Bad04", "ResetState": ["-"]}},
    {"op": "AddChoice", "line": 260, "indent": 0, "params": {"ChoiceSummary": "不杀艾玛", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0204Adv10_Choice002"]}},
    {"op": "GotoModified", "line": 261, "indent": 1, "params": {"Path": ".Choice2-4-4"}},
    {"op": "StopForChoice", "line": 263, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice2-4-4", "line": 265, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 267, "indent": 0, "params": {"Number": 24}},
    {"op": "ResetText", "line": 269, "indent": 0, "params": {}},
    {"op": "Wait", "line": 270, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlayBgm", "line": 272, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "像是要封印自己的感情一般，<br>\n我一点点地折回指关节，收起手指。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative034"]}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "在无边无际的迷茫之中，<br>\n我找到了自己唯一的真心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative035"]}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "（……我无法杀死艾玛）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro015"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "这已经是无可动摇的事实了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative036"]}},
    {"op": "ResetText", "line": 282, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 283, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 284, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 285, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "34_1"}},
    {"op": "ModifyBackgroundExtended", "line": 286, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 287, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "艾玛她呢，<br>\n终有一天会成为带来灾祸的魔女哦。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Yuki001"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "她会杀死很多人。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Yuki002"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "会让大家变得不幸。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Yuki003"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "很可怕呢。<br>\n那一天终将到来。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Yuki004"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "……不记得是什么时候的事了。<br>\n小雪所说的话，有种神秘的说服力，<br>\n深深铭刻在我心里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative037"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "小雪因被霸凌而自尽的时候，<br>\n我痛恨艾玛，那时我的心被怨恨填满。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative038"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "艾玛选择做个旁观者，<br>\n不去保护被霸凌的小雪，甚至对这一切视而不见。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative039"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "这件事以来，她依旧若无其事地与我相处，<br>\n而我却自认为看透了艾玛的本性。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative040"]}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "她就是带来灾厄的魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative041"]}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "害死了我最重要的朋友，<br>\n是决不能原谅的存在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative042"]}},
    {"op": "ResetText", "line": 309, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 310, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 311, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 312, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [70.0, 50.0], "AppearanceAndTransition": "7_1"}},
    {"op": "ModifyBackgroundExtended", "line": 313, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 314, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "——我猛然睁开双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative043"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "回过神来，<br>\n我竟然在艾玛的床边睡着了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative044"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "抬头一看，艾玛仍在睡梦中，<br>\n正被梦魇折磨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative045"]}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "停手吧……小雪，<br>\n求求你，别再这样了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema010"]}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "为什么是我……？<br>\n我明明不想、让大家死去……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Ema011"]}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "听到这梦话的瞬间，<br>\n我不禁颤抖，下意识捂住了嘴。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative046"]}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "几乎要失声尖叫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative047"]}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "（或许，一直以来我都想错了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro016"]}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "（我们真正的敌人是……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Hiro017"]}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "我全身止不住战栗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv10_Narrative048"]}},
    {"op": "Gosub", "line": 338, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 340, "indent": 0, "params": {"Path": "Act02_Chapter04/Act02_Chapter04_Adv11", "SoftReset": 1}}
  ],
  "translations": {
  "0204Adv10_Narrative001": "那晚，<br>\n回到房间后，我照例开始写日记。",
  "0204Adv10_Narrative002": "——监牢生活第二轮，第××天。",
  "0204Adv10_Narrative003": "——仍然找不到和大魔女有关的线索，<br>\n时间浑浑噩噩地流逝。",
  "0204Adv10_Narrative004": "——明明应该是由我来找到拯救她们的方法。<br>",
  "0204Adv10_Narrative005": "——留给我的时间已经不多了。",
  "0204Adv10_Hiro001": "（别焦躁。<br>\n　焦躁，只会把自己逼入绝境）",
  "0204Adv10_Narrative006": "为了让心情平复下来，<br>\n我放下钢笔，深吸一口气。",
  "0204Adv10_Narrative007": "然后，我看向了躺在床上的艾玛。",
  "0204Adv10_Ema001": "呜……呜呜……呃……",
  "0204Adv10_Narrative008": "她的呼吸浅而急速，<br>\n似乎正被噩梦折磨。",
  "0204Adv10_Narrative009": "听见艾玛发出痛苦的呻吟，<br>\n我便走到她身旁，轻轻摇醒了她。",
  "0204Adv10_Hiro002": "艾玛，没事吧？要不要起来……",
  "0204Adv10_Narrative010": "话音未落，我不经意触摸到艾玛肩头，<br>\n顿时一惊。",
  "0204Adv10_Hiro003": "（发高烧了……！）",
  "0204Adv10_Narrative011": "我立刻把艾玛送往医务室，<br>\n并通知了大家。",
  "0204Adv10_Narrative012": "少女们纷纷赶到了医务室。",
  "0204Adv10_Sherry001": "艾玛，你没事吧！<br>\n有什么想吃的？",
  "0204Adv10_Hanna001": "嘘，吵闹是不好的！<br>\n她现在一定很难受。",
  "0204Adv10_Leia001": "她烧得很厉害，<br>\n到底是什么原因呢……真让人担心。",
  "0204Adv10_Miria001": "可能是太累了吧。<br>\n艾玛，现在不能勉强自己，要好好休息。<br>\n记得多喝水哦。",
  "0204Adv10_Alisa001": "药在哪里……有没有药……！<br>\n可恶，要是冰上在的话，<br>\n就知道哪个是退烧药了……",
  "0204Adv10_Ema002": "大家……对不起……",
  "0204Adv10_Hiro004": "（……艾玛真是深受大家喜爱啊）",
  "0204Adv10_Narrative013": "站着稍远处望着围在艾玛床边的少女们，<br>\n我再次强烈感受到这一点。",
  "0204Adv10_Narrative014": "于是，<br>\n我们全心全意地照顾艾玛——",
  "0204Adv10_Narrative015": "『各位，马上就到就寝时间了』",
  "0204Adv10_Narrative016": "『之后属于禁止外出时间，<br>\n　请迅速回到牢房内』",
  "0204Adv10_Narrative017": "不久后，我们的手机<br>\n收到了典狱长的通知。",
  "0204Adv10_Alisa002": "啧，该回去了。",
  "0204Adv10_Sherry002": "虽然很担心艾玛的状况，<br>\n但也只能回去了……",
  "0204Adv10_Hiro005": "如果身体状况不佳，<br>\n艾玛可以被允许留在医务室。",
  "0204Adv10_Hiro006": "有一人陪护也是允许的，<br>\n今晚就由我留下来陪护艾玛吧。",
  "0204Adv10_Leia002": "好，就拜托你了，希罗。",
  "0204Adv10_Narrative018": "少女们陆续朝出口走去，<br>\n唯独汉娜仍留在艾玛床边。",
  "0204Adv10_Hanna002": "……那个，艾玛。<br>\n这个是，我为你做的……",
  "0204Adv10_Hanna003": "希望能让你稍微打起精神来……<br>",
  "0204Adv10_Ema003": "哇，汉娜好厉害。<br>\n谢谢……！",
  "0204Adv10_Narrative019": "艾玛虽然仍显得痛苦，<br>\n但她还是笑着接过汉娜递过来的人偶。",
  "0204Adv10_Narrative020": "汉娜依依不舍地，<br>\n离开了艾玛身旁。",
  "0204Adv10_Hiro007": "……呼，总算安静下来了。",
  "0204Adv10_Narrative021": "我在艾玛身旁坐下。",
  "0204Adv10_Ema004": "希罗，给你添麻烦了，对不起……",
  "0204Adv10_Hiro008": "别想太多。<br>\n现在专心把身体养好。",
  "0204Adv10_Ema005": "嗯，好……",
  "0204Adv10_Miria002": "那两个人，虽然一开始关系那么紧张，<br>\n但现在好像变得亲近多了，让人松了一口气。",
  "0204Adv10_Sherry003": "是啊是啊。<br>\n本来以为她们之间好像有什么过节，<br>\n不过现在看来终究还是朋友嘛。",
  "0204Adv10_Leia003": "嗯，交给希罗肯定没问题的。",
  "0204Adv10_Narrative022": "少女们的谈话声逐渐远去。<br>",
  "0204Adv10_Hiro009": "（真是的，这么光明正大地议论我们……）",
  "0204Adv10_Narrative023": "我这么想着，看向艾玛，<br>\n却见她手里握着人偶，轻声笑着。",
  "0204Adv10_Ema006": "可爱是可爱啦，但汉娜的品味有点独特呢。",
  "0204Adv10_Hiro010": "确实。",
  "0204Adv10_Ema007": "但我真的很开心。<br>\n能收到汉娜做的这个人偶，<br>\n真的、真的，特别开心。",
  "0204Adv10_Narrative024": "艾玛的眼角涌起泪珠，<br>\n顺着脸颊缓缓滑落。",
  "0204Adv10_Narrative025": "她自己似乎也对这眼泪感到意外。",
  "0204Adv10_Ema008": "咦……这是为什么……？<br>\n我一点也不想哭的啊……",
  "0204Adv10_Hiro011": "你太累了。该睡了。",
  "0204Adv10_Ema009": "嗯……我好像，<br>\n总是被希罗帮助呢。<br>\n不管是以前，还是现在……",
  "0204Adv10_Narrative026": "看着艾玛露出苦笑，我的心一阵刺痛。",
  "0204Adv10_Hiro012": "（为什么要露出这样的表情？）",
  "0204Adv10_Hiro013": "（明明我曾经对你说过那么过分的话，<br>\n　甚至把你逼入绝境）",
  "0204Adv10_Hiro014": "（艾玛，你的真面目是……）",
  "0204Adv10_Narrative027": "不久后，艾玛沉沉睡去。",
  "0204Adv10_Narrative028": "然而，杀意却趁机涌上我的心头——",
  "0204Adv10_Narrative029": "我感到自己的魔女化进程正在加速。<br>\n这是理性即将崩溃的征兆。",
  "0204Adv10_Narrative030": "这杀意正在向我低语。<br>\n只要现在趁机掐死她，就能立刻摆脱万千心结。",
  "0204Adv10_Narrative031": "即使脑中还有一丝念头，知道不可为之，<br>\n但我却无法反抗杀意。",
  "0204Adv10_Narrative032": "我的手伸向艾玛。<br>\n她安稳的呼吸拂过我的指尖。",
  "0204Adv10_Narrative033": "耳边回响着自己剧烈的心跳声。",
  "0204Adv10_Choice001": "杀死艾玛",
  "0204Adv10_Choice002": "不杀艾玛",
  "0204Adv10_Narrative034": "像是要封印自己的感情一般，<br>\n我一点点地折回指关节，收起手指。",
  "0204Adv10_Narrative035": "在无边无际的迷茫之中，<br>\n我找到了自己唯一的真心。",
  "0204Adv10_Hiro015": "（……我无法杀死艾玛）",
  "0204Adv10_Narrative036": "这已经是无可动摇的事实了。",
  "0204Adv10_Yuki001": "艾玛她呢，<br>\n终有一天会成为带来灾祸的魔女哦。",
  "0204Adv10_Yuki002": "她会杀死很多人。",
  "0204Adv10_Yuki003": "会让大家变得不幸。",
  "0204Adv10_Yuki004": "很可怕呢。<br>\n那一天终将到来。",
  "0204Adv10_Narrative037": "……不记得是什么时候的事了。<br>\n小雪所说的话，有种神秘的说服力，<br>\n深深铭刻在我心里。",
  "0204Adv10_Narrative038": "小雪因被霸凌而自尽的时候，<br>\n我痛恨艾玛，那时我的心被怨恨填满。",
  "0204Adv10_Narrative039": "艾玛选择做个旁观者，<br>\n不去保护被霸凌的小雪，甚至对这一切视而不见。",
  "0204Adv10_Narrative040": "这件事以来，她依旧若无其事地与我相处，<br>\n而我却自认为看透了艾玛的本性。",
  "0204Adv10_Narrative041": "她就是带来灾厄的魔女。",
  "0204Adv10_Narrative042": "害死了我最重要的朋友，<br>\n是决不能原谅的存在。",
  "0204Adv10_Narrative043": "——我猛然睁开双眼。",
  "0204Adv10_Narrative044": "回过神来，<br>\n我竟然在艾玛的床边睡着了。",
  "0204Adv10_Narrative045": "抬头一看，艾玛仍在睡梦中，<br>\n正被梦魇折磨。",
  "0204Adv10_Ema010": "停手吧……小雪，<br>\n求求你，别再这样了……",
  "0204Adv10_Ema011": "为什么是我……？<br>\n我明明不想、让大家死去……",
  "0204Adv10_Narrative046": "听到这梦话的瞬间，<br>\n我不禁颤抖，下意识捂住了嘴。",
  "0204Adv10_Narrative047": "几乎要失声尖叫。",
  "0204Adv10_Hiro016": "（或许，一直以来我都想错了）",
  "0204Adv10_Hiro017": "（我们真正的敌人是……）",
  "0204Adv10_Narrative048": "我全身止不住战栗。"
}
}
