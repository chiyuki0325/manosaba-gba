  "path": "Act02_Chapter04/Act02_Chapter04_Adv04",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-4-4", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "29_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "自从诺亚不在了以后，<br>\n我几乎没有再踏足这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "或许是我在刻意回避。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（诺亚的画室……吗。<br>\n　给这里命名的诺亚本人，已经不在了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "我只是不经意走进来，<br>\n并不是因为典狱长有可能在这里……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我本以为<br>\n寂静的画室里空无一人，<br>\n没想到汉娜在画室里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative004"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "汉娜坐在椅子上，<br>\n专心致志地埋头缝纫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "Wait", "line": 35, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "Wait", "line": 37, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "哎呀……你们，<br>\n来这里有什么事吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna001"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "察觉我们到来，<br>\n汉娜表情略显紧张地问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "汉娜是为什么还在这里缝纫呢？<br>\n舞台服应该全都已经制作完毕了才对……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "汉娜嘟起嘴，别过头去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative007"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "我本来就喜欢缝纫。<br>\n现在做的不是舞台服，而是人偶。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna002"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "多亏雪莉收集了这么多布料，<br>\n现在还剩了一大堆呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna003"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "最近艾玛没什么精神，<br>\n我有点担心她。<br>\n所以想着，能不能用这个让她开心一点……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna004"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "看向她手中的作品，<br>\n那似乎是以我们为原型制作的人偶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative008"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "她正在制作的是艾玛的人偶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "（她好努力啊……<br>\n　这也说明艾玛已经和汉娜<br>\n　亲密到这种程度了吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "哎呀！汉娜真是心灵手巧。<br>\n每天还会为大家洗衣服，<br>\n我做家务可一点不拿手，真的很羡慕你。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "羡慕……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna005"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "蕾雅站在画室里摆放的演出用礼服前，<br>\n眯起眼睛，露出陶醉的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative010"]}},
    {"op": "SpawnExtended", "line": 83, "indent": 0, "params": {"Path": "Clue", "Params": ["9-13"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "汉娜亲手制作的演出礼服……<br>\n真是精美绝伦。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia003"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "这金色的刺绣，<br>\n实在是太美了……让人舍不得移开目光。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia004"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "虽然最美丽的还是要数主角的服装！<br>\n但这顶王冠也精致得不分伯仲。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia005"]}},
    {"op": "DestroySpawnedExtended", "line": 91, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "SpawnExtended", "line": 96, "indent": 0, "params": {"Path": "Clue", "Params": ["9-5"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "那可不是我做的哦。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "呃，这、这样啊……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "那是米莉亚<br>\n按照安安的要求制作的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "安安说，<br>\n无论如何都想要一顶王冠……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna008"]}},
    {"op": "DestroySpawnedExtended", "line": 114, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "汉娜露出一抹寂寞的神色，低下头。<br>\n剧本是我和安安一起编写的，所以马上就明白了她的意思。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "（说起来，剧本在大纲的基础上改动了不少，<br>\n　比起小飞侠本人，王子倒更像是主角了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro003"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "（虽然蕾雅很高兴就是了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro004"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "（所以才有了这顶王冠吗……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro005"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "我听诺亚说，<br>\n安安其实<br>\n很想扮演温蒂。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna009"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "啊，确实，她的确流露出那样的想法……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "原来如此……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia007"]}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "一说到诺亚和安安的话题，<br>\n气氛顿时沉重起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "汉娜，希罗，不要气馁啊。<br>\n我还没有放弃舞台！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia008"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "蕾雅仿佛要驱散这股沉闷的气息，<br>\n朗声宣布道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative013"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "我还想穿上<br>\n汉娜精心制作的主角服装呢。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia009"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "主角用的舞台服，就连上面的刺绣也是美不胜收……<br>\n啊，汉娜真是太了不起了。<br>\n我发自内心敬佩着你。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia010"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Flushed1"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna010"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "被蕾雅直率的双瞳这样看着，一对上视线，<br>\n汉娜的脸颊瞬间染上红晕，立刻背过身去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative014"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "我、我、我很、很忙的，<br>\n你们快点离开吧……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna011"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "如果真的要演舞台剧，<br>\n服装还需要再做些调整呢……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hanna012"]}},
    {"op": "HideActors", "line": 162, "indent": 0, "params": {"ActorIds": ["Hanna"], "Lazy": 0}},
    {"op": "Wait", "line": 163, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "我和蕾雅对视一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "（这大概是害羞了吧……<br>\n　蕾雅说话，用词总是这么夸张）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "不能再打扰汉娜了。<br>\n我们该走了，希罗。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia011"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "出发，去抓住典狱长！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Leia012"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "（为什么她一脸心满意足啊……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Hiro009"]}},
    {"op": "HideAllCharacters", "line": 183, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "我们离开了画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv04_Narrative016"]}},
    {"op": "Gosub", "line": 192, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 194, "indent": 0, "params": {"Path": "Act02_Chapter04/Act02_Chapter04_Adv03", "SoftReset": 1}}
