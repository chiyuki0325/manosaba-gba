{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter04/Act02_Chapter04_Adv15",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-4-15", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlaySfxModified", "line": 15, "indent": 0, "params": {"SfxPath": "Sfx_111", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 17, "indent": 0, "params": {"BgmPath": "Bgm_24_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "——监牢生活第二轮，第××天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative001"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "——远野汉娜杀害了樱羽艾玛与莲见蕾雅，<br>\n作为魔女被处刑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative002"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "——我之所以还没有完全崩溃，<br>\n还能保持理智不失，是因为……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative003"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "——内心某处觉得，<br>\n我必须见证真相。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative004"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "——只要见到真相，<br>\n再重新来过就好。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative005"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "——只要用我的魔法，<br>\n就能回到今天早上，将一切重来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative006"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "钢笔书写的声音<br>\n戛然而止。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative007"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "我写不下去了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Pensive1,ArmL5"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "（汉娜从第一次见到蕾雅开始，<br>\n　就已经产生了恨意）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "（即使回到今天早上，<br>\n　也无法斩断长久累积的憎恶）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1,ArmL5"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "（也许今天能救下艾玛和蕾雅。<br>\n　但无论怎么努力，蕾雅总有一天会被杀）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1,ArmL5"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "（那么我是不是该……先把汉娜杀了？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro004"]}},
    {"op": "HideAllCharacters", "line": 49, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "明明亲眼见证汉娜被处刑——也就是正义得以执行。<br>\n这应该让我感到释怀才对。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative009"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "但我的心情却没有因此明朗起来。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative010"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "甚至觉得，这是错误的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Cry1,ArmL5"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "（我……我——！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro005"]}},
    {"op": "PlaySfxModified", "line": 62, "indent": 0, "params": {"SfxPath": "Sfx_151", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "我用力过猛，<br>\n竟折断了钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative012"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "……可恶！这种东西……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro006"]}},
    {"op": "PlaySfxModified", "line": 72, "indent": 0, "params": {"SfxPath": "Sfx_152", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 74, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1,ArmR13,ArmL13"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "我一直以为珍贵的事物……<br>\n原来全都是错的！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro007"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "我支撑不住身体，跪倒在地，<br>\n用拳头猛击地板。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative013"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "我是、我是、我是——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 86, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "——错误的。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki001"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "不是我自己说出的话。<br>\n那声音不知从何处，伴随着阵阵轻声讥笑传来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative014"]}},
    {"op": "ResetText", "line": 96, "indent": 0, "params": {}},
    {"op": "HidePrinter", "line": 97, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 98, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 99, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyTextPrinter", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "——你是错误的。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki002"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "——这点小事，其实你早就明白了吧？", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki003"]}},
    {"op": "ResetText", "line": 108, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1,ArmR13,ArmL13"}},
    {"op": "ModifyBackgroundExtended", "line": 111, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 112, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyTextPrinter", "line": 117, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "雪……？是你在、吗……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro009"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "听见熟悉而虚幻的声音，<br>\n我茫然站起身。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1,ArmR13,ArmL13"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "在哪！？到底在哪里！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro010"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "我环顾室内，<br>\n却看不到她的身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative016"]}},
    {"op": "ResetText", "line": 133, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 134, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 135, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 136, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyTextPrinter", "line": 139, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "对了，还有。很遗憾，你已经无法重来了哦。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki004"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "因为你的禁忌就是自杀吧。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki005"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "一旦你试图自杀，这次一定会触犯禁忌，<br>\n变成魔女。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki006"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "丧失理性并化为残骸的你，<br>\n就算回到过去，也只会杀光所有人。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki007"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "而成为残骸，<br>\n就意味着失去魔法，再也无法使出死亡回溯。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki008"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "真遗憾呢。真可怜呢。<br>\n你真是，太可怜了。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki009"]}},
    {"op": "ResetText", "line": 158, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1,ArmR9,ArmL10"}},
    {"op": "ModifyBackgroundExtended", "line": 161, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 162, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 164, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "住口——！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro011"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "脑海里回响的耳语声，<br>\n似乎是从钢笔里发出来的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative017"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "住口，住口，给我住口！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro012"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "于是我一次次踩碎钢笔，<br>\n直到它粉身碎骨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative018"]}},
    {"op": "ResetText", "line": 174, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 175, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 176, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 177, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 178, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "别这么过分嘛。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki010"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "即使我将钢笔彻底摧毁，<br>\n雪的耳语声依旧没有停止。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative019"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "这只钢笔里面倾注了你对我的感情，<br>\n用来附身最合适不过了。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki011"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "但就算无处附身……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki012"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "【希 罗】", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki013"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "【我会、一直、在你身边】", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki014"]}},
    {"op": "ResetText", "line": 200, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Fearful1,ArmR9,ArmL10"}},
    {"op": "ModifyBackgroundExtended", "line": 203, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 204, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "噫、啊、啊——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro013"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "捂住双耳、紧闭双眼、蜷缩起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative020"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "即便如此，她的耳语依然不断侵蚀我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative021"]}},
    {"op": "ResetText", "line": 212, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 213, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 214, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 215, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 216, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 217, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "【只要还在这座监牢，我就能维持存在】", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki015"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "【一定是因为家人对我的思念之情<br>\n　还残留于此吧】", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki016"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "【……喂，希罗。<br>\n　艾玛被杀了】", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki017"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "【我真的很失望。<br>\n　又得从头去找替代品了】", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki018"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "【你会帮我的吧？<br>\n　毕竟我们是朋友呀】", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Yuki019"]}},
    {"op": "ResetText", "line": 229, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1,ArmR13,ArmL13"}},
    {"op": "ModifyBackgroundExtended", "line": 232, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 233, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "朋友……？别开玩笑了！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro014"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "月代雪——你就是一切的元凶！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro015"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "我竟然一直以来……<br>\n都把你当作重要的朋友！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro016"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "原来我一直都是错的！！<br>\n一错再错，错到现在！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro017"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "艾玛、小雪，还有我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative022"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "我们三人共度的初中时代，<br>\n我曾视若珍宝的回忆，<br>\n全部轰然崩塌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative023"]}},
    {"op": "StopBgm", "line": 247, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 253, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 254, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 255, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 256, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 258, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 259, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "140_3"}},
    {"op": "ModifyBackgroundExtended", "line": 261, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 262, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 264, "indent": 0, "params": {"BgmPath": "Bgm_32_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "刚上初中没多久，<br>\n就有个女孩遭受了残酷霸凌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative024"]}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "她的名字叫月代雪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative025"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "我放不下她，<br>\n渐渐开始保护她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative026"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "但小雪却厌恶着试图保护她的我，<br>\n甚至冷淡避开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative027"]}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "即便如此，我仍然坚持成为她的盾。<br>\n因为我认为，这才是正确的行动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative028"]}},
    {"op": "ModifyBackgroundExtended", "line": 276, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "400_1"}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "直到某天，我看到小雪和艾玛走在一起。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative029"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "自从升上初中后，我和艾玛不再同班，<br>\n两人关系便稍显疏远。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative030"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "见到小雪与艾玛亲密地笑着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative031"]}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "——原来她交到朋友了。太好了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative032"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "同时，内心却涌上一股前所未有的相反感情。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative033"]}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "——为什么我就不行？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative034"]}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "——为什么偏偏是艾玛？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative035"]}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "她们两人的身影深深烙印在我心里，<br>\n怎么也挥之不去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative036"]}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "我开始觉得艾玛根本不是个好孩子。<br>\n这份感情不断膨胀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative037"]}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "在我不断留意她们的同时，<br>\n终于有一天，艾玛也察觉到了我的目光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative038"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "——希罗也一起玩嘛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative039"]}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "我若无其事地<br>\n握住了艾玛伸向我的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative040"]}},
    {"op": "ModifyBackgroundExtended", "line": 302, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "400_2"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "由于小雪讨厌他人的目光，<br>\n我们三人越来越经常<br>\n在避人耳目的秘密基地聚会。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative041"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "三个人在一起，<br>\n互相嬉闹，<br>\n一起打游戏，", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative042"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "聊天，<br>\n吃零食，<br>\n偶尔吵架，", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative043"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "都是无可替代的珍贵回忆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative044"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "……但是……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative045"]}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "后来，因为我要去短期留学，<br>\n三人之间的关系开始发生变化。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative046"]}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "我将小雪托付给艾玛。<br>\n因为小雪在学校被霸凌的情况还是没有改善。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative047"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "——就拜托你照顾小雪了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative048"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "——嗯，交给我吧！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative049"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "即使平日里笑着装作若无其事的样子，<br>\n其实我心里一直嫉妒着艾玛。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative050"]}},
    {"op": "StopBgm", "line": 324, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "心中这小小的黑暗——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative051"]}},
    {"op": "ModifyBackgroundExtended", "line": 328, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "400_3"}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "在我回国得知小雪自杀后，<br>\n爆发式地膨胀起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative052"]}},
    {"op": "ResetText", "line": 332, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 333, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 334, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 335, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 337, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "150_1"}},
    {"op": "ModifyBackgroundExtended", "line": 339, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 340, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 342, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 344, "indent": 0, "params": {"Text": "——我非常重要的朋友自杀了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative053"]}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "（但那只不过是<br>\n　她用来折磨艾玛的手段）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro018"]}},
    {"op": "PrintTextModified", "line": 348, "indent": 0, "params": {"Text": "她叫月代雪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative054"]}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "（她其实是大魔女）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro019"]}},
    {"op": "UpdateWitchBook", "line": 352, "indent": 0, "params": {"Id": "4", "Category": "Note", "Version": 2}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "当我推开房门时，<br>\n那根上吊绳还静静地悬挂在原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative055"]}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "我抬头怒视那根为她准备好的绞索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative056"]}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "（如今我明白了。<br>\n　她是为了在艾玛心里留下心理创伤）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro020"]}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "我将背脊挺得笔直，<br>\n视线穿过那为了扼住她的咽喉而存在的圆环——<br>\n过于刺眼的憎恶，让我咬紧了牙关。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative057"]}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "我无法原谅。<br>\n无法原谅小雪的生命，就这么被区区一根绳子夺走。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative058"]}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "（她是为了对艾玛的心灵造成伤痛，<br>\n　故意遭到霸凌，<br>\n　故意自杀的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro021"]}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "对我而言，这是不可饶恕的行为。<br>\n对我而言，这是不正确的行为。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative059"]}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "（我被她骗得团团转，<br>\n　更进一步将艾玛逼入绝境）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro022"]}},
    {"op": "PrintTextModified", "line": 370, "indent": 0, "params": {"Text": "我最崇尚的就是【正确】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative060"]}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "（我正如月代雪所愿，<br>\n　被她玩弄于股掌之间，还甘之如饴）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro023"]}},
    {"op": "PrintTextModified", "line": 374, "indent": 0, "params": {"Text": "这个世界上，<br>\n不该允许有哪怕一丝一毫的错误存在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative061"]}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "（我的一切都是错误的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro024"]}},
    {"op": "PrintTextModified", "line": 378, "indent": 0, "params": {"Text": "清澈的湖水中若是掺入一滴毒素，<br>\n生灵便会死绝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative062"]}},
    {"op": "PrintTextModified", "line": 380, "indent": 0, "params": {"Text": "（那滴毒药，是我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro025"]}},
    {"op": "PrintTextModified", "line": 382, "indent": 0, "params": {"Text": "精致的画布上若是划出一道划痕，<br>\n艺术的价值便随之泯灭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative063"]}},
    {"op": "PrintTextModified", "line": 384, "indent": 0, "params": {"Text": "（那道伤痕，是我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro026"]}},
    {"op": "PrintTextModified", "line": 386, "indent": 0, "params": {"Text": "完美的和声中若是混进一个错误的音符，<br>\n就会沦为刺耳的不协和音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative064"]}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "（那个错音，是我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro027"]}},
    {"op": "PrintTextModified", "line": 390, "indent": 0, "params": {"Text": "祈盼着正确的大脑中<br>\n若是寄生了一只害虫——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative065"]}},
    {"op": "PrintTextModified", "line": 392, "indent": 0, "params": {"Text": "（那只害虫，是我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro028"]}},
    {"op": "PrintTextModified", "line": 394, "indent": 0, "params": {"Text": "整个世界，便会崩塌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative066"]}},
    {"op": "PrintTextModified", "line": 396, "indent": 0, "params": {"Text": "——在绞索圆环的彼端，<br>\n我看见了造就这个错误世界的罪魁祸首。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative067"]}},
    {"op": "PrintTextModified", "line": 398, "indent": 0, "params": {"Text": "（那就是我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro029"]}},
    {"op": "PrintTextModified", "line": 400, "indent": 0, "params": {"Text": "（是我、是我、是我、<br>\n　是我、是我、是我——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro030"]}},
    {"op": "StopBgm", "line": 406, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 408, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 409, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 410, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 411, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 413, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 415, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 416, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PlayBgm", "line": 418, "indent": 0, "params": {"BgmPath": "Bgm_24_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 422, "indent": 0, "params": {"Text": "啊啊、啊啊啊啊啊、啊啊啊啊呜啊啊啊——！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro031"]}},
    {"op": "PrintTextModified", "line": 424, "indent": 0, "params": {"Text": "我失去了一切。<br>\n我手中根本没有什么正义。<br>\n我是如此无力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative068"]}},
    {"op": "PrintTextModified", "line": 426, "indent": 0, "params": {"Text": "我没能拯救任何人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative069"]}},
    {"op": "PrintTextModified", "line": 428, "indent": 0, "params": {"Text": "我只能不住呜咽，<br>\n不断痛哭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative070"]}},
    {"op": "PrintTextModified", "line": 432, "indent": 0, "params": {"Text": "呜、呜呜呜、啊啊……<br>\n啊啊、啊啊！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro032"]}},
    {"op": "ResetText", "line": 438, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 439, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 440, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 441, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 443, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro033"]}},
    {"op": "PrintTextModified", "line": 445, "indent": 0, "params": {"Text": "——不知道自己哭了多久。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative071"]}},
    {"op": "PrintTextModified", "line": 447, "indent": 0, "params": {"Text": "不知何时起，雪的气息已消失无踪。<br>\n她大概对我这个人从头到尾都无所谓吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative072"]}},
    {"op": "PrintTextModified", "line": 449, "indent": 0, "params": {"Text": "眼泪早已干涸，<br>\n唯有泪痕冰冷地贴在脸颊上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative073"]}},
    {"op": "PrintTextModified", "line": 451, "indent": 0, "params": {"Text": "嗓子只能发出沙哑的气音，<br>\n眼睛也失去光芒变得浑浊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative074"]}},
    {"op": "PrintTextModified", "line": 453, "indent": 0, "params": {"Text": "空虚在胸腔深处扎根、蔓延，<br>\n只余下残破的感情和一片静寂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative075"]}},
    {"op": "PrintTextModified", "line": 455, "indent": 0, "params": {"Text": "铁栅栏外模模糊糊看见一双脚。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative076"]}},
    {"op": "PrintTextModified", "line": 457, "indent": 0, "params": {"Text": "（啊啊，对了，还有几个少女<br>\n　存活下来……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro034"]}},
    {"op": "PrintTextModified", "line": 459, "indent": 0, "params": {"Text": "（不过，她们恐怕也……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro035"]}},
    {"op": "ModifyCharacterExtended", "line": 461, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmL2"}},
    {"op": "ModifyCharacterExtended", "line": 462, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1,ArmR10"}},
    {"op": "ModifyBackgroundExtended", "line": 464, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 3.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 465, "indent": 0, "params": {"WaitMode": "3.2"}},
    {"op": "PrintTextModified", "line": 467, "indent": 0, "params": {"Text": "我迟钝地抬起头。<br>\n透过铁栅望着我的，是亚里沙和米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative077"]}},
    {"op": "PrintTextModified", "line": 469, "indent": 0, "params": {"Text": "大概是听见我撕心裂肺的哭声，<br>\n她们才没有出声打扰。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative078"]}},
    {"op": "PrintTextModified", "line": 471, "indent": 0, "params": {"Text": "隔着铁栅栏，她们略显不安，<br>\n担忧地望着我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative079"]}},
    {"op": "PrintTextModified", "line": 473, "indent": 0, "params": {"Text": "……二阶堂，我有个东西想给你看看。<br>", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Alisa001"]}},
    {"op": "PrintTextModified", "line": 475, "indent": 0, "params": {"Text": "给我看？事到如今，还能有什么……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Hiro036"]}},
    {"op": "ModifyCharacterExtended", "line": 477, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1,ArmR10"}},
    {"op": "PrintTextModified", "line": 479, "indent": 0, "params": {"Text": "如果你还很难受，也不必勉强自己。<br>\n但……大叔我们<br>\n也只是想尽一点心意，希望能帮帮你……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Miria001"]}},
    {"op": "PrintTextModified", "line": 481, "indent": 0, "params": {"Text": "这东西到底能不能帮上你的忙，其实大叔我也不确定。<br>\n但……别再哭了，好吗？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Miria002"]}},
    {"op": "HideAllCharacters", "line": 483, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 485, "indent": 0, "params": {"Text": "我摇摇晃晃地站起身，走出牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative080"]}},
    {"op": "PrintTextModified", "line": 487, "indent": 0, "params": {"Text": "大脑已无法思考更多，只是机械地跟着她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv15_Narrative081"]}},
    {"op": "Gosub", "line": 489, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 491, "indent": 0, "params": {"Path": "Act02_Chapter04/Act02_Chapter04_Adv16", "SoftReset": 1}}
  ],
  "translations": {
  "0204Adv15_Narrative001": "——监牢生活第二轮，第××天。",
  "0204Adv15_Narrative002": "——远野汉娜杀害了樱羽艾玛与莲见蕾雅，<br>\n作为魔女被处刑了。",
  "0204Adv15_Narrative003": "——我之所以还没有完全崩溃，<br>\n还能保持理智不失，是因为……",
  "0204Adv15_Narrative004": "——内心某处觉得，<br>\n我必须见证真相。",
  "0204Adv15_Narrative005": "——只要见到真相，<br>\n再重新来过就好。",
  "0204Adv15_Narrative006": "——只要用我的魔法，<br>\n就能回到今天早上，将一切重来。",
  "0204Adv15_Narrative007": "钢笔书写的声音<br>\n戛然而止。",
  "0204Adv15_Narrative008": "我写不下去了。",
  "0204Adv15_Hiro001": "（汉娜从第一次见到蕾雅开始，<br>\n　就已经产生了恨意）",
  "0204Adv15_Hiro002": "（即使回到今天早上，<br>\n　也无法斩断长久累积的憎恶）",
  "0204Adv15_Hiro003": "（也许今天能救下艾玛和蕾雅。<br>\n　但无论怎么努力，蕾雅总有一天会被杀）",
  "0204Adv15_Hiro004": "（那么我是不是该……先把汉娜杀了？）",
  "0204Adv15_Narrative009": "明明亲眼见证汉娜被处刑——也就是正义得以执行。<br>\n这应该让我感到释怀才对。",
  "0204Adv15_Narrative010": "但我的心情却没有因此明朗起来。<br>",
  "0204Adv15_Narrative011": "甚至觉得，这是错误的。",
  "0204Adv15_Hiro005": "（我……我——！）",
  "0204Adv15_Narrative012": "我用力过猛，<br>\n竟折断了钢笔。",
  "0204Adv15_Hiro006": "……可恶！这种东西……！",
  "0204Adv15_Hiro007": "我一直以为珍贵的事物……<br>\n原来全都是错的！",
  "0204Adv15_Narrative013": "我支撑不住身体，跪倒在地，<br>\n用拳头猛击地板。",
  "0204Adv15_Hiro008": "我是、我是、我是——！",
  "0204Adv15_Yuki001": "——错误的。",
  "0204Adv15_Narrative014": "不是我自己说出的话。<br>\n那声音不知从何处，伴随着阵阵轻声讥笑传来。",
  "0204Adv15_Yuki002": "——你是错误的。",
  "0204Adv15_Yuki003": "——这点小事，其实你早就明白了吧？",
  "0204Adv15_Hiro009": "雪……？是你在、吗……？",
  "0204Adv15_Narrative015": "听见熟悉而虚幻的声音，<br>\n我茫然站起身。",
  "0204Adv15_Hiro010": "在哪！？到底在哪里！？",
  "0204Adv15_Narrative016": "我环顾室内，<br>\n却看不到她的身影。",
  "0204Adv15_Yuki004": "对了，还有。很遗憾，你已经无法重来了哦。",
  "0204Adv15_Yuki005": "因为你的禁忌就是自杀吧。",
  "0204Adv15_Yuki006": "一旦你试图自杀，这次一定会触犯禁忌，<br>\n变成魔女。",
  "0204Adv15_Yuki007": "丧失理性并化为残骸的你，<br>\n就算回到过去，也只会杀光所有人。",
  "0204Adv15_Yuki008": "而成为残骸，<br>\n就意味着失去魔法，再也无法使出死亡回溯。",
  "0204Adv15_Yuki009": "真遗憾呢。真可怜呢。<br>\n你真是，太可怜了。",
  "0204Adv15_Hiro011": "住口——！！",
  "0204Adv15_Narrative017": "脑海里回响的耳语声，<br>\n似乎是从钢笔里发出来的。",
  "0204Adv15_Hiro012": "住口，住口，给我住口！！",
  "0204Adv15_Narrative018": "于是我一次次踩碎钢笔，<br>\n直到它粉身碎骨。",
  "0204Adv15_Yuki010": "别这么过分嘛。",
  "0204Adv15_Narrative019": "即使我将钢笔彻底摧毁，<br>\n雪的耳语声依旧没有停止。",
  "0204Adv15_Yuki011": "这只钢笔里面倾注了你对我的感情，<br>\n用来附身最合适不过了。",
  "0204Adv15_Yuki012": "但就算无处附身……",
  "0204Adv15_Yuki013": "【希 罗】",
  "0204Adv15_Yuki014": "【我会、一直、在你身边】",
  "0204Adv15_Hiro013": "噫、啊、啊——！",
  "0204Adv15_Narrative020": "捂住双耳、紧闭双眼、蜷缩起来。",
  "0204Adv15_Narrative021": "即便如此，她的耳语依然不断侵蚀我。",
  "0204Adv15_Yuki015": "【只要还在这座监牢，我就能维持存在】",
  "0204Adv15_Yuki016": "【一定是因为家人对我的思念之情<br>\n　还残留于此吧】",
  "0204Adv15_Yuki017": "【……喂，希罗。<br>\n　艾玛被杀了】",
  "0204Adv15_Yuki018": "【我真的很失望。<br>\n　又得从头去找替代品了】",
  "0204Adv15_Yuki019": "【你会帮我的吧？<br>\n　毕竟我们是朋友呀】",
  "0204Adv15_Hiro014": "朋友……？别开玩笑了！",
  "0204Adv15_Hiro015": "月代雪——你就是一切的元凶！",
  "0204Adv15_Hiro016": "我竟然一直以来……<br>\n都把你当作重要的朋友！",
  "0204Adv15_Hiro017": "原来我一直都是错的！！<br>\n一错再错，错到现在！！",
  "0204Adv15_Narrative022": "艾玛、小雪，还有我。",
  "0204Adv15_Narrative023": "我们三人共度的初中时代，<br>\n我曾视若珍宝的回忆，<br>\n全部轰然崩塌。",
  "0204Adv15_Narrative024": "刚上初中没多久，<br>\n就有个女孩遭受了残酷霸凌。",
  "0204Adv15_Narrative025": "她的名字叫月代雪。",
  "0204Adv15_Narrative026": "我放不下她，<br>\n渐渐开始保护她。",
  "0204Adv15_Narrative027": "但小雪却厌恶着试图保护她的我，<br>\n甚至冷淡避开。",
  "0204Adv15_Narrative028": "即便如此，我仍然坚持成为她的盾。<br>\n因为我认为，这才是正确的行动。",
  "0204Adv15_Narrative029": "直到某天，我看到小雪和艾玛走在一起。<br>",
  "0204Adv15_Narrative030": "自从升上初中后，我和艾玛不再同班，<br>\n两人关系便稍显疏远。",
  "0204Adv15_Narrative031": "见到小雪与艾玛亲密地笑着。",
  "0204Adv15_Narrative032": "——原来她交到朋友了。太好了。",
  "0204Adv15_Narrative033": "同时，内心却涌上一股前所未有的相反感情。<br>",
  "0204Adv15_Narrative034": "——为什么我就不行？",
  "0204Adv15_Narrative035": "——为什么偏偏是艾玛？",
  "0204Adv15_Narrative036": "她们两人的身影深深烙印在我心里，<br>\n怎么也挥之不去。",
  "0204Adv15_Narrative037": "我开始觉得艾玛根本不是个好孩子。<br>\n这份感情不断膨胀。",
  "0204Adv15_Narrative038": "在我不断留意她们的同时，<br>\n终于有一天，艾玛也察觉到了我的目光。",
  "0204Adv15_Narrative039": "——希罗也一起玩嘛。",
  "0204Adv15_Narrative040": "我若无其事地<br>\n握住了艾玛伸向我的手。",
  "0204Adv15_Narrative041": "由于小雪讨厌他人的目光，<br>\n我们三人越来越经常<br>\n在避人耳目的秘密基地聚会。",
  "0204Adv15_Narrative042": "三个人在一起，<br>\n互相嬉闹，<br>\n一起打游戏，",
  "0204Adv15_Narrative043": "聊天，<br>\n吃零食，<br>\n偶尔吵架，",
  "0204Adv15_Narrative044": "都是无可替代的珍贵回忆。",
  "0204Adv15_Narrative045": "……但是……",
  "0204Adv15_Narrative046": "后来，因为我要去短期留学，<br>\n三人之间的关系开始发生变化。",
  "0204Adv15_Narrative047": "我将小雪托付给艾玛。<br>\n因为小雪在学校被霸凌的情况还是没有改善。",
  "0204Adv15_Narrative048": "——就拜托你照顾小雪了。",
  "0204Adv15_Narrative049": "——嗯，交给我吧！",
  "0204Adv15_Narrative050": "即使平日里笑着装作若无其事的样子，<br>\n其实我心里一直嫉妒着艾玛。<br>",
  "0204Adv15_Narrative051": "心中这小小的黑暗——",
  "0204Adv15_Narrative052": "在我回国得知小雪自杀后，<br>\n爆发式地膨胀起来。",
  "0204Adv15_Narrative053": "——我非常重要的朋友自杀了。",
  "0204Adv15_Hiro018": "（但那只不过是<br>\n　她用来折磨艾玛的手段）",
  "0204Adv15_Narrative054": "她叫月代雪。",
  "0204Adv15_Hiro019": "（她其实是大魔女）",
  "0204Adv15_Narrative055": "当我推开房门时，<br>\n那根上吊绳还静静地悬挂在原地。",
  "0204Adv15_Narrative056": "我抬头怒视那根为她准备好的绞索。",
  "0204Adv15_Hiro020": "（如今我明白了。<br>\n　她是为了在艾玛心里留下心理创伤）",
  "0204Adv15_Narrative057": "我将背脊挺得笔直，<br>\n视线穿过那为了扼住她的咽喉而存在的圆环——<br>\n过于刺眼的憎恶，让我咬紧了牙关。",
  "0204Adv15_Narrative058": "我无法原谅。<br>\n无法原谅小雪的生命，就这么被区区一根绳子夺走。",
  "0204Adv15_Hiro021": "（她是为了对艾玛的心灵造成伤痛，<br>\n　故意遭到霸凌，<br>\n　故意自杀的）",
  "0204Adv15_Narrative059": "对我而言，这是不可饶恕的行为。<br>\n对我而言，这是不正确的行为。",
  "0204Adv15_Hiro022": "（我被她骗得团团转，<br>\n　更进一步将艾玛逼入绝境）",
  "0204Adv15_Narrative060": "我最崇尚的就是【正确】。",
  "0204Adv15_Hiro023": "（我正如月代雪所愿，<br>\n　被她玩弄于股掌之间，还甘之如饴）",
  "0204Adv15_Narrative061": "这个世界上，<br>\n不该允许有哪怕一丝一毫的错误存在。",
  "0204Adv15_Hiro024": "（我的一切都是错误的）",
  "0204Adv15_Narrative062": "清澈的湖水中若是掺入一滴毒素，<br>\n生灵便会死绝。",
  "0204Adv15_Hiro025": "（那滴毒药，是我）",
  "0204Adv15_Narrative063": "精致的画布上若是划出一道划痕，<br>\n艺术的价值便随之泯灭。",
  "0204Adv15_Hiro026": "（那道伤痕，是我）",
  "0204Adv15_Narrative064": "完美的和声中若是混进一个错误的音符，<br>\n就会沦为刺耳的不协和音。",
  "0204Adv15_Hiro027": "（那个错音，是我）",
  "0204Adv15_Narrative065": "祈盼着正确的大脑中<br>\n若是寄生了一只害虫——",
  "0204Adv15_Hiro028": "（那只害虫，是我）",
  "0204Adv15_Narrative066": "整个世界，便会崩塌。",
  "0204Adv15_Narrative067": "——在绞索圆环的彼端，<br>\n我看见了造就这个错误世界的罪魁祸首。",
  "0204Adv15_Hiro029": "（那就是我）",
  "0204Adv15_Hiro030": "（是我、是我、是我、<br>\n　是我、是我、是我——）",
  "0204Adv15_Hiro031": "啊啊、啊啊啊啊啊、啊啊啊啊呜啊啊啊——！！",
  "0204Adv15_Narrative068": "我失去了一切。<br>\n我手中根本没有什么正义。<br>\n我是如此无力。",
  "0204Adv15_Narrative069": "我没能拯救任何人。",
  "0204Adv15_Narrative070": "我只能不住呜咽，<br>\n不断痛哭。",
  "0204Adv15_Hiro032": "呜、呜呜呜、啊啊……<br>\n啊啊、啊啊！",
  "0204Adv15_Hiro033": "…………",
  "0204Adv15_Narrative071": "——不知道自己哭了多久。",
  "0204Adv15_Narrative072": "不知何时起，雪的气息已消失无踪。<br>\n她大概对我这个人从头到尾都无所谓吧。",
  "0204Adv15_Narrative073": "眼泪早已干涸，<br>\n唯有泪痕冰冷地贴在脸颊上。",
  "0204Adv15_Narrative074": "嗓子只能发出沙哑的气音，<br>\n眼睛也失去光芒变得浑浊。",
  "0204Adv15_Narrative075": "空虚在胸腔深处扎根、蔓延，<br>\n只余下残破的感情和一片静寂。",
  "0204Adv15_Narrative076": "铁栅栏外模模糊糊看见一双脚。<br>",
  "0204Adv15_Hiro034": "（啊啊，对了，还有几个少女<br>\n　存活下来……）",
  "0204Adv15_Hiro035": "（不过，她们恐怕也……）",
  "0204Adv15_Narrative077": "我迟钝地抬起头。<br>\n透过铁栅望着我的，是亚里沙和米莉亚。",
  "0204Adv15_Narrative078": "大概是听见我撕心裂肺的哭声，<br>\n她们才没有出声打扰。",
  "0204Adv15_Narrative079": "隔着铁栅栏，她们略显不安，<br>\n担忧地望着我。",
  "0204Adv15_Alisa001": "……二阶堂，我有个东西想给你看看。<br>",
  "0204Adv15_Hiro036": "给我看？事到如今，还能有什么……",
  "0204Adv15_Miria001": "如果你还很难受，也不必勉强自己。<br>\n但……大叔我们<br>\n也只是想尽一点心意，希望能帮帮你……",
  "0204Adv15_Miria002": "这东西到底能不能帮上你的忙，其实大叔我也不确定。<br>\n但……别再哭了，好吗？",
  "0204Adv15_Narrative080": "我摇摇晃晃地站起身，走出牢房。",
  "0204Adv15_Narrative081": "大脑已无法思考更多，只是机械地跟着她们。"
}
}
