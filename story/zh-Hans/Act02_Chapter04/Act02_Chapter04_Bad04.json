{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter04/Act02_Chapter04_Bad04",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-4-b4", "line": 8, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_1"}},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "（……我要杀了艾玛）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "这个念头在脑海中成型的瞬间。<br>\n犹豫不决的心，仿佛终于找到了方向。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative001"]}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_32_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛她啊，<br>\n总有一天会成为带来灾祸的魔女哦。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Yuki001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "她会杀死很多人。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Yuki002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "会让大家变得不幸。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Yuki003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我回想起小雪<br>\n曾说过的话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "小雪是因为遭受霸凌而自杀的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "艾玛选择做个旁观者，<br>\n不去保护被霸凌的小雪，甚至对这一切视而不见。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative004"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "这恐怕才是樱羽艾玛的本性。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative005"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "她就是给世界带来灾祸的，邪恶魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative006"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "她在这座监牢里的暴露出的可疑举动和诡异言辞，<br>\n正印证了这一点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative007"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "（所以，我要杀了艾玛）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro002"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "不，我必须杀了艾玛。<br>\n这是对世界来说最正确的选择。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative008"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "我伸出手，<br>\n握住艾玛纤细的脖颈。<br>\n接着，手指慢慢施力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative009"]}},
    {"op": "PlaySfxModified", "line": 49, "indent": 0, "params": {"SfxPath": "Sfx_153", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 50, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "指尖传来仿佛轻轻一折<br>\n就会断裂的脆弱感。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative010"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "——和艾玛共度的童年时光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative011"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "——小雪、艾玛，还有我。<br>\n三人一起度过的日子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative012"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "——在这座监牢中发生的一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative013"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "与艾玛有关的回忆，<br>\n在脑海中不断旋转。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative014"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "我感到窒息般的痛苦。<br>\n可勒住她脖子的明明是我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative015"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "唔……啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema001"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "艾玛呻吟着睁开眼。<br>\n看见是我，她的眼中浮现出惊恐与困惑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative016"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "——别被她欺骗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative017"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "我加重了手上的力道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative018"]}},
    {"op": "PlaySfxModified", "line": 75, "indent": 0, "params": {"SfxPath": "Sfx_153", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 76, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "啊……咕……呃！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema002"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "艾玛手脚并用地挣扎着，试图抵抗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative019"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "去死！去死去死去死！去死……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro003"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "长久以来压抑心底的怨恨喷涌而出。<br>\n我一刻也没有放松指尖的力道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative020"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "终于——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative021"]}},
    {"op": "ResetText", "line": 90, "indent": 0, "params": {}},
    {"op": "Wait", "line": 91, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "IdAndAppearance": "Ema.Pensive1,Angle01/ArmR>ArmR06"}},
    {"op": "Wait", "line": 93, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "艾玛彻底不动了。<br>\n像一滩烂泥倒在那里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative022"]}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "哈啊……哈啊……死了……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro004"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "是我，杀死了，艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative023"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "这明明是正确的行动。<br>\n可不知为何，心情却如此沉重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative024"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "一股纷乱的情绪，<br>\n侵蚀着我的内心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative025"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "这就是罪恶感吗？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative026"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我不知道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative027"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "我说不清自己的感受。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative028"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "只想快速离开这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative029"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "我松开扼住艾玛脖子的手，向后退开一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative030"]}},
    {"op": "ResetText", "line": 117, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 118, "indent": 0, "params": {}},
    {"op": "Wait", "line": 119, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "——为什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema003"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro005"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "我的心脏猛地一跳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative031"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "本以为已经死去的艾玛，竟然开口说话了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative032"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "好过分啊，希罗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Scale": [0.5], "Duration": 3.0, "Lazy": 0, "ScenePosition": [50.0, 70.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "Wait", "line": 132, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "艾玛缓缓撑起上半身。<br>\n她声音昏暗，充斥着一种异样的气息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative033"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "艾玛身上的气场让我不由自主地后退了一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative034"]}},
    {"op": "HideAllCharacters", "line": 138, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Scale": [0.75], "Duration": 1.5, "Lazy": 0, "ScenePosition": [50.0, 60.0], "IdAndAppearance": "Ema"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "我还以为，我们又能和好了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema005"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "艾玛走下床，<br>\n向我逼近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative035"]}},
    {"op": "HideAllCharacters", "line": 145, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "CreatureEma.0-1"}},
    {"op": "PlayBgm", "line": 152, "indent": 0, "params": {"BgmPath": "Bgm_16_1_Loop", "IntroBgmPath": "Bgm_16_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "她的身姿扭曲变形，逐渐变成怪物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative036"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "魔女化了吗……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro006"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "面对步步逼近的艾玛，<br>\n我感到了深不见底的恐惧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative037"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "化为异形的艾玛纤弱而虚幻，<br>\n却又透着某种美感，甚至有些神圣。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative038"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "但同时，我也感到了丑陋。<br>\n一定是因为她身上<br>\n孕育着不可名状的邪恶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative039"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "（我没有错）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro007"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "艾玛果然是带来灾厄的魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative040"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "——真的吗？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative041"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "事到如今，我的心依然在迷惘。<br>\n思绪混乱不堪，始终无法坚定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative042"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "究竟什么才是正确的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative043"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "我到底应该怎么做？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative044"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "CreatureEma.1-1"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "我……想起来了……<br>\n关于她的事，和我的罪……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema006"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "她其实，一直都在我身边哦。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema007"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "你在说什么……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro008"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "艾玛的视线无法聚焦，<br>\n在空中游移不定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative045"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "她总是在我耳边说……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema008"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "……说，大家都去死就好了。<br>\n所以啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema009"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "艾玛飘忽不定的眼神锁定了我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative046"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "希罗你也去死吧？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Ema010"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "你说什——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 196, "indent": 0, "params": {"Scale": [5.0], "Duration": 0.20000000298023224, "Lazy": 0, "ScenePosition": [50.0, 0.0], "IdAndAppearance": "CreatureEma.1-1"}},
    {"op": "ResetText", "line": 197, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 198, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 199, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 200, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "PlaySfxModified", "line": 203, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "如同断线木偶，<br>\n希罗当场瘫倒下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative047"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "二阶堂希罗死了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative048"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "因觉醒后的艾玛施展出【魔女杀手】魔法，<br>\n希罗没能发动死亡回溯，而是迎来了真正的死亡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative049"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "艾玛茫然伫立在希罗的尸骸前。<br>\n一个声音在艾玛耳边轻柔地低语道：", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative050"]}},
    {"op": "ResetText", "line": 213, "indent": 0, "params": {}},
    {"op": "Wait", "line": 214, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "——我们还要杀很多很多人哦，艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Bad04_Narrative051"]}},
    {"op": "ProcessBadEnd", "line": 222, "indent": 0, "params": {"Number": 24}}
  ],
  "translations": {
  "0204Bad04_Hiro001": "（……我要杀了艾玛）",
  "0204Bad04_Narrative001": "这个念头在脑海中成型的瞬间。<br>\n犹豫不决的心，仿佛终于找到了方向。",
  "0204Bad04_Yuki001": "艾玛她啊，<br>\n总有一天会成为带来灾祸的魔女哦。",
  "0204Bad04_Yuki002": "她会杀死很多人。",
  "0204Bad04_Yuki003": "会让大家变得不幸。",
  "0204Bad04_Narrative002": "我回想起小雪<br>\n曾说过的话。",
  "0204Bad04_Narrative003": "小雪是因为遭受霸凌而自杀的。",
  "0204Bad04_Narrative004": "艾玛选择做个旁观者，<br>\n不去保护被霸凌的小雪，甚至对这一切视而不见。",
  "0204Bad04_Narrative005": "这恐怕才是樱羽艾玛的本性。",
  "0204Bad04_Narrative006": "她就是给世界带来灾祸的，邪恶魔女。",
  "0204Bad04_Narrative007": "她在这座监牢里的暴露出的可疑举动和诡异言辞，<br>\n正印证了这一点。",
  "0204Bad04_Hiro002": "（所以，我要杀了艾玛）",
  "0204Bad04_Narrative008": "不，我必须杀了艾玛。<br>\n这是对世界来说最正确的选择。",
  "0204Bad04_Narrative009": "我伸出手，<br>\n握住艾玛纤细的脖颈。<br>\n接着，手指慢慢施力。",
  "0204Bad04_Narrative010": "指尖传来仿佛轻轻一折<br>\n就会断裂的脆弱感。",
  "0204Bad04_Narrative011": "——和艾玛共度的童年时光。",
  "0204Bad04_Narrative012": "——小雪、艾玛，还有我。<br>\n三人一起度过的日子。",
  "0204Bad04_Narrative013": "——在这座监牢中发生的一切。",
  "0204Bad04_Narrative014": "与艾玛有关的回忆，<br>\n在脑海中不断旋转。",
  "0204Bad04_Narrative015": "我感到窒息般的痛苦。<br>\n可勒住她脖子的明明是我。",
  "0204Bad04_Ema001": "唔……啊……",
  "0204Bad04_Narrative016": "艾玛呻吟着睁开眼。<br>\n看见是我，她的眼中浮现出惊恐与困惑。",
  "0204Bad04_Narrative017": "——别被她欺骗。",
  "0204Bad04_Narrative018": "我加重了手上的力道。",
  "0204Bad04_Ema002": "啊……咕……呃！",
  "0204Bad04_Narrative019": "艾玛手脚并用地挣扎着，试图抵抗。",
  "0204Bad04_Hiro003": "去死！去死去死去死！去死……！",
  "0204Bad04_Narrative020": "长久以来压抑心底的怨恨喷涌而出。<br>\n我一刻也没有放松指尖的力道。",
  "0204Bad04_Narrative021": "终于——",
  "0204Bad04_Narrative022": "艾玛彻底不动了。<br>\n像一滩烂泥倒在那里。",
  "0204Bad04_Hiro004": "哈啊……哈啊……死了……",
  "0204Bad04_Narrative023": "是我，杀死了，艾玛。",
  "0204Bad04_Narrative024": "这明明是正确的行动。<br>\n可不知为何，心情却如此沉重。",
  "0204Bad04_Narrative025": "一股纷乱的情绪，<br>\n侵蚀着我的内心。",
  "0204Bad04_Narrative026": "这就是罪恶感吗？",
  "0204Bad04_Narrative027": "我不知道。",
  "0204Bad04_Narrative028": "我说不清自己的感受。",
  "0204Bad04_Narrative029": "只想快速离开这里。",
  "0204Bad04_Narrative030": "我松开扼住艾玛脖子的手，向后退开一步。",
  "0204Bad04_Ema003": "——为什么？",
  "0204Bad04_Hiro005": "！？",
  "0204Bad04_Narrative031": "我的心脏猛地一跳。",
  "0204Bad04_Narrative032": "本以为已经死去的艾玛，竟然开口说话了。",
  "0204Bad04_Ema004": "好过分啊，希罗。",
  "0204Bad04_Narrative033": "艾玛缓缓撑起上半身。<br>\n她声音昏暗，充斥着一种异样的气息。",
  "0204Bad04_Narrative034": "艾玛身上的气场让我不由自主地后退了一步。",
  "0204Bad04_Ema005": "我还以为，我们又能和好了。",
  "0204Bad04_Narrative035": "艾玛走下床，<br>\n向我逼近。",
  "0204Bad04_Narrative036": "她的身姿扭曲变形，逐渐变成怪物。",
  "0204Bad04_Hiro006": "魔女化了吗……？",
  "0204Bad04_Narrative037": "面对步步逼近的艾玛，<br>\n我感到了深不见底的恐惧。",
  "0204Bad04_Narrative038": "化为异形的艾玛纤弱而虚幻，<br>\n却又透着某种美感，甚至有些神圣。",
  "0204Bad04_Narrative039": "但同时，我也感到了丑陋。<br>\n一定是因为她身上<br>\n孕育着不可名状的邪恶。",
  "0204Bad04_Hiro007": "（我没有错）",
  "0204Bad04_Narrative040": "艾玛果然是带来灾厄的魔女。",
  "0204Bad04_Narrative041": "——真的吗？",
  "0204Bad04_Narrative042": "事到如今，我的心依然在迷惘。<br>\n思绪混乱不堪，始终无法坚定。",
  "0204Bad04_Narrative043": "究竟什么才是正确的。",
  "0204Bad04_Narrative044": "我到底应该怎么做？",
  "0204Bad04_Ema006": "我……想起来了……<br>\n关于她的事，和我的罪……",
  "0204Bad04_Ema007": "她其实，一直都在我身边哦。",
  "0204Bad04_Hiro008": "你在说什么……？",
  "0204Bad04_Narrative045": "艾玛的视线无法聚焦，<br>\n在空中游移不定。",
  "0204Bad04_Ema008": "她总是在我耳边说……",
  "0204Bad04_Ema009": "……说，大家都去死就好了。<br>\n所以啊……",
  "0204Bad04_Narrative046": "艾玛飘忽不定的眼神锁定了我。",
  "0204Bad04_Ema010": "希罗你也去死吧？",
  "0204Bad04_Hiro009": "你说什——",
  "0204Bad04_Narrative047": "如同断线木偶，<br>\n希罗当场瘫倒下去。",
  "0204Bad04_Narrative048": "二阶堂希罗死了。",
  "0204Bad04_Narrative049": "因觉醒后的艾玛施展出【魔女杀手】魔法，<br>\n希罗没能发动死亡回溯，而是迎来了真正的死亡。",
  "0204Bad04_Narrative050": "艾玛茫然伫立在希罗的尸骸前。<br>\n一个声音在艾玛耳边轻柔地低语道：",
  "0204Bad04_Narrative051": "——我们还要杀很多很多人哦，艾玛。"
}
}
