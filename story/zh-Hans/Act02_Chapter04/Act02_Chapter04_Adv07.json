    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "本来，我确信艾玛是魔女，<br>\n认为必须在她完全变成魔女之前杀掉她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative013"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "但这真的正确吗？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative014"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "我的心情、我的行动，一切都充满了矛盾。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative015"]}},
