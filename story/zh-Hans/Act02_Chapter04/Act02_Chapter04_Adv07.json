    {"op": "Wait", "line": 70, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "在限制活动期间，<br>\n我和艾玛必须在房间里独处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative007"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "虽然我已经习惯了<br>\n尽量不去在意艾玛的存在……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative008"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "……住手，我不要这样，住手啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Ema003"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "自从上次事件后，<br>\n艾玛开始频繁发呆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative009"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "她时常喃喃自语，<br>\n嘴里低声嘀咕着什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative010"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "（到底在自言自语些什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Hiro002"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "……只要大家都去死就好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Ema004"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "不对……这不是我的愿望……<br>\n明明我没有……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Ema005"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "仔细听就会发现，<br>\n自言自语的内容很危险。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative011"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "（是因为压力导致魔女化加剧，<br>\n　她开始产生杀意了……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Hiro003"]}},
