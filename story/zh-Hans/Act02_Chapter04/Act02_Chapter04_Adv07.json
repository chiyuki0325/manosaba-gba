    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [30.0, 50.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "……她的状况越来越糟了。<br>\n得想点办法让她打起精神才行……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "典狱长似乎不在这里。我们走吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Hiro004"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "我刻意回避谈到艾玛，<br>\n率先离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Ema006"]}},
