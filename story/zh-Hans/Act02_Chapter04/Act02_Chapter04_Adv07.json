    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我和蕾雅来到了花田。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "我们打算在视野开阔的花田<br>\n寻找典狱长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "远眺整座山丘，繁花似锦。<br>\n在花丛之间……我看到了艾玛的身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "啊……蕾雅、希罗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "艾玛的神情有些恍惚，<br>\n她只是坐在花田里，茫然遥望着天空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative004"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "天气这么好，待在这里确实很舒服。<br>\n艾玛，你是在这里采花吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Leia001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "不……也没有。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Ema002"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "艾玛面无表情地摇了摇头。<br>\n蕾雅似乎察觉到了什么，<br>\n凑近我低声说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative005"]}},
