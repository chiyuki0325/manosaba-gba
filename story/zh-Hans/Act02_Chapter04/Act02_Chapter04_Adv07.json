    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [70.0, 30.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "Wait", "line": 47, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [60.0, 30.0], "IdAndAppearance": "Leia"}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "艾玛的状态，是不是有些奇怪？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "她最近一直这样。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Hiro001"]}},
    {"op": "HideAllCharacters", "line": 57, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "我脑海中浮现艾玛近来的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0204Adv07_Narrative006"]}},
