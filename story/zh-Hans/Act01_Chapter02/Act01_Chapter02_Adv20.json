  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-20", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "3_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛走在惩罚室所在的过道上，<br>\n突然遇到了雪莉和梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "啊，艾玛！<br>\n我就知道你会来这里。<br>\n毕竟来这里调查可是搜查的基础！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "是、是啊……<br>\n刚才大家都很恐慌，<br>\n我觉得还是得好好调查一番……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "（可是，说实话……我不忍心再目睹那个场面……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "雪莉，梅露露，<br>\n你们发现什么了吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "……没有，目前还没什么收获……<br>\n只知道惩罚室前的过道光线很暗。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "非要说的话，也就发现了这个吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry002"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "雪莉把刚才拽掉的锁<br>\n递给艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative002"]}},
    {"op": "SpawnExtended", "line": 51, "indent": 0, "params": {"Path": "Clue", "Params": ["2-2"]}},
    {"op": "UpdateWitchBook", "line": 52, "indent": 0, "params": {"Id": "2-2", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 53, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "我把锁弄坏了，<br>\n之后不会挨骂吧……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "应该不会……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "（惩罚室的门上了锁，<br>\n　房门是关着的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema005"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（我们赶过来的时候门是锁着的，<br>\n　打不开房门）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（既然如此，到底是谁，<br>\n　又是怎么捅伤米莉亚的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "这就是所谓的那个吧！经典的那个！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "啊，你是说……密室杀人？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "没错没错～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry005"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "（我就知道雪莉会很兴奋……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema009"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "慎重起见，我也调查了一下<br>\n其他惩罚室的门能不能开……但是都不行。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru002"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "所有房间都上了锁，<br>\n只有米莉亚小姐所在的惩罚室能进。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "虽然我也不太想调查米莉亚的尸体，<br>\n但现在能做的只有这一件事了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "这次典狱长大人<br>\n没说不能进去，<br>\n而且我们也没有时间了，走吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry007"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "嗯、嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema010"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 106, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "艾玛她们面色惨白，浑身颤抖着，<br>\n走进米莉亚尸体所在的惩罚室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative003"]}},
    {"op": "ModifyBackgroundExtended", "line": 110, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 60.0], "AppearanceAndTransition": "21_1"}},
    {"op": "Wait", "line": 111, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyBackgroundExtended", "line": 113, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.7999999523162842, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 114, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 116, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 117, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "再度观察整个惩罚室，<br>\n能看到里面放了很多可以当做凶器的东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative004"]}},
    {"op": "PlayBgm", "line": 121, "indent": 0, "params": {"BgmPath": "Bgm_26_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "（感觉只要有办法进来，<br>\n　杀人本身就很容易做到）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema011"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "（可就算是这样，<br>\n　也不该刺杀被绑在十字架上的米莉亚……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema012"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "艾玛带着痛苦的表情<br>\n战战兢兢地看向米莉亚那边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative005"]}},
    {"op": "ModifyBackgroundExtended", "line": 129, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "280_1"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "被束缚在十字架上的米莉亚的尸体<br>\n仍维持着先前的状态。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative006"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "看来她的腹部被捅了很多刀呢……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry008"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "雪莉立即掏出手机，<br>\n开始拍摄室内的照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 138, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 143, "indent": 0, "params": {"Path": "Clue", "Params": ["2-9"]}},
    {"op": "UpdateWitchBook", "line": 144, "indent": 0, "params": {"Id": "2-9", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 145, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "（再仔细一看……真的好残忍）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema013"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "（有必要捅这么多刀吗？<br>\n　米莉亚究竟做错了什么？<br>\n　还是说，这就是【魔女的杀意】……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema014"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "艾玛的眼角渐渐渗出泪花。<br>\n然后，她急忙眼泪擦掉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative008"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "（现在不是哭的时候……没时间了，<br>\n　得赶紧找到凶手的线索！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema015"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "可以把米莉亚小姐放下来吗……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru004"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "她确实挺可怜的……但是<br>\n在搜查阶段最好还是放着不要动。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry009"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "……凶器很明显是这个吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry010"]}},
    {"op": "ResetText", "line": 161, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 162, "indent": 0, "params": {"Offset": [0.0, 2.0], "Zoom": 0.5, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 163, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "SpawnExtended", "line": 168, "indent": 0, "params": {"Path": "Clue", "Params": ["2-5"]}},
    {"op": "UpdateWitchBook", "line": 169, "indent": 0, "params": {"Id": "2-5", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 170, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "雪莉指着<br>\n插在米莉亚胸口的一把刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative009"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "嗯……惩罚室里<br>\n到处都是可以用来行凶的刀具。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema016"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "凶手可能是就近随手捡了把刀<br>\n把米莉亚捅死了吧……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema017"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "你是说出于冲动杀人吗……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry011"]}},
    {"op": "ResetText", "line": 180, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 181, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 182, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "我、我……<br>\n去调查一下米莉亚小姐的尸体……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru005"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "梅露露眼角挂着泪水，<br>\n但还是神情坚定地说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative010"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "别、别这样，梅露露，不要勉强自己……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema018"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "没、没关系的……！<br>\n调查一下尸体<br>\n也许能找到什么线索……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru006"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "梅露露向米莉亚的尸体伸出手，<br>\n开始到处调查起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative011"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "她的手发着光，<br>\n大概是想施法治愈米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative012"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "（梅露露……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema019"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "我想愈合她的伤口……可是，<br>\n我的魔法却这么没用……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru007"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "梅露露一边不停地悄悄流泪，<br>\n一边满怀怜悯地调查米莉亚的尸体。<br>\n忽然，她的手停住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative013"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "这是……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru008"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "你发现了什么吗！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Sherry012"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "是、是的。米莉亚小姐的嘴里……<br>\n有个钥匙。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru009"]}},
