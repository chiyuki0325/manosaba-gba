    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "三人的精神承受力已经到了极限，<br>\n她们只好回到过道，把刚才郁积的浊气全都吐了出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 225, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "……根据调查结果来看，<br>\n她是腹部被刺中多刀后，<br>\n心脏受到了致命一击……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru011"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "应该是出血过量导致的死亡。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru012"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "嗯……谢谢你梅露露……<br>\n那我去调查一下其他地方。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Ema021"]}},
    {"op": "HideAllCharacters", "line": 235, "indent": 0, "params": {"Lazy": 0}},
