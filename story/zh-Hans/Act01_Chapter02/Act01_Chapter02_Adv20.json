    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "不知道……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv20_Meruru010"]}},
    {"op": "HideActors", "line": 219, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
