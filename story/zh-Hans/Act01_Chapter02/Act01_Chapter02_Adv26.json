    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "九位少女站在证人席上，<br>\n她们都想从彼此的眼里读出对方的真心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative015"]}},
