    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "黑部奈叶香小姐，你之前去哪里了。<br>\n我们找你找了很久。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Warden001"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "也罢，现在以魔女审判优先，<br>\n有关黑部奈叶香小姐的处分稍后再议……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Warden002"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "魔女审判的规则<br>\n大家都已经清楚了吧？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Warden003"]}},
