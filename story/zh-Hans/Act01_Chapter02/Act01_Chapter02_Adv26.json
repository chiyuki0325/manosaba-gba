    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "……樱羽艾玛。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "奈叶香站在那里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "奈叶香！？你之前都去哪了！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Ema003"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "没时间站在这里闲聊了。<br>\n我是为了出庭才来的。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "接下来的事，就在审判中揭晓吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Nanoka003"]}},
