    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "（怎么办，这就到时间了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Ema001"]}},
