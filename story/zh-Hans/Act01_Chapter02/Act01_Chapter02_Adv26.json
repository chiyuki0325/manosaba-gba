    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "听到提示音后，<br>\n艾玛看了眼自己的手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "『魔女审判即将开始』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "『请大家务必带好自己的手机，<br>\n　迅速到审判庭集合』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative004"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "『如有不遵守者，将由看守强制带走』<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative005"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "看来典狱长发来的通知<br>\n都是有固定模板的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative006"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "（该走了……我已经尽了自己的全力）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Ema002"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "艾玛急忙赶去审判庭。<br>\n在大门前，她看到——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv26_Narrative007"]}},
