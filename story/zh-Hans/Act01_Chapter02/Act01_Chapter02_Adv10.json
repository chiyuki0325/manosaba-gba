    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "23_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛走进<br>\n紧挨着监牢的招待所里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "刚进来，她就遇到了可可和玛格。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "哎呀，你好啊艾玛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo001"]}},
    {"op": "HideAllCharacters", "line": 28, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "嗯，你好！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "（玛格又是设计热气球，又是帮忙筹集布料，<br>\n　真佩服她这么能干）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema002"]}},
    {"op": "HideAllCharacters", "line": 35, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "然后艾玛的目光<br>\n转到可可身上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "（可可她还是阴晴不定的老样子，<br>\n　只会突然给别人泼冷水……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema003"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "（虽然她一直在办直播，<br>\n　但观众越来越少，越来越被孤立）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema004"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "（要是还陪她玩的米莉亚<br>\n　哪天不在了，<br>\n　天知道她会变成什么样……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema005"]}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "今天，可可缠着玛格<br>\n吵个不停。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "玛格，跟我一起直播嘛。<br>\n你的模仿特技绝对能爆红的。<br>\n来试试模仿动画配音嘛～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Coco001"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "对不起，<br>\n我只能模仿听过的声音。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo002"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "我几乎不看电视，<br>\n没办法模仿名人的声音。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo003"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Smile1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "啊，不过蕾雅和诺亚都算是名人吧。<br>\n她们的声音我有听过，<br>\n这个我倒是可以模仿。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo004"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "我不是那个意思啦～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Coco002"]}},
    {"op": "HideAllCharacters", "line": 68, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "玛格敷衍地回给她一个笑容，<br>\n便扭头看向艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "艾玛，你今天也是在找亚里沙吧。<br>\n她没来过这里。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo005"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "谢谢你，玛格。<br>\n你们在这里做什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema006"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "就算飞过了围墙，我们也不知道<br>\n还要移动多长距离才算安全，不是吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo006"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "所以我准备把应急食物和必需的物资<br>\n先藏在这里。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo007"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "如果这附近有村落还好说……<br>\n但这里是孤岛，我们还需要渡海。<br>\n那我们就要准备周全才行，你说对不对？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo008"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "是、是哦……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema007"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "好啦，也不用表现得那么难过。<br>\n现在我们先以飞过围墙为目标吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo009"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "之后的事情，到时候再考虑就好。<br>\n船到桥头自然直啦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo010"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "（有玛格帮我们<br>\n　真是太好了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema008"]}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "看到艾玛对玛格投以崇拜的目光，<br>\n可可咂了咂嘴，表示不屑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "啊～，真是无聊死了～。<br>\n找大叔玩去咯。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Coco003"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "可可故意提高音量，<br>\n丢下这句话后就走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative007"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "只剩艾玛和玛格两人面面相觑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "我是不是打扰到你们了……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema009"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "可可应该是想找人陪她玩吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo011"]}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "听说最近米莉亚经常陪她玩。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema010"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "是啊。虽然会给米莉亚增添负担，<br>\n但她确实是最适合的人选。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Margo012"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "（我也觉得……最近把米莉亚当做心灵支柱的人<br>\n　越来越多了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Ema011"]}},
    {"op": "HideAllCharacters", "line": 126, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "艾玛稍微帮玛格处理了些工作后，<br>\n便离开了招待所。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv10_Narrative009"]}},
    {"op": "Gosub", "line": 135, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 137, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv08", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv10_Narrative001": "艾玛走进<br>\n紧挨着监牢的招待所里。",
  "0102Adv10_Narrative002": "刚进来，她就遇到了可可和玛格。",
  "0102Adv10_Margo001": "哎呀，你好啊艾玛。",
  "0102Adv10_Ema001": "嗯，你好！",
  "0102Adv10_Ema002": "（玛格又是设计热气球，又是帮忙筹集布料，<br>\n　真佩服她这么能干）",
  "0102Adv10_Narrative003": "然后艾玛的目光<br>\n转到可可身上。",
  "0102Adv10_Ema003": "（可可她还是阴晴不定的老样子，<br>\n　只会突然给别人泼冷水……）",
  "0102Adv10_Ema004": "（虽然她一直在办直播，<br>\n　但观众越来越少，越来越被孤立）",
  "0102Adv10_Ema005": "（要是还陪她玩的米莉亚<br>\n　哪天不在了，<br>\n　天知道她会变成什么样……）",
  "0102Adv10_Narrative004": "今天，可可缠着玛格<br>\n吵个不停。",
  "0102Adv10_Coco001": "玛格，跟我一起直播嘛。<br>\n你的模仿特技绝对能爆红的。<br>\n来试试模仿动画配音嘛～",
  "0102Adv10_Margo002": "对不起，<br>\n我只能模仿听过的声音。",
  "0102Adv10_Margo003": "我几乎不看电视，<br>\n没办法模仿名人的声音。",
  "0102Adv10_Margo004": "啊，不过蕾雅和诺亚都算是名人吧。<br>\n她们的声音我有听过，<br>\n这个我倒是可以模仿。",
  "0102Adv10_Coco002": "我不是那个意思啦～！",
  "0102Adv10_Narrative005": "玛格敷衍地回给她一个笑容，<br>\n便扭头看向艾玛。",
  "0102Adv10_Margo005": "艾玛，你今天也是在找亚里沙吧。<br>\n她没来过这里。",
  "0102Adv10_Ema006": "谢谢你，玛格。<br>\n你们在这里做什么？",
  "0102Adv10_Margo006": "就算飞过了围墙，我们也不知道<br>\n还要移动多长距离才算安全，不是吗？",
  "0102Adv10_Margo007": "所以我准备把应急食物和必需的物资<br>\n先藏在这里。",
  "0102Adv10_Margo008": "如果这附近有村落还好说……<br>\n但这里是孤岛，我们还需要渡海。<br>\n那我们就要准备周全才行，你说对不对？",
  "0102Adv10_Ema007": "是、是哦……",
  "0102Adv10_Margo009": "好啦，也不用表现得那么难过。<br>\n现在我们先以飞过围墙为目标吧。",
  "0102Adv10_Margo010": "之后的事情，到时候再考虑就好。<br>\n船到桥头自然直啦。",
  "0102Adv10_Ema008": "（有玛格帮我们<br>\n　真是太好了……）",
  "0102Adv10_Narrative006": "看到艾玛对玛格投以崇拜的目光，<br>\n可可咂了咂嘴，表示不屑。",
  "0102Adv10_Coco003": "啊～，真是无聊死了～。<br>\n找大叔玩去咯。",
  "0102Adv10_Narrative007": "可可故意提高音量，<br>\n丢下这句话后就走了。",
  "0102Adv10_Narrative008": "只剩艾玛和玛格两人面面相觑。",
  "0102Adv10_Ema009": "我是不是打扰到你们了……？",
  "0102Adv10_Margo011": "可可应该是想找人陪她玩吧。",
  "0102Adv10_Ema010": "听说最近米莉亚经常陪她玩。",
  "0102Adv10_Margo012": "是啊。虽然会给米莉亚增添负担，<br>\n但她确实是最适合的人选。",
  "0102Adv10_Ema011": "（我也觉得……最近把米莉亚当做心灵支柱的人<br>\n　越来越多了）",
  "0102Adv10_Narrative009": "艾玛稍微帮玛格处理了些工作后，<br>\n便离开了招待所。"
}
}
