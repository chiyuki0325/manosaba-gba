    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Fearful1,ArmR8,ArmL7"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "呀啊啊啊啊啊——！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria001"]}},
    {"op": "HideAllCharacters", "line": 24, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "刚走进娱乐室，<br>\n艾玛就听见米莉亚那几乎刺破耳膜的惨叫声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "米莉亚！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema001"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "艾玛的脸色唰的一下变白了，<br>\n她急忙跑到沙发那边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Normal1,ArmR8,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "啊，小、小艾……？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria002"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "你刚才的惨叫……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema002"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_AnAn001"]}},
    {"op": "HideAllCharacters", "line": 48, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "安安正在米莉亚的身旁坐着。<br>\n最近她们两个好像屁股长在沙发上，一定会出现在这里。<br>\n这时安安无言地直指前方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative003"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "艾玛回头一看，银幕上<br>\n正在播放电影。<br>\n看来现在在放恐怖片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative004"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "米莉亚调节好呼吸后，<br>\n走到艾玛身边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1,ArmR2,ArmL2"}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "抱、抱歉，吵到你了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria003"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "因为安安非要缠着我让我放恐怖片看，<br>\n我就只好放了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1,ArmR6,ArmL6"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "呜呜……但大叔我真的害怕恐怖片啊……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria005"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "原来是这样啊，那就好。我还以为出什么事了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema003"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "吓到你了吧……以后我会注意的……<br>\n明明你们在努力为计划做准备，<br>\n而我却在这里玩。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria006"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "没关系的，你不用太介意。<br>\n待在安全的地方对你也比较好。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema004"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "呜……也、也对。<br>\n毕竟还没有找到奈叶香……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria007"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "嗯……她都消失好几天了，<br>\n到底是怎么藏这么久的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "最近看守也经常在外面巡逻，<br>\n我猜大概是在找奈叶香。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Normal1,ArmR4,ArmL3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "四处巡逻的看守好可怕啊……<br>\n要是越狱计划被发现，那可就糟了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria008"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "我们得提高警惕才行。<br>\n一定要让越狱计划成功。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema007"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "听到艾玛的话，<br>\n不知为何米莉亚的脸色有些消沉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1,ArmR4,ArmL3"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "我们真的应该逃出去吗……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria009"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Normal1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "啊，抱、抱歉！哎呀大叔我<br>\n总爱把事情往坏处想，真是个坏毛病。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria010"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "你别放在心上。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Miria011"]}},
    {"op": "HideAllCharacters", "line": 107, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "艾玛和米莉亚聊着聊着，<br>\n忽然注意到安安站在旁边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Normal1,ArmR1,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_AnAn002"]}},
    {"op": "HideAllCharacters", "line": 117, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "她一言不发地拽住米莉亚的裙摆，<br>\n然后，狠狠地瞪着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "啊，我打扰你们看电影了吧。<br>\n对不起，我这就走。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema009"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "（安安她最近看上去<br>\n　好像又把内心封闭起来了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema010"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "（不过有米莉亚陪着她，<br>\n　应该没事吧……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Ema011"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "尽管艾玛有些担心安安阴沉的模样，<br>\n但她还是马上离开了娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv11_Narrative009"]}},
    {"op": "Gosub", "line": 140, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
