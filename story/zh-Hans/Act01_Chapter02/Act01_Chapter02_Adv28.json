    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "【在此记下逃脱方法】", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv28_Narrative008"]}},
