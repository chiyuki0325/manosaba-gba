    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "米莉亚遭杀害的原因<br>\n究竟是什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "为了进一步了解米莉亚，<br>\n艾玛去了趟她的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative002"]}},
    {"op": "ResetText", "line": 24, "indent": 0, "params": {}},
