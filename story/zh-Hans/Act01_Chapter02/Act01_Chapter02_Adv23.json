    {"op": "ModifyBackgroundExtended", "line": 28, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 29, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 30, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "那里已经有人捷足先登了。来者是玛格。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "哎呀，真巧啊艾玛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "你在这里做什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Ema001"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "搜查而已。<br>\n不用那么警惕我，现在我们还不是敌人呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Smile1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "不过等审判开始以后，<br>\n我就不会手下留情了。呵呵。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo003"]}},
    {"op": "HideAllCharacters", "line": 48, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "（现在是笑的时候吗……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Ema002"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "玛格嬉皮笑脸的样子<br>\n令艾玛感到反感。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR2"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "艾玛，你有想过<br>\n米莉亚交换身体的原因吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo004"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "忽然，玛格冷不丁地问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative005"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "我也很好奇，就去问了她本人。<br>\n但她没有正面回答我。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Ema003"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "我呢，之前有怀疑过<br>\n她的魔法是不是假的，<br>\n逼着她用过一回。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo005"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "我跟她约好，一定会马上换回来，<br>\n让她对我用了魔法。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo006"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "欸！？什么时候的事……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Smile1,ArmR4"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "呵呵，虽然她特别不情愿。<br>\n但她的魔法是真的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo007"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Smile1,ArmR6"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "就在那短短的一瞬间，我变成了米莉亚。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo008"]}},
    {"op": "HideAllCharacters", "line": 80, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "玛格一脸如痴如醉状，<br>\n似乎在想像那时的情景。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR6"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "可当我刚准备对米莉亚的身体玩点恶作剧的时候，<br>\n就马上回到自己的身体了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo009"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "（原来米莉亚的【互换】魔法<br>\n　是真的啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Ema005"]}},
    {"op": "UpdateWitchBook", "line": 90, "indent": 0, "params": {"Id": "Miria", "Category": "Profile", "Version": 3}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR6"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "如果她确实交换了身体，<br>\n那么真正的米莉亚究竟在哪呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo010"]}},
    {"op": "HideAllCharacters", "line": 95, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "玛格一句无心的低语唤起了艾玛内心的在意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative007"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "（真正的米莉亚……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Ema006"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "想到昨晚米莉亚那阴沉的表情和无力的自言自语，<br>\n艾玛的直觉告诉她，那就是真正的米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "顺便告诉你，我在这里没找到任何线索。<br>\n看来米莉亚还是个极度秘密主义者呢，<br>\n没有留下任何有关自己的痕迹。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo011"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "如果不相信我的话，<br>\n你也可以亲自搜查一下。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Margo012"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "……没关系，我相信你。<br>\n玛格，谢谢你告诉我情报。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Ema007"]}},
    {"op": "HideAllCharacters", "line": 111, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "艾玛离开了牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv23_Narrative009"]}},
