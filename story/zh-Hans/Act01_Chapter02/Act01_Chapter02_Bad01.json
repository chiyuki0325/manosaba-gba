  "language": "zh-Hans",
  "path": "Act01_Chapter02/Act01_Chapter02_Bad01",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-b1", "line": 8, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "100_1"}},
    {"op": "ModifyBackgroundExtended", "line": 12, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 13, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "同意试试看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative001"]}},
    {"op": "PlayBgm", "line": 17, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "机会难得，不如占卜看看……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema001"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "呵呵呵，就喜欢你这样的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo001"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "看到玛格面露妖艳的微笑，汉娜不禁对她投来怀疑的目光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "总感觉非常地可疑呢……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "哎呀，可别这么说。放心吧。<br>\n就像我刚才说过的那样，我的占卜真的很准啦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "可是，你的收费很贵吧？<br>\n我们都没有钱……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry001"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "这个嘛……那就特别给你们首次优惠，<br>\n先欠着好了。<br>\n……不过我也不介意用身体支付哦♡", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo003"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "玛格眯起眼睛，盯着艾玛等人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative003"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "用、用身体，是什么意思……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "呵呵，这个就任君想像了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo004"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "等、等等艾玛！<br>\n还是别占卜比较好吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna002"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "汉娜害怕地抱紧自己的身体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative004"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "也、也是……<br>\n抱歉玛格，我就不占卜了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema003"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "哎呀，现在可没法取消了哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo005"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "欸？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema004"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "因为我已经给你占卜了嘛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo006"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "玛格小声笑着<br>\n把三张塔罗牌摆在桌上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "三张牌分别代表过去、现在和未来。<br>\n首先是第一张。过去是……【塔】的正位。<br>\n这个结果好像和之前一样呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo007"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "艾玛和雪莉看向彼此。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative006"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "我相信不会发生凶杀案的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema005"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "玛格拿出一张牌，<br>\n放在了艾玛和雪莉面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative007"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "【塔】的正位。<br>\n……在不久的将来，会有某个人死去。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo008"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "确实和之前是同一张牌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative008"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "（在那之后真的发生了案件，诺亚她……<br>\n　我也不想相信，但她可能真的预测中了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema006"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "第二张牌代表着现在……【月亮】的正位。<br>\n这张牌的意思是……<br>\n对无法预知的危险和望不到头的现状而感到不安。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo009"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "不觉得这正是现在的我们吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo010"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "（好像，是这样……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema007"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "会不会再次发生案件。<br>\n谁又会杀谁，谁会被处刑。<br>\n毫无疑问，大家都被笼罩在这些不安当中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative009"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "最后一张牌代表的是未来。<br>\n……【恶魔】的正位。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo011"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "只能让人联想到不好的事情。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna003"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "见汉娜愁眉苦脸的样子，玛格点点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative010"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "很遗憾，确实如此。<br>\n失去朋友、背叛、憎恨、嫉妒、破灭……<br>\n这张牌的正位有很多负面的意思。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo012"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "破灭……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema008"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "艾玛一脸严肃的嘟哝道，玛格见此便耸耸肩说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative011"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "如果让你感到不安了，先说声抱歉。<br>\n但这并不意味一定会迎来这样的未来。<br>\n也可以把它当做一种警告。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo013"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "根据你今后的行动，<br>\n或许……未来也会被改变。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo014"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "玛格……嗯，你说得对！<br>\n谢谢你！我们会加油的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema009"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "呵呵，好啊……加油吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo015"]}},
    {"op": "ResetText", "line": 103, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 104, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 105, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 106, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 107, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 108, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 109, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "玛格的占卜结束后，艾玛等人便离开房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "（虽然说要加油，<br>\n　但我还是很在意占卜的结果……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema010"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "（背叛……<br>\n　是指我们当中的某个人会背叛吗）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema011"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Default"}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "艾玛瞥了一眼雪莉和汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative013"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "（如果她们两人……<br>\n　不要，我不想考虑这种可能）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema012"]}},
    {"op": "HideAllCharacters", "line": 127, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Default"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "艾玛，你怎么了？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry002"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "雪莉注意到艾玛的视线，便问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative014"]}},
    {"op": "HideAllCharacters", "line": 134, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 135, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "艾玛，你也在想那个占卜结果吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "……这么说，你也是？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema013"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "我觉得过去和现在都占卜得很准，<br>\n所以……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna005"]}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "嗯，是啊。<br>\n就是感觉忘不掉……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema014"]}},
    {"op": "HideAllCharacters", "line": 154, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "玛格的话里有着奇妙的说服力——<br>\n令人不禁去想她所说的可能。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 158, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Default"}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "嗯……可是再怎么想<br>\n也没有意义吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 162, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "欸，雪莉你不在意那个吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema015"]}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 168, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Default"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "说实话，我觉得玛格的占卜<br>\n跟巴纳姆效应差不多吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 172, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive"}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "巴纳……那是什么……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna006"]}},
    {"op": "HideAllCharacters", "line": 177, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "大概就是罗列一些和现在的情况<br>\n比较贴切的内容……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry005"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "比如【在不久的将来有人会死】这个占卜结果……<br>\n其实在当时的情况下，大家肯定<br>\n都感到很不安吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "突然被关进监狱，二阶堂希罗死亡，<br>\n紧接着又通告了凶杀案和魔女审判的事。<br>\n无论是谁，都会感到害怕吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "这么一说，也是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema016"]}},
    {"op": "HideAllCharacters", "line": 192, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Default"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "刚才的占卜也一样。<br>\n所谓望不到头的未来，只是明摆着的事实！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry007"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "关于未来的占卜结果也是，以我们现在的情况，<br>\n会去相信那些<br>\n煽动不安的内容也不奇怪啦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 199, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "雪莉你好厉害！<br>\n不愧是名侦探！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema017"]}},
    {"op": "HideAllCharacters", "line": 204, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "欸嘿！所以呢，<br>\n还是别太在意那些东西比较好啦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry009"]}},
    {"op": "HideAllCharacters", "line": 209, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "唉～真是个头脑简单的女人……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna007"]}},
    {"op": "HideAllCharacters", "line": 214, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "与赞同雪莉的艾玛不同，<br>\n汉娜无奈地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "ModifyCharacterExtended", "line": 219, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Default"}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "也许她的魔法就是占卜呢？<br>\n比如说她用塔罗牌占卜的结果一定会实现！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna008"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "唔～这个思维太跳跃了吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry010"]}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "而且她本人好像否定过<br>\n这个说法……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema018"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "雪莉问玛格的时候，<br>\n玛格明确否定了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Surprised"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "你们该不会就这么信了吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna009"]}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "汉娜的脸上露出不敢置信的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "是、是啊，我没感觉有什么问题……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema019"]}},
    {"op": "ModifyCharacterExtended", "line": 240, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Pensive"}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "你们是有多善良啊……<br>\n不对，难道她的魔法是让人相信谎言……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna010"]}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "什么事都要扯到魔法的话<br>\n可就没完没了了哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "但是可能性还是有的吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna011"]}},
    {"op": "HideAllCharacters", "line": 252, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "（咦……？怎么感觉<br>\n　空气里有点火药味？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema020"]}},
    {"op": "StopBgm", "line": 256, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 258, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "在这略显尴尬的氛围里，她们没能商量越狱计划的事，<br>\n放风时间就这样结束了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative020"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "——此时萌生的点滴不和<br>\n渐渐膨胀得越来越明显。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative021"]}},
    {"op": "ResetText", "line": 264, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 265, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 266, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 267, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 268, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 269, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 271, "indent": 0, "params": {"BgmPath": "Bgm_26_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "因为太在意玛格的占卜结果，<br>\n汉娜对周围人的疑心越来越重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative022"]}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "她会不会是叛徒。<br>\n她一定在盘算着找机会杀人。<br>\n或许饭菜里都掺了毒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative023"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "一开始，艾玛和雪莉、甚至汉娜本人<br>\n都觉察到她有些轻微的被害妄想。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative024"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "有一次，汉娜的饭菜里真的混了一支针。<br>\n自从那件事以后，事态急转直下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative025"]}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "只要和谁对上了视线，她就怀疑对方恨自己。<br>\n叫嚷着下一个被杀害的就是自己——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative026"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "最终，凶杀案再次发生。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative027"]}},
    {"op": "ModifyBackgroundExtended", "line": 285, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "魔女审判开庭，少女们经过讨论<br>\n推导出了凶手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative028"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "艾玛发自内心痛苦般地报出了凶手的名字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "杀害奈叶香的凶手——<br>\n就是你吧，汉娜？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Ema021"]}},
    {"op": "HideAllCharacters", "line": 295, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 296, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised"}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "谁让她手里有枪呀！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna012"]}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "她一定在计划杀害我！<br>\n所以，我就先……！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Hanna013"]}},
    {"op": "HideAllCharacters", "line": 304, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "怎么会这样，汉娜……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Sherry012"]}},
    {"op": "HideAllCharacters", "line": 309, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 311, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 313, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 316, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "根据投票结果，罪名成立的汉娜被处决了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative030"]}},
    {"op": "PlaySfxModified", "line": 321, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 323, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "Wait", "line": 325, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 326, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "看着日复一日沉浸在哀伤中的艾玛和雪莉，<br>\n有位少女暗暗露出充满施虐心的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 330, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile"}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "（……可爱的小女孩们渐渐走向破灭的模样，<br>\n　实在是太美妙了……）", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Bad01_Margo016"]}},
    {"op": "ProcessBadEnd", "line": 338, "indent": 0, "params": {"Number": 9}}
  ],
  "translations": {
  "0102Bad01_Narrative001": "同意试试看。",
  "0102Bad01_Ema001": "机会难得，不如占卜看看……？",
  "0102Bad01_Margo001": "呵呵呵，就喜欢你这样的。",
  "0102Bad01_Narrative002": "看到玛格面露妖艳的微笑，汉娜不禁对她投来怀疑的目光。",
  "0102Bad01_Hanna001": "总感觉非常地可疑呢……",
  "0102Bad01_Margo002": "哎呀，可别这么说。放心吧。<br>\n就像我刚才说过的那样，我的占卜真的很准啦。",
  "0102Bad01_Sherry001": "可是，你的收费很贵吧？<br>\n我们都没有钱……",
  "0102Bad01_Margo003": "这个嘛……那就特别给你们首次优惠，<br>\n先欠着好了。<br>\n……不过我也不介意用身体支付哦♡",
  "0102Bad01_Narrative003": "玛格眯起眼睛，盯着艾玛等人。",
  "0102Bad01_Ema002": "用、用身体，是什么意思……？",
  "0102Bad01_Margo004": "呵呵，这个就任君想像了。",
  "0102Bad01_Hanna002": "等、等等艾玛！<br>\n还是别占卜比较好吧！？",
  "0102Bad01_Narrative004": "汉娜害怕地抱紧自己的身体。",
  "0102Bad01_Ema003": "也、也是……<br>\n抱歉玛格，我就不占卜了……",
  "0102Bad01_Margo005": "哎呀，现在可没法取消了哦。",
  "0102Bad01_Ema004": "欸？",
  "0102Bad01_Margo006": "因为我已经给你占卜了嘛。",
  "0102Bad01_Narrative005": "玛格小声笑着<br>\n把三张塔罗牌摆在桌上。",
  "0102Bad01_Margo007": "三张牌分别代表过去、现在和未来。<br>\n首先是第一张。过去是……【塔】的正位。<br>\n这个结果好像和之前一样呢。",
  "0102Bad01_Narrative006": "艾玛和雪莉看向彼此。",
  "0102Bad01_Ema005": "我相信不会发生凶杀案的。",
  "0102Bad01_Narrative007": "玛格拿出一张牌，<br>\n放在了艾玛和雪莉面前。",
  "0102Bad01_Margo008": "【塔】的正位。<br>\n……在不久的将来，会有某个人死去。",
  "0102Bad01_Narrative008": "确实和之前是同一张牌。",
  "0102Bad01_Ema006": "（在那之后真的发生了案件，诺亚她……<br>\n　我也不想相信，但她可能真的预测中了）",
  "0102Bad01_Margo009": "第二张牌代表着现在……【月亮】的正位。<br>\n这张牌的意思是……<br>\n对无法预知的危险和望不到头的现状而感到不安。",
  "0102Bad01_Margo010": "不觉得这正是现在的我们吗？",
  "0102Bad01_Ema007": "（好像，是这样……）",
  "0102Bad01_Narrative009": "会不会再次发生案件。<br>\n谁又会杀谁，谁会被处刑。<br>\n毫无疑问，大家都被笼罩在这些不安当中。",
  "0102Bad01_Margo011": "最后一张牌代表的是未来。<br>\n……【恶魔】的正位。",
  "0102Bad01_Hanna003": "只能让人联想到不好的事情。",
  "0102Bad01_Narrative010": "见汉娜愁眉苦脸的样子，玛格点点头。",
  "0102Bad01_Margo012": "很遗憾，确实如此。<br>\n失去朋友、背叛、憎恨、嫉妒、破灭……<br>\n这张牌的正位有很多负面的意思。",
  "0102Bad01_Ema008": "破灭……",
  "0102Bad01_Narrative011": "艾玛一脸严肃的嘟哝道，玛格见此便耸耸肩说。",
  "0102Bad01_Margo013": "如果让你感到不安了，先说声抱歉。<br>\n但这并不意味一定会迎来这样的未来。<br>\n也可以把它当做一种警告。",
  "0102Bad01_Margo014": "根据你今后的行动，<br>\n或许……未来也会被改变。",
  "0102Bad01_Ema009": "玛格……嗯，你说得对！<br>\n谢谢你！我们会加油的！",
  "0102Bad01_Margo015": "呵呵，好啊……加油吧。",
  "0102Bad01_Narrative012": "玛格的占卜结束后，艾玛等人便离开房间。",
  "0102Bad01_Ema010": "（虽然说要加油，<br>\n　但我还是很在意占卜的结果……）",
  "0102Bad01_Ema011": "（背叛……<br>\n　是指我们当中的某个人会背叛吗）",
  "0102Bad01_Narrative013": "艾玛瞥了一眼雪莉和汉娜。",
  "0102Bad01_Ema012": "（如果她们两人……<br>\n　不要，我不想考虑这种可能）",
  "0102Bad01_Sherry002": "艾玛，你怎么了？",
  "0102Bad01_Narrative014": "雪莉注意到艾玛的视线，便问道。",
  "0102Bad01_Hanna004": "艾玛，你也在想那个占卜结果吗？",
  "0102Bad01_Ema013": "……这么说，你也是？",
  "0102Bad01_Hanna005": "我觉得过去和现在都占卜得很准，<br>\n所以……",
  "0102Bad01_Ema014": "嗯，是啊。<br>\n就是感觉忘不掉……",
  "0102Bad01_Narrative015": "玛格的话里有着奇妙的说服力——<br>\n令人不禁去想她所说的可能。",
  "0102Bad01_Sherry003": "嗯……可是再怎么想<br>\n也没有意义吧？",
  "0102Bad01_Ema015": "欸，雪莉你不在意那个吗？",
  "0102Bad01_Sherry004": "说实话，我觉得玛格的占卜<br>\n跟巴纳姆效应差不多吧。",
  "0102Bad01_Hanna006": "巴纳……那是什么……？",
  "0102Bad01_Sherry005": "大概就是罗列一些和现在的情况<br>\n比较贴切的内容……",
  "0102Bad01_Sherry006": "比如【在不久的将来有人会死】这个占卜结果……<br>\n其实在当时的情况下，大家肯定<br>\n都感到很不安吧？",
  "0102Bad01_Narrative016": "突然被关进监狱，二阶堂希罗死亡，<br>\n紧接着又通告了凶杀案和魔女审判的事。<br>\n无论是谁，都会感到害怕吧。",
  "0102Bad01_Ema016": "这么一说，也是……",
  "0102Bad01_Sherry007": "刚才的占卜也一样。<br>\n所谓望不到头的未来，只是明摆着的事实！",
  "0102Bad01_Sherry008": "关于未来的占卜结果也是，以我们现在的情况，<br>\n会去相信那些<br>\n煽动不安的内容也不奇怪啦！",
  "0102Bad01_Ema017": "雪莉你好厉害！<br>\n不愧是名侦探！",
  "0102Bad01_Sherry009": "欸嘿！所以呢，<br>\n还是别太在意那些东西比较好啦。",
  "0102Bad01_Hanna007": "唉～真是个头脑简单的女人……",
  "0102Bad01_Narrative017": "与赞同雪莉的艾玛不同，<br>\n汉娜无奈地叹了口气。",
  "0102Bad01_Hanna008": "也许她的魔法就是占卜呢？<br>\n比如说她用塔罗牌占卜的结果一定会实现！",
  "0102Bad01_Sherry010": "唔～这个思维太跳跃了吧？",
  "0102Bad01_Ema018": "而且她本人好像否定过<br>\n这个说法……",
  "0102Bad01_Narrative018": "雪莉问玛格的时候，<br>\n玛格明确否定了。",
  "0102Bad01_Hanna009": "你们该不会就这么信了吧！？",
  "0102Bad01_Narrative019": "汉娜的脸上露出不敢置信的表情。",
  "0102Bad01_Ema019": "是、是啊，我没感觉有什么问题……",
  "0102Bad01_Hanna010": "你们是有多善良啊……<br>\n不对，难道她的魔法是让人相信谎言……？",
  "0102Bad01_Sherry011": "什么事都要扯到魔法的话<br>\n可就没完没了了哦。",
  "0102Bad01_Hanna011": "但是可能性还是有的吧！？",
  "0102Bad01_Ema020": "（咦……？怎么感觉<br>\n　空气里有点火药味？）",
  "0102Bad01_Narrative020": "在这略显尴尬的氛围里，她们没能商量越狱计划的事，<br>\n放风时间就这样结束了。",
  "0102Bad01_Narrative021": "——此时萌生的点滴不和<br>\n渐渐膨胀得越来越明显。",
  "0102Bad01_Narrative022": "因为太在意玛格的占卜结果，<br>\n汉娜对周围人的疑心越来越重。",
  "0102Bad01_Narrative023": "她会不会是叛徒。<br>\n她一定在盘算着找机会杀人。<br>\n或许饭菜里都掺了毒。",
  "0102Bad01_Narrative024": "一开始，艾玛和雪莉、甚至汉娜本人<br>\n都觉察到她有些轻微的被害妄想。",
  "0102Bad01_Narrative025": "有一次，汉娜的饭菜里真的混了一支针。<br>\n自从那件事以后，事态急转直下。",
  "0102Bad01_Narrative026": "只要和谁对上了视线，她就怀疑对方恨自己。<br>\n叫嚷着下一个被杀害的就是自己——",
  "0102Bad01_Narrative027": "最终，凶杀案再次发生。",
  "0102Bad01_Narrative028": "魔女审判开庭，少女们经过讨论<br>\n推导出了凶手。",
  "0102Bad01_Narrative029": "艾玛发自内心痛苦般地报出了凶手的名字。",
  "0102Bad01_Ema021": "杀害奈叶香的凶手——<br>\n就是你吧，汉娜？",
  "0102Bad01_Hanna012": "谁让她手里有枪呀！",
  "0102Bad01_Hanna013": "她一定在计划杀害我！<br>\n所以，我就先……！！",
  "0102Bad01_Sherry012": "怎么会这样，汉娜……",
  "0102Bad01_Narrative030": "根据投票结果，罪名成立的汉娜被处决了。",
  "0102Bad01_Narrative031": "看着日复一日沉浸在哀伤中的艾玛和雪莉，<br>\n有位少女暗暗露出充满施虐心的微笑。",
  "0102Bad01_Margo016": "（……可爱的小女孩们渐渐走向破灭的模样，<br>\n　实在是太美妙了……）"
}
}
