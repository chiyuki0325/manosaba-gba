    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "然而，<br>\n那里已经空无一人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "（奈叶香……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Ema010"]}},
