    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "她从树丛间隐隐瞥见了奈叶香的身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Narrative006"]}},
