    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "——她觉得自己很可怕，<br>\n所以才总是呆在水边。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Nanoka001"]}},
