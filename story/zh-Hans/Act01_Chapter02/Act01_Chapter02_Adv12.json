    {"op": "Wait", "line": 58, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "奈叶香的身影立马消失了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "奈叶香！你听我说——！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Ema004"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "米莉亚不是幕后黑手！<br>\n她是个很好的女孩，不，是个很好的人！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "安安和可可<br>\n都特别黏着她。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Ema006"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "不只是她们。<br>\n米莉亚拯救了我们所有人！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Ema007"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "求求你，不要再盯着米莉亚的性命<br>\n不放了！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Ema008"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "和我们一起<br>\n离开这里吧！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Ema009"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "……我的目的不是离开这里。<br>\n无论是搭上这条命，还是要化身魔女，<br>\n我都要完成复仇——", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv12_Nanoka002"]}},
    {"op": "HideAllCharacters", "line": 80, "indent": 0, "params": {"Lazy": 0}},
