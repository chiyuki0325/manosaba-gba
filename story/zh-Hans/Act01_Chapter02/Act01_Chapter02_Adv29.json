{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter02/Act01_Chapter02_Adv29",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-29", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "19_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "哈啊、哈啊、哈啊……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "闭庭后，<br>\n奈叶香立马又逃出监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative001"]}},
    {"op": "PlaySfxModified", "line": 21, "indent": 0, "params": {"SfxPath": "Sfx_55", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "……呼。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "她跳进附近的树丛里，隐身于黑暗之中，<br>\n终于调整好呼吸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative002"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "这里非常安静。<br>\n紧接着，大脑里就混进了多余的思绪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative003"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "她的脑海里不经意间浮现出<br>\n触碰米莉亚尸体时幻视的画面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative004"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "那次幻视的景象比以前看到的更加鲜明，<br>\n也更加漫长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative005"]}},
    {"op": "HidePrinter", "line": 33, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 34, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 35, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "穿着松垮西装的男人<br>\n是一家个人律所的律师。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative006"]}},
    {"op": "PlayBgm", "line": 39, "indent": 0, "params": {"BgmPath": "Bgm_41_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "那天，为不雅照流出事件而烦恼的米莉亚来找他商量此事，<br>\n商谈结束后夜已经深了，男人便决定把米莉亚送回家。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative007"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "在回家的路上，<br>\n米莉亚告诉他“我有能与人交换身体的魔法”。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative008"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "她说，小时候发现这个魔法时曾经使用过一次，<br>\n但自那以后，她就害怕得再也不敢用了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative009"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "——啊，你看起来不相信呢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative010"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "——但我说的是真的哦。我能使用魔法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative011"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "憔悴不堪的米莉亚露出了淡淡的微笑。<br>\n男人见此终于也松了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative012"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "但就在这时，米莉亚无意间瞥了一眼手机，<br>\n发出悲痛的惨叫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative013"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "黑暗充斥着整个手机屏幕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative014"]}},
    {"op": "ModifyBackgroundExtended", "line": 57, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "220_1"}},
    {"op": "ModifyBackgroundExtended", "line": 58, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 59, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "米莉亚说，<br>\n她不想活下去了——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative015"]}},
    {"op": "PlaySfxModified", "line": 64, "indent": 0, "params": {"SfxPath": "Sfx_40", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "她想冲到道闸对面，<br>\n男人拼尽全力拉住她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative016"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "——放开我……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative017"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "——求求你了，让我死吧！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative018"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "被抓住手腕的米莉亚抽泣着，放声喊道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative019"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "为了阻止米莉亚自杀，<br>\n男人急切地恳求道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative020"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "——可以把你的身子给叔叔吗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative021"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "他破罐子破摔地提出交换身体的主意，<br>\n竟得到了米莉亚的同意——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative022"]}},
    {"op": "PlaySfxModified", "line": 81, "indent": 0, "params": {"SfxPath": "Sfx_54", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HidePrinter", "line": 83, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 84, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 86, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "——哈哈，真的换过来了……！<br>\n——叔叔变成你了！<br>\n——厉害，真厉害啊……！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative023"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "男人和米莉亚聊了一阵子彼此的情况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative024"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "——在交换身体的这段时间，<br>\n——我会尽自己所能解决你的问题。<br>\n——我好歹也是个律师，相信我吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative025"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "——这段时间你就用叔叔的身体，休息一阵子。<br>\n——我有存款，你就放心吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative026"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "——不过，我看你是个善良体贴的好孩子。<br>\n——永远躲在叔叔的身体里<br>\n——你肯定无法得到幸福。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative027"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "——所以，可以答应叔叔一件事吗？<br>\n——等你有勇气面对现实的时候……我们再见面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative028"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "————然后回到各自的身体里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative029"]}},
    {"op": "ModifyBackgroundExtended", "line": 102, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "19_2"}},
    {"op": "ModifyBackgroundExtended", "line": 103, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 104, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "StopSfx", "line": 106, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "米莉亚和男人互换过半年左右的时间，<br>\n但他们已经回到了各自的身体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative030"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "奈叶香感到一阵眩晕，忍不住单膝跪地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative031"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "你们居然已经交换回去了……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "你好歹解释一下啊……<br>\n我简直犯了个大错——", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "佐伯米莉亚，就是真正的米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative032"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "她一定不想把内心的创伤告诉任何人，<br>\n也不想让任何人过问，只将真相牢牢锁在心底。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative033"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "她之所以表现得像大叔一样，<br>\n大概是因为她还不愿意接纳自己就是真正的米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative034"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "即使奈叶香想道歉，<br>\n道歉的对象也已经不在世上了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative035"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "奈叶香的脸皱作一团，几乎要哭出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative036"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "（后悔也没用。<br>\n　现在，我只能行动起来——）", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Nanoka005"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "奈叶香再次动身，<br>\n走向她的藏身地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative037"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "她蹑手蹑脚地来到监牢后方，<br>\n正当她准备开门的时候——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative038"]}},
    {"op": "PlaySfxModified", "line": 133, "indent": 0, "params": {"SfxPath": "Sfx_55", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HidePrinter", "line": 135, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 136, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 137, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 138, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [28.0, 36.0], "AppearanceAndTransition": "19_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 139, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 20.0], "IdAndAppearance": "Nanoka.Default", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 141, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Nanoka-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 142, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "25", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 143, "indent": 0, "params": {"ActorIds": ["Nanoka-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 144, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "谁！？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Nanoka006"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "奈叶香感到树丛那边有人走了过来，<br>\n便猛地回过头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative039"]}},
    {"op": "HideActors", "line": 150, "indent": 0, "params": {"ActorIds": ["Nanoka-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 151, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 152, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 153, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "这里无比黑暗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative040"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "只有从树林间隙透过的微弱月光<br>\n照亮了奈叶香。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative041"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "现在是少女们的禁止外出时间。<br>\n奈叶香眼里带着十二分的警惕，<br>\n架好手里的枪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative042"]}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "等了一会，<br>\n看守来到奈叶香的面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative043"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "…………", "AuthorId": "Jailer", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Jailer001"]}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "即便看到奈叶香，看守也无动于衷，<br>\n直接默不作声地离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative044"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "这已经不知是第几次放过她了。<br>\n奈叶香自嘲地笑了笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative045"]}},
    {"op": "PlaySfxModified", "line": 174, "indent": 0, "params": {"SfxPath": "Sfx_62", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 176, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 177, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "black", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 178, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 180, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "24_1"}},
    {"op": "ModifyBackgroundExtended", "line": 181, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 182, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "她走进藏身地，<br>\n头靠在门上自言自语道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Narrative046"]}},
    {"op": "ModifyCharacterExtended", "line": 186, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "我迟早会变成“那边”的人。等我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv29_Nanoka007"]}},
    {"op": "SetCustomVariable", "line": 198, "indent": 0, "params": {"Expression": "g_gameProgress = max(3, g_gameProgress)"}},
    {"op": "Gosub", "line": 199, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 201, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv01", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv29_Nanoka001": "哈啊、哈啊、哈啊……",
  "0102Adv29_Narrative001": "闭庭后，<br>\n奈叶香立马又逃出监牢。",
  "0102Adv29_Nanoka002": "……呼。",
  "0102Adv29_Narrative002": "她跳进附近的树丛里，隐身于黑暗之中，<br>\n终于调整好呼吸。",
  "0102Adv29_Narrative003": "这里非常安静。<br>\n紧接着，大脑里就混进了多余的思绪。",
  "0102Adv29_Narrative004": "她的脑海里不经意间浮现出<br>\n触碰米莉亚尸体时幻视的画面。",
  "0102Adv29_Narrative005": "那次幻视的景象比以前看到的更加鲜明，<br>\n也更加漫长。",
  "0102Adv29_Narrative006": "穿着松垮西装的男人<br>\n是一家个人律所的律师。",
  "0102Adv29_Narrative007": "那天，为不雅照流出事件而烦恼的米莉亚来找他商量此事，<br>\n商谈结束后夜已经深了，男人便决定把米莉亚送回家。",
  "0102Adv29_Narrative008": "在回家的路上，<br>\n米莉亚告诉他“我有能与人交换身体的魔法”。",
  "0102Adv29_Narrative009": "她说，小时候发现这个魔法时曾经使用过一次，<br>\n但自那以后，她就害怕得再也不敢用了。",
  "0102Adv29_Narrative010": "——啊，你看起来不相信呢。",
  "0102Adv29_Narrative011": "——但我说的是真的哦。我能使用魔法。",
  "0102Adv29_Narrative012": "憔悴不堪的米莉亚露出了淡淡的微笑。<br>\n男人见此终于也松了口气。",
  "0102Adv29_Narrative013": "但就在这时，米莉亚无意间瞥了一眼手机，<br>\n发出悲痛的惨叫。",
  "0102Adv29_Narrative014": "黑暗充斥着整个手机屏幕。",
  "0102Adv29_Narrative015": "米莉亚说，<br>\n她不想活下去了——",
  "0102Adv29_Narrative016": "她想冲到道闸对面，<br>\n男人拼尽全力拉住她。",
  "0102Adv29_Narrative017": "——放开我……",
  "0102Adv29_Narrative018": "——求求你了，让我死吧！",
  "0102Adv29_Narrative019": "被抓住手腕的米莉亚抽泣着，放声喊道。",
  "0102Adv29_Narrative020": "为了阻止米莉亚自杀，<br>\n男人急切地恳求道。",
  "0102Adv29_Narrative021": "——可以把你的身子给叔叔吗。",
  "0102Adv29_Narrative022": "他破罐子破摔地提出交换身体的主意，<br>\n竟得到了米莉亚的同意——",
  "0102Adv29_Narrative023": "——哈哈，真的换过来了……！<br>\n——叔叔变成你了！<br>\n——厉害，真厉害啊……！",
  "0102Adv29_Narrative024": "男人和米莉亚聊了一阵子彼此的情况。",
  "0102Adv29_Narrative025": "——在交换身体的这段时间，<br>\n——我会尽自己所能解决你的问题。<br>\n——我好歹也是个律师，相信我吧。",
  "0102Adv29_Narrative026": "——这段时间你就用叔叔的身体，休息一阵子。<br>\n——我有存款，你就放心吧。",
  "0102Adv29_Narrative027": "——不过，我看你是个善良体贴的好孩子。<br>\n——永远躲在叔叔的身体里<br>\n——你肯定无法得到幸福。",
  "0102Adv29_Narrative028": "——所以，可以答应叔叔一件事吗？<br>\n——等你有勇气面对现实的时候……我们再见面。",
  "0102Adv29_Narrative029": "————然后回到各自的身体里。",
  "0102Adv29_Narrative030": "米莉亚和男人互换过半年左右的时间，<br>\n但他们已经回到了各自的身体。",
  "0102Adv29_Narrative031": "奈叶香感到一阵眩晕，忍不住单膝跪地。",
  "0102Adv29_Nanoka003": "你们居然已经交换回去了……",
  "0102Adv29_Nanoka004": "你好歹解释一下啊……<br>\n我简直犯了个大错——",
  "0102Adv29_Narrative032": "佐伯米莉亚，就是真正的米莉亚。",
  "0102Adv29_Narrative033": "她一定不想把内心的创伤告诉任何人，<br>\n也不想让任何人过问，只将真相牢牢锁在心底。",
  "0102Adv29_Narrative034": "她之所以表现得像大叔一样，<br>\n大概是因为她还不愿意接纳自己就是真正的米莉亚。",
  "0102Adv29_Narrative035": "即使奈叶香想道歉，<br>\n道歉的对象也已经不在世上了。",
  "0102Adv29_Narrative036": "奈叶香的脸皱作一团，几乎要哭出来。",
  "0102Adv29_Nanoka005": "（后悔也没用。<br>\n　现在，我只能行动起来——）",
  "0102Adv29_Narrative037": "奈叶香再次动身，<br>\n走向她的藏身地。",
  "0102Adv29_Narrative038": "她蹑手蹑脚地来到监牢后方，<br>\n正当她准备开门的时候——",
  "0102Adv29_Nanoka006": "谁！？",
  "0102Adv29_Narrative039": "奈叶香感到树丛那边有人走了过来，<br>\n便猛地回过头。",
  "0102Adv29_Narrative040": "这里无比黑暗。",
  "0102Adv29_Narrative041": "只有从树林间隙透过的微弱月光<br>\n照亮了奈叶香。",
  "0102Adv29_Narrative042": "现在是少女们的禁止外出时间。<br>\n奈叶香眼里带着十二分的警惕，<br>\n架好手里的枪。",
  "0102Adv29_Narrative043": "等了一会，<br>\n看守来到奈叶香的面前。",
  "0102Adv29_Jailer001": "…………",
  "0102Adv29_Narrative044": "即便看到奈叶香，看守也无动于衷，<br>\n直接默不作声地离开了。",
  "0102Adv29_Narrative045": "这已经不知是第几次放过她了。<br>\n奈叶香自嘲地笑了笑。",
  "0102Adv29_Narrative046": "她走进藏身地，<br>\n头靠在门上自言自语道。",
  "0102Adv29_Nanoka007": "我迟早会变成“那边”的人。等我。"
}
}
