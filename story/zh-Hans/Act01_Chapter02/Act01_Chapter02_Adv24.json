    {"op": "DestroySpawnedExtended", "line": 52, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "咦，我的手机……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema004"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "你洗澡的时候丢在这里了吧。<br>\n就放在你的衣柜里。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa003"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "呃、嗯，可能是。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema005"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "你小心点啊。要是放进衣服里没拿出来<br>\n可就要弄丢了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa004"]}},
    {"op": "HideAllCharacters", "line": 66, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "淋浴房的衣柜里<br>\n每天都会放进全新的囚服和内衣。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative004"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "旧衣服必须扔进<br>\n垃圾滑槽丢掉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative005"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "（好险……我记得衣服会被烧掉吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "顺便一提，所有人的衣柜我都检查了一遍，<br>\n今天大家应该都洗过澡了。<br>\n除了佐伯的柜子以外都是空的。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa005"]}},
    {"op": "HideAllCharacters", "line": 78, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "是吗……除此以外你还发现了什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema007"]}},
    {"op": "HideAllCharacters", "line": 83, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "亚里沙不甘心地摇摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmL4"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "什么都没有……该死。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa006"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL4"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "我头脑不好，怎么可能知道凶手是谁！<br>\n凭什么非要叫我们找凶手！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa007"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "这不是让我们把彼此当敌人吗！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa008"]}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "那悲痛的呐喊听得艾玛咬紧了嘴唇。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative007"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "（亚里沙说得没错……<br>\n　为什么一定得怀疑别人……？<br>\n　这样是不对的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema008"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "亚里沙正怒上心头，<br>\n艾玛没法再和她继续对话，便离开了淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative008"]}},
