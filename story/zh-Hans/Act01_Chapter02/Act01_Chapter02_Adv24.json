    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛想到去淋浴房看看，<br>\n是因为她在找能冲水的地方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（凶手刺杀米莉亚的时候<br>\n　应该被溅到了血）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（哪怕没有被溅一身，<br>\n　至少手上肯定有沾到）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（凶手一定得洗掉血迹，<br>\n　所以她应该去过淋浴房——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Ema003"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "艾玛走进去一看，<br>\n只见亚里沙在翻看淋浴房的衣柜，<br>\n她大概也作出了同样的推测。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "啊，樱羽，你来得正好。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 38, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "亚里沙看到艾玛来了，便走过去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "我检查了一遍所有囚犯的衣柜。<br>\n然后发现了这个，看。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv24_Alisa002"]}},
    {"op": "SpawnExtended", "line": 50, "indent": 0, "params": {"Path": "Clue", "Params": ["2-7"]}},
