    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（第二次的……魔女审判……<br>\n　这无言的氛围……好沉重……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Fearful1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "……又要来什么审判……！？<br>\n我已经受够互相猜疑了……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Smile1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "那你可以不用逼着自己参加呀？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Normal1,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Middle"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "只要你不介意缺席审判……<br>\n就是了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Margo002"]}},
    {"op": "PlaySfxModified", "line": 82, "indent": 0, "params": {"SfxPath": "Sfx_Common_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Fearful1,ArmR3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "这、这……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Hanna002"]}},
