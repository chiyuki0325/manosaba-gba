    {"op": "Wait", "line": 95, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "别担心！<br>\n这次我们也一定能找到真凶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Sherry001"]}},
