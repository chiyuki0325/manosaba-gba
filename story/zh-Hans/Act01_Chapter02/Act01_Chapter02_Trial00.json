    {"op": "Wait", "line": 105, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PlaySfxModified", "line": 108, "indent": 0, "params": {"SfxPath": "Sfx_Common_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "我不是在担心<br>\n找不找得到真凶……！<br>\n我是说这样子的审判根本就……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Hanna003"]}},
    {"op": "HidePerspectiveStageScreen", "line": 113, "indent": 0, "params": {"Index": 1, "Reset": 1}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Angry_Closed1,Mouth1_Pensive_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 117, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "……既然没有什么担心的，<br>\n那赶快开始讨论吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Flushed_Open1,Mouth1_Pensive_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 122, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "我们能作出的选择<br>\n并不多。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Nanoka002"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Normal1,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 127, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "啧……<br>\n这么疯狂的事你们居然还想若无其事地继续下去，<br>\n正常人也剩得不多了……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1,ArmR7,ArmL5,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 132, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "你这白莲花言论够了没～<br>\n明明只是承压能力差胆子小，<br>\n可以别说得那么冠冕堂皇吗～？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open03"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 137, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "你说什么……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Alisa002"]}},
    {"op": "PlaySfxModified", "line": 141, "indent": 0, "params": {"SfxPath": "Sfx_Common_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Fearful,ArmR1_2,ArmL5,Eyes2_Surprised_Open1,Mouth2_Normal_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 145, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "各、各位……！<br>\n再这样争论下去，恐怕会影响到之后的<br>\n讨论环节……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-,ArmR-Option-Off,Angle01/Arms>Arms01,Angle01/Option_Arms>Option_Arms01_03,Angle01/Head/Facial/Eyes>Eyes_Normal_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 149, "indent": 0, "params": {"Index": 0, "LookCharacterId": "AnAn", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "『与其说讨论，更像是厮杀。<br>\n　所以没有影响』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_AnAn001"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Normal1,ArmR2,ArmL5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 153, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "确实，安安说得没错。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Margo003"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Smile1,ArmR2,ArmL5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 157, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "毕竟这场讨论<br>\n可是赌上了我们的性命……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Margo004"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL6,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 161, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "（大家都好紧张……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 165, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "（……已经是第二个同伴被杀了，<br>\n　而且我们当中还有个杀人犯，<br>\n　这也难怪……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 168, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Flushed_Open1,Mouth1_Pensive_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 169, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "……首先我们来理一理<br>\n案件的来龙去脉吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Nanoka003"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Closed01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 173, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "对啊！<br>\n如果我们连前提都不一致的话，<br>\n根本无法讨论下去嘛！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Normal1,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 177, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "也行啊？<br>\n可能有人还没见过惩罚室里是什么样吧。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 181, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "……比如那具伤痕累累的尸体。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Fearful1,ArmR3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 186, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "呜……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR3,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 190, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "既然说到尸体，<br>\n那我们就从尸体的状况说起吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 194, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "（……凶手……居然就在我们当中……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Ema004"]}},
    {"op": "StopBgm", "line": 197, "indent": 0, "params": {"FadeOutDuration": 5.0}},
    {"op": "ResetText", "line": 199, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Surprised_Open2"}},
    {"op": "GosubToSplitPerspectiveStageScreens", "line": 201, "indent": 0, "params": {"Index": 1, "LookCharacterId": "Meruru", "Composition": "Left", "RollDirection": "Right"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "……艾玛小姐。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "怎、怎么了……？<br>\n梅露露……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.ArmR1_2,ArmL5,Eyes2_Downcast_Open1,Mouth2_Normal_Open1"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "我想谁都不愿意<br>\n从我们当中找出魔女……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Smile1,ArmR1_1,ArmL1,Eyes1_Smile_Closed1,Mouth1_Smile_Closed1"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "但是……要加油……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "……嗯！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Ema006"]}},
    {"op": "HidePerspectiveStageScreen", "line": 216, "indent": 0, "params": {"Index": 1, "Reset": 1, "Wait": 1}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Determined2,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "（就当是为了米莉亚……<br>\n　我得努力才行！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial00_Ema007"]}},
    {"op": "ResetText", "line": 221, "indent": 0, "params": {}},
    {"op": "GotoModified", "line": 223, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Trial01", "ResetState": ["-"]}}
  ],
  "translations": {
  "0102Trial00_Ema001": "（第二次的……魔女审判……<br>\n　这无言的氛围……好沉重……）",
  "0102Trial00_Hanna001": "……又要来什么审判……！？<br>\n我已经受够互相猜疑了……！",
  "0102Trial00_Margo001": "那你可以不用逼着自己参加呀？",
  "0102Trial00_Margo002": "只要你不介意缺席审判……<br>\n就是了。",
  "0102Trial00_Hanna002": "这、这……",
  "0102Trial00_Sherry001": "别担心！<br>\n这次我们也一定能找到真凶！",
  "0102Trial00_Hanna003": "我不是在担心<br>\n找不找得到真凶……！<br>\n我是说这样子的审判根本就……！",
  "0102Trial00_Nanoka001": "……既然没有什么担心的，<br>\n那赶快开始讨论吧。",
  "0102Trial00_Nanoka002": "我们能作出的选择<br>\n并不多。",
  "0102Trial00_Alisa001": "啧……<br>\n这么疯狂的事你们居然还想若无其事地继续下去，<br>\n正常人也剩得不多了……",
  "0102Trial00_Coco001": "你这白莲花言论够了没～<br>\n明明只是承压能力差胆子小，<br>\n可以别说得那么冠冕堂皇吗～？",
  "0102Trial00_Alisa002": "你说什么……",
  "0102Trial00_Meruru001": "各、各位……！<br>\n再这样争论下去，恐怕会影响到之后的<br>\n讨论环节……",
  "0102Trial00_AnAn001": "『与其说讨论，更像是厮杀。<br>\n　所以没有影响』",
  "0102Trial00_Margo003": "确实，安安说得没错。",
  "0102Trial00_Margo004": "毕竟这场讨论<br>\n可是赌上了我们的性命……",
  "0102Trial00_Ema002": "（大家都好紧张……）",
  "0102Trial00_Ema003": "（……已经是第二个同伴被杀了，<br>\n　而且我们当中还有个杀人犯，<br>\n　这也难怪……）",
  "0102Trial00_Nanoka003": "……首先我们来理一理<br>\n案件的来龙去脉吧。",
  "0102Trial00_Sherry002": "对啊！<br>\n如果我们连前提都不一致的话，<br>\n根本无法讨论下去嘛！",
  "0102Trial00_Coco002": "也行啊？<br>\n可能有人还没见过惩罚室里是什么样吧。",
  "0102Trial00_Coco003": "……比如那具伤痕累累的尸体。",
  "0102Trial00_Hanna004": "呜……",
  "0102Trial00_Sherry003": "既然说到尸体，<br>\n那我们就从尸体的状况说起吧！",
  "0102Trial00_Ema004": "（……凶手……居然就在我们当中……）",
  "0102Trial00_Meruru002": "……艾玛小姐。",
  "0102Trial00_Ema005": "怎、怎么了……？<br>\n梅露露……",
  "0102Trial00_Meruru003": "我想谁都不愿意<br>\n从我们当中找出魔女……",
  "0102Trial00_Meruru004": "但是……要加油……！",
  "0102Trial00_Ema006": "……嗯！",
  "0102Trial00_Ema007": "（就当是为了米莉亚……<br>\n　我得努力才行！）"
}
}
