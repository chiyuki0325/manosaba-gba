{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter02/Act01_Chapter02_Adv18",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-18", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "此刻，所有少女都集合在会客厅。<br>\n没有人敢违反规定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "大家的眼神都晦暗无光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "听到米莉亚遇害的消息，<br>\n没有亲眼看到现场的玛格和亚里沙<br>\n也摆出了不愿面对现实的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "听说米莉亚遇害了，<br>\n是真的吗……？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "是真的，我们亲眼看到了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Hanna001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "能明显看出是他杀吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "应该，是这样的……<br>\n她被绑着不能动，而且如果不是他杀的话，<br>\n尸体情况也不至于……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 36, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "玛格忧郁地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "这样啊……那就意味着，<br>\n要举行魔女审判了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo003"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "搞什么审判啊真没劲。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Coco001"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "就算那个大叔被杀了<br>\n又怎么样？反正她背叛了我们。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL7"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "闭嘴吧臭女人。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1,ArmR3,ArmL2"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "嘴上装着不饶人，其实就是小太妹你干的吧～？<br>\n热气球被毁掉你超级生气的吧？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Coco003"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "再说我就真把你烧了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR2"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "要说热气球被毁掉的怨恨，大家应该都有吧。<br>\n哎呀，那就是说<br>\n所有人都有杀害米莉亚的动机吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo004"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "我才不会因为这点事情杀人！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Hanna002"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "即将转变为魔女的人会被杀意迷惑，<br>\n这谁说得清楚呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo005"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "（气氛变得剑拔弩张起来了……<br>\n　这也难怪，因为有人杀了米莉亚）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema001"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "（再不找出凶手，<br>\n　我们也要被处刑）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema002"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "（大家都在互相怀疑，<br>\n　猜测谁是凶手）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema003"]}},
    {"op": "HideAllCharacters", "line": 80, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "艾玛好不容易搭建起来的友情和信任<br>\n眼看着就要轻易地崩塌了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative005"]}},
    {"op": "PlaySfxModified", "line": 85, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "这时，随着天花板边上传来一阵翅膀拍动的声音，<br>\n典狱长现身了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "唉……凶杀案……<br>\n还是发生了……而且还是在大晚上……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Warden001"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "建议你们尽快开始搜查吧。<br>\n这次是特殊处理，<br>\n会在今晚0点举行【魔女审判】。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Warden002"]}},
    {"op": "HideAllCharacters", "line": 95, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "哈！？那不是只剩一个半小时了！<br>\n你在搞笑吗！？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Coco004"]}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "你有意见归有意见……<br>\n可我也是在加班啊。<br>\n再晚我就等不了了……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Warden003"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "请各位务必从在场的囚犯之中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑……<br>\n还有就是老规矩，如果无法锁定凶手，所有人都要接受处刑。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Warden004"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "虽然现在是禁止外出时间，但搜查期间允许自由出入。<br>\n那么，请各位努力找出凶手吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Warden005"]}},
    {"op": "PlaySfxModified", "line": 110, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "啊，等下……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema004"]}},
    {"op": "HideAllCharacters", "line": 117, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "典狱长自顾自把话说完<br>\n就飞走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative007"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "而一众少女则不知所措地愣在原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "（一小时内查明杀害米莉亚的凶手……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema005"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "（怎么可能做得到！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema006"]}},
    {"op": "HideAllCharacters", "line": 129, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "……现在唯一确定的是，<br>\n米莉亚不是幕后黑手对吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Sherry001"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "之前因为她扰乱了越狱计划，<br>\n我们就以为她真的是幕后黑手。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 136, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "是、是的……可这样一来，就越来越搞不懂<br>\n米莉亚捣乱的原因了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema007"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "总、总之快行动起来吧。<br>\n我们得好好搜查，找到杀害米莉亚的凶手。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema008"]}},
    {"op": "HideAllCharacters", "line": 143, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "就在艾玛刚准备跑去门口的时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative009"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "玛格挡在艾玛身前，把她拦住。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR6"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "玛格，你怎么了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema009"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "我有个提议，可以听一下吗。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo006"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "玛格打断了艾玛的话，她的声音从未如此铿锵有力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative011"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "艾玛，<br>\n你打算和雪莉她们一起搜查对吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo007"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "嗯、嗯，是这样没错。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema010"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "艾玛不自觉地依次看向雪莉、汉娜和梅露露。<br>\n她们都点了点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Angry1,ArmR5"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "可以不要这样做吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo008"]}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "欸，为什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema011"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "如果你们结盟的话，<br>\n会对你们团队以外的人来说<br>\n非常不利。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo009"]}},
    {"op": "HideAllCharacters", "line": 176, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "雪莉“啪”的一声拍了下手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR4,ArmL5"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "我知道了，操控投票！如果我们事先商量好的话，<br>\n就能够把特定人票选为凶手！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR5"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "雪莉，你脑袋转得还挺快的，我想说的就是这么一回事。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo010"]}},
    {"op": "HideAllCharacters", "line": 189, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "你竟然认为我们会做那种卑鄙无耻之事！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 194, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR5"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "我也不愿意这么想……<br>\n但你们团队外的人<br>\n肯定会很害怕吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo011"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "所以，为了公平起见，<br>\n希望你们不要一起搜查，而是分开搜查。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo012"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "请你们不要再结盟了，<br>\n好吗，艾玛。你明白我的意思吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo013"]}},
    {"op": "HideAllCharacters", "line": 203, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "在玛格压迫感十足的发言下，<br>\n艾玛难过地皱起眉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "（虽然玛格说得并没有错……<br>\n　可是……到头来她还是谁也不相信啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 211, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "知道了……我们分开搜查吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema013"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "不过，把得到的情报分享出去应该没关系吧？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Ema014"]}},
    {"op": "HideAllCharacters", "line": 217, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmR1"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "那当然，毕竟最重要的是查明凶手。<br>\n一起加油吧，艾玛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Margo014"]}},
    {"op": "HideAllCharacters", "line": 222, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "玛格莞尔一笑，<br>\n而艾玛却不敢直视她的脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative015"]}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "接着艾玛等人离开会客厅，<br>\n开始各自搜查。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv18_Narrative016"]}},
    {"op": "SetCustomVariable", "line": 228, "indent": 0, "params": {"Expression": "chosenAreaFlag = 0"}},
