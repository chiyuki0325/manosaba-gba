    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "艾玛来到二楼的娱乐室，<br>\n便发现安安在里面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "她静静地凝视着没有画面的银幕。<br>\n那侧脸看上去无比孤单。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "米莉亚和安安经常在这里<br>\n观看老电影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative003"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（我们再也见不到那温馨的场面了——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema001"]}},
