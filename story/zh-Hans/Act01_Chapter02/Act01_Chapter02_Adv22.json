    {"op": "Wait", "line": 64, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "艾玛大致搜查了一番，<br>\n但除此以外没发现什么别的东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "嗯——，这里好像什么都没有呢。<br>\n那我去其他——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema007"]}},
    {"op": "HideAllCharacters", "line": 72, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "艾玛刚朝门口转身，<br>\n她的裙摆就被拉了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative009"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "她回头一看，安安正一脸泫然欲泣的表情<br>\n抬头望着她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative010"]}},
