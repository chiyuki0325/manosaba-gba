    {"op": "Wait", "line": 54, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "接着，艾玛发现收纳柜上了锁<br>\n打不开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative006"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "（奇怪……这个柜子打不开啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema006"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "虽然她有点在意，<br>\n但打不开的话只能暂时放弃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative007"]}},
    {"op": "ResetText", "line": 62, "indent": 0, "params": {}},
