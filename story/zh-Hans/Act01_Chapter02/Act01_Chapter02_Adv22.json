    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "安安……你怎么了……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema008"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_AnAn002"]}},
