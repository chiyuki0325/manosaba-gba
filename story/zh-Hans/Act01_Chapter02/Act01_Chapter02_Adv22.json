    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "安安……你有发现什么线索吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "安安无力地摇了摇头，<br>\n举起素描本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "『还没有』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_AnAn001"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "我再去调查一下。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema003"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（米莉亚的放风时间<br>\n　大多是在这娱乐室度过的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema004"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "（说不定这里还留有什么线索）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Ema005"]}},
    {"op": "HideAllCharacters", "line": 48, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "艾玛和安安<br>\n分头在娱乐室搜查起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv22_Narrative005"]}},
    {"op": "ResetText", "line": 52, "indent": 0, "params": {}},
