  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-4", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "第二天下午的放风时间，<br>\n艾玛一行人又被玛格叫去了图书室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative001"]}},
    {"op": "HidePrinter", "line": 18, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 19, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["40", "200", "true", "0.3", "#000000"], "ScenePosition": [80.0, 50.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [45.0, 36.0], "AppearanceAndTransition": "12_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [80.0, 32.0], "IdAndAppearance": "Coco.Pensive1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 22, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Coco-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 23, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 24, "indent": 0, "params": {"ActorIds": ["Coco-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 25, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "米莉亚和安安，还有梅露露都没来。<br>\n不过可可倒是来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "可可坐在离其他人稍远的椅子上，<br>\n正无精打采地玩手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative003"]}},
    {"op": "HidePrinter", "line": 31, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 32, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Coco-Front"], "Loop": 0}},
    {"op": "AnimateActorExtended", "line": 33, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "44", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 34, "indent": 0, "params": {"ActorIds": ["Coco-Front"], "Loop": 0, "ScenePositionY": "48", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "HideActors", "line": 35, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Coco-Front"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 36, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 37, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "玛格，今天喊我们来图书室有什么事……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema001"]}},
    {"op": "HideAllCharacters", "line": 43, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmR1,ArmL4"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "呵呵呵，不用那么警惕。<br>\n今天我不是来推销的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "我翻了一圈图书室里的书，<br>\n找到本很有意思的书，<br>\n所以想给大家也看一看。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo002"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "（玛格虽然看起来悠哉游哉的……<br>\n　但说不定其实她行动力很强……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema002"]}},
    {"op": "HideAllCharacters", "line": 54, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "自从大家被抓到监狱以来，<br>\n玛格似乎是精力最充沛的那个，<br>\n她做的事也是最有意义的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative004"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "（也许玛格比我<br>\n　更适合做队长………）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema003"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "艾玛摇摇头，<br>\n赶走脑海中浮现的想法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative005"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "（现在想那么多也没有用……！<br>\n　好不容易争取到了玛格的协助）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "你说的是什么书？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema005"]}},
    {"op": "HideAllCharacters", "line": 68, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "就是这本。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo003"]}},
    {"op": "HideAllCharacters", "line": 73, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 76, "indent": 0, "params": {"SfxPath": "Sfx_42", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "玛格放在桌上的书<br>\n装帧豪华，十分厚重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "上面记载了有关魔女的知识。目前，<br>\n我只找到了这一本和魔女有关的书。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo004"]}},
    {"op": "HideAllCharacters", "line": 88, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "这样啊，让我看看。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 96, "indent": 0, "params": {"SfxPath": "Sfx_43", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "雪莉翻开书，哗啦啦的翻了起来。<br>\n这时汉娜却有些着急了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "可、可以请你不要那样粗暴地翻阅吗！？<br>\n书都要被你弄坏了哦！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 104, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Angry1,ArmR3"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "……你把我当成什么人了？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "不过话说回来，我看不懂这本书耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry003"]}},
    {"op": "StopBgm", "line": 113, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "艾玛也兴趣盎然地看起书来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative008"]}},
    {"op": "ModifyBackgroundExtended", "line": 118, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "510_1"}},
    {"op": "PlayBgm", "line": 120, "indent": 0, "params": {"BgmPath": "Bgm_36_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "呵呵呵。怎样？这文字很奇特吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo005"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "玛格，难道你能看得懂！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema006"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "不，我看不懂。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo006"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "玛格愉快地扑哧一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative009"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "但这本书里有很多图解。<br>\n所以我才知道书上写了和魔女有关的东西。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo007"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "你看，这张图画的<br>\n是不是我们的魔法。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo008"]}},
    {"op": "ResetText", "line": 134, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 135, "indent": 0, "params": {"Offset": [5.0, 3.5], "Zoom": 0.5, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 136, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "啊！真的耶！<br>\n这张画上的女孩有一点飘起来了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry004"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "那张老旧的插图<br>\n画有一位飘在空中的少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative010"]}},
    {"op": "ResetText", "line": 142, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 143, "indent": 0, "params": {"Offset": [5.0, -1.0], "Zoom": 0.5, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 144, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "而它旁边的那张画，<br>\n好像是一位少女在空中滑翔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative011"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "我就说很有意思吧？<br>\n能从中解读出我们的魔法会怎样进化。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo009"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "如果这本书的内容没错的话……<br>\n那我的魔法变强以后<br>\n就可以飞得更高了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Hanna002"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "等你的魔法变强<br>\n说不定能飞过围墙……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema007"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "汉娜和艾玛似乎寻觅到了一丝希望，<br>\n她们两眼放光地看向彼此。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative012"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "嗯……？可是，魔法变强的话，<br>\n也就意味着进一步魔女化吧……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry005"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "呃，说、说得也对……<br>\n我可不想变成【残骸】……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Hanna003"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "不仅会加重杀意，还会危及我们的生命。<br>\n这可不是个好主意。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo010"]}},
    {"op": "ResetText", "line": 162, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 163, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 164, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "还是不行啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema008"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "艾玛感到很失落，<br>\n她想找到新的线索，<br>\n目光又回到书上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative013"]}},
    {"op": "ResetText", "line": 170, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 171, "indent": 0, "params": {"Offset": [-4.0, 1.0], "Zoom": 0.4000000059604645, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 172, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "这时她看见一幅图解。图画上，众多魔女手牵手围在一起，<br>\n而一名威严十足的魔女正在降临。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative014"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "这个人，是不是类似于魔女的领袖……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema009"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "恐怕是的。<br>\n在常见的传说中，魔女也都是有领袖的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo011"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "统治所有魔女的领袖——【大魔女】。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo012"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "这幅图解是【<ruby=\"Sabbath\">魔女的安息日</ruby>】吗？<br>\n看起来像是魔女们在召唤大魔女。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo013"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "如果能解读出文字的话，<br>\n就能知道更详细的内容了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo014"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "（大魔女……难道那就是幕后黑手……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema010"]}},
    {"op": "ResetText", "line": 188, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 189, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 190, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "艾玛的脑海中浮现出<br>\n米莉亚的身影。<br>\n她连忙甩开这个念头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative015"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "（只是奈叶香怀疑她而已，<br>\n　米莉亚也不一定就是幕后黑手）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema011"]}},
    {"op": "HideActors", "line": 196, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "StopBgm", "line": 198, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "玛格叹了口气将书合上，<br>\n看向艾玛她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "我想和大家商量的就是，<br>\n虽然汉娜的魔法没法指望，<br>\n不过我们也许可以用其他魔法越狱。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo015"]}},
    {"op": "PlayBgm", "line": 207, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "对哦……！<br>\n我们再确认一遍各自的魔法吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 211, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "呃，抱歉……我连自己的魔法<br>\n都搞不清楚是什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema013"]}},
    {"op": "HideAllCharacters", "line": 215, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "雪莉举起手，劲头十足地抢先发言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 219, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR16"}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "我的魔法是怪力！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 223, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "但那堵围墙可能是施了什么魔法，<br>\n连我的能力都无法破坏，<br>\n也没办法爬上去。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry007"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "玛格你的魔法是什么呢！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 229, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "玛格轻轻吐了口气，耸耸肩说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "我可以自由变换自己的声音。<br>\n比如像这样——", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo016"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR6"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "我是樱羽艾玛！", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo017"]}},
    {"op": "HideAllCharacters", "line": 243, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "玛格发出的声音<br>\n和艾玛一模一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative019"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "在场的所有人都惊呆了。<br>\n唯独玛格一人脸色有些阴郁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR1"}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "对不起，我只有这种无聊的模仿能力。<br>\n在越狱这件事上完全派不上用场吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo018"]}},
    {"op": "UpdateWitchBook", "line": 253, "indent": 0, "params": {"Id": "Margo", "Category": "Profile", "Version": 2}},
    {"op": "HideAllCharacters", "line": 254, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "玛格似乎不太中意自己的能力。<br>\n其他人也不知该如何接话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative021"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "这时，远处的可可<br>\n阴阳怪气地哈哈大笑起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative022"]}},
    {"op": "HidePrinter", "line": 260, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 261, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["40", "200", "true", "0.3", "#000000"], "ScenePosition": [80.0, 50.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 262, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [45.0, 36.0], "AppearanceAndTransition": "12_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [80.0, 32.0], "IdAndAppearance": "Coco.Smile1,ArmL4", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 264, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Coco-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 265, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 266, "indent": 0, "params": {"ActorIds": ["Coco-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 267, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "真的假的？你超适合当主播啊！<br>\n不如去当模仿艺人怎样？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 271, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "哼，竟敢嘲笑别人的能力，<br>\n想必你的魔法一定很了不得吧？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 275, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Normal1,ArmL11", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "你说我吗？我的魔法是——【千里眼】。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 279, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Normal1,ArmR10,ArmL5", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "可可一转平时的欢脱模样，<br>\n愁眉苦脸着站了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 283, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "千、千里眼……？<br>\n莫非你一直在监视我们……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Hanna005"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "只不过，我只能对正在看我的人<br>\n使用这个能力。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco003"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "无论通过直播还是照片，只要认知到了是泽渡可可这个人，<br>\n我就能用俯瞰视角看到对方。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "这样啊……那就好～<br>\n请、请你不要吓我们好吗。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Hanna006"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "（……所以可可她<br>\n　才会经常做直播啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema014"]}},
    {"op": "UpdateWitchBook", "line": 297, "indent": 0, "params": {"Id": "Coco", "Category": "Profile", "Version": 2}},
    {"op": "ModifyCharacterExtended", "line": 298, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Pensive1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "只要有人看我的直播，不管这人在哪里<br>\n我都能随意看个够啦……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco005"]}},
    {"op": "ModifyCharacterExtended", "line": 302, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Angry1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "什么狗屁魔法！！一点用也没有！！<br>\n开了直播也没人来看啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco006"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "可可突然情绪激动起来，<br>\n吓得艾玛她们肩膀一抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative024"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "还以为你们找到了什么好办法，结果过来一听，<br>\n都是些废话！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco007"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "我的魔法和你们的魔法全都派不上用场！！<br>\n到底该怎么逃出去啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco008"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "快点找到办法啊！！<br>\n我想赶紧离开这破地方！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco009"]}},
    {"op": "ModifyCharacterExtended", "line": 314, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "可大家也都是这么想的呀……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Hanna007"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "烦死了！！<br>\n我是真的想出去！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco010"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "怒上心头的可可气得直跺脚，<br>\n脸皱作一团。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Pensive1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "人家……是真的……<br>\n好想赶紧逃出这里……！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco011"]}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "得赶紧逃出去才行……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Coco012"]}},
    {"op": "HidePrinter", "line": 328, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 329, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Coco-Front"], "Loop": 0}},
    {"op": "AnimateActorExtended", "line": 330, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "44", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 331, "indent": 0, "params": {"ActorIds": ["Coco-Front"], "Loop": 0, "ScenePositionY": "48", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "HideActors", "line": 332, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Coco-Front", "Hanna"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 333, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 334, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "可可从喉咙里挤出悲痛的呢喃，<br>\n便转身离开了图书馆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 338, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "好担心可可啊……<br>\n感觉她积攒了很多压力。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Margo019"]}},
    {"op": "HideAllCharacters", "line": 342, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 344, "indent": 0, "params": {"Text": "（大家的忍耐都快到极限了……<br>\n　随时都有可能变成魔女）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema015"]}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "（可是，玛格的【模仿】<br>\n　和可可的【千里眼】对越狱都没太大帮助）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema016"]}},
    {"op": "PrintTextModified", "line": 348, "indent": 0, "params": {"Text": "艾玛在脑海中<br>\n再度回顾少女们的魔法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative027"]}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "——玛格的【模仿】，<br>\n——可可的【千里眼】，<br>\n——奈叶香的【幻视】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative028"]}},
    {"op": "PrintTextModified", "line": 352, "indent": 0, "params": {"Text": "——雪莉的【怪力】，<br>\n——汉娜的【飘浮】，<br>\n——梅露露的【治愈】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative029"]}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "——米莉亚的【互换】，<br>\n——安安的【洗脑】，<br>\n——亚里沙的【点火】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative030"]}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "（所有人的魔法我已经大致了解了……<br>\n　但要说哪个能用来越狱，<br>\n　可能就只有汉娜的【飘浮】了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema017"]}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "翻开的书页映入艾玛的眼帘，<br>\n上面画着自由自在飞翔在无垠蓝天的魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative031"]}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "（……如果我们也能像这样自由地飞在空中，<br>\n　一定很快乐吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema018"]}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "（但我们可以通过发展科学，<br>\n　从而自由地飞上天空……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema019"]}},
    {"op": "ModifyCharacterExtended", "line": 364, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "啊！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema020"]}},
    {"op": "HideAllCharacters", "line": 368, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 369, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 371, "indent": 0, "params": {"Text": "怎么了，艾玛？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Sherry009"]}},
    {"op": "HideAllCharacters", "line": 373, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 374, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "我好像找到越狱的方法了……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Ema021"]}},
    {"op": "HideAllCharacters", "line": 378, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 380, "indent": 0, "params": {"Text": "艾玛灵光一闪，探出身子<br>\n对少女们说出自己的想法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv04_Narrative032"]}},
    {"op": "Gosub", "line": 382, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 384, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv05", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv04_Narrative001": "第二天下午的放风时间，<br>\n艾玛一行人又被玛格叫去了图书室。",
  "0102Adv04_Narrative002": "米莉亚和安安，还有梅露露都没来。<br>\n不过可可倒是来了。",
  "0102Adv04_Narrative003": "可可坐在离其他人稍远的椅子上，<br>\n正无精打采地玩手机。",
  "0102Adv04_Ema001": "玛格，今天喊我们来图书室有什么事……？",
  "0102Adv04_Margo001": "呵呵呵，不用那么警惕。<br>\n今天我不是来推销的。",
  "0102Adv04_Margo002": "我翻了一圈图书室里的书，<br>\n找到本很有意思的书，<br>\n所以想给大家也看一看。",
  "0102Adv04_Ema002": "（玛格虽然看起来悠哉游哉的……<br>\n　但说不定其实她行动力很强……）",
  "0102Adv04_Narrative004": "自从大家被抓到监狱以来，<br>\n玛格似乎是精力最充沛的那个，<br>\n她做的事也是最有意义的。",
  "0102Adv04_Ema003": "（也许玛格比我<br>\n　更适合做队长………）",
  "0102Adv04_Narrative005": "艾玛摇摇头，<br>\n赶走脑海中浮现的想法。",
  "0102Adv04_Ema004": "（现在想那么多也没有用……！<br>\n　好不容易争取到了玛格的协助）",
  "0102Adv04_Ema005": "你说的是什么书？",
  "0102Adv04_Margo003": "就是这本。",
  "0102Adv04_Narrative006": "玛格放在桌上的书<br>\n装帧豪华，十分厚重。",
  "0102Adv04_Margo004": "上面记载了有关魔女的知识。目前，<br>\n我只找到了这一本和魔女有关的书。",
  "0102Adv04_Sherry001": "这样啊，让我看看。",
  "0102Adv04_Narrative007": "雪莉翻开书，哗啦啦的翻了起来。<br>\n这时汉娜却有些着急了。",
  "0102Adv04_Hanna001": "可、可以请你不要那样粗暴地翻阅吗！？<br>\n书都要被你弄坏了哦！？",
  "0102Adv04_Sherry002": "……你把我当成什么人了？",
  "0102Adv04_Sherry003": "不过话说回来，我看不懂这本书耶。",
  "0102Adv04_Narrative008": "艾玛也兴趣盎然地看起书来。",
  "0102Adv04_Margo005": "呵呵呵。怎样？这文字很奇特吧？",
  "0102Adv04_Ema006": "玛格，难道你能看得懂！？",
  "0102Adv04_Margo006": "不，我看不懂。",
  "0102Adv04_Narrative009": "玛格愉快地扑哧一笑。",
  "0102Adv04_Margo007": "但这本书里有很多图解。<br>\n所以我才知道书上写了和魔女有关的东西。",
  "0102Adv04_Margo008": "你看，这张图画的<br>\n是不是我们的魔法。",
  "0102Adv04_Sherry004": "啊！真的耶！<br>\n这张画上的女孩有一点飘起来了！",
  "0102Adv04_Narrative010": "那张老旧的插图<br>\n画有一位飘在空中的少女。",
  "0102Adv04_Narrative011": "而它旁边的那张画，<br>\n好像是一位少女在空中滑翔。",
  "0102Adv04_Margo009": "我就说很有意思吧？<br>\n能从中解读出我们的魔法会怎样进化。",
  "0102Adv04_Hanna002": "如果这本书的内容没错的话……<br>\n那我的魔法变强以后<br>\n就可以飞得更高了！",
  "0102Adv04_Ema007": "等你的魔法变强<br>\n说不定能飞过围墙……！",
  "0102Adv04_Narrative012": "汉娜和艾玛似乎寻觅到了一丝希望，<br>\n她们两眼放光地看向彼此。",
  "0102Adv04_Sherry005": "嗯……？可是，魔法变强的话，<br>\n也就意味着进一步魔女化吧……？",
  "0102Adv04_Hanna003": "呃，说、说得也对……<br>\n我可不想变成【残骸】……",
  "0102Adv04_Margo010": "不仅会加重杀意，还会危及我们的生命。<br>\n这可不是个好主意。",
  "0102Adv04_Ema008": "还是不行啊……",
  "0102Adv04_Narrative013": "艾玛感到很失落，<br>\n她想找到新的线索，<br>\n目光又回到书上。",
  "0102Adv04_Narrative014": "这时她看见一幅图解。图画上，众多魔女手牵手围在一起，<br>\n而一名威严十足的魔女正在降临。",
  "0102Adv04_Ema009": "这个人，是不是类似于魔女的领袖……？",
  "0102Adv04_Margo011": "恐怕是的。<br>\n在常见的传说中，魔女也都是有领袖的。",
  "0102Adv04_Margo012": "统治所有魔女的领袖——【大魔女】。",
  "0102Adv04_Margo013": "这幅图解是【<ruby=\"Sabbath\">魔女的安息日</ruby>】吗？<br>\n看起来像是魔女们在召唤大魔女。",
  "0102Adv04_Margo014": "如果能解读出文字的话，<br>\n就能知道更详细的内容了。",
  "0102Adv04_Ema010": "（大魔女……难道那就是幕后黑手……？）",
  "0102Adv04_Narrative015": "艾玛的脑海中浮现出<br>\n米莉亚的身影。<br>\n她连忙甩开这个念头。",
  "0102Adv04_Ema011": "（只是奈叶香怀疑她而已，<br>\n　米莉亚也不一定就是幕后黑手）",
  "0102Adv04_Narrative016": "玛格叹了口气将书合上，<br>\n看向艾玛她们。",
  "0102Adv04_Margo015": "我想和大家商量的就是，<br>\n虽然汉娜的魔法没法指望，<br>\n不过我们也许可以用其他魔法越狱。",
  "0102Adv04_Ema012": "对哦……！<br>\n我们再确认一遍各自的魔法吧。",
  "0102Adv04_Ema013": "呃，抱歉……我连自己的魔法<br>\n都搞不清楚是什么……",
  "0102Adv04_Narrative017": "雪莉举起手，劲头十足地抢先发言。",
  "0102Adv04_Sherry006": "我的魔法是怪力！",
  "0102Adv04_Sherry007": "但那堵围墙可能是施了什么魔法，<br>\n连我的能力都无法破坏，<br>\n也没办法爬上去。",
  "0102Adv04_Sherry008": "玛格你的魔法是什么呢！？",
  "0102Adv04_Narrative018": "玛格轻轻吐了口气，耸耸肩说。",
  "0102Adv04_Margo016": "我可以自由变换自己的声音。<br>\n比如像这样——",
  "0102Adv04_Margo017": "我是樱羽艾玛！",
  "0102Adv04_Narrative019": "玛格发出的声音<br>\n和艾玛一模一样。",
  "0102Adv04_Narrative020": "在场的所有人都惊呆了。<br>\n唯独玛格一人脸色有些阴郁。",
  "0102Adv04_Margo018": "对不起，我只有这种无聊的模仿能力。<br>\n在越狱这件事上完全派不上用场吧？",
  "0102Adv04_Narrative021": "玛格似乎不太中意自己的能力。<br>\n其他人也不知该如何接话。",
  "0102Adv04_Narrative022": "这时，远处的可可<br>\n阴阳怪气地哈哈大笑起来。",
  "0102Adv04_Coco001": "真的假的？你超适合当主播啊！<br>\n不如去当模仿艺人怎样？",
  "0102Adv04_Hanna004": "哼，竟敢嘲笑别人的能力，<br>\n想必你的魔法一定很了不得吧？",
  "0102Adv04_Coco002": "你说我吗？我的魔法是——【千里眼】。",
  "0102Adv04_Narrative023": "可可一转平时的欢脱模样，<br>\n愁眉苦脸着站了起来。",
  "0102Adv04_Hanna005": "千、千里眼……？<br>\n莫非你一直在监视我们……？",
  "0102Adv04_Coco003": "只不过，我只能对正在看我的人<br>\n使用这个能力。",
  "0102Adv04_Coco004": "无论通过直播还是照片，只要认知到了是泽渡可可这个人，<br>\n我就能用俯瞰视角看到对方。",
  "0102Adv04_Hanna006": "这样啊……那就好～<br>\n请、请你不要吓我们好吗。",
  "0102Adv04_Ema014": "（……所以可可她<br>\n　才会经常做直播啊……）",
  "0102Adv04_Coco005": "只要有人看我的直播，不管这人在哪里<br>\n我都能随意看个够啦……",
  "0102Adv04_Coco006": "什么狗屁魔法！！一点用也没有！！<br>\n开了直播也没人来看啊！！",
  "0102Adv04_Narrative024": "可可突然情绪激动起来，<br>\n吓得艾玛她们肩膀一抖。",
  "0102Adv04_Coco007": "还以为你们找到了什么好办法，结果过来一听，<br>\n都是些废话！！",
  "0102Adv04_Coco008": "我的魔法和你们的魔法全都派不上用场！！<br>\n到底该怎么逃出去啊！！",
  "0102Adv04_Coco009": "快点找到办法啊！！<br>\n我想赶紧离开这破地方！！",
  "0102Adv04_Hanna007": "可大家也都是这么想的呀……！",
  "0102Adv04_Coco010": "烦死了！！<br>\n我是真的想出去！！",
  "0102Adv04_Narrative025": "怒上心头的可可气得直跺脚，<br>\n脸皱作一团。",
  "0102Adv04_Coco011": "人家……是真的……<br>\n好想赶紧逃出这里……！",
  "0102Adv04_Coco012": "得赶紧逃出去才行……",
  "0102Adv04_Narrative026": "可可从喉咙里挤出悲痛的呢喃，<br>\n便转身离开了图书馆。",
  "0102Adv04_Margo019": "好担心可可啊……<br>\n感觉她积攒了很多压力。",
  "0102Adv04_Ema015": "（大家的忍耐都快到极限了……<br>\n　随时都有可能变成魔女）",
  "0102Adv04_Ema016": "（可是，玛格的【模仿】<br>\n　和可可的【千里眼】对越狱都没太大帮助）",
  "0102Adv04_Narrative027": "艾玛在脑海中<br>\n再度回顾少女们的魔法。",
  "0102Adv04_Narrative028": "——玛格的【模仿】，<br>\n——可可的【千里眼】，<br>\n——奈叶香的【幻视】。",
  "0102Adv04_Narrative029": "——雪莉的【怪力】，<br>\n——汉娜的【飘浮】，<br>\n——梅露露的【治愈】。",
  "0102Adv04_Narrative030": "——米莉亚的【互换】，<br>\n——安安的【洗脑】，<br>\n——亚里沙的【点火】。",
  "0102Adv04_Ema017": "（所有人的魔法我已经大致了解了……<br>\n　但要说哪个能用来越狱，<br>\n　可能就只有汉娜的【飘浮】了……）",
  "0102Adv04_Narrative031": "翻开的书页映入艾玛的眼帘，<br>\n上面画着自由自在飞翔在无垠蓝天的魔女。",
  "0102Adv04_Ema018": "（……如果我们也能像这样自由地飞在空中，<br>\n　一定很快乐吧）",
  "0102Adv04_Ema019": "（但我们可以通过发展科学，<br>\n　从而自由地飞上天空……）",
  "0102Adv04_Ema020": "啊！！",
  "0102Adv04_Sherry009": "怎么了，艾玛？",
  "0102Adv04_Ema021": "我好像找到越狱的方法了……！",
  "0102Adv04_Narrative032": "艾玛灵光一闪，探出身子<br>\n对少女们说出自己的想法。"
}
}
