  "path": "Act01_Chapter02/Act01_Chapter02_Trial15",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "Version": 5}},
    {"op": "SetCustomVariable", "line": 2, "indent": 0, "params": {"Expression": "isReenact = true"}},
    {"op": "ModifyTextPrinter", "line": 3, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Gosub", "line": 4, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Judge2-15-1", "line": 11, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 14, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 24, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S01", "Wait": 0}},
    {"op": "Wait", "line": 25, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "那只是一次偶然。<br>\n一开始……只是个偶然。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn001"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "吾辈见看守拿着钥匙，<br>\n便心想其中应该有惩罚室的钥匙。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn002"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "所以……吾辈试着用魔法拜托它，<br>\n骗它说，典狱长让吾辈把钥匙拿来。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn003"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "只有对方认可吾辈的话，<br>\n魔法才能生效。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn004"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "但看守似乎认可了吾辈的谎言，<br>\n把钥匙给了吾辈。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn005"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "所以，吾辈就拿着那钥匙……<br>\n去了惩罚室。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn006"]}},
    {"op": "ResetText", "line": 41, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 42, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 43, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 48, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S02", "Wait": 0}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "吾辈本没有打算杀她……<br>\n但……最终，还是变成了这局面。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn007"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "吾辈用她身旁的刀，刺杀了被绑在架子上的她。<br>\n一遍又一遍，刺了无数刀。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn008"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "那只是一时冲动罢了。<br>\n杀害她以后，吾辈必须想办法不背上嫌疑。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn009"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "吾辈便想起米莉亚的手机里<br>\n有她的录音文件。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn010"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "于是吾辈决定利用它制造不在场证明。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn011"]}},
    {"op": "ResetText", "line": 61, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 62, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S02", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 67, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S03", "Wait": 0}},
    {"op": "Wait", "line": 68, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "吾辈将米莉亚的铃声设成了<br>\n她的录音。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn012"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "吾辈想嫁祸给运营或典狱长……<br>\n也就是【幕后黑手】。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn013"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "所以把钥匙丢在房间就离开了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn014"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "之后，还需要找个人一起制造不在场证明。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn015"]}},
    {"op": "ResetText", "line": 78, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 79, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S03", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 80, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 84, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S04", "Wait": 0}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "吾辈写了张拷问秀的便条贴在会客厅里。<br>\n没过多久汉娜来了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn016"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "所以吾辈装作碰巧遇见她，商量好<br>\n和她一起去探望米莉亚。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn017"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "吾辈找准时机，偷偷给米莉亚的手机打电话。<br>\n随后便播放了米莉亚的惨叫录音。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn018"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "汉娜似乎完全相信了米莉亚还活着。<br>\n……她根本没想过怀疑别人，真是个好孩子。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn019"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "吾辈就这样制造了不在场证明，<br>\n前往医务室。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn020"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "之后，只要找个合适的时间和别人一起发现尸体，<br>\n把手机掉包……就能顺利完成计划。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn021"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "为此，吾辈在医务室悄悄删掉了手机数据。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn022"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "……但是没想到，奈叶香抢先发现了尸体。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn023"]}},
    {"op": "ResetText", "line": 103, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 104, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S04", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 105, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 110, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S05", "Wait": 0}},
    {"op": "Wait", "line": 111, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "因为房间上了锁，发现尸体的人<br>\n变多了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn024"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "趁着尸体引发混乱，<br>\n大家都在关注尸体的时候，吾辈把手机换掉了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn025"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "……不过看来，这一切实在漏洞百出。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn026"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "……吾辈的所作所为并没有什么大不了的。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn027"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "只是刺杀她……<br>\n然后播放了录音而已。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn028"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "就是这样一个混乱而散漫的，<br>\n甚至比不上B级恐怖片的……<br>\n可笑的故事。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn029"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "银幕上已然一片空白。<br>\n吾辈的故事，也到此结束——", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Trial15_AnAn030"]}},
    {"op": "ResetText", "line": 129, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 130, "indent": 0, "params": {"Path": "Reenact_Ch01_E02_S05", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 131, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "SetCustomVariable", "line": 135, "indent": 0, "params": {"Expression": "isReenact = false"}},
    {"op": "Gosub", "line": 136, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 138, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv27", "SoftReset": 1}}
  ],
  "translations": {
  "0102Trial15_AnAn001": "那只是一次偶然。<br>\n一开始……只是个偶然。",
  "0102Trial15_AnAn002": "吾辈见看守拿着钥匙，<br>\n便心想其中应该有惩罚室的钥匙。",
  "0102Trial15_AnAn003": "所以……吾辈试着用魔法拜托它，<br>\n骗它说，典狱长让吾辈把钥匙拿来。",
  "0102Trial15_AnAn004": "只有对方认可吾辈的话，<br>\n魔法才能生效。",
  "0102Trial15_AnAn005": "但看守似乎认可了吾辈的谎言，<br>\n把钥匙给了吾辈。",
  "0102Trial15_AnAn006": "所以，吾辈就拿着那钥匙……<br>\n去了惩罚室。",
  "0102Trial15_AnAn007": "吾辈本没有打算杀她……<br>\n但……最终，还是变成了这局面。",
  "0102Trial15_AnAn008": "吾辈用她身旁的刀，刺杀了被绑在架子上的她。<br>\n一遍又一遍，刺了无数刀。",
  "0102Trial15_AnAn009": "那只是一时冲动罢了。<br>\n杀害她以后，吾辈必须想办法不背上嫌疑。",
  "0102Trial15_AnAn010": "吾辈便想起米莉亚的手机里<br>\n有她的录音文件。",
  "0102Trial15_AnAn011": "于是吾辈决定利用它制造不在场证明。",
  "0102Trial15_AnAn012": "吾辈将米莉亚的铃声设成了<br>\n她的录音。",
  "0102Trial15_AnAn013": "吾辈想嫁祸给运营或典狱长……<br>\n也就是【幕后黑手】。",
  "0102Trial15_AnAn014": "所以把钥匙丢在房间就离开了。",
  "0102Trial15_AnAn015": "之后，还需要找个人一起制造不在场证明。",
  "0102Trial15_AnAn016": "吾辈写了张拷问秀的便条贴在会客厅里。<br>\n没过多久汉娜来了。",
  "0102Trial15_AnAn017": "所以吾辈装作碰巧遇见她，商量好<br>\n和她一起去探望米莉亚。",
  "0102Trial15_AnAn018": "吾辈找准时机，偷偷给米莉亚的手机打电话。<br>\n随后便播放了米莉亚的惨叫录音。",
  "0102Trial15_AnAn019": "汉娜似乎完全相信了米莉亚还活着。<br>\n……她根本没想过怀疑别人，真是个好孩子。",
  "0102Trial15_AnAn020": "吾辈就这样制造了不在场证明，<br>\n前往医务室。",
  "0102Trial15_AnAn021": "之后，只要找个合适的时间和别人一起发现尸体，<br>\n把手机掉包……就能顺利完成计划。",
  "0102Trial15_AnAn022": "为此，吾辈在医务室悄悄删掉了手机数据。",
  "0102Trial15_AnAn023": "……但是没想到，奈叶香抢先发现了尸体。",
  "0102Trial15_AnAn024": "因为房间上了锁，发现尸体的人<br>\n变多了。",
  "0102Trial15_AnAn025": "趁着尸体引发混乱，<br>\n大家都在关注尸体的时候，吾辈把手机换掉了。",
  "0102Trial15_AnAn026": "……不过看来，这一切实在漏洞百出。",
  "0102Trial15_AnAn027": "……吾辈的所作所为并没有什么大不了的。",
  "0102Trial15_AnAn028": "只是刺杀她……<br>\n然后播放了录音而已。",
  "0102Trial15_AnAn029": "就是这样一个混乱而散漫的，<br>\n甚至比不上B级恐怖片的……<br>\n可笑的故事。",
  "0102Trial15_AnAn030": "银幕上已然一片空白。<br>\n吾辈的故事，也到此结束——"
}
}
