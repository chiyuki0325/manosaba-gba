{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter02/Act01_Chapter02_Adv14",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-14", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "又过了几天。<br>\n晚餐后，少女们受艾玛召集，<br>\n在会客厅会合。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "可现场不见亚里沙的影子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR9"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "呼啊～，好困……没劲……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco001"]}},
    {"op": "HideAllCharacters", "line": 26, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "一进会客厅可可就倒在了沙发上。<br>\n梅露露走到她身边问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "可、可可小姐，你最近是不是昼夜颠倒了？<br>\n你的脸色看上去不太好……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Meruru001"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "要不要帮你泡一杯<br>\n助眠的香草茶……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "啊？你在监视我吗？<br>\n跟你有什么关系？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco002"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "我想几点睡就几点睡，想几点起就几点起，<br>\n又没影响到其他人。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco003"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "呜、呜呜……可是，我很担心你……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 45, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "梅露露打出了关心牌，但可可明显没当一回事，<br>\n于是米莉亚也插嘴说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "小可，早起心情会更好哦。<br>\n手机里面也有闹钟功能呢。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Miria001"]}},
    {"op": "HideAllCharacters", "line": 53, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "米莉亚拿出手机，<br>\n开始操作起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative005"]}},
    {"op": "PlayBgm", "line": 58, "indent": 0, "params": {"BgmPath": "Ambi_3_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "你看，还可以把铃声改成音乐哦！<br>\n听到喜欢的音乐就能开开心心地起床啦。<br>\n怎么样！？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Miria002"]}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1,ArmR6,ArmL8"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "大叔……你真的叔味很重欸。<br>\n这种事谁都知道啦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco004"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "而且把手机铃声改成音乐的想法也超像大叔的。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco005"]}},
    {"op": "StopBgm", "line": 71, "indent": 0, "params": {"BgmPath": "Ambi_3_1"}},
    {"op": "HideAllCharacters", "line": 72, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "尽管可可嘴上非常嫌弃，但她对米莉亚的态度已经算温柔了。<br>\n两个人操作着手机，看起来聊得很开心的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative006"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "艾玛站在会客厅中央，<br>\n望着这和睦的场面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative007"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "她清了清嗓子，一脸紧张地开口道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "在大家的协助下，<br>\n明天我们终于要正式执行计划了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema001"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "真的非常感谢大家……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema002"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "也许是因为看到了越狱的曙光，<br>\n在场所有少女脸上的表情都很灿烂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "我们是明天下午5点在围墙前执行计划，没错吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Sherry001"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "是的。看守在晚餐时间不会四处巡逻，<br>\n要动手只能趁这个时候。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Margo001"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "“那东西”的成品已经藏起来了。<br>\n我敢保证绝对不会被发现。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Miria003"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Miria.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "大叔我可是努力了好一番呢～！<br>\n只管相信我就好！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Miria004"]}},
    {"op": "HideAllCharacters", "line": 104, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "『担心』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_AnAn001"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "有、有、有点担心……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Meruru004"]}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Surprised1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "不要用那种眼神看我呀！？<br>\n这可是关系到我的信用，我肯定不会敷衍啦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Miria005"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "要是出了什么事大叔我负责！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Miria006"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "（热气球的成品<br>\n　由米莉亚负责藏起来）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema003"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "（目前，<br>\n　知道热气球藏在哪里的只有米莉亚一个人）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema004"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "（毕竟米莉亚或许暗中有什么企图，也有可能是幕后黑手，<br>\n　我也犹豫过，到底该不该相信她……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema005"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "但随着越狱计划的推进，<br>\n大家和米莉亚渐渐变得亲近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative010"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "如今，她反而收获了大家的喜爱，<br>\n就好像团宠一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative011"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "（米莉亚是我们的伙伴，一定不会有问题）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "不好意思，我可以提一个问题吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Hanna001"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "因为我们的热气球做得不是很大，<br>\n没法一次载我们所有人走。这点该怎么解决？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "嗯，关于这个问题，<br>\n玛格和我商量过……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema007"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "明天的行程，我打算让<br>\n艾玛和亚里沙两个人先去。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Margo002"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "但话说回来，亚里沙现在不在这里，<br>\n明天能不能出发还不好说。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Margo003"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "听到玛格的发言，可可一下子着急了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "哈！？给我等下，<br>\n凭什么就艾玛亲和太妹两个人去！？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco006"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "我不能接受，人家也要去！<br>\n得赶紧离开这鬼地方……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco007"]}},
    {"op": "HideAllCharacters", "line": 161, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "之所以让我们先去，<br>\n是因为人少一点不容易被发现。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema008"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "而且，我们还不知道围墙外的情况……<br>\n所以我们打算确定能出得去以后就回来。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema009"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "……什么嘛，是这样啊。好吧。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco008"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "可可像是暂时接受了这个理由，<br>\n但她看起来仍心存疑虑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "可是，你们该不会打算<br>\n自己偷偷溜走吧？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco009"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "要是能飞出围墙的话，<br>\n你们又没有必要回来帮我们。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco010"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "带我一起坐嘛。<br>\n加一个人又没什么，求你啦～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco011"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "就算你说一定会回来，<br>\n我也还是没办法相信你。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco012"]}},
    {"op": "HideAllCharacters", "line": 189, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1,ArmR1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema010"]}},
    {"op": "HideAllCharacters", "line": 194, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "而且那个太妹<br>\n绝对会偷偷溜走。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco013"]}},
    {"op": "HideAllCharacters", "line": 199, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "——我才不会。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 204, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "亚里沙！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema011"]}},
    {"op": "HideAllCharacters", "line": 209, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "不知何时，亚里沙来到了会客厅。<br>\n所有人的目光齐刷刷地集中在她身上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "我会帮你们。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa002"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "我承诺的事情<br>\n一定会负责到底，决不放弃。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa003"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "这下你可没怨言了吧，喂。<br>\n再啰啰嗦嗦的小心我烧你啊？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa004"]}},
    {"op": "HideAllCharacters", "line": 221, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "……哼，<br>\n那我没话好说了行吧？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco014"]}},
    {"op": "HideAllCharacters", "line": 226, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "在亚里沙的威吓下，可可终于让步了。<br>\n然后她转头不停地敲打身边的米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmR7,ArmL6"}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "啊～讨厌～那家伙搞什么嘛，吓死人了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Coco015"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "痛、好痛……不要把气撒在大叔我身上呀……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Miria007"]}},
    {"op": "HideAllCharacters", "line": 237, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "艾玛激动万分地<br>\n跑到亚里沙身旁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 241, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "ModifyCharacterExtended", "line": 242, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Smile1,ArmR3"}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "亚里沙，谢谢你愿意过来……<br>\n我真的好开心。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema012"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "真是的，谁叫你那么烦人。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa005"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "我会帮忙让所有人都离开这里，<br>\n这样就可以了吧？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa006"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "嗯，嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema013"]}},
    {"op": "HideAllCharacters", "line": 252, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "艾玛高兴得热泪盈眶。<br>\n这时玛格送来了掌声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "都是艾玛你的功劳。<br>\n因为有你的领导，<br>\n大家才能团结一心。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Margo004"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "是啊！哎呀～真期待明天！<br>\n祝艾玛和亚里沙幸福美满大结局～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Sherry002"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "你给我闭嘴。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa007"]}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "为什么就对我那么凶啦～<br>\n人家还想和你搞好关系耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "你太虚伪了，橘。<br>\n樱羽就很真诚，你们根本不一样。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Alisa008"]}},
    {"op": "HideAllCharacters", "line": 274, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "所有幸存的少女此刻团结在一起。<br>\n她们的脸上都绽放出了笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR3"}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "（我们才不是魔女，我们大家都是好孩子。<br>\n　我一定要带大家离开这里……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Ema014"]}},
    {"op": "HideAllCharacters", "line": 282, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "艾玛把手放在胸口，再次下定决心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv14_Narrative019"]}},
    {"op": "Gosub", "line": 286, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 288, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv15", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv14_Narrative001": "又过了几天。<br>\n晚餐后，少女们受艾玛召集，<br>\n在会客厅会合。",
  "0102Adv14_Narrative002": "可现场不见亚里沙的影子。",
  "0102Adv14_Coco001": "呼啊～，好困……没劲……",
  "0102Adv14_Narrative003": "一进会客厅可可就倒在了沙发上。<br>\n梅露露走到她身边问道。",
  "0102Adv14_Meruru001": "可、可可小姐，你最近是不是昼夜颠倒了？<br>\n你的脸色看上去不太好……",
  "0102Adv14_Meruru002": "要不要帮你泡一杯<br>\n助眠的香草茶……？",
  "0102Adv14_Coco002": "啊？你在监视我吗？<br>\n跟你有什么关系？",
  "0102Adv14_Coco003": "我想几点睡就几点睡，想几点起就几点起，<br>\n又没影响到其他人。",
  "0102Adv14_Meruru003": "呜、呜呜……可是，我很担心你……",
  "0102Adv14_Narrative004": "梅露露打出了关心牌，但可可明显没当一回事，<br>\n于是米莉亚也插嘴说道。",
  "0102Adv14_Miria001": "小可，早起心情会更好哦。<br>\n手机里面也有闹钟功能呢。",
  "0102Adv14_Narrative005": "米莉亚拿出手机，<br>\n开始操作起来。",
  "0102Adv14_Miria002": "你看，还可以把铃声改成音乐哦！<br>\n听到喜欢的音乐就能开开心心地起床啦。<br>\n怎么样！？",
  "0102Adv14_Coco004": "大叔……你真的叔味很重欸。<br>\n这种事谁都知道啦。",
  "0102Adv14_Coco005": "而且把手机铃声改成音乐的想法也超像大叔的。",
  "0102Adv14_Narrative006": "尽管可可嘴上非常嫌弃，但她对米莉亚的态度已经算温柔了。<br>\n两个人操作着手机，看起来聊得很开心的样子。",
  "0102Adv14_Narrative007": "艾玛站在会客厅中央，<br>\n望着这和睦的场面。",
  "0102Adv14_Narrative008": "她清了清嗓子，一脸紧张地开口道。",
  "0102Adv14_Ema001": "在大家的协助下，<br>\n明天我们终于要正式执行计划了。",
  "0102Adv14_Ema002": "真的非常感谢大家……！",
  "0102Adv14_Narrative009": "也许是因为看到了越狱的曙光，<br>\n在场所有少女脸上的表情都很灿烂。",
  "0102Adv14_Sherry001": "我们是明天下午5点在围墙前执行计划，没错吧。",
  "0102Adv14_Margo001": "是的。看守在晚餐时间不会四处巡逻，<br>\n要动手只能趁这个时候。",
  "0102Adv14_Miria003": "“那东西”的成品已经藏起来了。<br>\n我敢保证绝对不会被发现。",
  "0102Adv14_Miria004": "大叔我可是努力了好一番呢～！<br>\n只管相信我就好！",
  "0102Adv14_AnAn001": "『担心』",
  "0102Adv14_Meruru004": "有、有、有点担心……",
  "0102Adv14_Miria005": "不要用那种眼神看我呀！？<br>\n这可是关系到我的信用，我肯定不会敷衍啦。",
  "0102Adv14_Miria006": "要是出了什么事大叔我负责！",
  "0102Adv14_Ema003": "（热气球的成品<br>\n　由米莉亚负责藏起来）",
  "0102Adv14_Ema004": "（目前，<br>\n　知道热气球藏在哪里的只有米莉亚一个人）",
  "0102Adv14_Ema005": "（毕竟米莉亚或许暗中有什么企图，也有可能是幕后黑手，<br>\n　我也犹豫过，到底该不该相信她……）",
  "0102Adv14_Narrative010": "但随着越狱计划的推进，<br>\n大家和米莉亚渐渐变得亲近。",
  "0102Adv14_Narrative011": "如今，她反而收获了大家的喜爱，<br>\n就好像团宠一样。",
  "0102Adv14_Ema006": "（米莉亚是我们的伙伴，一定不会有问题）",
  "0102Adv14_Hanna001": "不好意思，我可以提一个问题吗？",
  "0102Adv14_Hanna002": "因为我们的热气球做得不是很大，<br>\n没法一次载我们所有人走。这点该怎么解决？",
  "0102Adv14_Ema007": "嗯，关于这个问题，<br>\n玛格和我商量过……",
  "0102Adv14_Margo002": "明天的行程，我打算让<br>\n艾玛和亚里沙两个人先去。",
  "0102Adv14_Margo003": "但话说回来，亚里沙现在不在这里，<br>\n明天能不能出发还不好说。",
  "0102Adv14_Narrative012": "听到玛格的发言，可可一下子着急了起来。",
  "0102Adv14_Coco006": "哈！？给我等下，<br>\n凭什么就艾玛亲和太妹两个人去！？",
  "0102Adv14_Coco007": "我不能接受，人家也要去！<br>\n得赶紧离开这鬼地方……",
  "0102Adv14_Ema008": "之所以让我们先去，<br>\n是因为人少一点不容易被发现。",
  "0102Adv14_Ema009": "而且，我们还不知道围墙外的情况……<br>\n所以我们打算确定能出得去以后就回来。",
  "0102Adv14_Coco008": "……什么嘛，是这样啊。好吧。",
  "0102Adv14_Narrative013": "可可像是暂时接受了这个理由，<br>\n但她看起来仍心存疑虑。",
  "0102Adv14_Coco009": "可是，你们该不会打算<br>\n自己偷偷溜走吧？",
  "0102Adv14_Coco010": "要是能飞出围墙的话，<br>\n你们又没有必要回来帮我们。",
  "0102Adv14_Coco011": "带我一起坐嘛。<br>\n加一个人又没什么，求你啦～",
  "0102Adv14_Coco012": "就算你说一定会回来，<br>\n我也还是没办法相信你。",
  "0102Adv14_Ema010": "……",
  "0102Adv14_Coco013": "而且那个太妹<br>\n绝对会偷偷溜走。",
  "0102Adv14_Alisa001": "——我才不会。",
  "0102Adv14_Ema011": "亚里沙！！",
  "0102Adv14_Narrative014": "不知何时，亚里沙来到了会客厅。<br>\n所有人的目光齐刷刷地集中在她身上。",
  "0102Adv14_Alisa002": "我会帮你们。",
  "0102Adv14_Alisa003": "我承诺的事情<br>\n一定会负责到底，决不放弃。",
  "0102Adv14_Alisa004": "这下你可没怨言了吧，喂。<br>\n再啰啰嗦嗦的小心我烧你啊？",
  "0102Adv14_Coco014": "……哼，<br>\n那我没话好说了行吧？",
  "0102Adv14_Narrative015": "在亚里沙的威吓下，可可终于让步了。<br>\n然后她转头不停地敲打身边的米莉亚。",
  "0102Adv14_Coco015": "啊～讨厌～那家伙搞什么嘛，吓死人了。",
  "0102Adv14_Miria007": "痛、好痛……不要把气撒在大叔我身上呀……",
  "0102Adv14_Narrative016": "艾玛激动万分地<br>\n跑到亚里沙身旁。",
  "0102Adv14_Ema012": "亚里沙，谢谢你愿意过来……<br>\n我真的好开心。",
  "0102Adv14_Alisa005": "真是的，谁叫你那么烦人。",
  "0102Adv14_Alisa006": "我会帮忙让所有人都离开这里，<br>\n这样就可以了吧？",
  "0102Adv14_Ema013": "嗯，嗯……",
  "0102Adv14_Narrative017": "艾玛高兴得热泪盈眶。<br>\n这时玛格送来了掌声。",
  "0102Adv14_Margo004": "都是艾玛你的功劳。<br>\n因为有你的领导，<br>\n大家才能团结一心。",
  "0102Adv14_Sherry002": "是啊！哎呀～真期待明天！<br>\n祝艾玛和亚里沙幸福美满大结局～",
  "0102Adv14_Alisa007": "你给我闭嘴。",
  "0102Adv14_Sherry003": "为什么就对我那么凶啦～<br>\n人家还想和你搞好关系耶。",
  "0102Adv14_Alisa008": "你太虚伪了，橘。<br>\n樱羽就很真诚，你们根本不一样。",
  "0102Adv14_Narrative018": "所有幸存的少女此刻团结在一起。<br>\n她们的脸上都绽放出了笑容。",
  "0102Adv14_Ema014": "（我们才不是魔女，我们大家都是好孩子。<br>\n　我一定要带大家离开这里……！）",
  "0102Adv14_Narrative019": "艾玛把手放在胸口，再次下定决心。"
}
}
