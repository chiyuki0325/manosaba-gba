  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-2", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "5_2"}},
    {"op": "Wait", "line": 11, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 14, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 16, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "噩梦般的魔女审判已成过往。<br>\n翌日，少女们来到会客厅集合。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "在早餐时间，艾玛向众人提议<br>\n大家先坐到一起好好谈一谈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "于是，少女们迈着沉重的步伐<br>\n陆续走进了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "——然而。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative004"]}},
    {"op": "PlayBgm", "line": 27, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "你跟我们都不是一路人好吗！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Alisa001"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "很快就起了冲突。<br>\n亚里沙对米莉亚怒吼道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative005"]}},
    {"op": "HidePrinter", "line": 33, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 34, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "5_2", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL7", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Miria.Pensive1,ArmR4,ArmL3", "SubId": "Middle"}},
    {"op": "Wait", "line": 37, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "你个大叔凑过来干什么！<br>\n你跟我们不一样！滚出去！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Alisa002"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "呀！对、对不起！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Ema.Surprised1,ArmR12", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "是我提议让大家一起谈一谈的，<br>\n米莉亚她没有错！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema001"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "艾玛立即介入调解两人的冲突。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Ema.Determined2,ArmR12", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "我们应该互帮互助才对。<br>\n所以，大家一起谈谈吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema002"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "米莉亚，亚里沙，<br>\n我希望你们都能留在这里。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema003"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "……你想说的就这些？<br>\n我可不想搞什么你帮我我帮你的。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Alisa003"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "谁想跟骗人精做朋友。<br>\n我连那家伙的脸都不想看到。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Alisa004"]}},
    {"op": "HideActors", "line": 59, "indent": 0, "params": {"ActorIds": ["Alisa-Middle"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "丢下这番话后，<br>\n亚里沙离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "呜、呜呜……看来大叔我真的很烦人吧……<br>\n对不起，害你们感到不舒服……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Miria002"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（虽然米莉亚身上的确谜团重重……<br>\n　不过我想暂时先相信她）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema004"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "艾玛带着几分紧张，转身对米莉亚说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative008"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1,ArmR4,ArmL3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "没关系的。米莉亚，我叫你来<br>\n是希望你也能帮助大家。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema005"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "啊，对了，我可以直接叫你<br>\n米莉亚吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Cry1,ArmR4,ArmL3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "当然可以……！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Miria003"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "米莉亚十分激动，<br>\n连连用力点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative009"]}},
    {"op": "HideAllCharacters", "line": 85, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "亚里沙已经离开了现场。<br>\n艾玛看向仍在场的几名少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "米莉亚、汉娜、雪莉、梅露露、<br>\n可可、玛格、安安。<br>\n再算上艾玛，一共8个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "说真的，我们必须得逃出这里。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema007"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "面对一众囚犯少女，<br>\n艾玛毅然开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "蕾雅之前呼吁我们老实遵守规定，<br>\n可是留在这里我们也无法得救。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema008"]}},
    {"op": "HideAllCharacters", "line": 99, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "艾玛原本就在四处游说越狱的事，<br>\n雪莉、汉娜、梅露露三人<br>\n也早就是她的同伴了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "听到艾玛的话，她们三人都用力点头。<br>\n……但，问题在于原先不愿意配合的几位少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Normal1,ArmR2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "话虽如此，<br>\n但违反规定的话，就要被带去惩罚室哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms02_01,Angle01/Option_ArmR/Option_ArmR01_01-", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "『吾辈觉得不应该做违规的事』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_AnAn001"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "我也想逃出这个鬼地方啊，<br>\n可是反抗的话，一个不走运甚至可能会被看守干掉啊。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Coco001"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "就像二阶堂希罗一样。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo002"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "艾玛痛苦地低下头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative015"]}},
    {"op": "HidePrinter", "line": 123, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 124, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "AppearanceAndTransition": "5_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 125, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Scale": [1.149999976158142], "Lazy": 0, "ScenePosition": [75.0, 30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Front"}},
    {"op": "Wait", "line": 127, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "希罗、诺亚……还有蕾雅。<br>\n大家被抓到这里来以后已经牺牲了三个人。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema009"]}},
    {"op": "HidePrinter", "line": 131, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 132, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 133, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["200", "200", "true", "0.5", "#000000cc"], "ScenePosition": [-7.0, 50.0], "Rotation": [0.0, 0.0, -10.0], "SubId": "Forefront"}},
    {"op": "ModifyBackgroundExtended", "line": 134, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 35.0], "AppearanceAndTransition": "5_2", "SubId": "Forefront"}},
    {"op": "SpawnBlur", "line": 135, "indent": 0, "params": {"ActorId": "MainBackground-Forefront", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Scale": [1.149999976158142], "Lazy": 0, "ScenePosition": [25.0, 30.0], "IdAndAppearance": "Coco.Normal1,ArmR2", "SubId": "Forefront"}},
    {"op": "ChangeActorMaskability", "line": 137, "indent": 0, "params": {"ActorIds": ["MainBackground-Forefront", "Coco-Forefront"], "Enable": 1}},
    {"op": "Wait", "line": 138, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "蕾雅她是自作自受吧。<br>\n谁让她杀人了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Ema.Determined2,ArmR3", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "如果不是在这种处境下，就不会闹出这种事了。<br>\n就像奈叶香说的那样，我们都被玩弄了！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema010"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "再在这里待下去，<br>\n等待我们的只有最悲惨的未来。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema011"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "一定有什么办法，<br>\n可以不被它们发现偷偷逃出去。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema012"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "我们一起逃走吧！<br>\n只要大家齐心协力，一定能找到出路！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema013"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0, 30.0], "IdAndAppearance": "Coco.Pensive1,ArmR2", "SubId": "Forefront"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "吐了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Ema.Angry1,ArmR3", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema014"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "看到可可的反应，艾玛的脸色变得有些严肃。<br>\n但很快，她就无奈地露出沮丧的神情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "（看样子，大家是不可能齐心协力的吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema015"]}},
    {"op": "HidePrinter", "line": 168, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 169, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "5_2"}},
    {"op": "HideActors", "line": 170, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "MainBackground-Forefront", "Ema-Front", "Coco-Forefront"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 171, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Forefront", "LogWarning": 1}},
    {"op": "Wait", "line": 172, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "这时，玛格往前走了一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "艾玛你真的很了不起。<br>\n像我呢，就做不到信任所有人。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo003"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "玛格……可、可是，<br>\n如果我们不团结在一起的话！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema016"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Smile1,ArmR6", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "呵呵呵，别担心。<br>\n我同意大家一起齐心协力越狱的想法，<br>\n因为这样做比较合理。我会帮助你的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo004"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "真的！？太、太好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema017"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "可可，你也想离开这里吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo005"]}},
    {"op": "HideAllCharacters", "line": 195, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 196, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "呃，算是吧……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Coco004"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "见可可不情不愿地点头，<br>\n玛格便微微一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative018"]}},
    {"op": "HideAllCharacters", "line": 202, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 204, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1,ArmR2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "我们来正式制定一下越狱的计划吧。<br>\n首先我们得确定团队的领导者。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo006"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "从各位之前的表现来看，<br>\n我认为让艾玛担任队长比较合适。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo007"]}},
    {"op": "ModifyCharacterExtended", "line": 211, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "什么，我、我吗……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema018"]}},
    {"op": "PlayBgm", "line": 215, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "嗯，是你一直在努力团结大家。<br>\n有人反对吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo008"]}},
    {"op": "HideAllCharacters", "line": 221, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "没有人提出异议。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative019"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "（原来，大家并不讨厌我啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema019"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "作为团队核心得到了大家的信任，<br>\n这让艾玛不禁绽放出花一般的笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR8,ArmL8", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Margo.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "对了，要不要做下那个仪式？<br>\n大家手叠在一起，大喊鼓舞士气的那个。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Sherry001"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "亏你能想到这么尴尬的仪式。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Margo.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "是吗，我觉得很好啊。<br>\n确实需要一个仪式把大家的心团结在一起。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo009"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "玛格露出妖艳的微笑，<br>\n向前伸出手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Margo.Smile,ArmR5", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "接下来就靠你了，艾玛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo010"]}},
    {"op": "HideAllCharacters", "line": 247, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "雪莉和梅露露将手放在玛格的手上，接着，<br>\n汉娜和可可也不情不愿地跟着把手放了上去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative022"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "而米莉亚也小心翼翼地把手轻轻放了上去，<br>\n尽量不碰到任何人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative023"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "接着，艾玛把手放到最上面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 255, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "我们所有人都要一起活着离开这里！<br>\n说好了！谁都不准背叛大家！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema020"]}},
    {"op": "HideAllCharacters", "line": 259, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "少女们的心，如同重叠的手心般紧紧团结在一起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative025"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "（感觉有底气多了……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema021"]}},
    {"op": "ModifyCharacterExtended", "line": 265, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "那我们赶快开始制定——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema022"]}},
    {"op": "HideAllCharacters", "line": 269, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-,ArmR1,ArmL1,ArmR1-Option-All", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 271, "indent": 0, "params": {"ActorIds": ["AnAn-Middle"], "Loop": 0, "ScenePositionY": "30", "Duration": "0.6"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "艾玛刚信心十足地开口宣言，<br>\n安安却突然无力地蹲了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative026"]}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "她不知何时离开了众人的包围圈，<br>\n面色铁青，似乎身体不太舒服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative027"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "安安，你怎么了……？<br>\n没事吧……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema023"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_AnAn002"]}},
    {"op": "HideAllCharacters", "line": 281, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "她没有说话，只是摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative028"]}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "又、又贫血了吗……<br>\n最好先带她去一趟<br>\n医务室……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Meruru001"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "（安安好像身体比较虚弱，<br>\n　精神消耗肯定也不小……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema024"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "而且，米莉亚小姐看起来……也、也有点不舒服……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 293, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 294, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Surprised1,ArmR4,ArmL3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "欸～", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Miria004"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "米莉亚惊讶得往后一退，<br>\n猛地摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Surprised1,ArmR2,ArmL2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "没有不舒服啦！我好着呢！<br>\n大叔我好得很啦！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Miria005"]}},
    {"op": "ModifyCharacterExtended", "line": 304, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "不、不是的。我一直有点担心你……<br>\n感觉你特别消沉，我就很担心……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Meruru003"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "你一直都很累吧……！<br>\n我看你……好像负担很重的样子……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Meruru004"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "那是因为沾染上了大叔的习性，<br>\n平时就半死不活的啦！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Miria006"]}},
    {"op": "ModifyCharacterExtended", "line": 312, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "今、今天就让我来照顾你一下，好吗……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Meruru005"]}},
    {"op": "AnimateActorExtended", "line": 316, "indent": 0, "params": {"ActorIds": ["Meruru-Middle"], "Loop": 0, "ScenePositionX": "45", "Duration": "0.6"}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "泪眼婆娑的梅露露一步步靠近米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative030"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "不要勉强自己了，<br>\n你们一起去医务室好好休息吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema025"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1,ArmR6,ArmL6", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "呜呜……谢谢你……<br>\n对不起，我太没用了……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Miria007"]}},
    {"op": "HideAllCharacters", "line": 326, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "在梅露露的陪同下，<br>\n安安和米莉亚离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative031"]}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "转眼间可可也不见了踪影。<br>\n剩下的只有艾玛、雪莉和汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative032"]}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "以及玛格。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative033"]}},
    {"op": "ModifyCharacterExtended", "line": 334, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "你们啊，究竟有没有干劲啊！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 338, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 339, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "算了……毕竟昨晚都被折磨得精疲力竭。<br>\n不过我觉得是时候紧张起来了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema026"]}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "艾玛放心不下的是<br>\n奈叶香在失踪前留下的话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative034"]}},
    {"op": "ModifyCharacterExtended", "line": 345, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 347, "indent": 0, "params": {"Text": "（她之前说没有时间了……<br>\n　难道说有什么时间限制吗）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema027"]}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "（如果真是那样，<br>\n　我们得赶紧行动起来……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema028"]}},
    {"op": "ModifyCharacterExtended", "line": 351, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "我们几个人<br>\n先商量一下越狱计划吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema029"]}},
    {"op": "HideAllCharacters", "line": 355, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 357, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR10,ArmL1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 358, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Margo.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "这样比较好，<br>\n人少点方便统一意见。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo011"]}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "可是放风时间<br>\n马上就要结束了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 364, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "可恶！总是事不如愿！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Hanna003"]}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "那我们就等晚餐后的放风时间<br>\n再碰面吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo012"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Margo.Normal1,ArmR6", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "正好我有东西想给你们看，<br>\n你们可以来我的房间集合吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo013"]}},
    {"op": "PrintTextModified", "line": 374, "indent": 0, "params": {"Text": "你的房间……是指地下的牢房？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema030"]}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "（那牢房很小……不过四个人的话，也许能塞得下？<br>\n　毕竟她的室友奈叶香不在）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Ema031"]}},
    {"op": "HideAllCharacters", "line": 378, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 380, "indent": 0, "params": {"Text": "玛格点点头，<br>\n随后便露出意味深长的笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Narrative035"]}},
    {"op": "ModifyCharacterExtended", "line": 382, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmR1,ArmL4", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 384, "indent": 0, "params": {"Text": "嗯，欢迎大家来我的房间做客。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv02_Margo014"]}},
    {"op": "Gosub", "line": 386, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 388, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv03", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv02_Narrative001": "噩梦般的魔女审判已成过往。<br>\n翌日，少女们来到会客厅集合。",
  "0102Adv02_Narrative002": "在早餐时间，艾玛向众人提议<br>\n大家先坐到一起好好谈一谈。",
  "0102Adv02_Narrative003": "于是，少女们迈着沉重的步伐<br>\n陆续走进了会客厅。",
  "0102Adv02_Narrative004": "——然而。",
  "0102Adv02_Alisa001": "你跟我们都不是一路人好吗！",
  "0102Adv02_Narrative005": "很快就起了冲突。<br>\n亚里沙对米莉亚怒吼道。",
  "0102Adv02_Alisa002": "你个大叔凑过来干什么！<br>\n你跟我们不一样！滚出去！",
  "0102Adv02_Miria001": "呀！对、对不起！",
  "0102Adv02_Ema001": "是我提议让大家一起谈一谈的，<br>\n米莉亚她没有错！",
  "0102Adv02_Narrative006": "艾玛立即介入调解两人的冲突。",
  "0102Adv02_Ema002": "我们应该互帮互助才对。<br>\n所以，大家一起谈谈吧。",
  "0102Adv02_Ema003": "米莉亚，亚里沙，<br>\n我希望你们都能留在这里。",
  "0102Adv02_Alisa003": "……你想说的就这些？<br>\n我可不想搞什么你帮我我帮你的。",
  "0102Adv02_Alisa004": "谁想跟骗人精做朋友。<br>\n我连那家伙的脸都不想看到。",
  "0102Adv02_Narrative007": "丢下这番话后，<br>\n亚里沙离开了会客厅。",
  "0102Adv02_Miria002": "呜、呜呜……看来大叔我真的很烦人吧……<br>\n对不起，害你们感到不舒服……",
  "0102Adv02_Ema004": "（虽然米莉亚身上的确谜团重重……<br>\n　不过我想暂时先相信她）",
  "0102Adv02_Narrative008": "艾玛带着几分紧张，转身对米莉亚说道。",
  "0102Adv02_Ema005": "没关系的。米莉亚，我叫你来<br>\n是希望你也能帮助大家。",
  "0102Adv02_Ema006": "啊，对了，我可以直接叫你<br>\n米莉亚吗……？",
  "0102Adv02_Miria003": "当然可以……！",
  "0102Adv02_Narrative009": "米莉亚十分激动，<br>\n连连用力点头。",
  "0102Adv02_Narrative010": "亚里沙已经离开了现场。<br>\n艾玛看向仍在场的几名少女。",
  "0102Adv02_Narrative011": "米莉亚、汉娜、雪莉、梅露露、<br>\n可可、玛格、安安。<br>\n再算上艾玛，一共8个人。",
  "0102Adv02_Ema007": "说真的，我们必须得逃出这里。",
  "0102Adv02_Narrative012": "面对一众囚犯少女，<br>\n艾玛毅然开口说道。",
  "0102Adv02_Ema008": "蕾雅之前呼吁我们老实遵守规定，<br>\n可是留在这里我们也无法得救。",
  "0102Adv02_Narrative013": "艾玛原本就在四处游说越狱的事，<br>\n雪莉、汉娜、梅露露三人<br>\n也早就是她的同伴了。",
  "0102Adv02_Narrative014": "听到艾玛的话，她们三人都用力点头。<br>\n……但，问题在于原先不愿意配合的几位少女。",
  "0102Adv02_Margo001": "话虽如此，<br>\n但违反规定的话，就要被带去惩罚室哦。",
  "0102Adv02_AnAn001": "『吾辈觉得不应该做违规的事』",
  "0102Adv02_Coco001": "我也想逃出这个鬼地方啊，<br>\n可是反抗的话，一个不走运甚至可能会被看守干掉啊。",
  "0102Adv02_Margo002": "就像二阶堂希罗一样。",
  "0102Adv02_Narrative015": "艾玛痛苦地低下头。",
  "0102Adv02_Ema009": "希罗、诺亚……还有蕾雅。<br>\n大家被抓到这里来以后已经牺牲了三个人。",
  "0102Adv02_Coco002": "蕾雅她是自作自受吧。<br>\n谁让她杀人了。",
  "0102Adv02_Ema010": "如果不是在这种处境下，就不会闹出这种事了。<br>\n就像奈叶香说的那样，我们都被玩弄了！",
  "0102Adv02_Ema011": "再在这里待下去，<br>\n等待我们的只有最悲惨的未来。",
  "0102Adv02_Ema012": "一定有什么办法，<br>\n可以不被它们发现偷偷逃出去。",
  "0102Adv02_Ema013": "我们一起逃走吧！<br>\n只要大家齐心协力，一定能找到出路！",
  "0102Adv02_Coco003": "吐了。",
  "0102Adv02_Ema014": "……",
  "0102Adv02_Narrative016": "看到可可的反应，艾玛的脸色变得有些严肃。<br>\n但很快，她就无奈地露出沮丧的神情。",
  "0102Adv02_Ema015": "（看样子，大家是不可能齐心协力的吧……）",
  "0102Adv02_Narrative017": "这时，玛格往前走了一步。",
  "0102Adv02_Margo003": "艾玛你真的很了不起。<br>\n像我呢，就做不到信任所有人。",
  "0102Adv02_Ema016": "玛格……可、可是，<br>\n如果我们不团结在一起的话！",
  "0102Adv02_Margo004": "呵呵呵，别担心。<br>\n我同意大家一起齐心协力越狱的想法，<br>\n因为这样做比较合理。我会帮助你的。",
  "0102Adv02_Ema017": "真的！？太、太好了……",
  "0102Adv02_Margo005": "可可，你也想离开这里吧？",
  "0102Adv02_Coco004": "呃，算是吧……",
  "0102Adv02_Narrative018": "见可可不情不愿地点头，<br>\n玛格便微微一笑。",
  "0102Adv02_Margo006": "我们来正式制定一下越狱的计划吧。<br>\n首先我们得确定团队的领导者。",
  "0102Adv02_Margo007": "从各位之前的表现来看，<br>\n我认为让艾玛担任队长比较合适。",
  "0102Adv02_Ema018": "什么，我、我吗……！？",
  "0102Adv02_Margo008": "嗯，是你一直在努力团结大家。<br>\n有人反对吗？",
  "0102Adv02_Narrative019": "没有人提出异议。",
  "0102Adv02_Ema019": "（原来，大家并不讨厌我啊……）",
  "0102Adv02_Narrative020": "作为团队核心得到了大家的信任，<br>\n这让艾玛不禁绽放出花一般的笑容。",
  "0102Adv02_Sherry001": "对了，要不要做下那个仪式？<br>\n大家手叠在一起，大喊鼓舞士气的那个。",
  "0102Adv02_Hanna001": "亏你能想到这么尴尬的仪式。",
  "0102Adv02_Margo009": "是吗，我觉得很好啊。<br>\n确实需要一个仪式把大家的心团结在一起。",
  "0102Adv02_Narrative021": "玛格露出妖艳的微笑，<br>\n向前伸出手。",
  "0102Adv02_Margo010": "接下来就靠你了，艾玛。",
  "0102Adv02_Narrative022": "雪莉和梅露露将手放在玛格的手上，接着，<br>\n汉娜和可可也不情不愿地跟着把手放了上去。",
  "0102Adv02_Narrative023": "而米莉亚也小心翼翼地把手轻轻放了上去，<br>\n尽量不碰到任何人。",
  "0102Adv02_Narrative024": "接着，艾玛把手放到最上面。",
  "0102Adv02_Ema020": "我们所有人都要一起活着离开这里！<br>\n说好了！谁都不准背叛大家！",
  "0102Adv02_Narrative025": "少女们的心，如同重叠的手心般紧紧团结在一起。",
  "0102Adv02_Ema021": "（感觉有底气多了……！）",
  "0102Adv02_Ema022": "那我们赶快开始制定——",
  "0102Adv02_Narrative026": "艾玛刚信心十足地开口宣言，<br>\n安安却突然无力地蹲了下来。",
  "0102Adv02_Narrative027": "她不知何时离开了众人的包围圈，<br>\n面色铁青，似乎身体不太舒服。",
  "0102Adv02_Ema023": "安安，你怎么了……？<br>\n没事吧……？",
  "0102Adv02_AnAn002": "…………",
  "0102Adv02_Narrative028": "她没有说话，只是摇了摇头。",
  "0102Adv02_Meruru001": "又、又贫血了吗……<br>\n最好先带她去一趟<br>\n医务室……",
  "0102Adv02_Ema024": "（安安好像身体比较虚弱，<br>\n　精神消耗肯定也不小……）",
  "0102Adv02_Meruru002": "而且，米莉亚小姐看起来……也、也有点不舒服……",
  "0102Adv02_Miria004": "欸～",
  "0102Adv02_Narrative029": "米莉亚惊讶得往后一退，<br>\n猛地摇头。",
  "0102Adv02_Miria005": "没有不舒服啦！我好着呢！<br>\n大叔我好得很啦！",
  "0102Adv02_Meruru003": "不、不是的。我一直有点担心你……<br>\n感觉你特别消沉，我就很担心……",
  "0102Adv02_Meruru004": "你一直都很累吧……！<br>\n我看你……好像负担很重的样子……",
  "0102Adv02_Miria006": "那是因为沾染上了大叔的习性，<br>\n平时就半死不活的啦！",
  "0102Adv02_Meruru005": "今、今天就让我来照顾你一下，好吗……",
  "0102Adv02_Narrative030": "泪眼婆娑的梅露露一步步靠近米莉亚。",
  "0102Adv02_Ema025": "不要勉强自己了，<br>\n你们一起去医务室好好休息吧。",
  "0102Adv02_Miria007": "呜呜……谢谢你……<br>\n对不起，我太没用了……",
  "0102Adv02_Narrative031": "在梅露露的陪同下，<br>\n安安和米莉亚离开了会客厅。",
  "0102Adv02_Narrative032": "转眼间可可也不见了踪影。<br>\n剩下的只有艾玛、雪莉和汉娜。",
  "0102Adv02_Narrative033": "以及玛格。",
  "0102Adv02_Hanna002": "你们啊，究竟有没有干劲啊！？",
  "0102Adv02_Ema026": "算了……毕竟昨晚都被折磨得精疲力竭。<br>\n不过我觉得是时候紧张起来了……",
  "0102Adv02_Narrative034": "艾玛放心不下的是<br>\n奈叶香在失踪前留下的话。",
  "0102Adv02_Ema027": "（她之前说没有时间了……<br>\n　难道说有什么时间限制吗）",
  "0102Adv02_Ema028": "（如果真是那样，<br>\n　我们得赶紧行动起来……）",
  "0102Adv02_Ema029": "我们几个人<br>\n先商量一下越狱计划吧。",
  "0102Adv02_Margo011": "这样比较好，<br>\n人少点方便统一意见。",
  "0102Adv02_Sherry002": "可是放风时间<br>\n马上就要结束了。",
  "0102Adv02_Hanna003": "可恶！总是事不如愿！",
  "0102Adv02_Margo012": "那我们就等晚餐后的放风时间<br>\n再碰面吧。",
  "0102Adv02_Margo013": "正好我有东西想给你们看，<br>\n你们可以来我的房间集合吗？",
  "0102Adv02_Ema030": "你的房间……是指地下的牢房？",
  "0102Adv02_Ema031": "（那牢房很小……不过四个人的话，也许能塞得下？<br>\n　毕竟她的室友奈叶香不在）",
  "0102Adv02_Narrative035": "玛格点点头，<br>\n随后便露出意味深长的笑容。",
  "0102Adv02_Margo014": "嗯，欢迎大家来我的房间做客。"
}
}
