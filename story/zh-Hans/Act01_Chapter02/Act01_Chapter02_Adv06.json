    {"op": "label", "name": "Scene1-2-6", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "ModifyCharacterExtended", "line": 17, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1,ArmR8"}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "她的身上看起来没有伤……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Meruru001"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "呜呜……我反应太大了，好丢人……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Miria001"]}},
    {"op": "HideAllCharacters", "line": 23, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "艾玛一行人把要死要活的米莉亚<br>\n带到了医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "梅露露和安安也在医务室里面。<br>\n她们两个仿佛已成了医务室的固定出场人员。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "米莉亚激动得快要哭出来，<br>\n梅露露只好拼命安抚她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Pensive1,ArmR8"}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "大叔我总是拖大家的后腿，好丢脸……<br>\n都怪我，小沙也被吓跑了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Miria002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "那不是大叔你的错！<br>\n啊，不小心叫你大叔了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Sherry001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "随你怎么喊都好了……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Miria003"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "感觉和米莉亚在一起的时候，心情都没那么紧张了。<br>\n某种意义上来说，她也算是治愈系角色呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "是、是啊，逃跑的时候她大吵大闹的，<br>\n我都有点被她逗笑了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "不对不对，刚刚的情况很危险啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema002"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "呜呜……对不起，给你们添麻烦了……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Miria004"]}},
    {"op": "HideAllCharacters", "line": 53, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "艾玛一边苦笑<br>\n一边回想起刚才发生的事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "（奈叶香狙击了米莉亚。<br>\n　她们已经没法重归于好了吗……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema003"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "奈叶香对米莉亚表现出了明确的杀意。<br>\n艾玛感受不到奈叶香愿意和解<br>\n并协助计划的希望。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "（……我觉得，还是应该找奈叶香谈谈。<br>\n　还有亚里沙也是。<br>\n　大家一定能相互理解的……现在还来得及）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema004"]}},
    {"op": "HideAllCharacters", "line": 67, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "亚里沙小姐是怎么说的……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 72, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "梅露露给大家泡好香草茶端了过来，<br>\n正好问到这件事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "她说自己做不到，<br>\n不过我觉得，和她谈一谈的话总会有办法的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema005"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "毕竟，大家都是一心想逃出这里的……<br>\n既然亚里沙是这个计划的关键，<br>\n我一定会说服她！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema006"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "看来这件事<br>\n只能拜托艾玛你了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Pensive1,ArmR1"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "她应该不会对大叔我敞开心扉啦……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Miria005"]}},
    {"op": "HideAllCharacters", "line": 90, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 92, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 93, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 94, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 95, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [68.0, 36.0], "AppearanceAndTransition": "7_1", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 96, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 40.0], "IdAndAppearance": "AnAn.Pensive1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 98, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "AnAn-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 99, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "65", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 100, "indent": 0, "params": {"ActorIds": ["AnAn-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 101, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "艾玛忽然感觉到一股视线，<br>\n于是看向了坐在床上的安安。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative007"]}},
    {"op": "HideActors", "line": 105, "indent": 0, "params": {"ActorIds": ["AnAn-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 106, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 107, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 108, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "（安安刚才在看我……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "安安，你身体怎么样了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema008"]}},
    {"op": "HideAllCharacters", "line": 116, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "听到艾玛问话，<br>\n安安一下子扭过头去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative008"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "这时，米莉亚走到安安身边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "安安，一直躺在这里很无聊吧？<br>\n要不要和大叔我去看电影啊？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Miria006"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "…………嗯。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_AnAn001"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "（什么……！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema009"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "安安乖乖下了床，<br>\n慢悠悠地跟在米莉亚身后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative010"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "看样子，两人去了娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "……不是吧，米莉亚<br>\n到底是怎么驯服安安的？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "是、是啊，真是个出乎意料的组合……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema010"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "自从上次她们一起来医务室以后<br>\n好像很聊得来……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Meruru003"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "可能因为米莉亚小姐是年长者，<br>\n安安对她比较放心吧。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "哦，类似于监护人的角色吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Sherry005"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "米莉亚人很好呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema011"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "（看来她应该真的不是幕后黑手）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema012"]}},
    {"op": "HideAllCharacters", "line": 161, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "米莉亚和安安有说有笑地离开了。<br>\n光是看到两个人关系很好的样子，艾玛的脸上也灿烂了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile1"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "好！休息时间结束！<br>\n我去找找看亚里沙。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema013"]}},
    {"op": "HideAllCharacters", "line": 169, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "不、不要太勉强自己哦……？<br>\n要是累了就休息一下吧。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Meruru005"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "那，我和梅露露<br>\n去玛格的房间一趟咯？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Sherry006"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "热气球的制作地点<br>\n在玛格的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative013"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "现在汉娜肯定在<br>\n一刻不停地拼命缝制吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "嗯，我也想帮上大家的忙……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Meruru006"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "说起来，她们之前叫我不要过去耶。<br>\n说我只会碍手碍脚，太过分了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 189, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "啊哈哈……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema014"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "艾玛不禁苦笑起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 196, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "（虽然途中有些挫折，<br>\n　但我第一次感受到了成功越狱的希望）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema015"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "（热气球在一步步地接近完工……<br>\n　就差一点了。我们一定可以——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Ema016"]}},
    {"op": "HideAllCharacters", "line": 202, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "难掩心中兴奋的艾玛<br>\n一步一跳地离开了医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv06_Narrative016"]}},
    {"op": "Gosub", "line": 206, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 208, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv07", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv06_Meruru001": "她的身上看起来没有伤……",
  "0102Adv06_Miria001": "呜呜……我反应太大了，好丢人……",
  "0102Adv06_Narrative001": "艾玛一行人把要死要活的米莉亚<br>\n带到了医务室。",
  "0102Adv06_Narrative002": "梅露露和安安也在医务室里面。<br>\n她们两个仿佛已成了医务室的固定出场人员。",
  "0102Adv06_Narrative003": "米莉亚激动得快要哭出来，<br>\n梅露露只好拼命安抚她。",
  "0102Adv06_Miria002": "大叔我总是拖大家的后腿，好丢脸……<br>\n都怪我，小沙也被吓跑了。",
  "0102Adv06_Sherry001": "那不是大叔你的错！<br>\n啊，不小心叫你大叔了。",
  "0102Adv06_Miria003": "随你怎么喊都好了……",
  "0102Adv06_Sherry002": "感觉和米莉亚在一起的时候，心情都没那么紧张了。<br>\n某种意义上来说，她也算是治愈系角色呢。",
  "0102Adv06_Ema001": "是、是啊，逃跑的时候她大吵大闹的，<br>\n我都有点被她逗笑了……",
  "0102Adv06_Ema002": "不对不对，刚刚的情况很危险啊！",
  "0102Adv06_Miria004": "呜呜……对不起，给你们添麻烦了……",
  "0102Adv06_Narrative004": "艾玛一边苦笑<br>\n一边回想起刚才发生的事。",
  "0102Adv06_Ema003": "（奈叶香狙击了米莉亚。<br>\n　她们已经没法重归于好了吗……）",
  "0102Adv06_Narrative005": "奈叶香对米莉亚表现出了明确的杀意。<br>\n艾玛感受不到奈叶香愿意和解<br>\n并协助计划的希望。",
  "0102Adv06_Ema004": "（……我觉得，还是应该找奈叶香谈谈。<br>\n　还有亚里沙也是。<br>\n　大家一定能相互理解的……现在还来得及）",
  "0102Adv06_Meruru002": "亚里沙小姐是怎么说的……？",
  "0102Adv06_Narrative006": "梅露露给大家泡好香草茶端了过来，<br>\n正好问到这件事。",
  "0102Adv06_Ema005": "她说自己做不到，<br>\n不过我觉得，和她谈一谈的话总会有办法的。",
  "0102Adv06_Ema006": "毕竟，大家都是一心想逃出这里的……<br>\n既然亚里沙是这个计划的关键，<br>\n我一定会说服她！",
  "0102Adv06_Sherry003": "看来这件事<br>\n只能拜托艾玛你了。",
  "0102Adv06_Miria005": "她应该不会对大叔我敞开心扉啦……",
  "0102Adv06_Narrative007": "艾玛忽然感觉到一股视线，<br>\n于是看向了坐在床上的安安。",
  "0102Adv06_Ema007": "（安安刚才在看我……？）",
  "0102Adv06_Ema008": "安安，你身体怎么样了？",
  "0102Adv06_Narrative008": "听到艾玛问话，<br>\n安安一下子扭过头去。",
  "0102Adv06_Narrative009": "这时，米莉亚走到安安身边。",
  "0102Adv06_Miria006": "安安，一直躺在这里很无聊吧？<br>\n要不要和大叔我去看电影啊？",
  "0102Adv06_AnAn001": "…………嗯。",
  "0102Adv06_Ema009": "（什么……！？）",
  "0102Adv06_Narrative010": "安安乖乖下了床，<br>\n慢悠悠地跟在米莉亚身后。",
  "0102Adv06_Narrative011": "看样子，两人去了娱乐室。",
  "0102Adv06_Sherry004": "……不是吧，米莉亚<br>\n到底是怎么驯服安安的？",
  "0102Adv06_Ema010": "是、是啊，真是个出乎意料的组合……",
  "0102Adv06_Meruru003": "自从上次她们一起来医务室以后<br>\n好像很聊得来……",
  "0102Adv06_Meruru004": "可能因为米莉亚小姐是年长者，<br>\n安安对她比较放心吧。",
  "0102Adv06_Sherry005": "哦，类似于监护人的角色吗？",
  "0102Adv06_Ema011": "米莉亚人很好呢。",
  "0102Adv06_Ema012": "（看来她应该真的不是幕后黑手）",
  "0102Adv06_Narrative012": "米莉亚和安安有说有笑地离开了。<br>\n光是看到两个人关系很好的样子，艾玛的脸上也灿烂了起来。",
  "0102Adv06_Ema013": "好！休息时间结束！<br>\n我去找找看亚里沙。",
  "0102Adv06_Meruru005": "不、不要太勉强自己哦……？<br>\n要是累了就休息一下吧。",
  "0102Adv06_Sherry006": "那，我和梅露露<br>\n去玛格的房间一趟咯？",
  "0102Adv06_Narrative013": "热气球的制作地点<br>\n在玛格的牢房。",
  "0102Adv06_Narrative014": "现在汉娜肯定在<br>\n一刻不停地拼命缝制吧。",
  "0102Adv06_Meruru006": "嗯，我也想帮上大家的忙……！",
  "0102Adv06_Sherry007": "说起来，她们之前叫我不要过去耶。<br>\n说我只会碍手碍脚，太过分了！",
  "0102Adv06_Ema014": "啊哈哈……",
  "0102Adv06_Narrative015": "艾玛不禁苦笑起来。",
  "0102Adv06_Ema015": "（虽然途中有些挫折，<br>\n　但我第一次感受到了成功越狱的希望）",
  "0102Adv06_Ema016": "（热气球在一步步地接近完工……<br>\n　就差一点了。我们一定可以——）",
  "0102Adv06_Narrative016": "难掩心中兴奋的艾玛<br>\n一步一跳地离开了医务室。"
}
}
