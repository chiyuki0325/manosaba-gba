  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-16", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "——时间来到计划执行日的早晨。<br>\n艾玛在自己的牢房里坐起上半身。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "她的脸上有几分阴郁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "（明明今天是越狱的日子……<br>\n　可这内心的躁动是怎么一回事）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema001"]}},
    {"op": "HideAllCharacters", "line": 24, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 27, "indent": 0, "params": {"SfxPath": "Sfx_49", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "艾玛忽然听见过道那边传来了奔跑的声音，<br>\n仿佛在呼应她不祥的预感。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative003"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "冲进艾玛牢房的<br>\n是雪莉和汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative004"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "两人都跑得上气不接下气，<br>\n面色铁青。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "艾玛，不、不、不好了！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Sherry001"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "发生什么事了！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema002"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "总、总之，你先过来！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 45, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 47, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "艾玛立即下床，<br>\n跟着她们跑了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative006"]}},
    {"op": "ResetText", "line": 51, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 52, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 53, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 55, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "18_1"}},
    {"op": "ModifyBackgroundExtended", "line": 56, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 57, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 59, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "天啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema003"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "艾玛赶到现场后，<br>\n直接瘫坐在地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "我们努力做出来的……<br>\n可不是这样的东西……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Hanna002"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "到底是谁干的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema004"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "被撕得破破烂烂的碎布<br>\n散得满地都是。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative008"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "载物篮也被拆得七零八散，<br>\n——热气球被无情地毁了个一干二净。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative009"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "其他少女听见动静后<br>\n也都接连走了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative010"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "众人望着被毁得惨不忍睹的热气球，<br>\n不知所措地愣在原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative011"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "残酷的现实摆在她们的面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative012"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "——越狱，失败了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL7"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "喂，大叔！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Alisa001"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "呜……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria001"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "亚里沙揪起米莉亚脖子上的丝带，<br>\n逼至跟前瞪着她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative014"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "应该只有你知道热气球藏在哪里才对，<br>\n难道是你干的！？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Alisa002"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "…………", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria002"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "米、米莉亚小姐，请说点什么吧……<br>\n否则大家就会……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Meruru001"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "真是你干的吗，大叔？<br>\n你可不像会干出这种离谱事的人啊。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Coco001"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "你真的，骗了我们……？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Coco002"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "真遗憾。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Margo001"]}},
    {"op": "HideAllCharacters", "line": 122, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "（米莉亚怎么可能做出这种事，<br>\n　这不可……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema005"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "艾玛的脑海里掠过米莉亚不经意间吐露的真心话——<br>\n“不想回去”。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative015"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "她的嘴不停地一张一合——<br>\n可就是说不出维护米莉亚的话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative016"]}},
    {"op": "PlaySfxModified", "line": 131, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "这时，大家的手机收到了通知，<br>\n每个人都拿出自己的手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative017"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "『因收到监视猫头鹰的报告，<br>\n　现在此通知各位……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative018"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "『佐伯米莉亚小姐<br>\n　曾于深夜门禁时间外出』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative019"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "『由于违反规定，<br>\n　现决定将其送往惩罚室……真遗憾』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Surprised1,ArmR10,ArmL4"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "——", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria003"]}},
    {"op": "HideAllCharacters", "line": 145, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "典狱长的通知<br>\n仿佛印证了米莉亚的作案事实。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "原来如此……你深夜跑出来<br>\n就是来这里破坏了热气球是吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Sherry002"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "太过分了！<br>\n你究竟为什么要这么做！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 156, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "“呵呵，啊哈哈！”<br>\n可可捧腹大笑起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "那还用说吗？因为大叔是幕后黑手啊。<br>\n她不想让我们逃走所以这么干了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "我说得没错吧！？喂！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Coco004"]}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Pensive1,ArmR10,ArmL4"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "不是……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria004"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "看到可可欲哭无泪的样子，<br>\n米莉亚反驳的声音渐弱，无力地垂下脑袋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Pensive1,ArmR6,ArmL6"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "……大家，对不起。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria005"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "小艾，抱歉……<br>\n明明你那么信任我。<br>\n真的很对不起。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria006"]}},
    {"op": "HideAllCharacters", "line": 183, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "（原来真的是米莉亚<br>\n　毁掉了热气球啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "这时，正如之前典狱长通知所说，<br>\n看守过来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative024"]}},
    {"op": "HideAllCharacters", "line": 191, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "它把米莉亚粗暴地抱了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative025"]}},
    {"op": "HidePrinter", "line": 195, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 196, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["60", "200", "true", "0.3", "#000000"], "ScenePosition": [50.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 197, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [20.0, 36.0], "AppearanceAndTransition": "18_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Rotation": [0.0, 0.0, 40.0], "Scale": [1.899999976158142], "Lazy": 0, "ScenePosition": [60.0, 48.0], "IdAndAppearance": "Miria.Fearful1,ArmR6,ArmL6", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 199, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Miria-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 200, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 201, "indent": 0, "params": {"ActorIds": ["Miria-Front"], "Loop": 0, "ScenePositionY": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 202, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "哇、哇啊，<br>\n住、住手……！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria007"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "我不要去惩罚室！<br>\n谁来救救我……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Miria008"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "在看守的束缚下，<br>\n米莉亚面色惨白，表情因恐惧而狰狞。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative026"]}},
    {"op": "AnimateActorExtended", "line": 210, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Miria-Front"], "Loop": 0}},
    {"op": "HideAllCharacters", "line": 211, "indent": 0, "params": {"Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 212, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "然而，谁也没有对她伸出援手。<br>\n她们纷纷移开视线，低下了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative027"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "就这样，<br>\n看守将拼命挣扎的米莉亚带走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative028"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "米莉亚走后，<br>\n现场沉默了好一阵子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative029"]}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "谁也没有说话，<br>\n唯有空虚的气氛占据全场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative030"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "艾玛紧紧握拳，抬起头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR1"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "（不能因为这点事就放弃！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema007"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "各位，虽然这次失败了，<br>\n但我们可以再做个热气球！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema008"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "也可以不做热气球，<br>\n而是去探索其他方法。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema009"]}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "我不会放弃的！<br>\n我一定会和大家一起越狱！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "就是啊！<br>\n想想看，我们还有亚里沙在。<br>\n只要再做个热气球就好了嘛！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "请不要把话说得那么轻松。<br>\n你知道我这段时间有多辛苦吗……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 242, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "……不过，艾玛说得没错。<br>\n我也不想放弃。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Hanna005"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "热气球被毁掉了，重新做一个就好。<br>\n无论做多少次我都奉陪到底，哼。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "汉娜，雪莉，<br>\n谢谢你们……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema011"]}},
    {"op": "HideAllCharacters", "line": 252, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 253, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "虽说有点失望，<br>\n不过也罢，我们重新制定作战计划吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Margo002"]}},
    {"op": "HideAllCharacters", "line": 257, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "嗯。各位，<br>\n我们先回一趟会客厅吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema012"]}},
    {"op": "HideAllCharacters", "line": 262, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "尽管少女们有些垂头丧气，<br>\n但她们还是迈着无力的步伐走了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative032"]}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "……安安小姐？<br>\n你怎么了，身体又不舒服吗……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 270, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "听见梅露露的声音，<br>\n走在前面的艾玛回过头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative033"]}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "安安正瘫坐在<br>\n被粉碎得不成样的热气球旁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative034"]}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Angry1,Angle01/Option_Arms-"}},
    {"op": "PlaySfxModified", "line": 281, "indent": 0, "params": {"SfxPath": "Sfx_50", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "她怒视着地面，<br>\n一拳又一拳地狠狠捶地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative035"]}},
    {"op": "PlaySfxModified", "line": 285, "indent": 0, "params": {"SfxPath": "Sfx_50", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "像是发自肺腑的感到不甘心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative036"]}},
    {"op": "HideAllCharacters", "line": 289, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 292, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 293, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "心情很难平复吧。<br>\n我也特别不甘心。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Margo003"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "（安安……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema013"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "安安小姐……我们回去吧？<br>\n你这样会受伤的……一起回去吧……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 301, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 302, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "梅露露轻轻抚摸她的背，<br>\n但她就是坐在原地不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative037"]}},
    {"op": "ResetText", "line": 306, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 307, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 308, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 310, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 311, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 312, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "本来还打算在会客厅开个作战会议，<br>\n但痛失热气球的无力感久久挥之不去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative038"]}},
    {"op": "PlayBgm", "line": 316, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "最后还是很快就解散了，<br>\n于是艾玛回到自己的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative039"]}},
    {"op": "ModifyCharacterExtended", "line": 320, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "（米莉亚……<br>\n　你为什么要这么做？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema014"]}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "（明明热气球是我们的希望，<br>\n　亚里沙也答应帮我们了……<br>\n　明明我们这次终于有机会逃出去了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema015"]}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "米莉亚被关进了惩罚室。<br>\n艾玛回想起以前偷偷看过<br>\n惩罚室里的模样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative040"]}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "（我记得，那里放了很多拷问用具……<br>\n　希望她不要受到太过分的对待……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema016"]}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "（要不要去看看情况……？可是……<br>\n　我不知道该对米莉亚<br>\n　说些什么……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema017"]}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "期望越大，<br>\n失望也就越深。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative041"]}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "艾玛蜷缩起身子，<br>\n准备入睡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative042"]}},
    {"op": "HideAllCharacters", "line": 336, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 337, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 339, "indent": 0, "params": {"Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [10.0, 70.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "（什么都不想思考，<br>\n　好想忘掉一切……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema018"]}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "（明天再开始努力吧。<br>\n　只要有大家在，一定没问题的……<br>\n　现在就好好休息吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Ema019"]}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "艾玛的意识<br>\n渐渐被吸入黑暗深渊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv16_Narrative043"]}},
    {"op": "Gosub", "line": 347, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 349, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv17", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv16_Narrative001": "——时间来到计划执行日的早晨。<br>\n艾玛在自己的牢房里坐起上半身。",
  "0102Adv16_Narrative002": "她的脸上有几分阴郁。",
  "0102Adv16_Ema001": "（明明今天是越狱的日子……<br>\n　可这内心的躁动是怎么一回事）",
  "0102Adv16_Narrative003": "艾玛忽然听见过道那边传来了奔跑的声音，<br>\n仿佛在呼应她不祥的预感。",
  "0102Adv16_Narrative004": "冲进艾玛牢房的<br>\n是雪莉和汉娜。",
  "0102Adv16_Narrative005": "两人都跑得上气不接下气，<br>\n面色铁青。",
  "0102Adv16_Sherry001": "艾玛，不、不、不好了！！",
  "0102Adv16_Ema002": "发生什么事了！？",
  "0102Adv16_Hanna001": "总、总之，你先过来！",
  "0102Adv16_Narrative006": "艾玛立即下床，<br>\n跟着她们跑了起来。",
  "0102Adv16_Ema003": "天啊……",
  "0102Adv16_Narrative007": "艾玛赶到现场后，<br>\n直接瘫坐在地。",
  "0102Adv16_Hanna002": "我们努力做出来的……<br>\n可不是这样的东西……",
  "0102Adv16_Ema004": "到底是谁干的……",
  "0102Adv16_Narrative008": "被撕得破破烂烂的碎布<br>\n散得满地都是。",
  "0102Adv16_Narrative009": "载物篮也被拆得七零八散，<br>\n——热气球被无情地毁了个一干二净。",
  "0102Adv16_Narrative010": "其他少女听见动静后<br>\n也都接连走了过来。",
  "0102Adv16_Narrative011": "众人望着被毁得惨不忍睹的热气球，<br>\n不知所措地愣在原地。",
  "0102Adv16_Narrative012": "残酷的现实摆在她们的面前。",
  "0102Adv16_Narrative013": "——越狱，失败了。",
  "0102Adv16_Alisa001": "喂，大叔！",
  "0102Adv16_Miria001": "呜……",
  "0102Adv16_Narrative014": "亚里沙揪起米莉亚脖子上的丝带，<br>\n逼至跟前瞪着她。",
  "0102Adv16_Alisa002": "应该只有你知道热气球藏在哪里才对，<br>\n难道是你干的！？",
  "0102Adv16_Miria002": "…………",
  "0102Adv16_Meruru001": "米、米莉亚小姐，请说点什么吧……<br>\n否则大家就会……",
  "0102Adv16_Coco001": "真是你干的吗，大叔？<br>\n你可不像会干出这种离谱事的人啊。",
  "0102Adv16_Coco002": "你真的，骗了我们……？",
  "0102Adv16_Margo001": "真遗憾。",
  "0102Adv16_Ema005": "（米莉亚怎么可能做出这种事，<br>\n　这不可……）",
  "0102Adv16_Narrative015": "艾玛的脑海里掠过米莉亚不经意间吐露的真心话——<br>\n“不想回去”。",
  "0102Adv16_Narrative016": "她的嘴不停地一张一合——<br>\n可就是说不出维护米莉亚的话。",
  "0102Adv16_Narrative017": "这时，大家的手机收到了通知，<br>\n每个人都拿出自己的手机。",
  "0102Adv16_Narrative018": "『因收到监视猫头鹰的报告，<br>\n　现在此通知各位……』",
  "0102Adv16_Narrative019": "『佐伯米莉亚小姐<br>\n　曾于深夜门禁时间外出』",
  "0102Adv16_Narrative020": "『由于违反规定，<br>\n　现决定将其送往惩罚室……真遗憾』",
  "0102Adv16_Miria003": "——",
  "0102Adv16_Narrative021": "典狱长的通知<br>\n仿佛印证了米莉亚的作案事实。",
  "0102Adv16_Sherry002": "原来如此……你深夜跑出来<br>\n就是来这里破坏了热气球是吧。",
  "0102Adv16_Hanna003": "太过分了！<br>\n你究竟为什么要这么做！？",
  "0102Adv16_Narrative022": "“呵呵，啊哈哈！”<br>\n可可捧腹大笑起来。",
  "0102Adv16_Coco003": "那还用说吗？因为大叔是幕后黑手啊。<br>\n她不想让我们逃走所以这么干了。",
  "0102Adv16_Coco004": "我说得没错吧！？喂！！",
  "0102Adv16_Miria004": "不是……",
  "0102Adv16_Narrative023": "看到可可欲哭无泪的样子，<br>\n米莉亚反驳的声音渐弱，无力地垂下脑袋。",
  "0102Adv16_Miria005": "……大家，对不起。",
  "0102Adv16_Miria006": "小艾，抱歉……<br>\n明明你那么信任我。<br>\n真的很对不起。",
  "0102Adv16_Ema006": "（原来真的是米莉亚<br>\n　毁掉了热气球啊……）",
  "0102Adv16_Narrative024": "这时，正如之前典狱长通知所说，<br>\n看守过来了。",
  "0102Adv16_Narrative025": "它把米莉亚粗暴地抱了起来。",
  "0102Adv16_Miria007": "哇、哇啊，<br>\n住、住手……！",
  "0102Adv16_Miria008": "我不要去惩罚室！<br>\n谁来救救我……",
  "0102Adv16_Narrative026": "在看守的束缚下，<br>\n米莉亚面色惨白，表情因恐惧而狰狞。",
  "0102Adv16_Narrative027": "然而，谁也没有对她伸出援手。<br>\n她们纷纷移开视线，低下了头。",
  "0102Adv16_Narrative028": "就这样，<br>\n看守将拼命挣扎的米莉亚带走了。",
  "0102Adv16_Narrative029": "米莉亚走后，<br>\n现场沉默了好一阵子。",
  "0102Adv16_Narrative030": "谁也没有说话，<br>\n唯有空虚的气氛占据全场。",
  "0102Adv16_Narrative031": "艾玛紧紧握拳，抬起头。",
  "0102Adv16_Ema007": "（不能因为这点事就放弃！）",
  "0102Adv16_Ema008": "各位，虽然这次失败了，<br>\n但我们可以再做个热气球！",
  "0102Adv16_Ema009": "也可以不做热气球，<br>\n而是去探索其他方法。",
  "0102Adv16_Ema010": "我不会放弃的！<br>\n我一定会和大家一起越狱！",
  "0102Adv16_Sherry003": "就是啊！<br>\n想想看，我们还有亚里沙在。<br>\n只要再做个热气球就好了嘛！",
  "0102Adv16_Hanna004": "请不要把话说得那么轻松。<br>\n你知道我这段时间有多辛苦吗……",
  "0102Adv16_Hanna005": "……不过，艾玛说得没错。<br>\n我也不想放弃。",
  "0102Adv16_Hanna006": "热气球被毁掉了，重新做一个就好。<br>\n无论做多少次我都奉陪到底，哼。",
  "0102Adv16_Ema011": "汉娜，雪莉，<br>\n谢谢你们……",
  "0102Adv16_Margo002": "虽说有点失望，<br>\n不过也罢，我们重新制定作战计划吧。",
  "0102Adv16_Ema012": "嗯。各位，<br>\n我们先回一趟会客厅吧。",
  "0102Adv16_Narrative032": "尽管少女们有些垂头丧气，<br>\n但她们还是迈着无力的步伐走了起来。",
  "0102Adv16_Meruru002": "……安安小姐？<br>\n你怎么了，身体又不舒服吗……？",
  "0102Adv16_Narrative033": "听见梅露露的声音，<br>\n走在前面的艾玛回过头来。",
  "0102Adv16_Narrative034": "安安正瘫坐在<br>\n被粉碎得不成样的热气球旁。",
  "0102Adv16_Narrative035": "她怒视着地面，<br>\n一拳又一拳地狠狠捶地。",
  "0102Adv16_Narrative036": "像是发自肺腑的感到不甘心。",
  "0102Adv16_Margo003": "心情很难平复吧。<br>\n我也特别不甘心。",
  "0102Adv16_Ema013": "（安安……）",
  "0102Adv16_Meruru003": "安安小姐……我们回去吧？<br>\n你这样会受伤的……一起回去吧……？",
  "0102Adv16_Narrative037": "梅露露轻轻抚摸她的背，<br>\n但她就是坐在原地不动。",
  "0102Adv16_Narrative038": "本来还打算在会客厅开个作战会议，<br>\n但痛失热气球的无力感久久挥之不去。",
  "0102Adv16_Narrative039": "最后还是很快就解散了，<br>\n于是艾玛回到自己的牢房。",
  "0102Adv16_Ema014": "（米莉亚……<br>\n　你为什么要这么做？）",
  "0102Adv16_Ema015": "（明明热气球是我们的希望，<br>\n　亚里沙也答应帮我们了……<br>\n　明明我们这次终于有机会逃出去了）",
  "0102Adv16_Narrative040": "米莉亚被关进了惩罚室。<br>\n艾玛回想起以前偷偷看过<br>\n惩罚室里的模样。",
  "0102Adv16_Ema016": "（我记得，那里放了很多拷问用具……<br>\n　希望她不要受到太过分的对待……）",
  "0102Adv16_Ema017": "（要不要去看看情况……？可是……<br>\n　我不知道该对米莉亚<br>\n　说些什么……）",
  "0102Adv16_Narrative041": "期望越大，<br>\n失望也就越深。",
  "0102Adv16_Narrative042": "艾玛蜷缩起身子，<br>\n准备入睡。",
  "0102Adv16_Ema018": "（什么都不想思考，<br>\n　好想忘掉一切……）",
  "0102Adv16_Ema019": "（明天再开始努力吧。<br>\n　只要有大家在，一定没问题的……<br>\n　现在就好好休息吧）",
  "0102Adv16_Narrative043": "艾玛的意识<br>\n渐渐被吸入黑暗深渊。"
}
}
