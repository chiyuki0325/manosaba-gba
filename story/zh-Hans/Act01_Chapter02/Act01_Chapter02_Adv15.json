    {"op": "Wait", "line": 18, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "28_2"}},
    {"op": "ModifyBackgroundExtended", "line": 21, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 22, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛洗完澡，<br>\n独自来到中庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative002"]}},
    {"op": "PlayBgm", "line": 26, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "呼……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema001"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "夜晚的冷风吹拂，带走身体上冒出的热气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "（明天我们就要逃出这里了……<br>\n　大家已经付出这么多的努力，一定要成功）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema002"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "被四面墙壁划成方形的夜空中，有几颗星星在闪烁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative004"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（好想快点见到爸爸妈妈啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema003"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "（现在回去上学应该还来得及。<br>\n　我已经下定决心要重头来过的——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema004"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "咦，这不是小艾吗……？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria001"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "艾玛一直在仰望夜空，<br>\n直到米莉亚叫她，她才反应过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative005"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "米莉亚走进中庭，<br>\n来到艾玛身边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "你也睡不着呀……？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria002"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "嗯，感觉心情好激动。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema005"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "大叔我也是。哈哈，感觉就像旅游的前一天晚上一样兴奋。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria003"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "……我说，米莉亚，<br>\n你到底经历了什么事？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema006"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "为什么会交换身体——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema007"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "现在只有她和米莉亚两人，<br>\n于是艾玛便直截了当地问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "（前几天问她的时候被她岔开了话题，<br>\n　但我还是想了解清楚）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema008"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（我实在不觉得奈叶香所说的是<br>\n　全部的真相……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema009"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "米莉亚有些为难地皱起眉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "……真头疼啊，<br>\n大叔我不是很想说自己的事。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "嗯、嗯，这我多少能感觉到。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema010"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "但事实上也确实因为我没讲清楚，造成了很大误会。<br>\n所以，我很讨厌这样的自己。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria005"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "（原来米莉亚不喜欢自己吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "小艾你真是个好孩子。<br>\n你一直那么努力，真的很了不起。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria006"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Flushed1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "呃，怎、怎么突然夸我！？<br>\n我、我没有很了不起啦……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema012"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "看到艾玛脸红的样子，米莉亚微微一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "大叔我心想，一定要帮你们顺利回家。<br>\n……可说实话，我自己倒有点不想回去。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria007"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "（不想回去……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema013"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "可能是我不敢去面对现实……面对自己吧。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria008"]}},
    {"op": "HideAllCharacters", "line": 109, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "米莉亚像是下定决心般叹了口气，<br>\n然后慢慢开始诉说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative010"]}},
    {"op": "ModifyBackgroundExtended", "line": 113, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "220_2"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "这是大叔我认识的一个少女的故事……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria009"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "现在的年轻人<br>\n不都是把手机当成一切嘛。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria010"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "是有这样的人没错……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema014"]}},
    {"op": "ModifyBackgroundExtended", "line": 121, "indent": 0, "params": {"Id": "Stills", "Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "220_2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "那个少女也不例外，她很爱玩<ruby=\"SNS\">社交媒体</ruby>。<br>\n手机就好像是她的全世界。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria011"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "当时呢，流行一种惩罚游戏，<br>\n就是和朋友小团体<br>\n互相拍一些见不得人的照片。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria012"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "而她被小团体出卖了，<br>\n自己拍的那些不雅照被传到了SNS上。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria013"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "不仅如此，小团体的朋友还嘲笑她。<br>\n把她当做玩具，拿她当乐子。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria014"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "好过分……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema015"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "不过这只是大叔我认识的人的故事，<br>\n和我无关啦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria015"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "当时那个少女绝望得想要自杀。<br>\n然后大叔我就——", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria016"]}},
    {"op": "HideActors", "line": 137, "indent": 0, "params": {"ActorIds": ["Stills", "Stills-Middle"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "米莉亚说到这里就停住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative011"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "她的脸色暗了下来，<br>\n只有嘴里在嘟哝着什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "这不是发生在我身上的事。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria017"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "她仿佛在抵抗，抵抗着不容触及的禁忌——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative013"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "大叔我要回房间啦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Miria018"]}},
    {"op": "HideActors", "line": 154, "indent": 0, "params": {"ActorIds": ["Miria"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "米莉亚逃也似地离开了这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative014"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "（如果刚刚那个故事的主角是米莉亚的话，<br>\n　那大叔岂不是当时救了她……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Ema016"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "艾玛隐约有这种预感，<br>\n但她想问的人已经不在了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv15_Narrative015"]}},
    {"op": "Gosub", "line": 162, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 164, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv16", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv15_Narrative001": "会客厅的谈话结束后——",
  "0102Adv15_Narrative002": "艾玛洗完澡，<br>\n独自来到中庭。",
  "0102Adv15_Ema001": "呼……",
  "0102Adv15_Narrative003": "夜晚的冷风吹拂，带走身体上冒出的热气。",
  "0102Adv15_Ema002": "（明天我们就要逃出这里了……<br>\n　大家已经付出这么多的努力，一定要成功）",
  "0102Adv15_Narrative004": "被四面墙壁划成方形的夜空中，有几颗星星在闪烁。",
  "0102Adv15_Ema003": "（好想快点见到爸爸妈妈啊）",
  "0102Adv15_Ema004": "（现在回去上学应该还来得及。<br>\n　我已经下定决心要重头来过的——）",
  "0102Adv15_Miria001": "咦，这不是小艾吗……？",
  "0102Adv15_Narrative005": "艾玛一直在仰望夜空，<br>\n直到米莉亚叫她，她才反应过来。",
  "0102Adv15_Narrative006": "米莉亚走进中庭，<br>\n来到艾玛身边。",
  "0102Adv15_Miria002": "你也睡不着呀……？",
  "0102Adv15_Ema005": "嗯，感觉心情好激动。",
  "0102Adv15_Miria003": "大叔我也是。哈哈，感觉就像旅游的前一天晚上一样兴奋。",
  "0102Adv15_Ema006": "……我说，米莉亚，<br>\n你到底经历了什么事？",
  "0102Adv15_Ema007": "为什么会交换身体——",
  "0102Adv15_Narrative007": "现在只有她和米莉亚两人，<br>\n于是艾玛便直截了当地问道。",
  "0102Adv15_Ema008": "（前几天问她的时候被她岔开了话题，<br>\n　但我还是想了解清楚）",
  "0102Adv15_Ema009": "（我实在不觉得奈叶香所说的是<br>\n　全部的真相……）",
  "0102Adv15_Narrative008": "米莉亚有些为难地皱起眉。",
  "0102Adv15_Miria004": "……真头疼啊，<br>\n大叔我不是很想说自己的事。",
  "0102Adv15_Ema010": "嗯、嗯，这我多少能感觉到。",
  "0102Adv15_Miria005": "但事实上也确实因为我没讲清楚，造成了很大误会。<br>\n所以，我很讨厌这样的自己。",
  "0102Adv15_Ema011": "（原来米莉亚不喜欢自己吗……？）",
  "0102Adv15_Miria006": "小艾你真是个好孩子。<br>\n你一直那么努力，真的很了不起。",
  "0102Adv15_Ema012": "呃，怎、怎么突然夸我！？<br>\n我、我没有很了不起啦……！？",
  "0102Adv15_Narrative009": "看到艾玛脸红的样子，米莉亚微微一笑。",
  "0102Adv15_Miria007": "大叔我心想，一定要帮你们顺利回家。<br>\n……可说实话，我自己倒有点不想回去。",
  "0102Adv15_Ema013": "（不想回去……？）",
  "0102Adv15_Miria008": "可能是我不敢去面对现实……面对自己吧。",
  "0102Adv15_Narrative010": "米莉亚像是下定决心般叹了口气，<br>\n然后慢慢开始诉说。",
  "0102Adv15_Miria009": "这是大叔我认识的一个少女的故事……",
  "0102Adv15_Miria010": "现在的年轻人<br>\n不都是把手机当成一切嘛。",
  "0102Adv15_Ema014": "是有这样的人没错……",
  "0102Adv15_Miria011": "那个少女也不例外，她很爱玩<ruby=\"SNS\">社交媒体</ruby>。<br>\n手机就好像是她的全世界。",
  "0102Adv15_Miria012": "当时呢，流行一种惩罚游戏，<br>\n就是和朋友小团体<br>\n互相拍一些见不得人的照片。",
  "0102Adv15_Miria013": "而她被小团体出卖了，<br>\n自己拍的那些不雅照被传到了SNS上。",
  "0102Adv15_Miria014": "不仅如此，小团体的朋友还嘲笑她。<br>\n把她当做玩具，拿她当乐子。",
  "0102Adv15_Ema015": "好过分……",
  "0102Adv15_Miria015": "不过这只是大叔我认识的人的故事，<br>\n和我无关啦。",
  "0102Adv15_Miria016": "当时那个少女绝望得想要自杀。<br>\n然后大叔我就——",
  "0102Adv15_Narrative011": "米莉亚说到这里就停住了。",
  "0102Adv15_Narrative012": "她的脸色暗了下来，<br>\n只有嘴里在嘟哝着什么。",
  "0102Adv15_Miria017": "这不是发生在我身上的事。",
  "0102Adv15_Narrative013": "她仿佛在抵抗，抵抗着不容触及的禁忌——",
  "0102Adv15_Miria018": "大叔我要回房间啦。",
  "0102Adv15_Narrative014": "米莉亚逃也似地离开了这里。",
  "0102Adv15_Ema016": "（如果刚刚那个故事的主角是米莉亚的话，<br>\n　那大叔岂不是当时救了她……）",
  "0102Adv15_Narrative015": "艾玛隐约有这种预感，<br>\n但她想问的人已经不在了。"
}
}
