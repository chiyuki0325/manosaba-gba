  "language": "zh-Hans",
  "path": "Act01_Chapter02/Act01_Chapter02_Adv17",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-17", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "第二天，时间过得很缓慢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative001"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "大概是因为昨天的打击太大，<br>\n大家都缩在各自的牢房里，不愿出门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative002"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "艾玛也无所事事，<br>\n只是在毫无意义地摆弄手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative003"]}},
    {"op": "PlayBgm", "line": 20, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（我现在是不是应该<br>\n　去探望一下米莉亚比较好？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（还是说，等她明天出来<br>\n　我再来问她）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（问她为什么要毁掉热气球）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema003"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "艾玛呆呆望着手机上的囚犯列表，叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative004"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "就在这时，她不小心误触了手机，<br>\n不仅申请加米莉亚为好友，还给她打了电话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "哇哇……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema004"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "这完全只是误触。但没想到的是——<br>\n打给米莉亚的电话竟然接通了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative006"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "哎！？米、米莉亚！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema005"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "艾玛吓了一跳，但还是慌忙把手机贴在耳朵上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative007"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "——啊，是樱羽艾玛小姐吗。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Warden001"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "典狱长！？咦，为什么是你！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema006"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "没为什么……<br>\n我只是正好来惩罚室检查囚犯的情况。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Warden002"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "然后我就看到手机有来电，<br>\n所以替她接电话而已。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Warden003"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "米莉亚呢！？米莉亚她没事吧！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema007"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "她好着呢。哎呀呀……<br>\n你们不停地闹出问题，害得我的工作量都增加了，<br>\n求你们放过我吧……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Warden004"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "也许我得挑个日子杀鸡儆猴了。再见。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Warden005"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 77, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "电话被挂断了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative008"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "艾玛呆呆地低头望着手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative009"]}},
    {"op": "ResetText", "line": 83, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 84, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 87, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "9_2"}},
    {"op": "ModifyBackgroundExtended", "line": 88, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 89, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 91, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "囚犯之间笼罩着一股疏远的气氛，<br>\n大家都没怎么讲话——时间就这样来到了晚上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative010"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "自从越狱计划开始后，<br>\n少女们的心日益亲近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative011"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "但现在，那亲近的氛围荡然无存。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative012"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "（看来，米莉亚确实起到了很重要的作用）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema008"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "（昨天我是硬逼着自己那么说的，但我们真的能<br>\n　再次团结一心朝着越狱的目标努力吗……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema009"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "雪莉大概是看穿了艾玛的气馁和失落，<br>\n晚餐后，她邀请艾玛一起去洗澡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative013"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "冲过澡后，两人的心情舒畅了些，<br>\n她们一起走在静静的过道上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "……我觉得，米莉亚这么做一定有自己的理由。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema010"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "艾玛小声地说出自己的想法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative015"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "你是说破坏热气球的理由吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "嗯。我觉得不是因为她是幕后黑手，<br>\n而是有什么其他原因<br>\n她才不得不破坏热气球。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "唔～，到底是什么原因呢？<br>\n让她不惜违反规定也要毁掉大家计划的原因……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry002"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "我是觉得只有监牢的同伙<br>\n才会做出这种事。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry003"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "再说米莉亚本来就骗了我们，<br>\n搞不好她就是幕后黑手吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry004"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "不过也有可能是<br>\n她被人威胁了……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry005"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "听着雪莉的话，艾玛的脸色越来越阴郁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "（是我想得太美好了吗……<br>\n　难道米莉亚真的是幕后黑手……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema012"]}},
    {"op": "HideAllCharacters", "line": 136, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 137, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 140, "indent": 0, "params": {"SfxPath": "Sfx_51", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "听见背后传来奔跑的脚步声，<br>\n艾玛和雪莉回过头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative017"]}},
    {"op": "HidePrinter", "line": 146, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 147, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [57.0, 60.0], "AppearanceAndTransition": "9_2", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 148, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [1.600000023841858], "Duration": 0.0, "Lazy": 0, "ScenePosition": [57.0, 100.0], "IdAndAppearance": "Hanna.Cry1", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 150, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Loop": 0, "ScenePositionX": "58", "ScenePositionY": "68", "EasingTypeName": "EaseOutQuad", "Duration": "0.6"}},
    {"op": "AnimateActorExtended", "line": 151, "indent": 0, "params": {"ActorIds": ["Hanna-Middle"], "Loop": 0, "ScenePositionX": "58", "ScenePositionY": "115", "EasingTypeName": "EaseOutQuad", "Duration": "0.6"}},
    {"op": "Wait", "line": 152, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "艾玛……雪莉……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Hanna001"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "汉娜，你怎么——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema013"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "艾玛的话说到一半就停住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative018"]}},
    {"op": "HidePrinter", "line": 160, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 161, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [2.200000047683716], "Lazy": 0, "ScenePosition": [52.0, 28.0], "AppearanceAndTransition": "9_2", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [1.600000023841858], "Lazy": 0, "ScenePosition": [50.0, 25.0], "IdAndAppearance": "Hanna.Cry1", "SubId": "Middle"}},
    {"op": "Wait", "line": 163, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "汉娜这时哭得泪如雨下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative019"]}},
    {"op": "PlayBgm", "line": 167, "indent": 0, "params": {"BgmPath": "Bgm_3_1_Loop", "IntroBgmPath": "Bgm_3_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "她往艾玛那边走去，<br>\n那通红的眼里还噙着泪花。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative020"]}},
    {"op": "HidePrinter", "line": 171, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 172, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Hanna-Middle"], "Duration": 0.0, "Lazy": 0}},
    {"op": "SpawnBlur", "line": 173, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "Intensity": 0.0, "FadeDuration": 0.30000001192092896}},
    {"op": "Wait", "line": 174, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "一股不祥的预感袭上心头。<br>\n艾玛感觉仿佛心脏被狠狠揪紧了一样，<br>\n疾速的心跳令她不禁捂住胸口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Cry1"}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "（和发现诺亚的时候一样……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema014"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "请、请你们马上过来……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 186, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "艾玛和雪莉点点头，<br>\n跟在汉娜身后跑了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative022"]}},
    {"op": "ResetText", "line": 190, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 191, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 192, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 194, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "3_2"}},
    {"op": "ModifyBackgroundExtended", "line": 195, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 196, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "在汉娜的带领下，<br>\n艾玛一行人来到了<br>\n地下惩罚室旁的过道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Cry1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Cry"}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Cry1,ArmR5,ArmL5"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "梅露露、可可和安安已经等在那里了。<br>\n三人紧紧依靠在一起，哭个不停。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative024"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "可可和安安哭得尤为激动，<br>\n梅露露在身边安抚她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative025"]}},
    {"op": "HideAllCharacters", "line": 208, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Cry"}},
    {"op": "ModifyCharacterExtended", "line": 211, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "啊，艾玛小姐……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Meruru001"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "梅露露，到底发生什么了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema015"]}},
    {"op": "HideAllCharacters", "line": 217, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "艾玛从干哑到几乎发不出声的喉咙里<br>\n努力挤出一句话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Cry"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "在惩罚室里面，米莉亚小姐她被……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 227, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Cry1,ArmR5,ArmL5"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "大叔被捅了！但是门打不开！<br>\n她可能还活着啊！？<br>\n快把门打开啊，喂！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Coco001"]}},
    {"op": "HideAllCharacters", "line": 234, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "艾玛和雪莉就站在<br>\n可可指着的门前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "（米莉亚被捅了……？<br>\n　怎么会这样，为什么……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema016"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "艾玛不敢置信，<br>\n只觉得头晕目眩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative028"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "艾玛。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 247, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "连雪莉也被吓得面无血色，<br>\n她紧紧握住艾玛的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative029"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "也许是因为她发现艾玛快要晕倒了。<br>\n也许是为了维持自己的理智。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative030"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "两人手牵着手，仿佛两颗残破不堪的心灵正互相扶持着。<br>\n她们一同从门上的小窗<br>\n看向惩罚室里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative031"]}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema017"]}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "米莉亚的身上血流成河——<br>\n那场面实在惨不忍睹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative032"]}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "艾玛不忍心看下去了，拼命忍住瞬间涌上来的反胃感。<br>\n这时，雪莉松开了她的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative033"]}},
    {"op": "ModifyCharacterExtended", "line": 261, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR8"}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "艾玛，请你后退一点。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 265, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "雪莉的声音有些僵硬，<br>\n说完，她确认艾玛已经退后一步后，<br>\n握住挂在惩罚室门前的锁——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative034"]}},
    {"op": "PlaySfxModified", "line": 270, "indent": 0, "params": {"SfxPath": "Sfx_52", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Angry1,ArmR8,ArmL8"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "啊啊啊！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 278, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 279, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "然后用怪力魔法徒手把锁扯了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative035"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "惩罚室的门开了，<br>\n艾玛等人走进里面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative036"]}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "（米莉亚，米莉亚米莉亚，米莉亚——！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema018"]}},
    {"op": "HideAllCharacters", "line": 289, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "紧接着，映入眼帘的是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative037"]}},
    {"op": "HidePrinter", "line": 293, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 295, "indent": 0, "params": {"BgmPath": "Bgm_12_1_Loop", "IntroBgmPath": "Bgm_12_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "AnimateActorExtended", "line": 297, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 298, "indent": 0, "params": {"Id": "Stills", "Scale": [2.5], "Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [80.0, 75.0], "AppearanceAndTransition": "280_1"}},
    {"op": "AnimateActorExtended", "line": 299, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "ScenePositionX": "60", "EasingTypeName": "EaseOutQuad", "Duration": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 300, "indent": 0, "params": {"Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 301, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "ModifyBackgroundExtended", "line": 303, "indent": 0, "params": {"Id": "Stills", "Scale": [3.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [35.0, -10.0], "AppearanceAndTransition": "280_1", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 304, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "50", "EasingTypeName": "EaseOutQuad", "Duration": "1.5"}},
    {"op": "Wait", "line": 305, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "AnimateActorExtended", "line": 307, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 308, "indent": 0, "params": {"Id": "Stills", "Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "280_1"}},
    {"op": "SpawnBlur", "line": 309, "indent": 0, "params": {"ActorId": "Stills", "FadeDuration": 0.0}},
    {"op": "AnimateActorExtended", "line": 310, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "Scale": "1.15", "EasingTypeName": "EaseOutQuad", "Duration": "2.4"}},
    {"op": "SpawnBlur", "line": 311, "indent": 0, "params": {"ActorId": "Stills", "Intensity": 0.0, "FadeDuration": 1.7999999523162842}},
    {"op": "HideActors", "line": 312, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 313, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 317, "indent": 0, "params": {"Text": "——拥有成人人格的少女，佐伯米莉亚。<br>\n她空洞的眼里已经失去了光芒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative038"]}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "她被束缚在十字架处刑台上，<br>\n看样子是被刺了很多下，<br>\n从胸部到腹部均有大量出血。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative039"]}},
    {"op": "PrintTextModified", "line": 321, "indent": 0, "params": {"Text": "鲜红的血液化作无数只蝴蝶<br>\n飞舞在十字架的周围，<br>\n仿佛在点缀少女神圣的死亡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative040"]}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "诺亚的魔法还没消失啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry009"]}},
    {"op": "PrintTextModified", "line": 325, "indent": 0, "params": {"Text": "雪莉呢喃道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative041"]}},
    {"op": "PrintTextModified", "line": 327, "indent": 0, "params": {"Text": "米莉亚她……真的被捅了吗？", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_AnAn001"]}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "她喜欢看电影……<br>\n所以，会不会是特效妆？最好确认一下。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_AnAn002"]}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "安安一边说着，摇摇晃晃地走了进来，<br>\n艾玛她们听了一惊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative042"]}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "（是啊，说不定她还活着……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema019"]}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "梅露露！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Sherry010"]}},
    {"op": "PrintTextModified", "line": 337, "indent": 0, "params": {"Text": "听到雪莉的呼唤，梅露露也走了进来。<br>\n如果她还有呼吸，就能用梅露露的魔法治疗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative043"]}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "艾玛她们急忙跑到米莉亚身边，<br>\n确认她的情况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative044"]}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "梅露露伸出发光的手，<br>\n触碰米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative045"]}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "然而，她很快就痛苦地摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative046"]}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "不行……她已经过世了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Meruru003"]}},
    {"op": "PrintTextModified", "line": 347, "indent": 0, "params": {"Text": "即便化成蝴蝶，<br>\n那股刺鼻的血腥味依旧还在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative047"]}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "而且，米莉亚尸体的惨状<br>\n实在叫人不忍心直视。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative048"]}},
    {"op": "HideActors", "line": 351, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 352, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "3_2"}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "艾玛她们拼命忍住呕吐的欲望，<br>\n暂时离开了房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative049"]}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Cry1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 357, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Cry1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 359, "indent": 0, "params": {"Text": "米莉亚……为什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Ema020"]}},
    {"op": "PrintTextModified", "line": 361, "indent": 0, "params": {"Text": "……米莉亚的手机掉了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_AnAn003"]}},
    {"op": "HideAllCharacters", "line": 363, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 365, "indent": 0, "params": {"Text": "安安把米莉亚的手机<br>\n递给了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative050"]}},
    {"op": "SpawnExtended", "line": 370, "indent": 0, "params": {"Path": "Clue", "Params": ["2-8"]}},
    {"op": "UpdateWitchBook", "line": 371, "indent": 0, "params": {"Id": "2-8", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 372, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 374, "indent": 0, "params": {"Text": "艾玛低头望向手机，<br>\n眼泪便止不住地落下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative051"]}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "少女们悲痛的呜咽和恸哭<br>\n回荡在地下过道中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative052"]}},
    {"op": "PlaySfxModified", "line": 379, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 381, "indent": 0, "params": {"Text": "这时，手机的提示音像看准时机般<br>\n响了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative053"]}},
    {"op": "PrintTextModified", "line": 383, "indent": 0, "params": {"Text": "『唉……收到一份报告。<br>\n　据说发生了一起令人痛心的凶杀案啊』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative054"]}},
    {"op": "PrintTextModified", "line": 385, "indent": 0, "params": {"Text": "『尽管现在已经是禁止外出时间，<br>\n　但是紧急情况特殊处理』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative055"]}},
    {"op": "PrintTextModified", "line": 387, "indent": 0, "params": {"Text": "『请大家立即前往会客厅集合。<br>\n　不遵守者将会被看守带走……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative056"]}},
    {"op": "ModifyCharacterExtended", "line": 389, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 391, "indent": 0, "params": {"Text": "看守此时也已应典狱长通知的召唤<br>\n抵达了过道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative057"]}},
    {"op": "PrintTextModified", "line": 393, "indent": 0, "params": {"Text": "想到之后事情的发展，<br>\n艾玛她们便有气无力地走了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv17_Narrative058"]}},
    {"op": "Gosub", "line": 395, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 397, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv18", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv17_Narrative001": "第二天，时间过得很缓慢。",
  "0102Adv17_Narrative002": "大概是因为昨天的打击太大，<br>\n大家都缩在各自的牢房里，不愿出门。",
  "0102Adv17_Narrative003": "艾玛也无所事事，<br>\n只是在毫无意义地摆弄手机。",
  "0102Adv17_Ema001": "（我现在是不是应该<br>\n　去探望一下米莉亚比较好？）",
  "0102Adv17_Ema002": "（还是说，等她明天出来<br>\n　我再来问她）",
  "0102Adv17_Ema003": "（问她为什么要毁掉热气球）",
  "0102Adv17_Narrative004": "艾玛呆呆望着手机上的囚犯列表，叹了口气。",
  "0102Adv17_Narrative005": "就在这时，她不小心误触了手机，<br>\n不仅申请加米莉亚为好友，还给她打了电话。",
  "0102Adv17_Ema004": "哇哇……！",
  "0102Adv17_Narrative006": "这完全只是误触。但没想到的是——<br>\n打给米莉亚的电话竟然接通了。",
  "0102Adv17_Ema005": "哎！？米、米莉亚！？",
  "0102Adv17_Narrative007": "艾玛吓了一跳，但还是慌忙把手机贴在耳朵上。",
  "0102Adv17_Warden001": "——啊，是樱羽艾玛小姐吗。",
  "0102Adv17_Ema006": "典狱长！？咦，为什么是你！？",
  "0102Adv17_Warden002": "没为什么……<br>\n我只是正好来惩罚室检查囚犯的情况。",
  "0102Adv17_Warden003": "然后我就看到手机有来电，<br>\n所以替她接电话而已。",
  "0102Adv17_Ema007": "米莉亚呢！？米莉亚她没事吧！？",
  "0102Adv17_Warden004": "她好着呢。哎呀呀……<br>\n你们不停地闹出问题，害得我的工作量都增加了，<br>\n求你们放过我吧……",
  "0102Adv17_Warden005": "也许我得挑个日子杀鸡儆猴了。再见。",
  "0102Adv17_Narrative008": "电话被挂断了。",
  "0102Adv17_Narrative009": "艾玛呆呆地低头望着手机。",
  "0102Adv17_Narrative010": "囚犯之间笼罩着一股疏远的气氛，<br>\n大家都没怎么讲话——时间就这样来到了晚上。",
  "0102Adv17_Narrative011": "自从越狱计划开始后，<br>\n少女们的心日益亲近。",
  "0102Adv17_Narrative012": "但现在，那亲近的氛围荡然无存。",
  "0102Adv17_Ema008": "（看来，米莉亚确实起到了很重要的作用）",
  "0102Adv17_Ema009": "（昨天我是硬逼着自己那么说的，但我们真的能<br>\n　再次团结一心朝着越狱的目标努力吗……）",
  "0102Adv17_Narrative013": "雪莉大概是看穿了艾玛的气馁和失落，<br>\n晚餐后，她邀请艾玛一起去洗澡。",
  "0102Adv17_Narrative014": "冲过澡后，两人的心情舒畅了些，<br>\n她们一起走在静静的过道上。",
  "0102Adv17_Ema010": "……我觉得，米莉亚这么做一定有自己的理由。",
  "0102Adv17_Narrative015": "艾玛小声地说出自己的想法。",
  "0102Adv17_Sherry001": "你是说破坏热气球的理由吗？",
  "0102Adv17_Ema011": "嗯。我觉得不是因为她是幕后黑手，<br>\n而是有什么其他原因<br>\n她才不得不破坏热气球。",
  "0102Adv17_Sherry002": "唔～，到底是什么原因呢？<br>\n让她不惜违反规定也要毁掉大家计划的原因……",
  "0102Adv17_Sherry003": "我是觉得只有监牢的同伙<br>\n才会做出这种事。",
  "0102Adv17_Sherry004": "再说米莉亚本来就骗了我们，<br>\n搞不好她就是幕后黑手吧？",
  "0102Adv17_Sherry005": "不过也有可能是<br>\n她被人威胁了……",
  "0102Adv17_Narrative016": "听着雪莉的话，艾玛的脸色越来越阴郁。",
  "0102Adv17_Ema012": "（是我想得太美好了吗……<br>\n　难道米莉亚真的是幕后黑手……）",
  "0102Adv17_Narrative017": "听见背后传来奔跑的脚步声，<br>\n艾玛和雪莉回过头来。",
  "0102Adv17_Hanna001": "艾玛……雪莉……",
  "0102Adv17_Ema013": "汉娜，你怎么——",
  "0102Adv17_Narrative018": "艾玛的话说到一半就停住了。",
  "0102Adv17_Narrative019": "汉娜这时哭得泪如雨下。",
  "0102Adv17_Narrative020": "她往艾玛那边走去，<br>\n那通红的眼里还噙着泪花。",
  "0102Adv17_Narrative021": "一股不祥的预感袭上心头。<br>\n艾玛感觉仿佛心脏被狠狠揪紧了一样，<br>\n疾速的心跳令她不禁捂住胸口。",
  "0102Adv17_Ema014": "（和发现诺亚的时候一样……）",
  "0102Adv17_Hanna002": "请、请你们马上过来……！",
  "0102Adv17_Narrative022": "艾玛和雪莉点点头，<br>\n跟在汉娜身后跑了起来。",
  "0102Adv17_Narrative023": "在汉娜的带领下，<br>\n艾玛一行人来到了<br>\n地下惩罚室旁的过道。",
  "0102Adv17_Narrative024": "梅露露、可可和安安已经等在那里了。<br>\n三人紧紧依靠在一起，哭个不停。",
  "0102Adv17_Narrative025": "可可和安安哭得尤为激动，<br>\n梅露露在身边安抚她们。",
  "0102Adv17_Meruru001": "啊，艾玛小姐……",
  "0102Adv17_Ema015": "梅露露，到底发生什么了……",
  "0102Adv17_Narrative026": "艾玛从干哑到几乎发不出声的喉咙里<br>\n努力挤出一句话。",
  "0102Adv17_Meruru002": "在惩罚室里面，米莉亚小姐她被……",
  "0102Adv17_Coco001": "大叔被捅了！但是门打不开！<br>\n她可能还活着啊！？<br>\n快把门打开啊，喂！",
  "0102Adv17_Narrative027": "艾玛和雪莉就站在<br>\n可可指着的门前。",
  "0102Adv17_Ema016": "（米莉亚被捅了……？<br>\n　怎么会这样，为什么……）",
  "0102Adv17_Narrative028": "艾玛不敢置信，<br>\n只觉得头晕目眩。",
  "0102Adv17_Sherry006": "艾玛。",
  "0102Adv17_Narrative029": "连雪莉也被吓得面无血色，<br>\n她紧紧握住艾玛的手。",
  "0102Adv17_Narrative030": "也许是因为她发现艾玛快要晕倒了。<br>\n也许是为了维持自己的理智。",
  "0102Adv17_Narrative031": "两人手牵着手，仿佛两颗残破不堪的心灵正互相扶持着。<br>\n她们一同从门上的小窗<br>\n看向惩罚室里。",
  "0102Adv17_Ema017": "呜……",
  "0102Adv17_Narrative032": "米莉亚的身上血流成河——<br>\n那场面实在惨不忍睹。",
  "0102Adv17_Narrative033": "艾玛不忍心看下去了，拼命忍住瞬间涌上来的反胃感。<br>\n这时，雪莉松开了她的手。",
  "0102Adv17_Sherry007": "艾玛，请你后退一点。",
  "0102Adv17_Narrative034": "雪莉的声音有些僵硬，<br>\n说完，她确认艾玛已经退后一步后，<br>\n握住挂在惩罚室门前的锁——",
  "0102Adv17_Sherry008": "啊啊啊！",
  "0102Adv17_Narrative035": "然后用怪力魔法徒手把锁扯了下来。",
  "0102Adv17_Narrative036": "惩罚室的门开了，<br>\n艾玛等人走进里面。",
  "0102Adv17_Ema018": "（米莉亚，米莉亚米莉亚，米莉亚——！）",
  "0102Adv17_Narrative037": "紧接着，映入眼帘的是——",
  "0102Adv17_Narrative038": "——拥有成人人格的少女，佐伯米莉亚。<br>\n她空洞的眼里已经失去了光芒。",
  "0102Adv17_Narrative039": "她被束缚在十字架处刑台上，<br>\n看样子是被刺了很多下，<br>\n从胸部到腹部均有大量出血。",
  "0102Adv17_Narrative040": "鲜红的血液化作无数只蝴蝶<br>\n飞舞在十字架的周围，<br>\n仿佛在点缀少女神圣的死亡。",
  "0102Adv17_Sherry009": "诺亚的魔法还没消失啊。",
  "0102Adv17_Narrative041": "雪莉呢喃道。",
  "0102Adv17_AnAn001": "米莉亚她……真的被捅了吗？",
  "0102Adv17_AnAn002": "她喜欢看电影……<br>\n所以，会不会是特效妆？最好确认一下。",
  "0102Adv17_Narrative042": "安安一边说着，摇摇晃晃地走了进来，<br>\n艾玛她们听了一惊。",
  "0102Adv17_Ema019": "（是啊，说不定她还活着……！）",
  "0102Adv17_Sherry010": "梅露露！",
  "0102Adv17_Narrative043": "听到雪莉的呼唤，梅露露也走了进来。<br>\n如果她还有呼吸，就能用梅露露的魔法治疗。",
  "0102Adv17_Narrative044": "艾玛她们急忙跑到米莉亚身边，<br>\n确认她的情况。",
  "0102Adv17_Narrative045": "梅露露伸出发光的手，<br>\n触碰米莉亚。",
  "0102Adv17_Narrative046": "然而，她很快就痛苦地摇了摇头。",
  "0102Adv17_Meruru003": "不行……她已经过世了。",
  "0102Adv17_Narrative047": "即便化成蝴蝶，<br>\n那股刺鼻的血腥味依旧还在。",
  "0102Adv17_Narrative048": "而且，米莉亚尸体的惨状<br>\n实在叫人不忍心直视。",
  "0102Adv17_Narrative049": "艾玛她们拼命忍住呕吐的欲望，<br>\n暂时离开了房间。",
  "0102Adv17_Ema020": "米莉亚……为什么……",
  "0102Adv17_AnAn003": "……米莉亚的手机掉了。",
  "0102Adv17_Narrative050": "安安把米莉亚的手机<br>\n递给了艾玛。",
  "0102Adv17_Narrative051": "艾玛低头望向手机，<br>\n眼泪便止不住地落下。",
  "0102Adv17_Narrative052": "少女们悲痛的呜咽和恸哭<br>\n回荡在地下过道中。",
  "0102Adv17_Narrative053": "这时，手机的提示音像看准时机般<br>\n响了起来。",
  "0102Adv17_Narrative054": "『唉……收到一份报告。<br>\n　据说发生了一起令人痛心的凶杀案啊』",
  "0102Adv17_Narrative055": "『尽管现在已经是禁止外出时间，<br>\n　但是紧急情况特殊处理』",
  "0102Adv17_Narrative056": "『请大家立即前往会客厅集合。<br>\n　不遵守者将会被看守带走……』",
  "0102Adv17_Narrative057": "看守此时也已应典狱长通知的召唤<br>\n抵达了过道。",
  "0102Adv17_Narrative058": "想到之后事情的发展，<br>\n艾玛她们便有气无力地走了起来。"
}
}
