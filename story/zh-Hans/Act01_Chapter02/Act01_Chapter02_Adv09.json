    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "刚来到玛格的牢房前，<br>\n艾玛就听见里面传来叽叽喳喳的吵闹声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Narrative001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "你来做什么！！<br>\n我不是叮嘱过不准进来吗！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Hanna001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "都说了我也想帮帮忙啊。<br>\n别看我这样，其实我手很巧的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Sherry001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "好啦，你就拿来给我吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Sherry002"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "呀——！<br>\n你这家伙竟敢直接上手拽！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Hanna002"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "你、你们两位都冷静点……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Meruru001"]}},
    {"op": "ModifyBackgroundExtended", "line": 47, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "（汉娜她们制作的是<br>\n　热气球的球皮部分。<br>\n　这是最重要的部分）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "啊，艾玛小姐……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 55, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "梅露露走出门口，<br>\n便看到站在牢房前的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "对不起，现在房间里不让人进……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Meruru003"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "嗯没事的，我明白。<br>\n毕竟要是有人进去弄破皮就麻烦了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Ema002"]}},
    {"op": "HideAllCharacters", "line": 66, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 69, "indent": 0, "params": {"SfxPath": "Sfx_45", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "两人正聊着，<br>\n突然听见里面传来撕破了什么东西的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Narrative003"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Ema003"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "……现在我决定了。<br>\n我要把这家伙宰了！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Hanna003"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "欸？你确定要这么说吗？<br>\n会被处刑的哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Sherry003"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "无所谓了！我一定要杀了你！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv09_Hanna004"]}},
