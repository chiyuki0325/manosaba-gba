  "path": "Act01_Chapter02/Act01_Chapter02_Adv03",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-2-3", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "于是艾玛一行人迅速解决晚餐后，<br>\n便前往玛格的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 19, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "为什么玛格要我们去她的房间呢？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "玛格和奈叶香是住在一起的……<br>\n说不定和这件事有关。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "说起来，玛格的房间<br>\n一直是被围挡住的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 28, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "玛格和奈叶香的房间在艾玛的隔壁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "（说起来，我从没见过玛格她们的房间<br>\n　里面长什么样子）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（印象中，她们的房间<br>\n　被一块不知哪里找来的窗帘布遮挡了起来）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "三人来到玛格的牢房前。<br>\n不出所料，门前挂了块布，看不见里面的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "玛格，你在吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema004"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "艾玛小心翼翼地问道，<br>\n随后便听见里面传来了声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative004"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "欢迎光临。<br>\n门开着，请进吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo001"]}},
    {"op": "PlaySfxModified", "line": 51, "indent": 0, "params": {"SfxPath": "Sfx_41", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "艾玛她们掀起帘子，<br>\n走进房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative005"]}},
    {"op": "HidePrinter", "line": 55, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 56, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 57, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 59, "indent": 0, "params": {"Id": "Stills", "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [70.0, 50.0], "AppearanceAndTransition": "100_1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 60, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.7999999523162842, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 61, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 63, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "30", "ScenePositionY": "50", "Duration": "30"}},
    {"op": "Wait", "line": 64, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "哦……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema005"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "哇……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry002"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "这、这、这是怎么一回事！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Hanna002"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "整个牢房四周都挂满了帘子，<br>\n仿佛摇身一变，成了一座占卜馆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "在房间的中央，玛格正把手肘支在桌上<br>\n向她们投来妖艳的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative007"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "不好意思，这里空间太小了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo002"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "这些是你用魔法变出来的吗？<br>\n变化大得太夸张了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry003"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "呵呵，不是哦。毕竟我们有大把的时间，<br>\n所以我就把这里改造得更宜居了一些。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo003"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "我从很久以前就开始出于爱好做占卜了。<br>\n说是爱好，其实也算在做生意吧？<br>\n因为我也喜欢赚钱。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo004"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "你到底是怎么做到的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema006"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "我借用了监牢里的某样东西。<br>\n非常简单，你们不如也试试看吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo005"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "你把我们叫来<br>\n就是为了让我们看这个房间吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry004"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "这也是原因之一。还有就是……<br>\n我很警惕监控摄像头。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo006"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "什么！？<br>\n这里设置了监控摄像头吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Hanna003"]}},
    {"op": "HidePrinter", "line": 94, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 95, "indent": 0, "params": {"Id": "Stills", "Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.800000011920929, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "100_1", "SubId": "Front"}},
    {"op": "Wait", "line": 96, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "玛格摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative008"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "我和奈叶香在监牢里分头搜寻了好几天，<br>\n但哪里都没有找到装监控摄像头的痕迹。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo007"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "不过，既然我们被当做囚犯抓到这里，<br>\n最好还是随时做好被监视的心理准备。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo008"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "从过道那边是看不见这里的，<br>\n要商量机密事情的话，来这个房间就好。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo009"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "（原来玛格叫我们来是为了这件事……<br>\n　她比我想像中要亲切呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema007"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "先不说这个……大家都说<br>\n我的占卜可是很准的哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo010"]}},
    {"op": "ResetText", "line": 110, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 111, "indent": 0, "params": {"SlotNumber": 9, "Wait": 0}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "有兴趣的话我也可以给你们占卜哦♡<br>\n当然是付费的。呵呵呵♡", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Margo011"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "（收回前言……！<br>\n　她要开始推销了……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema008"]}},
    {"op": "HidePrinter", "line": 117, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 118, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 119, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "HideActors", "line": 120, "indent": 0, "params": {"ActorIds": ["Stills-Middle", "Stills-Front"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 121, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 122, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "StopBgm", "line": 123, "indent": 0, "params": {"FadeOutDuration": 2.0}},
    {"op": "Wait", "line": 124, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "对于玛格的占卜，艾玛她——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative009"]}},
    {"op": "AddChoice", "line": 128, "indent": 0, "params": {"ChoiceSummary": "表示同意试试看", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0102Adv03_Choice001"]}},
    {"op": "GotoModified", "line": 129, "indent": 1, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Bad01", "ResetState": ["-"]}},
    {"op": "AddChoice", "line": 131, "indent": 0, "params": {"ChoiceSummary": "表示拒绝", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0102Adv03_Choice002"]}},
    {"op": "GotoModified", "line": 132, "indent": 1, "params": {"Path": ".Choice1-2-1"}},
    {"op": "StopForChoice", "line": 134, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice1-2-1", "line": 136, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 138, "indent": 0, "params": {"Number": 9}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "理所当然地拒绝了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative010"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "艾玛一行人好不容易逃脱了玛格的占卜推销，<br>\n精疲力竭地离开了房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "刚、刚才真是太可怕了……<br>\n她居然说没有钱就用身体来支付……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Hanna004"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "要是点头同意的话，<br>\n肯定要被她慢慢压榨到什么都不剩……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema009"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "雪莉突然一下子想起来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "不对，<br>\n我们完全没制定越狱计划吧！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry005"]}},
    {"op": "ModifyCharacterExtended", "line": 158, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "放风时间马上要结束了哦！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Hanna005"]}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "不、不过我们得知了更多情报，<br>\n比如监牢里没有装监控摄像头之类的……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema010"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "明天再认真制定计划吧！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema011"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "三人迈着无力的步伐走在过道上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "……不过，也许玛格的生存方式<br>\n是最合理的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "你的意思是？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "精神压力积攒得越多，就会越容易魔女化。<br>\n既然如此，那不要让自己有压力就好了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry007"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "我看玛格她<br>\n还是和先前一样，活得自由自在的，<br>\n不像会变成魔女的样子。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 186, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "确实……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema012"]}},
    {"op": "HideAllCharacters", "line": 190, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "（而我们一直过着<br>\n　压力巨大的生活……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema013"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "不快、焦躁、恐惧、愤怒。<br>\n种种负面情绪一点一滴地萦绕在艾玛她们的心里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative014"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "（魔女化的程度越深，杀意也就越重……<br>\n　那我们——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "在这里度过的时间越久，魔女化的程度就会越深。<br>\n也许正因为如此，<br>\n奈叶香才会说我们没有时间了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema015"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "是啊。<br>\n而杀意变重的奈叶香<br>\n现在行踪不明。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry009"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "或许下次再现身时，<br>\n她已经成了杀人犯。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry010"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "汉娜顿时面色苍白，不停地在发抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "怎么会这样……她还带着那么吓人的枪，<br>\n谁能抵抗得了她……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "我们也有反击的办法。<br>\n一旦发现她，立刻把她打倒就行！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised,ArmR3"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "雪、雪莉，你在说什么啊！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema016"]}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1,ArmR7"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "……咦？<br>\n我说得不对吗……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry012"]}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "要是变成了魔女的话，她就不会轻易死掉了，<br>\n只是反击一下又不至于杀死它，应该没事啦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry013"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "哪怕对手是魔女，<br>\n让它暂时不能行动，我们还是能做到的吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry014"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "奈叶香不一定已经魔女化了。<br>\n她可能只是心态变悲观了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema017"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1,ArmR7"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "说得也是，等我们拿到确凿的证据再说反击的事吧。<br>\n欸嘿，我以后会注意的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Sherry015"]}},
    {"op": "HideAllCharacters", "line": 238, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "（雪莉……偶尔会说些可怕的话呢……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema018"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "艾玛很担心奈叶香，<br>\n但并没有收到发现她的报告。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative016"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "（奈叶香说，<br>\n　她用幻视魔法得知了这座监牢的情报）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema019"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "（就算她知道其他人都不知道的藏身处<br>\n　也不奇怪）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema020"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "（但是，她真的能连着好几天躲过<br>\n　典狱长和看守的监视吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Ema021"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "至少，艾玛她们正处在<br>\n被监视的情况下，只能老实去遵守明文规定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative017"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "今天典狱长的通知也该来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative018"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "最后，艾玛她们还是只能遵守规定<br>\n回到自己的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv03_Narrative019"]}},
    {"op": "Gosub", "line": 256, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 258, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0102Adv03_Narrative001": "于是艾玛一行人迅速解决晚餐后，<br>\n便前往玛格的牢房。",
  "0102Adv03_Ema001": "为什么玛格要我们去她的房间呢？",
  "0102Adv03_Sherry001": "玛格和奈叶香是住在一起的……<br>\n说不定和这件事有关。",
  "0102Adv03_Hanna001": "说起来，玛格的房间<br>\n一直是被围挡住的。",
  "0102Adv03_Narrative002": "玛格和奈叶香的房间在艾玛的隔壁。",
  "0102Adv03_Ema002": "（说起来，我从没见过玛格她们的房间<br>\n　里面长什么样子）",
  "0102Adv03_Ema003": "（印象中，她们的房间<br>\n　被一块不知哪里找来的窗帘布遮挡了起来）",
  "0102Adv03_Narrative003": "三人来到玛格的牢房前。<br>\n不出所料，门前挂了块布，看不见里面的样子。",
  "0102Adv03_Ema004": "玛格，你在吗？",
  "0102Adv03_Narrative004": "艾玛小心翼翼地问道，<br>\n随后便听见里面传来了声音。",
  "0102Adv03_Margo001": "欢迎光临。<br>\n门开着，请进吧。",
  "0102Adv03_Narrative005": "艾玛她们掀起帘子，<br>\n走进房间。",
  "0102Adv03_Ema005": "哦……",
  "0102Adv03_Sherry002": "哇……",
  "0102Adv03_Hanna002": "这、这、这是怎么一回事！？",
  "0102Adv03_Narrative006": "整个牢房四周都挂满了帘子，<br>\n仿佛摇身一变，成了一座占卜馆。",
  "0102Adv03_Narrative007": "在房间的中央，玛格正把手肘支在桌上<br>\n向她们投来妖艳的微笑。",
  "0102Adv03_Margo002": "不好意思，这里空间太小了。",
  "0102Adv03_Sherry003": "这些是你用魔法变出来的吗？<br>\n变化大得太夸张了。",
  "0102Adv03_Margo003": "呵呵，不是哦。毕竟我们有大把的时间，<br>\n所以我就把这里改造得更宜居了一些。",
  "0102Adv03_Margo004": "我从很久以前就开始出于爱好做占卜了。<br>\n说是爱好，其实也算在做生意吧？<br>\n因为我也喜欢赚钱。",
  "0102Adv03_Ema006": "你到底是怎么做到的……",
  "0102Adv03_Margo005": "我借用了监牢里的某样东西。<br>\n非常简单，你们不如也试试看吧？",
  "0102Adv03_Sherry004": "你把我们叫来<br>\n就是为了让我们看这个房间吗？",
  "0102Adv03_Margo006": "这也是原因之一。还有就是……<br>\n我很警惕监控摄像头。",
  "0102Adv03_Hanna003": "什么！？<br>\n这里设置了监控摄像头吗！？",
  "0102Adv03_Narrative008": "玛格摇了摇头。",
  "0102Adv03_Margo007": "我和奈叶香在监牢里分头搜寻了好几天，<br>\n但哪里都没有找到装监控摄像头的痕迹。",
  "0102Adv03_Margo008": "不过，既然我们被当做囚犯抓到这里，<br>\n最好还是随时做好被监视的心理准备。",
  "0102Adv03_Margo009": "从过道那边是看不见这里的，<br>\n要商量机密事情的话，来这个房间就好。",
  "0102Adv03_Ema007": "（原来玛格叫我们来是为了这件事……<br>\n　她比我想像中要亲切呢）",
  "0102Adv03_Margo010": "先不说这个……大家都说<br>\n我的占卜可是很准的哦。",
  "0102Adv03_Margo011": "有兴趣的话我也可以给你们占卜哦♡<br>\n当然是付费的。呵呵呵♡",
  "0102Adv03_Ema008": "（收回前言……！<br>\n　她要开始推销了……！）",
  "0102Adv03_Narrative009": "对于玛格的占卜，艾玛她——",
  "0102Adv03_Choice001": "表示同意试试看",
  "0102Adv03_Choice002": "表示拒绝",
  "0102Adv03_Narrative010": "理所当然地拒绝了。",
  "0102Adv03_Narrative011": "艾玛一行人好不容易逃脱了玛格的占卜推销，<br>\n精疲力竭地离开了房间。",
  "0102Adv03_Hanna004": "刚、刚才真是太可怕了……<br>\n她居然说没有钱就用身体来支付……",
  "0102Adv03_Ema009": "要是点头同意的话，<br>\n肯定要被她慢慢压榨到什么都不剩……",
  "0102Adv03_Narrative012": "雪莉突然一下子想起来了。",
  "0102Adv03_Sherry005": "不对，<br>\n我们完全没制定越狱计划吧！？",
  "0102Adv03_Hanna005": "放风时间马上要结束了哦！？",
  "0102Adv03_Ema010": "不、不过我们得知了更多情报，<br>\n比如监牢里没有装监控摄像头之类的……！",
  "0102Adv03_Ema011": "明天再认真制定计划吧！！",
  "0102Adv03_Narrative013": "三人迈着无力的步伐走在过道上。",
  "0102Adv03_Sherry006": "……不过，也许玛格的生存方式<br>\n是最合理的。",
  "0102Adv03_Hanna006": "你的意思是？",
  "0102Adv03_Sherry007": "精神压力积攒得越多，就会越容易魔女化。<br>\n既然如此，那不要让自己有压力就好了。",
  "0102Adv03_Sherry008": "我看玛格她<br>\n还是和先前一样，活得自由自在的，<br>\n不像会变成魔女的样子。",
  "0102Adv03_Ema012": "确实……",
  "0102Adv03_Ema013": "（而我们一直过着<br>\n　压力巨大的生活……）",
  "0102Adv03_Narrative014": "不快、焦躁、恐惧、愤怒。<br>\n种种负面情绪一点一滴地萦绕在艾玛她们的心里。",
  "0102Adv03_Ema014": "（魔女化的程度越深，杀意也就越重……<br>\n　那我们——）",
  "0102Adv03_Ema015": "在这里度过的时间越久，魔女化的程度就会越深。<br>\n也许正因为如此，<br>\n奈叶香才会说我们没有时间了……",
  "0102Adv03_Sherry009": "是啊。<br>\n而杀意变重的奈叶香<br>\n现在行踪不明。",
  "0102Adv03_Sherry010": "或许下次再现身时，<br>\n她已经成了杀人犯。",
  "0102Adv03_Narrative015": "汉娜顿时面色苍白，不停地在发抖。",
  "0102Adv03_Hanna007": "怎么会这样……她还带着那么吓人的枪，<br>\n谁能抵抗得了她……",
  "0102Adv03_Sherry011": "我们也有反击的办法。<br>\n一旦发现她，立刻把她打倒就行！",
  "0102Adv03_Ema016": "雪、雪莉，你在说什么啊！？",
  "0102Adv03_Sherry012": "……咦？<br>\n我说得不对吗……？",
  "0102Adv03_Sherry013": "要是变成了魔女的话，她就不会轻易死掉了，<br>\n只是反击一下又不至于杀死它，应该没事啦。",
  "0102Adv03_Sherry014": "哪怕对手是魔女，<br>\n让它暂时不能行动，我们还是能做到的吧？",
  "0102Adv03_Ema017": "奈叶香不一定已经魔女化了。<br>\n她可能只是心态变悲观了。",
  "0102Adv03_Sherry015": "说得也是，等我们拿到确凿的证据再说反击的事吧。<br>\n欸嘿，我以后会注意的！",
  "0102Adv03_Ema018": "（雪莉……偶尔会说些可怕的话呢……）",
  "0102Adv03_Narrative016": "艾玛很担心奈叶香，<br>\n但并没有收到发现她的报告。",
  "0102Adv03_Ema019": "（奈叶香说，<br>\n　她用幻视魔法得知了这座监牢的情报）",
  "0102Adv03_Ema020": "（就算她知道其他人都不知道的藏身处<br>\n　也不奇怪）",
  "0102Adv03_Ema021": "（但是，她真的能连着好几天躲过<br>\n　典狱长和看守的监视吗……？）",
  "0102Adv03_Narrative017": "至少，艾玛她们正处在<br>\n被监视的情况下，只能老实去遵守明文规定。",
  "0102Adv03_Narrative018": "今天典狱长的通知也该来了。",
  "0102Adv03_Narrative019": "最后，艾玛她们还是只能遵守规定<br>\n回到自己的牢房。"
}
}
