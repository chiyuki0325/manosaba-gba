    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛和往常一样走进淋浴房，<br>\n没想到遇见了亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off"}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "呃。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "（已经习惯被她摆臭脸了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "亚里沙，跟我聊一……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "我跟你没话好说！<br>\n不是说了我干不了吗！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "你就不想离开这里吗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema003"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "当然想啊！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa003"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "饭难吃得要死，房间又黑又潮湿，<br>\n一天到晚被人监视，搞不好就要被杀死。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa004"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "我也在以自己的方法寻找出路啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa005"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "你找到什么方法了吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "呃……<br>\n这个嘛，就，慢慢来吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa006"]}},
    {"op": "AnimateActorExtended", "line": 55, "indent": 0, "params": {"ActorIds": ["Alisa"], "Loop": 0, "ScenePositionX": "20"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "亚里沙慢慢地挪动步子，<br>\n想从门口逃走。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "为什么说你做不到，<br>\n明明你的魔法那么强大。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "能凭空生火简直就是奇迹。<br>\n你的魔法一定可以——！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "……<br>\n我的魔法你又懂什么！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa007"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "根本就是你一厢情愿，我看你什么都不懂！<br>\n这破魔法我才不想要呢！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa008"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "面对怒火朝天的亚里沙，<br>\n艾玛吓得有些退缩，但她坚持下来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "我很羡慕你啊！<br>\n因为我什么都没有！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Angle01/Option_ArmL+,ArmL11,ArmR1"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "既然你那么想要，那我就给你！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa009"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL8,ArmR1"}},
    {"op": "PlaySfxModified", "line": 87, "indent": 0, "params": {"SfxPath": "Sfx_46", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "啊……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema008"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "亚里沙或许想要吓一吓艾玛，<br>\n于是举起手对着她，从掌心放出火焰。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative004"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "那火焰比想像中要猛烈。<br>\n它直奔艾玛，烧焦了她的衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative005"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "艾玛顿时惊慌失措，<br>\n但亚里沙的脸色比她惨白得多。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Surprised1,Option-ArmL-Off,ArmL4,ArmR1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "喂你没事吧！？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa010"]}},
    {"op": "StopBgm", "line": 105, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 106, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "亚里沙急忙跑了过去，<br>\n扭开淋浴的龙头放水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative007"]}},
    {"op": "PlayBgm", "line": 111, "indent": 0, "params": {"BgmPath": "Ambi_2_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 113, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "130_1"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "艾玛衣服上的火焰<br>\n很快就被水给冲灭了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative008"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "艾玛和亚里沙<br>\n都被淋得浑身湿透。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative009"]}},
    {"op": "StopBgm", "line": 119, "indent": 0, "params": {"BgmPath": "Ambi_2_1"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "亚里沙好像感觉有些呼吸不畅，于是便摘下了口罩。<br>\n她皱起眉，一脸担心地盯着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative010"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "抱歉。你，没受伤吧……？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa011"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "嗯、嗯。我没事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema009"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "（说起来，我还是第一次见到<br>\n　亚里沙的真面目……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema010"]}},
    {"op": "ModifyBackgroundExtended", "line": 129, "indent": 0, "params": {"Id": "Stills", "Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 30.0], "AppearanceAndTransition": "130_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "艾玛目不转睛地盯着<br>\n亚里沙的脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative011"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "……接近我就是这个下场，<br>\n别再缠着我了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa012"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "……我不听。<br>\n我需要你。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema011"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "你这家伙，不是才吃了亏，还不长记性吗。<br>\n我的魔法很危险的。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa013"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "一点也不可怕，我只是有点吃惊。<br>\n而且你还来救我，我好开心。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema012"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "就算我遇到危险，<br>\n你也一定会来救我的吧？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema013"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "那就没问题了！<br>\n你的魔法一点都不可怕！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema014"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "——！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa014"]}},
    {"op": "HideActors", "line": 147, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "热气球马上就要完成了，<br>\n大概明后天的样子。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema015"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "计划执行的那天，我会等你的。<br>\n因为只有你能做到。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema016"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "……随你怎么说吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Alisa015"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "这是她到目前为止最无力的一次拒绝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Narrative012"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "（接下来只能相信亚里沙了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv13_Ema017"]}},
