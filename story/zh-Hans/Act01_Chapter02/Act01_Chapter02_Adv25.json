    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "汉娜正站在玄关大厅里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "汉娜，你在这做什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "啊，是艾玛啊。<br>\n我刚刚在调查有没办法外出。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Hanna001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "外出……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "我觉得，<br>\n凶手有可能是从外面进来的……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 36, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "汉娜似乎有些难以启齿，<br>\n但艾玛一下子就想到了<br>\n她脑海里的怀疑对象是谁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Narrative002"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（也许奈叶香从外面入侵，把米莉亚给……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema003"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "（话说回来，<br>\n　我们甚至不知道奈叶香藏在哪里）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema004"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（或许她一直躲在监牢里。<br>\n　然后找准时机——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema005"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "艾玛用力摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Narrative003"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（先入为主是不对的！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "正门是锁着的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Hanna003"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "汉娜的话<br>\n让艾玛悄悄松了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Narrative004"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "对了，我还找到了这个。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Hanna004"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "铲子……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema007"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "这是放在清扫工具柜里面的。<br>\n好像是会定期更换。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Hanna005"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "凶手可能就是用它挖洞<br>\n潜入了米莉亚的惩罚室！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "嗯……但我印象中惩罚室里<br>\n好像没有什么洞吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema008"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "刚刚还洋洋得意的汉娜<br>\n顿时变得垂头丧气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "那倒也是……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "总、总之我再去找找看其他线索！<br>\n谢谢你汉娜！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv25_Ema009"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
