    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛回到会客厅一看，<br>\n可可留在这里还没走。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "她坐在沙发上，脸埋在双膝间，<br>\n肩膀不住地发抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（可可一定受到了相当大的打击吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "艾玛在犹豫要不要上前打招呼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（稍微调查一下就赶紧走吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema002"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "她蹑手蹑脚地走了进来，<br>\n努力不发出任何声音，<br>\n但可可注意到了她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "啊，原来是你啊艾玛亲。<br>\n你在搜查？查来查去有什么意义吗？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco001"]}},
    {"op": "HideAllCharacters", "line": 40, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "什么意义……因为不调查的话<br>\n就不知道杀害米莉亚的凶手是谁啊。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema003"]}},
    {"op": "HideAllCharacters", "line": 45, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "是谁都无所谓吧。<br>\n她被杀也是理所当然的。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco002"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1,ArmR1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "说得也太过分了……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema004"]}},
    {"op": "HideAllCharacters", "line": 55, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "可可狠狠瞪了眼艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "谁让她背叛了我们！<br>\n被杀也是活该！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco003"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "（可可在逞强……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema005"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "她大概是无法接受米莉亚的死亡，<br>\n甚至没力气离开这里吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative006"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "艾玛找不到话反驳她，<br>\n只能悲伤地看向她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "对了，这个给你。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco004"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "可可冷不防地把一团皱皱巴巴的纸递给艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative008"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "（这是什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema006"]}},
    {"op": "SpawnExtended", "line": 84, "indent": 0, "params": {"Path": "Clue", "Params": ["2-1"]}},
