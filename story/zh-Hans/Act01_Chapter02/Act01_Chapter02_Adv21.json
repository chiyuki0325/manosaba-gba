    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "她摊开纸团，<br>\n上面有潦草的字迹写着<br>\n【20时 在惩罚室举行拷问秀】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "这是……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema007"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "今天晚上我看到有便条贴在这边墙上，<br>\n就把它给撕下来了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco005"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "会不会是运营方写的。<br>\n真恶心。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco006"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "（说起来，典狱长好像讲过<br>\n　【杀鸡儆猴】什么的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema008"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "（难道说，这是杀害米莉亚的<br>\n　预告信……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema009"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "艾玛低头看着纸上潦草的字，<br>\n吞了吞口水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "可可，你当时发现这张纸的时候……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema010"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "现在不行。抱歉，我不想跟任何人说话。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco007"]}},
    {"op": "HideActors", "line": 111, "indent": 0, "params": {"ActorIds": ["Coco"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "可可又一次把脸埋在双膝间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative011"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "……审判我会好好参加的。<br>\n到那时我会，怎么说呢……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco008"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "我会回到平常那样。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Coco009"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "……嗯，对不起。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema011"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "（现在就让她一个人静静吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Ema012"]}},
    {"op": "HideActors", "line": 125, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "艾玛快步走出了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0102Adv21_Narrative012"]}},
