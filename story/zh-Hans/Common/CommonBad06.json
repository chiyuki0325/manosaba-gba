    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "你们快说些什么啊！<br>\n我没有杀死亚里沙！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Ema003"]}},
