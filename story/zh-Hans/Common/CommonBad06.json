    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "艾玛小姐，我……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 53, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.9"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "哎，这已经是最终决定了。<br>\n虽然很遗憾，但只能请你接受这个结果了。<br>\n我想早点闭庭……能让我继续下一个环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Warden001"]}},
    {"op": "HideAllCharacters", "line": 57, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "尽管艾玛声泪俱下地哭诉自己的无辜，<br>\n但典狱长却不为所动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "呜呜呜……我……我没有……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.9"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "好，接下来让我更换处刑装置……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Warden002"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful1,ArmR11,ArmL15,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "呜哇啊啊啊啊啊啊！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Ema005"]}},
    {"op": "HideAllCharacters", "line": 69, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 73, "indent": 0, "params": {"SfxPath": "Sfx_58", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "艾玛突然惊恐地大叫起来，撒腿就跑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Scream_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "不！不是我！<br>\n我没有杀人！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default,ArmR11,ArmL15,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "这太奇怪了！<br>\n救命！爸爸……妈妈……！<br>\n谁来救救我！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Ema007"]}},
    {"op": "HideAllCharacters", "line": 83, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.11"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "哎呀呀……不可以逃跑哦。<br>\n不过，逃跑也是白费力气。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Warden003"]}},
    {"op": "HideAllCharacters", "line": 87, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Jailer.5"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "在哭嚎着的艾玛面前，看守堵住了她的去路——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Narrative009"]}},
