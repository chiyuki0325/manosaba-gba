    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "…………", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Coco001"]}},
