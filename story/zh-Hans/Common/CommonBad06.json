    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "看到手机上自己的照片，<br>\n艾玛用颤抖的声音说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "我说……为什么！？<br>\n为什么要投票给我！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad06_Ema002"]}},
