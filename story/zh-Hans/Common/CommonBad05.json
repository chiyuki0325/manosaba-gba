{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Common/CommonBad05",
  "events": [
    {"op": "Gosub", "line": 1, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-ex5", "line": 3, "indent": 0},
    {"op": "PlayBgm", "line": 5, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 7, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyCharacterExtended", "line": 10, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.9"}},
    {"op": "PrintTextModified", "line": 11, "indent": 0, "params": {"Text": "那个，各位，是时候请大家开始投票了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Warden001"]}},
    {"op": "HideAllCharacters", "line": 13, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "讨论尚未得出明确答案，<br>\n但典狱长已经宣告了议论的结束。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "我没意见。<br>\n我已经决定好要投票给谁了～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Coco001"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "可可向亚里沙投去别有深意的视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR7,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Sweat>Sweat02,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "…………", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 24, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "这次会是谁以【魔女】的身份接受处刑——<br>\n所有人都按着手机，进行投票。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative003"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "然后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative004"]}},
    {"op": "PlaySfxModified", "line": 30, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 32, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "随着一声滑稽的庆祝音效响起，<br>\n手机上出现了亚里沙的照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "呃，根据结果……<br>\n决定对得票最多的紫藤亚里沙实施刑罚咯！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Warden002"]}},
    {"op": "PlayBgm", "line": 39, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 40, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Default,ArmR7,ArmL3,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Sweat>Sweat02,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "该死，该死……开什么玩笑！<br>\n为什么是我……！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa002"]}},
    {"op": "PlaySfxModified", "line": 45, "indent": 0, "params": {"SfxPath": "Sfx_96", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "亚里沙一边恶狠狠地说道，<br>\n一边将自己的手机用力摔在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Gross_Open"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "还用问为什么，这不是很合理吗。<br>\n从放火等等现场情况来看，明显你就是凶手啊。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR4,ArmL6,Angle01/Facial/Eyes>Eyes_Angry_Open01,Angle01/Facial/Sweat>Sweat02,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "开什么玩笑……我才没干！<br>\n我没杀那家伙的动机好吗！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa003"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Pensive_Middle"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "我管你什么动机。<br>\n不是魔女会有杀人冲动吗。<br>\n毕竟你平时就在那里喊打喊杀的，狠得要命。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR1,ArmL3,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Sweat>Sweat02,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "不、不对……我、我其实……！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa004"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Angry_Open01"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "放弃吧！大家就是觉得你可疑，<br>\n才投票给你的啊！<br>\n所以你才会高票通过啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Coco004"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "亚里沙向其他少女们投去视线。<br>\n那双因愤怒与绝望而扭曲的眼睛，<br>\n最终又像是死了心似的垂了下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR1,ArmL3,Angle01/Facial/Eyes>Eyes_Cry_Open,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "是啊……我早知道了。<br>\n只要我死了，大家就会满足了，对吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa005"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR9,ArmL3,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "哈……反正是迟早的事。<br>\n反正你们所有人，都一样会死。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa006"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Warden.10"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "呃，感觉当事人好像也没异议了，<br>\n那我就继续咯？<br>\n不过，就算有意见也会继续啦……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Warden003"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR9,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Closed,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "随便你……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa007"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "那么各位，请按下处刑执行的按钮吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Warden004"]}},
    {"op": "PlaySfxModified", "line": 84, "indent": 0, "params": {"SfxPath": "Sfx_86", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "好了！那么，<br>\n现在开始执行对魔女的刑罚～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Warden005"]}},
    {"op": "HideAllCharacters", "line": 92, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 95, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "机关开始启动，装置显出了身形。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default,ArmR13,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "椅子……？那是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "电椅，吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Margo001"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "那是放出高电压，令囚犯触电致死的<br>\n处刑执行装置——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR1,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Closed,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "…………", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa008"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default,ArmR5,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "亚里沙……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema002"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "亚里沙看见电椅，不禁颤抖了起来。<br>\n这时艾玛向她搭话了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR7,ArmL6,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "你好烦……不要再管我了。<br>\n反正你也投票给我了吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa009"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default,ArmR5,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "我、我……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema003"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "接收到拒绝的回应后，艾玛不禁退缩了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Default,ArmR7,ArmL6,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "……算了吧。反正不止是我，<br>\n你们所有人都没救了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa010"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "亚里沙自暴自弃地说道，<br>\n接着自行走到装置面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative012"]}},
    {"op": "PlaySfxModified", "line": 130, "indent": 0, "params": {"SfxPath": "Sfx_97", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 132, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 133, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 134, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "椅子似乎正散发着某种邪气。<br>\n而亚里沙在椅子上坐了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative013"]}},
    {"op": "PlaySfxModified", "line": 139, "indent": 0, "params": {"SfxPath": "Sfx_95", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "看守将亚里沙的身体绑在了电椅上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative014"]}},
    {"op": "ResetText", "line": 143, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 145, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "550_1"}},
    {"op": "ModifyBackgroundExtended", "line": 146, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 147, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "哈哈……能先走一步，<br>\n说不定还更好……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa011"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "亚里沙用颤抖的声音编织着话语。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative015"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "不管是我，还是你们，反正所有人，<br>\n接下来只会变成魔女，纯粹等死……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa012"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "从被抓来这个地方的那一刻起，就算反抗也没用。<br>\n既然这样……那还是走了会更轻松。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa013"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "什么侦探游戏审判游戏……全都无聊死了。<br>\n谁想继续的，随便她继续。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Alisa014"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "叽、叽里咕噜的说什么呢！<br>\n摆一副大彻大悟的嘴脸，真是恶心到爆！<br>\n喂我说，能不能赶紧送她归西啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Coco005"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "好啦好啦，不用你说……<br>\n那么，拜托你了～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Warden006"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "随着典狱长一声令下，看守也已就位。<br>\n它将手放在似乎是用去启动装置的拉杆上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative016"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "尽管亚里沙摆出一副认命的样子，<br>\n但面对即将来临的死亡，还是压抑不住内心的恐惧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative017"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "她颤抖着身体，<br>\n发出抽搐般的呼吸声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative018"]}},
    {"op": "PlaySfxModified", "line": 170, "indent": 0, "params": {"SfxPath": "Sfx_98", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "典狱长对着看守张了张翅膀。<br>\n紧接着，看守缓慢拉下了拉杆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative019"]}},
    {"op": "ModifyBackgroundExtended", "line": 174, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "550_2"}},
    {"op": "PlaySfxModified", "line": 177, "indent": 0, "params": {"SfxPath": "Sfx_99", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 178, "indent": 0, "params": {"SfxPath": "Sfx_100", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "装置启动，电流导通。<br>\n被绑在椅子上的亚里沙全身颤抖起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative020"]}},
    {"op": "PlaySfxModified", "line": 183, "indent": 0, "params": {"SfxPath": "Sfx_99", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 184, "indent": 0, "params": {"SfxPath": "Sfx_100", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "真狠啊，<br>\n竟然直接通电……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Sherry001"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "欸，什么意思？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema004"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "虽然是书上看来的……电椅处刑一般是<br>\n要往囚犯身上泼水的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Sherry002"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "因为泼水会比较容易导电，<br>\n能更容易把人电死。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Sherry003"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "也就是说，没经过这道步骤的亚里沙她——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative021"]}},
    {"op": "PlaySfxModified", "line": 201, "indent": 0, "params": {"SfxPath": "Sfx_99", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 202, "indent": 0, "params": {"SfxPath": "Sfx_100", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "从痛苦挣扎着的亚里沙的身体上<br>\n冒出了烟和蓝白色的火花。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative022"]}},
    {"op": "PlayBgm", "line": 207, "indent": 0, "params": {"BgmPath": "Ambi_6_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "不久后紫藤亚里沙全身被火焰吞噬，<br>\n化作了异形——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative023"]}},
    {"op": "StopBgm", "line": 211, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 212, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 213, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 214, "indent": 0, "params": {"WaitMode": "1.6"}},
    {"op": "ModifyBackgroundExtended", "line": 216, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "HideActors", "line": 217, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.0, "Lazy": 0}},
    {"op": "HideAllCharacters", "line": 218, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 219, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 220, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PlayBgm", "line": 222, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "亚里沙的处刑执行完毕后，<br>\n艾玛独自一人在牢房内抱膝抽泣。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed03,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Middle"}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "呜呜呜呜……汉娜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed03,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Closed02"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "（凶杀案还会发生的吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema006"]}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "（到时候又会有人被杀……<br>\n　又会有人被当作魔女处刑……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Lifeless02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "也许亚里沙说得没错……<br>\n我们，已经……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema009"]}},
    {"op": "HideAllCharacters", "line": 240, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "忽然，艾玛感觉到一股异味，不禁吸了吸鼻子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR13,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open"}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "怎么回事……好像有股焦臭味……？<br>\n而且，感觉还有点闷热……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 246, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR10,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open"}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "唔……应该不是有东西着火，吧？<br>\n……难道，刚刚的味道还没散……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema011"]}},
    {"op": "HideAllCharacters", "line": 249, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "艾玛想起亚里沙的身体烧焦的味道，<br>\n瞬时脸色煞白。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative026"]}},
    {"op": "PlaySfxModified", "line": 253, "indent": 0, "params": {"SfxPath": "Sfx_64", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 255, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR10,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "这是什么声音……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema012"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "艾玛想要确认这道突如其来的声音的来源，<br>\n便从铁栅栏内往过道方向探望——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative027"]}},
    {"op": "PlaySfxModified", "line": 261, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 263, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 264, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 265, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 266, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlaySfxModified", "line": 269, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 271, "indent": 0, "params": {"TintColor": "#ff0000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 272, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 274, "indent": 0, "params": {"TintColor": "#ff0000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 275, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "被某人袭击的艾玛受了致命伤，<br>\n趴倒在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative028"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "看见铁栅栏对面的人影，艾玛瞪大了双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative029"]}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "（怎么会，为什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema013"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Ema014"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "疑问未能成声——<br>\n艾玛便断了气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative030"]}},
    {"op": "ResetText", "line": 287, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 288, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 289, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 291, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 292, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 294, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 295, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 296, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "艾玛被人杀死了。<br>\n她成了下一位牺牲者，而杀死她的又会是谁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative031"]}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "是出现了新的凶手？<br>\n还是杀死汉娜的真凶另有其人——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative032"]}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "魔女审判又将再次开庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative033"]}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "而真相是否能水落石出，谁也无法保证——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad05_Narrative034"]}},
    {"op": "Gosub", "line": 309, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "ClearBacklog", "line": 311, "indent": 0, "params": {}},
    {"op": "ReturnToTitle", "line": 312, "indent": 0, "params": {"FadeDuration": 1.2000000476837158, "MinDelayDuration": 0.6000000238418579, "Wait": 1}}
  ],
  "translations": {
  "CommonBad05_Warden001": "那个，各位，是时候请大家开始投票了。",
  "CommonBad05_Narrative001": "讨论尚未得出明确答案，<br>\n但典狱长已经宣告了议论的结束。",
  "CommonBad05_Coco001": "我没意见。<br>\n我已经决定好要投票给谁了～",
  "CommonBad05_Narrative002": "可可向亚里沙投去别有深意的视线。",
  "CommonBad05_Alisa001": "…………",
  "CommonBad05_Narrative003": "这次会是谁以【魔女】的身份接受处刑——<br>\n所有人都按着手机，进行投票。",
  "CommonBad05_Narrative004": "然后。",
  "CommonBad05_Narrative005": "随着一声滑稽的庆祝音效响起，<br>\n手机上出现了亚里沙的照片。",
  "CommonBad05_Warden002": "呃，根据结果……<br>\n决定对得票最多的紫藤亚里沙实施刑罚咯！",
  "CommonBad05_Alisa002": "该死，该死……开什么玩笑！<br>\n为什么是我……！！",
  "CommonBad05_Narrative006": "亚里沙一边恶狠狠地说道，<br>\n一边将自己的手机用力摔在地上。",
  "CommonBad05_Coco002": "还用问为什么，这不是很合理吗。<br>\n从放火等等现场情况来看，明显你就是凶手啊。",
  "CommonBad05_Alisa003": "开什么玩笑……我才没干！<br>\n我没杀那家伙的动机好吗！！",
  "CommonBad05_Coco003": "我管你什么动机。<br>\n不是魔女会有杀人冲动吗。<br>\n毕竟你平时就在那里喊打喊杀的，狠得要命。",
  "CommonBad05_Alisa004": "不、不对……我、我其实……！",
  "CommonBad05_Coco004": "放弃吧！大家就是觉得你可疑，<br>\n才投票给你的啊！<br>\n所以你才会高票通过啊！！",
  "CommonBad05_Narrative007": "亚里沙向其他少女们投去视线。<br>\n那双因愤怒与绝望而扭曲的眼睛，<br>\n最终又像是死了心似的垂了下去。",
  "CommonBad05_Alisa005": "是啊……我早知道了。<br>\n只要我死了，大家就会满足了，对吧。",
  "CommonBad05_Alisa006": "哈……反正是迟早的事。<br>\n反正你们所有人，都一样会死。",
  "CommonBad05_Warden003": "呃，感觉当事人好像也没异议了，<br>\n那我就继续咯？<br>\n不过，就算有意见也会继续啦……",
  "CommonBad05_Alisa007": "随便你……",
  "CommonBad05_Warden004": "那么各位，请按下处刑执行的按钮吧。",
  "CommonBad05_Warden005": "好了！那么，<br>\n现在开始执行对魔女的刑罚～",
  "CommonBad05_Narrative008": "机关开始启动，装置显出了身形。",
  "CommonBad05_Ema001": "椅子……？那是……",
  "CommonBad05_Margo001": "电椅，吧。",
  "CommonBad05_Narrative009": "那是放出高电压，令囚犯触电致死的<br>\n处刑执行装置——",
  "CommonBad05_Alisa008": "…………",
  "CommonBad05_Ema002": "亚里沙……",
  "CommonBad05_Narrative010": "亚里沙看见电椅，不禁颤抖了起来。<br>\n这时艾玛向她搭话了。",
  "CommonBad05_Alisa009": "你好烦……不要再管我了。<br>\n反正你也投票给我了吧。",
  "CommonBad05_Ema003": "我、我……！",
  "CommonBad05_Narrative011": "接收到拒绝的回应后，艾玛不禁退缩了。",
  "CommonBad05_Alisa010": "……算了吧。反正不止是我，<br>\n你们所有人都没救了。",
  "CommonBad05_Narrative012": "亚里沙自暴自弃地说道，<br>\n接着自行走到装置面前。",
  "CommonBad05_Narrative013": "椅子似乎正散发着某种邪气。<br>\n而亚里沙在椅子上坐了下来。",
  "CommonBad05_Narrative014": "看守将亚里沙的身体绑在了电椅上。",
  "CommonBad05_Alisa011": "哈哈……能先走一步，<br>\n说不定还更好……",
  "CommonBad05_Narrative015": "亚里沙用颤抖的声音编织着话语。",
  "CommonBad05_Alisa012": "不管是我，还是你们，反正所有人，<br>\n接下来只会变成魔女，纯粹等死……",
  "CommonBad05_Alisa013": "从被抓来这个地方的那一刻起，就算反抗也没用。<br>\n既然这样……那还是走了会更轻松。",
  "CommonBad05_Alisa014": "什么侦探游戏审判游戏……全都无聊死了。<br>\n谁想继续的，随便她继续。",
  "CommonBad05_Coco005": "叽、叽里咕噜的说什么呢！<br>\n摆一副大彻大悟的嘴脸，真是恶心到爆！<br>\n喂我说，能不能赶紧送她归西啊！！",
  "CommonBad05_Warden006": "好啦好啦，不用你说……<br>\n那么，拜托你了～",
  "CommonBad05_Narrative016": "随着典狱长一声令下，看守也已就位。<br>\n它将手放在似乎是用去启动装置的拉杆上。",
  "CommonBad05_Narrative017": "尽管亚里沙摆出一副认命的样子，<br>\n但面对即将来临的死亡，还是压抑不住内心的恐惧。",
  "CommonBad05_Narrative018": "她颤抖着身体，<br>\n发出抽搐般的呼吸声。",
  "CommonBad05_Narrative019": "典狱长对着看守张了张翅膀。<br>\n紧接着，看守缓慢拉下了拉杆。",
  "CommonBad05_Narrative020": "装置启动，电流导通。<br>\n被绑在椅子上的亚里沙全身颤抖起来。",
  "CommonBad05_Sherry001": "真狠啊，<br>\n竟然直接通电……",
  "CommonBad05_Ema004": "欸，什么意思？",
  "CommonBad05_Sherry002": "虽然是书上看来的……电椅处刑一般是<br>\n要往囚犯身上泼水的。",
  "CommonBad05_Sherry003": "因为泼水会比较容易导电，<br>\n能更容易把人电死。",
  "CommonBad05_Narrative021": "也就是说，没经过这道步骤的亚里沙她——",
  "CommonBad05_Narrative022": "从痛苦挣扎着的亚里沙的身体上<br>\n冒出了烟和蓝白色的火花。",
  "CommonBad05_Narrative023": "不久后紫藤亚里沙全身被火焰吞噬，<br>\n化作了异形——",
  "CommonBad05_Narrative024": "亚里沙的处刑执行完毕后，<br>\n艾玛独自一人在牢房内抱膝抽泣。",
  "CommonBad05_Ema005": "呜呜呜呜……汉娜……",
  "CommonBad05_Ema006": "（凶杀案还会发生的吧……）",
  "CommonBad05_Ema007": "（到时候又会有人被杀……<br>\n　又会有人被当作魔女处刑……）",
  "CommonBad05_Ema008": "也许亚里沙说得没错……<br>\n我们，已经……",
  "CommonBad05_Ema009": "……？",
  "CommonBad05_Narrative025": "忽然，艾玛感觉到一股异味，不禁吸了吸鼻子。",
  "CommonBad05_Ema010": "怎么回事……好像有股焦臭味……？<br>\n而且，感觉还有点闷热……",
  "CommonBad05_Ema011": "唔……应该不是有东西着火，吧？<br>\n……难道，刚刚的味道还没散……",
  "CommonBad05_Narrative026": "艾玛想起亚里沙的身体烧焦的味道，<br>\n瞬时脸色煞白。",
  "CommonBad05_Ema012": "这是什么声音……？",
  "CommonBad05_Narrative027": "艾玛想要确认这道突如其来的声音的来源，<br>\n便从铁栅栏内往过道方向探望——",
  "CommonBad05_Narrative028": "被某人袭击的艾玛受了致命伤，<br>\n趴倒在地上。",
  "CommonBad05_Narrative029": "看见铁栅栏对面的人影，艾玛瞪大了双眼。",
  "CommonBad05_Ema013": "（怎么会，为什么……？）",
  "CommonBad05_Ema014": "…………",
  "CommonBad05_Narrative030": "疑问未能成声——<br>\n艾玛便断了气。",
  "CommonBad05_Narrative031": "艾玛被人杀死了。<br>\n她成了下一位牺牲者，而杀死她的又会是谁。",
  "CommonBad05_Narrative032": "是出现了新的凶手？<br>\n还是杀死汉娜的真凶另有其人——",
  "CommonBad05_Narrative033": "魔女审判又将再次开庭。",
  "CommonBad05_Narrative034": "而真相是否能水落石出，谁也无法保证——"
}
}
