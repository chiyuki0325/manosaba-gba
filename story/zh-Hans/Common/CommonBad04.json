{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Common/CommonBad04",
  "events": [
    {"op": "Gosub", "line": 1, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-ex4", "line": 3, "indent": 0},
    {"op": "PlayBgm", "line": 5, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 7, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "——直到最后，她们还是没有找出凶手，<br>\n便迎来了讨论时间的结束。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 12, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 13, "indent": 0, "params": {"Text": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Warden001"]}},
    {"op": "HideAllCharacters", "line": 14, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Lifeless04,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "（明明还没找出凶手，却要投票……<br>\n　可是，我们也只能照做了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema001"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "如果没有找出凶手，就要全员处死。<br>\n即使，那个人并不是真正的凶手——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative002"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "也需要推选出这么一位人物，以【魔女】的身份接受处刑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（可是，这实在是太难受了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema002"]}},
    {"op": "HideAllCharacters", "line": 26, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "不只是艾玛，<br>\n在场的所有人都脸色苍白地颤抖着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative004"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "然而，投票时间无情地降临了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative005"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "少女们各自按着自己的手机，<br>\n进行投票。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative006"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "然后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative007"]}},
    {"op": "StopBgm", "line": 36, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 41, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "在手机屏幕上出现的——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 48, "indent": 0, "params": {"SfxPath": "Sfx_35", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "是可可的照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative009"]}},
    {"op": "PlayBgm", "line": 54, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR6,ArmL10,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open,Angle01/Facial/Sweat>Sweat01,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "哈？等下……开什么玩笑……！？<br>\n这根本意义不明啊！<br>\n喂，投票给我的到底是谁啊……！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR1,ArmL3,Angle01/Facial/Eyes>Eyes_Cry_Open,Angle01/Facial/Mouth>Mouth_Angry_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "你们认真点思考好不好！<br>\n人怎么可能是我杀的啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Cry_Closed,Angle01/Facial/Mouth>Mouth_Surprised_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "这结果无效吧！<br>\n只要重新投票就好了吧……！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.4"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "呃，没有重来的机会了，敬请配合。<br>\n大家只要按下处刑按钮，<br>\n就会开始执行处刑了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Warden002"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Pensive_Middle,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "喂、喂，住手啊……<br>\n求你们，真的别按下去啦……<br>\n我说，你们住手啊……！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco004"]}},
    {"op": "HideAllCharacters", "line": 72, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "可可的请求苍白无力，<br>\n少女们各自按下了手中的按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 77, "indent": 0, "params": {"SfxPath": "Sfx_86", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "好了！那么，<br>\n现在开始执行对魔女的刑罚～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Warden003"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 87, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "随着典狱长一声令下，<br>\n机关开始启动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative011"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "接着，从某处传来了齿轮的转动声，<br>\n中央的底座颤动了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative012"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "地板开了一个洞，底座缓缓地往下降。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative013"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "然后，原本的底座消失不见，<br>\n一个新的底座出现了——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default,ArmR13,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "这……这什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema003"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 104, "indent": 0, "params": {"SfxPath": "Sfx_94", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "装置的顶部吊着复数锋利的刀刃，<br>\n像钟摆一样摇晃着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative015"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "而刀刃的正下方——<br>\n在装置的中央处，能看见一个绑住人的台子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Pensive_Middle,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "那是搞什么东西啊……<br>\n难不成，我要在下面……？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco005"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "看见那闪着寒光摇摇晃晃的刀刃，<br>\n可可便全身颤抖起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative017"]}},
    {"op": "HideAllCharacters", "line": 115, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Jailer.5"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "典狱长下达指示后，看守按住了可可的双臂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative018"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Angry_Open01,Angle01/Facial/Sweat>Sweat01,Angle01/Facial/Pale>Pale01"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "住手啊！别碰我好恶心！<br>\n放开我放开我放开我！不要！我不想过去！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco006"]}},
    {"op": "HideAllCharacters", "line": 123, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "看守将挣扎着手脚抵抗着的可可<br>\n拖上了舞台。<br>\n然后，将她固定在装置的台子上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative019"]}},
    {"op": "PlaySfxModified", "line": 128, "indent": 0, "params": {"SfxPath": "Sfx_95", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "560_1"}},
    {"op": "PlaySfxModified", "line": 137, "indent": 0, "params": {"SfxPath": "Sfx_94", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "噫、噫噫噫噫噫！？<br>\n这太不妙了……！要死了要死了……！<br>\n真的要死了啦……！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco007"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "错开着方向摆动着的刀刃缓缓降了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative020"]}},
    {"op": "PlaySfxModified", "line": 146, "indent": 0, "params": {"SfxPath": "Sfx_94", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "不要不要不要！我不想死！<br>\n我说住手啊！<br>\n求你们了！请你们住手！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco008"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "面对迫在眉睫的恐惧，可可脸部扭作一团，<br>\n如同恳求般放声大喊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative021"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "我们也很为难啊，这都是投票决定的结果。<br>\n啊，对了。要不要把过程直播一下呢？<br>\n标题就写：人生最后的直播，处刑的瞬间！怎样。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Warden004"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "哎，就是不知道会不会批准了……<br>\n这一定能走红吧？<br>\n啊，会被封台吧？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Warden005"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "吵死了，开什么玩笑……！<br>\n喂，你们别光看啊快帮帮我！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco009"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "……对不起，可可。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema004"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "如果干扰处刑，干扰者也视为同罪。<br>\n不光是艾玛，其他所有人都在恐惧的作用下无法动弹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative022"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "恶心恶心恶心恶心恶心恶心恶心！<br>\n我要诅咒你们！<br>\n所有人去死！去死去死去死去死！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco010"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "可可一边喷洒诅咒，一边胡乱地摇头晃脑。<br>\n而锋利的刀刃正无情地渐渐向她落下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative023"]}},
    {"op": "PlaySfxModified", "line": 169, "indent": 0, "params": {"SfxPath": "Sfx_94", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "我已经受不了了……！<br>\n啊啊啊啊……为什么，是我……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco011"]}},
    {"op": "PlaySfxModified", "line": 176, "indent": 0, "params": {"SfxPath": "Sfx_94", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "我不想死，我不想死，我不想——", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Coco012"]}},
    {"op": "ModifyBackgroundExtended", "line": 182, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "StopBgm", "line": 184, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 186, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "PlaySfxModified", "line": 192, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 197, "indent": 0, "params": {"SfxPath": "Sfx_53", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 201, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFFFF", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "Wait", "line": 204, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PlayBgm", "line": 207, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "可可的处刑执行完毕后，<br>\n艾玛独自一人在牢房内陷入深思。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR6,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "（凶杀案还会发生的吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Closed02"}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "（到时候又会有人被杀……<br>\n　又会有人被当作魔女处刑……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR13,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "说不定下次就轮到我……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema007"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "艾玛不禁颤抖了一下，然后往四下张望。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Lifeless02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "总感觉，好像有人在盯着我……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema008"]}},
    {"op": "HideAllCharacters", "line": 229, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "自从可可被处刑，<br>\n艾玛感觉有股神秘视线一直在看着她，这让她感到十分害怕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative026"]}},
    {"op": "PlaySfxModified", "line": 234, "indent": 0, "params": {"SfxPath": "Sfx_64", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Lifeless03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "这是什么声音……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Ema009"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "艾玛想要确认这道突如其来的声音的来源，<br>\n便从铁栅栏内往过道方向探望——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative027"]}},
    {"op": "HideAllCharacters", "line": 242, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 245, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 254, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 258, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "有人夺走了艾玛的性命。<br>\n艾玛成了下一位牺牲者，而杀死她的又会是谁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative028"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "是出现了新的凶手？<br>\n还是这次案件的真凶另有其人——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative029"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "魔女审判又将再次开庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative030"]}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "而真相是否能水落石出，谁也无法保证——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad04_Narrative031"]}},
    {"op": "Gosub", "line": 275, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
