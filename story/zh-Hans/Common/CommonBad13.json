    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Yuki.11"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "全・都・去・死・吧。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Yuki007"]}},
