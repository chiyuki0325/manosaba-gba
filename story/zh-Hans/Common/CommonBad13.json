    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "小雪缓缓地摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Yuki.8"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "无论堆砌怎样的辞藻，<br>\n那些可憎的记忆也不会消失。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Yuki002"]}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Yuki.7"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "我已经受够了。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Yuki003"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Yuki.19"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "但是呢……希罗，艾玛。<br>\n我很感谢你们。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Yuki004"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "小雪微微一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Narrative002"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "笑容很美。<br>\n但那溢出的愤怒与憎恶，却让我脊背发凉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Yuki.12"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "是你们的魔力，<br>\n让我有办法做到，以前无法做到的事情。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Yuki005"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "小雪缓缓张开双臂，仰望天空。<br>\n仿佛在宣告神谕一般，超然地编织着话语。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Yuki.12"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "呵呵呵……就让所有人类，<br>\n都听到我的声音吧。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad13_Yuki006"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Yuki.10"}},
