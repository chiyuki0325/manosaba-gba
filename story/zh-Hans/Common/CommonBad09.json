    {"op": "HideAllCharacters", "line": 109, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 110, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 111, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 113, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "ModifyBackgroundExtended", "line": 114, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 115, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "魔女审判结束后，<br>\n我来到了安安死亡的现场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative015"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "亚里沙以魔女的身份被处死了。<br>\n我和艾玛都逃过了一劫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative016"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "但是，这真的就好了吗……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative017"]}},
    {"op": "PlaySfxModified", "line": 124, "indent": 0, "params": {"SfxPath": "Sfx_73", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "忽然，我感到背后有人靠近。<br>\n接着，背上传来一阵灼烧般的剧痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative018"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "我倒在了地上，仰望着天空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative019"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "那就是【这次】记忆的最后一幕——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative020"]}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "我被某人杀害了，然后发动了死亡回溯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative021"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "某种意义上，这也许算得上是幸运。<br>\n下一次，我一定能做得更好——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative022"]}},
