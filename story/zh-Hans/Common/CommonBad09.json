    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ffffff", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 7, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "——少女们未能得出结论，时间徒然流逝。<br>\n为了选出应受处刑的魔女，投票开始了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative001"]}},
    {"op": "PrintTextModified", "line": 12, "indent": 0, "params": {"Text": "失败了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative002"]}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "安安的死是事故。<br>\n尽管我想将答案引导至这个方向……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative003"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "但现在只能将票<br>\n投给在至今为止的议论中受到怀疑的人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1,Arms4,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1,Sweat1-1"}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "（抱歉……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Hiro001"]}},
    {"op": "HideAllCharacters", "line": 21, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "我咬紧牙关按下按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative005"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "而被选出的人——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative006"]}},
    {"op": "PlaySfxModified", "line": 27, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Fearful1,ArmR7,ArmL3,Angle01/Facial/Sweat>Sweat02,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "啊？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "是亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Fearful1,ArmR4,ArmL6,Angle01/Facial/Eyes>Eyes_Angry_Open01,Angle01/Facial/Sweat>Sweat02"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "你们开什么玩笑……我才没动手！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 38, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "亚里沙怒视着我们。<br>\n憎恨和慌乱混杂在她颤抖的声音中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Default,ArmR9,ArmL8,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Sweat>Sweat02"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "这很有问题吧！<br>\n二阶堂不是说了吗！<br>\n说是她杀的……！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa003"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Open5,Mouth1_Determined_Closed1,Sweat1-1"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Flushed_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Neutral_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Ema001"]}},
    {"op": "StopBgm", "line": 52, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 53, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 54, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "哎，这已经是最终决定了。<br>\n虽然很遗憾，但只能请你接受这个结果了。<br>\n我想早点闭庭……能让我继续下一个环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Warden001"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "典狱长下达了指示，<br>\n看守开始准备绑住亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Fearful1,ArmR7,ArmL3,Angle01/Facial/Sweat>Sweat02"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "喂！给我等下！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa004"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Fearful1,ArmR9,ArmL8,Angle01/Facial/Sweat>Sweat02"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "我不接受……<br>\n凭什么我要被无理处死！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa005"]}},
    {"op": "HideAllCharacters", "line": 66, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 69, "indent": 0, "params": {"SfxPath": "Sfx_30", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "亚里沙的手上亮起魔法的火焰。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Default,ArmR5,ArmL11,Angle01/Facial/Eyes>Eyes_Angry_Open04,Angle01/Facial/Sweat>Sweat02"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "别靠近我！再靠近就烧了你们！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa006"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "看她的声音和表情就知道，<br>\n亚里沙的话并非恐吓。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative011"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "但是，看守根本就不吃这套。<br>\n它不怕火焰，步步逼近亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Fearful1,ArmR5,ArmL11,Angle01/Facial/Sweat>Sweat02"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "别过来！不许过来我这……！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa007"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.11"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "哎呀呀……不可以抵抗哦。<br>\n不过，抵抗也是白费力气。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Warden002"]}},
    {"op": "HideAllCharacters", "line": 88, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 91, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 94, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Fearful1,ArmR1,ArmL9,Angle01/Facial/Sweat>Sweat02"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Alisa008"]}},
    {"op": "HideAllCharacters", "line": 99, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "少女们发出了惨叫。<br>\n看守挥动镰刀，将亚里沙劈开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative013"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "亚里沙分成了两半，<br>\n她的鲜血染红了审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.11"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "唉呀～……地板和墙壁，都得打扫……<br>\n真希望不要再给我增加<br>\n无谓的工作了……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad09_Warden003"]}},
    {"op": "StopBgm", "line": 107, "indent": 0, "params": {}},
