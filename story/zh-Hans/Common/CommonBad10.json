  "events": [
    {"op": "Gosub", "line": 1, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-ex4", "line": 3, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 5, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 7, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 9, "indent": 0, "params": {"Text": "——希罗无法顺利完成少女们的魔女化，<br>\n只有时间徒然往前流动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative001"]}},
    {"op": "PrintTextModified", "line": 11, "indent": 0, "params": {"Text": "这么下去只会<br>\n无谓地伤害她们而已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative002"]}},
    {"op": "PrintTextModified", "line": 13, "indent": 0, "params": {"Text": "怎么办。该怎么办？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative003"]}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "几经纠结，最终我……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative004"]}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "从怀中取出了药瓶。<br>\n那是和仪礼剑一同，由梅露露取来的<br>\n【杀死魔女的药】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative005"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "我是以防万一才拿着的……<br>\n有办法的话，我是真不想用它。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative006"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "我将药瓶的内容物倾倒在仪礼剑上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1,ArmR5,ArmL7"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "希罗，你在干什……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Ema001"]}},
    {"op": "HideAllCharacters", "line": 26, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlayBgm", "line": 29, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 34, "indent": 0, "params": {"SfxPath": "Sfx_86", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default,ArmR6,ArmL6,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Lifeless03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Pale01>Pale01_03"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "欸……啊……咕啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Ema002"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "艾玛惊讶地睁大双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative008"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "我将涂了药的仪礼剑贯穿了她的胸口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default,ArmR6,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Lifeless03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Pale01>Pale01_03"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "希罗……为什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Ema003"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "困惑。悲伤。绝望。<br>\n各种各样的感情，现于其声，形于其色。<br>\n我拔出了插在艾玛胸口的剑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 48, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 52, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "鲜血染红了审判庭，樱羽艾玛就此殒命。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative011"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "因我的行动和艾玛的死，少女们喧闹了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "CreatureHiro.1"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "（为了拯救大家，我只能……<br>\n　把大家杀了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Hiro001"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "这么一来，就能从大魔女的诅咒中得到解放。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative013"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "她们不会再魔女化。<br>\n她们不会再失去自我，化作残骸，<br>\n不再受囚于不死的身体带来的长生之苦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "就由我来……拯救你们。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Hiro002"]}},
    {"op": "HideAllCharacters", "line": 69, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "我握紧了沾满艾玛鲜血的剑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative015"]}},
    {"op": "ModifyBackgroundExtended", "line": 74, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PlaySfxModified", "line": 79, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 81, "indent": 0, "params": {"TintColor": "#FFFFFF", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "有的少女向我投来敌意，破口大骂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative016"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "有的少女，只能面对我露出深深的恐惧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative017"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "有的少女直言我才是魔女，挺身反抗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative018"]}},
    {"op": "ModifyBackgroundExtended", "line": 90, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "泪划过了我的脸颊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative019"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "这时我才终于发现。<br>\n我的心，在作痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative020"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "不过，我做到了。<br>\n我【拯救了】大家。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative021"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "然后我……触犯了自己的禁忌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative022"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "我将仪礼剑的刃抵在自己的脖颈上。<br>\n手在颤抖，呼吸正慌乱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative023"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "没事的。这是【救赎】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative024"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "我没有做错。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative025"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "由我亲手结束一切，这才是正确的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative026"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我下定决心，拉动了手臂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative027"]}},
    {"op": "StopBgm", "line": 111, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 115, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "我的魔法，一定不会再次发动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative028"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "我，将迎来真正的死亡——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Narrative029"]}},
    {"op": "ModifyBackgroundExtended", "line": 123, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.9"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "所有人都死了……<br>\n这是否正如您所料呢？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Warden001"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "呵呵……谁知道呢？", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad10_Yuki001"]}},
    {"op": "Wait", "line": 133, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "HideAllCharacters", "line": 134, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Gosub", "line": 142, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
