  "path": "Common/CommonBad07",
  "events": [
    {"op": "Gosub", "line": 1, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-ex1", "line": 3, "indent": 0},
    {"op": "PlayBgm", "line": 5, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 7, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyCharacterExtended", "line": 10, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 11, "indent": 0, "params": {"Text": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Warden001"]}},
    {"op": "HideAllCharacters", "line": 13, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "——我还未能证明自己的清白，<br>\n典狱长就宣告讨论结束了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative001"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "被众人投票选为【魔女】的是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative002"]}},
    {"op": "PlaySfxModified", "line": 20, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "该说是意料之中还是什么好呢。<br>\n决定处刑二阶堂希罗啦～！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Warden002"]}},
    {"op": "HideAllCharacters", "line": 25, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 27, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 29, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR13,ArmL13,Eyes2_Angry_Open1,Mouth2_Angry_Closed1,Sweat2-1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Hiro001"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "我满怀憎恨，<br>\n瞪视着在场的每一个少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR13,ArmL12,Eyes2_Normal_Closed1,Mouth2_Angry_Open1,Sweat2-1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "你们是错误的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Hiro002"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "就算说了，也无法颠覆判决。<br>\n尽管如此，我还是重申了一遍。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR12,ArmL12,Eyes2_Angry_Open2,Mouth2_Angry_Open1,Sweat2-1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "你们……是错的……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Hiro003"]}},
    {"op": "HideAllCharacters", "line": 45, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "许多怜悯般的视线投向了我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative005"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "心底沸腾的怒火，<br>\n让我涌起毁掉一切的冲动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative006"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "被冲动驱使的同时，<br>\n却又觉得付诸行动也是无益。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL12,Eyes1_Angry_Open3,Mouth1_Determined_Closed1,Sweat1-1"}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.9"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "……好吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Hiro004"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "【现在】，我会接受这个结果。<br>\n毕竟我自己没做好，也是咎由自取。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Closed1,Sweat1-1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "快点结束吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Hiro005"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "……你这么爽快倒是帮了我大忙，<br>\n不过有点诡异呢。你是不是在搞什么小动作？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Warden003"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Open3,Mouth1_Fearful_Open1"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "没有。<br>\n事到如今再主张无罪，也只是徒增难堪罢了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.9"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "…………", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Warden004"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "不知道典狱长是否理解了我的话，<br>\n它只例行公事地回应了一句，<br>\n随后平静地开始推进处刑流程。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.2"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "大家只要按下手机上的处刑按钮，<br>\n就会开始执行处刑了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Warden005"]}},
    {"op": "HideAllCharacters", "line": 74, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "在典狱长的催促下，少女们脸色青白，<br>\n却还是接连按下了按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 79, "indent": 0, "params": {"SfxPath": "Sfx_86", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "好了！那么，<br>\n现在开始执行对魔女的刑罚～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Warden006"]}},
    {"op": "PlaySfxModified", "line": 87, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 90, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "随着典狱长一声令下，<br>\n某处的机关启动了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative011"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "接着，从某处传来了齿轮的转动声，<br>\n中央的底座颤动了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative012"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "地板开了一个洞，底座缓缓地往下降。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative013"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "看着那取代了原有的底座而出现的【那个东西】，<br>\n我的心脏剧烈地跳动起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative014"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "那是个像巨大铁棍般的装置。<br>\n其中央垂下一根绳子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative015"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "——是绞刑台。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative016"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "看守从后面押送着，我走上了绞刑台。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative017"]}},
    {"op": "ResetText", "line": 105, "indent": 0, "params": {}},
    {"op": "Wait", "line": 106, "indent": 0, "params": {"WaitMode": "1.0"}},
    {"op": "ModifyBackgroundExtended", "line": 108, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "530_1"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "站在绞刑台上，我抬头瞪视着那根绞索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative018"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "心中感到一阵骚动。<br>\n【那时】的景象不受控制地在脑海中闪现。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative019"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "无法消失、抹去不了的记忆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative020"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "自己的心跳声吵得耳朵发疼。<br>\n直到这时我才第一次发觉——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative021"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "我动摇了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative022"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "用来缢颈的绳圈。<br>\n我珍视的朋友就是被这种东西害死的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative023"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "如今。<br>\n它正向我招手，想要夺走我的生命。<br>\n它正等待着勒紧我的脖子，扼住我的呼吸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative024"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "……紧握的拳头在颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative025"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "没问题。我可以面对。<br>\n我不会被愤怒和恐惧吞噬。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative026"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "我挺直身姿，深吸一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative027"]}},
    {"op": "HideActors", "line": 132, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "已经没事了。我早已做好了觉悟。<br>\n汹涌的感情，已经彻底平息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative028"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.,Arms4,Eyes1_Normal_Closed1,Mouth1_Cry_Closed1,Sweat1-1,Pale1-1"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "快点结束吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Hiro007"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "看守把绳索套在我的脖子上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative029"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "然后。<br>\n脚下的地板打开——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative030"]}},
    {"op": "HideAllCharacters", "line": 143, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 145, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 147, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PlaySfxModified", "line": 152, "indent": 0, "params": {"SfxPath": "Sfx_127", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "二阶堂希罗被处决了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative031"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "她的魔法是【死亡回溯】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative032"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "但她的魔法没有发动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative033"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "用于处刑的绞索，<br>\n是为了制裁魔女而特制的道具。<br>\n——它具有封印魔法的效果。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative034"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "少女们的互相残杀仍未终结。<br>\n魔女审判仍在继续——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative035"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "但希罗已迎来了真正的终结。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad07_Narrative036"]}},
    {"op": "Gosub", "line": 173, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "ClearBacklog", "line": 175, "indent": 0, "params": {}},
    {"op": "ReturnToTitle", "line": 176, "indent": 0, "params": {"FadeDuration": 1.2000000476837158, "MinDelayDuration": 0.6000000238418579, "Wait": 1}}
  ],
  "translations": {
  "CommonBad07_Warden001": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？",
  "CommonBad07_Narrative001": "——我还未能证明自己的清白，<br>\n典狱长就宣告讨论结束了。",
  "CommonBad07_Narrative002": "被众人投票选为【魔女】的是——",
  "CommonBad07_Warden002": "该说是意料之中还是什么好呢。<br>\n决定处刑二阶堂希罗啦～！",
  "CommonBad07_Hiro001": "…………",
  "CommonBad07_Narrative003": "我满怀憎恨，<br>\n瞪视着在场的每一个少女。",
  "CommonBad07_Hiro002": "你们是错误的。",
  "CommonBad07_Narrative004": "就算说了，也无法颠覆判决。<br>\n尽管如此，我还是重申了一遍。",
  "CommonBad07_Hiro003": "你们……是错的……！",
  "CommonBad07_Narrative005": "许多怜悯般的视线投向了我。",
  "CommonBad07_Narrative006": "心底沸腾的怒火，<br>\n让我涌起毁掉一切的冲动。",
  "CommonBad07_Narrative007": "被冲动驱使的同时，<br>\n却又觉得付诸行动也是无益。",
  "CommonBad07_Hiro004": "……好吧。",
  "CommonBad07_Narrative008": "【现在】，我会接受这个结果。<br>\n毕竟我自己没做好，也是咎由自取。",
  "CommonBad07_Hiro005": "快点结束吧。",
  "CommonBad07_Warden003": "……你这么爽快倒是帮了我大忙，<br>\n不过有点诡异呢。你是不是在搞什么小动作？",
  "CommonBad07_Hiro006": "没有。<br>\n事到如今再主张无罪，也只是徒增难堪罢了。",
  "CommonBad07_Warden004": "…………",
  "CommonBad07_Narrative009": "不知道典狱长是否理解了我的话，<br>\n它只例行公事地回应了一句，<br>\n随后平静地开始推进处刑流程。",
  "CommonBad07_Warden005": "大家只要按下手机上的处刑按钮，<br>\n就会开始执行处刑了。",
  "CommonBad07_Narrative010": "在典狱长的催促下，少女们脸色青白，<br>\n却还是接连按下了按钮。",
  "CommonBad07_Warden006": "好了！那么，<br>\n现在开始执行对魔女的刑罚～",
  "CommonBad07_Narrative011": "随着典狱长一声令下，<br>\n某处的机关启动了。",
  "CommonBad07_Narrative012": "接着，从某处传来了齿轮的转动声，<br>\n中央的底座颤动了一下。",
  "CommonBad07_Narrative013": "地板开了一个洞，底座缓缓地往下降。",
  "CommonBad07_Narrative014": "看着那取代了原有的底座而出现的【那个东西】，<br>\n我的心脏剧烈地跳动起来。",
  "CommonBad07_Narrative015": "那是个像巨大铁棍般的装置。<br>\n其中央垂下一根绳子。",
  "CommonBad07_Narrative016": "——是绞刑台。",
  "CommonBad07_Narrative017": "看守从后面押送着，我走上了绞刑台。",
  "CommonBad07_Narrative018": "站在绞刑台上，我抬头瞪视着那根绞索。",
  "CommonBad07_Narrative019": "心中感到一阵骚动。<br>\n【那时】的景象不受控制地在脑海中闪现。",
  "CommonBad07_Narrative020": "无法消失、抹去不了的记忆。",
  "CommonBad07_Narrative021": "自己的心跳声吵得耳朵发疼。<br>\n直到这时我才第一次发觉——",
  "CommonBad07_Narrative022": "我动摇了。",
  "CommonBad07_Narrative023": "用来缢颈的绳圈。<br>\n我珍视的朋友就是被这种东西害死的。",
  "CommonBad07_Narrative024": "如今。<br>\n它正向我招手，想要夺走我的生命。<br>\n它正等待着勒紧我的脖子，扼住我的呼吸。",
  "CommonBad07_Narrative025": "……紧握的拳头在颤抖。",
  "CommonBad07_Narrative026": "没问题。我可以面对。<br>\n我不会被愤怒和恐惧吞噬。",
  "CommonBad07_Narrative027": "我挺直身姿，深吸一口气。",
  "CommonBad07_Narrative028": "已经没事了。我早已做好了觉悟。<br>\n汹涌的感情，已经彻底平息。",
  "CommonBad07_Hiro007": "快点结束吧。",
  "CommonBad07_Narrative029": "看守把绳索套在我的脖子上。",
  "CommonBad07_Narrative030": "然后。<br>\n脚下的地板打开——",
  "CommonBad07_Narrative031": "二阶堂希罗被处决了。",
  "CommonBad07_Narrative032": "她的魔法是【死亡回溯】。",
  "CommonBad07_Narrative033": "但她的魔法没有发动。",
  "CommonBad07_Narrative034": "用于处刑的绞索，<br>\n是为了制裁魔女而特制的道具。<br>\n——它具有封印魔法的效果。",
  "CommonBad07_Narrative035": "少女们的互相残杀仍未终结。<br>\n魔女审判仍在继续——",
  "CommonBad07_Narrative036": "但希罗已迎来了真正的终结。"
}
}
