    {"op": "ModifyBackgroundExtended", "line": 9, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 10, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlayBgm", "line": 12, "indent": 0, "params": {"BgmPath": "Bgm_12_1_Loop", "IntroBgmPath": "Bgm_12_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "——整座监狱岛都被亚里沙的魔法火焰吞噬，<br>\n并在汉娜的魔法作用下，飞向高空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative001"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "剧烈的震动和地鸣声响彻四周。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative002"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "飘浮到空中的监狱岛，<br>\n因无法承受自身重量而开始崩溃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "希罗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Ema001"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "艾玛一脸不安地看着我，<br>\n我无言地轻轻握住了她的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative004"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "我最终还是没能阻止堕落为魔女、<br>\n失去控制的少女——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "CreatureHiro.12"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "对不起……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Hiro001"]}},
    {"op": "HideAllCharacters", "line": 29, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "我再也做不到任何事，只能说出这样的话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative006"]}},
    {"op": "ModifyBackgroundExtended", "line": 34, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PlayBgm", "line": 39, "indent": 0, "params": {"BgmPath": "Ambi_7_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "不久，审判庭崩塌了，强烈的失重感向我袭来。<br>\n紧接着，我失去了意识——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative007"]}},
    {"op": "StopBgm", "line": 43, "indent": 0, "params": {}},
    {"op": "Wait", "line": 44, "indent": 0, "params": {"WaitMode": "1.0"}},
    {"op": "ModifyBackgroundExtended", "line": 51, "indent": 0, "params": {"TintColor": "#ffffff", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "监狱岛崩溃了，<br>\n被牵涉其中的少女们下落不明。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative008"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "这下有点麻烦了啊。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Warden001"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "唉，不过是死是活，<br>\n倒也无所谓了……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Warden002"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "无论是拥有魔女因子的人，<br>\n还是已经化为魔女的人，<br>\n都不能放任其在外界自由行动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative009"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "必须找到她们，对其施加适当的处置。<br>\n仅此而已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad11_Narrative010"]}},
    {"op": "Gosub", "line": 73, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
