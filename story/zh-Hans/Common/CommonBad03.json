    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "（凶杀案还会发生的吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Closed02"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "（到时候又会有人被杀……<br>\n　又会有人被当作魔女处刑……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR13,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "说不定下次就轮到我……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema004"]}},
    {"op": "PlaySfxModified", "line": 102, "indent": 0, "params": {"SfxPath": "Sfx_5", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Lifeless02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "哎呀，这个声音是……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema005"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "不经意间响起的声音，<br>\n离她越来越近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Lifeless03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "怎么回事呢……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema006"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "艾玛从铁栅栏内往过道方向探望——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative013"]}},
    {"op": "StopBgm", "line": 116, "indent": 0, "params": {}},
