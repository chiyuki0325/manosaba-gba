    {"op": "ModifyBackgroundExtended", "line": 135, "indent": 0, "params": {"TintColor": "#FFFFFFFF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 136, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 138, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 140, "indent": 0, "params": {"TintColor": "#FFFFFF00", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 141, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "被某人袭击的艾玛受了致命伤，<br>\n趴倒在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative014"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "看见铁栅栏对面的人影，艾玛瞪大了双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative015"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "（怎么会，为什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema007"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema008"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "疑问未能成声——<br>\n艾玛便断了气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative016"]}},
    {"op": "ModifyBackgroundExtended", "line": 155, "indent": 0, "params": {"TintColor": "#FFFFFFFF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 158, "indent": 0, "params": {"TintColor": "#FFFFFF00", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 160, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "艾玛被人杀死了。<br>\n她成了下一位牺牲者，而杀死她的又会是谁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative017"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "是出现了新的凶手？<br>\n还是杀死米莉亚的真凶另有其人——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative018"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "魔女审判又将再次开庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative019"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "而真相是否能水落石出，谁也无法保证——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative020"]}},
