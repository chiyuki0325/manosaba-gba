    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "——大家至今一直没有得出明确的结论，时间徒然流逝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 13, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Warden001"]}},
    {"op": "HideAllCharacters", "line": 15, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 17, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Lifeless04,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "（又得决定去处刑谁了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Ema001"]}},
    {"op": "HideAllCharacters", "line": 20, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "下一个被投票选中的，会不会就是自己——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative002"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "萦绕在少女身边的恐惧和紧张的气氛<br>\n愈发浓重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative003"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "每个人都面色铁青，颤抖不已。<br>\n也许，她们想起了凄惨的处刑场面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative004"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "然而，投票时间无情地降临了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative005"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "少女们各自按着自己的手机，<br>\n进行投票。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "然后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 35, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "随着庆祝的号角声响起，<br>\n手机屏幕上出现的——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 42, "indent": 0, "params": {"SfxPath": "Sfx_35", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 45, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "是奈叶香的照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "好了，决定执行对黑部奈叶香的刑罚～！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Warden002"]}},
    {"op": "PlayBgm", "line": 52, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.ArmR5,ArmL4,Eyes1_Tearful_Open1,Mouth1_Angry_Closed2,Sweat1_1,Pale1-1"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "你们的结论错了……！<br>\n我根本没杀她……！", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.4"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "就算错了那也是投票得出的结果，<br>\n请你放弃……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Warden003"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.ArmR6,ArmL3,Mouth1_Normal_Open1,Sweat1_1,Pale1-1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "这太胡闹了……！<br>\n我可不想老老实实地被处刑！", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Nanoka002"]}},
    {"op": "HideAllCharacters", "line": 64, "indent": 0, "params": {"Lazy": 0}},
