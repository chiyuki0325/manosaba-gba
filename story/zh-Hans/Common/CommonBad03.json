    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "魔女审判之后。<br>\n艾玛一个人在牢房里静静沉思。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative011"]}},
