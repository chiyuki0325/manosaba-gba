    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "奈叶香尝试反抗，<br>\n但最终还是被看守制服，<br>\n接受了处刑——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad03_Narrative010"]}},
    {"op": "StopBgm", "line": 72, "indent": 0, "params": {}},
