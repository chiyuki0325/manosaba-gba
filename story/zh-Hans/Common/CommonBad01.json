{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Common/CommonBad01",
  "events": [
    {"op": "Gosub", "line": 1, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-ex1", "line": 3, "indent": 0},
    {"op": "PlayBgm", "line": 5, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 7, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "——艾玛仍然无法找出凶手，<br>\n时间徒然流逝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 12, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 13, "indent": 0, "params": {"Text": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden001"]}},
    {"op": "HideAllCharacters", "line": 15, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "（明明还没找出凶手，却要投票……<br>\n　可是，我们也只能照做了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema001"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "如果没有找出凶手，就要全员处死。<br>\n即使，那个人并不是真正的凶手——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "也需要推选出这么一位人物，以【魔女】的身份接受处刑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（可是，这实在是太难受了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema002"]}},
    {"op": "HideAllCharacters", "line": 26, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "不只是艾玛，<br>\n在场的所有人都脸色苍白地颤抖着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative004"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "然而，投票时间无情地降临了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "少女们各自按着自己的手机，<br>\n进行投票。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative006"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "然后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 38, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "随着一声与现场气氛格格不入的滑稽庆祝音效响起，<br>\n手机上出现的——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 45, "indent": 0, "params": {"SfxPath": "Sfx_35", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "是艾玛的照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative009"]}},
    {"op": "StopBgm", "line": 50, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 52, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR13,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless01,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "——欸？等、等一下……！<br>\n是不是搞错了什么……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema003"]}},
    {"op": "HideAllCharacters", "line": 58, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "呃，没搞错啊。<br>\n那么……<br>\n就决定对得票最多的樱羽艾玛实施刑罚咯！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden002"]}},
    {"op": "HideAllCharacters", "line": 62, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless01,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "为、为什么！？<br>\n我说，为什么是我！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema004"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "艾玛向梅露露投去无助的眼神。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 68, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "而梅露露也露出一副难以置信的表情，<br>\n哑口无言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative011"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL3,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "我说……为什么要投票选我！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema005"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "艾玛向其他少女抛去疑问，<br>\n但没有任何人作出回答。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative012"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "有人尴尬地低下了头，<br>\n有人用怜悯的眼神望着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative013"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "而真凶或许就在心中<br>\n悄悄窃笑着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative014"]}},
    {"op": "HideAllCharacters", "line": 82, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.7"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "理由不是怎样都好？<br>\n比如就是感觉很可疑……<br>\n又或者只是单纯的遭人讨厌……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden003"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR12,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "这、这也太乱来了！<br>\n我根本没有杀人！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema006"]}},
    {"op": "HideAllCharacters", "line": 90, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.7"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "哎，这已经是最终决定了。<br>\n虽然很遗憾，但只能请你接受这个结果了。<br>\n我想早点闭庭……能让我继续下一个环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden004"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "尽管艾玛声泪俱下地哭诉自己的无辜，<br>\n但典狱长却不为所动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 96, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR1,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "这太奇怪了！<br>\n大家也帮忙说句话啊！我说！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema007"]}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.9"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "啊，以防万一事先声明……<br>\n如果有人妨碍或者介入，<br>\n看守将对其同样定罪。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden005"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "大家只要按下手机上的处刑按钮，<br>\n就会开始执行处刑了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden006"]}},
    {"op": "HideAllCharacters", "line": 106, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "典狱长就像是念稿子一样<br>\n平淡地作出宣告。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative016"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "脸色煞白的少女们<br>\n各自按下了按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative017"]}},
    {"op": "PlaySfxModified", "line": 114, "indent": 0, "params": {"SfxPath": "Sfx_86", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "好了！那么，<br>\n现在开始执行对魔女的刑罚～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden007"]}},
    {"op": "HideAllCharacters", "line": 121, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 125, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "随着典狱长一声令下，<br>\n机关开始启动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative018"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "接着，从某处传来了齿轮的转动声，<br>\n中央的底座颤动了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative019"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "地板开了一个洞，底座缓缓地往下降。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative020"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "然后，原本的底座消失不见，<br>\n一个新的底座出现了——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 136, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless01,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "噫……断、断头台……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema008"]}},
    {"op": "HideAllCharacters", "line": 140, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "这是切断骨头，斩落头颅的<br>\n行刑设备——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative022"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "锋利的刀刃发出寒光，<br>\n似乎在等待下一位囚犯的头颅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative023"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "艾玛脸色煞白，全身颤抖起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative024"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "典狱长下达指示后，看守开始行动，<br>\n按住了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative025"]}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "不、不要！不要啊啊！<br>\n救命！放开我！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema009"]}},
    {"op": "HideAllCharacters", "line": 152, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "看守将挣扎着手脚的艾玛<br>\n拖上了舞台。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR11,ArmL15,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "等、等一下！我真的，没有杀人！<br>\n这根本就不对！求你们住手！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema010"]}},
    {"op": "HideAllCharacters", "line": 159, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 160, "indent": 0, "params": {}},
    {"op": "Wait", "line": 161, "indent": 0, "params": {"WaitMode": "1.0"}},
    {"op": "ModifyBackgroundExtended", "line": 163, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "520_1"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "看守按住无力抵抗着的艾玛的头部，<br>\n将其固定在断头台上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative027"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "因恐惧颤抖的艾玛，露出了绝望的神情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative028"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "看守站在固定着砍刀的绳子旁，<br>\n缓缓举起了镰刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative029"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "死刑近在眼前。<br>\n艾玛陷入惊慌，呼吸十分慌乱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative030"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "【笨蛋】、【恶心】、【去死】——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative031"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "点缀在断头台上的无情涂鸦，<br>\n在艾玛看来就像是对她的指责。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative032"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "不要……不要……救命……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Ema011"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "像呻吟般不断重复的艾玛的话语，<br>\n回响在审判庭之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative033"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "现在动手吧。<br>\n“唰”地一下就搞定～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Warden008"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "典狱长对此情此景毫不在意，<br>\n直接向看守下达了指示。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative034"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "看守对准绳子砍下了镰刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative035"]}},
    {"op": "PlaySfxModified", "line": 190, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideActors", "line": 194, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 198, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "StopBgm", "line": 201, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 204, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "飞速落下的砍刀，<br>\n将艾玛的头颅切下——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative036"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "而脸上最后定格的表情，因绝望变得扭曲。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative037"]}},
    {"op": "ModifyBackgroundExtended", "line": 212, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "艾玛以魔女的身份被处死了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative038"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "但这并没有解决任何问题。<br>\n到头来，真凶的身份仍然不明。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative039"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "凶杀案肯定会再次发生。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative040"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "而魔女审判也将再次开展——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad01_Narrative041"]}},
