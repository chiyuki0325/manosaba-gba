  "path": "Common/CommonBad08",
  "events": [
    {"op": "Gosub", "line": 1, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-ex2", "line": 3, "indent": 0},
    {"op": "PlayBgm", "line": 5, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 7, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyCharacterExtended", "line": 10, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 11, "indent": 0, "params": {"Text": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Warden001"]}},
    {"op": "HideAllCharacters", "line": 12, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "大家仍未讨论出一个结论，<br>\n典狱长便宣布讨论结束。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative001"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "被众人投票选为【魔女】的是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative002"]}},
    {"op": "PlaySfxModified", "line": 20, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "好的，谢谢各位。<br>\n决定处刑佐伯米莉亚了～！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Warden002"]}},
    {"op": "HideAllCharacters", "line": 25, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 26, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 29, "indent": 0, "params": {"BgmPath": "Bgm_29_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Fearful1,ArmR10,ArmL4,Angle01/Facial/Mouth>Mouth_Surprised_Open01"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "怎么会，等等啊……<br>\n为什么是大叔我！？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Fearful1,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Closed,Angle01/Facial/Mouth>Mouth_Surprised_Open02"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "不管怎么想，<br>\n小希才是最可疑的吧！？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria002"]}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "米莉亚一副难以置信的样子，<br>\n指着我，高声说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.,Arms3,Eyes1_Normal_Open4,Mouth1_Pensive_Closed1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "……真难看。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Fearful1,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Surprised_Lifeless01,Angle01/Facial/Mouth>Mouth_Angry_Closed02"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "！！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria003"]}},
    {"op": "HideAllCharacters", "line": 46, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "事到如今再怎么吵闹，结果也不会改变。<br>\n米莉亚到底是不是凶手？<br>\n已经不是思考这个问题的时候了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Default,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Cry_Open01,Angle01/Facial/Mouth>Mouth_Fearful_Closed"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "这不对……<br>\n这一定有问题，绝对……！！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria004"]}},
    {"op": "HideAllCharacters", "line": 52, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "米莉亚畏惧地叫喊着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative005"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "包括我在内，<br>\n在场的所有少女都感受着和她一样的心情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative006"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "但我们不得不作出选择。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative007"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "不这么做，<br>\n所有人都会死。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.2"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "大家只要按下手机上的处刑按钮，<br>\n就会开始执行处刑了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Warden003"]}},
    {"op": "HideAllCharacters", "line": 64, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "在典狱长的催促下，<br>\n我们只得接连按下按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative009"]}},
    {"op": "PlaySfxModified", "line": 70, "indent": 0, "params": {"SfxPath": "Sfx_86", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "好了！那么，<br>\n现在开始执行对魔女的刑罚～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Warden004"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 79, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "随着典狱长一声令下，<br>\n某处的机关启动了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative010"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "接着，从某处传来了齿轮的转动声，<br>\n中央的底座颤动了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative011"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "地板开了一个洞，底座缓缓地往下降。<br>\n然后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative012"]}},
    {"op": "ModifyBackgroundExtended", "line": 89, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PlaySfxModified", "line": 94, "indent": 0, "params": {"SfxPath": "Sfx_169", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "审判庭突然陷入一片黑暗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative013"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "住手！别碰我！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria005"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "听见了米莉亚的惨叫，和不祥的响动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative014"]}},
    {"op": "PlaySfxModified", "line": 107, "indent": 0, "params": {"SfxPath": "Sfx_90", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "呜哇啊啊啊啊啊！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria006"]}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "灯光亮起，映入我眼帘的是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative015"]}},
    {"op": "ResetText", "line": 116, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 118, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "540_1"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "被拘束在十字架上的米莉亚的身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative016"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "已经有数根长枪刺穿了她的身体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative017"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "看守摆出姿势，准备再次投掷长枪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative018"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "住手……住手……<br>\n我不想、死……求求你们……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria007"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "剧痛、以及步步逼近的死亡所带来的恐惧——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative019"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "一定是无法估量的痛苦。<br>\n米莉亚扭曲的脸庞说明了一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative020"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "大叔我……不是凶手……<br>\n什么都没做……却……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria008"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "米莉亚用尽全力般挤出的低语<br>\n回响在虚空中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative021"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "这样……太过分了……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria009"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "这是她死前的最后一句话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative022"]}},
    {"op": "StopBgm", "line": 141, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 143, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "PlaySfxModified", "line": 148, "indent": 0, "params": {"SfxPath": "Sfx_89", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 152, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "看守投掷出的长枪，刺穿了米莉亚的胸膛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative023"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "咳、哈……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Miria010"]}},
    {"op": "HideAllCharacters", "line": 159, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "从米莉亚身上流出的鲜血，全都化作蝴蝶翩翩飞去。<br>\n仿佛在为她的死，增添一抹华丽的色彩……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative024"]}},
    {"op": "Wait", "line": 163, "indent": 0, "params": {"WaitMode": "1.0"}},
    {"op": "ModifyBackgroundExtended", "line": 166, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFFFF", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "PlayBgm", "line": 169, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "魔女审判之后。<br>\n我独自一人，待在中庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative025"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "由于米莉亚被选为魔女并处决，<br>\n我逃过了一劫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative026"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "但是，总觉得无法释怀。<br>\n这样真的好吗？<br>\n如果真凶另有其人……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative027"]}},
    {"op": "PlaySfxModified", "line": 180, "indent": 0, "params": {"SfxPath": "Sfx_73", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "忽然，我感到背后有人靠近。<br>\n接着，背上传来一阵灼烧般的剧痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative028"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "我倒在了地上，仰望着天空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative029"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "那就是【这次】记忆的最后一幕——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative030"]}},
    {"op": "ModifyBackgroundExtended", "line": 190, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "我被某人杀害了，然后发动了死亡回溯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative031"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "果然米莉亚并不是凶手吗？<br>\n那么，这次我一定要查明真凶——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad08_Narrative032"]}},
    {"op": "Gosub", "line": 203, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "ClearBacklog", "line": 205, "indent": 0, "params": {}},
    {"op": "ReturnToTitle", "line": 206, "indent": 0, "params": {"FadeDuration": 1.2000000476837158, "MinDelayDuration": 0.6000000238418579, "Wait": 1}}
  ],
  "translations": {
  "CommonBad08_Warden001": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？",
  "CommonBad08_Narrative001": "大家仍未讨论出一个结论，<br>\n典狱长便宣布讨论结束。",
  "CommonBad08_Narrative002": "被众人投票选为【魔女】的是——",
  "CommonBad08_Warden002": "好的，谢谢各位。<br>\n决定处刑佐伯米莉亚了～！",
  "CommonBad08_Miria001": "怎么会，等等啊……<br>\n为什么是大叔我！？",
  "CommonBad08_Miria002": "不管怎么想，<br>\n小希才是最可疑的吧！？",
  "CommonBad08_Narrative003": "米莉亚一副难以置信的样子，<br>\n指着我，高声说道。",
  "CommonBad08_Hiro001": "……真难看。",
  "CommonBad08_Miria003": "！！",
  "CommonBad08_Narrative004": "事到如今再怎么吵闹，结果也不会改变。<br>\n米莉亚到底是不是凶手？<br>\n已经不是思考这个问题的时候了。",
  "CommonBad08_Miria004": "这不对……<br>\n这一定有问题，绝对……！！",
  "CommonBad08_Narrative005": "米莉亚畏惧地叫喊着。",
  "CommonBad08_Narrative006": "包括我在内，<br>\n在场的所有少女都感受着和她一样的心情。",
  "CommonBad08_Narrative007": "但我们不得不作出选择。",
  "CommonBad08_Narrative008": "不这么做，<br>\n所有人都会死。",
  "CommonBad08_Warden003": "大家只要按下手机上的处刑按钮，<br>\n就会开始执行处刑了。",
  "CommonBad08_Narrative009": "在典狱长的催促下，<br>\n我们只得接连按下按钮。",
  "CommonBad08_Warden004": "好了！那么，<br>\n现在开始执行对魔女的刑罚～",
  "CommonBad08_Narrative010": "随着典狱长一声令下，<br>\n某处的机关启动了。",
  "CommonBad08_Narrative011": "接着，从某处传来了齿轮的转动声，<br>\n中央的底座颤动了一下。",
  "CommonBad08_Narrative012": "地板开了一个洞，底座缓缓地往下降。<br>\n然后——",
  "CommonBad08_Narrative013": "审判庭突然陷入一片黑暗。",
  "CommonBad08_Miria005": "住手！别碰我！",
  "CommonBad08_Narrative014": "听见了米莉亚的惨叫，和不祥的响动。",
  "CommonBad08_Miria006": "呜哇啊啊啊啊啊！",
  "CommonBad08_Narrative015": "灯光亮起，映入我眼帘的是——",
  "CommonBad08_Narrative016": "被拘束在十字架上的米莉亚的身影。",
  "CommonBad08_Narrative017": "已经有数根长枪刺穿了她的身体。",
  "CommonBad08_Narrative018": "看守摆出姿势，准备再次投掷长枪。",
  "CommonBad08_Miria007": "住手……住手……<br>\n我不想、死……求求你们……",
  "CommonBad08_Narrative019": "剧痛、以及步步逼近的死亡所带来的恐惧——",
  "CommonBad08_Narrative020": "一定是无法估量的痛苦。<br>\n米莉亚扭曲的脸庞说明了一切。",
  "CommonBad08_Miria008": "大叔我……不是凶手……<br>\n什么都没做……却……",
  "CommonBad08_Narrative021": "米莉亚用尽全力般挤出的低语<br>\n回响在虚空中。",
  "CommonBad08_Miria009": "这样……太过分了……",
  "CommonBad08_Narrative022": "这是她死前的最后一句话。",
  "CommonBad08_Narrative023": "看守投掷出的长枪，刺穿了米莉亚的胸膛。",
  "CommonBad08_Miria010": "咳、哈……",
  "CommonBad08_Narrative024": "从米莉亚身上流出的鲜血，全都化作蝴蝶翩翩飞去。<br>\n仿佛在为她的死，增添一抹华丽的色彩……",
  "CommonBad08_Narrative025": "魔女审判之后。<br>\n我独自一人，待在中庭。",
  "CommonBad08_Narrative026": "由于米莉亚被选为魔女并处决，<br>\n我逃过了一劫。",
  "CommonBad08_Narrative027": "但是，总觉得无法释怀。<br>\n这样真的好吗？<br>\n如果真凶另有其人……",
  "CommonBad08_Narrative028": "忽然，我感到背后有人靠近。<br>\n接着，背上传来一阵灼烧般的剧痛。",
  "CommonBad08_Narrative029": "我倒在了地上，仰望着天空。",
  "CommonBad08_Narrative030": "那就是【这次】记忆的最后一幕——",
  "CommonBad08_Narrative031": "我被某人杀害了，然后发动了死亡回溯。",
  "CommonBad08_Narrative032": "果然米莉亚并不是凶手吗？<br>\n那么，这次我一定要查明真凶——"
}
}
