    {"op": "ModifyBackgroundExtended", "line": 88, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "魔女审判结束后，<br>\n艾玛独自站在诺亚的杀害现场前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "（汉娜她真的是凶手吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "（……我还是没法接受。<br>\n　我感觉凶手另有其人）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "（虽然已经来不及了……但是我，<br>\n　这次一定要证明汉娜的清白……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Ema003"]}},
    {"op": "StopBgm", "line": 102, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 105, "indent": 0, "params": {"SfxPath": "Sfx_27", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 108, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 115, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "忽然艾玛感受到了来自身后的冲击，<br>\n直接以卧姿倒在了地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "（哎、哎呀……？怎、么回事……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Ema004"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "卧倒在地上的艾玛，<br>\n背上深深地插着一把刀具。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "艾玛总算反应过来她遇上了什么事。她强忍着痛苦，<br>\n拼尽力气往身后看去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative015"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "只见在她眼前站着的是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative016"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Ema005"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "（为什么她会……<br>\n　难道杀死诺亚的也是她……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Ema006"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "未等艾玛开口询问，<br>\n【她】再次向艾玛挥下了凶器——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative017"]}},
    {"op": "PlaySfxModified", "line": 136, "indent": 0, "params": {"SfxPath": "Sfx_87", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
