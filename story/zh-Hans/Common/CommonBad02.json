    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "——大家至今一直没有得出明确的结论，时间徒然流逝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 13, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.3"}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "讨论到此为止，<br>\n可以请各位进入投票环节了吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Warden001"]}},
    {"op": "HideAllCharacters", "line": 16, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "下一个被投票选中的，会不会就是自己——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "萦绕在少女身边的恐惧和紧张的气氛<br>\n愈发浓重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default,ArmR4,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 24, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "被蕾雅指名道姓怀疑的汉娜，<br>\n正脸色苍白的咬着手指甲。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative004"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "不只是汉娜，<br>\n在场的所有人都脸色苍白地颤抖着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "然而，投票时间无情地降临了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "少女们各自按着自己的手机，<br>\n进行投票。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "然后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 37, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "随着一声与现场气氛格格不入的滑稽庆祝音效响起，<br>\n手机上出现的——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative009"]}},
    {"op": "PlaySfxModified", "line": 44, "indent": 0, "params": {"SfxPath": "Sfx_35", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 47, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "是汉娜的照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.8"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "好了，决定执行对远野汉娜的刑罚～！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Warden002"]}},
    {"op": "PlayBgm", "line": 55, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Default,ArmR4,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "别、别开玩笑了！<br>\n明明还有比我更可疑的人吧……！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Warden.4"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "唉，毕竟这事已经通过投票决定了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Warden003"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Default,ArmR4,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Pale01>Pale01_01"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "不对！人不是我杀的！<br>\n我是无辜的！！我要求重新审判！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 67, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "汉娜的诉求不被采纳，<br>\n她的死刑得到了执行——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["CommonBad02_Narrative011"]}},
