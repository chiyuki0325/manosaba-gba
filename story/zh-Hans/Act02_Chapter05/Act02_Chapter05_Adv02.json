    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 14, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro001"]}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "370_1"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 22, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "370_2"}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyBackgroundExtended", "line": 24, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "370_1"}},
    {"op": "Wait", "line": 25, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 26, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "370_2"}},
    {"op": "Wait", "line": 27, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我眨了眨眼，<br>\n眼前是冰冷的石制天花板。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative001"]}},
    {"op": "PlaySfxModified", "line": 33, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "咦，怎、怎么回事，这里是……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "牢、牢房……！？为什么！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema002"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "我说，这里究竟是什么地方！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema003"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "这是我们被囚禁在这座监牢的第一天。<br>\n听到下铺传来【还活着的】艾玛的声音，我真切感受到这一点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative002"]}},
    {"op": "ModifyBackgroundExtended", "line": 43, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "370_1"}},
    {"op": "Wait", "line": 44, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "（……回溯了。我成功回溯了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro002"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "我以自身的意志施展了【死亡回溯】魔法，<br>\n跨越无比漫长的时间，<br>\n终于抵达了这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative003"]}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ResetText", "line": 51, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 52, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 53, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 54, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 56, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "HideActors", "line": 57, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 58, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 59, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "艾玛——呃唔、呜呜呜呜……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro003"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "我呼唤着她的名字——那是我最想再会的人，<br>\n立刻打算从床上一跃而下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative004"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "然而，紧随而来的是遍袭全身的剧痛，<br>\n令我甚至无法站起身，忍不住发出呻吟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "呃、呜呜、啊、啊啊啊……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro004"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "欸，怎、怎么回事……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "听到我痛苦挣扎的声音，<br>\n艾玛回头看向床铺。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "似乎是发现我也在牢房里了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "希罗！？<br>\n怎、怎么你也在这！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema005"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "头痛欲裂。<br>\n身体像是被千刀万剐，<br>\n心脏疼痛得仿佛即将破碎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative008"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "（啊、啊啊，原来如此……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro005"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "这是第三轮死亡回溯。<br>\n我跨越漫长的时间，终于来到这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "大概我的身体<br>\n已经被重置回最初的状态了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "但是，在这次死亡回溯之前，<br>\n我的魔女化程度已经太深，到了无可挽回的地步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "那种腐蚀，已经深深刻在我的深层本质当中。<br>\n即使身体曾一度复原……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative012"]}},
    {"op": "ResetText", "line": 102, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 103, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 104, "indent": 0, "params": {"TintColor": "#550000AA", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 105, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyBackgroundExtended", "line": 106, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 107, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 108, "indent": 0, "params": {"TintColor": "#550000AA", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 109, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyBackgroundExtended", "line": 110, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 111, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "啊啊、呃、啊……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro006"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "魔女化的进程也无法逆转。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "脸上的皮肤寸寸龟裂。<br>\n指甲像锋利的树枝一样伸长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "身体急速变化，<br>\n那猛烈的疼痛折磨着我，只能徒劳地呻吟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative015"]}},
    {"op": "PlaySfxModified", "line": 122, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnShake", "line": 124, "indent": 0, "params": {"ActorId": "Camera"}},
    {"op": "Wait", "line": 125, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "我就维持着那个状态，<br>\n从床上滚落下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative016"]}},
    {"op": "HideAllCharacters", "line": 129, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "希罗！你还好吗，希罗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema006"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "——别过来！<br>\n别靠近我！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro007"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "看到艾玛向我奔来的身影，<br>\n我声嘶力竭地叫喊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "艾玛惊恐地一震，顿住了脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative018"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "（我还能、还能勉强维持理智……<br>\n　还能控制自己的身体）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro008"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "我大口喘着粗气，<br>\n摇摇晃晃地站起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative019"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "这时艾玛惊讶地倒抽了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "CreatureHiro.22"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "希……你是……希罗，对吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema007"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "（艾玛……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro009"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "我的喉咙发不出任何言语。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative021"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "身体似乎渐渐适应了这种状态，<br>\n剧痛略微减轻，意识也尚算清醒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative022"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "但我却不知道该对她说什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative023"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "炽热的情绪即将冲破心口，<br>\n仿佛下一秒就要放声哭喊出来。可是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative024"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "（我已经是个怪物了。恐怕，再也回不去了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro010"]}},
    {"op": "HideAllCharacters", "line": 171, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "我把视线移开，<br>\n仿佛要把艾玛的存在从心里抹去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative025"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "或许是因为死亡回溯换得的短暂宽限，<br>\n又或许是因为我强行压制了内心的心理创伤，勉强还维持着理智。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative026"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "（……真是讽刺。<br>\n　小雪，似乎是因为与你的那番对话，才让我的魔女化进程<br>\n　在最后关头勉强减缓了吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro011"]}},
    {"op": "QuickSave", "line": 179, "indent": 0, "params": {"SlotNumber": 25, "Wait": 0}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "（趁着还清醒，<br>\n　我还有必须完成的事）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro012"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "（我正是为此，才回到了这里）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro013"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "视线凛然向前。<br>\n囚禁着我们的铁栅栏就在眼前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative027"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "我决定——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative028"]}},
    {"op": "AddChoice", "line": 189, "indent": 0, "params": {"ChoiceSummary": "举行魔女安息仪式", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0205Adv02_Choice001"]}},
    {"op": "GotoModified", "line": 190, "indent": 1, "params": {"Path": ".Choice2-5-1"}},
    {"op": "AddChoice", "line": 192, "indent": 0, "params": {"ChoiceSummary": "不举行魔女安息仪式", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0205Adv02_Choice002"]}},
    {"op": "GotoModified", "line": 193, "indent": 1, "params": {"Path": "Act02_Chapter05/Act02_Chapter05_Bad01", "ResetState": ["-"]}},
    {"op": "StopForChoice", "line": 195, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice2-5-1", "line": 197, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 199, "indent": 0, "params": {"Number": 25}},
    {"op": "ResetText", "line": 201, "indent": 0, "params": {}},
    {"op": "Wait", "line": 202, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "——没错。<br>\n我早已下定决心，要启动魔女安息仪式。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative029"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "根据少女们留在【魔女之书】里的线索，<br>\n召唤大魔女必须集齐<br>\n【13名魔女】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative030"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "也就是说……包括我在内，<br>\n所有人都必须彻底魔女化才行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative031"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "这意味着，必须将艾玛她们的心理创伤强行揭开，<br>\n逼迫她们堕为魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative032"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "这就是梅露露犯下的暴行……<br>\n不，比那更加残酷。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative033"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "即使如此，我的心意已决。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative034"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "（不管这有多磨残酷，就算被她们厌恶、憎恨……<br>\n　哪怕此举希望渺茫……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro014"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "（我也要拯救你们）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro015"]}},
    {"op": "ModifyBackgroundExtended", "line": 220, "indent": 0, "params": {"Scale": [1.5], "Duration": 0.4000000059604645, "Lazy": 0, "ScenePosition": [60.0], "AppearanceAndTransition": "1_1"}},
    {"op": "Wait", "line": 221, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PlaySfxModified", "line": 224, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 226, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "听到牢门打开的声音，<br>\n我尽力不去回头看艾玛，转身踏上前路。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative035"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "啊，等、等等我，希罗！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Ema008"]}},
    {"op": "ResetText", "line": 234, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 235, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 236, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "HideAllCharacters", "line": 238, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 241, "indent": 0, "params": {"SfxPath": "Sfx_119", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 243, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 244, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 245, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "我的目标只有一个——【魔女安息仪式】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative036"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "我让自己别去想除此以外的其他任何事，<br>\n疾步前行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative037"]}},
    {"op": "ModifyCharacterExtended", "line": 251, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "呀啊啊啊啊！！<br>\n怎么还有一只怪物啊啊啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Coco001"]}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "被囚禁在监牢里的少女们已经聚集在过道上，<br>\n看到我的模样，人人神色凝重，面露惊恐。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative038"]}},
    {"op": "HideAllCharacters", "line": 257, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "但我却感到由衷的喜悦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative039"]}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "（大家都还活着）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro016"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "她们的心中，已经<br>\n没有了和我一起度过的记忆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative040"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "对她们来说，<br>\n我仅仅只是怪物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative041"]}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "但这也没关系。<br>\n因为在抵达这里之前，<br>\n我心中早已藏好那段珍贵的回忆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative042"]}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "忽然想起了什么，<br>\n我把手伸进口袋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative043"]}},
    {"op": "SpawnExtended", "line": 274, "indent": 0, "params": {"Path": "Clue", "Params": ["10-1"]}},
    {"op": "UpdateWitchBook", "line": 275, "indent": 0, "params": {"Id": "10-1", "Category": "Clue", "Version": 3}},
    {"op": "DestroySpawnedExtended", "line": 276, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "明明曾经捏碎得粉碎的东西，<br>\n却毫发无伤地握在我的掌心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative044"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "瞬间，情绪如浪涛般汹涌，<br>\n险些令我把那支钢笔捏碎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative045"]}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "但我在最后关头强行按下这股冲动，<br>\n再次迈步向前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Narrative046"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "（给我等着吧，小雪。<br>\n　我现在就去见你——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro017"]}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "（为了审判你的罪行）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv02_Hiro018"]}},
    {"op": "PlaySfxModified", "line": 291, "indent": 0, "params": {"SfxPath": "Sfx_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 292, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "Gosub", "line": 294, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 296, "indent": 0, "params": {"Path": "Act02_Chapter05/Act02_Chapter05_Adv03", "SoftReset": 1}}
  ],
  "translations": {
  "0205Adv02_Hiro001": "——！",
  "0205Adv02_Narrative001": "我眨了眨眼，<br>\n眼前是冰冷的石制天花板。",
  "0205Adv02_Ema001": "咦，怎、怎么回事，这里是……？",
  "0205Adv02_Ema002": "牢、牢房……！？为什么！？",
  "0205Adv02_Ema003": "我说，这里究竟是什么地方！？",
  "0205Adv02_Narrative002": "这是我们被囚禁在这座监牢的第一天。<br>\n听到下铺传来【还活着的】艾玛的声音，我真切感受到这一点。",
  "0205Adv02_Hiro002": "（……回溯了。我成功回溯了）",
  "0205Adv02_Narrative003": "我以自身的意志施展了【死亡回溯】魔法，<br>\n跨越无比漫长的时间，<br>\n终于抵达了这里。",
  "0205Adv02_Hiro003": "艾玛——呃唔、呜呜呜呜……！",
  "0205Adv02_Narrative004": "我呼唤着她的名字——那是我最想再会的人，<br>\n立刻打算从床上一跃而下。",
  "0205Adv02_Narrative005": "然而，紧随而来的是遍袭全身的剧痛，<br>\n令我甚至无法站起身，忍不住发出呻吟。",
  "0205Adv02_Hiro004": "呃、呜呜、啊、啊啊啊……！",
  "0205Adv02_Ema004": "欸，怎、怎么回事……？",
  "0205Adv02_Narrative006": "听到我痛苦挣扎的声音，<br>\n艾玛回头看向床铺。",
  "0205Adv02_Narrative007": "似乎是发现我也在牢房里了。",
  "0205Adv02_Ema005": "希罗！？<br>\n怎、怎么你也在这！？",
  "0205Adv02_Narrative008": "头痛欲裂。<br>\n身体像是被千刀万剐，<br>\n心脏疼痛得仿佛即将破碎。",
  "0205Adv02_Hiro005": "（啊、啊啊，原来如此……）",
  "0205Adv02_Narrative009": "这是第三轮死亡回溯。<br>\n我跨越漫长的时间，终于来到这里。",
  "0205Adv02_Narrative010": "大概我的身体<br>\n已经被重置回最初的状态了。",
  "0205Adv02_Narrative011": "但是，在这次死亡回溯之前，<br>\n我的魔女化程度已经太深，到了无可挽回的地步。",
  "0205Adv02_Narrative012": "那种腐蚀，已经深深刻在我的深层本质当中。<br>\n即使身体曾一度复原……",
  "0205Adv02_Hiro006": "啊啊、呃、啊……！",
  "0205Adv02_Narrative013": "魔女化的进程也无法逆转。",
  "0205Adv02_Narrative014": "脸上的皮肤寸寸龟裂。<br>\n指甲像锋利的树枝一样伸长。",
  "0205Adv02_Narrative015": "身体急速变化，<br>\n那猛烈的疼痛折磨着我，只能徒劳地呻吟。",
  "0205Adv02_Narrative016": "我就维持着那个状态，<br>\n从床上滚落下来。",
  "0205Adv02_Ema006": "希罗！你还好吗，希罗！？",
  "0205Adv02_Hiro007": "——别过来！<br>\n别靠近我！！",
  "0205Adv02_Narrative017": "看到艾玛向我奔来的身影，<br>\n我声嘶力竭地叫喊。",
  "0205Adv02_Narrative018": "艾玛惊恐地一震，顿住了脚步。",
  "0205Adv02_Hiro008": "（我还能、还能勉强维持理智……<br>\n　还能控制自己的身体）",
  "0205Adv02_Narrative019": "我大口喘着粗气，<br>\n摇摇晃晃地站起来。",
  "0205Adv02_Narrative020": "这时艾玛惊讶地倒抽了一口气。",
  "0205Adv02_Ema007": "希……你是……希罗，对吗……？",
  "0205Adv02_Hiro009": "（艾玛……）",
  "0205Adv02_Narrative021": "我的喉咙发不出任何言语。",
  "0205Adv02_Narrative022": "身体似乎渐渐适应了这种状态，<br>\n剧痛略微减轻，意识也尚算清醒。",
  "0205Adv02_Narrative023": "但我却不知道该对她说什么。",
  "0205Adv02_Narrative024": "炽热的情绪即将冲破心口，<br>\n仿佛下一秒就要放声哭喊出来。可是——",
  "0205Adv02_Hiro010": "（我已经是个怪物了。恐怕，再也回不去了）",
  "0205Adv02_Narrative025": "我把视线移开，<br>\n仿佛要把艾玛的存在从心里抹去。",
  "0205Adv02_Narrative026": "或许是因为死亡回溯换得的短暂宽限，<br>\n又或许是因为我强行压制了内心的心理创伤，勉强还维持着理智。",
  "0205Adv02_Hiro011": "（……真是讽刺。<br>\n　小雪，似乎是因为与你的那番对话，才让我的魔女化进程<br>\n　在最后关头勉强减缓了吧）",
  "0205Adv02_Hiro012": "（趁着还清醒，<br>\n　我还有必须完成的事）",
  "0205Adv02_Hiro013": "（我正是为此，才回到了这里）",
  "0205Adv02_Narrative027": "视线凛然向前。<br>\n囚禁着我们的铁栅栏就在眼前。",
  "0205Adv02_Narrative028": "我决定——",
  "0205Adv02_Choice001": "举行魔女安息仪式",
  "0205Adv02_Choice002": "不举行魔女安息仪式",
  "0205Adv02_Narrative029": "——没错。<br>\n我早已下定决心，要启动魔女安息仪式。",
  "0205Adv02_Narrative030": "根据少女们留在【魔女之书】里的线索，<br>\n召唤大魔女必须集齐<br>\n【13名魔女】。",
  "0205Adv02_Narrative031": "也就是说……包括我在内，<br>\n所有人都必须彻底魔女化才行。",
  "0205Adv02_Narrative032": "这意味着，必须将艾玛她们的心理创伤强行揭开，<br>\n逼迫她们堕为魔女。",
  "0205Adv02_Narrative033": "这就是梅露露犯下的暴行……<br>\n不，比那更加残酷。",
  "0205Adv02_Narrative034": "即使如此，我的心意已决。",
  "0205Adv02_Hiro014": "（不管这有多磨残酷，就算被她们厌恶、憎恨……<br>\n　哪怕此举希望渺茫……）",
  "0205Adv02_Hiro015": "（我也要拯救你们）",
  "0205Adv02_Narrative035": "听到牢门打开的声音，<br>\n我尽力不去回头看艾玛，转身踏上前路。",
  "0205Adv02_Ema008": "啊，等、等等我，希罗！",
  "0205Adv02_Narrative036": "我的目标只有一个——【魔女安息仪式】。",
  "0205Adv02_Narrative037": "我让自己别去想除此以外的其他任何事，<br>\n疾步前行。",
  "0205Adv02_Coco001": "呀啊啊啊啊！！<br>\n怎么还有一只怪物啊啊啊！！",
  "0205Adv02_Narrative038": "被囚禁在监牢里的少女们已经聚集在过道上，<br>\n看到我的模样，人人神色凝重，面露惊恐。",
  "0205Adv02_Narrative039": "但我却感到由衷的喜悦。",
  "0205Adv02_Hiro016": "（大家都还活着）",
  "0205Adv02_Narrative040": "她们的心中，已经<br>\n没有了和我一起度过的记忆。",
  "0205Adv02_Narrative041": "对她们来说，<br>\n我仅仅只是怪物。",
  "0205Adv02_Narrative042": "但这也没关系。<br>\n因为在抵达这里之前，<br>\n我心中早已藏好那段珍贵的回忆。",
  "0205Adv02_Narrative043": "忽然想起了什么，<br>\n我把手伸进口袋。",
  "0205Adv02_Narrative044": "明明曾经捏碎得粉碎的东西，<br>\n却毫发无伤地握在我的掌心。",
  "0205Adv02_Narrative045": "瞬间，情绪如浪涛般汹涌，<br>\n险些令我把那支钢笔捏碎。",
  "0205Adv02_Narrative046": "但我在最后关头强行按下这股冲动，<br>\n再次迈步向前。",
  "0205Adv02_Hiro017": "（给我等着吧，小雪。<br>\n　我现在就去见你——）",
  "0205Adv02_Hiro018": "（为了审判你的罪行）"
}
}
