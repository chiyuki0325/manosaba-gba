    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR4,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 40, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 41, "indent": 0, "params": {"Text": "诺、诺亚什么都<br>\n没隐瞒哦……！<br>\n完全，什么都没……<br>\n一点都没有！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial06_Noah001"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.10"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 44, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 45, "indent": 0, "params": {"Text": "……首先，你的真实身份是<br>\n身份不明的<br>\n街头艺术家，<br>\n【气球】。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial06_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR6,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 50, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 51, "indent": 0, "params": {"Text": "呀啊！？", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial06_Noah002"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR8,ArmL7,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 54, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 55, "indent": 0, "params": {"Text": "真、真的假的！？<br>\n是那个……！？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial06_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 60, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 61, "indent": 0, "params": {"Text": "那、那是……<br>\n那个、那个……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial06_Noah003"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.11"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 64, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 65, "indent": 0, "params": {"Text": "……然后，<br>\n那些被世人称赞的画作，<br>\n是用魔法画出来的。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial06_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Fearful1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 68, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 69, "indent": 0, "params": {"Text": "呜呜——！？", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial06_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.18"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 72, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 73, "indent": 0, "params": {"Text": "这些画不能说是你画的……<br>\n我说得没错吧。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial06_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 76, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 77, "indent": 0, "params": {"Text": "这、这……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial06_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open02,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 80, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 81, "indent": 0, "params": {"Text": "不、不对哦！？<br>\n诺亚，<br>\n<link=\"Objection_02_05_06_01\">超喜欢画画</link>的！！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial06_Noah006"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open_1,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 86, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 87, "indent": 0, "params": {"Text": "希罗……<br>\n你为什么要说这么过分的话……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial06_Noah007"]}},
