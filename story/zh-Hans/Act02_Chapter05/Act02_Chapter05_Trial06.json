    {"op": "ModifyCharacterExtended", "line": 341, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01"}},
