    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "当然，不用在意画得好不好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro022"]}},
