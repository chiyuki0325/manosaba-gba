    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "欸……？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Noah008"]}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 171, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "我在另一个发展不同的世界亲眼见到过，所以我知道哦。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.9"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 175, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "诺亚……其实你，<br>\n并【不会画画】。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 181, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "欸……！？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Noah009"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.18"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 185, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "因为自己画不出来，所以才依赖魔法。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 189, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "才、才没有！<br>\n诺亚自己能画的！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Noah010"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 193, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "希罗在撒谎！<br>\n你想给诺亚设圈套！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Noah011"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default,ArmR2,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Cry_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 199, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "诺亚，才不会上当呢……！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Noah012"]}},
