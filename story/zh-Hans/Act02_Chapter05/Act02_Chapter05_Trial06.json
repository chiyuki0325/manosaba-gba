    {"op": "Wait", "line": 105, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（诺亚看似天然，其实相当会演戏）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro004"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "（但……那是在下定决心动手杀了人之后的事了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro005"]}},
