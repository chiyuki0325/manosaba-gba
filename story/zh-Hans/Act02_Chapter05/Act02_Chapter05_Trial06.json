    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "你最喜欢画画了。<br>\n应该能画出来吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro021"]}},
