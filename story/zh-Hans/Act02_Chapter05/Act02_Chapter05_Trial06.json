    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "（趁她现在并不冷静，<br>\n　我要撼动她的感情，击垮她的内心……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial06_Hiro006"]}},
