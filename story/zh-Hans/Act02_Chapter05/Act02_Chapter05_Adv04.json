  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-5-3", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "我们一行人鱼贯而行，<br>\n朝着审判庭前进。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative001"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "梅露露因为被我派去办事了，所以她不在。<br>\n现在知道怎么去审判庭的，只有我一个了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative002"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "我走在最前面，为少女们带路。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative003"]}},
    {"op": "PlayBgm", "line": 20, "indent": 0, "params": {"BgmPath": "Bgm_2_1_Loop", "IntroBgmPath": "Bgm_2_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "审判是怎么回事呀？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "接下来要发生什么啊……<br>\n喂，你这家伙！到了审判庭会解释清楚的吧！？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "审判这两个字，真让人心动呢～！<br>\n总觉得好像会发生什么有趣的事情，好兴奋呀！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "是、是吗……？<br>\n审判什么的，总觉得只有不好的预感……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Miria001"]}},
    {"op": "HideAllCharacters", "line": 39, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "不知会是谁被审判呢？<br>\n啊啊～想想就觉得一阵颤栗呢♡", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Margo001"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "跟在后面的少女们，<br>\n气氛莫名地有些轻松。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative004"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "这也难怪。<br>\n悲剧尚未降临，<br>\n她们还对一切都一无所知。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative005"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "唯独艾玛紧跟在我身边，<br>\n忧心忡忡地看着喘着粗气的我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "希罗，那个，不要勉强自己……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Ema001"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "我知道你在生我的气，但是，<br>\n我也想帮上希罗的忙……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Ema002"]}},
    {"op": "HideAllCharacters", "line": 58, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro001"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "（当一切都真相大白的时候……艾玛还能<br>\n　用和现在一样的眼神看我吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro002"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "（……现在已经顾不上自己了！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro003"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "（现在唯一要做的，就是让<br>\n　【魔女安息仪式】成功……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro004"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "完成魔女安息仪式需要<br>\n13名魔女的魔力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative007"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "只要将她们的魔力集中于仪礼剑上，<br>\n大魔女便会受肉降临。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative008"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "早在我们被囚禁在这座监牢之前，<br>\n梅露露应该就已经知道这件事了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative009"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "她刻意凑够13人，<br>\n或许也是为此。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative010"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "（但是【现在】的她们还不够）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro005"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "（必须让十三人全部<br>\n　都获得与魔女同等的魔力）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro006"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（换句话说……我必须让她们每个人<br>\n　都堕为魔女……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro007"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "把她们封锁在内心深处的阴影暴露在人前，<br>\n再强行撬开，蹂躏她们的灵魂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative011"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "我早已深知，这是一种极其残酷，<br>\n且几近不可能实现的行径。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative012"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "终于，我们抵达了审判庭前。<br>\n我停下脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "CreatureHiro.10"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "这里就是审判庭。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 92, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "那一对长年上锁、<br>\n紧闭着的巨大门扉，此刻却打开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative014"]}},
    {"op": "ResetText", "line": 96, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 97, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 98, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PlaySfxModified", "line": 101, "indent": 0, "params": {"SfxPath": "Sfx_165", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 103, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 104, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 105, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1,ArmL2"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "哇啊，好厉害！好宽敞！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Noah001"]}},
    {"op": "HideAllCharacters", "line": 111, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "好神圣的空间……<br>\n真是太美了……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "搞不清状况啦，<br>\n快点结束快点回家吧～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Coco001"]}},
    {"op": "HideAllCharacters", "line": 120, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "应该是<br>\n按照我们的囚犯编号就座吧……？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "吾辈已经累垮了……<br>\n好想睡……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_AnAn001"]}},
    {"op": "HideAllCharacters", "line": 129, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "我们走进审判庭，<br>\n顺从地站到了各自的证人席前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative015"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "就这样稍等片刻……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative016"]}},
    {"op": "PlaySfxModified", "line": 136, "indent": 0, "params": {"SfxPath": "Sfx_33", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "钟声在审判庭内隆隆回荡起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative017"]}},
    {"op": "PlaySfxModified", "line": 142, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 143, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "与此同时，不知从何处飞来一只猫头鹰，<br>\n停在了高处的栏杆上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "规矩如此，所以我连钟都敲了哦。<br>\n真是的……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Warden001"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "审判庭的门仍然敞开着。<br>\n稍晚，梅露露最后一个进来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative019"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "确认她到场后，<br>\n站在出入口大门前的看守随即关闭了大门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Normal1"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "那、那个，希罗小姐，我拿来了……<br>\n这个……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Meruru001"]}},
    {"op": "SpawnExtended", "line": 166, "indent": 0, "params": {"Path": "Clue", "Params": ["6-2"]}},
    {"op": "UpdateWitchBook", "line": 167, "indent": 0, "params": {"Id": "6-2", "Category": "Clue", "Version": 2}},
    {"op": "DestroySpawnedExtended", "line": 168, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "辛苦。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro009"]}},
    {"op": "HideAllCharacters", "line": 172, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Smile1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "我说我说，希罗亲你凭什么那么拽啊？<br>\n你是魔王还是什么啊？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Coco002"]}},
    {"op": "HideAllCharacters", "line": 178, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "无视可可的揶揄，<br>\n我深深吸了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative021"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "接着，我拿起仪礼剑，高高举向天空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative022"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "魔女审判现在开庭！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Hiro010"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "这将是我的最后一场魔女审判。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative023"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "我在心中暗暗立誓，<br>\n无论最终是怎样的结局，我都要维持正确。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "别抢我台词好吗……<br>\n算了算了，为了能准时下班，<br>\n赶紧搞完吧～！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv04_Warden002"]}},
    {"op": "Gosub", "line": 198, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 200, "indent": 0, "params": {"Path": "Act02_Chapter05/Act02_Chapter05_Trial00", "SoftReset": 1}}
  ],
  "translations": {
  "0205Adv04_Narrative001": "我们一行人鱼贯而行，<br>\n朝着审判庭前进。",
  "0205Adv04_Narrative002": "梅露露因为被我派去办事了，所以她不在。<br>\n现在知道怎么去审判庭的，只有我一个了。",
  "0205Adv04_Narrative003": "我走在最前面，为少女们带路。",
  "0205Adv04_Hanna001": "审判是怎么回事呀？",
  "0205Adv04_Alisa001": "接下来要发生什么啊……<br>\n喂，你这家伙！到了审判庭会解释清楚的吧！？",
  "0205Adv04_Sherry001": "审判这两个字，真让人心动呢～！<br>\n总觉得好像会发生什么有趣的事情，好兴奋呀！",
  "0205Adv04_Miria001": "是、是吗……？<br>\n审判什么的，总觉得只有不好的预感……",
  "0205Adv04_Margo001": "不知会是谁被审判呢？<br>\n啊啊～想想就觉得一阵颤栗呢♡",
  "0205Adv04_Narrative004": "跟在后面的少女们，<br>\n气氛莫名地有些轻松。",
  "0205Adv04_Narrative005": "这也难怪。<br>\n悲剧尚未降临，<br>\n她们还对一切都一无所知。",
  "0205Adv04_Narrative006": "唯独艾玛紧跟在我身边，<br>\n忧心忡忡地看着喘着粗气的我。",
  "0205Adv04_Ema001": "希罗，那个，不要勉强自己……",
  "0205Adv04_Ema002": "我知道你在生我的气，但是，<br>\n我也想帮上希罗的忙……",
  "0205Adv04_Hiro001": "…………",
  "0205Adv04_Hiro002": "（当一切都真相大白的时候……艾玛还能<br>\n　用和现在一样的眼神看我吗？）",
  "0205Adv04_Hiro003": "（……现在已经顾不上自己了！）",
  "0205Adv04_Hiro004": "（现在唯一要做的，就是让<br>\n　【魔女安息仪式】成功……！）",
  "0205Adv04_Narrative007": "完成魔女安息仪式需要<br>\n13名魔女的魔力。",
  "0205Adv04_Narrative008": "只要将她们的魔力集中于仪礼剑上，<br>\n大魔女便会受肉降临。",
  "0205Adv04_Narrative009": "早在我们被囚禁在这座监牢之前，<br>\n梅露露应该就已经知道这件事了。",
  "0205Adv04_Narrative010": "她刻意凑够13人，<br>\n或许也是为此。",
  "0205Adv04_Hiro005": "（但是【现在】的她们还不够）",
  "0205Adv04_Hiro006": "（必须让十三人全部<br>\n　都获得与魔女同等的魔力）",
  "0205Adv04_Hiro007": "（换句话说……我必须让她们每个人<br>\n　都堕为魔女……）",
  "0205Adv04_Narrative011": "把她们封锁在内心深处的阴影暴露在人前，<br>\n再强行撬开，蹂躏她们的灵魂。",
  "0205Adv04_Narrative012": "我早已深知，这是一种极其残酷，<br>\n且几近不可能实现的行径。",
  "0205Adv04_Narrative013": "终于，我们抵达了审判庭前。<br>\n我停下脚步。",
  "0205Adv04_Hiro008": "这里就是审判庭。",
  "0205Adv04_Narrative014": "那一对长年上锁、<br>\n紧闭着的巨大门扉，此刻却打开了。",
  "0205Adv04_Noah001": "哇啊，好厉害！好宽敞！",
  "0205Adv04_Margo002": "好神圣的空间……<br>\n真是太美了……",
  "0205Adv04_Coco001": "搞不清状况啦，<br>\n快点结束快点回家吧～",
  "0205Adv04_Leia001": "应该是<br>\n按照我们的囚犯编号就座吧……？",
  "0205Adv04_AnAn001": "吾辈已经累垮了……<br>\n好想睡……",
  "0205Adv04_Narrative015": "我们走进审判庭，<br>\n顺从地站到了各自的证人席前。",
  "0205Adv04_Narrative016": "就这样稍等片刻……",
  "0205Adv04_Narrative017": "钟声在审判庭内隆隆回荡起来。",
  "0205Adv04_Narrative018": "与此同时，不知从何处飞来一只猫头鹰，<br>\n停在了高处的栏杆上。",
  "0205Adv04_Warden001": "规矩如此，所以我连钟都敲了哦。<br>\n真是的……",
  "0205Adv04_Narrative019": "审判庭的门仍然敞开着。<br>\n稍晚，梅露露最后一个进来了。",
  "0205Adv04_Narrative020": "确认她到场后，<br>\n站在出入口大门前的看守随即关闭了大门。",
  "0205Adv04_Meruru001": "那、那个，希罗小姐，我拿来了……<br>\n这个……",
  "0205Adv04_Hiro009": "辛苦。",
  "0205Adv04_Coco002": "我说我说，希罗亲你凭什么那么拽啊？<br>\n你是魔王还是什么啊？",
  "0205Adv04_Narrative021": "无视可可的揶揄，<br>\n我深深吸了一口气。",
  "0205Adv04_Narrative022": "接着，我拿起仪礼剑，高高举向天空。",
  "0205Adv04_Hiro010": "魔女审判现在开庭！",
  "0205Adv04_Narrative023": "这将是我的最后一场魔女审判。",
  "0205Adv04_Narrative024": "我在心中暗暗立誓，<br>\n无论最终是怎样的结局，我都要维持正确。",
  "0205Adv04_Warden002": "别抢我台词好吗……<br>\n算了算了，为了能准时下班，<br>\n赶紧搞完吧～！"
}
}
