    {"op": "label", "name": "Judge10-24-3", "line": 218, "indent": 0},
    {"op": "Gosub", "line": 220, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 221, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "Gosub", "line": 222, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 225, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "你不必自责。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 229, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "你和我们相处得很融洽。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 233, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "……当然，<br>\n不能说完全没有异于常人的地方……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 237, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "但那也算是某种个性吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 240, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL14,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 241, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "你真温柔啊，希罗。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry015"]}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 245, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "但我并不这么认为。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry016"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 249, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "现在我还有很多不理解的事情，<br>\n也看不到正确的选项。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry017"]}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Flushed_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 253, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "希罗你和我所看到的世界，是不一样的哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry018"]}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.14"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 257, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "（……看来我这番话<br>\n　无法触达雪莉的内心）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 260, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 261, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "（要让她魔女化，<br>\n　首先必须准确理解她面临的问题才行）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro010"]}},
    {"op": "GotoModified", "line": 264, "indent": 0, "params": {"Path": ".Judge10-24-1"}},
    {"op": "label", "name": "Judge10-24-4", "line": 268, "indent": 0},
    {"op": "Gosub", "line": 270, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 271, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "Gosub", "line": 272, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.25"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 275, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "……嗯，就是那样。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.25"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 279, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "你的反应，或许只是刻意做出来的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro012"]}},
    {"op": "ModifyCharacterExtended", "line": 282, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.25"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 283, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "但即便如此，<br>\n只要能相互沟通就足够了，不是吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 286, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Smile_Closed02,Angle01/Facial/Mouth>Mouth_Yum_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 287, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "是这样吗！<br>\n那说不定我根本没什么缺点呢！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry019"]}},
    {"op": "ModifyCharacterExtended", "line": 290, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Pensive_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 291, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "……嗯～，不过是真的话，接下来该怎么办呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry020"]}},
    {"op": "ModifyCharacterExtended", "line": 294, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR15,ArmL2,Angle01/Facial/Eyes>Eyes_Wink_Open02,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 295, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "我变成完美名侦探雪莉了！<br>\n肯定不会魔女化了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry021"]}},
    {"op": "Damage", "line": 298, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.24"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 301, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "（……感觉魔女化的进度倒退了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 304, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 305, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "（要让她魔女化，<br>\n　首先必须准确理解她面临的问题才行）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro015"]}},
    {"op": "GotoModified", "line": 308, "indent": 0, "params": {"Path": ".Judge10-24-1"}},
    {"op": "label", "name": "Judge10-24-2", "line": 314, "indent": 0},
    {"op": "Gosub", "line": 316, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 317, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "HideUI", "line": 318, "indent": 0, "params": {"UINames": ["DebateUI"], "AllowToggle": 0}},
    {"op": "ShowUI", "line": 319, "indent": 0, "params": {"UINames": ["ControlPanel"]}},
    {"op": "StopBgm", "line": 321, "indent": 0, "params": {}},
    {"op": "GosubToObjectionCutIn", "line": 322, "indent": 0, "params": {"CutInKind": "CreatureHiro", "Index": 3}},
    {"op": "Gosub", "line": 323, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 325, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.21"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 326, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 327, "indent": 0, "params": {"Text": "……这是【痛苦的感觉】。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro016"]}},
    {"op": "PlaySfxModified", "line": 330, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 332, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Confused_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 333, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "欸？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry022"]}},
    {"op": "ModifyCharacterExtended", "line": 336, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 337, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "是你没有感受到的感情哦。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 340, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 341, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "我猜，你没办法正确认识到痛苦。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 344, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR2,ArmL3,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Pensive_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 345, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "……是这样吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry023"]}},
    {"op": "ModifyCharacterExtended", "line": 348, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Flushed_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 349, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "手割破了会痛，<br>\n脚被刺了也会痛哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry024"]}},
    {"op": "ModifyCharacterExtended", "line": 352, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Flushed_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 353, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "我不觉得我痛觉迟钝啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry025"]}},
    {"op": "PlayBgm", "line": 356, "indent": 0, "params": {"BgmPath": "Bgm_37_1_Loop", "IntroBgmPath": "Bgm_37_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 358, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 359, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "来自皮肤的信号，<br>\n和你如何看待它，是两回事。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 362, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.19"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 363, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "你的心并没有将痛苦当作难受的事情……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro020"]}},
    {"op": "ModifyCharacterExtended", "line": 366, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.18"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 367, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "所以你才能做出不顾一切的举动，<br>\n就算陷入被处刑的境地，也不会魔女化……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.18"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 371, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "……而且，仔细想想，<br>\n你的魔法应该多少会有些反作用力才对。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 374, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 375, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "对物体施力时，身体会受到反作用力。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro023"]}},
    {"op": "ModifyCharacterExtended", "line": 378, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 379, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 380, "indent": 0, "params": {"Text": "而减轻反作用力，<br>\n说不定也是你魔法的效果之一——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro024"]}},
    {"op": "ModifyCharacterExtended", "line": 382, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 383, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 384, "indent": 0, "params": {"Text": "——但是依我看，正因为你不将痛苦视作苦难，<br>\n你才能完美地运用这个魔法。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro025"]}},
    {"op": "ModifyCharacterExtended", "line": 386, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 387, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "……你的内心，拒绝接受痛苦。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro026"]}},
