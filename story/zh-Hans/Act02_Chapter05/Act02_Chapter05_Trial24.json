    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR12,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 66, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 67, "indent": 0, "params": {"Text": "小时候<br>\n我曾长期遭受<br>\n他人对我的肉体伤害。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 70, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 71, "indent": 0, "params": {"Text": "虽然我还小，<br>\n但是后来的某天<br>\n我试着反抗了一下。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR7,ArmL3,Angle01/Facial/Eyes>Eyes_Flushed_Closed01,Angle01/Facial/Mouth>Mouth_Cry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 74, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 75, "indent": 0, "params": {"Text": "……不过<br>\n我好像力气<br>\n比别人稍微<br>\n大了一点。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR10,ArmL9,Angle01/Facial/Eyes>Eyes_Wink_Open02,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 78, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 79, "indent": 0, "params": {"Text": "结果就是，<br>\n这个世界上<br>\n又少了<br>\n一条生命。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL12,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 82, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 83, "indent": 0, "params": {"Text": "案子最终成了无头迷案，<br>\n而设施职员惨死的尸体，<br>\n也被当成意外死亡处理，<br>\n一切都埋葬在了黑暗中。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry005"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Closed02,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 88, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 89, "indent": 0, "params": {"Text": "不过之后<br>\n雪莉她<br>\n被新的家庭<br>\n收养了。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Closed03,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 92, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 93, "indent": 0, "params": {"Text": "就这样<br>\n在温柔的<br>\n养父养母身边，<br>\n雪莉从此<br>\n过上了<br>\n幸福快乐的生活。<br>\n可喜可贺，可喜可贺——", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry007"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL14,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Neutral_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 98, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 99, "indent": 0, "params": {"Text": "——假如真是那样<br>\n就好了。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR13,ArmL12,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 102, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 103, "indent": 0, "params": {"Text": "只是雪莉她<br>\n从那以后好像<br>\n变成了跟其他人<br>\n稍微不太一样的<br>\n生物。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry009"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL14,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 106, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 107, "indent": 0, "params": {"Text": "我对养父养母<br>\n没有任何不满。<br>\n所以我<br>\n打算努力成为<br>\n他们所期望的<br>\n【好孩子】。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL14,Angle01/Facial/Eyes>Eyes_Normal_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 110, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 111, "indent": 0, "params": {"Text": "我对身边的人<br>\n也一样。<br>\n……虽然不太懂，<br>\n但也在努力融入其中哦。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR7,ArmL14,Angle01/Facial/Eyes>Eyes_Flushed_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 114, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 115, "indent": 0, "params": {"Text": "只不过……<br>\n我好像<link=\"Objection_02_05_24_01\">真的做不到</link>呢。<br>", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry012"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR10,ArmL11,Angle01/Facial/Eyes>Eyes_Cry_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 120, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 121, "indent": 0, "params": {"Text": "不管怎么努力<br>\n也无法假装成<br>\n普通人……<br>\n这不是<br>\n很可悲吗？<br>\n嘤嘤嘤嘤……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry013"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR3,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Neutral_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 126, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 127, "indent": 0, "params": {"Text": "……【悲伤】是<br>\n<link=\"Objection_02_05_24_02\">这样表达</link>的，没错吧？", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial24_Sherry014"]}},
    {"op": "Gosub", "line": 134, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 135, "indent": 0, "params": {"Enable": 1, "ProcessTimer": 1}},
    {"op": "Gosub", "line": 136, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Effect"}},
    {"op": "Gosub", "line": 137, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ResetText", "line": 143, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 145, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center", "ZoomLevel": 2}},
    {"op": "Wait", "line": 146, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "（雪莉的内心……<br>\n　的确是封闭着的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "（她感情中的空洞，<br>\n　只靠一朝一夕是无法填补的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "（不过参考之前的魔女化，<br>\n　雪莉的魔女化应该并非不可能）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "（为此……<br>\n　首先我得直面雪莉的内心，<br>\n　解开她的心结）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro004"]}},
