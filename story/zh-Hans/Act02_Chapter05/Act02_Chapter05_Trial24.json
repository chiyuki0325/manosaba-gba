    {"op": "PlaySfxModified", "line": 399, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 401, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR10,ArmL11,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 402, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "不过……这么一来，<br>\n要让我【魔女化】岂不是更难了？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Sherry027"]}},
