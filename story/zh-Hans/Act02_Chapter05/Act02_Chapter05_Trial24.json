    {"op": "PrintTextModified", "line": 407, "indent": 0, "params": {"Text": "（这……说不定确实是）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro028"]}},
    {"op": "ModifyCharacterExtended", "line": 409, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 410, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 411, "indent": 0, "params": {"Text": "（不过我对她内心的理解又进了一步）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro029"]}},
    {"op": "ModifyCharacterExtended", "line": 413, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 414, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 415, "indent": 0, "params": {"Text": "（现在的话，或许就能动摇她的心，<br>\n　让她魔女化了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial24_Hiro030"]}},
    {"op": "StopBgm", "line": 417, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 419, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
