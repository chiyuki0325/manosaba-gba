{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter05/Act02_Chapter05_Adv07",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-5-6", "line": 4, "indent": 0},
    {"op": "PrintTextModified", "line": 11, "indent": 0, "params": {"Text": "那天，我独自站在监牢门前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative001"]}},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "19_1"}},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 15, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 17, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "（真够慢的……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro001"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "不守时是错误的。<br>\n焦躁使我忍不住用脚尖不断敲击地面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative002"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "（再不快点就要被大家发现了——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "嗨，希罗。<br>\n你看起来很焦急的样子，<br>\n发生什么事了吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Leia001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "——啧。我不禁咂嘴。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "（怎么偏偏是蕾雅）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro003"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "没什么。<br>\n我不过是今天也在堂堂正正地活着罢了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro004"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "话虽如此，但平时希罗你<br>\n这个时候应该正在打扫宅邸才对。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Leia002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "……你知道得还真清楚啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 39, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "距离最后的审判……<br>\n小雪和梅露露消失之后，已经过去数日。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative004"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "我们从魔女的诅咒因子中解放出来，<br>\n原以为能马上就能回家了……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative005"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "据典狱长说，<br>\n我们已经从社会意义上被抹杀了，<br>\n是特例中的特例。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative006"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "所以办理我们回去的手续，需要好几天时间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative007"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "无奈之下，我们只好继续留在监牢，<br>\n已经一个星期了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative008"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "当然，在此期间我们并没有睡在地下牢房，<br>\n而是各自住在自己喜欢的地方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1,ArmL3"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "虽然相处的时间不长，<br>\n但我心中却有很多很多<br>\n与你共度的回忆呢。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Leia003"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "就算你用帅气的表情跟我说这个……<br>\n简而言之，你是我的跟踪狂还是什么吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro006"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "就这样，正当我和蕾雅在宅邸前<br>\n有一搭没一搭地聊着——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 62, "indent": 0, "params": {"SfxPath": "Sfx_154", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HidePrinter", "line": 64, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 66, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "远处传来如同地鸣般的低沉声响。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative011"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "声音逐渐变大，风也开始呼啸。<br>\n抬头望向天空，不知何时出现了一个黑影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative012"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "（总算来了吗。<br>\n　降落地点还真远啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro007"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "从山丘上俯瞰，<br>\n可以看到机体缓缓降落在山谷间的开阔地带。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "那不是直升机吗！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "终于来接我们了吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hanna001"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "（又被麻烦的家伙发现了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "不只是雪莉和汉娜。<br>\n注意到骚动的少女们，<br>\n全都吵吵嚷嚷地跑了出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative014"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "面对这意料之外的状况，<br>\n我重重叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative015"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "……典狱长通知我，<br>\n让我第一个回去。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "哎呀，一次只能接一个人走吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "欸～搞什么嘛～。太狡猾了吧？<br>\n也带上我一起嘛。<br>\n人家想早点回去啦！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Coco001"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "因为我们的情况从各种意义上来说都是特例，<br>\n他们大概也在警惕我们吧。<br>\n回去后短时间内，也可能会被一定程度上禁足。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro010"]}},
    {"op": "HideAllCharacters", "line": 104, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Pensive1,ArmR10,ArmL6"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "说得也是呢……<br>\n也许能允许我们回家<br>\n就该谢天谢地了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Miria001"]}},
    {"op": "ResetText", "line": 109, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 110, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "希罗……你要先走了吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "听到艾玛的声音，我略微一惊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative016"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "嗯……我先走了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 120, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "为什么不告诉我们呀？<br>\n早知道就给你开告别派对了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Noah001"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "……我不喜欢那种伤感的场面。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro012"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "其实，我本打算不惊动任何人，<br>\n悄悄离开这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Cry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "可是……用这种方式告别，<br>\n诺亚好寂寞哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Noah002"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "看着快要哭出来的诺亚，<br>\n我走上前，轻轻地把手放在她的头上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative018"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "我们不是都交换了联系方式吗，<br>\n很快就能再见面的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro013"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "我一定会来见你的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "……嗯！<br>\n诺亚会在希罗来之前，<br>\n把这座宅邸变成彩虹色的！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Noah003"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Angry1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "……吾辈要求的不是彩虹色，<br>\n应该是暗黑城堡才对。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_AnAn001"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "彩虹色比较漂亮，<br>\n所以诺亚就自己定为彩虹色啦！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Angry1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "『坚决斗争』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_AnAn002"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "……诺亚和安安，<br>\n决定留在这座宅邸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "画画是挺好的，<br>\n但你们俩也要记得每天好好洗澡哦？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Smile1,ArmR6"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "我陪你们一起洗也可以的♡", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Margo003"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "玛格也同样选择留下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "诺亚、安安和玛格，<br>\n各自都有选择留在这里而不回去的理由。<br>\n所以我不会阻止她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative021"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "只是，还是有些放心不下，<br>\n我看向玛格。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "玛格，我必须向你道歉。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro015"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "我中途离开，<br>\n相当于增加了你的负担。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro016"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "这不是希罗需要担心的问题。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Margo004"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR6"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "我啊。<br>\n……我讨厌外面的世界。<br>\n这是我的真心话，绝无虚假。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Margo005"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmR6"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "能在这里找到自己力所能及的事，<br>\n我想，这就是我的幸福了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Margo006"]}},
    {"op": "HideAllCharacters", "line": 189, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Smile1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "……我也会再在这里留一段时间，<br>\n继续照顾大家的。希罗就别担心了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Pensive1"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "不过，我也总有一天会回去的。<br>\n因为这里……有太多、太痛苦的回忆了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "……是啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro017"]}},
    {"op": "HideAllCharacters", "line": 200, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "从大魔女的诅咒因子中解放出来的，<br>\n不仅仅只有我们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative023"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "保存在冷冻室里的魔女们，<br>\n也陆陆续续从诅咒中苏醒了过来。<br>\n——看守们，也是如此。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative024"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "但并不是所有人都处于谈得上是幸福的状态。<br>\n许多少女在混乱中留下了深深的心灵创伤，<br>\n需要漫长的时间去疗愈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative025"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "也有很多少女无家可归。<br>\n玛格决定留在这座监牢，<br>\n也是因为需要有人来照顾她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Smile1"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "奈叶香向前迈出一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative027"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "我由衷地感谢你。<br>\n真的非常感谢……二阶堂希罗。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "我并没有资格接受感谢。<br>\n但是，能遇见你们真是太好了，真的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro018"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "嗯。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "奈叶香露出天真无邪的笑容，点了点头。<br>\n或许这才是她本来的样子吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative028"]}},
    {"op": "HideAllCharacters", "line": 222, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "因为我曾好几次看到<br>\n她在医务室的病床旁，和姐姐说话时<br>\n纯真地笑着的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Cry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "呜……你赶紧走吧二阶堂。<br>\n气氛都奇怪起来了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Alisa001"]}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "亚里沙。你要好好回家才行。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "我知道啦！<br>\n到最后了还像个班长一样说教！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "我一定会回去的。<br>\n因为现在的我已经变了，我想见到亲人。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Alisa003"]}},
    {"op": "HideAllCharacters", "line": 242, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "说得对呢。我也是，<br>\n在这里经历了很多很多事情，<br>\n总觉得好像体会到了亲人的珍贵！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "所以，回去之后，<br>\n我想好好地跟家里人撒撒娇。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 251, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Surprised1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "不是撒娇，是好好报答家人吧我说。<br>\n啊啊，怎么还不来接人家啊～<br>\n终于能见到我推了！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "小可真了不起呢。<br>\n大叔我也是，回去之后有想要亲自传达感谢的人呢。<br>\n还有……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Miria002"]}},
    {"op": "ModifyCharacterExtended", "line": 260, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Smile1,ArmR3"}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "回去之后，<br>\n我们也还是朋友吧？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Miria003"]}},
    {"op": "ModifyCharacterExtended", "line": 264, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 265, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Smile1"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "当然！大家一定要出来聚哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 269, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "约好了要开茶会的哇！<br>\n在我那豪华的宅邸……不对，<br>\n是在蕾雅家！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile1,ArmL3"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "哈哈哈哈，随时欢迎你们，当自己家就行。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Leia004"]}},
    {"op": "HideAllCharacters", "line": 278, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "看着大家这样你一言我一语的，<br>\n感觉好像永远也离不开这里了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative030"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "我转过身，趁大家不注意，悄悄迈开脚步。<br>\n我打算前往直升机的降落地点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Narrative031"]}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "（大家……再见了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro020"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "（再见了，艾玛）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv07_Hiro021"]}},
    {"op": "ResetText", "line": 288, "indent": 0, "params": {}},
    {"op": "Wait", "line": 289, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "Gosub", "line": 291, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 293, "indent": 0, "params": {"Path": "Act02_Chapter05/Act02_Chapter05_Adv08", "SoftReset": 1}}
  ],
  "translations": {
  "0205Adv07_Narrative001": "那天，我独自站在监牢门前。",
  "0205Adv07_Hiro001": "（真够慢的……）",
  "0205Adv07_Narrative002": "不守时是错误的。<br>\n焦躁使我忍不住用脚尖不断敲击地面。",
  "0205Adv07_Hiro002": "（再不快点就要被大家发现了——）",
  "0205Adv07_Leia001": "嗨，希罗。<br>\n你看起来很焦急的样子，<br>\n发生什么事了吗？",
  "0205Adv07_Narrative003": "——啧。我不禁咂嘴。",
  "0205Adv07_Hiro003": "（怎么偏偏是蕾雅）",
  "0205Adv07_Hiro004": "没什么。<br>\n我不过是今天也在堂堂正正地活着罢了。",
  "0205Adv07_Leia002": "话虽如此，但平时希罗你<br>\n这个时候应该正在打扫宅邸才对。",
  "0205Adv07_Hiro005": "……你知道得还真清楚啊。",
  "0205Adv07_Narrative004": "距离最后的审判……<br>\n小雪和梅露露消失之后，已经过去数日。",
  "0205Adv07_Narrative005": "我们从魔女的诅咒因子中解放出来，<br>\n原以为能马上就能回家了……",
  "0205Adv07_Narrative006": "据典狱长说，<br>\n我们已经从社会意义上被抹杀了，<br>\n是特例中的特例。",
  "0205Adv07_Narrative007": "所以办理我们回去的手续，需要好几天时间。",
  "0205Adv07_Narrative008": "无奈之下，我们只好继续留在监牢，<br>\n已经一个星期了。",
  "0205Adv07_Narrative009": "当然，在此期间我们并没有睡在地下牢房，<br>\n而是各自住在自己喜欢的地方。",
  "0205Adv07_Leia003": "虽然相处的时间不长，<br>\n但我心中却有很多很多<br>\n与你共度的回忆呢。",
  "0205Adv07_Hiro006": "就算你用帅气的表情跟我说这个……<br>\n简而言之，你是我的跟踪狂还是什么吗？",
  "0205Adv07_Narrative010": "就这样，正当我和蕾雅在宅邸前<br>\n有一搭没一搭地聊着——",
  "0205Adv07_Narrative011": "远处传来如同地鸣般的低沉声响。",
  "0205Adv07_Narrative012": "声音逐渐变大，风也开始呼啸。<br>\n抬头望向天空，不知何时出现了一个黑影。",
  "0205Adv07_Hiro007": "（总算来了吗。<br>\n　降落地点还真远啊）",
  "0205Adv07_Narrative013": "从山丘上俯瞰，<br>\n可以看到机体缓缓降落在山谷间的开阔地带。",
  "0205Adv07_Sherry001": "那不是直升机吗！？",
  "0205Adv07_Hanna001": "终于来接我们了吗！？",
  "0205Adv07_Hiro008": "（又被麻烦的家伙发现了……）",
  "0205Adv07_Narrative014": "不只是雪莉和汉娜。<br>\n注意到骚动的少女们，<br>\n全都吵吵嚷嚷地跑了出来。",
  "0205Adv07_Narrative015": "面对这意料之外的状况，<br>\n我重重叹了口气。",
  "0205Adv07_Hiro009": "……典狱长通知我，<br>\n让我第一个回去。",
  "0205Adv07_Margo001": "哎呀，一次只能接一个人走吗？",
  "0205Adv07_Coco001": "欸～搞什么嘛～。太狡猾了吧？<br>\n也带上我一起嘛。<br>\n人家想早点回去啦！",
  "0205Adv07_Hiro010": "因为我们的情况从各种意义上来说都是特例，<br>\n他们大概也在警惕我们吧。<br>\n回去后短时间内，也可能会被一定程度上禁足。",
  "0205Adv07_Miria001": "说得也是呢……<br>\n也许能允许我们回家<br>\n就该谢天谢地了。",
  "0205Adv07_Ema001": "希罗……你要先走了吗？",
  "0205Adv07_Narrative016": "听到艾玛的声音，我略微一惊。",
  "0205Adv07_Hiro011": "嗯……我先走了。",
  "0205Adv07_Noah001": "为什么不告诉我们呀？<br>\n早知道就给你开告别派对了。",
  "0205Adv07_Hiro012": "……我不喜欢那种伤感的场面。",
  "0205Adv07_Narrative017": "其实，我本打算不惊动任何人，<br>\n悄悄离开这里。",
  "0205Adv07_Noah002": "可是……用这种方式告别，<br>\n诺亚好寂寞哦。",
  "0205Adv07_Narrative018": "看着快要哭出来的诺亚，<br>\n我走上前，轻轻地把手放在她的头上。",
  "0205Adv07_Hiro013": "我们不是都交换了联系方式吗，<br>\n很快就能再见面的。",
  "0205Adv07_Hiro014": "我一定会来见你的。",
  "0205Adv07_Noah003": "……嗯！<br>\n诺亚会在希罗来之前，<br>\n把这座宅邸变成彩虹色的！",
  "0205Adv07_AnAn001": "……吾辈要求的不是彩虹色，<br>\n应该是暗黑城堡才对。",
  "0205Adv07_Noah004": "彩虹色比较漂亮，<br>\n所以诺亚就自己定为彩虹色啦！",
  "0205Adv07_AnAn002": "『坚决斗争』",
  "0205Adv07_Narrative019": "……诺亚和安安，<br>\n决定留在这座宅邸。",
  "0205Adv07_Margo002": "画画是挺好的，<br>\n但你们俩也要记得每天好好洗澡哦？",
  "0205Adv07_Margo003": "我陪你们一起洗也可以的♡",
  "0205Adv07_Narrative020": "玛格也同样选择留下。",
  "0205Adv07_Narrative021": "诺亚、安安和玛格，<br>\n各自都有选择留在这里而不回去的理由。<br>\n所以我不会阻止她们。",
  "0205Adv07_Narrative022": "只是，还是有些放心不下，<br>\n我看向玛格。",
  "0205Adv07_Hiro015": "玛格，我必须向你道歉。",
  "0205Adv07_Hiro016": "我中途离开，<br>\n相当于增加了你的负担。",
  "0205Adv07_Margo004": "这不是希罗需要担心的问题。",
  "0205Adv07_Margo005": "我啊。<br>\n……我讨厌外面的世界。<br>\n这是我的真心话，绝无虚假。",
  "0205Adv07_Margo006": "能在这里找到自己力所能及的事，<br>\n我想，这就是我的幸福了。",
  "0205Adv07_Nanoka001": "……我也会再在这里留一段时间，<br>\n继续照顾大家的。希罗就别担心了。",
  "0205Adv07_Nanoka002": "不过，我也总有一天会回去的。<br>\n因为这里……有太多、太痛苦的回忆了。",
  "0205Adv07_Hiro017": "……是啊。",
  "0205Adv07_Narrative023": "从大魔女的诅咒因子中解放出来的，<br>\n不仅仅只有我们。",
  "0205Adv07_Narrative024": "保存在冷冻室里的魔女们，<br>\n也陆陆续续从诅咒中苏醒了过来。<br>\n——看守们，也是如此。",
  "0205Adv07_Narrative025": "但并不是所有人都处于谈得上是幸福的状态。<br>\n许多少女在混乱中留下了深深的心灵创伤，<br>\n需要漫长的时间去疗愈。",
  "0205Adv07_Narrative026": "也有很多少女无家可归。<br>\n玛格决定留在这座监牢，<br>\n也是因为需要有人来照顾她们。",
  "0205Adv07_Narrative027": "奈叶香向前迈出一步。",
  "0205Adv07_Nanoka003": "我由衷地感谢你。<br>\n真的非常感谢……二阶堂希罗。",
  "0205Adv07_Hiro018": "我并没有资格接受感谢。<br>\n但是，能遇见你们真是太好了，真的。",
  "0205Adv07_Nanoka004": "嗯。",
  "0205Adv07_Narrative028": "奈叶香露出天真无邪的笑容，点了点头。<br>\n或许这才是她本来的样子吧。",
  "0205Adv07_Narrative029": "因为我曾好几次看到<br>\n她在医务室的病床旁，和姐姐说话时<br>\n纯真地笑着的样子。",
  "0205Adv07_Alisa001": "呜……你赶紧走吧二阶堂。<br>\n气氛都奇怪起来了。",
  "0205Adv07_Hiro019": "亚里沙。你要好好回家才行。",
  "0205Adv07_Alisa002": "我知道啦！<br>\n到最后了还像个班长一样说教！",
  "0205Adv07_Alisa003": "我一定会回去的。<br>\n因为现在的我已经变了，我想见到亲人。",
  "0205Adv07_Sherry002": "说得对呢。我也是，<br>\n在这里经历了很多很多事情，<br>\n总觉得好像体会到了亲人的珍贵！",
  "0205Adv07_Sherry003": "所以，回去之后，<br>\n我想好好地跟家里人撒撒娇。",
  "0205Adv07_Coco002": "不是撒娇，是好好报答家人吧我说。<br>\n啊啊，怎么还不来接人家啊～<br>\n终于能见到我推了！！",
  "0205Adv07_Miria002": "小可真了不起呢。<br>\n大叔我也是，回去之后有想要亲自传达感谢的人呢。<br>\n还有……",
  "0205Adv07_Miria003": "回去之后，<br>\n我们也还是朋友吧？",
  "0205Adv07_Sherry004": "当然！大家一定要出来聚哦！",
  "0205Adv07_Hanna002": "约好了要开茶会的哇！<br>\n在我那豪华的宅邸……不对，<br>\n是在蕾雅家！",
  "0205Adv07_Leia004": "哈哈哈哈，随时欢迎你们，当自己家就行。",
  "0205Adv07_Narrative030": "看着大家这样你一言我一语的，<br>\n感觉好像永远也离不开这里了。",
  "0205Adv07_Narrative031": "我转过身，趁大家不注意，悄悄迈开脚步。<br>\n我打算前往直升机的降落地点。",
  "0205Adv07_Hiro020": "（大家……再见了）",
  "0205Adv07_Hiro021": "（再见了，艾玛）"
}
}
