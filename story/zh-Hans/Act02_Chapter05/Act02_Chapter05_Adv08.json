    {"op": "PlayVoice", "line": 359, "indent": 1, "params": {"VoicePath": "Act02_Chapter05/Act02_Chapter05_Adv08/0205Adv08_Ema027", "Volume": 1.0, "AuthorId": "Ema"}},
    {"op": "Else", "line": 360, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 361, "indent": 1, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 362, "indent": 1, "params": {"Text": "希罗，我们还能再见面的吧？", "RevealSpeed": 1.0, "WaitForInput": 0, "Wait": 0}, "text_ids": {"Text": ["0205Adv08_Ema027"]}},
    {"op": "Wait", "line": 364, "indent": 0, "params": {"WaitMode": {"expression": "{3.745 + 1}"}}},
    {"op": "BeginIfCurrentLanguage", "line": 366, "indent": 0, "params": {"Expression": "ja", "LanguageName": "ja"}},
    {"op": "PlayVoice", "line": 367, "indent": 1, "params": {"VoicePath": "Act02_Chapter05/Act02_Chapter05_Adv08/0205Adv08_Hiro016", "Volume": 1.0, "AuthorId": "Hiro"}},
    {"op": "Else", "line": 368, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 369, "indent": 1, "params": {"Text": "因为你都哭得稀里哗啦的了。<br>\n没办法，就待在你身边吧。", "RevealSpeed": 1.0, "WaitForInput": 0, "Wait": 0}, "text_ids": {"Text": ["0205Adv08_Hiro016"]}},
    {"op": "Wait", "line": 371, "indent": 0, "params": {"WaitMode": {"expression": "{6.424 + 1}"}}},
    {"op": "BeginIfCurrentLanguage", "line": 373, "indent": 0, "params": {"Expression": "ja", "LanguageName": "ja"}},
    {"op": "PlayVoice", "line": 374, "indent": 1, "params": {"VoicePath": "Act02_Chapter05/Act02_Chapter05_Adv08/0205Adv08_Ema028", "Volume": 1.0, "AuthorId": "Ema"}},
    {"op": "Else", "line": 375, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 376, "indent": 1, "params": {"Text": "明明希罗自己也在哭，还说我。", "RevealSpeed": 1.0, "WaitForInput": 0, "Wait": 0}, "text_ids": {"Text": ["0205Adv08_Ema028"]}},
    {"op": "Wait", "line": 378, "indent": 0, "params": {"WaitMode": {"expression": "{2.419 + 1}"}}},
    {"op": "BeginIfCurrentLanguage", "line": 380, "indent": 0, "params": {"Expression": "ja", "LanguageName": "ja"}},
    {"op": "PlayVoice", "line": 381, "indent": 1, "params": {"VoicePath": "Act02_Chapter05/Act02_Chapter05_Adv08/0205Adv08_Hiro017", "Volume": 1.0, "AuthorId": "Hiro"}},
    {"op": "Else", "line": 382, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 383, "indent": 1, "params": {"Text": "……你好烦。", "RevealSpeed": 1.0, "WaitForInput": 0, "Wait": 0}, "text_ids": {"Text": ["0205Adv08_Hiro017"]}},
    {"op": "Wait", "line": 385, "indent": 0, "params": {"WaitMode": {"expression": "{1.564 + 1}"}}},
    {"op": "BeginIfCurrentLanguage", "line": 387, "indent": 0, "params": {"Expression": "ja", "LanguageName": "ja"}},
    {"op": "PlayVoice", "line": 388, "indent": 1, "params": {"VoicePath": "Act02_Chapter05/Act02_Chapter05_Adv08/0205Adv08_Ema029", "Volume": 1.0, "AuthorId": "Ema"}},
    {"op": "Else", "line": 389, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 390, "indent": 1, "params": {"Text": "我想跟希罗一直聊下去，聊好多好多呢。<br>\n毕竟，属于我们两个人的时间，现在才刚刚开始。", "RevealSpeed": 1.0, "WaitForInput": 0, "Wait": 0}, "text_ids": {"Text": ["0205Adv08_Ema029"]}},
    {"op": "Wait", "line": 392, "indent": 0, "params": {"WaitMode": "1"}},
