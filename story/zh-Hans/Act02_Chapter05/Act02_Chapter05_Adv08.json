    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "不知不觉间，<br>\n希罗的身影消失了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative001"]}},
    {"op": "PlayBgm", "line": 24, "indent": 0, "params": {"BgmPath": "Bgm_40_1_Loop", "IntroBgmPath": "Bgm_40_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（希罗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "大家还在叽叽喳喳，<br>\n似乎没人注意到希罗<br>\n已经离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative002"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（真像希罗的作风啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "这样想着的同时，<br>\n胸口一阵抽痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "从那件事至今已经过了一个星期。<br>\n在这座宅邸度过的这段时间，<br>\n希罗一直刻意躲着我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative004"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "初中时，<br>\n我和希罗关系变差那阵子，<br>\n和在监牢里度过的这段时间所见的希罗……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative005"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "没有任何不同。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative006"]}},
    {"op": "ResetText", "line": 40, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 41, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 42, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 43, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyBackgroundExtended", "line": 45, "indent": 0, "params": {"TintColor": "#dfd1a2", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"TintColor": "#dfd1a2", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "ModifyBackgroundExtended", "line": 48, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "你改变了，<br>\n跟我有什么关系？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro001"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "我讨厌你的事实不会改变。<br>\n永远不会。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro002"]}},
    {"op": "ResetText", "line": 59, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 60, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
