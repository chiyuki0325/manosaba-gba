    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Scale": [3.0], "Lazy": 0, "ScenePosition": [30.0, 55.0], "IdAndAppearance": "Hiro.Pensive1", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 234, "indent": 0, "params": {"ActorId": "Hiro-Middle", "FadeDuration": 0.0}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "视野里终于出现希罗的背影，<br>\n我忍不住大喊起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative013"]}},
    {"op": "PlayBgm", "line": 238, "indent": 0, "params": {"BgmPath": "Bgm_2_1_Loop", "IntroBgmPath": "Bgm_2_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 2.0}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro003"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "希罗没有回头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative014"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "我不要就这样和你分别！！<br>", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema016"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "……我做了很多对不起你的事。<br>\n我打算用一生去补偿。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro004"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "希罗仍然背对着我，抛下这句话。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative015"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "我真的由衷感到非常对不起你……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Ema.Angry1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "我不想听这个！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema017"]}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "我不需要这种话！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema018"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro006"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "希罗的背影颤抖起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative016"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "我知道我的所作所为，即使道歉也不应该得到原谅，<br>\n更没有期望你的原谅。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro007"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "我做了错误的事，所以，已经……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro008"]}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "那种事无所谓啦！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema019"]}},
    {"op": "ResetText", "line": 268, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 269, "indent": 0, "params": {"Duration": 0.5, "Lazy": 0, "IdAndAppearance": "Hiro.Angry1", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 270, "indent": 0, "params": {"ActorId": "Hiro-Middle", "Intensity": 0.0, "FadeDuration": 0.5}},
    {"op": "SpawnBlur", "line": 271, "indent": 0, "params": {"ActorId": "Ema", "FadeDuration": 0.5}},
    {"op": "Wait", "line": 272, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "怎么可能无所谓！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro009"]}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "初中的时候，是我，伤透了你的心！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro010"]}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "因为我自以为是的嫉妒、自以为是的误解，<br>\n把你逼到绝境……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro011"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "就算那是小雪计划的一部分，<br>\n也不足以构成借口！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro012"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "我们已经回不到从前了！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro013"]}},
    {"op": "ResetText", "line": 284, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Duration": 0.4000000059604645, "Lazy": 0, "IdAndAppearance": "Hiro.Pensive1", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 286, "indent": 0, "params": {"ActorId": "Hiro-Middle", "FadeDuration": 0.4000000059604645}},
    {"op": "SpawnBlur", "line": 287, "indent": 0, "params": {"ActorId": "Ema", "Intensity": 0.0, "FadeDuration": 0.4000000059604645}},
    {"op": "Wait", "line": 288, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyCharacterExtended", "line": 290, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "面对坚持不肯回头的希罗……<br>\n我深吸一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative017"]}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "你知道吗？我啊，", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema020"]}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "从小就为了吸引希罗的注意，<br>\n故意净做些失败的事。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema021"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "有时给希罗添麻烦，<br>\n有时让希罗担心，<br>\n我总是只会用这种方式来吸引你的注意……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema022"]}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "其实，先束缚住希罗的心的，<br>\n应该是我才对。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema023"]}},
    {"op": "ModifyCharacterExtended", "line": 302, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Ema.Smile1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "所以——我们就扯平啦！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema024"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 310, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "虽然我确实也<br>\n有过很多生气的时候，<br>\n也有原谅不了的时候。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema025"]}},
    {"op": "ModifyCharacterExtended", "line": 314, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Ema.Smile1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "虽然很不甘心，<br>\n但我还是最喜欢希罗了！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema026"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hiro015"]}},
    {"op": "ResetText", "line": 322, "indent": 0, "params": {}},
    {"op": "SpawnBlur", "line": 323, "indent": 0, "params": {"ActorId": "Hiro-Middle", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 324, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0}},
    {"op": "Wait", "line": 325, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "StopBgm", "line": 327, "indent": 0, "params": {"FadeOutDuration": 2.0}},
    {"op": "ModifyCharacterExtended", "line": 328, "indent": 0, "params": {"Scale": [1.5], "Duration": 1.0, "Lazy": 0, "ScenePosition": [50.0, 45.0], "IdAndAppearance": "Hiro.Cry1"}},
    {"op": "Wait", "line": 329, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "希罗终于回头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative018"]}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "不出意料，<br>\n我们两人都哭得一塌糊涂——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 335, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 337, "indent": 0, "params": {"Text": "我奔向希罗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative020"]}},
    {"op": "BeginIf", "line": 339, "indent": 0, "params": {"Expression": "!enableDebugSkip"}},
