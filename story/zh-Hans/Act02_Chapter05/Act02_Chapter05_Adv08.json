    {"op": "Wait", "line": 68, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "（我们已经，回不到从前了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema003"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "仅仅只是将这个现实，<br>\n再次摆在了我的面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative007"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema004"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "我握紧拳头，低下头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.Smile1"}},
