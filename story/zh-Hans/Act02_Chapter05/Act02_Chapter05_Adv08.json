    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "这是我们大家<br>\n作为朋友，给你的建议。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "去吧，艾玛！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 134, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "我抬起头。<br>\n面前是大家的笑脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative009"]}},
