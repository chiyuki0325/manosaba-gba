    {"op": "Wait", "line": 184, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "哈啊、哈啊、哈啊……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema006"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "（居然要靠人推一把，<br>\n　才终于能动起来……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema007"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "（我还是一如既往地没出息）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema008"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "哈啊、哈啊……！啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema009"]}},
    {"op": "SpawnShake", "line": 198, "indent": 0, "params": {"ActorId": "Camera"}},
    {"op": "PlaySfxModified", "line": 201, "indent": 0, "params": {"SfxPath": "Sfx_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "脚下一绊，我摔倒在地。<br>\n疼痛让我差点哭出来，五官皱成一团。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative011"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "呜、呜呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema010"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "（我总是那么依赖希罗……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema011"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "（所以，不能再依赖希罗了，<br>\n　必须离开她才行……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema012"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "我摇摇晃晃地站起来。<br>\n擦掉眼角涌出的泪水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Narrative012"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "（但是……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema013"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "（即使如此，我还是……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv08_Ema014"]}},
