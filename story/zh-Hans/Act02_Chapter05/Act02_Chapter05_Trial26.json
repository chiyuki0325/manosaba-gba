  "translations": {
  "0205Trial26_Hiro001": "……告诉我<br>\n你的过去吧。",
  "0205Trial26_Ema001": "嗯……",
  "0205Trial26_Ema002": "我……<br>\n在学校被霸凌了。",
  "0205Trial26_Ema003": "为什么会<br>\n遭欺负……<br>\n为什么会<br>\n被讨厌……<br>",
  "0205Trial26_Ema004": "原因……<br>\n<link=\"Objection_02_05_26_01\">我不知道</link>。",
  "0205Trial26_Ema005": "所以……<br>\n我曾经想过。",
  "0205Trial26_Ema006": "——只要大家<br>\n都<link=\"Objection_02_05_26_02\">去死就好</link>了。",
  "0205Trial26_Ema007": "我……<br>\n<link=\"Objection_02_05_26_03\">怨恨着</link>大家。",
  "0205Trial26_Hiro002": "（……艾玛）",
  "0205Trial26_Hiro003": "（为什么……）",
  "0205Trial26_Choice001": "你是知道的",
  "Common_Return": "返回",
  "0205Trial26_Choice002": "不可以有这种想法",
  "0205Trial26_Choice003": "没有必要去怨恨",
  "0205Trial26_Hiro004": "……不可以有这种想法。",
  "0205Trial26_Ema008": "我知道……可是我止不住这么想。",
  "0205Trial26_Ema009": "为什么大家……都要欺负我……？",
  "0205Trial26_Hiro005": "（艾玛的【杀意】<br>\n　有可能会触发【杀死魔女的魔法】……）",
  "0205Trial26_Hiro006": "（……我要慎重地推进对话）",
  "0205Trial26_Hiro007": "你没必要恨……",
  "0205Trial26_Hiro008": "一切……都是大魔女的恶意造成的。",
  "0205Trial26_Ema010": "你说这个……也没意义。",
  "0205Trial26_Ema011": "我……很难理解。",
  "0205Trial26_Hiro009": "（艾玛的【杀意】<br>\n　有可能会触发【杀死魔女的魔法】……）",
  "0205Trial26_Hiro010": "（……我要慎重地推进对话）",
  "0205Trial26_Hiro011": "不可能不知道。",
  "0205Trial26_Hiro012": "你是知道的。",
  "0205Trial26_Hiro013": "为什么你，<br>\n会成为目标。",
  "0205Trial26_Ema012": "不管你再怎么说……我也搞不明白啊。",
  "0205Trial26_Ema013": "我真的……不知道……",
  "0205Trial26_Hiro014": "…………",
  "0205Trial26_Hiro015": "……那么，接下来能请你谈谈我的事吗？",
  "0205Trial26_Ema014": "欸……",
  "0205Trial26_Hiro016": "拜托你了，艾玛。",
  "0205Trial26_Ema015": "嗯、嗯……",
  "0205Trial26_Ema016": "……我明白了。"
}
