    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（……魔女审判要开始了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（就算幕后黑手梅露露被杀，<br>\n　这座监牢对我们的囚禁也并未结束。<br>\n　而且——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro002"]}},
    {"op": "ResetText", "line": 36, "indent": 0, "params": {}},
