    {"op": "GosubToModifyPerspectiveStageCamera", "line": 287, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "……难道你没有像我一样产生【魔女化】吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro026"]}},
