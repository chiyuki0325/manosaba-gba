    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "你明明是魔女，外形却和普通人没什么两样。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro025"]}},
