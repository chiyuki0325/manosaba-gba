    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.ArmR2,ArmL3,Eyes1_Pensive_Open1,Mouth1_Angry_Open1", "SubId": "Flashback"}},
    {"op": "ModifyBackgroundExtended", "line": 45, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 46, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "本来按规定，<br>\n国家机关会在我们完全变成魔女前把我们全部诛杀。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR4,ArmL2", "SubId": "Flashback"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "可讽刺的是，<br>\n正因为冰上梅露露想利用我们找到大魔女，<br>\n我们才得以在夹缝中生存下来。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Nanoka002"]}},
    {"op": "ResetText", "line": 55, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 56, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 57, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "HideActors", "line": 58, "indent": 0, "params": {"ActorIds": ["MainBackground-Flashback", "Nanoka-Flashback"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 60, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "ModifyTextPrinter", "line": 61, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 62, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlayBgm", "line": 64, "indent": 0, "params": {"BgmPath": "Bgm_39_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "（结合之前奈叶香所说的，<br>\n　靠梅露露的做法，<br>\n　是不可能找出大魔女的——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 72, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "（所以，就由我来代替梅露露，<br>\n　召唤大魔女……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 76, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "（虽然我不完全了解，召唤后会引发怎样的情况……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 80, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "（但只要解决了万恶之源的大魔女，<br>\n　或许就能消除我们这些<br>\n　预备魔女身上的魔女因子）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 84, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "（这样一来，我们就不会变成魔女，<br>\n　这群少女也没有理由再遭囚禁了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 88, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "（能够拯救在场所有人的人<br>\n　——只有我！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro008"]}},
    {"op": "PlaySfxModified", "line": 92, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR10,ArmL8,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 95, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "……我说啊，你把我们召集来这种地方，<br>\n到底要我们干嘛？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Coco001"]}},
    {"op": "PlaySfxModified", "line": 99, "indent": 0, "params": {"SfxPath": "Sfx_Common_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR10,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Open01,Angle01/Facial/Mouth>Mouth_Yell_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 102, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "没错！<br>\n你到底打算让我们做什么！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 106, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（……要召唤大魔女，<br>\n　就需要令在场所有人完成魔女化）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 110, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "（魔女化是通过施加过度的心理压力<br>\n　引发的……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro010"]}},
    {"op": "PlaySfxModified", "line": 114, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 117, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "（但是……<br>\n　如果为了施加巨大的心理压力而诉诸暴力，<br>\n　恐怕只会招致反抗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 121, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "（有没有什么可利用的情报呢……<br>\n　试着回想一下吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro012"]}},
    {"op": "ResetText", "line": 126, "indent": 0, "params": {}},
    {"op": "Wait", "line": 127, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 129, "indent": 0, "params": {"SfxPath": "Sfx_Common_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Head2,ArmR1_2,Eyes2_Smile_Closed1,Mouth2_Smile_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 134, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "……来吧！希罗小姐！<br>\n我们把大魔女大人……召唤出来吧！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.10"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 138, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "……好啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.10"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 142, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "只不过，我们得按步骤来。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 146, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "……你会协助我的，对吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro015"]}},
    {"op": "PlaySfxModified", "line": 150, "indent": 0, "params": {"SfxPath": "Sfx_Common_2", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Head2,ArmR1_2,Eyes2_Smile_Closed1,Mouth2_Smile_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 153, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "是、是的！<br>\n要做什么我都愿意帮忙……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 157, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "……魔女审判——是叫这个吧？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 161, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "你是想从我们之中找出魔女吗？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Smile1,ArmR2,ArmL5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 165, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "如果真是这样，<br>\n那么大家眼前不就有一个非常显眼的【魔女】吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 168, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 169, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Noah", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "那就是希罗呢！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Noah001"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.25"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 173, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "事到如今……你们要这么想也无妨。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.20"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 177, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "但是，除了我之外，<br>\n我也要把你们之中的魔女找出来。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro017"]}},
    {"op": "PlaySfxModified", "line": 181, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 186, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Ema001"]}},
