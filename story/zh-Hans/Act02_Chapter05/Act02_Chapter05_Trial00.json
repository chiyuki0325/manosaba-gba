    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "……不好意思，我有一个问题想问你一下。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial00_Hiro024"]}},
