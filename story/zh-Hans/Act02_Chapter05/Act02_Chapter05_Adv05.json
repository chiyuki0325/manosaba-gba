    {"op": "Wait", "line": 131, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "包裹着肉块的血液，<br>\n忽地化作铺天盖地的红蝶剥落下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative017"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "那就是大魔女……<br>\n长得还挺可爱的嘛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Margo001"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "我偷偷瞥了眼身旁的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative018"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "……小……雪。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Ema001"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "终于重逢……却又不愿相信。<br>\n艾玛脸上浮现出复杂纠葛的神情，<br>\n轻轻唤出旧友的名字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative019"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "我的复活，即意味着绝望……<br>\n你们到底在指望什么呢？", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Yuki001"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "不可能会有好结局的。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Yuki002"]}},
    {"op": "ModifyBackgroundExtended", "line": 147, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 3.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "700_6", "SubId": "Middle"}},
    {"op": "Wait", "line": 148, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "大魔女——雪，嫣然一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative020"]}},
    {"op": "ModifyBackgroundExtended", "line": 152, "indent": 0, "params": {"Id": "Stills", "Scale": [3.0], "Duration": 2.0, "Lazy": 0, "ScenePosition": [50.0, 10.0], "AppearanceAndTransition": "700_6", "SubId": "Front"}},
    {"op": "Wait", "line": 153, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "来吧，成为我的共犯吧。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Yuki003"]}},
    {"op": "Wait", "line": 157, "indent": 0, "params": {"WaitMode": "1"}},
