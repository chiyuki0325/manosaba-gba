    {"op": "label", "name": "Scene2-5-4", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "700_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_36_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "如今的我心如止水。<br>\n我高举仪礼剑，用剑尖指向审判庭中央。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "（召唤出大魔女，并审判她）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Hiro001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（然后，让她把我们从诅咒中解放出来……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Hiro002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（你一直都在我们身边。<br>\n　你会来的，对吧，小雪……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Hiro003"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "在紧绷的空气中，几秒钟过去了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative002"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "……等等。<br>\n感觉……有什么在看着我。<br>\n有什么不妙的东西要来了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Coco001"]}},
    {"op": "SpawnShake", "line": 32, "indent": 0, "params": {"ActorId": "Camera"}},
    {"op": "PlayBgm", "line": 35, "indent": 0, "params": {"BgmPath": "Ambi_7_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "低沉如地鸣般的闷响，<br>\n隐约地在四周响起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative003"]}},
    {"op": "ModifyBackgroundExtended", "line": 39, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "700_2"}},
    {"op": "AnimateActorExtended", "line": 41, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "ScenePositionX": "50", "ScenePositionY": "70", "Scale": "1.5", "EasingTypeName": "EaseOutQuad", "Duration": "10"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "——慢慢地，审判庭中央的<br>\n处刑台上渗出了赤黑色的液体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative004"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "唔唔。<br>\n那不是……血吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Sherry001"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "雪莉透过放大镜凝视着远处的液体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative005"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "就在那一瞬间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative006"]}},
    {"op": "PlaySfxModified", "line": 52, "indent": 0, "params": {"SfxPath": "Sfx_170", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 54, "indent": 0, "params": {"Id": "Stills", "Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 80.0], "AppearanceAndTransition": "700_3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "审判庭中央像是被撕开了一个大洞，<br>\n赤黑色的液体源源不断地涌出。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative007"]}},
    {"op": "AnimateActorExtended", "line": 58, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "50", "ScenePositionY": "115", "Scale": "3", "EasingTypeName": "EaseOutQuad", "Duration": "18"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "喂喂喂……！<br>\n这是什么鬼，没听说过啊！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Alisa001"]}},
    {"op": "PlaySfxModified", "line": 63, "indent": 0, "params": {"SfxPath": "Sfx_171", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "血柱喷涌而上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative008"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "不久，液体如同洪水般<br>\n开始充斥整个审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative009"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "等、等等，这、<br>\n这样下去不妙吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Hanna001"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "没、没事的。我会保护大家的……！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Leia001"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "少女们还在战栗不已，<br>\n终于血色喷泉的势头开始有了减弱的迹象。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative010"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "……里面，有个人。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_AnAn001"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "在逐渐减弱的血柱缝隙中，<br>\n隐约可见某种【轮廓】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative011"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "那是一团闪着粘稠光泽、<br>\n约一人大小的肉块。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative012"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "啊啊……大魔女大人。<br>\n终于……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Meruru001"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "——终于，与您相会了……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Meruru002"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "就在那一刻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative013"]}},
    {"op": "PlaySfxModified", "line": 89, "indent": 0, "params": {"SfxPath": "Sfx_38", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 90, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "枪声骤然响起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative014"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "子弹射向肉块，<br>\n却在空中化作火花，凭空消失了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative015"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "……！<br>\n子弹在空中燃尽了？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "等、等等，别乱来啊！<br>\n那东西不知道会对我们做什么！<br>\n大、大叔我受不了了，好可怕！！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Miria001"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "这是魔女们流的血。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Unknown001"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "也是我们将继续播下的种子……<br>\n魔女的因子。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Unknown002"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "有什么东西在说话？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Noah001"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "随着诺亚一句疑问……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv05_Narrative016"]}},
    {"op": "HidePrinter", "line": 109, "indent": 0, "params": {}},
