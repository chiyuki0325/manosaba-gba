  "translations": {
  "0205Adv05_Narrative001": "如今的我心如止水。<br>\n我高举仪礼剑，用剑尖指向审判庭中央。",
  "0205Adv05_Hiro001": "（召唤出大魔女，并审判她）",
  "0205Adv05_Hiro002": "（然后，让她把我们从诅咒中解放出来……）",
  "0205Adv05_Hiro003": "（你一直都在我们身边。<br>\n　你会来的，对吧，小雪……？）",
  "0205Adv05_Narrative002": "在紧绷的空气中，几秒钟过去了。",
  "0205Adv05_Coco001": "……等等。<br>\n感觉……有什么在看着我。<br>\n有什么不妙的东西要来了。",
  "0205Adv05_Narrative003": "低沉如地鸣般的闷响，<br>\n隐约地在四周响起。",
  "0205Adv05_Narrative004": "——慢慢地，审判庭中央的<br>\n处刑台上渗出了赤黑色的液体。",
  "0205Adv05_Sherry001": "唔唔。<br>\n那不是……血吗？",
  "0205Adv05_Narrative005": "雪莉透过放大镜凝视着远处的液体。",
  "0205Adv05_Narrative006": "就在那一瞬间。",
  "0205Adv05_Narrative007": "审判庭中央像是被撕开了一个大洞，<br>\n赤黑色的液体源源不断地涌出。",
  "0205Adv05_Alisa001": "喂喂喂……！<br>\n这是什么鬼，没听说过啊！",
  "0205Adv05_Narrative008": "血柱喷涌而上。",
  "0205Adv05_Narrative009": "不久，液体如同洪水般<br>\n开始充斥整个审判庭。",
  "0205Adv05_Hanna001": "等、等等，这、<br>\n这样下去不妙吧！？",
  "0205Adv05_Leia001": "没、没事的。我会保护大家的……！",
  "0205Adv05_Narrative010": "少女们还在战栗不已，<br>\n终于血色喷泉的势头开始有了减弱的迹象。",
  "0205Adv05_AnAn001": "……里面，有个人。",
  "0205Adv05_Narrative011": "在逐渐减弱的血柱缝隙中，<br>\n隐约可见某种【轮廓】。",
  "0205Adv05_Narrative012": "那是一团闪着粘稠光泽、<br>\n约一人大小的肉块。",
  "0205Adv05_Meruru001": "啊啊……大魔女大人。<br>\n终于……",
  "0205Adv05_Meruru002": "——终于，与您相会了……！",
  "0205Adv05_Narrative013": "就在那一刻。",
  "0205Adv05_Narrative014": "枪声骤然响起。",
  "0205Adv05_Narrative015": "子弹射向肉块，<br>\n却在空中化作火花，凭空消失了。",
  "0205Adv05_Nanoka001": "……！<br>\n子弹在空中燃尽了？",
  "0205Adv05_Miria001": "等、等等，别乱来啊！<br>\n那东西不知道会对我们做什么！<br>\n大、大叔我受不了了，好可怕！！",
  "0205Adv05_Unknown001": "这是魔女们流的血。",
  "0205Adv05_Unknown002": "也是我们将继续播下的种子……<br>\n魔女的因子。",
  "0205Adv05_Noah001": "有什么东西在说话？",
  "0205Adv05_Narrative016": "随着诺亚一句疑问……",
  "0205Adv05_Narrative017": "包裹着肉块的血液，<br>\n忽地化作铺天盖地的红蝶剥落下来。",
  "0205Adv05_Margo001": "那就是大魔女……<br>\n长得还挺可爱的嘛。",
  "0205Adv05_Narrative018": "我偷偷瞥了眼身旁的艾玛。",
  "0205Adv05_Ema001": "……小……雪。",
  "0205Adv05_Narrative019": "终于重逢……却又不愿相信。<br>\n艾玛脸上浮现出复杂纠葛的神情，<br>\n轻轻唤出旧友的名字。",
  "0205Adv05_Yuki001": "我的复活，即意味着绝望……<br>\n你们到底在指望什么呢？",
  "0205Adv05_Yuki002": "不可能会有好结局的。",
  "0205Adv05_Narrative020": "大魔女——雪，嫣然一笑。",
  "0205Adv05_Yuki003": "来吧，成为我的共犯吧。"
}
