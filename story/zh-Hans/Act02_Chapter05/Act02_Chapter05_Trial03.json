    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（……蕾雅的行事方式还真是万年不变啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro002"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "（不过，我已经十分了解她的为人了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro003"]}},
