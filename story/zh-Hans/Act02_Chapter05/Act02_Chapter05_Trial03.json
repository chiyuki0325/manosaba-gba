    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "我只是想弄清真相而已。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.8"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 205, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "为了找出潜藏在所有人当中的魔女，<br>\n我希望进行平等的讨论。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 208, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.7"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 209, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "为此，<br>\n我需要得到大家的协助。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 212, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 213, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "能不能请你不要随意把人当作幕后黑手，<br>\n妨碍大家的团结呢？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 216, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 217, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "我、我也只是在号召大家团结啊！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia009"]}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 221, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "可是你<br>\n明显很异常啊，希罗……！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia010"]}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Surprised_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 225, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "明明一副知道很多事情的样子，<br>\n却不见有什么说明，自顾自地推进讨论——", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia011"]}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 229, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "怀疑你是幕后黑手也很正常！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia012"]}},
    {"op": "Damage", "line": 232, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 235, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "（就算坦白说明，<br>\n　以目前的状态而言，她们也不太可能会信……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro010"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 238, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "（……该怎么做才能<br>\n　对蕾雅的心灵造成伤害呢）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro011"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 241, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "（……和蕾雅相处至今，<br>\n　我注意到了一些事）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro012"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 244, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "（她是为了让自己受到瞩目而行动的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 248, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "（如果能指出潜藏在她内心深处的自我中心主义，<br>\n　或许就——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro014"]}},
    {"op": "GotoModified", "line": 252, "indent": 0, "params": {"Path": ".Judge10-3-1"}},
    {"op": "label", "name": "Judge10-3-4", "line": 256, "indent": 0},
    {"op": "Gosub", "line": 258, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 259, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "Gosub", "line": 260, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 263, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "（……没错，蕾雅的正义感是真实的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro015"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 266, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "（但……正因如此，<br>\n　她的正义感很有可能就是她的压力来源）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 269, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 270, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "（虽然很对不住蕾雅……<br>\n　就让我瞄准这点发起进攻吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 273, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 274, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "……蕾雅，你是个<br>\n只考虑自己的伪善者。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 277, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Surprised_Open01,Angle01/Facial/Mouth>Mouth_Fearful_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 278, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "你、你突然在说什么……！？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia013"]}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 282, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "一出现问题，你就只顾着独善其身……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.8"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 286, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "你根本就没打算守护任何人。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro020"]}},
    {"op": "ModifyCharacterExtended", "line": 289, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Angry_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 290, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "……为什么。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia014"]}},
    {"op": "ModifyCharacterExtended", "line": 293, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 294, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "为什么，要说这么过分的话？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia015"]}},
    {"op": "ModifyCharacterExtended", "line": 297, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Downcast_Open,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 298, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "我……在集体中遇到问题时，<br>\n都是挺身守护大家，和大家一起解决的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia016"]}},
    {"op": "ModifyCharacterExtended", "line": 301, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 302, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "制作舞台剧的时候也是，<br>\n我一直以来都是和团队——也就是参加成员们共同进步的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia017"]}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL8,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 306, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "我目前在演艺圈的地位，就是最好的证明。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia018"]}},
    {"op": "ModifyCharacterExtended", "line": 309, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL8,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 310, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "所以我能确信地说，<br>\n能守护大家的……只有我！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia019"]}},
    {"op": "Damage", "line": 313, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 315, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.13"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 316, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 317, "indent": 0, "params": {"Text": "（反而让她产生确信了……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro021"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 321, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "（……该怎么做才能<br>\n　对蕾雅的心灵造成伤害呢）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 324, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 325, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "（……和蕾雅相处至今，<br>\n　我注意到了一些事）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro023"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 328, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "（她是为了让自己受到瞩目而行动的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro024"]}},
    {"op": "ModifyCharacterExtended", "line": 331, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 332, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "（如果能指出潜藏在她内心深处的自我中心主义，<br>\n　或许就——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro025"]}},
    {"op": "GotoModified", "line": 336, "indent": 0, "params": {"Path": ".Judge10-3-1"}},
