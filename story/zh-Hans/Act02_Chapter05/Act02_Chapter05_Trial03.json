    {"op": "Gosub", "line": 352, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 354, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 355, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "你在说谎。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro026"]}},
    {"op": "PlayBgm", "line": 359, "indent": 0, "params": {"BgmPath": "Bgm_45_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 361, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "所谓的守护同伴，<br>\n不过是你找来的冠冕堂皇的理由罢了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro027"]}},
    {"op": "PlaySfxModified", "line": 365, "indent": 0, "params": {"SfxPath": "Sfx_Common_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 367, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Fearful_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 368, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 369, "indent": 0, "params": {"Text": "你、你说什么！？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia020"]}},
    {"op": "ModifyCharacterExtended", "line": 371, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 372, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 373, "indent": 0, "params": {"Text": "你真正想守护的，<br>\n是自己的地位和面子。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro028"]}},
    {"op": "ModifyCharacterExtended", "line": 375, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.8"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 376, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 377, "indent": 0, "params": {"Text": "你只是单纯想引人注目……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro029"]}},
    {"op": "ModifyCharacterExtended", "line": 379, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.11"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 380, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 381, "indent": 0, "params": {"Text": "你就是个渴望受认可的怪物。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro030"]}},
    {"op": "StopBgm", "line": 383, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 385, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 386, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 387, "indent": 0, "params": {"Text": "什、什么……！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia021"]}},
    {"op": "PlaySfxModified", "line": 390, "indent": 0, "params": {"SfxPath": "Sfx_Common_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 394, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 395, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 396, "indent": 0, "params": {"Text": "你凭什么，这么说！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Leia022"]}},
    {"op": "ModifyCharacterExtended", "line": 398, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.25"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 399, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 400, "indent": 0, "params": {"Text": "（光看她反应，<br>\n　我就知道我戳中她的弱点了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro031"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 402, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "（只不过我得注意不能过于拖沓，<br>\n　以免打断了讨论）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro032"]}},
    {"op": "ModifyCharacterExtended", "line": 405, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 406, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 407, "indent": 0, "params": {"Text": "（我必须震撼她的深层内心……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro033"]}},
    {"op": "ModifyCharacterExtended", "line": 409, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 410, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 411, "indent": 0, "params": {"Text": "（抱歉，就让我尽快剥掉<br>\n　你虚伪的面具吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro034"]}},
