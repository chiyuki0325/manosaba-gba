    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 37, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 38, "indent": 0, "params": {"Text": "说到底，我根本就没听明白，<br>\n你说的那“魔女”<br>\n究竟是怎么一回事！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial03_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Surprised1,ArmR3,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 41, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 42, "indent": 0, "params": {"Text": "……可、可是<br>\n能使出魔法的人<br>\n的确存在啊？<br>\n比如我<br>\n就是……", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Middle,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 45, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 46, "indent": 0, "params": {"Text": "那、那<br>\n我也一样……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial03_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 49, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 50, "indent": 0, "params": {"Text": "……再说了，<br>\n什么逃离这座监牢，<br>\n根本就是希罗你单方面的说法！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial03_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR10,ArmL8,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 53, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 54, "indent": 0, "params": {"Text": "说不定希罗你才是<br>\n<link=\"Objection_02_05_03_01\">真正的幕后黑手</link>，<br>\n不是吗！？", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial03_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR6,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 57, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 58, "indent": 0, "params": {"Text": "……我、我觉得……", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 61, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 62, "indent": 0, "params": {"Text": "希罗她才，<br>\n不会做那种坏事……！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 65, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 66, "indent": 0, "params": {"Text": "就算<br>\n她真的做了……<br>\n我也觉得她<br>\n一定有相应的<br>\n正当理由……", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.25"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 69, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 70, "indent": 0, "params": {"Text": "（艾玛……）", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial03_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Fearful_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 73, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 74, "indent": 0, "params": {"Text": "什么叫【正当理由】……？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR9,ArmL8,Angle01/Facial/Eyes>Eyes_Pensive_Closed,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 77, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 78, "indent": 0, "params": {"Text": "我也有正当理由啊！<br>\n我的<link=\"Objection_02_05_03_02\">目的</link>就是<br>\n拯救大家啊！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR9,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Open01,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 81, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 82, "indent": 0, "params": {"Text": "只有我<br>\n<link=\"Objection_02_05_03_03\">能守护</link><br>\n在场的所有人……！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Leia007"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 85, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 86, "indent": 0, "params": {"Text": "我一定能守护大家！<br>\n相信我吧！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial03_Leia008"]}},
