    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "（……当然也包括她隐藏起来的真实想法）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial03_Hiro004"]}},
