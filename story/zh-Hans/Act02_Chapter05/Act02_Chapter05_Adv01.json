    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook"}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-5-0", "line": 8, "indent": 0},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_1_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 5.0}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "有谁……能听见我的声音吗？", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown001"]}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"Scale": [1.5], "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "34_1"}},
    {"op": "ModifyBackgroundExtended", "line": 21, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 22, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "你不但曾经目睹了少女们引发的悲剧，<br>\n还拥有干涉这个世界的力量。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "拜托了……<br>\n请你，救救她吧。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown003"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "我的声音已经，连她也无法听到……<br>\n更不用说那些被聚集到宅邸的少女们了。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown004"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "希望你能帮我转告她，<br>\n我们这些人……<br>\n事到如今已经不重要了。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown005"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "无论如何，我们的存续<br>\n本就已时日无多……", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown006"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "这座封闭的岛屿，是我们发展的尽头。<br>\n依靠魔法得来的繁荣与文明，<br>\n也早已停滞不前……", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown007"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "照这样下去，<br>\n未来只会酿成不吉的淤积……<br>\n这是预言告诉我们的结果。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown008"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "我们这些岛上的大魔女之间<br>\n也曾无数次争论，要如何避免毁灭的到来。<br>\n可是，我们终究没有达成共识……", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_Unknown009"]}},
    {"op": "ModifyBackgroundExtended", "line": 48, "indent": 0, "params": {"TintColor": "#ffffff22", "Duration": 5.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "毕竟事情是在那样的情况下发生的……", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch001"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "我们已经接受了——<br>\n灭亡就是我们的宿命。", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch002"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "所以，我们并不期望复仇。", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch003"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "我只希望她……<br>\n能在和人类共存中，<br>\n找到属于自己的幸福。", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch004"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "……那孩子明明是我们魔女之中最年幼的，<br>\n我们却让她背负起这一切，<br>\n只因为她是最后一任大魔女……", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch005"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "可我依然希望她……能过得幸福。", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch006"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "所以……<br>\n能听到我声音的人，也就是你。", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch007"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "我想请你向她转达……<br>\n她不必再背负所谓“生为魔女的命运”了。", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch008"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "求求你了——<br>\n救救她吧……！", "AuthorId": "BigWitch", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv01_BigWitch009"]}},
    {"op": "ResetText", "line": 69, "indent": 0, "params": {}},
