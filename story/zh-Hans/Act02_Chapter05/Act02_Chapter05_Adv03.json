  "language": "zh-Hans",
  "path": "Act02_Chapter05/Act02_Chapter05_Adv03",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-5-2", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 9, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 11, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 13, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "进入会客厅后没过多久，<br>\n少女们似乎就全都到齐了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative001"]}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "看守像堵住去路一样，牢牢把守出入口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative002"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "对我来说，这已是第三次见到的场景，<br>\n但对其他少女们而言，却是第一次经历。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative003"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "而且在她们的认知中，<br>\n怪物大概不止一个了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative004"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "她们无一不面露困惑，<br>\n脸上写满了恐惧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative005"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "——包括我在内，总共十三名预备魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "我在其中认出了我要找的少女，<br>\n快步朝她走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative007"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "见我有所动作，<br>\n有人发出了小声的尖叫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative008"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "在众人屏息凝视之下——<br>\n我站到了冰上梅露露面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Normal1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "欸……？啊、啊、那个……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Meruru001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "我不容分说，<br>\n一把揪住了梅露露的衣襟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 39, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, 20.0], "IdAndAppearance": "Meruru"}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, 20.0], "IdAndAppearance": "Meruru.Fearful1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "呃……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Meruru002"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "……冰上梅露露，我有话对你说。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, 20.0], "IdAndAppearance": "Meruru.Surprised1"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "噫、啊……？<br>\n为什么，会知道我的名字……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, 20.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "住手，你这怪物！不准碰她！<br>\n大家退到我身后！这家伙由我来收拾！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Leia001"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Leia.Angry1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [40.0, 50.0], "IdAndAppearance": "Meruru.Pensive1"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "最先作出反应的，<br>\n不出所料，是蕾雅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative011"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（还是这么爱出风头……<br>\n　不过，居然叫我怪物吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro002"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "她拔出刺剑，剑尖直指向我。<br>\n眼神中写满了明确的厌恶与敌意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative012"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "胸口一紧，有些难受。<br>\n但我强行驱散了这种感伤。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative013"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "现在必须不顾一切地压抑所有感情，<br>\n尽快推进计划才行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative014"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "（趁我还能保持理智……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Meruru.Pensive1"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "我无视用剑尖指着我的蕾雅，<br>\n再次转向梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative015"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "我要求立刻开庭，进行魔女审判！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Meruru.Normal1"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "欸、啊、为、为什么你连魔女审判的事都知道……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Meruru004"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "我的魔法是【死亡回溯】。<br>\n我是带着一切的答案回到今天的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro005"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "而且我已经知道如何才能见到大魔女。<br>\n只说到这里，你就该明白了吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Meruru.Surprised1"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "梅露露的眼睛倏地睁大了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative016"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "能、能见到大魔女大人……？<br>\n【死亡回溯】魔法……确、确实，如果是这样的话，<br>\n那你找到了各种答案，并且人在这里，也不是不可能……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Meruru005"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "你至今为止所做的一切，<br>\n我可以暂且不予追究。协助我。<br>\n这样我就会让你见到大魔女。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Meruru.Pensive1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "明、明白了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Meruru006"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Meruru.Surprised1"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "你们在那嘀嘀咕咕什么！<br>\n你的对手是我，怪物！一决高下吧！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Surprised1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "等、等等！<br>\n希罗和我是从小一起长大的好朋友，<br>\n那个，她不是什么怪物……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Ema001"]}},
    {"op": "HideActors", "line": 115, "indent": 0, "params": {"ActorIds": ["Meruru", "Leia-Middle"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR10,ArmL11"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "呃……虽然不清楚你是哪位，<br>\n但你的意思是，你和怪物一起长大吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "不、不是啦，虽然她现在长这样，<br>\n但希罗才不是怪物……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Ema002"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "够了，那边那个王子，<br>\n要打就快点把那怪物解决掉啦！<br>\n那边那个拿枪的女的上也行！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Coco001"]}},
    {"op": "HideAllCharacters", "line": 129, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 130, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Surprised1,ArmR2,ArmL2"}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Nanoka.Normal1"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "呀啊！真的耶，<br>\n你为什么会拿着枪啊！？<br>\n你这是非法持有枪械……！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Miria001"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "……她到底是不是敌人，<br>\n我还无法判断。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR6"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "哎呀，真巧。我们看法一致呢。<br>\n总觉得她不像是我们应该讨伐的怪物呢。<br>\n……为什么呢？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Margo001"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "那种事怎样都好！<br>\n总之先给我解释清楚！你到底想拿我们怎么办！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "没、没错哇！<br>\n看你好像知道些内情，<br>\n请你给我们解释一下！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Noah.Smile1,ArmL2"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "哼哼哼～哼♪", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Noah001"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "诺亚正在把玩着会客厅的摆设……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative017"]}},
    {"op": "HideAllCharacters", "line": 160, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "AnAn.Fearful1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "这一定是梦这一定是梦这一定是梦……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_AnAn001"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "安安则在逃避现实。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative018"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "……唉。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro008"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "事态变得极其混乱，<br>\n我轻轻叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative019"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "（……你们真的，一点都没变啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro009"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "我转身面对少女们，<br>\n从口袋里取出手机，高高举起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "CreatureHiro.10"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "检查一下你们口袋里的手机。<br>\n打开叫做【魔女图鉴】的APP，<br>\n就能知道彼此的名字。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro010"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "总之大家先互相记住名字吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 185, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 186, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "少女们虽然保持着警戒，<br>\n但还是乖乖地从自己的口袋里拿出了手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative021"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "她们打开【魔女图鉴】，<br>\n逐一确认彼此的名字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative022"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "就在这时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative023"]}},
    {"op": "PlayBgm", "line": 194, "indent": 0, "params": {"BgmPath": "Bgm_26_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 197, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 198, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "传来了猫头鹰振翅的声音，<br>\n典狱长出现了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "啊……好多人……<br>\n呃，自我介绍一下……<br>\n我是受命管理这座宅邸的可爱猫头鹰，典狱长……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Warden001"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "……因为下班时间快到了……<br>\n我就抓紧时间开始说明咯……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Warden002"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "不必解释了。<br>\n我们现在就要召开魔女审判。<br>\n你立刻给我准备开庭。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro012"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "哈？……那个，不知怎的好像已经魔女化了的这位……<br>\n呃，你是二阶堂希罗小姐，对吧？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Warden003"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "说要召开魔女审判，这到底是……？<br>\n是谁批准的？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Warden004"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "典狱长困惑地歪着头，<br>\n瞥了一眼梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative025"]}},
    {"op": "HideAllCharacters", "line": 216, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Normal1"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "梅露露似乎有些犹豫，<br>\n但还是点了点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative026"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "我、我批准。可以召开魔女审判。<br>\n请开始准备吧，典狱长先生。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Meruru007"]}},
    {"op": "HideAllCharacters", "line": 223, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "可、可是现在还没有发生任何凶杀案啊……？<br>\n一个人都还没死，<br>\n到底要审判谁啊？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Warden005"]}},
    {"op": "HideAllCharacters", "line": 228, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "CreatureHiro.7"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "……啧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro013"]}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "难道不是有许多、许许多多的少女<br>\n在这座监牢里牺牲了吗！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro014"]}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "那些死去的、堕为魔女的、<br>\n无数少女们……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro015"]}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "以及作为新的牺牲者的我们，<br>\n这是为了我们和她们举行的魔女审判！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro016"]}},
    {"op": "HideAllCharacters", "line": 240, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "即使告诫自己不要情绪激动，<br>\n却仍忍不住高声怒喝，<br>\n怒目瞪向典狱长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "知、知道啦知道啦，<br>\n别那么生气嘛。<br>\n反正都下命令了，我去准备就是了……哎哟真是的……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Warden006"]}},
    {"op": "PlaySfxModified", "line": 249, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 251, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 252, "indent": 0, "params": {}},
    {"op": "Wait", "line": 253, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "典狱长逃也似的飞走了。<br>\n我捂着胸口，单膝跪地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative028"]}},
    {"op": "PlaySfxModified", "line": 258, "indent": 0, "params": {"SfxPath": "Sfx_162", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 259, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 260, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 261, "indent": 0, "params": {"TintColor": "#550000CC", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 262, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 263, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 264, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "哈啊、哈啊、哈啊……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Ema.Pensive1,ArmR1"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "希罗……这到底，是怎么回事……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Ema003"]}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "艾玛来到我身边，<br>\n伸出了手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative029"]}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "我无视她向我伸出的手，踉跄着站起身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Narrative030"]}},
    {"op": "HideAllCharacters", "line": 278, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "……都叫你别管我了。<br>\n总之先去审判庭。有话之后再说。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Adv03_Hiro018"]}},
    {"op": "Gosub", "line": 282, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 284, "indent": 0, "params": {"Path": "Act02_Chapter05/Act02_Chapter05_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0205Adv03_Narrative001": "进入会客厅后没过多久，<br>\n少女们似乎就全都到齐了。",
  "0205Adv03_Narrative002": "看守像堵住去路一样，牢牢把守出入口。",
  "0205Adv03_Narrative003": "对我来说，这已是第三次见到的场景，<br>\n但对其他少女们而言，却是第一次经历。",
  "0205Adv03_Narrative004": "而且在她们的认知中，<br>\n怪物大概不止一个了。",
  "0205Adv03_Narrative005": "她们无一不面露困惑，<br>\n脸上写满了恐惧。",
  "0205Adv03_Narrative006": "——包括我在内，总共十三名预备魔女。",
  "0205Adv03_Narrative007": "我在其中认出了我要找的少女，<br>\n快步朝她走去。",
  "0205Adv03_Narrative008": "见我有所动作，<br>\n有人发出了小声的尖叫。",
  "0205Adv03_Narrative009": "在众人屏息凝视之下——<br>\n我站到了冰上梅露露面前。",
  "0205Adv03_Meruru001": "欸……？啊、啊、那个……？",
  "0205Adv03_Narrative010": "我不容分说，<br>\n一把揪住了梅露露的衣襟。",
  "0205Adv03_Meruru002": "呃……！",
  "0205Adv03_Hiro001": "……冰上梅露露，我有话对你说。",
  "0205Adv03_Meruru003": "噫、啊……？<br>\n为什么，会知道我的名字……？",
  "0205Adv03_Leia001": "住手，你这怪物！不准碰她！<br>\n大家退到我身后！这家伙由我来收拾！",
  "0205Adv03_Narrative011": "最先作出反应的，<br>\n不出所料，是蕾雅。",
  "0205Adv03_Hiro002": "（还是这么爱出风头……<br>\n　不过，居然叫我怪物吗）",
  "0205Adv03_Narrative012": "她拔出刺剑，剑尖直指向我。<br>\n眼神中写满了明确的厌恶与敌意。",
  "0205Adv03_Narrative013": "胸口一紧，有些难受。<br>\n但我强行驱散了这种感伤。",
  "0205Adv03_Narrative014": "现在必须不顾一切地压抑所有感情，<br>\n尽快推进计划才行。",
  "0205Adv03_Hiro003": "（趁我还能保持理智……）",
  "0205Adv03_Narrative015": "我无视用剑尖指着我的蕾雅，<br>\n再次转向梅露露。",
  "0205Adv03_Hiro004": "我要求立刻开庭，进行魔女审判！",
  "0205Adv03_Meruru004": "欸、啊、为、为什么你连魔女审判的事都知道……？",
  "0205Adv03_Hiro005": "我的魔法是【死亡回溯】。<br>\n我是带着一切的答案回到今天的。",
  "0205Adv03_Hiro006": "而且我已经知道如何才能见到大魔女。<br>\n只说到这里，你就该明白了吧？",
  "0205Adv03_Narrative016": "梅露露的眼睛倏地睁大了。",
  "0205Adv03_Meruru005": "能、能见到大魔女大人……？<br>\n【死亡回溯】魔法……确、确实，如果是这样的话，<br>\n那你找到了各种答案，并且人在这里，也不是不可能……",
  "0205Adv03_Hiro007": "你至今为止所做的一切，<br>\n我可以暂且不予追究。协助我。<br>\n这样我就会让你见到大魔女。",
  "0205Adv03_Meruru006": "明、明白了……",
  "0205Adv03_Leia002": "你们在那嘀嘀咕咕什么！<br>\n你的对手是我，怪物！一决高下吧！",
  "0205Adv03_Ema001": "等、等等！<br>\n希罗和我是从小一起长大的好朋友，<br>\n那个，她不是什么怪物……！",
  "0205Adv03_Sherry001": "呃……虽然不清楚你是哪位，<br>\n但你的意思是，你和怪物一起长大吗？",
  "0205Adv03_Ema002": "不、不是啦，虽然她现在长这样，<br>\n但希罗才不是怪物……",
  "0205Adv03_Coco001": "够了，那边那个王子，<br>\n要打就快点把那怪物解决掉啦！<br>\n那边那个拿枪的女的上也行！",
  "0205Adv03_Miria001": "呀啊！真的耶，<br>\n你为什么会拿着枪啊！？<br>\n你这是非法持有枪械……！",
  "0205Adv03_Nanoka001": "……她到底是不是敌人，<br>\n我还无法判断。",
  "0205Adv03_Margo001": "哎呀，真巧。我们看法一致呢。<br>\n总觉得她不像是我们应该讨伐的怪物呢。<br>\n……为什么呢？",
  "0205Adv03_Alisa001": "那种事怎样都好！<br>\n总之先给我解释清楚！你到底想拿我们怎么办！",
  "0205Adv03_Hanna001": "没、没错哇！<br>\n看你好像知道些内情，<br>\n请你给我们解释一下！",
  "0205Adv03_Noah001": "哼哼哼～哼♪",
  "0205Adv03_Narrative017": "诺亚正在把玩着会客厅的摆设……",
  "0205Adv03_AnAn001": "这一定是梦这一定是梦这一定是梦……",
  "0205Adv03_Narrative018": "安安则在逃避现实。",
  "0205Adv03_Hiro008": "……唉。",
  "0205Adv03_Narrative019": "事态变得极其混乱，<br>\n我轻轻叹了口气。",
  "0205Adv03_Hiro009": "（……你们真的，一点都没变啊）",
  "0205Adv03_Narrative020": "我转身面对少女们，<br>\n从口袋里取出手机，高高举起。",
  "0205Adv03_Hiro010": "检查一下你们口袋里的手机。<br>\n打开叫做【魔女图鉴】的APP，<br>\n就能知道彼此的名字。",
  "0205Adv03_Hiro011": "总之大家先互相记住名字吧。",
  "0205Adv03_Narrative021": "少女们虽然保持着警戒，<br>\n但还是乖乖地从自己的口袋里拿出了手机。",
  "0205Adv03_Narrative022": "她们打开【魔女图鉴】，<br>\n逐一确认彼此的名字。",
  "0205Adv03_Narrative023": "就在这时——",
  "0205Adv03_Narrative024": "传来了猫头鹰振翅的声音，<br>\n典狱长出现了。",
  "0205Adv03_Warden001": "啊……好多人……<br>\n呃，自我介绍一下……<br>\n我是受命管理这座宅邸的可爱猫头鹰，典狱长……",
  "0205Adv03_Warden002": "……因为下班时间快到了……<br>\n我就抓紧时间开始说明咯……",
  "0205Adv03_Hiro012": "不必解释了。<br>\n我们现在就要召开魔女审判。<br>\n你立刻给我准备开庭。",
  "0205Adv03_Warden003": "哈？……那个，不知怎的好像已经魔女化了的这位……<br>\n呃，你是二阶堂希罗小姐，对吧？",
  "0205Adv03_Warden004": "说要召开魔女审判，这到底是……？<br>\n是谁批准的？",
  "0205Adv03_Narrative025": "典狱长困惑地歪着头，<br>\n瞥了一眼梅露露。",
  "0205Adv03_Narrative026": "梅露露似乎有些犹豫，<br>\n但还是点了点头。",
  "0205Adv03_Meruru007": "我、我批准。可以召开魔女审判。<br>\n请开始准备吧，典狱长先生。",
  "0205Adv03_Warden005": "可、可是现在还没有发生任何凶杀案啊……？<br>\n一个人都还没死，<br>\n到底要审判谁啊？",
  "0205Adv03_Hiro013": "……啧。",
  "0205Adv03_Hiro014": "难道不是有许多、许许多多的少女<br>\n在这座监牢里牺牲了吗！",
  "0205Adv03_Hiro015": "那些死去的、堕为魔女的、<br>\n无数少女们……",
  "0205Adv03_Hiro016": "以及作为新的牺牲者的我们，<br>\n这是为了我们和她们举行的魔女审判！！",
  "0205Adv03_Narrative027": "即使告诫自己不要情绪激动，<br>\n却仍忍不住高声怒喝，<br>\n怒目瞪向典狱长。",
  "0205Adv03_Warden006": "知、知道啦知道啦，<br>\n别那么生气嘛。<br>\n反正都下命令了，我去准备就是了……哎哟真是的……",
  "0205Adv03_Narrative028": "典狱长逃也似的飞走了。<br>\n我捂着胸口，单膝跪地。",
  "0205Adv03_Hiro017": "哈啊、哈啊、哈啊……",
  "0205Adv03_Ema003": "希罗……这到底，是怎么回事……？",
  "0205Adv03_Narrative029": "艾玛来到我身边，<br>\n伸出了手。",
  "0205Adv03_Narrative030": "我无视她向我伸出的手，踉跄着站起身来。",
  "0205Adv03_Hiro018": "……都叫你别管我了。<br>\n总之先去审判庭。有话之后再说。"
}
}
