    {"op": "HidePerspectiveStageScreen", "line": 42, "indent": 0, "params": {"Index": 1, "Reset": 1}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 45, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 46, "indent": 0, "params": {"Text": "如果因绝望而放弃，<br>\n那么，在那一瞬间<br>\n所有的可能性都会破灭。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 49, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 50, "indent": 0, "params": {"Text": "但是，<br>\n只要朝着那<br>\n微小的可能性前进，<br>\n希望就不会破灭……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 53, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 54, "indent": 0, "params": {"Text": "想要放弃的话，<br>\n等你确定一切都<br>\n无法挽回之后，<br>\n再说放弃也不迟……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.7"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 57, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 58, "indent": 0, "params": {"Text": "这才是【正确的道路】！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR6,ArmL10,Eyes1_Flushed_Open1,Mouth1_Normal_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 61, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 62, "indent": 0, "params": {"Text": "……那，<br>\n请你告诉我<br>\n具体的方法。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR6,ArmL10,Eyes1_Flushed_Open1,Mouth1_Angry_Closed2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 65, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 66, "indent": 0, "params": {"Text": "你说要去除<br>\n魔女因子……", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka002"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Flushed_Open1,Mouth1_Angry_Closed2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 69, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 70, "indent": 0, "params": {"Text": "这真的<br>\n有办法做到吗？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka003"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 73, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 74, "indent": 0, "params": {"Text": "……按照梅露露所说，<br>\n大魔女将自身<br>\n转化为了魔女因子。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 77, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 78, "indent": 0, "params": {"Text": "那么，<br>\n只要让大魔女<br>\n再次现身于世，<br>\n那构成她本质的魔女因子<br>\n应该就会得到复原。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.7"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 81, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 82, "indent": 0, "params": {"Text": "其最终结果，<br>\n你的姐姐是有可能<br>\n从【残骸】恢复原状的……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR3,ArmL8,Eyes1_Normal_Closed1,Mouth1_Pensive_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 85, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 86, "indent": 0, "params": {"Text": "【召集完成魔女化的少女，<br>\n令大魔女复活】……", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka004"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR6,ArmL10,Eyes1_Normal_Open3,Mouth1_Pensive_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 89, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 90, "indent": 0, "params": {"Text": "……简直就是邪教仪式呢。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka005"]}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR6,ArmL10,Eyes1_Normal_Open3,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 93, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 94, "indent": 0, "params": {"Text": "……这可是<br>\n连B级恐怖片<br>\n都懒得演的<link=\"Objection_02_05_11_01\">老套</link>剧情啊。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka006"]}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR1,ArmL1,Eyes1_Normal_Open3,Mouth1_Normal_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 97, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 98, "indent": 0, "params": {"Text": "你也不过是受那个所谓的大魔女<br>\n<link=\"Objection_02_05_11_02\">操控</link>的提线木偶罢了，<br>\n不是吗？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka007"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 101, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 102, "indent": 0, "params": {"Text": "……大魔女<br>\n的确图谋着<br>\n向人类<br>\n复仇。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 105, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 106, "indent": 0, "params": {"Text": "即便如此，<br>\n我们想要得救的话，<br>\n也只能选这条路了……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial11_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR1,ArmL10,Eyes1_Angry_Open1,Mouth1_Normal_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 109, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 110, "indent": 0, "params": {"Text": "那复活了大魔女又怎样？<br>\n难道你打算<link=\"Objection_02_05_11_03\">求</link>她发慈悲吗？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka008"]}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR1,ArmL10,Eyes1_Pensive_Open1,Mouth1_Normal_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 113, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 114, "indent": 0, "params": {"Text": "你所指引的道路……<br>\n只是性质恶劣的幻觉。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial11_Nanoka009"]}},
