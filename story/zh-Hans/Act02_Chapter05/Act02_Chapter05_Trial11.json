    {"op": "Gosub", "line": 37, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginDebate-First"}},
    {"op": "Gosub", "line": 38, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginDebate-Effect"}},
