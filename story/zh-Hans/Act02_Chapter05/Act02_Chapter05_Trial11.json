    {"op": "label", "name": "Judge10-11-3", "line": 222, "indent": 0},
    {"op": "Gosub", "line": 224, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 225, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "Gosub", "line": 226, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 229, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "正因如此，<br>\n才有可信度。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro014"]}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 233, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "流传下来的故事，都有其原型……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 237, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "那么【老套】且广为人知的故事类型，<br>\n难道不是更贴近事实吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 240, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 241, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "我认为值得一试。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open5,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 245, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "……假设仪式真的成功了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka010"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open5,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 249, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "按照老套的剧情展开，<br>\n接下来我们就会被当作祭品<br>\n丢掉小命了，难道不是吗？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka011"]}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open5,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 253, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "……希望和乐观根本是两码事。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka012"]}},
    {"op": "Damage", "line": 256, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 259, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "（看来我没能向她展现出希望）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 263, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "（我得首先说服奈叶香，<br>\n　让她敞开心扉）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 267, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "（为此我需要展示的希望……<br>\n　只能是与她目的一致的那件事了！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro020"]}},
    {"op": "GotoModified", "line": 270, "indent": 0, "params": {"Path": ".Judge10-11-1"}},
    {"op": "label", "name": "Judge10-11-4", "line": 274, "indent": 0},
    {"op": "Gosub", "line": 276, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 277, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "Gosub", "line": 278, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.18"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 281, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "……一切都是我自己作出的决定。<br>\n都是为了拯救大家。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 284, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.18"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 285, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "我并没有受操纵。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 288, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR2,ArmL9,Eyes1_Normal_Open2,Mouth1_Surprised_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 289, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "……我们身上<br>\n携带着大魔女的因子，没错吧？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka013"]}},
    {"op": "ModifyCharacterExtended", "line": 292, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR2,ArmL9,Eyes1_Normal_Open4,Mouth1_Surprised_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 293, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "既然如此……<br>\n我们根本无从判断，到底有哪些部分是出于自己的意志。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka014"]}},
    {"op": "ModifyCharacterExtended", "line": 296, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR2,ArmL9,Eyes1_Angry_Open1,Mouth1_Flushed_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 297, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "说不定大魔女只是玩心大发，<br>\n放任我们自由行动而已。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka015"]}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR2,ArmL9,Eyes1_Angry_Open1,Mouth1_Flushed_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 301, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "同样，她也有可能利用你的意志，<br>\n图谋着自己的复活。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka016"]}},
    {"op": "ModifyCharacterExtended", "line": 304, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR2,ArmL10,Eyes1_Angry_Open1,Mouth1_Flushed_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 305, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "有谁能保证<br>\n你现在还拥有着理智呢？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka017"]}},
    {"op": "Damage", "line": 308, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 310, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 311, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "（……看来就算我主张【我思故我在】，<br>\n　她也不会善罢甘休了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro023"]}},
    {"op": "ModifyCharacterExtended", "line": 314, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 315, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "（我得首先说服奈叶香，<br>\n　让她敞开心扉）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro024"]}},
    {"op": "ModifyCharacterExtended", "line": 318, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 319, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "（为此我需要展示的希望……<br>\n　只能是与她目的一致的那件事了！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro025"]}},
    {"op": "GotoModified", "line": 322, "indent": 0, "params": {"Path": ".Judge10-11-1"}},
    {"op": "label", "name": "Judge10-11-2", "line": 328, "indent": 0},
    {"op": "Gosub", "line": 330, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-First"}},
    {"op": "ChangeTrialPauseMode", "line": 331, "indent": 0, "params": {"Enable": 0, "ProcessTimer": 0}},
    {"op": "HideUI", "line": 332, "indent": 0, "params": {"UINames": ["DebateUI"], "AllowToggle": 0}},
    {"op": "ShowUI", "line": 333, "indent": 0, "params": {"UINames": ["ControlPanel"]}},
    {"op": "StopBgm", "line": 335, "indent": 0, "params": {}},
    {"op": "GosubToObjectionCutIn", "line": 336, "indent": 0, "params": {"CutInKind": "CreatureHiro", "Index": 2}},
    {"op": "Gosub", "line": 337, "indent": 0, "params": {"Path": "System/System_Subroutine.EndDebate-Last"}},
    {"op": "PlayBgm", "line": 342, "indent": 0, "params": {"BgmPath": "Bgm_39_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 343, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 344, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "大魔女……由我来打倒。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro026"]}},
    {"op": "PlaySfxModified", "line": 348, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 350, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR6,ArmL8,Eyes1_Confused_Open1,Mouth1_Cry_Closed1,Sweat1_1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 351, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 352, "indent": 0, "params": {"Text": "……！", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka018"]}},
    {"op": "ModifyCharacterExtended", "line": 354, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR6,ArmL8,Eyes1_Confused_Open1,Mouth1_Cry_Closed1,Sweat1_1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 355, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "还以为你有什么高招呢……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka019"]}},
    {"op": "ModifyCharacterExtended", "line": 358, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR1,ArmL3,Eyes1_Normal_Open4,Mouth1_Pensive_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 359, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "记得你的魔法是【死亡回溯】<br>\n……没错吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka020"]}},
    {"op": "ModifyCharacterExtended", "line": 362, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR1,ArmL3,Eyes1_Normal_Open5,Mouth1_Normal_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 363, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "那你打算怎么用它打倒大魔女？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka021"]}},
    {"op": "ModifyCharacterExtended", "line": 366, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 367, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "……不知道。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro027"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 371, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "但是……知识就是力量。<br>\n我可以跨越死亡，收集情报……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro028"]}},
    {"op": "ModifyCharacterExtended", "line": 374, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.3"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 375, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "【获取本不可能知道的情报】——<br>\n这一点跟你的魔法是一样的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro029"]}},
    {"op": "ModifyCharacterExtended", "line": 378, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.9"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 379, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 380, "indent": 0, "params": {"Text": "那么，我想你也应该明白，<br>\n在战斗中，这究竟能带来多大的优势。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro030"]}},
    {"op": "ModifyCharacterExtended", "line": 382, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR1,ArmL3,Eyes1_Uncomfortable_Open1,Mouth1_Flushed_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 383, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 384, "indent": 0, "params": {"Text": "…………", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Nanoka022"]}},
    {"op": "ModifyCharacterExtended", "line": 386, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.8"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 387, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "我一定会打倒大魔女。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro031"]}},
    {"op": "ModifyCharacterExtended", "line": 390, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.9"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 391, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 392, "indent": 0, "params": {"Text": "并且让你的姐姐得救。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro032"]}},
    {"op": "ModifyCharacterExtended", "line": 394, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.9"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 395, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 396, "indent": 0, "params": {"Text": "我绝不放弃。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro033"]}},
