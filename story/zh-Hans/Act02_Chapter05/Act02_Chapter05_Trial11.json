    {"op": "Wait", "line": 133, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "（奈叶香疑心很重……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.17"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "（但是她也<br>\n　应该注意到了，<br>\n　这么下去是不会有希望的……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "（……我得说服奈叶香）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro012"]}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.2"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "（我得找出，说服她的正确道路……<br>\n　思考能让大家得救的方法……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0205Trial11_Hiro013"]}},
