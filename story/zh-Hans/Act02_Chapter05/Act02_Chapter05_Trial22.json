    {"op": "PrintDebateText", "line": 77, "indent": 0, "params": {"Text": "不要……不要……<br>\n为什么我会<link=\"Objection_02_05_22_01\">做出这种事</link>……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial22_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHanna.1_4"}},
    {"op": "PrintDebateText", "line": 81, "indent": 0, "params": {"Text": "为什么我会<br>\n<link=\"Objection_02_05_22_02\">杀人</link>……？<br>\n把蕾雅杀了……<br>\n把艾玛杀了……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial22_Hanna002"]}},
    {"op": "PrintDebateText", "line": 83, "indent": 0, "params": {"Text": "明明她们<br>\n根本没有罪过……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial22_Hanna003"]}},
    {"op": "PrintDebateText", "line": 85, "indent": 0, "params": {"Text": "而且……<br>\n我这么罪孽深重，<br>\n<link=\"Objection_02_05_22_03\">雪莉</link>竟然要陪我一起……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial22_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHanna.1_5"}},
    {"op": "PrintDebateText", "line": 91, "indent": 0, "params": {"Text": "呜呜……<br>\n啊啊啊啊……！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0205Trial22_Hanna005"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureHiro.7"}},
