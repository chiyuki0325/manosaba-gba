  "translations": {
  "0205Trial22_Hanna001": "不要……不要……<br>\n为什么我会<link=\"Objection_02_05_22_01\">做出这种事</link>……",
  "0205Trial22_Hanna002": "为什么我会<br>\n<link=\"Objection_02_05_22_02\">杀人</link>……？<br>\n把蕾雅杀了……<br>\n把艾玛杀了……！",
  "0205Trial22_Hanna003": "明明她们<br>\n根本没有罪过……！",
  "0205Trial22_Hanna004": "而且……<br>\n我这么罪孽深重，<br>\n<link=\"Objection_02_05_22_03\">雪莉</link>竟然要陪我一起……",
  "0205Trial22_Hanna005": "呜呜……<br>\n啊啊啊啊……！",
  "0205Trial22_Hiro001": "……汉娜！<br>\n你振作一点！",
  "0205Trial22_Hanna006": "<link=\"Objection_02_05_22_04\">做不到</link>啊……！<br>\n我……<br>\n该怎办……！！",
  "0205Trial22_Hiro002": "（汉娜的心承受不住负担，<br>\n　令魔法失控了……！）",
  "0205Trial22_Hiro003": "（重力变得紊乱，我甚至没法靠近汉娜）",
  "0205Trial22_Hiro004": "（……岛的高度现在还在不断上升……！<br>\n　真不敢想放任不管下去会出什么事……！）",
  "0205Trial22_Hiro005": "（我只能……持续对汉娜喊话了！）",
  "0205Trial22_Choice001": "不是你的错",
  "Common_Return": "返回",
  "0205Trial22_Choice002": "不是你动手的",
  "0205Trial22_Choice003": "那是雪莉的选择",
  "0205Trial22_Choice004": "你有办法克服",
  "0205Trial22_Hiro006": "那不怪你！<br>\n当时你的魔女化正在加深……！",
  "0205Trial22_Hiro007": "你不是真心想杀人的！<br>\n这全都是魔女因子的错！",
  "0205Trial22_Hanna007": "我……已经……！",
  "0205Trial22_Hiro008": "（汉娜的心已经憔悴不堪……）",
  "0205Trial22_Hiro009": "（但是……我怎能放弃！）",
  "Toast_002": "讨论前进…",
  "0205Trial22_Hiro010": "那不是你做的！<br>\n只是另一个世界的你做的事！",
  "0205Trial22_Hiro011": "当下的你根本没必要懊悔！",
  "0205Trial22_Hanna008": "……就算是这样，我也……！！",
  "0205Trial22_Hiro012": "（她还听得进我说的话……！）",
  "0205Trial22_Hiro013": "（现在放弃还太早！）",
  "0205Trial22_Hiro014": "那是雪莉自己选择的！",
  "0205Trial22_Hiro015": "你根本没必要感到自责！",
  "0205Trial22_Sherry001": "……总感觉心情复杂呢。",
  "0205Trial22_Sherry002": "请不用在意我！<br>\n我完全不介意的！",
  "0205Trial22_Hanna009": "现在说这个……有什么用……！",
  "0205Trial22_Hiro016": "你一定能克服……",
  "0205Trial22_Hiro017": "你不是高贵的【大小姐】吗！",
  "0205Trial22_Hanna010": "……！",
  "0205Trial22_Hanna011": "我……",
  "0205Trial22_Hanna012": "…………",
  "0205Trial22_Hanna013": "还是不行……！<br>\n我……根本没有当大小姐的资格呀……！",
  "0205Trial22_Hiro018": "……！",
  "0205Trial22_Hanna014": "我……真的太不中用了！！"
}
