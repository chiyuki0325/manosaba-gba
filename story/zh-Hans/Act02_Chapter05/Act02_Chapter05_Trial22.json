    {"op": "PrintDebateText", "line": 98, "indent": 0, "params": {"Text": "……汉娜！<br>\n你振作一点！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0205Trial22_Hiro001"]}},
