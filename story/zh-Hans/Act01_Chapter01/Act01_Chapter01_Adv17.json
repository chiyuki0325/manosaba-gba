    {"op": "label", "name": "Scene1-1-13", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_1"}},
    {"op": "ModifyBackgroundExtended", "line": 16, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "晚餐结束后，艾玛她们去了淋浴房洗澡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "她们昨天也来洗过，所以她们都知道，<br>\n淋浴房里有标记了各个囚犯编号的存衣柜。<br>\n里面整齐地放着一整套的替换衣服，包括内衣裤在内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "根据规定，穿过的衣服<br>\n要投进淋浴房内设置的<br>\n垃圾滑槽里丢掉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "竟然要丢掉衣服……咕唔唔，太浪费了……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "这条垃圾滑槽，联通着地下的焚烧炉哦。<br>\n我在地下看到过焚烧炉室。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry001"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "啊，听你这么一讲……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema001"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 45, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 46, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ff9900", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "27_1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（之前在探索地下的时候，确实见到过焚烧炉室）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema002"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "（魔女图鉴的规定有写，<br>\n　说是【每周一15时启动】）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema003"]}},
    {"op": "Wait", "line": 56, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 57, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_1"}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "明明还能穿欸！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna002"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "说不定是因为我们是预备魔女才会这样。<br>\n穿过的东西都要烧掉，感觉像是某种偏见。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry002"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema004"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "也有可能只是因为洗衣服很麻烦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry003"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "不过我感觉这个查得不是很严，<br>\n不愿意的话不丢掉也可以吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "呜……虽然很不愿意，<br>\n但是要是被抓到违反了规定，不知道会遭怎样的处罚……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna003"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "真是没办法，该死～～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna004"]}},
    {"op": "ResetText", "line": 83, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 85, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 86, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 88, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_2"}},
    {"op": "ModifyBackgroundExtended", "line": 89, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 90, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "——而且每天都要我们穿一模一样的衣服！<br>\n应该至少给我们准备一套睡衣才对。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna005"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "冲完澡后，汉娜还继续吐着苦水。<br>\n艾玛只好露出苦笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative004"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "算啦算啦。<br>\n虽说是一样的衣服，有得换就谢天谢地了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "说不定这是典狱长的私人喜好哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry005"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "艾玛、雪莉、汉娜她们三人正走在过道上，<br>\n热乎乎的身体还冒着白色的蒸气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative005"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "呵，看来它的喜好还不算太差……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "看来你还蛮喜欢的耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Flushed1"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "才、才才才才没有吧？一点都不喜欢哦？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna007"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "（总感觉……这样的小打小闹也蛮不赖的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema006"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "走在路上的艾玛微微弯起了嘴角。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative006"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "（我很向往像这样子<br>\n　可以和朋友一起边走边聊天的时光）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema007"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "（当然了，我们是囚犯，这里是监狱……<br>\n　差点不知不觉，就把这件事忘了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema008"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "啊，艾玛，汉娜，你们快看手机。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "雪莉忽然打断了话题，<br>\n于是艾玛和汉娜拿出了手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative007"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "只见【莲见蕾雅】亮起了“正在直播”的灯，<br>\n屏幕上显示出蕾雅的脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative008"]}},
    {"op": "ResetText", "line": 134, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 135, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 136, "indent": 0, "params": {"Scale": [1.399999976158142], "Lazy": 0, "AppearanceAndTransition": "5_1", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 137, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "Intensity": 0.5}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Scale": [1.600000023841858], "Lazy": 0, "ScenePosition": [50.0, 15.0], "IdAndAppearance": "Leia.Normal1", "SubId": "Middle"}},
    {"op": "Wait", "line": 139, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "——也为了团结，<br>\n我觉得，我也应该定期开展直播。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Leia001"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "希望各位可以保持积极的心态，<br>\n千万不要冲动行事。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "目前我们别无办法，只能遵守规定。<br>\n但是，我们绝不屈服。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "我们一定要做到，所有人能活着离开这里。<br>\n请放心，我一定会想办法实现。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Leia004"]}},
    {"op": "ResetText", "line": 159, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 160, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "HideActors", "line": 161, "indent": 0, "params": {"ActorIds": ["Hanna", "Sherry", "Ema"], "Duration": 0.0, "Lazy": 0}},
    {"op": "HideActors", "line": 162, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Leia-Middle"], "Lazy": 0}},
    {"op": "Wait", "line": 163, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "艾玛的心被蕾雅充满力量的话语打动了。<br>\n她的眼角渗出了热泪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 168, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "（刚刚食堂的事让大家都觉得很害怕。<br>\n　为了安抚大家，蕾雅才开直播讲话的……她真的很了不起……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema009"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "（而我只会想着自己的事……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "哼，这样的东西根本没有看的价值。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna008"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "汉娜嘴上说着嫌弃，可视线还是<br>\n紧紧盯着手机不放。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "哦～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "雪莉好像十分在意这个反应，<br>\n于是乎，她忽然间拿走了汉娜的手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna009"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "汉娜慌了神，<br>\n伸手就要取回映在手机上的蕾雅的身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "你在干什么！？把手机还给我！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna010"]}},
    {"op": "HideAllCharacters", "line": 198, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR17,ArmL4"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "汉娜，你这么拼命抢手机，<br>\n意思是你其实很喜欢蕾雅，对不对～？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry009"]}},
    {"op": "HideAllCharacters", "line": 203, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "雪莉拿着手机左晃右晃，<br>\n汉娜的脸涨得通红，视线也跟着手机左来右去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 208, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "AnimateActorExtended", "line": 209, "indent": 0, "params": {"ActorIds": ["Hanna"], "Loop": 0, "ScenePositionX": "45|65", "Duration": "0.2|0.2"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "你个猩猩女！快还给我！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Hanna011"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "AnimateActorExtended", "line": 214, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "ScenePositionX": "50|30", "Duration": "0.2|0.2"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "呵呵呵，来抓我呀～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Sherry010"]}},
    {"op": "HideAllCharacters", "line": 218, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "面对开始你追我赶的二人，<br>\n艾玛露出傻眼的表情，叹了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative014"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "这期间，连艾玛自己也<br>\n目不转睛的望着屏幕上的蕾雅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Narrative015"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "（蕾雅她是不是<br>\n　会用迷住女孩子的魔法呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv17_Ema011"]}},
