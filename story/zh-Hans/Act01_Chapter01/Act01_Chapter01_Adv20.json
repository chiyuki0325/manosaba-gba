  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv20",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-16", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_2"}},
    {"op": "ModifyBackgroundExtended", "line": 12, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 13, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "吃完了一如既往的晚餐，<br>\n艾玛、雪莉、汉娜、梅露露四人走出了食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 17, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [10.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 19, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [90.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "她们走在路上，讨论要不要去冲澡。<br>\n这时背后有人喊住了她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative002"]}},
    {"op": "HideAllCharacters", "line": 24, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "请问可以打扰一下吗？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "艾玛她们回头一看，原来是奈叶香。<br>\n奈叶香一直都是独来独往，从未跟随团体一起行动过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative003"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "她的行动充满谜团。<br>\n艾玛她们四个不禁有些紧张。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 33, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "什么事？你有什么烦恼吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 38, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "装饰在会客厅里的弩枪不见了。<br>\n我猜是有人把它拿走了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka002"]}},
    {"op": "PlayBgm", "line": 47, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 49, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Fearful1,ArmR4"}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "什么……这事很严重欸！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Hanna001"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "汉娜脸色煞白，<br>\n艾玛也产生了不好的预感，心跳越来越快。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative005"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "（为什么要把弩枪拿走……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema001"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "去、去确认一下吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema002"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 66, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "5_2"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "她们五人<br>\n陆续进入了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative006"]}},
    {"op": "ResetText", "line": 70, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 71, "indent": 0, "params": {"Offset": [8.0, 0.0], "Zoom": 0.6000000238418579, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 72, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "然后她们看到，<br>\n本该挂在墙壁上的弩枪不见了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative007"]}},
    {"op": "ResetText", "line": 76, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 77, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 78, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "是真的……什么时候开始不见的……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema003"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "昨天白天来的时候还在，今天来的时候就不见了。<br>\n所以我猜是昨晚不见的。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "而且……昨天还有另一件东西不见了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "是什么不见了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema004"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "是我的发带。我以为是弄丢了，<br>\n可有头绪的地方我都找过了，还是没找到。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka005"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "奈叶香嘴上用平淡的口吻描述着事实，<br>\n但手里却是紧握着拳头，并且微微颤抖着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative008"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "（啊，白天我有看见奈叶香。难道说……<br>\n　她当时是在找那条发带吗）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema005"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "（奈叶香应该相当珍惜那条发带……<br>\n　她现在看起来很焦急）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema006"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "囚犯里有小偷，<br>\n我不会放过她。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka006"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "眼神昏暗的奈叶香作出宣言。<br>\n这句话让艾玛感到脊背发凉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative009"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "（她说的不会放过，究竟要做什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema007"]}},
    {"op": "HideAllCharacters", "line": 106, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "接着，<br>\n奈叶香便转身离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "奈叶香小姐她不太对劲。<br>\n我很担心她……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Meruru001"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "她这副样子，很容易惹出事欸。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Hanna002"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "令人在意……<br>\n我们快跟上去吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema008"]}},
    {"op": "StopBgm", "line": 128, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 130, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 131, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "9_2"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "艾玛她们跟着奈叶香后面，<br>\n看见她走进二楼的娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative011"]}},
    {"op": "ModifyBackgroundExtended", "line": 135, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "11_1"}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "艾玛她们也急忙跟着进去了。<br>\n果不其然，她和别人起了争执。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative012"]}},
    {"op": "PlayBgm", "line": 143, "indent": 0, "params": {"BgmPath": "Bgm_25_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "你搞什么，见人就说别人是小偷！？<br>\n开什么玩笑啊你！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Alisa001"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "我没在开玩笑。所有人之中你看起来最可疑。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka007"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "我才想说你呢，你那把枪是搞什么鬼！？是从哪里弄到手的！？<br>\n最可疑的是你才对！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 154, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "亚里沙眼看着就要<br>\n伸出手来抓住奈叶香。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 158, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR1,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "艾玛慌忙站在她们两人中间，想要从中说和。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative014"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "你们两个等一下！<br>\n冷静一下！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema009"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "吵死了！滚一边去！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Alisa003"]}},
    {"op": "PlaySfxModified", "line": 172, "indent": 0, "params": {"SfxPath": "Sfx_26", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 173, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "亚里沙踢了一脚旁边的西洋棋桌，<br>\n害棋子撒得满地都是。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative015"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "接着她推开了艾玛，抓住了奈叶香的衣领。<br>\n二人在近距离互相瞪着对方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [55.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "你总是在虚张声势，从来没想过认真直面其他人。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka008"]}},
    {"op": "ResetText", "line": 184, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 185, "indent": 0, "params": {"SlotNumber": 7, "Wait": 0}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "你说够没……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Alisa004"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "亚里沙高举起的拳头正在颤抖。<br>\n互殴一触即发，现场的气氛十分紧张。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative017"]}},
    {"op": "HideAllCharacters", "line": 191, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "哇哇、哇哇哇……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Meruru002"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "不好啦，要发生暴力事件了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 200, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR18,ArmL1"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "这时，雪莉来到艾玛身边，<br>\n悄悄在她耳边说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative018"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "要怎么办？我倒是可以阻止她们两个。<br>\n要我把她们两个打晕吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 207, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "对于雪莉的危险建议，艾玛她——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative019"]}},
    {"op": "AddChoice", "line": 217, "indent": 0, "params": {"ChoiceSummary": "半开玩笑地煽动雪莉", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv20_Choice001"]}},
    {"op": "GotoModified", "line": 218, "indent": 1, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Bad07", "ResetState": ["-"]}},
    {"op": "AddChoice", "line": 220, "indent": 0, "params": {"ChoiceSummary": "用力地摇了摇头", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv20_Choice002"]}},
    {"op": "GotoModified", "line": 221, "indent": 1, "params": {"Path": ".Choice1-1-7"}},
    {"op": "StopForChoice", "line": 223, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice1-1-7", "line": 225, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 227, "indent": 0, "params": {"Number": 7}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "艾玛用力摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "那样会变成大混战啦。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema010"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "要是真的打起来了，说不定会违反不能惹事的规定，<br>\n被关进惩罚室的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "——你们两个快住手，不要再闹了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema012"]}},
    {"op": "HideAllCharacters", "line": 241, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "艾玛平静地说道。<br>\n这时，亚里沙和奈叶香似乎一时间想到了什么，心生怯意，<br>\n然后各自拉开了距离。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative021"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "哎呀，艾玛，你还挺厉害的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "在不远处，玛格小声笑了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative022"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "她好像一开始就在娱乐室里面了。<br>\n现在她坐在沙发上，摆出一副当旁观者当到底的态度。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 253, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "虽然我不知道有什么东西被偷了，<br>\n可是，这座监牢没有一样东西是自己的吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Margo002"]}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "我倒是认为，不管是谁拿走了什么东西都无所谓哦？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Margo003"]}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "奈叶香尖锐的眼神<br>\n转移到了玛格身上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative024"]}},
    {"op": "HideAllCharacters", "line": 261, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "你也拿了不少东西到自己的房间里。<br>\n是你偷了我的发带也不奇怪。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka009"]}},
    {"op": "HideAllCharacters", "line": 266, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 267, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR6,ArmL1"}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "发带？没见过呢。<br>\n不过，如果是很漂亮的东西，说不定我会把它占为己有哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Margo004"]}},
    {"op": "HideAllCharacters", "line": 271, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 272, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "现在马上还给我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka010"]}},
    {"op": "HideAllCharacters", "line": 276, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 277, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR1,ArmL4"}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "不是我干的，或许啦。呵呵。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Margo005"]}},
    {"op": "HideAllCharacters", "line": 281, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 282, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "快还我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Nanoka011"]}},
    {"op": "HideAllCharacters", "line": 286, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "（真头大……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Ema013"]}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "这次换玛格和奈叶香针锋相对，<br>\n害得艾玛头疼了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv20_Narrative025"]}},
    {"op": "Gosub", "line": 296, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 298, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv21", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv20_Narrative001": "吃完了一如既往的晚餐，<br>\n艾玛、雪莉、汉娜、梅露露四人走出了食堂。",
  "0101Adv20_Narrative002": "她们走在路上，讨论要不要去冲澡。<br>\n这时背后有人喊住了她们。",
  "0101Adv20_Nanoka001": "请问可以打扰一下吗？",
  "0101Adv20_Narrative003": "艾玛她们回头一看，原来是奈叶香。<br>\n奈叶香一直都是独来独往，从未跟随团体一起行动过。",
  "0101Adv20_Narrative004": "她的行动充满谜团。<br>\n艾玛她们四个不禁有些紧张。",
  "0101Adv20_Sherry001": "什么事？你有什么烦恼吗？",
  "0101Adv20_Nanoka002": "装饰在会客厅里的弩枪不见了。<br>\n我猜是有人把它拿走了。",
  "0101Adv20_Hanna001": "什么……这事很严重欸！？",
  "0101Adv20_Narrative005": "汉娜脸色煞白，<br>\n艾玛也产生了不好的预感，心跳越来越快。",
  "0101Adv20_Ema001": "（为什么要把弩枪拿走……？）",
  "0101Adv20_Ema002": "去、去确认一下吧。",
  "0101Adv20_Narrative006": "她们五人<br>\n陆续进入了会客厅。",
  "0101Adv20_Narrative007": "然后她们看到，<br>\n本该挂在墙壁上的弩枪不见了。",
  "0101Adv20_Ema003": "是真的……什么时候开始不见的……？",
  "0101Adv20_Nanoka003": "昨天白天来的时候还在，今天来的时候就不见了。<br>\n所以我猜是昨晚不见的。",
  "0101Adv20_Nanoka004": "而且……昨天还有另一件东西不见了。",
  "0101Adv20_Ema004": "是什么不见了？",
  "0101Adv20_Nanoka005": "是我的发带。我以为是弄丢了，<br>\n可有头绪的地方我都找过了，还是没找到。",
  "0101Adv20_Narrative008": "奈叶香嘴上用平淡的口吻描述着事实，<br>\n但手里却是紧握着拳头，并且微微颤抖着。",
  "0101Adv20_Ema005": "（啊，白天我有看见奈叶香。难道说……<br>\n　她当时是在找那条发带吗）",
  "0101Adv20_Ema006": "（奈叶香应该相当珍惜那条发带……<br>\n　她现在看起来很焦急）",
  "0101Adv20_Nanoka006": "囚犯里有小偷，<br>\n我不会放过她。",
  "0101Adv20_Narrative009": "眼神昏暗的奈叶香作出宣言。<br>\n这句话让艾玛感到脊背发凉。",
  "0101Adv20_Ema007": "（她说的不会放过，究竟要做什么……？）",
  "0101Adv20_Narrative010": "接着，<br>\n奈叶香便转身离开了会客厅。",
  "0101Adv20_Meruru001": "奈叶香小姐她不太对劲。<br>\n我很担心她……",
  "0101Adv20_Hanna002": "她这副样子，很容易惹出事欸。",
  "0101Adv20_Ema008": "令人在意……<br>\n我们快跟上去吧！",
  "0101Adv20_Narrative011": "艾玛她们跟着奈叶香后面，<br>\n看见她走进二楼的娱乐室。",
  "0101Adv20_Narrative012": "艾玛她们也急忙跟着进去了。<br>\n果不其然，她和别人起了争执。",
  "0101Adv20_Alisa001": "你搞什么，见人就说别人是小偷！？<br>\n开什么玩笑啊你！",
  "0101Adv20_Nanoka007": "我没在开玩笑。所有人之中你看起来最可疑。",
  "0101Adv20_Alisa002": "我才想说你呢，你那把枪是搞什么鬼！？是从哪里弄到手的！？<br>\n最可疑的是你才对！！",
  "0101Adv20_Narrative013": "亚里沙眼看着就要<br>\n伸出手来抓住奈叶香。",
  "0101Adv20_Narrative014": "艾玛慌忙站在她们两人中间，想要从中说和。",
  "0101Adv20_Ema009": "你们两个等一下！<br>\n冷静一下！",
  "0101Adv20_Alisa003": "吵死了！滚一边去！",
  "0101Adv20_Narrative015": "亚里沙踢了一脚旁边的西洋棋桌，<br>\n害棋子撒得满地都是。",
  "0101Adv20_Narrative016": "接着她推开了艾玛，抓住了奈叶香的衣领。<br>\n二人在近距离互相瞪着对方。",
  "0101Adv20_Nanoka008": "你总是在虚张声势，从来没想过认真直面其他人。",
  "0101Adv20_Alisa004": "你说够没……",
  "0101Adv20_Narrative017": "亚里沙高举起的拳头正在颤抖。<br>\n互殴一触即发，现场的气氛十分紧张。",
  "0101Adv20_Meruru002": "哇哇、哇哇哇……",
  "0101Adv20_Hanna003": "不好啦，要发生暴力事件了！",
  "0101Adv20_Narrative018": "这时，雪莉来到艾玛身边，<br>\n悄悄在她耳边说道。",
  "0101Adv20_Sherry002": "要怎么办？我倒是可以阻止她们两个。<br>\n要我把她们两个打晕吗？",
  "0101Adv20_Narrative019": "对于雪莉的危险建议，艾玛她——",
  "0101Adv20_Choice001": "半开玩笑地煽动雪莉",
  "0101Adv20_Choice002": "用力地摇了摇头",
  "0101Adv20_Narrative020": "艾玛用力摇了摇头。",
  "0101Adv20_Ema010": "那样会变成大混战啦。",
  "0101Adv20_Ema011": "要是真的打起来了，说不定会违反不能惹事的规定，<br>\n被关进惩罚室的。",
  "0101Adv20_Ema012": "——你们两个快住手，不要再闹了。",
  "0101Adv20_Narrative021": "艾玛平静地说道。<br>\n这时，亚里沙和奈叶香似乎一时间想到了什么，心生怯意，<br>\n然后各自拉开了距离。",
  "0101Adv20_Margo001": "哎呀，艾玛，你还挺厉害的。",
  "0101Adv20_Narrative022": "在不远处，玛格小声笑了起来。",
  "0101Adv20_Narrative023": "她好像一开始就在娱乐室里面了。<br>\n现在她坐在沙发上，摆出一副当旁观者当到底的态度。",
  "0101Adv20_Margo002": "虽然我不知道有什么东西被偷了，<br>\n可是，这座监牢没有一样东西是自己的吧？",
  "0101Adv20_Margo003": "我倒是认为，不管是谁拿走了什么东西都无所谓哦？",
  "0101Adv20_Narrative024": "奈叶香尖锐的眼神<br>\n转移到了玛格身上。",
  "0101Adv20_Nanoka009": "你也拿了不少东西到自己的房间里。<br>\n是你偷了我的发带也不奇怪。",
  "0101Adv20_Margo004": "发带？没见过呢。<br>\n不过，如果是很漂亮的东西，说不定我会把它占为己有哦。",
  "0101Adv20_Nanoka010": "现在马上还给我。",
  "0101Adv20_Margo005": "不是我干的，或许啦。呵呵。",
  "0101Adv20_Nanoka011": "快还我。",
  "0101Adv20_Ema013": "（真头大……）",
  "0101Adv20_Narrative025": "这次换玛格和奈叶香针锋相对，<br>\n害得艾玛头疼了起来。"
}
}
