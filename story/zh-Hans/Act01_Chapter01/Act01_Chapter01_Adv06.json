  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-2", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 16, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "回到地下后，<br>\n艾玛发觉了一件事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "那就是，所有人的牢房前面<br>\n多了一块写着囚犯编号的板子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（我的囚犯编号是658号……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "她站在今早醒来的牢房前，确认好现场情况后正准备回房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 32, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 33, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 34, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 36, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 37, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 38, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "这时，手机恰好震动了起来，<br>\n响起了猫头鹰叫声的提示音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative004"]}},
    {"op": "PlaySfxModified", "line": 46, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "她赶紧拿出手机，<br>\n看到上面显示的是典狱长发来的通知。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative005"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "她打开手机里的聊天APP后，<br>\n弹出一条典狱长（头像是它自己的抽象画）<br>\n传来的信息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative006"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "『放风时间结束了。<br>\n　请大家迅速返回自己的牢房内』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative007"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "『不遵守规定的人，<br>\n　会被扭送至惩罚室……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative008"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "『请大家不要给我增加工作……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative009"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "看来典狱长的通知<br>\n也会直接推到手机里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative010"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "艾玛才刚坐在床上没多久，<br>\n便传来了昭示时限到来的上锁声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative011"]}},
    {"op": "PlaySfxModified", "line": 66, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "（明明是个老旧的建筑物，<br>\n　安装的却是自动锁……总感觉有点错位）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema002"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "看样子，每间牢房都是双人间。<br>\n她刚刚有看到，其他少女进了同一间牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative012"]}},
    {"op": "ModifyBackgroundExtended", "line": 75, "indent": 0, "params": {"Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [10.0, 30.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "而艾玛却是孤身一人。<br>\n因为同在一间房醒来的希罗被杀了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative013"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "希罗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema003"]}},
    {"op": "SpawnBlur", "line": 81, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "FadeDuration": 0.0}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "虽然紧闭双唇，<br>\n但泪珠却一颗颗从眼中流下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative014"]}},
    {"op": "HideActors", "line": 85, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "艾玛想止住伤感，马上用袖子擦去了眼泪。<br>\n紧接着，她开始观察起室内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative015"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "（之前因为恐慌，还没好好观察室内……<br>\n　这里有洗脸台和厕所，还有桌椅也都有）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema004"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "（至少有最低限度的生活保障……<br>\n　我们要一直在这个地方生活下去吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema005"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "（对了，确认一下规定吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema006"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "她拿出口袋里的手机，<br>\n查看上面的内容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative016"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "（虽然不是自己的手机，<br>\n　不过功能和我熟悉的型号一样）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema007"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "身处昏暗不见天日的地下，容易失去对时间的判断。<br>\n看手机上的时钟显示，<br>\n现在是15时刚过一点点的时间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative017"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "（能确认时间已经很好了。<br>\n　要是能用它联络外部就好了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema008"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "和蕾雅刚才说的一样，<br>\n手机里面安装了一个叫【魔女图鉴】的APP。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative018"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "艾玛启动了APP，确认里面的内容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative019"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "根据监牢规定，<br>\n除了放风时间以外，<br>\n囚犯必须留在指定的牢房内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative020"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "外面会有看守时常巡逻，<br>\n如果发现了囚犯，会将其送到惩罚室关上两天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative021"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "此外，如果作出违反规定的行为，<br>\n也是会送到惩罚室里面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative022"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "（惩罚室……究竟是个什么样的地方呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema009"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "艾玛脸色发青，但还是小小叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative023"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "典狱长之前说过的话，<br>\n在关于魔女审判的规定上也有讲。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative024"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "『囚犯受到强烈精神压力后，<br>\n　魔女因子会得到增强，魔女化程度便会加深』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative025"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "『成为魔女之人，有可能会因为难以忍受的<br>\n　杀人冲动，犯下杀人的罪行』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative026"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "『如果发生了凶杀案，<br>\n　为了将危险的魔女处死，将开展魔女审判』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative027"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "『囚犯们应经过讨论、投票，选出魔女，<br>\n　之后魔女将当场处死』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative028"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "怎么可能会发生凶杀案……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema010"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "（虽然希罗失控了……<br>\n　可是其他人看起来都是同龄的普通人）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema011"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "（根本无法想像<br>\n　她们会互相厮杀……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema012"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "艾玛摇了摇头，不再多想，<br>\n重新集中精神看魔女图鉴的内容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative029"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "『完全成为魔女之人，<br>\n　可获得强韧肉体，不会轻易死亡』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative030"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "『完全成为魔女之人，<br>\n　持有的【魔法】会得到爆发式增强』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative031"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "『但，其终将失去人形，<br>\n　成为完全的【残骸】』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative032"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "魔法……？可是我不会用欸……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema013"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "艾玛有些不解。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative033"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "累了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema014"]}},
    {"op": "PlaySfxModified", "line": 147, "indent": 0, "params": {"SfxPath": "Sfx_179", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnBlur", "line": 148, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 149, "indent": 0, "params": {"Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [10.0, 70.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "她放弃了进一步思考，把手机扔到了一边，<br>\n躺平在硬硬的床铺上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Narrative034"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "（软绵绵的被窝……最爱的抱枕……<br>\n　高中的制服……一切都不复存在了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema015"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "爸爸妈妈，你们有没有在担心我……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema016"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "（他们肯定有找警察报案，<br>\n　现在还在拼命地找我……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema017"]}},
    {"op": "StopBgm", "line": 163, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 164, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "SpawnBlur", "line": 168, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "FadeDuration": 0.0}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema018"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "（虽然初中搞砸了，<br>\n　但是我明明已经下了决心）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema019"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "（要在高中交很多朋友，<br>\n　不要再让爸妈操心的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema020"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "（为什么我要被关进<br>\n　这种地方里面……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema021"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "呜呜……呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv06_Ema022"]}},
    {"op": "Gosub", "line": 186, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 188, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv07", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv06_Narrative001": "回到地下后，<br>\n艾玛发觉了一件事。",
  "0101Adv06_Narrative002": "那就是，所有人的牢房前面<br>\n多了一块写着囚犯编号的板子。",
  "0101Adv06_Ema001": "（我的囚犯编号是658号……）",
  "0101Adv06_Narrative003": "她站在今早醒来的牢房前，确认好现场情况后正准备回房。",
  "0101Adv06_Narrative004": "这时，手机恰好震动了起来，<br>\n响起了猫头鹰叫声的提示音。",
  "0101Adv06_Narrative005": "她赶紧拿出手机，<br>\n看到上面显示的是典狱长发来的通知。",
  "0101Adv06_Narrative006": "她打开手机里的聊天APP后，<br>\n弹出一条典狱长（头像是它自己的抽象画）<br>\n传来的信息。",
  "0101Adv06_Narrative007": "『放风时间结束了。<br>\n　请大家迅速返回自己的牢房内』",
  "0101Adv06_Narrative008": "『不遵守规定的人，<br>\n　会被扭送至惩罚室……』",
  "0101Adv06_Narrative009": "『请大家不要给我增加工作……』",
  "0101Adv06_Narrative010": "看来典狱长的通知<br>\n也会直接推到手机里。",
  "0101Adv06_Narrative011": "艾玛才刚坐在床上没多久，<br>\n便传来了昭示时限到来的上锁声。",
  "0101Adv06_Ema002": "（明明是个老旧的建筑物，<br>\n　安装的却是自动锁……总感觉有点错位）",
  "0101Adv06_Narrative012": "看样子，每间牢房都是双人间。<br>\n她刚刚有看到，其他少女进了同一间牢房。",
  "0101Adv06_Narrative013": "而艾玛却是孤身一人。<br>\n因为同在一间房醒来的希罗被杀了。",
  "0101Adv06_Ema003": "希罗……",
  "0101Adv06_Narrative014": "虽然紧闭双唇，<br>\n但泪珠却一颗颗从眼中流下。",
  "0101Adv06_Narrative015": "艾玛想止住伤感，马上用袖子擦去了眼泪。<br>\n紧接着，她开始观察起室内。",
  "0101Adv06_Ema004": "（之前因为恐慌，还没好好观察室内……<br>\n　这里有洗脸台和厕所，还有桌椅也都有）",
  "0101Adv06_Ema005": "（至少有最低限度的生活保障……<br>\n　我们要一直在这个地方生活下去吗……？）",
  "0101Adv06_Ema006": "（对了，确认一下规定吧）",
  "0101Adv06_Narrative016": "她拿出口袋里的手机，<br>\n查看上面的内容。",
  "0101Adv06_Ema007": "（虽然不是自己的手机，<br>\n　不过功能和我熟悉的型号一样）",
  "0101Adv06_Narrative017": "身处昏暗不见天日的地下，容易失去对时间的判断。<br>\n看手机上的时钟显示，<br>\n现在是15时刚过一点点的时间。",
  "0101Adv06_Ema008": "（能确认时间已经很好了。<br>\n　要是能用它联络外部就好了……）",
  "0101Adv06_Narrative018": "和蕾雅刚才说的一样，<br>\n手机里面安装了一个叫【魔女图鉴】的APP。",
  "0101Adv06_Narrative019": "艾玛启动了APP，确认里面的内容。",
  "0101Adv06_Narrative020": "根据监牢规定，<br>\n除了放风时间以外，<br>\n囚犯必须留在指定的牢房内。",
  "0101Adv06_Narrative021": "外面会有看守时常巡逻，<br>\n如果发现了囚犯，会将其送到惩罚室关上两天。",
  "0101Adv06_Narrative022": "此外，如果作出违反规定的行为，<br>\n也是会送到惩罚室里面。",
  "0101Adv06_Ema009": "（惩罚室……究竟是个什么样的地方呢）",
  "0101Adv06_Narrative023": "艾玛脸色发青，但还是小小叹了口气。",
  "0101Adv06_Narrative024": "典狱长之前说过的话，<br>\n在关于魔女审判的规定上也有讲。",
  "0101Adv06_Narrative025": "『囚犯受到强烈精神压力后，<br>\n　魔女因子会得到增强，魔女化程度便会加深』",
  "0101Adv06_Narrative026": "『成为魔女之人，有可能会因为难以忍受的<br>\n　杀人冲动，犯下杀人的罪行』",
  "0101Adv06_Narrative027": "『如果发生了凶杀案，<br>\n　为了将危险的魔女处死，将开展魔女审判』",
  "0101Adv06_Narrative028": "『囚犯们应经过讨论、投票，选出魔女，<br>\n　之后魔女将当场处死』",
  "0101Adv06_Ema010": "怎么可能会发生凶杀案……",
  "0101Adv06_Ema011": "（虽然希罗失控了……<br>\n　可是其他人看起来都是同龄的普通人）",
  "0101Adv06_Ema012": "（根本无法想像<br>\n　她们会互相厮杀……）",
  "0101Adv06_Narrative029": "艾玛摇了摇头，不再多想，<br>\n重新集中精神看魔女图鉴的内容。",
  "0101Adv06_Narrative030": "『完全成为魔女之人，<br>\n　可获得强韧肉体，不会轻易死亡』",
  "0101Adv06_Narrative031": "『完全成为魔女之人，<br>\n　持有的【魔法】会得到爆发式增强』",
  "0101Adv06_Narrative032": "『但，其终将失去人形，<br>\n　成为完全的【残骸】』",
  "0101Adv06_Ema013": "魔法……？可是我不会用欸……",
  "0101Adv06_Narrative033": "艾玛有些不解。",
  "0101Adv06_Ema014": "累了……",
  "0101Adv06_Narrative034": "她放弃了进一步思考，把手机扔到了一边，<br>\n躺平在硬硬的床铺上。",
  "0101Adv06_Ema015": "（软绵绵的被窝……最爱的抱枕……<br>\n　高中的制服……一切都不复存在了）",
  "0101Adv06_Ema016": "爸爸妈妈，你们有没有在担心我……？",
  "0101Adv06_Ema017": "（他们肯定有找警察报案，<br>\n　现在还在拼命地找我……）",
  "0101Adv06_Ema018": "呜……",
  "0101Adv06_Ema019": "（虽然初中搞砸了，<br>\n　但是我明明已经下了决心）",
  "0101Adv06_Ema020": "（要在高中交很多朋友，<br>\n　不要再让爸妈操心的……）",
  "0101Adv06_Ema021": "（为什么我要被关进<br>\n　这种地方里面……？）",
  "0101Adv06_Ema022": "呜呜……呜……"
}
}
