    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 20, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "等事情终于平息后，<br>\n艾玛一组人去冲了个澡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative002"]}},
    {"op": "ResetText", "line": 26, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 27, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 28, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 30, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 31, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 32, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "今天奔波了一整天，又遇上刚刚的闹剧，<br>\n艾玛她们积累了不少疲劳。回到地下后，她们几个累得脚都软了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "雪莉的牢房最靠前，<br>\n她最先回到自己的房间里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1,ArmR4"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "呜呜……明天肌肉要痛一整天了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema001"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "累死了，光冲澡已经缓解不了疲劳了，好想泡个澡啊。<br>\n呼啊～", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Hanna001"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "汉娜打了个哈欠，<br>\n眼神都有些朦胧了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR13,ArmL1"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "艾玛也跟着打了个哈欠，<br>\n迷迷糊糊走在过道上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 51, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "接着，她走到了自己的房门前，<br>\n正准备回房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative007"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "这时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 61, "indent": 0, "params": {"SfxPath": "Sfx_27", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 62, "indent": 0, "params": {"Path": "ShakeBackground"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "哇！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema002"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "有个人撞到了艾玛，<br>\n害艾玛一屁股跌坐在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative009"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "两眼昏花的艾玛抬头定睛一看，<br>\n站在面前的是亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "啧……又是你。<br>\n走路能不能不要做白日梦啊！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 74, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "对、对不起。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema003"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "听到艾玛的道歉，亚里沙又咂了咂舌，<br>\n然后走掉了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "明明是她自己撞上来的，真是没礼貌！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Hanna002"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "你、你没事吧，艾玛小姐。有没有受伤？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Meruru001"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "嗯，完全没事！嘿咻！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema004"]}},
    {"op": "HideAllCharacters", "line": 88, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "艾玛快速站起身来，<br>\n动手拍落身上的灰尘。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative012"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "——你们没事吧？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia001"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "不知什么时候，蕾雅也来到了她们的身边。<br>\n所有人的视线集中在蕾雅身上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative013"]}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "本、<br>\n本小姐可用不着你来关心！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "……我做了什么害你讨厌的事情吗？<br>\n真头疼，我可是想和大家友好相处的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR1,ArmL2"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "对了，我等一下准备直播。<br>\n你们愿意的话，希望你们也能看一下。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia003"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "哼，真是辛苦你每天费心照顾其他人呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1,ArmR8,ArmL5"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "虽然辛苦是辛苦了点啦，哈哈，性格使然而已。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia004"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Flushed1"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "面对露出为难笑容的蕾雅，<br>\n汉娜涨红了脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative014"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "（蕾雅她果然是<br>\n　魅惑人心的魔法师……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema005"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR1,ArmL2"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "今天的直播是可可和米莉亚邀我的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia005"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "我想今天这场应该会比较热闹和开心。<br>\n如果能在这个令人郁闷的地方里给大家带来一些消遣，<br>\n我就满足了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia006"]}},
    {"op": "HideAllCharacters", "line": 138, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Flushed1"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "哼～倒也不是不能看一眼哦？<br>\n走、走啦，梅露露！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Hanna005"]}},
    {"op": "HideAllCharacters", "line": 143, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "嗯、嗯……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 148, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "汉娜抓住梅露露的手腕，<br>\n逃也似的跑回了自己的房里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative015"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "只剩艾玛一人留在了原地，<br>\n和蕾雅四目相对。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "啊，对了。今天我去医务室的时候，<br>\n不小心错拿了安安的手机。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia007"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "蕾雅从口袋里摸出了一部手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative017"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "我等一下有直播要开……<br>\n真是不好意思，希望你可以帮我还给她。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia008"]}},
    {"op": "HideAllCharacters", "line": 162, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "嗯，这么点小事没关系的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "我、我想说，<br>\n我觉得蕾雅你在做的事情真的很棒！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "虽然我们意见不太一样……不过，<br>\n我希望我们可以互相帮助。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Ema008"]}},
    {"op": "HideAllCharacters", "line": 175, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Surprised1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "蕾雅有些惊讶地瞪大了眼睛。<br>\n不过很快，她便露出了一个温柔的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "谢谢你。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Leia009"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "艾玛从蕾雅手里拿过手机，<br>\n急匆匆前往了医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative019"]}},
    {"op": "Gosub", "line": 192, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 194, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv22", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv21_Narrative001": "现场再次充满了火药味，<br>\n不知不觉又浪费了许多时间。",
  "0101Adv21_Narrative002": "等事情终于平息后，<br>\n艾玛一组人去冲了个澡。",
  "0101Adv21_Narrative003": "今天奔波了一整天，又遇上刚刚的闹剧，<br>\n艾玛她们积累了不少疲劳。回到地下后，她们几个累得脚都软了。",
  "0101Adv21_Narrative004": "雪莉的牢房最靠前，<br>\n她最先回到自己的房间里。",
  "0101Adv21_Ema001": "呜呜……明天肌肉要痛一整天了……",
  "0101Adv21_Hanna001": "累死了，光冲澡已经缓解不了疲劳了，好想泡个澡啊。<br>\n呼啊～",
  "0101Adv21_Narrative005": "汉娜打了个哈欠，<br>\n眼神都有些朦胧了。",
  "0101Adv21_Narrative006": "艾玛也跟着打了个哈欠，<br>\n迷迷糊糊走在过道上。",
  "0101Adv21_Narrative007": "接着，她走到了自己的房门前，<br>\n正准备回房。",
  "0101Adv21_Narrative008": "这时——",
  "0101Adv21_Ema002": "哇！",
  "0101Adv21_Narrative009": "有个人撞到了艾玛，<br>\n害艾玛一屁股跌坐在地上。",
  "0101Adv21_Narrative010": "两眼昏花的艾玛抬头定睛一看，<br>\n站在面前的是亚里沙。",
  "0101Adv21_Alisa001": "啧……又是你。<br>\n走路能不能不要做白日梦啊！",
  "0101Adv21_Ema003": "对、对不起。",
  "0101Adv21_Narrative011": "听到艾玛的道歉，亚里沙又咂了咂舌，<br>\n然后走掉了。",
  "0101Adv21_Hanna002": "明明是她自己撞上来的，真是没礼貌！",
  "0101Adv21_Meruru001": "你、你没事吧，艾玛小姐。有没有受伤？",
  "0101Adv21_Ema004": "嗯，完全没事！嘿咻！",
  "0101Adv21_Narrative012": "艾玛快速站起身来，<br>\n动手拍落身上的灰尘。",
  "0101Adv21_Leia001": "——你们没事吧？",
  "0101Adv21_Narrative013": "不知什么时候，蕾雅也来到了她们的身边。<br>\n所有人的视线集中在蕾雅身上。",
  "0101Adv21_Hanna003": "本、<br>\n本小姐可用不着你来关心！",
  "0101Adv21_Leia002": "……我做了什么害你讨厌的事情吗？<br>\n真头疼，我可是想和大家友好相处的。",
  "0101Adv21_Leia003": "对了，我等一下准备直播。<br>\n你们愿意的话，希望你们也能看一下。",
  "0101Adv21_Hanna004": "哼，真是辛苦你每天费心照顾其他人呢。",
  "0101Adv21_Leia004": "虽然辛苦是辛苦了点啦，哈哈，性格使然而已。",
  "0101Adv21_Narrative014": "面对露出为难笑容的蕾雅，<br>\n汉娜涨红了脸。",
  "0101Adv21_Ema005": "（蕾雅她果然是<br>\n　魅惑人心的魔法师……）",
  "0101Adv21_Leia005": "今天的直播是可可和米莉亚邀我的。",
  "0101Adv21_Leia006": "我想今天这场应该会比较热闹和开心。<br>\n如果能在这个令人郁闷的地方里给大家带来一些消遣，<br>\n我就满足了。",
  "0101Adv21_Hanna005": "哼～倒也不是不能看一眼哦？<br>\n走、走啦，梅露露！",
  "0101Adv21_Meruru002": "嗯、嗯……",
  "0101Adv21_Narrative015": "汉娜抓住梅露露的手腕，<br>\n逃也似的跑回了自己的房里。",
  "0101Adv21_Narrative016": "只剩艾玛一人留在了原地，<br>\n和蕾雅四目相对。",
  "0101Adv21_Leia007": "啊，对了。今天我去医务室的时候，<br>\n不小心错拿了安安的手机。",
  "0101Adv21_Narrative017": "蕾雅从口袋里摸出了一部手机。",
  "0101Adv21_Leia008": "我等一下有直播要开……<br>\n真是不好意思，希望你可以帮我还给她。",
  "0101Adv21_Ema006": "嗯，这么点小事没关系的。",
  "0101Adv21_Ema007": "我、我想说，<br>\n我觉得蕾雅你在做的事情真的很棒！",
  "0101Adv21_Ema008": "虽然我们意见不太一样……不过，<br>\n我希望我们可以互相帮助。",
  "0101Adv21_Narrative018": "蕾雅有些惊讶地瞪大了眼睛。<br>\n不过很快，她便露出了一个温柔的微笑。",
  "0101Adv21_Leia009": "谢谢你。",
  "0101Adv21_Narrative019": "艾玛从蕾雅手里拿过手机，<br>\n急匆匆前往了医务室。"
}
}
