    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "现场再次充满了火药味，<br>\n不知不觉又浪费了许多时间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv21_Narrative001"]}},
    {"op": "ResetText", "line": 17, "indent": 0, "params": {}},
