    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [80.0, 32.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Front"}},
