    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "总、总之我们继续调查吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema015"]}},
