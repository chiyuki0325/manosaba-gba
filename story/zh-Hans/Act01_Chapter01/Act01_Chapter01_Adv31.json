    {"op": "WaitForNextFrame", "line": 260, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "完全说不上有益好吗……<br>\n本、本来我就很不愿意说这件事。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Hanna006"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "汉娜几乎难受得要跺脚，<br>\n可雪莉却是一副乐开花的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative010"]}},
