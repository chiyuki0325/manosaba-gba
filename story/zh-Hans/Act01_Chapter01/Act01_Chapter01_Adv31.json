    {"op": "AnimateActorExtended", "line": 109, "indent": 0, "params": {"ActorIds": ["Hanna-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "WaitForNextFrame", "line": 110, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "难道是对【气球】有怨恨的人物……？<br>\n有可能欸。<br>\n毕竟是名人，在什么地方招惹了别人也说不定。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Hanna003"]}},
    {"op": "AnimateActorExtended", "line": 114, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Hanna-Front"], "Loop": 0}},
    {"op": "HideAllCharacters", "line": 115, "indent": 0, "params": {"Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 116, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "（不管有怎样的理由，杀人都是不可饶恕的。<br>\n　可是，这个人却还是动手了。究竟动手的是谁……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema006"]}},
    {"op": "HidePrinter", "line": 120, "indent": 0, "params": {}},
