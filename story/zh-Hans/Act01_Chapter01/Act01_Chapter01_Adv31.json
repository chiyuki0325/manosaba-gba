    {"op": "AnimateActorExtended", "line": 126, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "WaitForNextFrame", "line": 127, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "有一件事我想不通，<br>\n就是按照现有的信息，谋杀是在禁止外出时间进行的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry006"]}},
    {"op": "AnimateActorExtended", "line": 131, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Sherry-Front"], "Loop": 0}},
