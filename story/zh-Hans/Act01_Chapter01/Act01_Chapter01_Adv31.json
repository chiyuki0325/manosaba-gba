    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [10.0, 36.0], "AppearanceAndTransition": "6_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [50.0, 32.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 71, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Ema-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 72, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 73, "indent": 0, "params": {"ActorIds": ["Ema-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "WaitForNextFrame", "line": 74, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "我和她交流的时间太短了……不过我觉得<br>\n她是个好孩子，还有就是喜欢画画，只想到这些。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema002"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "（在我印象中，我所接触的诺亚，<br>\n　是个天真直率的好孩子）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema003"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（可我只和她讲过几次话，<br>\n　实际是怎样我也不清楚……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema004"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "只不过，我不觉得她身上有什么会遭杀害的理由。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema005"]}},
    {"op": "AnimateActorExtended", "line": 84, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Ema-Front"], "Loop": 0}},
    {"op": "HideAllCharacters", "line": 85, "indent": 0, "params": {"Lazy": 0}},
