    {"op": "WaitForNextFrame", "line": 95, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "她还是有名的街头艺术家。<br>\n和这件事又有什么关系呢……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry005"]}},
