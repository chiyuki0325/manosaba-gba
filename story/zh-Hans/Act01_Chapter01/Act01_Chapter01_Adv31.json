    {"op": "WaitForNextFrame", "line": 190, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "可、可是，电子锁到了早上就会打开。<br>\n只要趁一大早去诺亚的房间里，<br>\n谁都有可能犯案。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema014"]}},
