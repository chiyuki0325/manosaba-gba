    {"op": "WaitForNextFrame", "line": 243, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "哦哦，真是有益的情报！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry009"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "如果只能悬空很短的时间，<br>\n应该可以主张自己无法不留足迹杀人哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry010"]}},
