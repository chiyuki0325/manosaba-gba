    {"op": "WaitForNextFrame", "line": 220, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "呜……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Hanna004"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "汉娜垂头丧气了好一会，<br>\n最终下定了决心，抬起头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Normal1,ArmR3", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "我想说，我可以飘在半空中的时间，<br>\n其实只有1分钟左右。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Hanna005"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "汉娜不甘心地小声说道。<br>\n看来她是真的对她的魔法感到很自豪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative009"]}},
    {"op": "AnimateActorExtended", "line": 232, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Hanna-Front"], "Loop": 0}},
