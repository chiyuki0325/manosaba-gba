    {"op": "AnimateActorExtended", "line": 54, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "WaitForNextFrame", "line": 55, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "凶手为什么会想要<br>\n杀死诺亚呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry003"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "在调查餐桌下时，<br>\n雪莉忽然抛来了问题。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative004"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "诺亚她<br>\n究竟是个怎样的人呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry004"]}},
    {"op": "AnimateActorExtended", "line": 63, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Sherry-Front"], "Loop": 0}},
