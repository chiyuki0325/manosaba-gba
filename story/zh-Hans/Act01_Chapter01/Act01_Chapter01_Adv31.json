    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "那之后，她们在宽阔的食堂内到处转了一圈，<br>\n最后还是没得到什么线索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative011"]}},
    {"op": "ResetText", "line": 317, "indent": 0, "params": {}},
