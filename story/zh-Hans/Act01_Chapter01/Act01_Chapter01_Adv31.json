    {"op": "AnimateActorExtended", "line": 155, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 156, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "WaitForNextFrame", "line": 157, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "应该说，几乎所有人。<br>\n因为安安在医务室那边。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry007"]}},
    {"op": "AnimateActorExtended", "line": 161, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Ema-Front"], "Loop": 0}},
    {"op": "HideAllCharacters", "line": 162, "indent": 0, "params": {"Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 163, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "（啊，是哦……医务室是没有上锁的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema008"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "这时艾玛想到一件事，<br>\n她的脸一下子僵住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative005"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "（我也是自己一个人睡的，<br>\n　所以没有人可以证明我在自己的房间里……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema009"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "（难道，夜间不在场证明无法成立的，<br>\n　只有我和安安两个？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema010"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "（可、可是诺亚是什么时候被杀的，<br>\n　目前还没有明确的答案。在睡觉前和今天早上，<br>\n　我和安安是碰了面的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema011"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "（根据实际的杀害时间，也许可以证明我们两个不在场吧。<br>\n　前提是安安愿意配合我的话……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema012"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "艾玛的心中充满了混乱和不安，<br>\n脸色变得越来越苍白。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative006"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "（难不成，我被人选为凶手的可能性<br>\n　非常大……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema013"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "想到这，她摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative007"]}},
