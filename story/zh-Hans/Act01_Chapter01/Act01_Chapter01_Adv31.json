    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛她们为了调查，来到了食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "发生了这种事，实在是没食欲。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Hanna001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "这些饭菜是不是一直都没换过新的啊？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry001"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "再怎么样，至少还是会定期换饭菜的吧……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "面对放在取餐处的饭菜，<br>\n三人各自说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative002"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "是那个看守换的饭菜吧。<br>\n我们进不了厨房，所以煮饭也是看守负责的咯？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "我说，可不可以不要勾起别人的想像？<br>\n你害我以后都吃不下饭了欸。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "三人原地散开，<br>\n开始大致搜索一遍食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Narrative003"]}},
    {"op": "HidePrinter", "line": 48, "indent": 0, "params": {}},
