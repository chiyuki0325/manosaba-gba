    {"op": "AnimateActorExtended", "line": 141, "indent": 0, "params": {"ActorIds": ["Ema-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "WaitForNextFrame", "line": 142, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "我也在想这个问题。如果是在禁止外出时间杀人，<br>\n那所有囚犯都有不在场证明。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv31_Ema007"]}},
    {"op": "AnimateActorExtended", "line": 146, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Ema-Front"], "Loop": 0}},
