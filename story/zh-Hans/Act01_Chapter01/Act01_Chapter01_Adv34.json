    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "经过漫长的调查，<br>\n太阳也快要下山了——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative001"]}},
    {"op": "PlaySfxModified", "line": 21, "indent": 0, "params": {"SfxPath": "Sfx_33", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "此时，一道从未听过的<br>\n庄严的钟声响彻整座监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "艾玛、雪莉、汉娜三人一个激灵，<br>\n抬起了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "是钟声……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Hanna001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "难道说……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Sherry001"]}},
    {"op": "PlaySfxModified", "line": 38, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 40, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "『魔女审判即将开始』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative004"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "『请大家务必带好自己的手机，<br>\n　迅速到审判庭集合』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative005"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "『如有不遵守者，将由看守强制带走』<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative006"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "典狱长传来的信息<br>\n和预想中的一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative007"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "（到时间了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "只好过去了呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "雪莉摊开双手耸了耸肩。<br>\n艾玛和汉娜不情不愿地点了点头，开始在过道上移动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative008"]}},
    {"op": "ResetText", "line": 60, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 61, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 62, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PlaySfxModified", "line": 68, "indent": 0, "params": {"SfxPath": "Sfx_165", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 78, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 60.0], "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 79, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 80, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 82, "indent": 0, "params": {"BgmPath": "Bgm_2_1_Loop", "IntroBgmPath": "Bgm_2_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 84, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.7999999523162842, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 85, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 87, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 88, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "她们数次探索这座监牢，<br>\n但因为上锁，从未踏足过这个大房间——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative009"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "而这间大房间，就是审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative010"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "和大厅一样宽阔的室内，中心有一个耐人寻味的底座。<br>\n十数个证人席绕着底座围成了一圈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative011"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "证人席上标记有各自的囚犯编号，<br>\n每个人的座位都已分配好了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative012"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "而出入口大门处，<br>\n看守正在站岗放哨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative013"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "此时，典狱长站在高处的栏杆上，<br>\n开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative014"]}},
    {"op": "ModifyBackgroundExtended", "line": 102, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "AppearanceAndTransition": "13_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "嗯……首先我要说明一下<br>\n魔女审判的规则。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Warden001"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "经过1小时的辩论之后，<br>\n我会请各位用你们的手机投票，选出你们心中认定的凶手。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Warden002"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "而在投票中被选为魔女的人物，<br>\n会被带到中间的底座处，执行处刑……大概就这样。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Warden003"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "11位少女站在证人席上，<br>\n彼此试探着，向对方投去尖锐的视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "（必须要选出一位魔女……<br>\n　可凶手究竟是谁……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "一小时都用不着。<br>\n赶紧投票赶紧结束吧！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 122, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1,ArmL4", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "哎呀，那你愿不愿意自告奋勇<br>\n说自己就是凶手呢？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Margo001"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "这样一来，这事很快就可以结束了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Margo002"]}},
    {"op": "HideAllCharacters", "line": 129, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "……人不是我杀的。你要怀疑随便你，<br>\n但不是我的杀人黑锅，我可不打算背！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 134, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 135, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "哈，我看你就是一副杀过好几个人的样子欸～？<br>\n其实人就是你杀的吧～？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Coco001"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "要不要把票投给亚里沙呢～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Coco002"]}},
    {"op": "HideAllCharacters", "line": 141, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "你这家伙……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Alisa003"]}},
    {"op": "HideAllCharacters", "line": 146, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "少女们很快便火星四溅起来，<br>\n令艾玛感到有些退缩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative016"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "（让我在这种气氛下发言，<br>\n　我做不到……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "艾玛低着头，视线无处安放。<br>\n这时，她看见了旁边的梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative017"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "梅露露一副要哭出来的表情。<br>\n她脸色苍白，身体颤抖着，看着非常害怕这个充满火药味的气氛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative018"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "呜、呜呜……大家好可怕……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Meruru001"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "（梅露露也觉得很害怕）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Ema004"]}},
    {"op": "HideAllCharacters", "line": 162, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "梅露露，没事的。<br>\n我们要相信彼此，互相加油。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Ema005"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "艾玛小声地送去鼓励的话语，<br>\n此时梅露露终于回过神来，抬起了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "嗯、嗯……谢谢你，艾玛小姐。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Meruru002"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "我在这种时候就没法提起坚定的自信心……<br>\n肯定没法作出有意义的发言……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Meruru003"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "所以，<br>\n请让我在一旁支援你吧，艾玛小姐……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Determined2,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "谢谢你！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Ema006"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "艾玛得到了一位近在身边的可靠盟友。她的眼里生出一道希望之光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Narrative020"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "（我不会认输的！我一定要找出凶手！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Ema007"]}},
    {"op": "HideAllCharacters", "line": 186, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "那么，魔女审判现在开庭！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv34_Warden004"]}},
    {"op": "Gosub", "line": 195, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 197, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Trial00", "SoftReset": 1}}
