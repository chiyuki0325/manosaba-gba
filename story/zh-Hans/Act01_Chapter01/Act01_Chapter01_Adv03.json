    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "艾玛马上跟在希罗身后，来到过道上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "等、等我一下，希罗！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "过道上又出现了<br>\n许多名少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative003"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "少女们的视线都集中在了艾玛身上。<br>\n除了希罗，艾玛并未见过这些少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "（太好了……我还在想，<br>\n　要是全部人都是初中的同学，我该怎么办呢……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema002"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "但，所有人的年纪看起来都和自己差不多。<br>\n跟艾玛和希罗一样，她们都身穿奇妙的衣裳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative005"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "而过道前方，一个黑衣异形正在走动着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "（那个异形就是所谓的看守吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema003"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "其他少女也吓得脸色煞白，不知所措，<br>\n只好跟随看守开始移动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative007"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "希罗远远走在了艾玛前边。<br>\n艾玛小跑着追赶着她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "希罗！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema004"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Hiro001"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "听、听我说。虽然发生了这样那样的事，<br>\n不过还能见到希罗你，真是太好了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema005"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "我已经下决心改变了，<br>\n已经不是过去的我了。<br>\n我想和你做朋友。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema006"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Hiro002"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "希罗似乎决意要无视艾玛，<br>\n没有放慢脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "我，我不会放弃的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Hiro003"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "希罗发出咬牙切齿的声音，<br>\n转过身来面向艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "然后，毫不犹豫的推了艾玛一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "呀！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Ema008"]}},
    {"op": "PlaySfxModified", "line": 99, "indent": 0, "params": {"SfxPath": "Sfx_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideActors", "line": 100, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "艾玛当即摔倒在地，<br>\n膝盖擦在坚硬的石地板上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "而动手伤人的希罗<br>\n正恶狠狠地俯视着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative013"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "你改变了，<br>\n跟我有什么关系？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Hiro004"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "我讨厌你的事实不会改变。<br>\n永远不会。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
