    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "唔……", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Unknown001"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "一位水蓝色头发的少女，正兴致勃勃的观察着二人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv03_Narrative015"]}},
