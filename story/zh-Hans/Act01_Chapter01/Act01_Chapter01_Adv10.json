  "path": "Act01_Chapter01/Act01_Chapter01_Adv10",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-6", "line": 4, "indent": 0},
    {"op": "PrintTextModified", "line": 11, "indent": 0, "params": {"Text": "艾玛，艾玛～<br>\n天亮了哦～？快起床啦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry001"]}},
    {"op": "PrintTextModified", "line": 13, "indent": 0, "params": {"Text": "呜呜……嗯……<br>\n我再睡一会……呃，哇呀呀呀！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 15, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCamera", "line": 16, "indent": 0, "params": {"Offset": [0.0, 3.5], "Zoom": 0.699999988079071, "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 17, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 18, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 19, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "艾玛半睁开眼，便看到了雪莉的大脸。<br>\n艾玛吓了一大跳，放声大喊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative001"]}},
    {"op": "PlaySfxModified", "line": 23, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 25, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 26, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 27, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 28, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "她慌慌张张四下看了看。<br>\n这里是牢房里面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "（这果然不是做梦……<br>\n　我真的被抓到这个地方了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "早餐后的放风时间有点长，<br>\n所以我想去探索一下监牢。你要一起来吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry002"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "……嗯，也好。<br>\n我去洗个脸，你等我一下。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema003"]}},
    {"op": "HideAllCharacters", "line": 41, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 47, "indent": 0, "params": {"SfxPath": "Sfx_119", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 57, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 58, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 59, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 61, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 62, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 65, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "艾玛急忙洗好脸，<br>\n和雪莉一起走出牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "（说来，隔壁……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema004"]}},
    {"op": "PlaySfxModified", "line": 78, "indent": 0, "params": {"SfxPath": "Sfx_15", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 82, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 83, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Normal1,ArmR1,ArmL5"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "哼哼哼～哼♪", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Noah001"]}},
    {"op": "HideAllCharacters", "line": 88, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 89, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "（还是老样子，在画画……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema005"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "（安安好像不在……<br>\n　不知道那之后她还有没有事呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema006"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "诺亚在牢房内画的画，又变了一个样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative004"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "喷漆画的细节相当丰富，<br>\n颜色也十分美丽。<br>\n很难相信一个晚上就能画出来这种品质。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "好厉害……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "是气球……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry003"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "雪莉不禁冒出的这句话，<br>\n令艾玛有些疑惑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "气球？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "艾玛你不知道吗？<br>\n“<ruby=\"Balloon\">气球</ruby>”可是世界有名的街头艺术家哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry004"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "据说他的真实身份是个谜，<br>\n从未有人见过他的真面目……没想到他就是诺亚耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry005"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "好厉害好厉害好厉害～！<br>\n诺亚，请你给我签个名！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 123, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 124, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "听到有人喊她，诺亚转过头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative007"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "签名？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Noah002"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "诺亚，你就是【气球】，对吗！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 138, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 139, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Flushed1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "嗯？哦～对哦～？<br>\n嘿嘿～好羞人啊～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Noah003"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 145, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "（真的是……世界有名的艺术家？<br>\n　我只感觉她就是个有些奇怪的女孩……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema009"]}},
    {"op": "ShowToastUI", "line": 151, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 152, "indent": 0, "params": {"Id": "Noah", "Category": "Profile", "Version": 4}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "连这么有名的人也抓来了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "我，我说，她这么有名，<br>\n被抓来这里肯定会出大新闻吧！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema011"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "说来，蕾雅也是艺人欸，肯定会有人讨论失踪的事！<br>\n现在警察肯定在到处找我们！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema012"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "艾玛的口吻就好像抓住了救命稻草一样。<br>\n但雪莉没有被这番说法打动，把头扭到了一边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "究竟会怎样呢？<br>\n我感觉国家有在背后插手这个监牢的事哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry008"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "典狱长也说过了，<br>\n我们是在全国范围的检查被查验到的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry009"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "如果是真的话，那警察应该<br>\n不会出手才对。不如说他们才是帮忙抓人的那一边。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "说不定，<br>\n我们在外面已经被宣布死亡了哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry011"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "雪莉露出清爽的笑容说道，<br>\n好像说出口的事根本不值一提。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "怎么会……那也太奇怪了！<br>\n我们不可以坐以待毙！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema013"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "我们一定要把希罗遇害的消息告诉外面的人！<br>\n我们去联系救援吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "嗯。这个方向也算合理。<br>\n那你就是想准备越狱，对吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry012"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "越狱……对、对啊。<br>\n我们是被误抓到这里来的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema015"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "所以，我们先想想怎样越狱吧……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema016"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "（啊，不过……昨天想逃跑的亚里沙<br>\n　好像一下子就被看守抓住了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema017"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "看守会不会不止一个呢？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema018"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "目前确认到的只有一个吧。<br>\n只要瞒得过看守的眼睛，<br>\n我感觉应该有戏。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry013"]}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "我们对这里的了解也太少了。<br>\n多四处走走，找一下有没有比较好的越狱方法吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Ema019"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "收到！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv10_Sherry014"]}},
    {"op": "SetCustomVariable", "line": 212, "indent": 0, "params": {"Expression": "chosenAreaFlag = 0"}},
    {"op": "Gosub", "line": 213, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 215, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv11", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv10_Sherry001": "艾玛，艾玛～<br>\n天亮了哦～？快起床啦。",
  "0101Adv10_Ema001": "呜呜……嗯……<br>\n我再睡一会……呃，哇呀呀呀！？",
  "0101Adv10_Narrative001": "艾玛半睁开眼，便看到了雪莉的大脸。<br>\n艾玛吓了一大跳，放声大喊。",
  "0101Adv10_Narrative002": "她慌慌张张四下看了看。<br>\n这里是牢房里面。",
  "0101Adv10_Ema002": "（这果然不是做梦……<br>\n　我真的被抓到这个地方了）",
  "0101Adv10_Sherry002": "早餐后的放风时间有点长，<br>\n所以我想去探索一下监牢。你要一起来吗？",
  "0101Adv10_Ema003": "……嗯，也好。<br>\n我去洗个脸，你等我一下。",
  "0101Adv10_Narrative003": "艾玛急忙洗好脸，<br>\n和雪莉一起走出牢房。",
  "0101Adv10_Ema004": "（说来，隔壁……）",
  "0101Adv10_Noah001": "哼哼哼～哼♪",
  "0101Adv10_Ema005": "（还是老样子，在画画……）",
  "0101Adv10_Ema006": "（安安好像不在……<br>\n　不知道那之后她还有没有事呢）",
  "0101Adv10_Narrative004": "诺亚在牢房内画的画，又变了一个样子。",
  "0101Adv10_Narrative005": "喷漆画的细节相当丰富，<br>\n颜色也十分美丽。<br>\n很难相信一个晚上就能画出来这种品质。",
  "0101Adv10_Ema007": "好厉害……",
  "0101Adv10_Sherry003": "是气球……",
  "0101Adv10_Narrative006": "雪莉不禁冒出的这句话，<br>\n令艾玛有些疑惑。",
  "0101Adv10_Ema008": "气球？",
  "0101Adv10_Sherry004": "艾玛你不知道吗？<br>\n“<ruby=\"Balloon\">气球</ruby>”可是世界有名的街头艺术家哦！",
  "0101Adv10_Sherry005": "据说他的真实身份是个谜，<br>\n从未有人见过他的真面目……没想到他就是诺亚耶！",
  "0101Adv10_Sherry006": "好厉害好厉害好厉害～！<br>\n诺亚，请你给我签个名！！",
  "0101Adv10_Narrative007": "听到有人喊她，诺亚转过头来。",
  "0101Adv10_Noah002": "签名？",
  "0101Adv10_Sherry007": "诺亚，你就是【气球】，对吗！？",
  "0101Adv10_Noah003": "嗯？哦～对哦～？<br>\n嘿嘿～好羞人啊～",
  "0101Adv10_Ema009": "（真的是……世界有名的艺术家？<br>\n　我只感觉她就是个有些奇怪的女孩……）",
  "Toast_001": "魔女图鉴 更新…",
  "0101Adv10_Ema010": "连这么有名的人也抓来了……",
  "0101Adv10_Ema011": "我，我说，她这么有名，<br>\n被抓来这里肯定会出大新闻吧！？",
  "0101Adv10_Ema012": "说来，蕾雅也是艺人欸，肯定会有人讨论失踪的事！<br>\n现在警察肯定在到处找我们！",
  "0101Adv10_Narrative008": "艾玛的口吻就好像抓住了救命稻草一样。<br>\n但雪莉没有被这番说法打动，把头扭到了一边。",
  "0101Adv10_Sherry008": "究竟会怎样呢？<br>\n我感觉国家有在背后插手这个监牢的事哦。",
  "0101Adv10_Sherry009": "典狱长也说过了，<br>\n我们是在全国范围的检查被查验到的。",
  "0101Adv10_Sherry010": "如果是真的话，那警察应该<br>\n不会出手才对。不如说他们才是帮忙抓人的那一边。",
  "0101Adv10_Sherry011": "说不定，<br>\n我们在外面已经被宣布死亡了哦。",
  "0101Adv10_Narrative009": "雪莉露出清爽的笑容说道，<br>\n好像说出口的事根本不值一提。",
  "0101Adv10_Ema013": "怎么会……那也太奇怪了！<br>\n我们不可以坐以待毙！",
  "0101Adv10_Ema014": "我们一定要把希罗遇害的消息告诉外面的人！<br>\n我们去联系救援吧！",
  "0101Adv10_Sherry012": "嗯。这个方向也算合理。<br>\n那你就是想准备越狱，对吗？",
  "0101Adv10_Ema015": "越狱……对、对啊。<br>\n我们是被误抓到这里来的。",
  "0101Adv10_Ema016": "所以，我们先想想怎样越狱吧……",
  "0101Adv10_Ema017": "（啊，不过……昨天想逃跑的亚里沙<br>\n　好像一下子就被看守抓住了……）",
  "0101Adv10_Ema018": "看守会不会不止一个呢？",
  "0101Adv10_Sherry013": "目前确认到的只有一个吧。<br>\n只要瞒得过看守的眼睛，<br>\n我感觉应该有戏。",
  "0101Adv10_Ema019": "我们对这里的了解也太少了。<br>\n多四处走走，找一下有没有比较好的越狱方法吧！",
  "0101Adv10_Sherry014": "收到！"
}
}
