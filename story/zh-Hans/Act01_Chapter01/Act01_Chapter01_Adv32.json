    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛她们来到了娱乐室，<br>\n看见正靠在沙发上的可可。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Normal1,ArmR9"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "可可一边打着哈欠，一边看着手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative002"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "喂，我说你，<br>\n这时候大家都在拼命调查，为什么你却在玩手机？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 35, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1,ArmR2"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "哈？烦不烦。<br>\n我现在很忙啦，别管我。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco001"]}},
    {"op": "HideAllCharacters", "line": 40, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "她那副说话口吻<br>\n惹得艾玛也有些生气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Angry1,ArmR2"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "现在可是有人死了欸？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Ema001"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "怎么，要我对一个不认识的死人一把鼻涕一把泪？<br>\n啊我受不了了，也太肉麻了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco002"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "我觉得除了我和我推之外，<br>\n这世上的所有人都该去死。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco003"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "就是说，爱调查还是怎样随便你们。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco004"]}},
    {"op": "HideAllCharacters", "line": 55, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "（总感觉她有点……令人讨厌……<br>\n　感觉跟她聊不来）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Angry1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "你说你很忙，那可可你在忙什么？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Sherry001"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "雪莉没有对可可的态度作出明显反应，<br>\n只是笑着向她问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Normal1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "我在确认昨天直播的回放。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco005"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "（说起来，昨天可可她们好像是办了直播）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "哦！竟然还可以保存回放。<br>\n功能还蛮全的耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Sherry002"]}},
