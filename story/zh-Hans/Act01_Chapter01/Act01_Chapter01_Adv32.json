    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "明明在直播里滔滔不绝讲自己的事……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Ema005"]}},
    {"op": "HideAllCharacters", "line": 111, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "那是两码事。<br>\n唉你们好烦啊！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco008"]}},
    {"op": "PlaySfxModified", "line": 120, "indent": 0, "params": {"SfxPath": "Sfx_32", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "可可“砰”地<br>\n砸了一下桌子，表露出了明显的焦躁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative006"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "我一个人直播的时候<br>\n观众几乎都是零蛋，根本就是完蛋好不好？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco009"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "和蕾雅联动的时候你们倒是会来看！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco010"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "我连蕾雅都不如吗？<br>\n算什么那家伙烦死了。能不能给我去死。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco011"]}},
    {"op": "HideAllCharacters", "line": 130, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "她都答应跟你联动了，<br>\n没必要说得这么过分吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Hanna002"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "我根本没求过她！是她来邀我的好不好！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco012"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "跟你真是没话好说！哼！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Hanna003"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR18,ArmL13"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "算啦算啦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Sherry005"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "雪莉把涨红了脸<br>\n十分生气的汉娜拖走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 146, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "显然，再待在娱乐室，<br>\n吵架只会进一步升级。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "我看这里也没其他线索了，<br>\n走吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 154, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Ema006"]}},
    {"op": "HideAllCharacters", "line": 159, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "到头来也只搞懂了<br>\n可可是坏人这件事。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Sherry007"]}},
