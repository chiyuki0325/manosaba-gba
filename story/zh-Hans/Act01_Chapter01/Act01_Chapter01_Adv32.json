    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "反正对我有意义。<br>\n总之你们以后也要看我直播。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco006"]}},
