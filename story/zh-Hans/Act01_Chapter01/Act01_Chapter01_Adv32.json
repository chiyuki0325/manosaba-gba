    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "（可可的魔法<br>\n　会不会和直播有关呢……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Ema004"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "看来雪莉也在想同样的事情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Narrative005"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "可可的魔法，<br>\n是不是和直播有关系呀？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Angry1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "恶心死。为什么我一定要<br>\n跟你们讲我会什么魔法？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Coco007"]}},
    {"op": "HideAllCharacters", "line": 106, "indent": 0, "params": {"Lazy": 0}},
