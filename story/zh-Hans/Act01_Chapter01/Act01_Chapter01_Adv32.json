    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv32_Ema007"]}},
