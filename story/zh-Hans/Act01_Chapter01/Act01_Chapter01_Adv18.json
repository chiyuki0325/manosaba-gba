    {"op": "QuickSave", "line": 458, "indent": 0, "params": {"SlotNumber": 5, "Wait": 0}},
    {"op": "PrintTextModified", "line": 460, "indent": 0, "params": {"Text": "快逃——！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema025"]}},
    {"op": "PlaySfxModified", "line": 462, "indent": 0, "params": {"SfxPath": "Sfx_71", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 463, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 465, "indent": 0, "params": {"Text": "艾玛话音刚落，<br>\n三人便全力飞奔起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative041"]}},
    {"op": "ModifyCharacterExtended", "line": 467, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Fearful1"}},
    {"op": "PrintTextModified", "line": 469, "indent": 0, "params": {"Text": "到底往哪里逃！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna018"]}},
    {"op": "PrintTextModified", "line": 471, "indent": 0, "params": {"Text": "听到汉娜的呼喊，艾玛她——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative042"]}},
