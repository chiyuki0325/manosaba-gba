{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv18",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-14", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "19_1"}},
    {"op": "PrintTextModified", "line": 8, "indent": 0, "params": {"Text": "监牢的囚犯生活<br>\n来到了第4天——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative001"]}},
    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "今天艾玛和雪莉也约好了，到放风时间<br>\n就一起去探索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative002"]}},
    {"op": "PrintTextModified", "line": 12, "indent": 0, "params": {"Text": "而今天的目标，就是在监牢外面认真转一圈，<br>\n找寻越狱的方法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative003"]}},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "从正门走出外面后，<br>\n艾玛回头望向监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative004"]}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 19, "indent": 0, "params": {"BgmPath": "Ambi_1_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "这就是监牢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "这么看上去，还真是相当坚固啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "嗯……不过能自由外出的话，<br>\n肯定能在什么地方找到逃脱的出口。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema002"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "整个宅邸处在高坡之上。<br>\n而且正如蕾雅所说，<br>\n在艾玛的眼前铺开的这道风景就像绘画一般美丽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative005"]}},
    {"op": "ModifyBackgroundExtended", "line": 38, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "有像怀抱着大地一般，不断往远处延伸的青翠森林——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative006"]}},
    {"op": "ModifyBackgroundExtended", "line": 46, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "16_1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "有盛放着五颜六色花朵的花田——<br>\n她还能听到，从不知什么地方传来溪流的流水声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative007"]}},
    {"op": "ModifyBackgroundExtended", "line": 54, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "19_1"}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "好美丽的地方……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema003"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "每当有风吹过，森林里的树木就像在低声细语般，<br>\n颤动着枝桠上的叶片。<br>\n她还能微微听见远方小鸟的欢唱声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative008"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "这里好宽广耶。<br>\n如果能自由出入的话，<br>\n说不定可以藏身在某个地方。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry002"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "嗯。不过我很在意<br>\n亚里沙说过的【监视猫头鹰】。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema004"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "确实。<br>\n不过看起来这附近没有它们的影子……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "时间有限，<br>\n总之我们四周看看吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "嗯，走吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema005"]}},
    {"op": "StopBgm", "line": 77, "indent": 0, "params": {"BgmPath": "Ambi_1_1", "FadeOutDuration": 5.0}},
    {"op": "HideAllCharacters", "line": 78, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 84, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "22_1"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "沿着石砖地面的道路走，<br>\n能看见监牢旁边有3栋原木屋风格的建筑物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "这里是什么地方……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema006"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "是什么地方呢。我猜是看守的住处……？<br>\n总之进去看看吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 95, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "面前的建筑物的门上<br>\n都挂着耐人寻味的牌子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative010"]}},
    {"op": "ResetText", "line": 103, "indent": 0, "params": {}},
    {"op": "Wait", "line": 104, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCamera", "line": 105, "indent": 0, "params": {"Offset": [-4.0, -2.0], "Zoom": 0.6000000238418579, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 106, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "按照地图的位置，<br>\n这里是【<ruby=\"SALAMANDER\">火精</ruby>之室】……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema007"]}},
    {"op": "ResetText", "line": 114, "indent": 0, "params": {}},
    {"op": "Wait", "line": 115, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCamera", "line": 116, "indent": 0, "params": {"Offset": [5.0, -2.0], "Zoom": 0.699999988079071, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 117, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "这边是【<ruby=\"UNDINE\">水精</ruby>之室】耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry006"]}},
    {"op": "ResetText", "line": 125, "indent": 0, "params": {}},
    {"op": "Wait", "line": 126, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCamera", "line": 127, "indent": 0, "params": {"Offset": [11.0, -2.0], "Zoom": 0.800000011920929, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 128, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "那，这里就是【<ruby=\"GNOME\">地精</ruby>之室】了。<br>\n会有什么不一样呢……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema008"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "她们本以为门应该是锁着的，<br>\n但没想到竟然一下子就打开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative011"]}},
    {"op": "PlaySfxModified", "line": 138, "indent": 0, "params": {"SfxPath": "Sfx_22", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 144, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 145, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 146, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 147, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 149, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "23_2"}},
    {"op": "ModifyBackgroundExtended", "line": 150, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 151, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "建筑物的内部整洁而大方。<br>\n这里看起来不像是日常居住的地方，<br>\n更像是那种专为住宿设计的设施。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "这里比我们的牢房漂亮多了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema009"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR9,ArmL4"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "唔唔唔……这里有可能是<br>\n【招待所】耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry007"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "招待所……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema010"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "如果监牢的运营有国家在幕后参与，<br>\n我想应该会有什么高层领导会来这座监狱视察。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 168, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "哦，是这么一回事啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema011"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "虽然只是我的想像，<br>\n那些领导肯定不愿意住在<br>\n监牢里面。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry009"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "毕竟我们可是会对世界<br>\n造成威胁的可怕魔女。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry010"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "这么一来，如果有领导来视察的话，<br>\n这个情况下，<br>\n他们应该就会住进这些招待所里。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR6,ArmL4"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "哇，有没觉得我的推理实在太妙了！？<br>\n可以的话，真想找到证据～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry012"]}},
    {"op": "HideAllCharacters", "line": 182, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "雪莉一边自卖自夸，<br>\n一边举着放大镜，仔细检查房间里的每一个角落。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 186, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "那、那个，雪莉，<br>\n我想看看其他地方……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema012"]}},
    {"op": "HideAllCharacters", "line": 190, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "最终艾玛只能把<br>\n不情不愿的雪莉从房间里拖了出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative014"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "随后她们稍稍调查了其他招待所，<br>\n得知其室内的构造是一样的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative015"]}},
    {"op": "ModifyBackgroundExtended", "line": 200, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "18_1"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "之后，艾玛她们再走了一会，<br>\n便来到一堵高高的围墙前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative016"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "这堵混凝土围墙不单结实，<br>\n而且还很高，抬头一望看不见尽头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 206, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "如果能到围墙另一边，<br>\n应该可以和外界取得联系吧？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema013"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "说不定可以。<br>\n不过，这超级高的耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry013"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "我试试看能不能爬上去。<br>\n你看，那里有一小块能落脚的地方。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema014"]}},
    {"op": "HideAllCharacters", "line": 215, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "艾玛踩上围墙裂开的地方，<br>\n用力爬了上去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative018"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "虽然能爬到接近她自己身高的位置，<br>\n但艾玛再也找不到更高处的落脚点了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative019"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "呜、呜呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema015"]}},
    {"op": "PlaySfxModified", "line": 227, "indent": 0, "params": {"SfxPath": "Sfx_23", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "她手指力气用尽，<br>\n最终还是落回了地面上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "行不通呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry014"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "记得亚里沙说过，<br>\n围墙上作用着一道神奇力量，<br>\n或许根本就没法让人爬上去。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry015"]}},
    {"op": "HideAllCharacters", "line": 237, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "你们在这里干什么呀？<br>\n万一被看守看见了，可是要被关进惩罚室里的哦。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna001"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "汉娜摆出一副看傻眼的表情，不知从哪里出现了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative021"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "我们根本就不知道<br>\n它们会从什么地方看着我们。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 246, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema016"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "一想到看守有可能藏在了树丛里，<br>\n艾玛便快速地扫视了周遭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative022"]}},
    {"op": "HideAllCharacters", "line": 253, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 254, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "我刚刚去了比较远的地方，<br>\n看到有好多监视的怪物猫头鹰在天上飞。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 258, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 259, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "这附近倒是没见耶。<br>\n也就只有监牢附近<br>\n可以不受监视自由散步了吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry016"]}},
    {"op": "HideAllCharacters", "line": 263, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 264, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "嗯……虽然不清楚准确的机制，<br>\n我猜只要往远处逃，被监视的猫头鹰发现的话，<br>\n看守就会收到联络。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 268, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "猫头鹰的夜间视力应该很好……<br>\n这也是为了提防趁夜色昏暗越狱的囚犯吧。<br>\n唉……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna005"]}},
    {"op": "HideAllCharacters", "line": 272, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "在她们进行对话时，<br>\n艾玛发现，她视野的角落处出现了一个人影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 276, "indent": 0, "params": {"Scale": [0.800000011920929], "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "（是奈叶香……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema017"]}},
    {"op": "HideAllCharacters", "line": 288, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "那人影好像有意掩人耳目，<br>\n马上钻进森林的草丛里，消失不见了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative024"]}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "注意到这件事的，似乎只有艾玛一个。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 294, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 295, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 296, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "汉娜，你刚其实在做什么？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry017"]}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "我也有在找找看，有没有什么地方<br>\n可以逃出这里。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna006"]}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "你有找到逃跑的地方！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema018"]}},
    {"op": "ModifyCharacterExtended", "line": 304, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [45.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "艾玛一下子拉近了和汉娜的距离。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 308, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "可是汉娜好像不喜欢这样的距离感——<br>\n她往后退了一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 312, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [45.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "（嗯……？是我的错觉，对吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema019"]}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "艾玛的内心有些刺痛，<br>\n脸上的表情也变得僵硬起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative028"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "过去朋友的影子在她脑海中浮现，<br>\n和初中时代的讨厌回忆重叠在一起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative029"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "怎么可能那么顺利。你也看到了吧，<br>\n这附近全部都被混凝土高墙围住。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "很遗憾，我们被困在这个地方的事实<br>\n没有任何改变。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna008"]}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "而且走到远处，<br>\n就会碰到时常巡逻的监视猫头鹰……<br>\n唔，安保等级比想像中高好多。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry018"]}},
    {"op": "ModifyCharacterExtended", "line": 328, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "我还发现了一件事。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna009"]}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "什么事？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry019"]}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "这里是座小岛吧。我有闻到一丝海浪的气味……<br>\n把耳朵贴在围墙上，还听到了波浪的声音。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna010"]}},
    {"op": "HideAllCharacters", "line": 336, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "艾玛按照汉娜所说，<br>\n把耳朵贴在围墙上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative030"]}},
    {"op": "StopBgm", "line": 344, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 345, "indent": 0, "params": {"SfxPath": "Sfx_24", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 346, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 347, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 348, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "是真的……！<br>\n说来，我好像记得典狱长也说过，这里是一座【岛】。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema020"]}},
    {"op": "ModifyCharacterExtended", "line": 352, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "雪莉也恍然大悟般拍了拍手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative031"]}},
    {"op": "PrintTextModified", "line": 356, "indent": 0, "params": {"Text": "哦哦！虽然我早有预感了，<br>\n这里一定就是与世隔绝的孤岛！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry020"]}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "我们应该是被迷昏了，然后被人<br>\n用直升机这类运输工具运过来的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry021"]}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "而且整座岛都被围墙围住，<br>\n想逃出这里一定很困难。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna011"]}},
    {"op": "ModifyCharacterExtended", "line": 362, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "怎么会这样……<br>\n就算翻过了围墙，也还有一片大海……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema021"]}},
    {"op": "PlayBgm", "line": 370, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 372, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Fearful1,ArmR4"}},
    {"op": "PrintTextModified", "line": 374, "indent": 0, "params": {"Text": "脸色惨白的汉娜咬着手指头，<br>\n低声自言自语着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative032"]}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "我一定要早点逃出这里……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna012"]}},
    {"op": "PrintTextModified", "line": 378, "indent": 0, "params": {"Text": "汉娜，你、你没事吧？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema022"]}},
    {"op": "ModifyCharacterExtended", "line": 380, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Angry1,ArmR3"}},
    {"op": "PrintTextModified", "line": 382, "indent": 0, "params": {"Text": "——怎么可能没事！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna013"]}},
    {"op": "ModifyCharacterExtended", "line": 386, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema023"]}},
    {"op": "PrintTextModified", "line": 390, "indent": 0, "params": {"Text": "可怕的怪物<br>\n可是时时刻刻都在监视我们哦！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna014"]}},
    {"op": "PrintTextModified", "line": 392, "indent": 0, "params": {"Text": "我已经受够了这个地方了！！<br>\n而且我们以后可能也会变成那样子的怪物——", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna015"]}},
    {"op": "HideAllCharacters", "line": 394, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 400, "indent": 0, "params": {"SfxPath": "Sfx_25", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 401, "indent": 0, "params": {"Path": "ShakeBackground"}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "这时突然响起一道巨大的响声，<br>\n把艾玛和汉娜吓了一跳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative033"]}},
    {"op": "PrintTextModified", "line": 405, "indent": 0, "params": {"Text": "是雪莉她用力地砸了一下围墙。<br>\n气势猛烈的巨响似乎震撼了整堵围墙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative034"]}},
    {"op": "PrintTextModified", "line": 407, "indent": 0, "params": {"Text": "遗憾的是，围墙并没有倒塌。<br>\n甚至连一道裂痕都没有产生。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative035"]}},
    {"op": "PrintTextModified", "line": 409, "indent": 0, "params": {"Text": "雪莉看着艾玛和汉娜，<br>\n吐了一下舌头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative036"]}},
    {"op": "ModifyCharacterExtended", "line": 411, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Smile1,ArmR8,ArmL4"}},
    {"op": "PrintTextModified", "line": 413, "indent": 0, "params": {"Text": "我不忍心看汉娜那么伤心，<br>\n就想试试看能不能砸坏围墙，不过失败了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry022"]}},
    {"op": "PrintTextModified", "line": 415, "indent": 0, "params": {"Text": "这堵围墙，好硬！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry023"]}},
    {"op": "ModifyCharacterExtended", "line": 417, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 419, "indent": 0, "params": {"Text": "竟然想赤手空拳解决问题，你的想法也太不正常了吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Hanna016"]}},
    {"op": "ModifyCharacterExtended", "line": 421, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 423, "indent": 0, "params": {"Text": "雪莉，汉娜……<br>\n大、大事不好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Ema024"]}},
    {"op": "HideAllCharacters", "line": 425, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 427, "indent": 0, "params": {"Text": "艾玛指着茂密树林的方向，<br>\n用颤抖的声音说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative037"]}},
    {"op": "ResetText", "line": 429, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 430, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [2.200000047683716], "Lazy": 0, "ScenePosition": [50.0, 70.0], "AppearanceAndTransition": "18_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 431, "indent": 0, "params": {"Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [30.0, 0.0], "IdAndAppearance": "Jailer.1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 433, "indent": 0, "params": {"Text": "——看守要过来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative038"]}},
    {"op": "ResetText", "line": 435, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 436, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HideActors", "line": 437, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 439, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Fearful1"}},
