    {"op": "HideAllCharacters", "line": 443, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 444, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR7,ArmL1"}},
    {"op": "PrintTextModified", "line": 446, "indent": 0, "params": {"Text": "哎哟。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Sherry024"]}},
    {"op": "HideAllCharacters", "line": 448, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 450, "indent": 0, "params": {"Text": "看守举起了镰刀。<br>\n它的步速比平常还要快。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative039"]}},
    {"op": "PrintTextModified", "line": 452, "indent": 0, "params": {"Text": "它很有可能是听到雪莉砸墙的声音后，<br>\n过来确认情况的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv18_Narrative040"]}},
    {"op": "ModifyCharacterExtended", "line": 454, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1"}},
