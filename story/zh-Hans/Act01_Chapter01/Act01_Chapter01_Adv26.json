  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-22", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛一行人决定前往<br>\n最有可能找到证据的尸体目击现场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "艾玛的步伐十分沉重。<br>\n或许是因为，她非常不愿意直视诺亚的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative002"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "而此时，雪莉的步伐则是一蹦一跳的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 35, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "我说你，是不是太过神经大条了？<br>\n真亏你走路还能一蹦一跳的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "欸，我可是很会察言观色的哦？<br>\n在学校里我知道大家都会避开我，所以我也会主动拉开距离哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry001"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "你这是明显被人孤立了欸？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "没这回事啦！<br>\n大家都很亲切地喊我【小仙子】呢！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry002"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "那绝对不是什么正面称呼啦。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 52, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "（虽然才刚有人过世……<br>\n　不过汉娜能稍微恢复精神，真是太好了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema001"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "看到她们两个在拌嘴的样子，艾玛感到有些暖心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "说起来，昨天晚上<br>\n我们在诺亚房间附近看到亚里沙了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema002"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "听艾玛不经意地说到，<br>\n雪莉非常感兴趣地插进了话题。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "亚里沙和我是同一间房的。我们的房间是最外面的那间，<br>\n她走到里面是不是有别的事呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "我是感觉她看起来有点慌张……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "嗯，我也是。感觉她有点奇怪。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "真令人在意耶～！<br>\n看来很有必要找亚里沙问话了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry004"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（难道是亚里沙把诺亚给……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema004"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "艾玛马上否定了这个念头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative006"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "（单方面断定并不好。<br>\n　还是尽量先调查吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema005"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "在聊着天的时候，<br>\n艾玛一行人不知不觉走到了诺亚的牢房前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative007"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "（诺亚……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema006"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "为了调查，必须认真仔细去观察。<br>\n艾玛忍住泪水，开始观察诺亚的牢房内部。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative008"]}},
    {"op": "ModifyBackgroundExtended", "line": 98, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "270_2"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "冰凉的，再也不会动的诺亚的遗体，<br>\n正躺在房内的正中间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative009"]}},
    {"op": "HideActors", "line": 102, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 103, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "唔，没法进去里面太难办了……<br>\n总之，先拍下现场的照片吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry005"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "雪莉取出手机，<br>\n开始拍摄房内的情况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 117, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "亏你能想得到<br>\n把这么残忍的景象拍下来……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna005"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "因为这是搜查的基础！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry006"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "雪莉神气地说道。然后她好像想到了什么似的，<br>\n举起了食指说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "说来，我们在聊天APP上<br>\n还没有添加好友耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry007"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "在APP上添加了好友后，<br>\n不仅可以传文字信息，还可以通话，<br>\n也可以传图片哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "欸，这样啊……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema007"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "和我们平常用的聊天工具基本一样呢。<br>\n那……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna006"]}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "雪莉和汉娜熟练地将对方添加为好友后，<br>\n转过头面向艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Flushed1"}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "啊、呃、那个……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema008"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "（怎么办，我不知道怎么弄……<br>\n　我用我原来的手机都<br>\n　从没添加过好友……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema009"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "艾玛不知所措，直冒冷汗。<br>\n好在有雪莉和汉娜教她，<br>\n艾玛总算成功添加了好友。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Flushed1"}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "这下子，我和艾玛，还有汉娜<br>\n就可以随时联络了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry009"]}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "嗯。之后也得跟梅露露加一下好友。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema010"]}},
    {"op": "HideAllCharacters", "line": 165, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 171, "indent": 0, "params": {"SfxPath": "Sfx_29", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "雪莉很快就向她们两个<br>\n传了一张图片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative014"]}},
    {"op": "ResetText", "line": 179, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 180, "indent": 0, "params": {"Path": "Clue", "Params": ["1-6"]}},
