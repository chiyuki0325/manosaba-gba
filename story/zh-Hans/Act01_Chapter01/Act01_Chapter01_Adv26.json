    {"op": "Wait", "line": 186, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "SpawnExtended", "line": 192, "indent": 0, "params": {"Path": "Clue", "Params": ["1-8"]}},
    {"op": "ShowToastUI", "line": 193, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 194, "indent": 0, "params": {"Id": "1-8", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 195, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 197, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 198, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "这张水果的照片是……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema011"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "哎呀，这个是我昨天拍的！<br>\n总感觉应该纪念一下！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry010"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "这是要纪念什么东西啊……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna007"]}},
    {"op": "HideAllCharacters", "line": 210, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 211, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "270_2"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "讲完了图片的话题，<br>\n三人继续观察现实里的尸体目击现场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative015"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "地板是一片纯白色，<br>\n这是用诺亚用喷漆弄的，对吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry011"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "嗯，诺亚说她要重新画其他东西。<br>\n所以我猜，她才会把地板先弄成白色的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema012"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "以防万一，艾玛把手伸进了铁栅栏内，<br>\n在摸得到的范围内触碰了一下白色的颜料。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative016"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "（颜料已经干了。<br>\n　我就说肯定是诺亚昨晚涂的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema013"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "既然如此，如果有足迹的话就会相当明显呢。<br>\n但诺亚身边都没看到足迹。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry012"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "那么，不飞在半空中接近诺亚，<br>\n就没法把她杀死耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry013"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna008"]}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "虽然可以透过铁栅栏看到内部，<br>\n但是它的缝隙并不宽，最多只能让手伸进去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative017"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "而诺亚的遗体在室内的中间位置。<br>\n不靠近她本人应该没法杀死她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative018"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "不、不过呢，应该有办法在外面就能杀人。<br>\n啊，你们看！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema014"]}},
    {"op": "ResetText", "line": 235, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 236, "indent": 0, "params": {"Offset": [-6.0, 3.0], "Zoom": 0.5, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 237, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "艾玛指着的，<br>\n是掉落在诺亚遗体附近的一根短箭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative019"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "这不是弩枪的箭吗！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry014"]}},
    {"op": "PlaySfxModified", "line": 247, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 253, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 254, "indent": 0, "params": {"Path": "Clue", "Params": ["1-10"]}},
    {"op": "ShowToastUI", "line": 255, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 256, "indent": 0, "params": {"Id": "1-10", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 257, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "诺亚是被弩枪刺中胸口死掉的……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema015"]}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "可能性相当高！<br>\n而且，也可以证明在房外也能作案。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry015"]}},
    {"op": "ResetText", "line": 263, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 264, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 265, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "（会客厅的弩枪被人偷走了……<br>\n　可能是有人为了杀害诺亚把它拿走的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema016"]}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "（其他我在意的地方……果然还是……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema017"]}},
    {"op": "ResetText", "line": 271, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 272, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 273, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "在如同纯白画布的房间里，<br>\n诺亚身上流出的血迹似乎变成了一幅画。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative020"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "（是蝴蝶的画——为什么会变成这个样子？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema018"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "（或许有什么特殊意义。先把画面拍下来吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema019"]}},
    {"op": "PlaySfxModified", "line": 285, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 291, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 292, "indent": 0, "params": {"Path": "Clue", "Params": ["1-11"]}},
    {"op": "ShowToastUI", "line": 293, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 294, "indent": 0, "params": {"Id": "1-11", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 295, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "真亏你们能一直死盯着现场看……<br>\n反正我感觉很不舒服……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna009"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "（那其实，我现在也非常非常地不舒服……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema020"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "艾玛忍住没让某物冲出喉咙，<br>\n然后摇了摇头。这时她的表情瞬间变得僵硬起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative021"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "没有血液的味道。不对，是因为喷漆的刺鼻气味<br>\n挡住了血腥味……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema021"]}},
    {"op": "ResetText", "line": 305, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 306, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 307, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "因为诺亚生前不断地<br>\n在狭小的牢房里喷洒着颜料喷漆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative022"]}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "即便现在她已过世，房内也仍然充满了喷漆的刺激气味。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative023"]}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "艾玛将手机对准掉落在诺亚身旁的<br>\n喷漆罐，放大焦距后拍下照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative024"]}},
    {"op": "PlaySfxModified", "line": 319, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 325, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 326, "indent": 0, "params": {"Path": "Clue", "Params": ["1-5"]}},
    {"op": "ShowToastUI", "line": 327, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 328, "indent": 0, "params": {"Id": "1-5", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 329, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 331, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 332, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "这下你把所有在意的地方都调查完啦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry016"]}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "嗯。我想应该不会再有其他发现——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema022"]}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "我说，不知道是不是我的错觉，<br>\n你们有没看到地上有一些划痕？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Hanna010"]}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "汉娜不情不愿的举起手指，<br>\n艾玛和雪莉便往她手指的方向看去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative025"]}},
    {"op": "ResetText", "line": 342, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 343, "indent": 0, "params": {"Offset": [8.0, -2.0], "Zoom": 0.5, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 344, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "（真的欸……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema023"]}},
    {"op": "PrintTextModified", "line": 348, "indent": 0, "params": {"Text": "虽然是很轻的痕迹，<br>\n但是能看到白色颜料上有一点点划痕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative026"]}},
    {"op": "PlaySfxModified", "line": 354, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 356, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 357, "indent": 0, "params": {"Path": "Clue", "Params": ["1-9"]}},
    {"op": "ShowToastUI", "line": 358, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 359, "indent": 0, "params": {"Id": "1-9", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 360, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 362, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 363, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ResetText", "line": 369, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 370, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 371, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 373, "indent": 0, "params": {"Text": "虽然可能是错觉，<br>\n不过说不定会有什么特殊意义。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema024"]}},
    {"op": "PrintTextModified", "line": 375, "indent": 0, "params": {"Text": "是啊！侦探的铁则就是怀疑一切！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry017"]}},
    {"op": "HideActors", "line": 385, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 386, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 388, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 390, "indent": 0, "params": {"Text": "那接下来，我们去搜查一下其他地方吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Sherry018"]}},
    {"op": "HideAllCharacters", "line": 392, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 394, "indent": 0, "params": {"Text": "雪莉马上动身出发了，<br>\n但艾玛却留在原地，目光停留在过道的角落处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative027"]}},
    {"op": "ResetText", "line": 396, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 397, "indent": 0, "params": {"Offset": [-4.0, -3.0], "Zoom": 0.699999988079071, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 398, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 400, "indent": 0, "params": {"Text": "——是放在地下过道角落的那个桶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative028"]}},
    {"op": "PrintTextModified", "line": 402, "indent": 0, "params": {"Text": "艾玛往里面看了看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative029"]}},
    {"op": "PrintTextModified", "line": 404, "indent": 0, "params": {"Text": "里面装着的，是从昨天开始就装在里面的，<br>\n拆解得十分零碎的，<br>\n状如机械零件的某些物体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative030"]}},
    {"op": "PrintTextModified", "line": 406, "indent": 0, "params": {"Text": "（虽然昨天并没特别在意，<br>\n　但说不定这也有什么特殊意义）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Ema025"]}},
    {"op": "ResetText", "line": 412, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 413, "indent": 0, "params": {"Path": "Clue", "Params": ["1-1"]}},
    {"op": "ShowToastUI", "line": 414, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 415, "indent": 0, "params": {"Id": "1-1", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 416, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 418, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 419, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyCamera", "line": 421, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 422, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 424, "indent": 0, "params": {"Text": "艾玛她们大致结束了搜查，<br>\n离开了凶杀现场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv26_Narrative031"]}},
    {"op": "Gosub", "line": 431, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 433, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv25", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv26_Narrative001": "艾玛一行人决定前往<br>\n最有可能找到证据的尸体目击现场。",
  "0101Adv26_Narrative002": "艾玛的步伐十分沉重。<br>\n或许是因为，她非常不愿意直视诺亚的尸体。",
  "0101Adv26_Narrative003": "而此时，雪莉的步伐则是一蹦一跳的。",
  "0101Adv26_Hanna001": "我说你，是不是太过神经大条了？<br>\n真亏你走路还能一蹦一跳的。",
  "0101Adv26_Sherry001": "欸，我可是很会察言观色的哦？<br>\n在学校里我知道大家都会避开我，所以我也会主动拉开距离哦。",
  "0101Adv26_Hanna002": "你这是明显被人孤立了欸？",
  "0101Adv26_Sherry002": "没这回事啦！<br>\n大家都很亲切地喊我【小仙子】呢！",
  "0101Adv26_Hanna003": "那绝对不是什么正面称呼啦。",
  "0101Adv26_Ema001": "（虽然才刚有人过世……<br>\n　不过汉娜能稍微恢复精神，真是太好了）",
  "0101Adv26_Narrative004": "看到她们两个在拌嘴的样子，艾玛感到有些暖心。",
  "0101Adv26_Ema002": "说起来，昨天晚上<br>\n我们在诺亚房间附近看到亚里沙了。",
  "0101Adv26_Narrative005": "听艾玛不经意地说到，<br>\n雪莉非常感兴趣地插进了话题。",
  "0101Adv26_Sherry003": "亚里沙和我是同一间房的。我们的房间是最外面的那间，<br>\n她走到里面是不是有别的事呢？",
  "0101Adv26_Hanna004": "我是感觉她看起来有点慌张……",
  "0101Adv26_Ema003": "嗯，我也是。感觉她有点奇怪。",
  "0101Adv26_Sherry004": "真令人在意耶～！<br>\n看来很有必要找亚里沙问话了。",
  "0101Adv26_Ema004": "（难道是亚里沙把诺亚给……？）",
  "0101Adv26_Narrative006": "艾玛马上否定了这个念头。",
  "0101Adv26_Ema005": "（单方面断定并不好。<br>\n　还是尽量先调查吧）",
  "0101Adv26_Narrative007": "在聊着天的时候，<br>\n艾玛一行人不知不觉走到了诺亚的牢房前。",
  "0101Adv26_Ema006": "（诺亚……）",
  "0101Adv26_Narrative008": "为了调查，必须认真仔细去观察。<br>\n艾玛忍住泪水，开始观察诺亚的牢房内部。",
  "0101Adv26_Narrative009": "冰凉的，再也不会动的诺亚的遗体，<br>\n正躺在房内的正中间。",
  "0101Adv26_Sherry005": "唔，没法进去里面太难办了……<br>\n总之，先拍下现场的照片吧。",
  "0101Adv26_Narrative010": "雪莉取出手机，<br>\n开始拍摄房内的情况。",
  "0101Adv26_Hanna005": "亏你能想得到<br>\n把这么残忍的景象拍下来……",
  "0101Adv26_Sherry006": "因为这是搜查的基础！",
  "0101Adv26_Narrative011": "雪莉神气地说道。然后她好像想到了什么似的，<br>\n举起了食指说。",
  "0101Adv26_Sherry007": "说来，我们在聊天APP上<br>\n还没有添加好友耶。",
  "0101Adv26_Sherry008": "在APP上添加了好友后，<br>\n不仅可以传文字信息，还可以通话，<br>\n也可以传图片哦。",
  "0101Adv26_Ema007": "欸，这样啊……！",
  "0101Adv26_Hanna006": "和我们平常用的聊天工具基本一样呢。<br>\n那……",
  "0101Adv26_Narrative012": "雪莉和汉娜熟练地将对方添加为好友后，<br>\n转过头面向艾玛。",
  "0101Adv26_Ema008": "啊、呃、那个……",
  "0101Adv26_Ema009": "（怎么办，我不知道怎么弄……<br>\n　我用我原来的手机都<br>\n　从没添加过好友……！）",
  "0101Adv26_Narrative013": "艾玛不知所措，直冒冷汗。<br>\n好在有雪莉和汉娜教她，<br>\n艾玛总算成功添加了好友。",
  "0101Adv26_Sherry009": "这下子，我和艾玛，还有汉娜<br>\n就可以随时联络了！",
  "0101Adv26_Ema010": "嗯。之后也得跟梅露露加一下好友。",
  "0101Adv26_Narrative014": "雪莉很快就向她们两个<br>\n传了一张图片。",
  "Toast_001": "魔女图鉴 更新…",
  "0101Adv26_Ema011": "这张水果的照片是……？",
  "0101Adv26_Sherry010": "哎呀，这个是我昨天拍的！<br>\n总感觉应该纪念一下！",
  "0101Adv26_Hanna007": "这是要纪念什么东西啊……",
  "0101Adv26_Narrative015": "讲完了图片的话题，<br>\n三人继续观察现实里的尸体目击现场。",
  "0101Adv26_Sherry011": "地板是一片纯白色，<br>\n这是用诺亚用喷漆弄的，对吧。",
  "0101Adv26_Ema012": "嗯，诺亚说她要重新画其他东西。<br>\n所以我猜，她才会把地板先弄成白色的。",
  "0101Adv26_Narrative016": "以防万一，艾玛把手伸进了铁栅栏内，<br>\n在摸得到的范围内触碰了一下白色的颜料。",
  "0101Adv26_Ema013": "（颜料已经干了。<br>\n　我就说肯定是诺亚昨晚涂的）",
  "0101Adv26_Sherry012": "既然如此，如果有足迹的话就会相当明显呢。<br>\n但诺亚身边都没看到足迹。",
  "0101Adv26_Sherry013": "那么，不飞在半空中接近诺亚，<br>\n就没法把她杀死耶！",
  "0101Adv26_Hanna008": "…………",
  "0101Adv26_Narrative017": "虽然可以透过铁栅栏看到内部，<br>\n但是它的缝隙并不宽，最多只能让手伸进去。",
  "0101Adv26_Narrative018": "而诺亚的遗体在室内的中间位置。<br>\n不靠近她本人应该没法杀死她。",
  "0101Adv26_Ema014": "不、不过呢，应该有办法在外面就能杀人。<br>\n啊，你们看！",
  "0101Adv26_Narrative019": "艾玛指着的，<br>\n是掉落在诺亚遗体附近的一根短箭。",
  "0101Adv26_Sherry014": "这不是弩枪的箭吗！？",
  "0101Adv26_Ema015": "诺亚是被弩枪刺中胸口死掉的……？",
  "0101Adv26_Sherry015": "可能性相当高！<br>\n而且，也可以证明在房外也能作案。",
  "0101Adv26_Ema016": "（会客厅的弩枪被人偷走了……<br>\n　可能是有人为了杀害诺亚把它拿走的）",
  "0101Adv26_Ema017": "（其他我在意的地方……果然还是……）",
  "0101Adv26_Narrative020": "在如同纯白画布的房间里，<br>\n诺亚身上流出的血迹似乎变成了一幅画。",
  "0101Adv26_Ema018": "（是蝴蝶的画——为什么会变成这个样子？）",
  "0101Adv26_Ema019": "（或许有什么特殊意义。先把画面拍下来吧）",
  "0101Adv26_Hanna009": "真亏你们能一直死盯着现场看……<br>\n反正我感觉很不舒服……",
  "0101Adv26_Ema020": "（那其实，我现在也非常非常地不舒服……）",
  "0101Adv26_Narrative021": "艾玛忍住没让某物冲出喉咙，<br>\n然后摇了摇头。这时她的表情瞬间变得僵硬起来。",
  "0101Adv26_Ema021": "没有血液的味道。不对，是因为喷漆的刺鼻气味<br>\n挡住了血腥味……",
  "0101Adv26_Narrative022": "因为诺亚生前不断地<br>\n在狭小的牢房里喷洒着颜料喷漆。",
  "0101Adv26_Narrative023": "即便现在她已过世，房内也仍然充满了喷漆的刺激气味。",
  "0101Adv26_Narrative024": "艾玛将手机对准掉落在诺亚身旁的<br>\n喷漆罐，放大焦距后拍下照片。",
  "0101Adv26_Sherry016": "这下你把所有在意的地方都调查完啦？",
  "0101Adv26_Ema022": "嗯。我想应该不会再有其他发现——",
  "0101Adv26_Hanna010": "我说，不知道是不是我的错觉，<br>\n你们有没看到地上有一些划痕？",
  "0101Adv26_Narrative025": "汉娜不情不愿的举起手指，<br>\n艾玛和雪莉便往她手指的方向看去。",
  "0101Adv26_Ema023": "（真的欸……！）",
  "0101Adv26_Narrative026": "虽然是很轻的痕迹，<br>\n但是能看到白色颜料上有一点点划痕。",
  "0101Adv26_Ema024": "虽然可能是错觉，<br>\n不过说不定会有什么特殊意义。",
  "0101Adv26_Sherry017": "是啊！侦探的铁则就是怀疑一切！",
  "0101Adv26_Sherry018": "那接下来，我们去搜查一下其他地方吧。",
  "0101Adv26_Narrative027": "雪莉马上动身出发了，<br>\n但艾玛却留在原地，目光停留在过道的角落处。",
  "0101Adv26_Narrative028": "——是放在地下过道角落的那个桶。",
  "0101Adv26_Narrative029": "艾玛往里面看了看。",
  "0101Adv26_Narrative030": "里面装着的，是从昨天开始就装在里面的，<br>\n拆解得十分零碎的，<br>\n状如机械零件的某些物体。",
  "0101Adv26_Ema025": "（虽然昨天并没特别在意，<br>\n　但说不定这也有什么特殊意义）",
  "0101Adv26_Narrative031": "艾玛她们大致结束了搜查，<br>\n离开了凶杀现场。"
}
}
