  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-8", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "11_1"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛她们来到了二楼的娱乐室。<br>\n这里应该是囚犯最常来的地方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "呀，这里正是适合休息的地方耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "宽广的室内铺着柔软的地毯，<br>\n设置有舒适宜居的沙发。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "这里的设备一应俱全。有西洋棋、桌游、桌球台……<br>\n连大型银幕和投影机都有。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "有人比艾玛她们先到这里。<br>\n是佐伯米莉亚，她正坐在沙发上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative004"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "艾玛和雪莉的视线自然而然<br>\n转向米莉亚身上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative005"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "她正在银幕上<br>\n播放着8mm胶片里的黑白电影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative006"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "……唉。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Miria001"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "米莉亚发出一声忧郁的叹息。她几乎没在看电影，<br>\n而是面露困倦地按着手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative007"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "米莉亚的手机上<br>\n也装着一个亮晶晶的豪华保护套，<br>\n看起来相当衬她的外表。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative008"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "你不觉得有点安心吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry002"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "欸？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "哎呀，就是感觉，学校里面常见的女孩子就是这个样子的啦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "（确实……感觉她应该属于班上最引人注目的小团体……<br>\n　是我从来不敢搭话的那类人……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema002"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "——接着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Surprised1,ArmR1,ArmL4"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "哇啊！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Miria002"]}},
    {"op": "HideAllCharacters", "line": 73, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "米莉亚的肩膀忽然夸张地颤抖了一下，<br>\n害艾玛和雪莉也吓了一跳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Surprised1"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "你怎么啦米莉亚！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "啊，呃……叫什么来着。<br>\n不好意思，我还记不太清楚你们的长相和名字。对不起啦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Miria003"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "面对刚来的艾玛和雪莉，<br>\n米莉亚露出了不知所措的神色。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "我叫橘雪莉，她是樱羽艾玛。<br>\n我说，你刚才是被什么吓到了？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry005"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "是、是吗。我刚刚在看手机，<br>\n突然有个猫耳女孩子出现在屏幕上。<br>\n你们的手机应该也可以看到。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Miria004"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "（出现在手机里……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema003"]}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "艾玛打开了自己的手机。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative012"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "接着，她就看到囚犯名单上的“泽渡可可”那边<br>\n显示“正在直播”。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative013"]}},
    {"op": "ResetText", "line": 103, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 104, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 105, "indent": 0, "params": {"Scale": [1.399999976158142], "Lazy": 0, "ScenePosition": [50.0, 40.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 106, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "Intensity": 0.5, "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Scale": [1.600000023841858], "Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Coco.Normal1", "SubId": "Middle"}},
    {"op": "Wait", "line": 108, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "点开之后，<br>\n可可的大脸立刻占领了整个屏幕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative014"]}},
    {"op": "ResetText", "line": 112, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 113, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "HideActors", "line": 117, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Coco-Middle"], "Lazy": 0}},
    {"op": "Wait", "line": 118, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "哇啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema004"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "（和米莉亚做了一模一样的反应……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema005"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "欸～这个APP居然还可以直播耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry006"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "雪莉看着自己的手机，十分感慨地说道。<br>\n这时，画面里神情兴奋的可可也开始发言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative015"]}},
    {"op": "ResetText", "line": 130, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 131, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"Scale": [1.399999976158142], "Lazy": 0, "ScenePosition": [50.0, 40.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Scale": [1.600000023841858], "Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Coco.Smile1", "SubId": "Middle"}},
    {"op": "Wait", "line": 134, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "大家好～我是可可碳～！<br>\n今天开始我会经常开直播～！记得多来看哦～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Coco001"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "哦，在线观众3个！<br>\n看来开了个好头？请多多转发推介哦！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Coco002"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "可最多也只能同时在线11个人耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry007"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "这个是不能直说的吧……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "首先是，嗯……从我的兴趣讲起吧。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "我的兴趣就是推活哦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "推活正是我的人生！除了我推都没有活着的价值！<br>\n其他人全都给我去死！就这样子——", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Coco005"]}},
    {"op": "ResetText", "line": 164, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 165, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "HideActors", "line": 166, "indent": 0, "params": {"ActorIds": ["Sherry", "Ema", "Miria"], "Duration": 0.0, "Lazy": 0}},
    {"op": "HideActors", "line": 167, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Coco-Middle"], "Lazy": 0}},
    {"op": "Wait", "line": 168, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "在场所有人几乎同时<br>\n关闭了直播。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1,ArmR3,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "根本浪费时间呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "这个是不能直说的吧……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema007"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "现场所有人达成了共识：<br>\n泽渡可可毫无作为直播主的吸引力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "究竟为什么会有直播的功能呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema008"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "算是某种程度的安慰剂吧？<br>\n毕竟是我们日常生活会见到的东西。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry009"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "那可不可以当联络外部的手段……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema009"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "不行吧，<br>\n幕后黑手不至于这么笨。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "说得也对……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema010"]}},
    {"op": "HideAllCharacters", "line": 198, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "艾玛和雪莉重整旗鼓，<br>\n开始探索娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative018"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "艾玛往收纳柜里瞧了瞧，<br>\n里面放满了老旧的胶片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative019"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "（米莉亚竟然懂得怎么播放<br>\n　这么老的电影……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema011"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "坐在沙发上的米莉亚，<br>\n精神散漫地看着黑白电影，一动也不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 208, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Pensive1,ArmR6,ArmL1"}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "唉……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Miria005"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "（感觉……她是不是有些心病……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Ema012"]}},
    {"op": "HideAllCharacters", "line": 214, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "艾玛和雪莉再也没找到值得关注的事物，<br>\n于是便离开了娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv12_Narrative021"]}},
    {"op": "Gosub", "line": 223, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 225, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv11", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv12_Narrative001": "艾玛她们来到了二楼的娱乐室。<br>\n这里应该是囚犯最常来的地方。",
  "0101Adv12_Sherry001": "呀，这里正是适合休息的地方耶！",
  "0101Adv12_Narrative002": "宽广的室内铺着柔软的地毯，<br>\n设置有舒适宜居的沙发。",
  "0101Adv12_Narrative003": "这里的设备一应俱全。有西洋棋、桌游、桌球台……<br>\n连大型银幕和投影机都有。",
  "0101Adv12_Narrative004": "有人比艾玛她们先到这里。<br>\n是佐伯米莉亚，她正坐在沙发上。",
  "0101Adv12_Narrative005": "艾玛和雪莉的视线自然而然<br>\n转向米莉亚身上。",
  "0101Adv12_Narrative006": "她正在银幕上<br>\n播放着8mm胶片里的黑白电影。",
  "0101Adv12_Miria001": "……唉。",
  "0101Adv12_Narrative007": "米莉亚发出一声忧郁的叹息。她几乎没在看电影，<br>\n而是面露困倦地按着手机。",
  "0101Adv12_Narrative008": "米莉亚的手机上<br>\n也装着一个亮晶晶的豪华保护套，<br>\n看起来相当衬她的外表。",
  "0101Adv12_Sherry002": "你不觉得有点安心吗？",
  "0101Adv12_Ema001": "欸？",
  "0101Adv12_Sherry003": "哎呀，就是感觉，学校里面常见的女孩子就是这个样子的啦。",
  "0101Adv12_Ema002": "（确实……感觉她应该属于班上最引人注目的小团体……<br>\n　是我从来不敢搭话的那类人……）",
  "0101Adv12_Narrative009": "——接着。",
  "0101Adv12_Miria002": "哇啊！",
  "0101Adv12_Narrative010": "米莉亚的肩膀忽然夸张地颤抖了一下，<br>\n害艾玛和雪莉也吓了一跳。",
  "0101Adv12_Sherry004": "你怎么啦米莉亚！？",
  "0101Adv12_Miria003": "啊，呃……叫什么来着。<br>\n不好意思，我还记不太清楚你们的长相和名字。对不起啦。",
  "0101Adv12_Narrative011": "面对刚来的艾玛和雪莉，<br>\n米莉亚露出了不知所措的神色。",
  "0101Adv12_Sherry005": "我叫橘雪莉，她是樱羽艾玛。<br>\n我说，你刚才是被什么吓到了？",
  "0101Adv12_Miria004": "是、是吗。我刚刚在看手机，<br>\n突然有个猫耳女孩子出现在屏幕上。<br>\n你们的手机应该也可以看到。",
  "0101Adv12_Ema003": "（出现在手机里……？）",
  "0101Adv12_Narrative012": "艾玛打开了自己的手机。<br>",
  "0101Adv12_Narrative013": "接着，她就看到囚犯名单上的“泽渡可可”那边<br>\n显示“正在直播”。",
  "0101Adv12_Narrative014": "点开之后，<br>\n可可的大脸立刻占领了整个屏幕。",
  "0101Adv12_Ema004": "哇啊！",
  "0101Adv12_Ema005": "（和米莉亚做了一模一样的反应……）",
  "0101Adv12_Sherry006": "欸～这个APP居然还可以直播耶！",
  "0101Adv12_Narrative015": "雪莉看着自己的手机，十分感慨地说道。<br>\n这时，画面里神情兴奋的可可也开始发言。",
  "0101Adv12_Coco001": "大家好～我是可可碳～！<br>\n今天开始我会经常开直播～！记得多来看哦～！",
  "0101Adv12_Coco002": "哦，在线观众3个！<br>\n看来开了个好头？请多多转发推介哦！",
  "0101Adv12_Sherry007": "可最多也只能同时在线11个人耶。",
  "0101Adv12_Ema006": "这个是不能直说的吧……",
  "0101Adv12_Coco003": "首先是，嗯……从我的兴趣讲起吧。",
  "0101Adv12_Coco004": "我的兴趣就是推活哦。",
  "0101Adv12_Coco005": "推活正是我的人生！除了我推都没有活着的价值！<br>\n其他人全都给我去死！就这样子——",
  "0101Adv12_Narrative016": "在场所有人几乎同时<br>\n关闭了直播。",
  "0101Adv12_Sherry008": "根本浪费时间呢。",
  "0101Adv12_Ema007": "这个是不能直说的吧……",
  "0101Adv12_Narrative017": "现场所有人达成了共识：<br>\n泽渡可可毫无作为直播主的吸引力。",
  "0101Adv12_Ema008": "究竟为什么会有直播的功能呢。",
  "0101Adv12_Sherry009": "算是某种程度的安慰剂吧？<br>\n毕竟是我们日常生活会见到的东西。",
  "0101Adv12_Ema009": "那可不可以当联络外部的手段……",
  "0101Adv12_Sherry010": "不行吧，<br>\n幕后黑手不至于这么笨。",
  "0101Adv12_Ema010": "说得也对……",
  "0101Adv12_Narrative018": "艾玛和雪莉重整旗鼓，<br>\n开始探索娱乐室。",
  "0101Adv12_Narrative019": "艾玛往收纳柜里瞧了瞧，<br>\n里面放满了老旧的胶片。",
  "0101Adv12_Ema011": "（米莉亚竟然懂得怎么播放<br>\n　这么老的电影……）",
  "0101Adv12_Narrative020": "坐在沙发上的米莉亚，<br>\n精神散漫地看着黑白电影，一动也不动。",
  "0101Adv12_Miria005": "唉……",
  "0101Adv12_Ema012": "（感觉……她是不是有些心病……？）",
  "0101Adv12_Narrative021": "艾玛和雪莉再也没找到值得关注的事物，<br>\n于是便离开了娱乐室。"
}
}
