    {"op": "label", "name": "Scene1-1-b2", "line": 13, "indent": 0},
    {"op": "HideActors", "line": 19, "indent": 0, "params": {"ActorIds": ["Alisa-Front", "MainBackground-Front", "Ema-Middle"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 20, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "ModifyBackgroundExtended", "line": 23, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "HideActors", "line": 24, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "MainBackground-Middle"], "Lazy": 0}},
    {"op": "PlayBgm", "line": 25, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "跟随在了看守和亚里沙的身后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "根据地图，可以得知过道的尽头是惩罚室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "（说不定亚里沙她<br>\n　违反了某些规定）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "（毕竟她说过要逃出这里……<br>\n　也许是因为策划逃跑才会被抓的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema002"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "（惩罚室……<br>\n　肯定会在里面遭受可怕的惩罚吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema003"]}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "说不定，会跟希罗一样——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "回想起沾满血迹的会客厅，<br>\n艾玛浑身颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative004"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "（应该没事吧……<br>\n　亚里沙也没有很激烈地反抗）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "一定不会被杀的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema005"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "艾玛自言自语着，就好像在说给她自己听一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 51, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 53, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 54, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 55, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 57, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 80.0], "AppearanceAndTransition": "3_2"}},
    {"op": "Wait", "line": 58, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyBackgroundExtended", "line": 59, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.9900000095367432, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 60, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 62, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "（这里就是惩罚室……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema006"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "这里并排着几扇厚实的门，每扇门都用挂锁封闭着。<br>\n相比囚犯的房间，这里的空气显得更加沉重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "过道上除了艾玛之外，别无他人。<br>\n说不定亚里沙已经被关进<br>\n房间里面了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "亚里沙……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema007"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "艾玛用颤抖的声音，轻轻呼喊亚里沙的名字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative008"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "就算亚里沙人在里面某处，<br>\n只凭目前的音量，根本无法传达。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "当然，此时不应该会有回应——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative010"]}},
    {"op": "HidePrinter", "line": 79, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 80, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "3_2", "SubId": "Middle"}},
    {"op": "PlaySfxModified", "line": 83, "indent": 0, "params": {"SfxPath": "Sfx_75", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "噫……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema008"]}},
    {"op": "ResetText", "line": 87, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 88, "indent": 0, "params": {"Offset": [2.0, -4.0], "Zoom": 0.6000000238418579, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 89, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "紧贴在艾玛眼前的这道惩罚室的门，<br>\n发出了巨大声响，自行打开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "艾玛摆好了姿势，以为会有人从里面走出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema009"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "不过，等了好一会，<br>\n也不见有人出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema010"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "感到异状的艾玛靠近了门，<br>\n战战兢兢地往室内看去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema011"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "艾玛用手捂住嘴巴，<br>\n好止住不自觉发出的喊声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative015"]}},
    {"op": "ResetText", "line": 107, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 108, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 109, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "她看见惩罚室内那些充满邪恶气息的工具，不禁浑身颤抖，<br>\n往后退了一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative016"]}},
    {"op": "StopBgm", "line": 113, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 116, "indent": 0, "params": {"SfxPath": "Sfx_76", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "欸？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema012"]}},
    {"op": "PlaySfxModified", "line": 121, "indent": 0, "params": {"SfxPath": "Sfx_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 122, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "21_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "背后有什么推了她一把，害艾玛跌倒在惩罚室内。<br>\n等她回头一看，发现房门正要关上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "等、等下！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema013"]}},
    {"op": "PlaySfxModified", "line": 131, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 133, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "艾玛慌忙爬起身来，<br>\n但惩罚室的厚重房门已在她眼前紧紧闭上了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "开门啊！为什么要把我关在里面！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema014"]}},
    {"op": "HideAllCharacters", "line": 141, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "艾玛大喊着，但没有得到任何回应。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative019"]}},
    {"op": "ModifyBackgroundExtended", "line": 145, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "“被关在室内”这一情况，<br>\n唤醒了艾玛脑海深处的痛苦记忆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative020"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "在初中时期，她被人关在厕所的隔间，<br>\n或者是体育用品仓库里面——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative021"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "在厕所里，她被人从上方洒水或者丢垃圾。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative022"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "在体育仓库里，则是好几个小时无法外出。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative023"]}},
    {"op": "PlayBgm", "line": 156, "indent": 0, "params": {"BgmPath": "Ambi_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "充满恶意的嘲笑，<br>\n如今仍萦绕在艾玛的耳边，不见消散。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative024"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "住手呀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative025"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "住手住手住手住手住手！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative026"]}},
    {"op": "ModifyBackgroundExtended", "line": 164, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 165, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PlaySfxModified", "line": 168, "indent": 0, "params": {"SfxPath": "Sfx_77", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "开门啊！为什么要做这样的事！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema015"]}},
    {"op": "PlaySfxModified", "line": 173, "indent": 0, "params": {"SfxPath": "Sfx_77", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "不管艾玛怎样叫喊，<br>\n门再也不会开了——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative027"]}},
    {"op": "ResetText", "line": 177, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 179, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 181, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 182, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 184, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 185, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "艾玛无力地躺倒在惩罚室的地面上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative028"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "（……究竟过了有多久呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema016"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "她在想，被关进来后<br>\n究竟过了多长的时间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative029"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "不知为何，在惩罚室里无法打开手机的电源，<br>\n没法使用。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative030"]}},
    {"op": "PlaySfxModified", "line": 196, "indent": 0, "params": {"SfxPath": "Sfx_78", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema017"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "她似乎听见了门的另一侧传来了脚步声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative031"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "艾玛使出全力站起身来，<br>\n用门支撑住身体，竖起耳朵仔细倾听。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative032"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "这里是怎么回事……<br>\n不觉得空气超级沉重吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Hanna001"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "是吗？我倒是没什么特别感觉耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "（汉娜，雪莉！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema018"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "在饱受绝望折磨的艾玛眼前，出现了一道希望之光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative033"]}},
    {"op": "ModifyCharacterExtended", "line": 216, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3,ArmL7", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "救救我！求你们！放我出去！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema019"]}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "在门上的小窗处，艾玛拼命喊道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative034"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "汉娜！雪莉！我在这里！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema020"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "不知二人是不是听到了她的呼声，<br>\n她们来到了艾玛所在的房间前。<br>\n接着，雪莉往里面看了看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative035"]}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL7", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "雪莉！太好了……！<br>\n不知道为什么，我被关进了这里面……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema021"]}},
    {"op": "HideAllCharacters", "line": 230, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "艾玛感受到了异样，于是停下了话语。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative036"]}},
    {"op": "ResetText", "line": 234, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 235, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 236, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 237, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [28.0, 36.0], "AppearanceAndTransition": "3_2", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 238, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 20.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 240, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Sherry-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 241, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "25", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 242, "indent": 0, "params": {"ActorIds": ["Sherry-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 243, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "唔～～～～……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Sherry002"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "毫无疑问，雪莉正在探视室内。<br>\n只不过，她的眼睛似乎<br>\n完全没有看见艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative037"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "为什……么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema022"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "怎么啦？<br>\n难道里面有人……！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Hanna002"]}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "不，一个人都没有哦～<br>\n不过，倒是有很多不得了的刑具呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Sherry003"]}},
    {"op": "HideActors", "line": 258, "indent": 0, "params": {"ActorIds": ["Sherry-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 259, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 260, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 261, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PlaySfxModified", "line": 264, "indent": 0, "params": {"SfxPath": "Sfx_78", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "雪莉和汉娜远离了房门，<br>\n径直离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative038"]}},
    {"op": "ModifyCharacterExtended", "line": 268, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3,ArmL7", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "怎么会这样……等一下啊！<br>\n雪莉！汉娜！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema023"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "你们有看到吧！？你们有听见吧！？<br>\n我可是在这里啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema024"]}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "为什么……为什么呀……？<br>\n这根本就是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema025"]}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "把我无视掉了吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative039"]}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR6,ArmL6", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "明明……我在这里……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema026"]}},
    {"op": "PlayBgm", "line": 283, "indent": 0, "params": {"BgmPath": "Ambi_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "艾玛在脑海中听见了少女们的声音。<br>\n那些笑声好像在嘲笑她一样，不断在脑海中回荡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative040"]}},
    {"op": "ModifyCharacterExtended", "line": 287, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Cry1,ArmR11,ArmL15", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "吵死了……<br>\n吵死了吵死了吵死了吵死了吵死了！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema027"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "而嘲笑声最终转变成了责骂艾玛的话语。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative041"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "住口啊！我没有做错事……我没有！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema028"]}},
    {"op": "HideAllCharacters", "line": 295, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "艾玛拿起手边的拷问器具，<br>\n无数次敲打惩罚室的房门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative042"]}},
    {"op": "PlaySfxModified", "line": 300, "indent": 0, "params": {"SfxPath": "Sfx_79", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "啊啊啊啊啊啊！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema029"]}},
    {"op": "StopBgm", "line": 304, "indent": 0, "params": {"FadeOutDuration": 2.0}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "忽然间，艾玛理解了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative043"]}},
    {"op": "ModifyCharacterExtended", "line": 308, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "自己正被所有人讨厌，自己正被世界讨厌。<br>\n如此遭人讨厌的自己，肯定是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative044"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "去死比较好。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative045"]}},
    {"op": "ModifyCharacterExtended", "line": 314, "indent": 0, "params": {"Duration": 1.2000000476837158, "Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL1", "SubId": "Middle"}},
    {"op": "Wait", "line": 315, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 317, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema030"]}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "艾玛盯着手上的拷问器具，<br>\n露出了笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative046"]}},
    {"op": "PrintTextModified", "line": 321, "indent": 0, "params": {"Text": "那是一根铁棒，其中一端锋利且尖锐——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Narrative047"]}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "这不是正好吗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad02_Ema031"]}},
    {"op": "HidePrinter", "line": 325, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 326, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 328, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 329, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PlaySfxModified", "line": 332, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 334, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 337, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 339, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ProcessBadEnd", "line": 345, "indent": 0, "params": {"Number": 2}}
  ],
  "translations": {
  "0101Bad02_Narrative001": "跟随在了看守和亚里沙的身后。",
  "0101Bad02_Narrative002": "根据地图，可以得知过道的尽头是惩罚室。",
  "0101Bad02_Ema001": "（说不定亚里沙她<br>\n　违反了某些规定）",
  "0101Bad02_Ema002": "（毕竟她说过要逃出这里……<br>\n　也许是因为策划逃跑才会被抓的）",
  "0101Bad02_Ema003": "（惩罚室……<br>\n　肯定会在里面遭受可怕的惩罚吧）",
  "0101Bad02_Narrative003": "说不定，会跟希罗一样——",
  "0101Bad02_Narrative004": "回想起沾满血迹的会客厅，<br>\n艾玛浑身颤抖。",
  "0101Bad02_Ema004": "（应该没事吧……<br>\n　亚里沙也没有很激烈地反抗）",
  "0101Bad02_Ema005": "一定不会被杀的。",
  "0101Bad02_Narrative005": "艾玛自言自语着，就好像在说给她自己听一样。",
  "0101Bad02_Ema006": "（这里就是惩罚室……）",
  "0101Bad02_Narrative006": "这里并排着几扇厚实的门，每扇门都用挂锁封闭着。<br>\n相比囚犯的房间，这里的空气显得更加沉重。",
  "0101Bad02_Narrative007": "过道上除了艾玛之外，别无他人。<br>\n说不定亚里沙已经被关进<br>\n房间里面了。",
  "0101Bad02_Ema007": "亚里沙……？",
  "0101Bad02_Narrative008": "艾玛用颤抖的声音，轻轻呼喊亚里沙的名字。",
  "0101Bad02_Narrative009": "就算亚里沙人在里面某处，<br>\n只凭目前的音量，根本无法传达。",
  "0101Bad02_Narrative010": "当然，此时不应该会有回应——",
  "0101Bad02_Ema008": "噫……",
  "0101Bad02_Narrative011": "紧贴在艾玛眼前的这道惩罚室的门，<br>\n发出了巨大声响，自行打开了。",
  "0101Bad02_Narrative012": "艾玛摆好了姿势，以为会有人从里面走出来。",
  "0101Bad02_Ema009": "…………",
  "0101Bad02_Narrative013": "不过，等了好一会，<br>\n也不见有人出来。",
  "0101Bad02_Ema010": "……？",
  "0101Bad02_Narrative014": "感到异状的艾玛靠近了门，<br>\n战战兢兢地往室内看去。",
  "0101Bad02_Ema011": "！！",
  "0101Bad02_Narrative015": "艾玛用手捂住嘴巴，<br>\n好止住不自觉发出的喊声。",
  "0101Bad02_Narrative016": "她看见惩罚室内那些充满邪恶气息的工具，不禁浑身颤抖，<br>\n往后退了一步。",
  "0101Bad02_Ema012": "欸？",
  "0101Bad02_Narrative017": "背后有什么推了她一把，害艾玛跌倒在惩罚室内。<br>\n等她回头一看，发现房门正要关上。",
  "0101Bad02_Ema013": "等、等下！",
  "0101Bad02_Narrative018": "艾玛慌忙爬起身来，<br>\n但惩罚室的厚重房门已在她眼前紧紧闭上了。",
  "0101Bad02_Ema014": "开门啊！为什么要把我关在里面！？",
  "0101Bad02_Narrative019": "艾玛大喊着，但没有得到任何回应。",
  "0101Bad02_Narrative020": "“被关在室内”这一情况，<br>\n唤醒了艾玛脑海深处的痛苦记忆。",
  "0101Bad02_Narrative021": "在初中时期，她被人关在厕所的隔间，<br>\n或者是体育用品仓库里面——",
  "0101Bad02_Narrative022": "在厕所里，她被人从上方洒水或者丢垃圾。",
  "0101Bad02_Narrative023": "在体育仓库里，则是好几个小时无法外出。",
  "0101Bad02_Narrative024": "充满恶意的嘲笑，<br>\n如今仍萦绕在艾玛的耳边，不见消散。",
  "0101Bad02_Narrative025": "住手呀。",
  "0101Bad02_Narrative026": "住手住手住手住手住手！",
  "0101Bad02_Ema015": "开门啊！为什么要做这样的事！",
  "0101Bad02_Narrative027": "不管艾玛怎样叫喊，<br>\n门再也不会开了——",
  "0101Bad02_Narrative028": "艾玛无力地躺倒在惩罚室的地面上。",
  "0101Bad02_Ema016": "（……究竟过了有多久呢）",
  "0101Bad02_Narrative029": "她在想，被关进来后<br>\n究竟过了多长的时间。",
  "0101Bad02_Narrative030": "不知为何，在惩罚室里无法打开手机的电源，<br>\n没法使用。",
  "0101Bad02_Ema017": "！！",
  "0101Bad02_Narrative031": "她似乎听见了门的另一侧传来了脚步声。",
  "0101Bad02_Narrative032": "艾玛使出全力站起身来，<br>\n用门支撑住身体，竖起耳朵仔细倾听。",
  "0101Bad02_Hanna001": "这里是怎么回事……<br>\n不觉得空气超级沉重吗？",
  "0101Bad02_Sherry001": "是吗？我倒是没什么特别感觉耶。",
  "0101Bad02_Ema018": "（汉娜，雪莉！）",
  "0101Bad02_Narrative033": "在饱受绝望折磨的艾玛眼前，出现了一道希望之光。",
  "0101Bad02_Ema019": "救救我！求你们！放我出去！",
  "0101Bad02_Narrative034": "在门上的小窗处，艾玛拼命喊道。",
  "0101Bad02_Ema020": "汉娜！雪莉！我在这里！",
  "0101Bad02_Narrative035": "不知二人是不是听到了她的呼声，<br>\n她们来到了艾玛所在的房间前。<br>\n接着，雪莉往里面看了看。",
  "0101Bad02_Ema021": "雪莉！太好了……！<br>\n不知道为什么，我被关进了这里面……",
  "0101Bad02_Narrative036": "艾玛感受到了异样，于是停下了话语。",
  "0101Bad02_Sherry002": "唔～～～～……",
  "0101Bad02_Narrative037": "毫无疑问，雪莉正在探视室内。<br>\n只不过，她的眼睛似乎<br>\n完全没有看见艾玛。",
  "0101Bad02_Ema022": "为什……么……？",
  "0101Bad02_Hanna002": "怎么啦？<br>\n难道里面有人……！？",
  "0101Bad02_Sherry003": "不，一个人都没有哦～<br>\n不过，倒是有很多不得了的刑具呢。",
  "0101Bad02_Narrative038": "雪莉和汉娜远离了房门，<br>\n径直离开了。",
  "0101Bad02_Ema023": "怎么会这样……等一下啊！<br>\n雪莉！汉娜！",
  "0101Bad02_Ema024": "你们有看到吧！？你们有听见吧！？<br>\n我可是在这里啊！",
  "0101Bad02_Ema025": "为什么……为什么呀……？<br>\n这根本就是……",
  "0101Bad02_Narrative039": "把我无视掉了吧。",
  "0101Bad02_Ema026": "明明……我在这里……",
  "0101Bad02_Narrative040": "艾玛在脑海中听见了少女们的声音。<br>\n那些笑声好像在嘲笑她一样，不断在脑海中回荡。",
  "0101Bad02_Ema027": "吵死了……<br>\n吵死了吵死了吵死了吵死了吵死了！！",
  "0101Bad02_Narrative041": "而嘲笑声最终转变成了责骂艾玛的话语。",
  "0101Bad02_Ema028": "住口啊！我没有做错事……我没有！",
  "0101Bad02_Narrative042": "艾玛拿起手边的拷问器具，<br>\n无数次敲打惩罚室的房门。",
  "0101Bad02_Ema029": "啊啊啊啊啊啊！！",
  "0101Bad02_Narrative043": "忽然间，艾玛理解了。",
  "0101Bad02_Narrative044": "自己正被所有人讨厌，自己正被世界讨厌。<br>\n如此遭人讨厌的自己，肯定是——",
  "0101Bad02_Narrative045": "去死比较好。",
  "0101Bad02_Ema030": "…………",
  "0101Bad02_Narrative046": "艾玛盯着手上的拷问器具，<br>\n露出了笑容。",
  "0101Bad02_Narrative047": "那是一根铁棒，其中一端锋利且尖锐——",
  "0101Bad02_Ema031": "这不是正好吗。"
}
}
