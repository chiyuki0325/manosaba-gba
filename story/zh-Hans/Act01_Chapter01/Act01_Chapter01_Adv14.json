{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv14",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-10", "line": 4, "indent": 0},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "艾玛和雪莉跟着地图，<br>\n前往一楼的医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative001"]}},
    {"op": "ModifyBackgroundExtended", "line": 21, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_2"}},
    {"op": "ModifyBackgroundExtended", "line": 22, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 24, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "走进医务室，迎面飘来的不是药品的气味，<br>\n而是一股沁人的香气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "室内洒满了阳光，<br>\n让人感受到难得的心神安宁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（还有这样的好地方……<br>\n　不是所有地方都那么糟糕，真是太好了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "安安躺在床上睡着了。<br>\n梅露露和蕾雅也在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "啊，艾玛小姐，雪莉小姐……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Meruru001"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "还想着怎么不见梅露露你，<br>\n原来你在这里啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "嗯……听说安安小姐情况不太好，<br>\n我安不下心来，就……对不起。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Meruru002"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "梅露露小声说道，把头低了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "你不用道歉啦！<br>\n梅露露你很棒哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry002"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "讲、讲讲讲讲太过了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "安安她一直都待在这里吗？<br>\n情况怎么样了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "她发了高烧……我们遇到典狱长大人，<br>\n它听了我们的情况就说，与其留她在自己房间，<br>\n不如带来医务室这边休息还比较好。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Meruru004"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "这样啊……它还蛮心善的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema003"]}},
    {"op": "HideAllCharacters", "line": 64, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "艾玛和雪莉走到了<br>\n安安的床边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "是你们啊。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "请问，安安她没事吧？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "说不上情况很好……<br>\n不过，梅露露她真的出了很多力。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Leia.Smile1,ArmR5,ArmL2"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "中庭那边植物长得很茂盛，<br>\n她就跑去那边摘香草，给我们泡茶。<br>\n多亏有她，现在大家感觉很安心。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "欸，梅露露好厉害耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "（所以这里才飘着一股<br>\n　柔和的香气啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "中庭……说来，我记得过道中间<br>\n有一个地方是可以走出去的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry004"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "嗯，那里是个气氛很好的地方。<br>\n想去的话我可以带路。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia004"]}},
    {"op": "HideAllCharacters", "line": 103, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 104, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "艾玛和雪莉跟着蕾雅<br>\n来到了中庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative007"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "虽然四周被墙壁包围，<br>\n但是没有天花板的遮挡，可以看得见天空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative008"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "也能看到这里的二楼各处都设置了阳台，<br>\n便于呼吸新鲜空气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Smile1"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "（是外面的空气……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema006"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "见到这座绿意满盈的庭院，<br>\n一直待在密闭空间里的艾玛，不禁深深吸了一口这里的空气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 118, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "虽然这边是封闭空间，<br>\n但是也可以走正门去到外面。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia005"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "那是个充满自然气息的美景。<br>\n我觉得那边的开放感会更好哦。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "面对蕾雅笑容满面给出的建议，<br>\n艾玛和雪莉对视了一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative011"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "我们还以为<br>\n正门肯定是锁着的呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Leia.Normal1,ArmR5,ArmL1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "好像在放风时间里<br>\n是真的允许我们自由地四处转转的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia007"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "只不过，在禁止外出时间内<br>\n玄关还是会上锁的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia008"]}},
    {"op": "PlaySfxModified", "line": 144, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 146, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "在她们聊得正火热时，上空传来了翅膀拍动的声音。<br>\n于是艾玛她们抬头往上看。<br>\n和心里想的一样，是典狱长来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "哎呀，这不是樱羽艾玛小姐，<br>\n橘雪莉小姐，还有莲见蕾雅小姐吗。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden001"]}},
    {"op": "HideAllCharacters", "line": 154, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1,ArmR1,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Ema.Surprised1,ArmR3,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "典狱长……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema008"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "看到典狱长出现，蕾雅警戒起来，<br>\n露出恶狠狠的表情站在二人面前，摆出要保护她们两个的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative013"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "我们有老实遵守规定生活。<br>\n没有做任何坏事。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia009"]}},
    {"op": "HideAllCharacters", "line": 165, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "嗯，希望你们继续保持下去。<br>\n这里可是个好地方，<br>\n希望你们可以好好享受这里的生活。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden002"]}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "典狱长忽然出现，<br>\n艾玛和蕾雅二人的表情都十分紧张，<br>\n但雪莉此时却是两眼放光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Sherry.Smile1,ArmR1,ArmL6"}},
    {"op": "EmoteJumpDouble", "line": 178, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "遇到你真的好幸运耶！<br>\n典狱长，我可以问你几个问题吗！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry005"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "这座建筑物相当古老呢。<br>\n典狱长，时间这么久了，<br>\n你应该见过好几批关进这里的囚犯吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry006"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "曾经被关在这里的囚犯，最后都变成怎样了！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry007"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "这座监牢又是为了什么目的建成的！？<br>\n请你告诉我～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 188, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "……哎呀呀。<br>\n唉，看你们什么都不知道，也是蛮可怜的。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden003"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "虽然我现在没什么时间……<br>\n不过，我就告诉你们一点点吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden004"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "这座监牢呢，已经有500年的历史了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden005"]}},
    {"op": "HideAllCharacters", "line": 197, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Sherry.Surprised1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "500年！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry009"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "怪不得破旧成这样……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Leia010"]}},
    {"op": "HideAllCharacters", "line": 206, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "当时这里还不是囚禁魔女的地方，<br>\n而是魔女们正常生活的一间大宅子。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden006"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "以大魔女为中心，<br>\n许许多多的魔女曾经在这里幸福地生活着。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden007"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "虽然摸不透它究竟有没有情感，<br>\n但从它平和的语气来看，它似乎也相当怀念过去的事情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative015"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "某天，有一个和魔女不一样的种族——<br>\n也就是人类，来到这座岛上时，魔女们也是<br>\n在这个中庭里开展茶会，欢迎他们的到来。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden008"]}},
    {"op": "HideAllCharacters", "line": 217, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 219, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [65.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "那为什么这里就变成了关押囚犯的监牢呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry010"]}},
    {"op": "HideAllCharacters", "line": 224, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 225, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "呃，那是因为大魔女她——哎呀，<br>\n说太多了也不好呢。我就告辞了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Warden009"]}},
    {"op": "PlaySfxModified", "line": 233, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 235, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "典狱长逃也似的飞走了。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Narrative016"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "（监牢……大魔女……总觉得是很重要的情报。<br>\n　把它记到【魔女图鉴】里面吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema009"]}},
    {"op": "ShowToastUI", "line": 245, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 246, "indent": 0, "params": {"Id": "8", "Category": "Note", "Version": 1}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "好想听典狱长说更多的事耶！<br>\n不过我感觉已经大丰收了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Sherry011"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "嗯、嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema010"]}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "（我没法像雪莉那样子，随便就高兴得起来啦……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv14_Ema011"]}},
    {"op": "Gosub", "line": 263, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 265, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv11", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv14_Narrative001": "艾玛和雪莉跟着地图，<br>\n前往一楼的医务室。",
  "0101Adv14_Narrative002": "走进医务室，迎面飘来的不是药品的气味，<br>\n而是一股沁人的香气。",
  "0101Adv14_Narrative003": "室内洒满了阳光，<br>\n让人感受到难得的心神安宁。",
  "0101Adv14_Ema001": "（还有这样的好地方……<br>\n　不是所有地方都那么糟糕，真是太好了）",
  "0101Adv14_Narrative004": "安安躺在床上睡着了。<br>\n梅露露和蕾雅也在。",
  "0101Adv14_Meruru001": "啊，艾玛小姐，雪莉小姐……！",
  "0101Adv14_Sherry001": "还想着怎么不见梅露露你，<br>\n原来你在这里啊。",
  "0101Adv14_Meruru002": "嗯……听说安安小姐情况不太好，<br>\n我安不下心来，就……对不起。",
  "0101Adv14_Narrative005": "梅露露小声说道，把头低了下来。",
  "0101Adv14_Sherry002": "你不用道歉啦！<br>\n梅露露你很棒哦！",
  "0101Adv14_Meruru003": "讲、讲讲讲讲太过了……",
  "0101Adv14_Ema002": "安安她一直都待在这里吗？<br>\n情况怎么样了。",
  "0101Adv14_Meruru004": "她发了高烧……我们遇到典狱长大人，<br>\n它听了我们的情况就说，与其留她在自己房间，<br>\n不如带来医务室这边休息还比较好。",
  "0101Adv14_Ema003": "这样啊……它还蛮心善的。",
  "0101Adv14_Narrative006": "艾玛和雪莉走到了<br>\n安安的床边。",
  "0101Adv14_Leia001": "是你们啊。",
  "0101Adv14_Ema004": "请问，安安她没事吧？",
  "0101Adv14_Leia002": "说不上情况很好……<br>\n不过，梅露露她真的出了很多力。",
  "0101Adv14_Leia003": "中庭那边植物长得很茂盛，<br>\n她就跑去那边摘香草，给我们泡茶。<br>\n多亏有她，现在大家感觉很安心。",
  "0101Adv14_Sherry003": "欸，梅露露好厉害耶！",
  "0101Adv14_Ema005": "（所以这里才飘着一股<br>\n　柔和的香气啊）",
  "0101Adv14_Sherry004": "中庭……说来，我记得过道中间<br>\n有一个地方是可以走出去的。",
  "0101Adv14_Leia004": "嗯，那里是个气氛很好的地方。<br>\n想去的话我可以带路。",
  "0101Adv14_Narrative007": "艾玛和雪莉跟着蕾雅<br>\n来到了中庭。",
  "0101Adv14_Narrative008": "虽然四周被墙壁包围，<br>\n但是没有天花板的遮挡，可以看得见天空。",
  "0101Adv14_Narrative009": "也能看到这里的二楼各处都设置了阳台，<br>\n便于呼吸新鲜空气。",
  "0101Adv14_Ema006": "（是外面的空气……！）",
  "0101Adv14_Narrative010": "见到这座绿意满盈的庭院，<br>\n一直待在密闭空间里的艾玛，不禁深深吸了一口这里的空气。",
  "0101Adv14_Leia005": "虽然这边是封闭空间，<br>\n但是也可以走正门去到外面。",
  "0101Adv14_Leia006": "那是个充满自然气息的美景。<br>\n我觉得那边的开放感会更好哦。",
  "0101Adv14_Narrative011": "面对蕾雅笑容满面给出的建议，<br>\n艾玛和雪莉对视了一眼。",
  "0101Adv14_Ema007": "我们还以为<br>\n正门肯定是锁着的呢。",
  "0101Adv14_Leia007": "好像在放风时间里<br>\n是真的允许我们自由地四处转转的。",
  "0101Adv14_Leia008": "只不过，在禁止外出时间内<br>\n玄关还是会上锁的。",
  "0101Adv14_Narrative012": "在她们聊得正火热时，上空传来了翅膀拍动的声音。<br>\n于是艾玛她们抬头往上看。<br>\n和心里想的一样，是典狱长来了。",
  "0101Adv14_Warden001": "哎呀，这不是樱羽艾玛小姐，<br>\n橘雪莉小姐，还有莲见蕾雅小姐吗。",
  "0101Adv14_Ema008": "典狱长……",
  "0101Adv14_Narrative013": "看到典狱长出现，蕾雅警戒起来，<br>\n露出恶狠狠的表情站在二人面前，摆出要保护她们两个的样子。",
  "0101Adv14_Leia009": "我们有老实遵守规定生活。<br>\n没有做任何坏事。",
  "0101Adv14_Warden002": "嗯，希望你们继续保持下去。<br>\n这里可是个好地方，<br>\n希望你们可以好好享受这里的生活。",
  "0101Adv14_Narrative014": "典狱长忽然出现，<br>\n艾玛和蕾雅二人的表情都十分紧张，<br>\n但雪莉此时却是两眼放光。",
  "0101Adv14_Sherry005": "遇到你真的好幸运耶！<br>\n典狱长，我可以问你几个问题吗！",
  "0101Adv14_Sherry006": "这座建筑物相当古老呢。<br>\n典狱长，时间这么久了，<br>\n你应该见过好几批关进这里的囚犯吧？",
  "0101Adv14_Sherry007": "曾经被关在这里的囚犯，最后都变成怎样了！？",
  "0101Adv14_Sherry008": "这座监牢又是为了什么目的建成的！？<br>\n请你告诉我～！",
  "0101Adv14_Warden003": "……哎呀呀。<br>\n唉，看你们什么都不知道，也是蛮可怜的。",
  "0101Adv14_Warden004": "虽然我现在没什么时间……<br>\n不过，我就告诉你们一点点吧。",
  "0101Adv14_Warden005": "这座监牢呢，已经有500年的历史了。",
  "0101Adv14_Sherry009": "500年！？",
  "0101Adv14_Leia010": "怪不得破旧成这样……",
  "0101Adv14_Warden006": "当时这里还不是囚禁魔女的地方，<br>\n而是魔女们正常生活的一间大宅子。",
  "0101Adv14_Warden007": "以大魔女为中心，<br>\n许许多多的魔女曾经在这里幸福地生活着。",
  "0101Adv14_Narrative015": "虽然摸不透它究竟有没有情感，<br>\n但从它平和的语气来看，它似乎也相当怀念过去的事情。",
  "0101Adv14_Warden008": "某天，有一个和魔女不一样的种族——<br>\n也就是人类，来到这座岛上时，魔女们也是<br>\n在这个中庭里开展茶会，欢迎他们的到来。",
  "0101Adv14_Sherry010": "那为什么这里就变成了关押囚犯的监牢呢？",
  "0101Adv14_Warden009": "呃，那是因为大魔女她——哎呀，<br>\n说太多了也不好呢。我就告辞了。",
  "0101Adv14_Narrative016": "典狱长逃也似的飞走了。<br>",
  "0101Adv14_Ema009": "（监牢……大魔女……总觉得是很重要的情报。<br>\n　把它记到【魔女图鉴】里面吧）",
  "Toast_001": "魔女图鉴 更新…",
  "0101Adv14_Sherry011": "好想听典狱长说更多的事耶！<br>\n不过我感觉已经大丰收了！",
  "0101Adv14_Ema010": "嗯、嗯。",
  "0101Adv14_Ema011": "（我没法像雪莉那样子，随便就高兴得起来啦……）"
}
}
