  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-29", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_1"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛她们来到淋浴房，<br>\n正好遇到调查中的蕾雅、玛格、米莉亚三人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "对面似乎是<br>\n在搜查期间正好遇上，才一起行动的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "Wait", "line": 29, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "汉娜一脸不悦地皱起眉头，<br>\n马上就离开了淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmL4"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "哎呀，你们也在玩侦探游戏吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Margo001"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "刚还在调查柜子的玛格，<br>\n转过脸对着艾玛她们轻轻一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 40, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "才不是什么游戏……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema001"]}},
    {"op": "HideAllCharacters", "line": 45, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR18,ArmL13"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "算啦，现在不是吵架的时候。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "在雪莉的劝说下，<br>\n艾玛做了深呼吸，总算压抑住不快的感情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative005"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "（玛格是故意这么讲话惹我们不爽的。<br>\n　我要冷静才行）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema002"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "你们那边有收获什么线索吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Sherry002"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "蕾雅耸了耸肩，以示回应。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 63, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Normal1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1,ArmL1"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "不，完全没有有力的线索。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia001"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "我们的看法基本达成一致，<br>\n最可疑的人就是汉娜。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Margo002"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "汉娜绝对不会做出这样的事！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema003"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "艾玛这下真的生气了。<br>\n这时，蕾雅深深地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 78, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1,Arms"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "艾玛，你对汉娜她<br>\n到底有多少了解？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia002"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "我几乎不了解她。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia003"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "她或许是会动手杀人的少女，<br>\n也或许不是。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia004"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "我有点羡慕你，<br>\n可以发自真心地信任他人。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia005"]}},
    {"op": "HideAllCharacters", "line": 89, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1,ArmR3"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "……蕾雅，<br>\n你难道无法相信任何人吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema004"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "艾玛反问的声音软弱无力，根本算不上反击。<br>\n这时，蕾雅露出了温柔的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative008"]}},
    {"op": "HideAllCharacters", "line": 96, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "我想保护所有人。<br>\n所以，我会尽全力保护我所相信的少女们，不受魔女的伤害。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia006"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "（我不认为蕾雅的想法是错误的。<br>\n　可是，汉娜她……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema005"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "（她愿意和没有朋友的我一起玩。<br>\n　……虽然这可能只是我单方面的情感）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema006"]}},
    {"op": "ResetText", "line": 107, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 108, "indent": 0, "params": {"SlotNumber": 8, "Wait": 0}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "（我想要相信，相信汉娜她<br>\n　并不是魔女）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "看来淋浴房也没什么线索。<br>\n怎么办？要离开吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Sherry003"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "雪莉轻轻碰了碰艾玛的肩膀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative009"]}},
    {"op": "HideAllCharacters", "line": 118, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "艾玛她——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative010"]}},
    {"op": "AddChoice", "line": 128, "indent": 0, "params": {"ChoiceSummary": "向雪莉点了点头", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv33_Choice001"]}},
    {"op": "GotoModified", "line": 129, "indent": 1, "params": {"Path": ".Choice1-1-8"}},
    {"op": "AddChoice", "line": 131, "indent": 0, "params": {"ChoiceSummary": "做出若有所思的表情", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv33_Choice002"]}},
    {"op": "GotoModified", "line": 132, "indent": 1, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Bad08", "ResetState": ["-"]}},
    {"op": "StopForChoice", "line": 134, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice1-1-8", "line": 136, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 138, "indent": 0, "params": {"Number": 8}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "向雪莉点了点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "嗯……<br>\n哦，还有件事，我想问一下她们魔法的事。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema008"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "我们不知道蕾雅你们<br>\n会用怎样的魔法。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema009"]}},
    {"op": "HideAllCharacters", "line": 148, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Surprised1,ArmR10,ArmL4"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "呃……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Miria001"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "发出了惊讶声的<br>\n是米莉亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative012"]}},
    {"op": "Wait", "line": 155, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "AnimateActorExtended", "line": 156, "indent": 0, "params": {"ActorIds": ["Miria"], "Loop": 0, "ScenePositionY": "20", "Scale": "2", "Duration": "1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "她猛地凑到艾玛面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative013"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "这是一位一头金发，穿着耳钉，<br>\n由头到脚都打理得美丽动人的，拥有模特身材的超魅力少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative014"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "这样一位美少女在超近距离面对着自己，<br>\n艾玛忍不住吞了吞口水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative015"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "魔、魔魔魔魔魔法怎么可能会存在呢？<br>\n别再说这个话题了好吗？哈哈哈哈哈。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Miria002"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "一阵干笑声<br>\n响遍整间淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative016"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "（超、超级可疑……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema010"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "这时，蕾雅清了清嗓子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "既然艾玛你怎样也使不出魔法，<br>\n那不就说明，不是每个人都对自己的魔法有认知，对不对？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia007"]}},
    {"op": "HideAllCharacters", "line": 178, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "啊，嗯。说得有道理……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema011"]}},
    {"op": "HideAllCharacters", "line": 183, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1,ArmR3,ArmL2"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "顺带一提，我似乎是在无意中<br>\n使出了轻微地诱惑了你们的魔法。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia008"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "（确实有这个感觉）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "还有其他问题吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia009"]}},
    {"op": "HideAllCharacters", "line": 194, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "呃……还有，我想知道你们昨晚的行动。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema013"]}},
    {"op": "HideAllCharacters", "line": 199, "indent": 0, "params": {"Lazy": 0}},
    {"op": "AnimateActorExtended", "line": 200, "indent": 0, "params": {"ActorIds": ["Miria"], "Loop": 0, "ScenePositionY": "50", "Wait": 0}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Surprised1,ArmR10,ArmL4"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "呃……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Miria003"]}},
    {"op": "Wait", "line": 205, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "AnimateActorExtended", "line": 206, "indent": 0, "params": {"ActorIds": ["Miria"], "Loop": 0, "ScenePositionY": "20", "Scale": "2", "Duration": "1"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "米莉亚又一次发出惊讶声，<br>\n又慌张地靠近了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative018"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "虽然我和小蕾睡一间房，但只是单纯的室友关系哦？<br>\n并没有什么奇怪的意思哦？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Miria004"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "我和她睡的床也不是同一张哦？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Miria005"]}},
    {"op": "HideAllCharacters", "line": 214, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "…………", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Leia010"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "你说得这么慌张，<br>\n反而更招人怀疑了耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Sherry004"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "雪莉满面笑容，自然地发出吐槽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 226, "indent": 0, "params": {"Lazy": 0}},
    {"op": "AnimateActorExtended", "line": 227, "indent": 0, "params": {"ActorIds": ["Miria"], "Loop": 0, "ScenePositionY": "50", "Wait": 0}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Fearful1,ArmR8,ArmL7"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "啊啊啊……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Miria006"]}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "米莉亚双手抱头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 234, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "（我其实更想问<br>\n　昨天晚上直播的事）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema015"]}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "（这股尴尬死的气氛究竟是怎么回事……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Ema016"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "艾玛和雪莉<br>\n离开了淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv33_Narrative021"]}},
