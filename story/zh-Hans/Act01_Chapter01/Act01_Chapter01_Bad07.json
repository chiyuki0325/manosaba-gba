  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 3, "indent": 1, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "label", "name": "Scene1-1-b7", "line": 9, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "11_1"}},
    {"op": "PlayBgm", "line": 16, "indent": 0, "params": {"BgmPath": "Bgm_25_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "艾玛半开玩笑地喊雪莉动手了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "嗯，动手吧雪莉！<br>\n开玩笑的啦……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR14"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "收到！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "欸，等一下雪莉！？<br>\n我开玩笑的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema002"]}},
    {"op": "HideAllCharacters", "line": 33, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "雪莉没有听到艾玛的制止，<br>\n来到亚里沙和奈叶香跟前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR18,ArmL13"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "你们两个，不可以吵架哦——", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 43, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "雪莉笑容满面地说着，<br>\n然后朝亚里沙和奈叶香挥下拳头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative003"]}},
    {"op": "PlaySfxModified", "line": 48, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 50, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlaySfxModified", "line": 53, "indent": 0, "params": {"SfxPath": "Sfx_25", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "她们两个瞬间躲开，<br>\n雪莉的拳头挥空，砸向了娱乐室的地板。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "！！", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Nanoka001"]}},
    {"op": "HideAllCharacters", "line": 63, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "你这家伙……突然之间干什么！？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 69, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR8,ArmL1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "只是想阻止争吵啦，<br>\n感觉先把你们两个打晕是最快的～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "……开什么玩笑。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "这下挑事的是你才对。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 83, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "当然，亚里沙和奈叶香<br>\n并不打算老实被打。<br>\n三人之间的战斗一触即发。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR8,ArmL1"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "最初行动的是雪莉，<br>\n她再次向亚里沙和奈叶香发起攻击。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 91, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "这回亚里沙和奈叶香都做好了迎战的姿势。<br>\n可是，雪莉的动作比两人的反应更快。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 99, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PlaySfxModified", "line": 103, "indent": 0, "params": {"SfxPath": "Sfx_85", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 104, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "AnimateActorExtended", "line": 106, "indent": 0, "params": {"ActorIds": ["Nanoka", "Alisa"], "Loop": 0, "ScenePositionY": "-50"}},
    {"op": "PlaySfxModified", "line": 109, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 110, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "雪莉将奈叶香和亚里沙都打趴下了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR3,ArmL4"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "嗯哼！这下吵架就完全结束了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 120, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "哪里结束了！？<br>\n现在是你挑起了暴力事件好吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 125, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "看守现身了，把雪莉、亚里沙、奈叶香三人<br>\n都抓住了。<br>\n三人都被带走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative009"]}},
    {"op": "HideAllCharacters", "line": 130, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "呀，真不得了……那三人要被送到惩罚室了呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Margo001"]}},
    {"op": "HideAllCharacters", "line": 135, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "我、我说艾玛！<br>\n都怪你，现在情况变得更糟糕了欸！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 140, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "怎、怎会这样……我只是想开个玩笑而已……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema003"]}},
    {"op": "StopBgm", "line": 145, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 147, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "…………", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 152, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 153, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 156, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 158, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 159, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 160, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_2"}},
    {"op": "ModifyBackgroundExtended", "line": 161, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "时间来到两天后。<br>\n艾玛正等待雪莉三人从惩罚室中释放。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative010"]}},
    {"op": "PlayBgm", "line": 165, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "她们应该快到时间放出来了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema004"]}},
    {"op": "HideAllCharacters", "line": 171, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "呵，谁知道呢……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 176, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "（总感觉汉娜的态度有些冷淡……<br>\n　其他人好像也都没正眼看我……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema005"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "（我真的惹大家生气了……？<br>\n　只因为我说了那些话……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema006"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "本来只是想着开玩笑，结果却煽动了雪莉，<br>\n令事态进一步恶化。<br>\n大家或许是因此对艾玛感到不信任。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "艾玛小姐，请你不要灰心……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 188, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "梅露露向表情昏暗的艾玛送去了关心。<br>\n所有少女中，只有她没有和艾玛拉开距离。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "梅露露……谢谢你。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema007"]}},
    {"op": "HideAllCharacters", "line": 196, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0, 50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR7,ArmL2"}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "过了一会，亚里沙和奈叶香两人出现了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative013"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "也许是因为在惩罚室遭受了残酷的责罚，<br>\n她们两个看上去十分疲累。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative014"]}},
    {"op": "HideAllCharacters", "line": 204, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "……雪莉她情况怎么了？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 209, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR7,ArmL2"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "那家伙……说不定已经被杀了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Alisa003"]}},
    {"op": "HideAllCharacters", "line": 214, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 215, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "被、被杀了！？为什么！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema008"]}},
    {"op": "HideAllCharacters", "line": 219, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR7,ArmL2"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "谁知道啊！我只听见典狱长<br>\n它这么说过……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Alisa004"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "说……已经没救了，把她处理掉吧……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Alisa005"]}},
    {"op": "HideAllCharacters", "line": 226, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Cry1,ArmR3"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "怎么、怎会这样……这也，太过分……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema009"]}},
    {"op": "HideAllCharacters", "line": 231, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR7,ArmL2"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "你也好意思说……<br>\n不都怪你煽动那家伙！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Alisa006"]}},
    {"op": "HideAllCharacters", "line": 236, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "哎呀……说到底，<br>\n最开始吵架的是谁呀？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Margo002"]}},
    {"op": "HideAllCharacters", "line": 241, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 242, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "一开始挑事的是这家伙才对！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Alisa007"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "…………", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Nanoka003"]}},
    {"op": "HideAllCharacters", "line": 249, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "那、那个，大家，请冷静一下……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Meruru003"]}},
    {"op": "PlaySfxModified", "line": 255, "indent": 0, "params": {"SfxPath": "Sfx_32", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 257, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "你们这帮人，说够了没！<br>\n你们所有人都有责任吧！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Hanna005"]}},
    {"op": "HideAllCharacters", "line": 262, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "汉娜怒吼道，并砸了一下桌子。<br>\n之后，她神情激愤地准备离开房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "汉娜，等一下！<br>\n我说……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema010"]}},
    {"op": "HideAllCharacters", "line": 270, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 271, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "现在请不要和我说话……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Hanna006"]}},
    {"op": "HideAllCharacters", "line": 275, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 276, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema011"]}},
    {"op": "HideAllCharacters", "line": 280, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "汉娜留下这句话后，转身离开了。<br>\n只留艾玛呆站在原地一动不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative016"]}},
    {"op": "ResetText", "line": 284, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 286, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 287, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 288, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 289, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "在那之后，<br>\n饱受负罪感折磨的艾玛<br>\n主动和其他少女们拉开了距离。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative017"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "（雪莉被杀<br>\n　都是我的错……<br>\n　为什么我会说出那些话呢……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema012"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "由于尴尬，<br>\n其他人都没有再和艾玛说话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative018"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "日子一天天过去，<br>\n艾玛的内心愈发疲敝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative019"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "（大家肯定都还在责怪我……<br>\n　刚刚也是……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema013"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "少女们待在会客厅中，正有说有笑地交流着。<br>\n可艾玛一现身，所有人都压低了音量。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative020"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "少女们低声私语着，向艾玛投去视线。<br>\n艾玛感觉自己正在被人讲坏话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "啊，艾玛小姐……我把饭菜带过来了。<br>\n我就放在这里，请快吃吧……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Meruru004"]}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "呃……你一定要打起精神来哦。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Meruru005"]}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "就连温柔以待的梅露露的话语，<br>\n艾玛也会不自觉地反向解读。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative022"]}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "（是喊我不要再继续摆一副受害者的态度吗……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema014"]}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "艾玛双手抱膝，没有回应梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 317, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "…………", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Meruru006"]}},
    {"op": "HideAllCharacters", "line": 321, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "梅露露露出悲伤的表情，离开了房门前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 325, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 327, "indent": 0, "params": {"Text": "好难受……一切都好难受……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema015"]}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "待在这个地方，令她很难受。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative025"]}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "因为不识气氛，<br>\n害死雪莉一事，令她很难受。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative026"]}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "被大家看不起，令她很难受。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 335, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 337, "indent": 0, "params": {"Text": "感觉一切都无所谓了……好累啊。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema016"]}},
    {"op": "ModifyCharacterExtended", "line": 339, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR9"}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "艾玛拿起从食堂带出的餐刀，<br>\n抵在自己的喉咙上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative028"]}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "要是我死了，<br>\n会不会有人稍微为我感到悲伤呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Ema017"]}},
    {"op": "HideAllCharacters", "line": 345, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 347, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 350, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 352, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlaySfxModified", "line": 355, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 357, "indent": 0, "params": {"TintColor": "#ff0000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 358, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 359, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 360, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "在牢房中，<br>\n赤红色的蝴蝶在艾玛的身旁翩翩起舞起来——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad07_Narrative029"]}},
    {"op": "ProcessBadEnd", "line": 368, "indent": 0, "params": {"Number": 7}}
  ],
  "translations": {
  "0101Bad07_Narrative001": "艾玛半开玩笑地喊雪莉动手了。",
  "0101Bad07_Ema001": "嗯，动手吧雪莉！<br>\n开玩笑的啦……",
  "0101Bad07_Sherry001": "收到！",
  "0101Bad07_Ema002": "欸，等一下雪莉！？<br>\n我开玩笑的！",
  "0101Bad07_Narrative002": "雪莉没有听到艾玛的制止，<br>\n来到亚里沙和奈叶香跟前。",
  "0101Bad07_Sherry002": "你们两个，不可以吵架哦——",
  "0101Bad07_Narrative003": "雪莉笑容满面地说着，<br>\n然后朝亚里沙和奈叶香挥下拳头。",
  "0101Bad07_Narrative004": "她们两个瞬间躲开，<br>\n雪莉的拳头挥空，砸向了娱乐室的地板。",
  "0101Bad07_Nanoka001": "！！",
  "0101Bad07_Alisa001": "你这家伙……突然之间干什么！？",
  "0101Bad07_Sherry003": "只是想阻止争吵啦，<br>\n感觉先把你们两个打晕是最快的～",
  "0101Bad07_Nanoka002": "……开什么玩笑。",
  "0101Bad07_Alisa002": "这下挑事的是你才对。",
  "0101Bad07_Narrative005": "当然，亚里沙和奈叶香<br>\n并不打算老实被打。<br>\n三人之间的战斗一触即发。",
  "0101Bad07_Narrative006": "最初行动的是雪莉，<br>\n她再次向亚里沙和奈叶香发起攻击。",
  "0101Bad07_Narrative007": "这回亚里沙和奈叶香都做好了迎战的姿势。<br>\n可是，雪莉的动作比两人的反应更快。",
  "0101Bad07_Narrative008": "雪莉将奈叶香和亚里沙都打趴下了。",
  "0101Bad07_Sherry004": "嗯哼！这下吵架就完全结束了！",
  "0101Bad07_Hanna001": "哪里结束了！？<br>\n现在是你挑起了暴力事件好吗！？",
  "0101Bad07_Narrative009": "看守现身了，把雪莉、亚里沙、奈叶香三人<br>\n都抓住了。<br>\n三人都被带走了。",
  "0101Bad07_Margo001": "呀，真不得了……那三人要被送到惩罚室了呢。",
  "0101Bad07_Hanna002": "我、我说艾玛！<br>\n都怪你，现在情况变得更糟糕了欸！？",
  "0101Bad07_Ema003": "怎、怎会这样……我只是想开个玩笑而已……",
  "0101Bad07_Meruru001": "…………",
  "0101Bad07_Narrative010": "时间来到两天后。<br>\n艾玛正等待雪莉三人从惩罚室中释放。",
  "0101Bad07_Ema004": "她们应该快到时间放出来了……",
  "0101Bad07_Hanna003": "呵，谁知道呢……",
  "0101Bad07_Ema005": "（总感觉汉娜的态度有些冷淡……<br>\n　其他人好像也都没正眼看我……）",
  "0101Bad07_Ema006": "（我真的惹大家生气了……？<br>\n　只因为我说了那些话……）",
  "0101Bad07_Narrative011": "本来只是想着开玩笑，结果却煽动了雪莉，<br>\n令事态进一步恶化。<br>\n大家或许是因此对艾玛感到不信任。",
  "0101Bad07_Meruru002": "艾玛小姐，请你不要灰心……",
  "0101Bad07_Narrative012": "梅露露向表情昏暗的艾玛送去了关心。<br>\n所有少女中，只有她没有和艾玛拉开距离。",
  "0101Bad07_Ema007": "梅露露……谢谢你。",
  "0101Bad07_Narrative013": "过了一会，亚里沙和奈叶香两人出现了。",
  "0101Bad07_Narrative014": "也许是因为在惩罚室遭受了残酷的责罚，<br>\n她们两个看上去十分疲累。",
  "0101Bad07_Hanna004": "……雪莉她情况怎么了？",
  "0101Bad07_Alisa003": "那家伙……说不定已经被杀了。",
  "0101Bad07_Ema008": "被、被杀了！？为什么！？",
  "0101Bad07_Alisa004": "谁知道啊！我只听见典狱长<br>\n它这么说过……",
  "0101Bad07_Alisa005": "说……已经没救了，把她处理掉吧……",
  "0101Bad07_Ema009": "怎么、怎会这样……这也，太过分……",
  "0101Bad07_Alisa006": "你也好意思说……<br>\n不都怪你煽动那家伙！",
  "0101Bad07_Margo002": "哎呀……说到底，<br>\n最开始吵架的是谁呀？",
  "0101Bad07_Alisa007": "一开始挑事的是这家伙才对！",
  "0101Bad07_Nanoka003": "…………",
  "0101Bad07_Meruru003": "那、那个，大家，请冷静一下……",
  "0101Bad07_Hanna005": "你们这帮人，说够了没！<br>\n你们所有人都有责任吧！！",
  "0101Bad07_Narrative015": "汉娜怒吼道，并砸了一下桌子。<br>\n之后，她神情激愤地准备离开房间。",
  "0101Bad07_Ema010": "汉娜，等一下！<br>\n我说……",
  "0101Bad07_Hanna006": "现在请不要和我说话……",
  "0101Bad07_Ema011": "……！",
  "0101Bad07_Narrative016": "汉娜留下这句话后，转身离开了。<br>\n只留艾玛呆站在原地一动不动。",
  "0101Bad07_Narrative017": "在那之后，<br>\n饱受负罪感折磨的艾玛<br>\n主动和其他少女们拉开了距离。",
  "0101Bad07_Ema012": "（雪莉被杀<br>\n　都是我的错……<br>\n　为什么我会说出那些话呢……）",
  "0101Bad07_Narrative018": "由于尴尬，<br>\n其他人都没有再和艾玛说话。",
  "0101Bad07_Narrative019": "日子一天天过去，<br>\n艾玛的内心愈发疲敝。",
  "0101Bad07_Ema013": "（大家肯定都还在责怪我……<br>\n　刚刚也是……）",
  "0101Bad07_Narrative020": "少女们待在会客厅中，正有说有笑地交流着。<br>\n可艾玛一现身，所有人都压低了音量。",
  "0101Bad07_Narrative021": "少女们低声私语着，向艾玛投去视线。<br>\n艾玛感觉自己正在被人讲坏话。",
  "0101Bad07_Meruru004": "啊，艾玛小姐……我把饭菜带过来了。<br>\n我就放在这里，请快吃吧……",
  "0101Bad07_Meruru005": "呃……你一定要打起精神来哦。",
  "0101Bad07_Narrative022": "就连温柔以待的梅露露的话语，<br>\n艾玛也会不自觉地反向解读。",
  "0101Bad07_Ema014": "（是喊我不要再继续摆一副受害者的态度吗……）",
  "0101Bad07_Narrative023": "艾玛双手抱膝，没有回应梅露露。",
  "0101Bad07_Meruru006": "…………",
  "0101Bad07_Narrative024": "梅露露露出悲伤的表情，离开了房门前。",
  "0101Bad07_Ema015": "好难受……一切都好难受……",
  "0101Bad07_Narrative025": "待在这个地方，令她很难受。",
  "0101Bad07_Narrative026": "因为不识气氛，<br>\n害死雪莉一事，令她很难受。",
  "0101Bad07_Narrative027": "被大家看不起，令她很难受。",
  "0101Bad07_Ema016": "感觉一切都无所谓了……好累啊。",
  "0101Bad07_Narrative028": "艾玛拿起从食堂带出的餐刀，<br>\n抵在自己的喉咙上。",
  "0101Bad07_Ema017": "要是我死了，<br>\n会不会有人稍微为我感到悲伤呢……",
  "0101Bad07_Narrative029": "在牢房中，<br>\n赤红色的蝴蝶在艾玛的身旁翩翩起舞起来——"
}
}
