  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv22",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-18", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_1"}},
    {"op": "ModifyBackgroundExtended", "line": 16, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "不好意思打扰了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "夜晚的医务室静悄悄的。<br>\n艾玛也自然地压低了音量，走进房间里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative001"]}},
    {"op": "PlaySfxModified", "line": 24, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "艾玛走到安安的床边时，<br>\n感觉到床上有人正爬起身的动静。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "啊，安安，我是不是把你吵醒了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "『你有什么事』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_AnAn001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "呃，今天白天蕾雅不是来看望你了吗？<br>\n那时她好像错拿了你的手机。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema003"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "所以她想让我把手机还你。<br>\n——呐，给你。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema004"]}},
    {"op": "HideAllCharacters", "line": 40, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "艾玛刚伸出手，安安就一下子把手机抢了过去。<br>\n艾玛不禁苦笑了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative003"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（她这是讨厌我一个人呢，还是对所有人<br>\n　都是这副态度呢……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "那我先回去咯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema006"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "做完要做的事，<br>\n艾玛便回过头来准备离开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative004"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "这时，安安的手机里<br>\n传出一阵吵吵闹闹的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative005"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "那好像是可可的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "啊，直播开始了。<br>\n我也要看一下才行。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema007"]}},
    {"op": "HideAllCharacters", "line": 62, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "安安注意到了艾玛有些焦急的神情，<br>\n于是伸手向她递出了自己的手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative007"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "（她的意思是，想让我陪她一起看完再走？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema008"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "（虽然我想回自己房间看啦……<br>\n　不过安安竟然对我展现了善意，<br>\n　这是个难得的机会）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema009"]}},
    {"op": "StopBgm", "line": 70, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "谢谢你，那我就和你一起看咯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema010"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "艾玛小心翼翼地坐在床边，<br>\n把视线移到安安的手机上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative008"]}},
    {"op": "ResetText", "line": 79, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 80, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 81, "indent": 0, "params": {"Scale": [1.2999999523162842], "Lazy": 0, "AppearanceAndTransition": "5_2", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 82, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "Intensity": 0.5}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [25.0, 40.0], "IdAndAppearance": "Leia.Normal1,ArmR1,ArmL5", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [75.0, 40.0], "IdAndAppearance": "Miria.Pensive1,ArmR9,ArmL1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Coco.Normal1", "SubId": "Middle"}},
    {"op": "Wait", "line": 86, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "画面上出现了<br>\n3名少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative009"]}},
    {"op": "PlayBgm", "line": 91, "indent": 0, "params": {"BgmPath": "Bgm_18_1_Loop", "IntroBgmPath": "Bgm_18_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "呀吼～我是可可碳～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco001"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "今天我们竟然！迎来了！<br>\n那位知名艺人莲见蕾雅，一起开联动台～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "哈哈，你今天好兴奋啊。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Leia001"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "请问……为什么要把大叔我喊来呢……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "你就是单纯用来暖场的！你就是个龙套！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco003"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "龙套……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Miria002"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "说来“大叔”又是演哪一出啦！<br>\n你怎么看都是辣妹吧！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Flushed1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "不对，那个，大叔就是大叔啊……<br>\n我不是很习惯这种场面，你不要老是跟我说话啦……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Miria003"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "那你是来做什么的啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco005"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "艾玛不禁笑出了声。<br>\n看样子，她们应该是在会客厅直播的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative010"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "同时在线观众只有6人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative011"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "（在线观众才这么点，真佩服可可还能这么兴奋）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema011"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "结果，全程亢奋的可可<br>\n竟想到让蕾雅表演杂技。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "接下来，我要把这颗苹果丢出去，<br>\n而蕾雅就会用刺剑戳中它～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco006"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Surprised1,ArmR4,ArmL6", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "欸？等一下，我可没听说过要表演这个？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Leia002"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "有什么不好的啦！肯定能炒热气氛的！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco007"]}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "炒热什么气氛啊……看直播的才几个人……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "龙套就给我闭嘴！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco008"]}},
    {"op": "HideAllCharacters", "line": 171, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "蕾雅推脱不掉可可的恳求，最终还是表演了<br>\n用刺剑戳中抛出苹果的杂技。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1,ArmR1,ArmL8", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "真不愧是蕾雅，<br>\n她轻易地就表演成功了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative014"]}},
    {"op": "StopBgm", "line": 179, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 180, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 181, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "AnAn.Normal1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "HideActors", "line": 184, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Leia-Middle", "Coco-Middle", "Miria-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 185, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "艾玛和安安也<br>\n看直播看得很入迷。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "AnAn.Flushed1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "忽然，安安发现艾玛的脸靠得很近，<br>\n于是便一下子把头转到另一边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative016"]}},
    {"op": "HideAllCharacters", "line": 193, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "——这时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative017"]}},
    {"op": "PlaySfxModified", "line": 201, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "『各位，马上就到就寝时间了』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative018"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "『之后属于禁止外出时间，<br>\n　请迅速回到牢房内』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative019"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "直播还未结束，<br>\n就收到了典狱长的通知。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative020"]}},
    {"op": "PlayBgm", "line": 209, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 210, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 211, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 212, "indent": 0, "params": {"Scale": [1.2999999523162842], "Lazy": 0, "AppearanceAndTransition": "5_2", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 213, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "Intensity": 0.5}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [25.0, 40.0], "IdAndAppearance": "Leia.Normal1,ArmR3,ArmL2", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 215, "indent": 0, "params": {"Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [75.0, 40.0], "IdAndAppearance": "Miria.Pensive1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 216, "indent": 0, "params": {"Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Coco.Normal1", "SubId": "Middle"}},
    {"op": "Wait", "line": 217, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "屏幕上的蕾雅耸了耸肩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative021"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "今天就到此为止了。<br>\n各位晚安。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "记得再来看哦～！请多多转发推介！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Coco009"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "工作人员之后会好好品尝这颗苹果，<br>\n我就把它好好收起来咯～……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Miria005"]}},
    {"op": "ResetText", "line": 235, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 236, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "HideActors", "line": 237, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Leia-Middle", "Coco-Middle", "Miria-Middle"], "Lazy": 0}},
    {"op": "Wait", "line": 238, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "三人挥起手来，然后直播直接断掉，<br>\n画面一下子变黑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 242, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "……好了，我也要回房间了！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema012"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "安安，谢谢你给我看手机！<br>\n晚安！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema013"]}},
    {"op": "HideAllCharacters", "line": 248, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "如果超时未回到房间，<br>\n就会违反规定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative023"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "于是艾玛急匆匆地离开了医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative024"]}},
    {"op": "ResetText", "line": 258, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 259, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 260, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 262, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 263, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 264, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlaySfxModified", "line": 266, "indent": 0, "params": {"SfxPath": "Sfx_51", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "艾玛飞快地钻回自己的房间，<br>\n过了几分钟后，响起了各个牢房的上锁音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative025"]}},
    {"op": "PlaySfxModified", "line": 274, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 275, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "安全踩点回到家……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema014"]}},
    {"op": "PlaySfxModified", "line": 279, "indent": 0, "params": {"SfxPath": "Sfx_179", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 280, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 281, "indent": 0, "params": {"Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [10.0, 70.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "然后她一头倒在床上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative026"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "（蕾雅她们也是<br>\n　跑步回到自己房间的吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Ema015"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "今天已经相当累了。<br>\n艾玛闭上眼睛，马上就深深堕入了<br>\n梦中世界。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv22_Narrative027"]}},
    {"op": "Gosub", "line": 293, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
