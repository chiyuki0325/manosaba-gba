    {"op": "ModifyBackgroundExtended", "line": 34, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 35, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 41, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 42, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 43, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 45, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "一到早上的开锁时间，<br>\n艾玛就伸着懒腰走出了房门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative002"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "其他少女大概还没睡醒。<br>\n地下包裹在一片寂静之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative003"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "（大早上要不要散散步呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Ema001"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "这时，过道远处<br>\n出现了一位正在走动的少女身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "是安安。她正向艾玛这边走来，<br>\n几乎不带声响。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 59, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "早上好安安。<br>\n你起得好早！身体怎么样了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Ema002"]}},
    {"op": "HideAllCharacters", "line": 64, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "看到艾玛后，<br>\n安安皱起眉头，看着相当不开心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative006"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_AnAn001"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "她决意要无视艾玛，<br>\n从艾玛身边走过，准备回自己的房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative007"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "（还以为稍微有和她更亲近一点……<br>\n　看来和她相处不会太顺利呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Ema003"]}},
    {"op": "StopBgm", "line": 81, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "安安低着头继续走路，<br>\n走到自己房门前才抬起头来。这时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Surprised1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "啊、啊、啊……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_AnAn002"]}},
    {"op": "HideAllCharacters", "line": 89, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "欸？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Ema004"]}},
    {"op": "HideAllCharacters", "line": 94, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Fearful1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "啊啊啊啊啊啊啊啊啊啊——！！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_AnAn003"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "安安震惊地瞪大了眼睛，<br>\n第一次喊出声来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative009"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "对安安的反应感到好奇，艾玛也跟着望向隔壁的房间。<br>\n然后，她也看到了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative010"]}},
    {"op": "HidePrinter", "line": 105, "indent": 0, "params": {}},
