    {"op": "AnimateActorExtended", "line": 121, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "Scale": "1.15", "EasingTypeName": "EaseOutQuad", "Duration": "2.4"}},
    {"op": "SpawnBlur", "line": 122, "indent": 0, "params": {"ActorId": "Stills", "Intensity": 0.0, "FadeDuration": 1.7999999523162842}},
    {"op": "HideActors", "line": 123, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 124, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "诺亚……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Ema005"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "最喜欢画画的少女，<br>\n城崎诺亚，死了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative011"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "那双充满好奇心的，用来观察世界的可爱眼睛，<br>\n现在已经永远地闭上，再也不会看见任何色彩了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative012"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "失去了温度和血液的身体好像一件瓷器，<br>\n又好像一只做工精美的洋娃娃，美丽，而又脆弱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative013"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "而用喷漆涂成的纯白色画布上，<br>\n画有一幅画。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative014"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "——那是由诺亚自身流出的大量鲜血<br>\n画成的一幅画。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative015"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "蝴……蝶……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Ema006"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "许许多多红色的蝴蝶，在诺亚的身边轻盈飞舞着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative016"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "这就是城崎诺亚画的最后一幅画。<br>\n多么残酷，多么美丽，多么荒诞无稽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative017"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "听见骚动赶来的少女们看见这副惨烈的景象，<br>\n不禁倒吸一口凉气，哭喊着，颤抖着，尖叫着，陷入了恐慌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative018"]}},
    {"op": "HideActors", "line": 156, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 157, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Cry1,ArmR13,ArmL7"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "为什么、为什么为什么为什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Fearful1,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "大家冷静下来！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Leia001"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "和嘴里说的话相反，蕾雅满脸写着震惊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative019"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "她打开诺亚的房门，<br>\n往里看了一眼，十分沉痛地摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative020"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "没救了……已经死了……为什么！！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Leia002"]}},
    {"op": "PlaySfxModified", "line": 177, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 179, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "就好像是挑准了时间一样，<br>\n手机的提示音回荡在过道之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative021"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "『唉……收到一份报告。<br>\n　据说发生了一起令人痛心的凶杀案啊』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative022"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "『大家注意，请大家立即前往会客厅集合。<br>\n　不遵守者将被看守带走……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative023"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "正如典狱长所说，<br>\n看守已经抵达过道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative024"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "艾玛的脑袋乱作一团，<br>\n身体里好像有什么东西堵住似的，连呼吸都变得不太顺畅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative025"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "但因为看守在场的关系，<br>\n少女们只好动身前往指定地点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative026"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "没有任何人说话。<br>\n大家的脸上都没有任何表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative027"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "这件事，<br>\n似乎改变了少女们的一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative028"]}},
    {"op": "ShowToastUI", "line": 197, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 198, "indent": 0, "params": {"Id": "Noah", "Category": "Profile", "Version": 5}},
