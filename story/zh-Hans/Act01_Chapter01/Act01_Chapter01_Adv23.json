    {"op": "ModifyBackgroundExtended", "line": 119, "indent": 0, "params": {"Id": "Stills", "Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "270_1"}},
