    {"op": "AnimateActorExtended", "line": 115, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "80", "EasingTypeName": "EaseOutQuad", "Duration": "1.5"}},
    {"op": "Wait", "line": 116, "indent": 0, "params": {"WaitMode": "2.4"}},
