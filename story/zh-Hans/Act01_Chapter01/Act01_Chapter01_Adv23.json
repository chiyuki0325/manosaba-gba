    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "——第二天早晨。<br>\n或许因为昨晚睡得很香，艾玛早早便醒来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv23_Narrative001"]}},
