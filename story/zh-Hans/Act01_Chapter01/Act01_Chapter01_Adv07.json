    {"op": "PlayBgm", "line": 26, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "这时，手机响起提示音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative001"]}},
    {"op": "PlaySfxModified", "line": 30, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnBlur", "line": 31, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "半梦半醒的艾玛忽然醒来，<br>\n急匆匆把手机点开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative002"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "是典狱长的通知。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative003"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "『各位，到晚餐时间了。<br>\n　请迅速集合到食堂来』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative004"]}},
    {"op": "PlaySfxModified", "line": 43, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "所有的牢房在同一时间解锁了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative005"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "晚餐……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema001"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "（说起来，从醒来后就没吃过东西……<br>\n　肚子饿了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema002"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "（虽然不想接受这样的生活……<br>\n　可是不吃饭头脑也转不起来）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema003"]}},
    {"op": "ModifyBackgroundExtended", "line": 53, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "HideActors", "line": 54, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "艾玛叹了口气，站起身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 60, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 61, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 62, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 70, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 71, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "食堂在哪里呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema004"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "艾玛想起【魔女图鉴】里面有地图，<br>\n于是点开手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative007"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "啊，找到了，食堂在这边……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema005"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "她正要准备跟着地图走，<br>\n却停住了脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative008"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "隔壁房好像还有人没动身，<br>\n有点好奇的艾玛悄悄往里面看了一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative009"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "（是城崎诺亚……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema006"]}},
    {"op": "AnimateActorExtended", "line": 87, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 88, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["200", "200", "true", "0.5", "#000000cc"], "ScenePosition": [-7.0, 50.0], "Rotation": [0.0, 0.0, -10.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 89, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [10.0, 80.0], "AppearanceAndTransition": "1_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Scale": [1.149999976158142], "Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Smile1,ArmL5", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 91, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Noah-Front"], "Enable": 1}},
    {"op": "ModifyBackgroundExtended", "line": 92, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 93, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "Wait", "line": 98, "indent": 0, "params": {"WaitMode": "1.0"}},
    {"op": "PlaySfxModified", "line": 99, "indent": 0, "params": {"SfxPath": "Sfx_15", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "哼哼哼～哼♪", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Noah001"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "诺亚一屁股坐在地上，<br>\n好像在专注做着什么事情。她现在正背对着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "呃，你好？现在是晚餐时间，你不去吃饭吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema007"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "艾玛在铁栅栏外向她说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Scale": [1.149999976158142], "Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Normal1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "诺亚把头转了过来。<br>\n她手上拿着喷漆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "诺亚今天不去吃饭哦？<br>\n诺亚才刚画到一半呢。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Noah002"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "（她到底有没有意识到自己被抓了？<br>\n　感觉她悠哉游哉的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "那你现在在画什么东西呢？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema009"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "嗯……你等一下哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Noah003"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "诺亚站起身来，<br>\n往旁边移动了一下，好让艾玛看到地面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR13", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "欸……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema010"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "艾玛发出惊愕的声音。<br>\n地面上画着的画——竟然自己会动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative014"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "喷漆画成的不知名图案<br>\n开始扭来扭去，变化成另一个形状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative015"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "转眼间，就变成了蛇的形状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative016"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "五颜六色的蛇在地面蠕动着，<br>\n给人带来恶心的真实感。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative017"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "怎、怎么回事！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Scale": [1.149999976158142], "Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Smile1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "诺亚歪着头，有点为难地微笑着说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative018"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "怎么说呢，诺亚的画，会自己动起来。<br>\n不只是画，只要是液体，都会自己动。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Scale": [1.149999976158142], "Lazy": 0, "ScenePosition": [25.0, 45.0], "IdAndAppearance": "Noah.Pensive1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "本来没想着画蛇的。<br>\n这下要重新画了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Noah005"]}},
    {"op": "HideActors", "line": 157, "indent": 0, "params": {"ActorIds": ["Noah-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 158, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1", "SubId": "Middle"}},
    {"op": "Wait", "line": 160, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "（会动……<br>\n　是因为，用了魔法？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema012"]}},
    {"op": "ShowToastUI", "line": 164, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 165, "indent": 0, "params": {"Id": "Noah", "Category": "Profile", "Version": 2}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "诺亚重新转过身坐在了地上。<br>\n艾玛茫然地呆望着她好一阵子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "（跟刚才梅露露的手发光<br>\n　帮我止血的时候一样）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema013"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "（魔法真的存在吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema014"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "尽管目睹了神奇的现象，<br>\n但艾玛还是难以相信，不禁摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative020"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "（现在没有功夫慢慢想了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "……那，那我先走啦。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema016"]}},
    {"op": "ResetText", "line": 183, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 184, "indent": 0, "params": {"SlotNumber": 2, "Wait": 0}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "艾玛朝诺亚的背影说道。<br>\n接着，在她正准备往上一楼的方向走的时候——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 188, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "放开我！混蛋！放开我啊怪物！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Alisa001"]}},
    {"op": "AnimateActorExtended", "line": 192, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 193, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["40", "200", "true", "0.3", "#000000"], "ScenePosition": [20.0, 50.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 194, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [-20.0, 36.0], "AppearanceAndTransition": "2_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Rotation": [0.0, 0.0, 40.0], "Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [33.0, 52.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR3", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 196, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Alisa-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 197, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 198, "indent": 0, "params": {"ActorIds": ["Alisa-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 199, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "她看到看守走下了楼梯，<br>\n而它的手好像夹篮球一样拦腰扣住了亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Ema.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "（我记得她，是紫藤亚里沙！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Ema017"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "开什么玩笑！凭什么就抓我！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Alisa002"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "尽管亚里沙嘴上<br>\n不依不饶，但是身体却没有表示出反抗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative023"]}},
