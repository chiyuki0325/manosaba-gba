    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "数小时前目击的恐怖情景在她脑海中复苏，<br>\n艾玛呆站在原地，身体止不住颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv07_Narrative026"]}},
