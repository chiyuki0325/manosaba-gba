    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-5", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 16, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "晚餐结束后，是一段较长的放风时间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "可以在受允许的范围内散步，<br>\n也可以去冲澡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（今天到处都看过了……<br>\n　已经很累了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（今天就先睡吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema002"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "在走进自己的牢房前，<br>\n艾玛不经意地往旁边的牢房看了一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative003"]}},
    {"op": "StopBgm", "line": 36, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "然后，倒吸了一口凉气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "——！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema003"]}},
    {"op": "HideAllCharacters", "line": 46, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 52, "indent": 0, "params": {"SfxPath": "Sfx_15", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "哼哼哼～哼♪", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah001"]}},
    {"op": "ModifyBackgroundExtended", "line": 66, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "PlayBgm", "line": 67, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Normal1,ArmR1,ArmL5"}},
    {"op": "AnimateActorExtended", "line": 70, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionY": "30", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "——整个室内<br>\n都被染成了一片通红。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative005"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "而诺亚就在里面<br>\n一屁股坐在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative006"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "本就不算大的牢房被彻底涂满了颜色，<br>\n散发出浓烈的喷漆气味。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 78, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 79, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR9,ArmL8"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "艾玛吓了一跳，然后在铁栅栏前蹲了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative008"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "诺、诺亚！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema004"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 87, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1,ArmR1,ArmL1"}},
    {"op": "AnimateActorExtended", "line": 89, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionY": "30", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "诺亚转过头来，<br>\n摆出了感到奇怪的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative009"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "嗯？慌慌张张的，有什么事吗？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah002"]}},
    {"op": "HideAllCharacters", "line": 95, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 96, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "呃，我说，这个房间……<br>\n怎么变成这样了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema005"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 102, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Normal1"}},
    {"op": "AnimateActorExtended", "line": 104, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionY": "30", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "因为它怎么都不肯变成诺亚想画的样子，<br>\n所以就想把它涂掉。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah003"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "然后，就全都变成这样子了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah004"]}},
    {"op": "HideAllCharacters", "line": 110, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 111, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "（她好像说过是画自己会动……<br>\n　就是说，诺亚她不能主动控制魔法吗？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema006"]}},
    {"op": "ShowToastUI", "line": 116, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 117, "indent": 0, "params": {"Id": "Noah", "Category": "Profile", "Version": 3}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "然后她察觉到了靠近的脚步声。<br>\n那脚步声非常非常小，应该是特意压低声音的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "艾玛把视线移到过道上，<br>\n便看到有一位少女站在那里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "呃……记得你叫夏目安安，对吗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema007"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_AnAn001"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "安安并没有开口回应。<br>\n她的嘴唇紧闭，只用一只眼睛紧盯着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative012"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "（她是不是有话要跟我说……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema008"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "安安的神情有些焦急，<br>\n一直望着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative013"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "呃，你找我有什么事？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema009"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_AnAn002"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "（她是不是很怕生啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema010"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "安安深深叹了一口气，<br>\n准备打开手上拿着的素描本。<br>\n可是——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative014"]}},
    {"op": "PlaySfxModified", "line": 153, "indent": 0, "params": {"SfxPath": "Sfx_17", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Angry1,ArmR1-Option-2"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "她有些笨手笨脚，<br>\n不小心把素描本弄掉在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative015"]}},
    {"op": "AnimateActorExtended", "line": 158, "indent": 0, "params": {"ActorIds": ["Ema"], "Loop": 0, "ScenePositionY": "40", "Duration": "5"}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "艾玛没有多想，正要伸手帮她捡起来时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative016"]}},
    {"op": "PlaySfxModified", "line": 166, "indent": 0, "params": {"SfxPath": "Sfx_18", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Angry1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "AnimateActorExtended", "line": 172, "indent": 0, "params": {"ActorIds": ["Ema"], "Loop": 0, "ScenePositionY": "50", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema011"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "她的手被安安用力甩开了。<br>\n看来她很讨厌别人碰她的东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative017"]}},
    {"op": "AnimateActorExtended", "line": 178, "indent": 0, "params": {"ActorIds": ["AnAn"], "Loop": 0, "ScenePositionY": "30", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "安安急忙把素描本捡起来，<br>\n然后用手上的笔<br>\n在素描本上唰唰写着什么东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Angry1,Arms2,Angle01/Option_Arms>Option_Arms01_02,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "AnimateActorExtended", "line": 183, "indent": 0, "params": {"ActorIds": ["AnAn"], "Loop": 0, "ScenePositionY": "50", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "然后她把刚写的那一页<br>\n举起给艾玛看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative019"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "『滚开。你挡吾辈的路了』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_AnAn003"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "欸，滚开……哇啊啊，对不起！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema012"]}},
    {"op": "HideActors", "line": 191, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "艾玛发现她原来挡住了<br>\n诺亚牢房的门口。<br>\n于是她马上让开了路。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative020"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "原来你和诺亚是同一间房。<br>\n对不起，我才知道。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema013"]}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Pensive1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_AnAn004"]}},
    {"op": "HideAllCharacters", "line": 201, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "安安小小叹了一口气，<br>\n站到牢房门前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative021"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "然后才把头转向牢房内——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Fearful1,ArmR6,ArmL7,ArmR-Option-Off,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "——！！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_AnAn005"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "她马上用手捂住了嘴，<br>\n好挡住自己下意识的惊声呼喊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative023"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "她看见了牢房被涂成一片鲜红的样子。<br>\n这幅画面本身给人的冲击力就很大。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative024"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "而且，室内还由内而外地散发出<br>\n喷漆的刺鼻气味。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative025"]}},
    {"op": "HideAllCharacters", "line": 220, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 221, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "AnimateActorExtended", "line": 223, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionY": "30", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "啊，是安安。<br>\n你回来啦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah005"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "诺亚露出了满面笑容，<br>\n但其中不掺杂半点恶意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative026"]}},
    {"op": "HideAllCharacters", "line": 229, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 230, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Fearful1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "安安的脸上渐渐没了血色，<br>\n变得一片苍白，身体止不住发抖……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative027"]}},
    {"op": "HideAllCharacters", "line": 235, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "然后，她晕倒了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative028"]}},
    {"op": "PlaySfxModified", "line": 243, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1,ArmR8,ArmL1"}},
    {"op": "AnimateActorExtended", "line": 245, "indent": 0, "params": {"ActorIds": ["Ema"], "Loop": 0, "ScenePositionY": "40", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "哇，安安，你没事吧！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema014"]}},
    {"op": "PlaySfxModified", "line": 249, "indent": 0, "params": {"SfxPath": "Sfx_18", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 251, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR1,ArmL1"}},
    {"op": "AnimateActorExtended", "line": 252, "indent": 0, "params": {"ActorIds": ["Ema"], "Loop": 0, "ScenePositionY": "50", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "艾玛自然而然伸出了手，<br>\n可是被安安挡开了。<br>\n她似乎很拼命地保持住了意识。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative029"]}},
    {"op": "PlaySfxModified", "line": 256, "indent": 0, "params": {"SfxPath": "Sfx_49", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 257, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "其他少女应该是注意到了<br>\n这边的异常，过来了好几个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative030"]}},
    {"op": "ModifyCharacterExtended", "line": 261, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema"}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "究竟出了什么事！？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Leia001"]}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "呃，安安她被房间的样子吓了一跳，<br>\n好像有点贫血……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 268, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "AnimateActorExtended", "line": 269, "indent": 0, "params": {"ActorIds": ["Leia"], "Loop": 0, "ScenePositionY": "30", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "蕾雅轻松地抱起了安安整个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative031"]}},
    {"op": "HideActors", "line": 273, "indent": 0, "params": {"ActorIds": ["Leia"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "艾玛有点吃惊。虽然安安身材娇小，<br>\n但要抱起她，应该也得花不少力气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative032"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "地图上有标注医务室的位置，<br>\n我会把她带到那边。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Leia002"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "蕾雅用公主抱的姿势抱着安安，<br>\n英姿飒爽地走掉了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative033"]}},
    {"op": "HideAllCharacters", "line": 281, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "骚动逐渐平息，<br>\n聚集而来的少女也解散回房了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative034"]}},
    {"op": "ModifyBackgroundExtended", "line": 285, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 286, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "AnimateActorExtended", "line": 287, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionY": "50", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "牢房内的诺亚感到有些为难，<br>\n呆呆地站在原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative035"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "……诺亚是不是吓到大家了？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah006"]}},
    {"op": "HideAllCharacters", "line": 293, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 294, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 295, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "嗯……大概是的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema016"]}},
    {"op": "HideAllCharacters", "line": 299, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 300, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 301, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1,ArmR1,ArmL5"}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "那，下次诺亚要给安安<br>\n画她会感到开心的画！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah007"]}},
    {"op": "AnimateActorExtended", "line": 305, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "ScenePositionY": "30", "Duration": "0"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "这么说着，诺亚又一屁股坐在地上，<br>\n开始按动手上的喷漆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative036"]}},
    {"op": "PlaySfxModified", "line": 313, "indent": 0, "params": {"SfxPath": "Sfx_15", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 317, "indent": 0, "params": {"Text": "哼哼哼～哼♪", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Noah008"]}},
    {"op": "HideAllCharacters", "line": 319, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 320, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "white", "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyCharacterExtended", "line": 321, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "（我猜这股味道也是安安不舒服的<br>\n　原因之一。她们两个真是相处不来……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema017"]}},
    {"op": "PrintTextModified", "line": 325, "indent": 0, "params": {"Text": "（不过诺亚好像很开心的样子……她应该是真心喜欢画画的……<br>\n　我实在说不出口，让她不要再画）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema018"]}},
    {"op": "PrintTextModified", "line": 327, "indent": 0, "params": {"Text": "（毕竟我们还根本不熟悉彼此）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Ema019"]}},
    {"op": "HideAllCharacters", "line": 329, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "艾玛把到了嘴边的话又吞了回去，<br>\n转身回到自己的牢房里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv09_Narrative037"]}},
    {"op": "Gosub", "line": 337, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 339, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv10", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv09_Narrative001": "晚餐结束后，是一段较长的放风时间。",
  "0101Adv09_Narrative002": "可以在受允许的范围内散步，<br>\n也可以去冲澡。",
  "0101Adv09_Ema001": "（今天到处都看过了……<br>\n　已经很累了）",
  "0101Adv09_Ema002": "（今天就先睡吧……）",
  "0101Adv09_Narrative003": "在走进自己的牢房前，<br>\n艾玛不经意地往旁边的牢房看了一眼。",
  "0101Adv09_Narrative004": "然后，倒吸了一口凉气。",
  "0101Adv09_Ema003": "——！",
  "0101Adv09_Noah001": "哼哼哼～哼♪",
  "0101Adv09_Narrative005": "——整个室内<br>\n都被染成了一片通红。",
  "0101Adv09_Narrative006": "而诺亚就在里面<br>\n一屁股坐在地上。",
  "0101Adv09_Narrative007": "本就不算大的牢房被彻底涂满了颜色，<br>\n散发出浓烈的喷漆气味。",
  "0101Adv09_Narrative008": "艾玛吓了一跳，然后在铁栅栏前蹲了下来。",
  "0101Adv09_Ema004": "诺、诺亚！？",
  "0101Adv09_Narrative009": "诺亚转过头来，<br>\n摆出了感到奇怪的表情。",
  "0101Adv09_Noah002": "嗯？慌慌张张的，有什么事吗？",
  "0101Adv09_Ema005": "呃，我说，这个房间……<br>\n怎么变成这样了？",
  "0101Adv09_Noah003": "因为它怎么都不肯变成诺亚想画的样子，<br>\n所以就想把它涂掉。",
  "0101Adv09_Noah004": "然后，就全都变成这样子了。",
  "0101Adv09_Ema006": "（她好像说过是画自己会动……<br>\n　就是说，诺亚她不能主动控制魔法吗？）",
  "Toast_001": "魔女图鉴 更新…",
  "0101Adv09_Narrative010": "然后她察觉到了靠近的脚步声。<br>\n那脚步声非常非常小，应该是特意压低声音的。",
  "0101Adv09_Narrative011": "艾玛把视线移到过道上，<br>\n便看到有一位少女站在那里。",
  "0101Adv09_Ema007": "呃……记得你叫夏目安安，对吗。",
  "0101Adv09_AnAn001": "…………",
  "0101Adv09_Narrative012": "安安并没有开口回应。<br>\n她的嘴唇紧闭，只用一只眼睛紧盯着艾玛。",
  "0101Adv09_Ema008": "（她是不是有话要跟我说……？）",
  "0101Adv09_Narrative013": "安安的神情有些焦急，<br>\n一直望着艾玛。",
  "0101Adv09_Ema009": "呃，你找我有什么事？",
  "0101Adv09_AnAn002": "…………",
  "0101Adv09_Ema010": "（她是不是很怕生啊……）",
  "0101Adv09_Narrative014": "安安深深叹了一口气，<br>\n准备打开手上拿着的素描本。<br>\n可是——",
  "0101Adv09_Narrative015": "她有些笨手笨脚，<br>\n不小心把素描本弄掉在地上。",
  "0101Adv09_Narrative016": "艾玛没有多想，正要伸手帮她捡起来时——",
  "0101Adv09_Ema011": "……",
  "0101Adv09_Narrative017": "她的手被安安用力甩开了。<br>\n看来她很讨厌别人碰她的东西。",
  "0101Adv09_Narrative018": "安安急忙把素描本捡起来，<br>\n然后用手上的笔<br>\n在素描本上唰唰写着什么东西。",
  "0101Adv09_Narrative019": "然后她把刚写的那一页<br>\n举起给艾玛看。",
  "0101Adv09_AnAn003": "『滚开。你挡吾辈的路了』",
  "0101Adv09_Ema012": "欸，滚开……哇啊啊，对不起！",
  "0101Adv09_Narrative020": "艾玛发现她原来挡住了<br>\n诺亚牢房的门口。<br>\n于是她马上让开了路。",
  "0101Adv09_Ema013": "原来你和诺亚是同一间房。<br>\n对不起，我才知道。",
  "0101Adv09_AnAn004": "…………",
  "0101Adv09_Narrative021": "安安小小叹了一口气，<br>\n站到牢房门前。",
  "0101Adv09_Narrative022": "然后才把头转向牢房内——",
  "0101Adv09_AnAn005": "——！！",
  "0101Adv09_Narrative023": "她马上用手捂住了嘴，<br>\n好挡住自己下意识的惊声呼喊。",
  "0101Adv09_Narrative024": "她看见了牢房被涂成一片鲜红的样子。<br>\n这幅画面本身给人的冲击力就很大。",
  "0101Adv09_Narrative025": "而且，室内还由内而外地散发出<br>\n喷漆的刺鼻气味。",
  "0101Adv09_Noah005": "啊，是安安。<br>\n你回来啦。",
  "0101Adv09_Narrative026": "诺亚露出了满面笑容，<br>\n但其中不掺杂半点恶意。",
  "0101Adv09_Narrative027": "安安的脸上渐渐没了血色，<br>\n变得一片苍白，身体止不住发抖……",
  "0101Adv09_Narrative028": "然后，她晕倒了。",
  "0101Adv09_Ema014": "哇，安安，你没事吧！？",
  "0101Adv09_Narrative029": "艾玛自然而然伸出了手，<br>\n可是被安安挡开了。<br>\n她似乎很拼命地保持住了意识。",
  "0101Adv09_Narrative030": "其他少女应该是注意到了<br>\n这边的异常，过来了好几个人。",
  "0101Adv09_Leia001": "究竟出了什么事！？",
  "0101Adv09_Ema015": "呃，安安她被房间的样子吓了一跳，<br>\n好像有点贫血……",
  "0101Adv09_Narrative031": "蕾雅轻松地抱起了安安整个人。",
  "0101Adv09_Narrative032": "艾玛有点吃惊。虽然安安身材娇小，<br>\n但要抱起她，应该也得花不少力气。",
  "0101Adv09_Leia002": "地图上有标注医务室的位置，<br>\n我会把她带到那边。",
  "0101Adv09_Narrative033": "蕾雅用公主抱的姿势抱着安安，<br>\n英姿飒爽地走掉了。",
  "0101Adv09_Narrative034": "骚动逐渐平息，<br>\n聚集而来的少女也解散回房了。",
  "0101Adv09_Narrative035": "牢房内的诺亚感到有些为难，<br>\n呆呆地站在原地。",
  "0101Adv09_Noah006": "……诺亚是不是吓到大家了？",
  "0101Adv09_Ema016": "嗯……大概是的。",
  "0101Adv09_Noah007": "那，下次诺亚要给安安<br>\n画她会感到开心的画！",
  "0101Adv09_Narrative036": "这么说着，诺亚又一屁股坐在地上，<br>\n开始按动手上的喷漆。",
  "0101Adv09_Noah008": "哼哼哼～哼♪",
  "0101Adv09_Ema017": "（我猜这股味道也是安安不舒服的<br>\n　原因之一。她们两个真是相处不来……）",
  "0101Adv09_Ema018": "（不过诺亚好像很开心的样子……她应该是真心喜欢画画的……<br>\n　我实在说不出口，让她不要再画）",
  "0101Adv09_Ema019": "（毕竟我们还根本不熟悉彼此）",
  "0101Adv09_Narrative037": "艾玛把到了嘴边的话又吞了回去，<br>\n转身回到自己的牢房里。"
}
}
