    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "两人的距离越来越远。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative024"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "艾玛心想，<br>\n安安的内心或许是在拒绝着艾玛……也就是拒绝着他人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative025"]}},
