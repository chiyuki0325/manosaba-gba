{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv30",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-26", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_2"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "她们来到医务室，<br>\n便看见躺在床上的安安，还有梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1,ArmR3,ArmL4"}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "雪、雪莉小姐，<br>\n你的脸色不是很好……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru001"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "梅露露最先注意到脸色发白的雪莉，<br>\n一脸担心地走了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative002"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "虽说健康和充满活力是我屈指可数的优点啦，<br>\n但还是感觉好累啊。唔……不应该啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Sherry001"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "请、请你休息一下！<br>\n我去给你泡缓解疲劳的香草茶哦……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR10,ArmL1"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "哇！谢谢你！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 41, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "梅露露开始用壶烧水，<br>\n艾玛走到她身旁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "梅露露。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Surprised"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "什、什么事～～……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru003"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "梅露露精神集中在泡茶上，<br>\n听到有人喊她，不禁吓到抖了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "哇，不好意思吓到你！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "没、没事的没事的！<br>\n被吓到都是我的不好，对不起……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru004"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "我、我、我要做深呼吸，<br>\n请你等我一下……嘶～呼～嘶～呼～……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru005"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "等梅露露冷静下来后，<br>\n艾玛便开口问。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "安安的情况怎么样了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "现在已经冷静下来了……她一定受到了很大的冲击，<br>\n毕竟回自己的房间时却看到了诺亚小姐她……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru006"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "梅露露眼眶湿润，似乎马上就要哭出来似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative006"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "我还没来得及为诺亚小姐做任何事，她就……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru007"]}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "谁都不会想到<br>\n会发生这种事……啊，对了！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "艾玛不忍心看到梅露露垂头丧气的样子，<br>\n于是大声说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative007"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "那是什么香草？<br>\n你还会摘香草泡茶，真的好厉害。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "是迷迭香。<br>\n这个很有益于恢复疲劳哦。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru008"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "看来艾玛成功分散了她的注意力，<br>\n梅露露的脸上终于露出了些许笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative008"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "请你们一定要喝一口看看哦。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Meruru009"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "嗯，谢谢你。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema006"]}},
    {"op": "HideAllCharacters", "line": 102, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 108, "indent": 0, "params": {"SfxPath": "Sfx_31", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "艾玛一行人<br>\n从梅露露手里接过香草茶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative009"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "（好清爽通透的香气……<br>\n　感觉整个人都变得舒服了一些）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema007"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "经过短暂的休息，<br>\n艾玛望向安安所在的床上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative010"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "（安安和诺亚是住在同一间房的……<br>\n　我想和她谈一谈）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema008"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "（有些担心<br>\n　能不能和她顺利对话……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema009"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "艾玛下定了决心，<br>\n来到安安的面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Pensive1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "安安，你还好吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema010"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_AnAn001"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "艾玛站在床边，<br>\n看到安安眼神呆滞地望着天花板。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative012"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "那个，安安你和诺亚她<br>\n住在同一间房，对不对。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema011"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "虽然你和她相处的时间<br>\n应该不是很长……你有没有注意到什么特别的事？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema012"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "安安大大地叹了一口气，<br>\n毫无干劲地取出了素描本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative013"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "她在上面唰唰地写着什么东西，<br>\n然后举起来给艾玛看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Pensive1,Arms2,Angle01/Option_Arms>Option_Arms02_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "『吾辈非常非常讨厌和她住一间房』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_AnAn002"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "写在素描本上的文字<br>\n强烈地反映出了她的心声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "也、也是啦……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema013"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "（嗯——？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema014"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "素描本的一角留有折痕，<br>\n而折痕后稍稍露出的内容吸引住了艾玛的视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "安安，我说，<br>\n你在那一页上面画的是——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 158, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "艾玛伸手指着那一角，<br>\n安安变得有些心虚，把视线移到了别处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative017"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "不久后她便放弃了掩饰，<br>\n撕下素描本里的其中一页，递给了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative018"]}},
    {"op": "ResetText", "line": 167, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 168, "indent": 0, "params": {"Path": "Clue", "Params": ["1-2"]}},
    {"op": "ShowToastUI", "line": 169, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 170, "indent": 0, "params": {"Id": "1-2", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 171, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 173, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 174, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "（蝴蝶的画！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema016"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "艾玛下意识探出身子，<br>\n一下子凑近了安安的脸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative019"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "这、这个难道是，<br>\n诺亚画的？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema017"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "为什么诺亚会画蝴蝶的画！？<br>\n又是为什么会<br>\n画在安安的素描本上！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema018"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "安安的表情变得十分不悦，<br>\n她缓缓开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Angry1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "吾辈现在很不舒服。<br>\n大声对吾辈讲话会害吾辈更不舒服。<br>\n所以——【出去】。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_AnAn003"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "就在轻声的话语说出口的瞬间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "AnimateActorExtended", "line": 195, "indent": 0, "params": {"ActorIds": ["Ema"], "Loop": 0, "ScenePositionX": "60|70|80", "Duration": "0.5|0.5|0.5"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "艾玛的身体违背她本人的意愿<br>\n开始往后退，离安安越来越远。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative022"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "咦，啊，为什么……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema019"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "安安在素描本上唰唰写了字，<br>\n然后举了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "AnAn.Pensive1,Arms2,Angle01/Option_Arms>Option_Arms01_03,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "『吾辈的魔法是，只要得到对方的认可，<br>\n　就可以令对方服从指令』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_AnAn004"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "『换言之，就是轻度的【洗脑】』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_AnAn005"]}},
    {"op": "UpdateWitchBook", "line": 209, "indent": 0, "params": {"Id": "AnAn", "Category": "Profile", "Version": 2}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "欸——……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema020"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "（这就是安安<br>\n　不说话的原因……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv30_Ema021"]}},
