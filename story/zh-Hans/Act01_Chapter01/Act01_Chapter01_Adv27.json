  "path": "Act01_Chapter01/Act01_Chapter01_Adv27",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-23", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛一行人去了外面，<br>\n来到了森林中某座湖的边上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "你来这种地方找什么？<br>\n我并不觉得这里会有什么<br>\n和诺亚被杀有关的东西……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "正走在路上时，听见背后传来了吐槽声，<br>\n艾玛支吾了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（非要讲的话，<br>\n　我更多是想呼吸一下外面的新鲜空气）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "监牢的地下躺着诺亚的遗体。<br>\n想到这个事实，艾玛就感觉坐立不安。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "抱歉，来这里调查<br>\n应该没什么意义。<br>\n我们快回去吧——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema002"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "哎呀，似乎还有其他人来了这个地方呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 49, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 50, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["40", "200", "true", "0.3", "#000000"], "ScenePosition": [20.0, 50.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 51, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [-20.0, 36.0], "AppearanceAndTransition": "17_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [20.0, 32.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 53, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Alisa-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 54, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 55, "indent": 0, "params": {"ActorIds": ["Alisa-Front"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 56, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "顺着汉娜指的方向望去，<br>\n能看到有一位少女正坐在湖边上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative004"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "（亚里沙……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema003"]}},
    {"op": "HidePrinter", "line": 62, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 63, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Alisa-Front"], "Loop": 0}},
    {"op": "AnimateActorExtended", "line": 64, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "44", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 65, "indent": 0, "params": {"ActorIds": ["Alisa-Front"], "Loop": 0, "ScenePositionY": "48", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "HideActors", "line": 66, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Alisa-Front"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 67, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 68, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "难得来一趟，我们去和亚里沙聊聊看吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema004"]}},
    {"op": "HideAllCharacters", "line": 74, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1,ArmR7"}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "啊，那我就不和你们一起聊了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry002"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "欸，为什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema005"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "我虽然和亚里沙住一间房，<br>\n不过她超嫌弃我的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "我懂她的感觉。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Hanna002"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "如果我在的话，她估计就会发一顿脾气，<br>\n然后直接逃掉。所以我就先藏起来咯。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 91, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "（雪莉她能<br>\n　藏得住吗？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema006"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "艾玛感到有些疑惑。<br>\n接着，她走到了亚里沙身边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "你好，亚里沙。你在这里做什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL2"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "搞什么，别过来我这好不好。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa001"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "亚里沙明显地不太欢迎来客，<br>\n她咂了咂舌，眼神紧盯着艾玛这边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "艾玛虽然有些害怕，<br>\n可还是鼓起勇气向亚里沙踏出一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative007"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "你昨晚在过道撞到了我，对吗？<br>\n我想问，你当时在那边做了些什么。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "你撞到我们之后……<br>\n我看你当时十分慌张欸？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Hanna003"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "啊？你们几个，<br>\n是在怀疑我动手了？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "没、没有这个意思……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema009"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "一到这种时候，你们这些人就只会说<br>\n都是我干的……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa003"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL7"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "你惹我很不爽！给我滚！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa004"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Pensive1,ArmR4"}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "艾玛和汉娜被臭骂了一顿，<br>\n吓得打了一个哆嗦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative008"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "看来和她是讲不通了。<br>\n哼，艾玛，我们走。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Hanna004"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema010"]}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "正当她们两个要转身离开时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmL3"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "……我是想去看画啦。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa005"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "艾玛听到了她的自言自语，于是回过头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "画……你是说诺亚在房间里面画的<br>\n喷漆画……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema011"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "亚里沙表情扭作一团，似乎很不愿意聊这件事，<br>\n但还是渐渐说了出口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative011"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "我很早就发觉她是【气球】了。<br>\n自那以后，为了看画，我去过她那边好几次了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa006"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "昨天我也是去看画了，<br>\n但是正好碰到了那个模范生，因为感觉很尴尬，所以就回去了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa007"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "（是这样啊……<br>\n　亚里沙是为了看诺亚的画才过去的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema012"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "谢谢你愿意跟我说。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema013"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "亚里沙好像有些别扭，<br>\n她将石子丢进了湖里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmL1"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "我想起我在湖边捡到了这个。<br>\n这不是那家伙在找的东西吗？给你了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa008"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "亚里沙递过来的，是一根发带。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative013"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "（这个难道是奈叶香在找的发带…？<br>\n　不过，看起来上面沾着血迹……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema014"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "我先声明，这可不是我偷的。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa009"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "总之，艾玛还是从亚里沙手里接过了那根发带。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative014"]}},
    {"op": "ResetText", "line": 181, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 182, "indent": 0, "params": {"Path": "Clue", "Params": ["1-3"]}},
    {"op": "ShowToastUI", "line": 183, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 184, "indent": 0, "params": {"Id": "1-3", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 185, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 187, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 188, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "已经没有我事了吧，你们该滚了。<br>\n和藏在那边的苍蝇妹一起滚。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa010"]}},
    {"op": "HideAllCharacters", "line": 192, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "至、<br>\n至少喊人家【小仙子】嘛～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry005"]}},
    {"op": "ModifyCharacterExtended", "line": 196, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1,ArmR10"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "看来是完全没藏住。<br>\n雪莉从藏身的草丛中钻了出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "顺带一说，我可没有怀疑亚里沙你哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,Arms1"}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "哼，随便你。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa011"]}},
    {"op": "ModifyCharacterExtended", "line": 208, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "啊，有件事我要问你。<br>\n亚里沙你会用怎样的魔法？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry007"]}},
    {"op": "ModifyCharacterExtended", "line": 212, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "……先说好，我没有故意要隐瞒。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa012"]}},
    {"op": "PlaySfxModified", "line": 220, "indent": 0, "params": {"SfxPath": "Sfx_30", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Normal1,Angle01/Option_ArmL+,ArmL11,ArmR1"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "亚里沙在手指尖上<br>\n“噗”地点着一小团火焰，<br>\n就好像拿着一支看不见的打火机似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 225, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Surprised1,ArmR15"}},
    {"op": "Wait", "line": 226, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "EmoteJumpDouble", "line": 227, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "是<ruby=\"pyrokinesis\">点火超能力</ruby>耶！<br>\n好厉害好厉害好厉害～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Sherry008"]}},
    {"op": "ShowToastUI", "line": 231, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 232, "indent": 0, "params": {"Id": "Alisa", "Category": "Profile", "Version": 2}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "雪莉看到亚里沙的魔法后欢欣雀跃了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative017"]}},
    {"op": "HideAllCharacters", "line": 236, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "（根据每个人魔法的特性，<br>\n　或许可以推导出，谁有能力实施<br>\n　不可能的杀人手法……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Ema015"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "所以汉娜才会第一个被怀疑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative018"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "亚里沙这时已经没心思<br>\n和艾玛她们继续聊下去了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative019"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "她无言望着湖面，<br>\n一丝寂寥挂在她的侧脸上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative020"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "艾玛一行人互相用眼神交流了一下，<br>\n便打算离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative021"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "正当她们刚迈出步伐——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative022"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "我很喜欢她的画。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Alisa013"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "便传来她的小声嘟哝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative023"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "她的自言自语无处可去，<br>\n最终消失在了虚空之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv27_Narrative024"]}},
