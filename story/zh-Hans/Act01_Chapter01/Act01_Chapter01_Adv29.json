    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "虽然这里确实到处都是灰尘，<br>\n可大家也不至于有心情打扫吧。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Hanna003"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "（这里没有其他令人在意的事了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Ema007"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "为了躲避看守的视线，<br>\n艾玛她们慌忙离开了玄关大厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Narrative007"]}},
