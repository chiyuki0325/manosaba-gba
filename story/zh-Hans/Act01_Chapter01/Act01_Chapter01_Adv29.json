    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（我还是有点害怕在这附近走动）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Ema001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "看守经常会来玄关大厅这边巡逻站岗。<br>\n它什么时候悄悄出现在这里都不出奇。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Narrative001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（现、现在不是害怕的时候……！<br>\n　我要调查才行！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR3,ArmL4"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "……呼。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Sherry001"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "这时雪莉竟大大地叹了一口气。很少见她会有这种反应。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "你怎么了？<br>\n天不怕地不怕的雪莉竟然会叹气。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Hanna001"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "总感觉最近好容易变累啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Sherry002"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "我可是无限体力的怪人耶，<br>\n怎么会这样呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "先是希罗死了，接着连诺亚也死了……<br>\n目击了这些残忍的事，怎么还可能保持正常……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Ema003"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "但雪莉却把手指抵在唇尖上，歪头表示疑问。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR3,ArmL11"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "唔～……不过尸体我倒是看习惯了耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Sherry004"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "（欸……？那是什么意思……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Ema004"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "艾玛正准备张嘴回问，<br>\n但汉娜抢先发言了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Narrative004"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "这边的清扫工具柜<br>\n没有关上欸。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "啊，真的耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Sherry005"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "三人来到了楼梯附近的<br>\n清扫工具柜跟前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Narrative005"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "你们有没有亲眼见过<br>\n看守打扫的样子？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "没见过。是谁打扫的呢？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Ema005"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "清扫工具柜的柜门处露出了扫帚的长柄。<br>\n仔细一看，扫帚的接头部分也被人拆开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Narrative006"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "（感觉有些可疑）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv29_Ema006"]}},
