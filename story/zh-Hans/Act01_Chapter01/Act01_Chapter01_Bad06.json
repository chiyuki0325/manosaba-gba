  "path": "Act01_Chapter01/Act01_Chapter01_Bad06",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 3, "indent": 1, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "label", "name": "Scene1-1-b6", "line": 9, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "PlayBgm", "line": 16, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "摇了摇头，说“算了，还是没事了”。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "真的吗……？那我们走吧。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 24, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "梅露露和艾玛手牵手离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "不过艾玛还是有些在意诺亚的情况，<br>\n扭头往她的房间看了一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（诺亚她今天也不去用餐吗）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "也许她还在专心搞艺术吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative004"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（可是，有点奇怪。<br>\n　平常的话，应该能听到她的喷罐声音才对……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "艾玛小姐，<br>\n你其实是不是还有在意的事？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "……不，没事的。我们走吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "真的吗？<br>\n你是不是哪里不舒服……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 49, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "面对正爬着楼梯的艾玛，梅露露有些担心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative005"]}},
    {"op": "PlaySfxModified", "line": 54, "indent": 0, "params": {"SfxPath": "Sfx_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 56, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 57, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 58, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 60, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyBackgroundExtended", "line": 61, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 62, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "StopBgm", "line": 64, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "（今天又要吃那种饭菜了啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema004"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "走进食堂的艾玛一想到那些黏糊糊的<br>\n诡异饭菜，便叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "哎呀？感觉今天好像味道香香的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema005"]}},
    {"op": "PlayBgm", "line": 74, "indent": 0, "params": {"BgmPath": "Bgm_34_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "香飘四溢的气味，<br>\n令艾玛大感意外，禁不住再用力闻上一闻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR5"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "啊，艾玛！<br>\n你终于来了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "雪莉挥手向艾玛招呼。<br>\n其他的少女今天也难得地都坐在了一起。<br>\n所有人都已经开始用餐了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR13"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "欸欸，不是真的吧……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema006"]}},
    {"op": "HideAllCharacters", "line": 92, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "看着托盘上盛放的饭菜，<br>\n艾玛发出惊讶的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative009"]}},
    {"op": "PlaySfxModified", "line": 97, "indent": 0, "params": {"SfxPath": "Sfx_82", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "上面盛放的，<br>\n不是平时那些恶心的饭菜，<br>\n而是烤得恰到好处的肉排。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR13"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "……这是肉！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema007"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "不止有肉排，<br>\n还有浓汤、炸物、排骨。<br>\n除此之外，还有其他丰富多样的肉菜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative011"]}},
    {"op": "PlaySfxModified", "line": 110, "indent": 0, "params": {"SfxPath": "Sfx_83", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "浓汤里面的肉松松软软的，<br>\n好好吃～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile1,ArmR3"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "这味道和香气可谓顶级。<br>\n肉排的熟度也控制得十分绝妙。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Leia001"]}},
    {"op": "HideAllCharacters", "line": 121, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR11"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "来，奈叶香你也快吃吧！<br>\n这边的红色果汁很好喝哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 126, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "好、好的……<br>\n……啊，还真的挺好喝。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Nanoka001"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Smile1,Arms2,Angle01/Option_Arms>Option_Arms01_03,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "『吃了感觉有瘾。里面放了什么香料？』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_AnAn001"]}},
    {"op": "PlaySfxModified", "line": 137, "indent": 0, "params": {"SfxPath": "Sfx_84", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Smile1,ArmR6"}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "我说，这边的炸物也好吃爆了！<br>\n来，米莉亚你也快吃！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Smile1,ArmR10"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "大叔我吃不来这种腻的……<br>\n啊，可是这个比想像中的爽口欸。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Miria001"]}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Normal1,ArmR5,ArmL2,Option-ArmL-Off"}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "看你们这一脸幸福的样子，<br>\n不就是一顿饭，亏你们能吃得这么开心。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Smile,ArmL3"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "呵呵呵……嘴上就会说别人，<br>\n你这都第几盘了？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Margo001"]}},
    {"op": "HideAllCharacters", "line": 159, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR4"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "艾玛，梅露露，你们两个也快一起吃吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 164, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "啊……好、好的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema008"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "在雪莉的催促下，艾玛和梅露露也就座了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative012"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "我开吃咯——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema009"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "艾玛双手合掌后，开始将饭菜送进嘴里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile1,ArmR1"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "嗯，好好吃……！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema010"]}},
    {"op": "HideAllCharacters", "line": 179, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "今天大家看起来好幸福，真是太好了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Meruru004"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "嗯。感觉，这样也挺不错的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema011"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "大家能在一起热热闹闹吃饭，<br>\n真是开心……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema012"]}},
    {"op": "HideAllCharacters", "line": 191, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "自从来到这里，她们身边常常充满着杀气和紧张的气氛。<br>\n不过今晚，少女之间的气氛却是十分和睦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative014"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "（要是之后可以一直不发生互相厮杀，<br>\n　所有人能一起离开这里就更好了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema013"]}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "……啊，诺亚……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema014"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "忽然间，她想起现在这里缺了一个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative015"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "（这么好吃的饭菜，没吃到真是太可惜了。<br>\n　之后给诺亚也带一些饭菜过去吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile1,ArmR1"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "话说回来，这个肉……真的好好吃！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema016"]}},
    {"op": "HideAllCharacters", "line": 209, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 211, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 213, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 214, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 215, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 216, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "晚餐后，<br>\n艾玛去给诺亚送饭了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "诺亚，我给你带今天的晚餐了……哎呀？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema017"]}},
    {"op": "HideAllCharacters", "line": 224, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "涂满喷漆画的房内，<br>\n不见诺亚的影子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative017"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "只见她用过的喷罐<br>\n孤零零地躺在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "（真奇怪……她跑哪里去了？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema018"]}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "晚餐后是一段较长的放风时间，<br>\n或许她是跑到别的地方打发时间了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "（如果是这样的话，那她晚点就回来了吧。<br>\n　希望她能喜欢我给她带的饭）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Ema019"]}},
    {"op": "HideAllCharacters", "line": 240, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 242, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 243, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "可是，不管过了多久，<br>\n城崎诺亚都没有再回来过了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative020"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "虽然四处找过她，但都没找着。<br>\n时间就这样一天天地流逝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative021"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "之后，监牢内<br>\n定期会有【美味大餐】供应，但——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative022"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "每次出餐，都会有一位少女不知所踪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad06_Narrative023"]}},
    {"op": "ProcessBadEnd", "line": 257, "indent": 0, "params": {"Number": 6}}
  ],
  "translations": {
  "0101Bad06_Narrative001": "摇了摇头，说“算了，还是没事了”。",
  "0101Bad06_Meruru001": "真的吗……？那我们走吧。",
  "0101Bad06_Narrative002": "梅露露和艾玛手牵手离开了。",
  "0101Bad06_Narrative003": "不过艾玛还是有些在意诺亚的情况，<br>\n扭头往她的房间看了一眼。",
  "0101Bad06_Ema001": "（诺亚她今天也不去用餐吗）",
  "0101Bad06_Narrative004": "也许她还在专心搞艺术吧。",
  "0101Bad06_Ema002": "（可是，有点奇怪。<br>\n　平常的话，应该能听到她的喷罐声音才对……）",
  "0101Bad06_Meruru002": "艾玛小姐，<br>\n你其实是不是还有在意的事？",
  "0101Bad06_Ema003": "……不，没事的。我们走吧。",
  "0101Bad06_Meruru003": "真的吗？<br>\n你是不是哪里不舒服……！",
  "0101Bad06_Narrative005": "面对正爬着楼梯的艾玛，梅露露有些担心。",
  "0101Bad06_Ema004": "（今天又要吃那种饭菜了啊）",
  "0101Bad06_Narrative006": "走进食堂的艾玛一想到那些黏糊糊的<br>\n诡异饭菜，便叹了口气。",
  "0101Bad06_Ema005": "哎呀？感觉今天好像味道香香的……",
  "0101Bad06_Narrative007": "香飘四溢的气味，<br>\n令艾玛大感意外，禁不住再用力闻上一闻。",
  "0101Bad06_Sherry001": "啊，艾玛！<br>\n你终于来了！",
  "0101Bad06_Narrative008": "雪莉挥手向艾玛招呼。<br>\n其他的少女今天也难得地都坐在了一起。<br>\n所有人都已经开始用餐了。",
  "0101Bad06_Ema006": "欸欸，不是真的吧……！？",
  "0101Bad06_Narrative009": "看着托盘上盛放的饭菜，<br>\n艾玛发出惊讶的声音。",
  "0101Bad06_Narrative010": "上面盛放的，<br>\n不是平时那些恶心的饭菜，<br>\n而是烤得恰到好处的肉排。",
  "0101Bad06_Ema007": "……这是肉！？",
  "0101Bad06_Narrative011": "不止有肉排，<br>\n还有浓汤、炸物、排骨。<br>\n除此之外，还有其他丰富多样的肉菜。",
  "0101Bad06_Hanna001": "浓汤里面的肉松松软软的，<br>\n好好吃～！",
  "0101Bad06_Leia001": "这味道和香气可谓顶级。<br>\n肉排的熟度也控制得十分绝妙。",
  "0101Bad06_Sherry002": "来，奈叶香你也快吃吧！<br>\n这边的红色果汁很好喝哦！",
  "0101Bad06_Nanoka001": "好、好的……<br>\n……啊，还真的挺好喝。",
  "0101Bad06_AnAn001": "『吃了感觉有瘾。里面放了什么香料？』",
  "0101Bad06_Coco001": "我说，这边的炸物也好吃爆了！<br>\n来，米莉亚你也快吃！",
  "0101Bad06_Miria001": "大叔我吃不来这种腻的……<br>\n啊，可是这个比想像中的爽口欸。",
  "0101Bad06_Alisa001": "看你们这一脸幸福的样子，<br>\n不就是一顿饭，亏你们能吃得这么开心。",
  "0101Bad06_Margo001": "呵呵呵……嘴上就会说别人，<br>\n你这都第几盘了？",
  "0101Bad06_Sherry003": "艾玛，梅露露，你们两个也快一起吃吧！",
  "0101Bad06_Ema008": "啊……好、好的！",
  "0101Bad06_Narrative012": "在雪莉的催促下，艾玛和梅露露也就座了。",
  "0101Bad06_Ema009": "我开吃咯——",
  "0101Bad06_Narrative013": "艾玛双手合掌后，开始将饭菜送进嘴里。",
  "0101Bad06_Ema010": "嗯，好好吃……！！",
  "0101Bad06_Meruru004": "今天大家看起来好幸福，真是太好了……",
  "0101Bad06_Ema011": "嗯。感觉，这样也挺不错的……",
  "0101Bad06_Ema012": "大家能在一起热热闹闹吃饭，<br>\n真是开心……",
  "0101Bad06_Narrative014": "自从来到这里，她们身边常常充满着杀气和紧张的气氛。<br>\n不过今晚，少女之间的气氛却是十分和睦。",
  "0101Bad06_Ema013": "（要是之后可以一直不发生互相厮杀，<br>\n　所有人能一起离开这里就更好了）",
  "0101Bad06_Ema014": "……啊，诺亚……",
  "0101Bad06_Narrative015": "忽然间，她想起现在这里缺了一个人。",
  "0101Bad06_Ema015": "（这么好吃的饭菜，没吃到真是太可惜了。<br>\n　之后给诺亚也带一些饭菜过去吧）",
  "0101Bad06_Ema016": "话说回来，这个肉……真的好好吃！",
  "0101Bad06_Narrative016": "晚餐后，<br>\n艾玛去给诺亚送饭了。",
  "0101Bad06_Ema017": "诺亚，我给你带今天的晚餐了……哎呀？",
  "0101Bad06_Narrative017": "涂满喷漆画的房内，<br>\n不见诺亚的影子。",
  "0101Bad06_Narrative018": "只见她用过的喷罐<br>\n孤零零地躺在地上。",
  "0101Bad06_Ema018": "（真奇怪……她跑哪里去了？）",
  "0101Bad06_Narrative019": "晚餐后是一段较长的放风时间，<br>\n或许她是跑到别的地方打发时间了。",
  "0101Bad06_Ema019": "（如果是这样的话，那她晚点就回来了吧。<br>\n　希望她能喜欢我给她带的饭）",
  "0101Bad06_Narrative020": "可是，不管过了多久，<br>\n城崎诺亚都没有再回来过了。",
  "0101Bad06_Narrative021": "虽然四处找过她，但都没找着。<br>\n时间就这样一天天地流逝。",
  "0101Bad06_Narrative022": "之后，监牢内<br>\n定期会有【美味大餐】供应，但——",
  "0101Bad06_Narrative023": "每次出餐，都会有一位少女不知所踪。"
}
}
