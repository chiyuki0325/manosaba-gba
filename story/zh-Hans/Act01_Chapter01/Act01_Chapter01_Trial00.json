    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "……啊，那个，艾玛小姐。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "啊……梅露露，<br>\n你喊我有什么事？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Ema003"]}},
