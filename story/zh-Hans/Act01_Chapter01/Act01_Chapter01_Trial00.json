    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "（接下来讨论要真正开始了……<br>\n　我得认真听大家讲的话……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Ema001"]}},
