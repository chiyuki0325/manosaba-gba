    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR8_1,ArmL8,Eyes1_Normal_Open2,Mouth1_Normal_Open2"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我想，接下来大家要开始<br>\n【讨论】了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR8_1,ArmL8,Eyes1_Normal_Open2,Mouth1_Normal_Open2"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "在大家的讲话内容之中……<br>\n应该会出现一些<br>\n你【在意的地方】。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR1_1,Eyes1_Normal_Open3,Mouth1_Smile_Closed1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "如果出现这样的地方……<br>\n请你思考一下<br>\n可不可以【指出】这些地方。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR1_1,Eyes1_Normal_Open3,Mouth1_Smile_Closed1"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "如果是错误的见解，<br>\n你应该可以反驳它们。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru005"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR5_1,ArmL2,Eyes1_Pensive_Open2,Mouth1_Normal_Open1"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "大家可能会有<br>\n认知或者理解错误的地方……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru006"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR5_1,ArmL2,Eyes1_Pensive_Open2,Mouth1_Normal_Open1"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "或许连我也会<br>\n说出一些不太对劲的发言……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru007"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal2,ArmR9_2,ArmL9,Eyes2_Smile_Closed1,Mouth2_Smile_Closed1"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "但我相信，艾玛小姐你<br>\n一定可以将大家的讨论<br>\n引导至正确的方向……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru008"]}},
