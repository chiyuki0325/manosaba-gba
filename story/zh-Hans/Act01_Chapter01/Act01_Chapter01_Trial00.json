    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "接下来，我们要从什么话题开始讨论呢？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Leia001"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "那当然是，能明确指出凶手的证据了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Sherry001"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "有那玩意也用不着我们想这么辛苦了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "哼哼哼，如果我说存在这样的证据呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "……比如尸体上写了凶手的名字？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "要是有这种证据，大家早就发现了！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Surprised1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "别急嘛。<br>\n先听听小莉她<br>\n是怎么讲的，好吗？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Miria001"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "反正我也不知道<br>\n该从哪里开始讨论……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Miria002"]}},
