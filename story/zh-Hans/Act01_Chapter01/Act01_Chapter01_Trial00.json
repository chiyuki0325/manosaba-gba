    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "……虽然，这只是我的感觉。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial00_Meruru009"]}},
