{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv02",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-0-2", "line": 4, "indent": 0},
    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "——不对！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema001"]}},
    {"op": "PlaySfxModified", "line": 12, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"Id": "Stills", "Rotation": [0.0, 0.0, -10.0], "Scale": {"expression": "{g_backgroundDefaultScale * 3}"}, "Lazy": 0, "ScenePosition": [80.0, -35.0], "AppearanceAndTransition": "490_1", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 14, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "60", "ScenePositionY": "-20", "EasingTypeName": "EaseOutBack", "Duration": "0.4"}},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "樱羽艾玛大喊着，爬起身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "大概是因为做了噩梦，她的呼吸相当紊乱，<br>\n而且满身都是汗水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "原来是做梦。她才刚安下心来——<br>\n眼前的光景就逐渐清晰了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative003"]}},
    {"op": "PlayBgm", "line": 24, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "咦，怎么回事，这里是……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema002"]}},
    {"op": "ModifyBackgroundExtended", "line": 28, "indent": 0, "params": {"Id": "Stills", "Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "490_1"}},
    {"op": "ResetText", "line": 29, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 30, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 31, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "醒来的艾玛发现，这里不是她自己的房间。<br>\n这是张做工粗糙的双层床，她睡在了这里的下铺。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative004"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "床紧贴着老旧的石墙，<br>\n而石墙似乎透着一股寒气，总令人不禁为之一颤。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "室内光线昏暗，空气也并不畅通。<br>\n并且——有一道铁栅栏限制了自由。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative006"]}},
    {"op": "EmoteShake", "line": 39, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "牢、牢房……！？为什么！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema003"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "艾玛陷入了恐慌，<br>\n拼命回想着睡前的记忆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "（昨天是想到明天我就要上高中了……<br>\n　很开心地睡着了才对）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema004"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "昨天是春假的最后一天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative008"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "艾玛早早地洗了澡，换了睡衣，<br>\n早早地钻进了被窝里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "（记得睡觉前……我还看着挂在墙上的<br>\n　全新的高中制服）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema005"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "望着那件明天就要穿上的制服，<br>\n艾玛露出了十分幸福的笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "（还下了决心，一切要重头来过……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema006"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "然后在温暖的被窝包裹下，闭上了双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "可是现在，她正被关在牢房里。<br>\n身上还穿着自己从没见过的衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "（这是噩梦的后续……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema007"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "但，四周的一切却如此真实。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "她大致观察了下室内。四周被结实的石墙包围，<br>\n只有铁栅栏一面联通着过道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "墙上安装有电视屏幕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative015"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "在透着中世纪气息的古牢里面，<br>\n这块现代随处可见的显示屏幕实在是格格不入。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative016"]}},
    {"op": "ModifyBackgroundExtended", "line": 75, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "我说，这里究竟是什么地方！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema008"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "艾玛抓着铁栅栏，喊出声来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative017"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "紧接着，远远地从其他地方传来了<br>\n其他少女们的叫喊声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative018"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "竟把本小姐关在这种地方！<br>\n究竟是什么意思啊！？", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Unknown001"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "监禁少女可是犯罪欸！虽然不知是谁，<br>\n可干出来这种事，这辈子就到头了欸！？", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Unknown002"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "喂，开什么玩笑，我要杀了你！放我出去！！", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Unknown003"]}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "（……太好了，被关进来的<br>\n　不止我一个人）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema009"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "现场忽然吵闹起来，<br>\n艾玛的脸上露出了安心。紧接着——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "——能不能给我安静一下？", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Unknown004"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "从艾玛身后冷不防传来一道清冽的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative020"]}},
    {"op": "PlaySfxModified", "line": 108, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "艾玛顺着声音望去，<br>\n发现双层床的上铺有个刚起身的人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "大吵大闹是不对的。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Unknown005"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "——！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema010"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "艾玛十分吃惊，瞬间忘记了呼吸。<br>\n因为，她认识这位说话的少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative022"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "（真的假的……<br>\n　是二阶堂希罗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema011"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "二阶堂希罗——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative023"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "是在艾玛的初中时代，令她深陷黑暗的同窗，<br>\n也是广受众人仰慕，常在人群中心可爱地微笑着的少女……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "和她对上眼的希罗，也大大的瞪圆了眼睛。<br>\n艾玛还是第一次见有人把眼睛瞪得那么大。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative025"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "为什么你会在这里？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Hiro001"]}},
    {"op": "PlaySfxModified", "line": 134, "indent": 0, "params": {"SfxPath": "Sfx_178", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "希罗轻快的爬下了床，向艾玛问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative026"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "往日同窗竟出现在眼前，<br>\n惊慌失措的艾玛哑口无言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative027"]}},
    {"op": "HideAllCharacters", "line": 140, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Fearful1,ArmR3"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema012"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "这是哪里？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Hiro002"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "希罗四下张望着，<br>\n紧张地尖声问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative028"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "我、我说，希罗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema013"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "艾玛鼓起勇气，<br>\n尝试向往日旧识搭话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative029"]}},
    {"op": "HideAllCharacters", "line": 154, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "这时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative030"]}},
    {"op": "PlaySfxModified", "line": 158, "indent": 0, "params": {"SfxPath": "Sfx_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "声音从墙壁上的显示屏幕传来。<br>\n艾玛和希罗吓了一跳，然后望向屏幕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative031"]}},
    {"op": "ResetText", "line": 162, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 163, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 164, "indent": 0, "params": {"Scale": [1.2999999523162842], "Lazy": 0, "AppearanceAndTransition": "25_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Scale": [1.399999976158142], "Lazy": 0, "IdAndAppearance": "Warden.1", "SubId": "Middle"}},
    {"op": "Wait", "line": 166, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "（欸，怎么回事！？猫、猫头鹰怪物……！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema014"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "啊……喂喂……看得见画面吗……？<br>\n毕竟机器有好些年头了，故障特别多……唉呀呀。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Warden001"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "大家好，我是典狱长。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Warden002"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "我想给大家作详细说明，<br>\n请各位到会客厅来集合。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Warden003"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "我会给大家打开牢房的锁，<br>\n之后请大家跟着带路的看守。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Warden004"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "想反抗也没问题……<br>\n只不过小命不保罢了……嗯……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Warden005"]}},
    {"op": "PlaySfxModified", "line": 185, "indent": 0, "params": {"SfxPath": "Sfx_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 186, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 187, "indent": 0, "params": {"Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 188, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlaySfxModified", "line": 190, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyTextPrinter", "line": 191, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "显示屏幕再次回归一片漆黑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative032"]}},
    {"op": "ResetText", "line": 195, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 196, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Warden-Middle"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "ModifyBackgroundExtended", "line": 199, "indent": 0, "params": {"Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 200, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "典狱长……？看守……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema015"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "艾玛似乎思考不太跟得上状况的变化，呆站在原地一动不动——<br>\n而她身边的希罗也一样。紧接着——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative033"]}},
    {"op": "HideAllCharacters", "line": 206, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 208, "indent": 0, "params": {"SfxPath": "Sfx_5", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "从铁栅栏的另一侧——过道处，<br>\n传来了某样沉重物体的移动声，且愈来愈接近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative034"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "那声音透着一股令人汗毛直竖的感觉，<br>\n令艾玛她们本能地察觉到了危险。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative035"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "艾玛和希罗绷紧了身子，<br>\n——然后缓慢地将视线挪动到过道上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative036"]}},
    {"op": "ResetText", "line": 216, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 217, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale * 2}"}, "Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [100.0, 40.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "Wait", "line": 218, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 220, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 221, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale * 2}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [100.0, 40.0], "AppearanceAndTransition": "1_2"}},
    {"op": "AnimateActorExtended", "line": 222, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.8"}},
    {"op": "AnimateActorExtended", "line": 223, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.8"}},
    {"op": "HideActors", "line": 224, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Duration": 0.5, "Lazy": 0}},
    {"op": "Wait", "line": 225, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "噫……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema016"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "差点惊声大喊的艾玛，用双手捂住了自己的嘴。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative037"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "面前出现了披着破烂黑衣的不明物体。<br>\n那东西大概有两三米高。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative038"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "虽然戴着面具，看不见面孔，<br>\n但从外形看，明显不是人类。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative039"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "希、希罗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema017"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "艾玛在恐惧的驱使下，不禁抓紧了希罗的手臂。<br>\n就连刚才还很冷静的希罗也望着过道上的异形，呆站着一动不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative040"]}},
    {"op": "ModifyBackgroundExtended", "line": 247, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "PlaySfxModified", "line": 249, "indent": 0, "params": {"SfxPath": "Sfx_5", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 251, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 252, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "呀啊啊啊！怪物别碰我！好恶心！<br>\n好了，好了啦，我走就是！！", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Unknown006"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "艾玛她们听见，其他牢房里<br>\n有人被怪物强行带走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative041"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "这让她们两个感到越来越害怕了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative042"]}},
    {"op": "ModifyBackgroundExtended", "line": 262, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "1_1", "SubId": "Default"}},
    {"op": "HideActors", "line": 263, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 265, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [45.0], "IdAndAppearance": "Hiro.Head1,Pale1-Off,Sweat1-Off,Cheeks1-Normal,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Ema.Fearful1,ArmR1"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "所谓的说明，会解释清楚情况吗。<br>\n那我得快点过去……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Hiro003"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "希罗自言自语着，然后望向身旁的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative043"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "这时她终于发现，<br>\n艾玛紧紧抓住了她的手臂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative044"]}},
    {"op": "PlaySfxModified", "line": 274, "indent": 0, "params": {"SfxPath": "Sfx_18", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 275, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Hiro.Angry2"}},
    {"op": "ModifyCharacterExtended", "line": 276, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Fearful1,ArmR3"}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "——唰。<br>\n她用力地甩开了艾玛的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative045"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Ema018"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "不要随便碰我。<br>\n你可别忘了，我讨厌你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Hiro004"]}},
    {"op": "HideActors", "line": 284, "indent": 0, "params": {"ActorIds": ["Hiro"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "希罗的眼神中<br>\n透着一股深深的厌弃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv02_Narrative046"]}},
    {"op": "ModifyCharacterExtended", "line": 292, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "Gosub", "line": 294, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 296, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv03", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv02_Ema001": "——不对！",
  "0101Adv02_Narrative001": "樱羽艾玛大喊着，爬起身来。",
  "0101Adv02_Narrative002": "大概是因为做了噩梦，她的呼吸相当紊乱，<br>\n而且满身都是汗水。",
  "0101Adv02_Narrative003": "原来是做梦。她才刚安下心来——<br>\n眼前的光景就逐渐清晰了起来。",
  "0101Adv02_Ema002": "咦，怎么回事，这里是……？",
  "0101Adv02_Narrative004": "醒来的艾玛发现，这里不是她自己的房间。<br>\n这是张做工粗糙的双层床，她睡在了这里的下铺。",
  "0101Adv02_Narrative005": "床紧贴着老旧的石墙，<br>\n而石墙似乎透着一股寒气，总令人不禁为之一颤。",
  "0101Adv02_Narrative006": "室内光线昏暗，空气也并不畅通。<br>\n并且——有一道铁栅栏限制了自由。",
  "0101Adv02_Ema003": "牢、牢房……！？为什么！？",
  "0101Adv02_Narrative007": "艾玛陷入了恐慌，<br>\n拼命回想着睡前的记忆。",
  "0101Adv02_Ema004": "（昨天是想到明天我就要上高中了……<br>\n　很开心地睡着了才对）",
  "0101Adv02_Narrative008": "昨天是春假的最后一天。",
  "0101Adv02_Narrative009": "艾玛早早地洗了澡，换了睡衣，<br>\n早早地钻进了被窝里。",
  "0101Adv02_Ema005": "（记得睡觉前……我还看着挂在墙上的<br>\n　全新的高中制服）",
  "0101Adv02_Narrative010": "望着那件明天就要穿上的制服，<br>\n艾玛露出了十分幸福的笑容。",
  "0101Adv02_Ema006": "（还下了决心，一切要重头来过……）",
  "0101Adv02_Narrative011": "然后在温暖的被窝包裹下，闭上了双眼。",
  "0101Adv02_Narrative012": "可是现在，她正被关在牢房里。<br>\n身上还穿着自己从没见过的衣服。",
  "0101Adv02_Ema007": "（这是噩梦的后续……？）",
  "0101Adv02_Narrative013": "但，四周的一切却如此真实。",
  "0101Adv02_Narrative014": "她大致观察了下室内。四周被结实的石墙包围，<br>\n只有铁栅栏一面联通着过道。",
  "0101Adv02_Narrative015": "墙上安装有电视屏幕。",
  "0101Adv02_Narrative016": "在透着中世纪气息的古牢里面，<br>\n这块现代随处可见的显示屏幕实在是格格不入。",
  "0101Adv02_Ema008": "我说，这里究竟是什么地方！？",
  "0101Adv02_Narrative017": "艾玛抓着铁栅栏，喊出声来。",
  "0101Adv02_Narrative018": "紧接着，远远地从其他地方传来了<br>\n其他少女们的叫喊声。",
  "0101Adv02_Unknown001": "竟把本小姐关在这种地方！<br>\n究竟是什么意思啊！？",
  "0101Adv02_Unknown002": "监禁少女可是犯罪欸！虽然不知是谁，<br>\n可干出来这种事，这辈子就到头了欸！？",
  "0101Adv02_Unknown003": "喂，开什么玩笑，我要杀了你！放我出去！！",
  "0101Adv02_Ema009": "（……太好了，被关进来的<br>\n　不止我一个人）",
  "0101Adv02_Narrative019": "现场忽然吵闹起来，<br>\n艾玛的脸上露出了安心。紧接着——",
  "0101Adv02_Unknown004": "——能不能给我安静一下？",
  "0101Adv02_Narrative020": "从艾玛身后冷不防传来一道清冽的声音。",
  "0101Adv02_Narrative021": "艾玛顺着声音望去，<br>\n发现双层床的上铺有个刚起身的人。",
  "0101Adv02_Unknown005": "大吵大闹是不对的。",
  "0101Adv02_Ema010": "——！！",
  "0101Adv02_Narrative022": "艾玛十分吃惊，瞬间忘记了呼吸。<br>\n因为，她认识这位说话的少女。",
  "0101Adv02_Ema011": "（真的假的……<br>\n　是二阶堂希罗……？）",
  "0101Adv02_Narrative023": "二阶堂希罗——",
  "0101Adv02_Narrative024": "是在艾玛的初中时代，令她深陷黑暗的同窗，<br>\n也是广受众人仰慕，常在人群中心可爱地微笑着的少女……",
  "0101Adv02_Narrative025": "和她对上眼的希罗，也大大的瞪圆了眼睛。<br>\n艾玛还是第一次见有人把眼睛瞪得那么大。",
  "0101Adv02_Hiro001": "为什么你会在这里？",
  "0101Adv02_Narrative026": "希罗轻快的爬下了床，向艾玛问道。",
  "0101Adv02_Narrative027": "往日同窗竟出现在眼前，<br>\n惊慌失措的艾玛哑口无言。",
  "0101Adv02_Ema012": "啊……",
  "0101Adv02_Hiro002": "这是哪里？",
  "0101Adv02_Narrative028": "希罗四下张望着，<br>\n紧张地尖声问道。",
  "0101Adv02_Ema013": "我、我说，希罗……",
  "0101Adv02_Narrative029": "艾玛鼓起勇气，<br>\n尝试向往日旧识搭话。",
  "0101Adv02_Narrative030": "这时——",
  "0101Adv02_Narrative031": "声音从墙壁上的显示屏幕传来。<br>\n艾玛和希罗吓了一跳，然后望向屏幕。",
  "0101Adv02_Ema014": "（欸，怎么回事！？猫、猫头鹰怪物……！？）",
  "0101Adv02_Warden001": "啊……喂喂……看得见画面吗……？<br>\n毕竟机器有好些年头了，故障特别多……唉呀呀。",
  "0101Adv02_Warden002": "大家好，我是典狱长。",
  "0101Adv02_Warden003": "我想给大家作详细说明，<br>\n请各位到会客厅来集合。",
  "0101Adv02_Warden004": "我会给大家打开牢房的锁，<br>\n之后请大家跟着带路的看守。",
  "0101Adv02_Warden005": "想反抗也没问题……<br>\n只不过小命不保罢了……嗯……",
  "0101Adv02_Narrative032": "显示屏幕再次回归一片漆黑。",
  "0101Adv02_Ema015": "典狱长……？看守……？",
  "0101Adv02_Narrative033": "艾玛似乎思考不太跟得上状况的变化，呆站在原地一动不动——<br>\n而她身边的希罗也一样。紧接着——",
  "0101Adv02_Narrative034": "从铁栅栏的另一侧——过道处，<br>\n传来了某样沉重物体的移动声，且愈来愈接近。",
  "0101Adv02_Narrative035": "那声音透着一股令人汗毛直竖的感觉，<br>\n令艾玛她们本能地察觉到了危险。",
  "0101Adv02_Narrative036": "艾玛和希罗绷紧了身子，<br>\n——然后缓慢地将视线挪动到过道上。",
  "0101Adv02_Ema016": "噫……",
  "0101Adv02_Narrative037": "差点惊声大喊的艾玛，用双手捂住了自己的嘴。",
  "0101Adv02_Narrative038": "面前出现了披着破烂黑衣的不明物体。<br>\n那东西大概有两三米高。",
  "0101Adv02_Narrative039": "虽然戴着面具，看不见面孔，<br>\n但从外形看，明显不是人类。",
  "0101Adv02_Ema017": "希、希罗……",
  "0101Adv02_Narrative040": "艾玛在恐惧的驱使下，不禁抓紧了希罗的手臂。<br>\n就连刚才还很冷静的希罗也望着过道上的异形，呆站着一动不动。",
  "0101Adv02_Unknown006": "呀啊啊啊！怪物别碰我！好恶心！<br>\n好了，好了啦，我走就是！！",
  "0101Adv02_Narrative041": "艾玛她们听见，其他牢房里<br>\n有人被怪物强行带走了。",
  "0101Adv02_Narrative042": "这让她们两个感到越来越害怕了。",
  "0101Adv02_Hiro003": "所谓的说明，会解释清楚情况吗。<br>\n那我得快点过去……",
  "0101Adv02_Narrative043": "希罗自言自语着，然后望向身旁的艾玛。",
  "0101Adv02_Narrative044": "这时她终于发现，<br>\n艾玛紧紧抓住了她的手臂。",
  "0101Adv02_Narrative045": "——唰。<br>\n她用力地甩开了艾玛的手。",
  "0101Adv02_Ema018": "……！",
  "0101Adv02_Hiro004": "不要随便碰我。<br>\n你可别忘了，我讨厌你。",
  "0101Adv02_Narrative046": "希罗的眼神中<br>\n透着一股深深的厌弃。"
}
}
