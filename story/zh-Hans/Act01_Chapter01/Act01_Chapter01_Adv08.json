  "path": "Act01_Chapter01/Act01_Chapter01_Adv08",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-4", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyBackgroundExtended", "line": 16, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛跟着地图的指引，<br>\n来到了食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "而食堂内的少女们<br>\n都已经开始用餐了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "呃……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "艾玛四周观察着。<br>\n刚刚的事冲击太大，她现在脸色不是很好。<br>\n这时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR5"}},
    {"op": "EmoteJumpDouble", "line": 32, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "喂～艾玛～！<br>\n过来这边！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "雪莉兴冲冲的挥着小手，<br>\n喊艾玛过去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 38, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "（啊，原来是这里是自由就座啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema002"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "艾玛走到雪莉她们的餐桌前，<br>\n拉开椅子坐了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 45, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "刚刚表明了团结意向的雪莉、汉娜和梅露露也都在。<br>\n而餐盘上已经盛好了食物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR10"}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL5"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "这边用餐是自助餐形式，<br>\n所以你的份我也帮你取好了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "谢、谢谢你。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema003"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "刚道完谢，她的嘴角却有些抽动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative007"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "餐盘盛放的食物看起来黏糊糊的，颜色也十分诡异。<br>\n根本看不出这是哪样食物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative008"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "（……她们没有故意霸凌我吧？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema004"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "雪莉、汉娜和梅露露的餐盘上的，<br>\n还有取餐处盛放的，<br>\n都是这种令人恶心的饭菜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative009"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "（那就是说，<br>\n　这座监牢的饭菜都是这么糟糕……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "不过她看到，饭菜中还是有完整的一颗苹果。<br>\n艾玛松了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1,ArmR14"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "虽然看起来不太妙，不过味道还是不错的哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "你的舌头是不是坏掉了？<br>\n这个超级难吃的……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 81, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR4"}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "……这些饭菜都是那些看守做的吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema006"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "想像了一下，<br>\n总感觉看守也是蛮可爱的耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 89, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "汉娜无言望着雪莉。<br>\n她很怀疑雪莉，不止是舌头，连脑子也是坏掉的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative011"]}},
    {"op": "HideAllCharacters", "line": 94, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "说到看守……<br>\n我刚刚碰见有看守<br>\n把亚里沙抓走了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema007"]}},
    {"op": "HideAllCharacters", "line": 99, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "我、我也看到了……不知道发生什么事了……<br>\n呜呜，好担心她……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 104, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "刚刚她还气势汹汹地说“我要逃出去”呢，<br>\n应该是真的在想办法逃跑吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 109, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "如果在禁止时间内被发现人在外面，<br>\n应该就会被带到<br>\n那个所谓的惩罚室吧……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "惩罚室……究竟会有什么惩罚呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema008"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "不知是不是都想到了可怕的事情，<br>\n所有人都低着头，一言不发。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative012"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "除了诺亚和亚里沙，所有人都在食堂里了。<br>\n在场的人看来都选择老实遵守规定行动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative013"]}},
    {"op": "ResetText", "line": 125, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 126, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 127, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 128, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [28.0, 36.0], "AppearanceAndTransition": "6_1", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 129, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 20.0], "IdAndAppearance": "Leia.Normal1", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 131, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Leia-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 132, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "25", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 133, "indent": 0, "params": {"ActorIds": ["Leia-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 134, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "离艾玛一桌稍远处，<br>\n蕾雅一众也在用餐。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative014"]}},
    {"op": "ResetText", "line": 138, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Duration": 0.4000000059604645, "Lazy": 0, "IdAndAppearance": "Leia.Smile1", "SubId": "Front"}},
    {"op": "Wait", "line": 140, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "这时艾玛和蕾雅的眼神对上了。<br>\n蕾雅抛出了一个微笑，<br>\n害得艾玛脸上热乎乎的，慌忙移开了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative015"]}},
    {"op": "HideActors", "line": 144, "indent": 0, "params": {"ActorIds": ["Leia-Front", "MainBackground-Front"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 145, "indent": 0, "params": {"ActorId": "MainBackground-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "DestroySpawnedExtended", "line": 146, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "Wait", "line": 147, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "汉娜看到了两人的互动后，<br>\n便把脸凑到艾玛旁边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "那个女人……<br>\n刚刚肯定在用魔法。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna003"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "魔法……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema009"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "艾玛的脸一下子僵住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative017"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "（刚刚梅露露还有诺亚<br>\n　都做出了超乎想像的事情。<br>\n　这些都是很普通的事情吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema010"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "竟然使出诱惑女孩子的魔法……<br>\n而且还仗着自己是艺人，搞什么小团体，真叫人生气！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna004"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "看样子，汉娜十分看不惯蕾雅。<br>\n她一边生气，一边一口口把神秘饭菜往嘴里送。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative018"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "虽然她操着大小姐的口吻，<br>\n可用餐的方式却有些粗鲁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR17"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "说到魔法，梅露露的魔法<br>\n真厉害呀！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry006"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "哎呀，现实中竟然真的有魔法，<br>\n真是吓了我一跳！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 177, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "哇、哇哇哇……说、说太过了啦……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Meruru002"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "在艾玛旁边安安分分用餐的梅露露<br>\n突然被拉进了对话，她一下子就羞得不行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Flushed"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "也没做，很厉害的事情……<br>\n只是帮艾玛小姐，止了血而已。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Meruru003"]}},
    {"op": "ShowToastUI", "line": 188, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 189, "indent": 0, "params": {"Id": "Meruru", "Category": "Profile", "Version": 2}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "梅露露满脸通红低下了头。<br>\n艾玛感觉自己想要说些什么，不由自主地站起身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 193, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "大家都在理所当然地聊什么魔法……<br>\n我想问，被抓进来的大家是不是都会魔法？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema011"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "可是我根本就不会使用魔法……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema012"]}},
    {"op": "HideAllCharacters", "line": 200, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR12"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "我和艾玛一样哦。<br>\n我也是刚知道有魔法这回事，也不会用。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 205, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 206, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "……哈啊，看来你们两个<br>\n是真的什么都不知道呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna005"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "汉娜放下汤匙，夸张地叹了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative022"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "拥有魔女因子的人，可以使用神奇的力量哦。<br>\n那就是【魔法】。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna006"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "只是你们没有发现，<br>\n自己其实也会用某些神奇的能力而已。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna007"]}},
    {"op": "HideAllCharacters", "line": 216, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "欸～？我可没有什么<br>\n神奇能力耶？不过特技倒是有一样。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry009"]}},
    {"op": "HideAllCharacters", "line": 221, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "雪莉拿起眼前的苹果。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative023"]}},
    {"op": "SpawnBlur", "line": 232, "indent": 0, "params": {"ActorId": "MainBackground", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [70.0, 30.0], "IdAndAppearance": "Sherry.Normal1,ArmR8", "SubId": "Middle"}},
    {"op": "PlaySfxModified", "line": 235, "indent": 0, "params": {"SfxPath": "Sfx_16", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 236, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "然后便轻易地单手把它捏碎了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative024"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "她看起来不像有使出手指的力量，<br>\n可是苹果却碎得一干二净。<br>\n溅出的果汁把周围都弄脏了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative025"]}},
    {"op": "SpawnBlur", "line": 242, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 243, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Fearful1,ArmR4"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "啊……啊……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna008"]}},
    {"op": "HideAllCharacters", "line": 248, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8"}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "也就是力气稍微有点大而已啦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry010"]}},
    {"op": "HideAllCharacters", "line": 253, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "汉娜和艾玛都哑口无言了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative026"]}},
    {"op": "PlayBgm", "line": 261, "indent": 0, "params": {"BgmPath": "Bgm_18_1_Loop", "IntroBgmPath": "Bgm_18_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 264, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "这算哪门子的“稍微”啦！？你是猩猩女吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna009"]}},
    {"op": "ModifyCharacterExtended", "line": 268, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Cry1,ArmR19,ArmL14"}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "好过分哦～小小一颗苹果，人人都能捏碎的对吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 272, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "好啦那就是你的魔法啦！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna010"]}},
    {"op": "ModifyCharacterExtended", "line": 276, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Flushed1,ArmR7,ArmL1"}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "雪莉瞪大眼睛愣了一下，<br>\n然后摆出羞涩的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative027"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "是吗……原来我会用魔法啊。<br>\n哎呀，好羞人耶～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry012"]}},
    {"op": "ShowToastUI", "line": 282, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 283, "indent": 0, "params": {"Id": "Sherry", "Category": "Profile", "Version": 2}},
    {"op": "ModifyCharacterExtended", "line": 284, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "我才不信你真的从来都没发现呢……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna011"]}},
    {"op": "ModifyCharacterExtended", "line": 288, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "那，汉娜你会什么魔法呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry013"]}},
    {"op": "HideAllCharacters", "line": 292, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 293, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "听到雪莉提问，<br>\n汉娜一脸得意地站起身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative028"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "真拿你没办法。这么想看的话<br>\n本小姐就表演给你看咯？看好咯？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna012"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "然后汉娜走到显眼处，<br>\n忽然张开了双手——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative029"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "这就是我的魔法哇哇哇～", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna013"]}},
    {"op": "ModifyCharacterExtended", "line": 303, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "AnimateActorExtended", "line": 304, "indent": 0, "params": {"ActorIds": ["Hanna"], "Loop": 0, "ScenePositionY": "70|65|70", "Duration": "1|0.5|3"}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "然后飘起来了，一点点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative030"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "……大概有10厘米左右。<br>\n她的脚已经离开地面，像气球一样飘着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative031"]}},
    {"op": "HideAllCharacters", "line": 310, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 311, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Surprised1,ArmR8,ArmL8"}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "好厉害好厉害好厉害～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry014"]}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "雪莉满脸写着兴奋，<br>\n而汉娜的呼吸却渐渐变得紊乱，脸也变得愈来愈红。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative032"]}},
    {"op": "HideAllCharacters", "line": 317, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 318, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "AnimateActorExtended", "line": 319, "indent": 0, "params": {"ActorIds": ["Hanna"], "Loop": 0, "ScenePositionX": "30|50|70", "Duration": "1|0.5|3"}},
    {"op": "PrintTextModified", "line": 321, "indent": 0, "params": {"Text": "我还可以一边飞一边移动！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna014"]}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "然后移动了，一点点。<br>\n只有雪莉送去了掌声和欢呼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative033"]}},
    {"op": "HideAllCharacters", "line": 325, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 326, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Flushed1"}},
    {"op": "AnimateActorExtended", "line": 327, "indent": 0, "params": {"ActorIds": ["Hanna"], "Loop": 0, "ScenePositionX": "70", "ScenePositionY": "50"}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "接着汉娜就着地了。<br>\n她现在上气不接下气，看起来很疲累的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative034"]}},
    {"op": "StopBgm", "line": 333, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "……就像这样，我们是<br>\n会使用魔法的。<br>\n我想这算是实习魔女吧。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna015"]}},
    {"op": "ShowToastUI", "line": 337, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 338, "indent": 0, "params": {"Id": "Hanna", "Category": "Profile", "Version": 2}},
    {"op": "ModifyCharacterExtended", "line": 339, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "汉娜喘着大气一边说道，<br>\n然后坐回自己的位置。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative035"]}},
    {"op": "PlayBgm", "line": 343, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "我发现自己会使用神奇能力之后，<br>\n就开始了调查，知道了很多事。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna016"]}},
    {"op": "PrintTextModified", "line": 347, "indent": 0, "params": {"Text": "魔女因子还有监牢的事，<br>\n我有听都市传说讲过哦。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna017"]}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "说拥有魔法的人可能会变成魔女，<br>\n所以要在15岁的时候送到监牢里。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna018"]}},
    {"op": "HideAllCharacters", "line": 351, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 352, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL11"}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "听你这么一讲，我好像也听<br>\n我的朋友讲过类似的传闻耶？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Sherry015"]}},
    {"op": "ShowToastUI", "line": 356, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 357, "indent": 0, "params": {"Id": "1", "Category": "Note", "Version": 2}},
    {"op": "HideAllCharacters", "line": 359, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "我完全没听说过有这么一回事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema013"]}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "（因为我没有朋友……<br>\n　可是魔法实在是太难以置信了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema014"]}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "我想，他们是不是搞错了<br>\n才把我送到这里来了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Ema015"]}},
    {"op": "ShowToastUI", "line": 368, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 369, "indent": 0, "params": {"Id": "Ema", "Category": "Profile", "Version": 2}},
    {"op": "HideAllCharacters", "line": 370, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 371, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 373, "indent": 0, "params": {"Text": "嗯，有可能。<br>\n毕竟也不知道所谓的检查是什么时候做的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna019"]}},
    {"op": "ModifyCharacterExtended", "line": 375, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 377, "indent": 0, "params": {"Text": "汉娜有些不甘心地咬着指甲。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative036"]}},
    {"op": "PrintTextModified", "line": 379, "indent": 0, "params": {"Text": "我本来是不想被关进监牢，<br>\n才一直以来都隐瞒了这份能力……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna020"]}},
    {"op": "PrintTextModified", "line": 381, "indent": 0, "params": {"Text": "关进这种地方，接下来究竟<br>\n会变成什么样……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Hanna021"]}},
    {"op": "PrintTextModified", "line": 383, "indent": 0, "params": {"Text": "汉娜的自言自语，<br>\n让现场的空气变得十分凝重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv08_Narrative037"]}},
    {"op": "Gosub", "line": 389, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 391, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv09", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv08_Narrative001": "艾玛跟着地图的指引，<br>\n来到了食堂。",
  "0101Adv08_Narrative002": "而食堂内的少女们<br>\n都已经开始用餐了。",
  "0101Adv08_Ema001": "呃……",
  "0101Adv08_Narrative003": "艾玛四周观察着。<br>\n刚刚的事冲击太大，她现在脸色不是很好。<br>\n这时——",
  "0101Adv08_Sherry001": "喂～艾玛～！<br>\n过来这边！",
  "0101Adv08_Narrative004": "雪莉兴冲冲的挥着小手，<br>\n喊艾玛过去。",
  "0101Adv08_Ema002": "（啊，原来是这里是自由就座啊）",
  "0101Adv08_Narrative005": "艾玛走到雪莉她们的餐桌前，<br>\n拉开椅子坐了下来。",
  "0101Adv08_Narrative006": "刚刚表明了团结意向的雪莉、汉娜和梅露露也都在。<br>\n而餐盘上已经盛好了食物。",
  "0101Adv08_Sherry002": "这边用餐是自助餐形式，<br>\n所以你的份我也帮你取好了！",
  "0101Adv08_Ema003": "谢、谢谢你。",
  "0101Adv08_Narrative007": "刚道完谢，她的嘴角却有些抽动。",
  "0101Adv08_Narrative008": "餐盘盛放的食物看起来黏糊糊的，颜色也十分诡异。<br>\n根本看不出这是哪样食物。",
  "0101Adv08_Ema004": "（……她们没有故意霸凌我吧？）",
  "0101Adv08_Narrative009": "雪莉、汉娜和梅露露的餐盘上的，<br>\n还有取餐处盛放的，<br>\n都是这种令人恶心的饭菜。",
  "0101Adv08_Ema005": "（那就是说，<br>\n　这座监牢的饭菜都是这么糟糕……）",
  "0101Adv08_Narrative010": "不过她看到，饭菜中还是有完整的一颗苹果。<br>\n艾玛松了口气。",
  "0101Adv08_Sherry003": "虽然看起来不太妙，不过味道还是不错的哦！",
  "0101Adv08_Hanna001": "你的舌头是不是坏掉了？<br>\n这个超级难吃的……",
  "0101Adv08_Ema006": "……这些饭菜都是那些看守做的吧。",
  "0101Adv08_Sherry004": "想像了一下，<br>\n总感觉看守也是蛮可爱的耶。",
  "0101Adv08_Narrative011": "汉娜无言望着雪莉。<br>\n她很怀疑雪莉，不止是舌头，连脑子也是坏掉的。",
  "0101Adv08_Ema007": "说到看守……<br>\n我刚刚碰见有看守<br>\n把亚里沙抓走了……",
  "0101Adv08_Meruru001": "我、我也看到了……不知道发生什么事了……<br>\n呜呜，好担心她……",
  "0101Adv08_Sherry005": "刚刚她还气势汹汹地说“我要逃出去”呢，<br>\n应该是真的在想办法逃跑吧？",
  "0101Adv08_Hanna002": "如果在禁止时间内被发现人在外面，<br>\n应该就会被带到<br>\n那个所谓的惩罚室吧……",
  "0101Adv08_Ema008": "惩罚室……究竟会有什么惩罚呢。",
  "0101Adv08_Narrative012": "不知是不是都想到了可怕的事情，<br>\n所有人都低着头，一言不发。",
  "0101Adv08_Narrative013": "除了诺亚和亚里沙，所有人都在食堂里了。<br>\n在场的人看来都选择老实遵守规定行动。",
  "0101Adv08_Narrative014": "离艾玛一桌稍远处，<br>\n蕾雅一众也在用餐。",
  "0101Adv08_Narrative015": "这时艾玛和蕾雅的眼神对上了。<br>\n蕾雅抛出了一个微笑，<br>\n害得艾玛脸上热乎乎的，慌忙移开了视线。",
  "0101Adv08_Narrative016": "汉娜看到了两人的互动后，<br>\n便把脸凑到艾玛旁边。",
  "0101Adv08_Hanna003": "那个女人……<br>\n刚刚肯定在用魔法。",
  "0101Adv08_Ema009": "魔法……？",
  "0101Adv08_Narrative017": "艾玛的脸一下子僵住了。",
  "0101Adv08_Ema010": "（刚刚梅露露还有诺亚<br>\n　都做出了超乎想像的事情。<br>\n　这些都是很普通的事情吗……？）",
  "0101Adv08_Hanna004": "竟然使出诱惑女孩子的魔法……<br>\n而且还仗着自己是艺人，搞什么小团体，真叫人生气！",
  "0101Adv08_Narrative018": "看样子，汉娜十分看不惯蕾雅。<br>\n她一边生气，一边一口口把神秘饭菜往嘴里送。",
  "0101Adv08_Narrative019": "虽然她操着大小姐的口吻，<br>\n可用餐的方式却有些粗鲁。",
  "0101Adv08_Sherry006": "说到魔法，梅露露的魔法<br>\n真厉害呀！",
  "0101Adv08_Sherry007": "哎呀，现实中竟然真的有魔法，<br>\n真是吓了我一跳！",
  "0101Adv08_Meruru002": "哇、哇哇哇……说、说太过了啦……",
  "0101Adv08_Narrative020": "在艾玛旁边安安分分用餐的梅露露<br>\n突然被拉进了对话，她一下子就羞得不行。",
  "0101Adv08_Meruru003": "也没做，很厉害的事情……<br>\n只是帮艾玛小姐，止了血而已。",
  "Toast_001": "魔女图鉴 更新…",
  "0101Adv08_Narrative021": "梅露露满脸通红低下了头。<br>\n艾玛感觉自己想要说些什么，不由自主地站起身来。",
  "0101Adv08_Ema011": "大家都在理所当然地聊什么魔法……<br>\n我想问，被抓进来的大家是不是都会魔法？",
  "0101Adv08_Ema012": "可是我根本就不会使用魔法……",
  "0101Adv08_Sherry008": "我和艾玛一样哦。<br>\n我也是刚知道有魔法这回事，也不会用。",
  "0101Adv08_Hanna005": "……哈啊，看来你们两个<br>\n是真的什么都不知道呢。",
  "0101Adv08_Narrative022": "汉娜放下汤匙，夸张地叹了一口气。",
  "0101Adv08_Hanna006": "拥有魔女因子的人，可以使用神奇的力量哦。<br>\n那就是【魔法】。",
  "0101Adv08_Hanna007": "只是你们没有发现，<br>\n自己其实也会用某些神奇的能力而已。",
  "0101Adv08_Sherry009": "欸～？我可没有什么<br>\n神奇能力耶？不过特技倒是有一样。",
  "0101Adv08_Narrative023": "雪莉拿起眼前的苹果。",
  "0101Adv08_Narrative024": "然后便轻易地单手把它捏碎了。",
  "0101Adv08_Narrative025": "她看起来不像有使出手指的力量，<br>\n可是苹果却碎得一干二净。<br>\n溅出的果汁把周围都弄脏了。",
  "0101Adv08_Hanna008": "啊……啊……",
  "0101Adv08_Sherry010": "也就是力气稍微有点大而已啦。",
  "0101Adv08_Narrative026": "汉娜和艾玛都哑口无言了。",
  "0101Adv08_Hanna009": "这算哪门子的“稍微”啦！？你是猩猩女吗！？",
  "0101Adv08_Sherry011": "好过分哦～小小一颗苹果，人人都能捏碎的对吧？",
  "0101Adv08_Hanna010": "好啦那就是你的魔法啦！！",
  "0101Adv08_Narrative027": "雪莉瞪大眼睛愣了一下，<br>\n然后摆出羞涩的微笑。",
  "0101Adv08_Sherry012": "是吗……原来我会用魔法啊。<br>\n哎呀，好羞人耶～",
  "0101Adv08_Hanna011": "我才不信你真的从来都没发现呢……",
  "0101Adv08_Sherry013": "那，汉娜你会什么魔法呢？",
  "0101Adv08_Narrative028": "听到雪莉提问，<br>\n汉娜一脸得意地站起身来。",
  "0101Adv08_Hanna012": "真拿你没办法。这么想看的话<br>\n本小姐就表演给你看咯？看好咯？",
  "0101Adv08_Narrative029": "然后汉娜走到显眼处，<br>\n忽然张开了双手——",
  "0101Adv08_Hanna013": "这就是我的魔法哇哇哇～",
  "0101Adv08_Narrative030": "然后飘起来了，一点点。",
  "0101Adv08_Narrative031": "……大概有10厘米左右。<br>\n她的脚已经离开地面，像气球一样飘着。",
  "0101Adv08_Sherry014": "好厉害好厉害好厉害～！",
  "0101Adv08_Narrative032": "雪莉满脸写着兴奋，<br>\n而汉娜的呼吸却渐渐变得紊乱，脸也变得愈来愈红。",
  "0101Adv08_Hanna014": "我还可以一边飞一边移动！",
  "0101Adv08_Narrative033": "然后移动了，一点点。<br>\n只有雪莉送去了掌声和欢呼。",
  "0101Adv08_Narrative034": "接着汉娜就着地了。<br>\n她现在上气不接下气，看起来很疲累的样子。",
  "0101Adv08_Hanna015": "……就像这样，我们是<br>\n会使用魔法的。<br>\n我想这算是实习魔女吧。",
  "0101Adv08_Narrative035": "汉娜喘着大气一边说道，<br>\n然后坐回自己的位置。",
  "0101Adv08_Hanna016": "我发现自己会使用神奇能力之后，<br>\n就开始了调查，知道了很多事。",
  "0101Adv08_Hanna017": "魔女因子还有监牢的事，<br>\n我有听都市传说讲过哦。",
  "0101Adv08_Hanna018": "说拥有魔法的人可能会变成魔女，<br>\n所以要在15岁的时候送到监牢里。",
  "0101Adv08_Sherry015": "听你这么一讲，我好像也听<br>\n我的朋友讲过类似的传闻耶？",
  "0101Adv08_Ema013": "我完全没听说过有这么一回事……",
  "0101Adv08_Ema014": "（因为我没有朋友……<br>\n　可是魔法实在是太难以置信了……）",
  "0101Adv08_Ema015": "我想，他们是不是搞错了<br>\n才把我送到这里来了？",
  "0101Adv08_Hanna019": "嗯，有可能。<br>\n毕竟也不知道所谓的检查是什么时候做的。",
  "0101Adv08_Narrative036": "汉娜有些不甘心地咬着指甲。",
  "0101Adv08_Hanna020": "我本来是不想被关进监牢，<br>\n才一直以来都隐瞒了这份能力……",
  "0101Adv08_Hanna021": "关进这种地方，接下来究竟<br>\n会变成什么样……",
  "0101Adv08_Narrative037": "汉娜的自言自语，<br>\n让现场的空气变得十分凝重。"
}
}
