{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv13",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-9", "line": 4, "indent": 0},
    {"op": "PrintTextModified", "line": 10, "indent": 0, "params": {"Text": "监牢二楼可以进的房间只有两个。<br>\n一个是图书室，一个是娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative001"]}},
    {"op": "ResetText", "line": 12, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 15, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 16, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "艾玛和雪莉决定<br>\n去图书室看一看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "图书室内的书架整齐地排列着，<br>\n空气中飘着一股老旧的纸香味，呈现出静谧的气氛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "这里会有什么书呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "艾玛随手拿出一本书翻了起来，<br>\n可上面写的全是看不懂的字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "唔……看不懂……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema002"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "这不是我们国家的文字呢。<br>\n这座监牢究竟在哪个国家？<br>\n难不成……是异世界！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "你、你不要说这么令人绝望的话啦！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema003"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "雪莉也从书架上拿出一本书，<br>\n随意的翻动着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 46, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "艾玛，艾玛！<br>\n快，快来看这个！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry002"]}},
    {"op": "StopBgm", "line": 52, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "见雪莉朝她挥手，<br>\n艾玛的视线也往书上面移动。<br>\n只见打开的那一页上面写着——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative006"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "<color=#ff0000>救命</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "血红的字迹写着这么一句话。<br>\n艾玛倒吸一口凉气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative008"]}},
    {"op": "PlayBgm", "line": 63, "indent": 0, "params": {"BgmPath": "Bgm_27_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 2.0}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "这个难道是之前被抓的预备魔女<br>\n在上面写的！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry003"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "可能是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema004"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "令人兴奋耶～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "一点都不兴奋啦！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ResetText", "line": 78, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 79, "indent": 0, "params": {"SlotNumber": 3, "Wait": 0}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "其他书上会不会<br>\n也留下了这类信息呢。<br>\n你要不要再调查一下？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry005"]}},
    {"op": "StopBgm", "line": 83, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "对于雪莉的建议，艾玛——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative009"]}},
    {"op": "AddChoice", "line": 87, "indent": 0, "params": {"ChoiceSummary": "表示赞成", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv13_Choice001"]}},
    {"op": "GotoModified", "line": 88, "indent": 1, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Bad03", "ResetState": ["-"]}},
    {"op": "AddChoice", "line": 90, "indent": 0, "params": {"ChoiceSummary": "摇了摇头", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv13_Choice002"]}},
    {"op": "GotoModified", "line": 91, "indent": 1, "params": {"Path": ".Choice1-1-3"}},
    {"op": "StopForChoice", "line": 93, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice1-1-3", "line": 95, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 97, "indent": 0, "params": {"Number": 3}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative010"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "现在还是算了。总觉得<br>\n刚刚的血字好吓人……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema006"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "而且要调查这么多书的话，<br>\n我觉得应该多找几个人来比较好……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema007"]}},
    {"op": "HideAllCharacters", "line": 107, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "——哎呀。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "在某个书架的阴影处，有一位少女<br>\n稍稍探了探头看向这边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR1,ArmL1"}},
    {"op": "PlayBgm", "line": 116, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "你叫玛格……对吗。你原来在这里啊。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Margo.Normal1,ArmR5,ArmL3"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "嗯。听到有小鸟在这里唱歌，<br>\n我就想看看是什么情况。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "不、不好意思吵到你了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema009"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "没关系啦。<br>\n我在这里没找到能看的书，正愁没事可干呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo003"]}},
    {"op": "HideAllCharacters", "line": 130, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "她边说着，边迈着轻飘飘的步伐走到了别处。<br>\n明明没有招呼她们，艾玛和雪莉却像着了魔似的，跟在了她后面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative012"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "阅读区的一张小桌子上<br>\n铺满了卡片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "这是塔罗牌，对吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry006"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "嗯。是放在娱乐室的，我把它拿过来了。<br>\n我本来就很喜欢塔罗牌哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo004"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "要不要我来帮你们<br>\n占卜一下呢？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo005"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "难道玛格你是通过<br>\n塔罗牌使用魔法的吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry007"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "玛格坐在椅子上，露出一个妖艳的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Smile1"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "不是的。你们为什么想到问这个？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo006"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "我很好奇，大家都会用一些<br>\n怎样的魔法，好奇得不得了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry008"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "玛格不禁笑了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Smile1,ArmR5,ArmL3"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "真可爱。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo007"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "和设想相反，玛格没有直接配合提问，<br>\n而是边笑着摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative016"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "不过，很抱歉，<br>\n我不能告诉你们我会用怎样的魔法。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo008"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "如果说，之后这座监牢内会发生凶杀案，<br>\n你们难道不觉得，暴露手里的底牌是很愚蠢的吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo009"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "听玛格这么讲，<br>\n艾玛不禁皱起眉头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative017"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "我相信不会发生凶杀案的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema010"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "玛格拿出一张牌，<br>\n放在了艾玛和雪莉面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "【塔】的正位。<br>\n……在不久的将来，会有某个人死去。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo010"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "明明只是普通的占卜，<br>\n但玛格的话却莫名地有说服力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative019"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "你们也要小心周遭的事物。<br>\n毕竟我们没法知道，哪个人的身上埋藏着杀意。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo011"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "太过分了……竟然要让我怀疑其他人……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Margo.Smile1,ArmR5,ArmL3"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "哎呀。我们只不过才认识了一天，<br>\n你还真是善良……还是应该说是天真呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo012"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "明明每个人之间都不是很熟悉，<br>\n为什么你会选择相信别人？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo013"]}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "我……不、不过！<br>\n至少我觉得，她们不是会下手杀人的人！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema012"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "你最熟悉的那位二阶堂希罗，<br>\n不是比谁都要更早地展露出杀意了吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo014"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema013"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "玛格的脸上仍堆着满面的笑容，<br>\n可是她的话语就像一把锋利的刀，狠狠刺伤了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "眼看艾玛和玛格之间要掀起一股波浪，<br>\n雪莉便插到了她们两人中间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "那个，我们该走啦，<br>\n艾玛！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry009"]}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Ema014"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "打搅了！<br>\n我们下次再来跟你讨教你的事哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Sherry010"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "呵呵……想要占卜的话，<br>\n随时来跟我说哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv13_Margo015"]}},
    {"op": "Gosub", "line": 231, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 233, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv11", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv13_Narrative001": "监牢二楼可以进的房间只有两个。<br>\n一个是图书室，一个是娱乐室。",
  "0101Adv13_Narrative002": "艾玛和雪莉决定<br>\n去图书室看一看。",
  "0101Adv13_Narrative003": "图书室内的书架整齐地排列着，<br>\n空气中飘着一股老旧的纸香味，呈现出静谧的气氛。",
  "0101Adv13_Ema001": "这里会有什么书呢。",
  "0101Adv13_Narrative004": "艾玛随手拿出一本书翻了起来，<br>\n可上面写的全是看不懂的字。",
  "0101Adv13_Ema002": "唔……看不懂……",
  "0101Adv13_Sherry001": "这不是我们国家的文字呢。<br>\n这座监牢究竟在哪个国家？<br>\n难不成……是异世界！？",
  "0101Adv13_Ema003": "你、你不要说这么令人绝望的话啦！",
  "0101Adv13_Narrative005": "雪莉也从书架上拿出一本书，<br>\n随意的翻动着。",
  "0101Adv13_Sherry002": "艾玛，艾玛！<br>\n快，快来看这个！",
  "0101Adv13_Narrative006": "见雪莉朝她挥手，<br>\n艾玛的视线也往书上面移动。<br>\n只见打开的那一页上面写着——",
  "0101Adv13_Narrative007": "<color=#ff0000>救命</color>",
  "0101Adv13_Narrative008": "血红的字迹写着这么一句话。<br>\n艾玛倒吸一口凉气。",
  "0101Adv13_Sherry003": "这个难道是之前被抓的预备魔女<br>\n在上面写的！？",
  "0101Adv13_Ema004": "可能是……",
  "0101Adv13_Sherry004": "令人兴奋耶～！",
  "0101Adv13_Ema005": "一点都不兴奋啦！",
  "0101Adv13_Sherry005": "其他书上会不会<br>\n也留下了这类信息呢。<br>\n你要不要再调查一下？",
  "0101Adv13_Narrative009": "对于雪莉的建议，艾玛——",
  "0101Adv13_Choice001": "表示赞成",
  "0101Adv13_Choice002": "摇了摇头",
  "0101Adv13_Narrative010": "摇了摇头。",
  "0101Adv13_Ema006": "现在还是算了。总觉得<br>\n刚刚的血字好吓人……",
  "0101Adv13_Ema007": "而且要调查这么多书的话，<br>\n我觉得应该多找几个人来比较好……",
  "0101Adv13_Margo001": "——哎呀。",
  "0101Adv13_Narrative011": "在某个书架的阴影处，有一位少女<br>\n稍稍探了探头看向这边。",
  "0101Adv13_Ema008": "你叫玛格……对吗。你原来在这里啊。",
  "0101Adv13_Margo002": "嗯。听到有小鸟在这里唱歌，<br>\n我就想看看是什么情况。",
  "0101Adv13_Ema009": "不、不好意思吵到你了。",
  "0101Adv13_Margo003": "没关系啦。<br>\n我在这里没找到能看的书，正愁没事可干呢。",
  "0101Adv13_Narrative012": "她边说着，边迈着轻飘飘的步伐走到了别处。<br>\n明明没有招呼她们，艾玛和雪莉却像着了魔似的，跟在了她后面。",
  "0101Adv13_Narrative013": "阅读区的一张小桌子上<br>\n铺满了卡片。",
  "0101Adv13_Sherry006": "这是塔罗牌，对吗？",
  "0101Adv13_Margo004": "嗯。是放在娱乐室的，我把它拿过来了。<br>\n我本来就很喜欢塔罗牌哦。",
  "0101Adv13_Margo005": "要不要我来帮你们<br>\n占卜一下呢？",
  "0101Adv13_Sherry007": "难道玛格你是通过<br>\n塔罗牌使用魔法的吗？",
  "0101Adv13_Narrative014": "玛格坐在椅子上，露出一个妖艳的微笑。",
  "0101Adv13_Margo006": "不是的。你们为什么想到问这个？",
  "0101Adv13_Sherry008": "我很好奇，大家都会用一些<br>\n怎样的魔法，好奇得不得了！",
  "0101Adv13_Narrative015": "玛格不禁笑了起来。",
  "0101Adv13_Margo007": "真可爱。",
  "0101Adv13_Narrative016": "和设想相反，玛格没有直接配合提问，<br>\n而是边笑着摇了摇头。",
  "0101Adv13_Margo008": "不过，很抱歉，<br>\n我不能告诉你们我会用怎样的魔法。",
  "0101Adv13_Margo009": "如果说，之后这座监牢内会发生凶杀案，<br>\n你们难道不觉得，暴露手里的底牌是很愚蠢的吗？",
  "0101Adv13_Narrative017": "听玛格这么讲，<br>\n艾玛不禁皱起眉头。",
  "0101Adv13_Ema010": "我相信不会发生凶杀案的。",
  "0101Adv13_Narrative018": "玛格拿出一张牌，<br>\n放在了艾玛和雪莉面前。",
  "0101Adv13_Margo010": "【塔】的正位。<br>\n……在不久的将来，会有某个人死去。",
  "0101Adv13_Narrative019": "明明只是普通的占卜，<br>\n但玛格的话却莫名地有说服力。",
  "0101Adv13_Margo011": "你们也要小心周遭的事物。<br>\n毕竟我们没法知道，哪个人的身上埋藏着杀意。",
  "0101Adv13_Ema011": "太过分了……竟然要让我怀疑其他人……",
  "0101Adv13_Margo012": "哎呀。我们只不过才认识了一天，<br>\n你还真是善良……还是应该说是天真呢。",
  "0101Adv13_Margo013": "明明每个人之间都不是很熟悉，<br>\n为什么你会选择相信别人？",
  "0101Adv13_Ema012": "我……不、不过！<br>\n至少我觉得，她们不是会下手杀人的人！",
  "0101Adv13_Margo014": "你最熟悉的那位二阶堂希罗，<br>\n不是比谁都要更早地展露出杀意了吗？",
  "0101Adv13_Ema013": "……",
  "0101Adv13_Narrative020": "玛格的脸上仍堆着满面的笑容，<br>\n可是她的话语就像一把锋利的刀，狠狠刺伤了艾玛。",
  "0101Adv13_Narrative021": "眼看艾玛和玛格之间要掀起一股波浪，<br>\n雪莉便插到了她们两人中间。",
  "0101Adv13_Sherry009": "那个，我们该走啦，<br>\n艾玛！",
  "0101Adv13_Ema014": "嗯……",
  "0101Adv13_Sherry010": "打搅了！<br>\n我们下次再来跟你讨教你的事哦。",
  "0101Adv13_Margo015": "呵呵……想要占卜的话，<br>\n随时来跟我说哦。"
}
}
