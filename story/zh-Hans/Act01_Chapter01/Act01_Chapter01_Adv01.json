    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "——这里是囚牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "樱羽艾玛只想捂紧耳朵，<br>\n抵挡身边涌现的恶意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "可是，她被无形的锁链束缚着，<br>\n就像个囚犯一样，连捂紧耳朵也做不到。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative003"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "有时被锁在厕所隔间里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative004"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "有时课本被撕毁丢弃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "有时室内鞋里被塞满了虫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative006"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "有时被集体暴打施以私刑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative007"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "有时被绑起来当众羞辱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative008"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "有时。有时。有时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative009"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "霸凌日益变本加厉，<br>\n她的心脏好似灌铅般愈发沉重。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative010"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "住手吧。<br>\n住手。住手。住手住手住手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative011"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "不要再欺负人了！！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative012"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "唯有这句话不管怎样都说不出口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative013"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "被辱骂、被欺侮、被嘲笑，<br>\n每日如此，不见尽头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative014"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "如此残酷的行为，竟长期持续，未曾断绝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative015"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "她不禁开始责备比任何人都胆小的自己。<br>\n她太过讨厌自己，甚至想要就此消失。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative016"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "对一成不变的日常感到绝望的艾玛，<br>\n堕入了无边的黑暗之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative017"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "周围的少女们，不断地发出欢声笑语。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative018"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "不想被讨厌，不想被讨厌啊。<br>\n为什么要这样？可不可以不要这样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative019"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "心在持续发出沙哑的呜咽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative020"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "长期以来，艾玛一直在责备着自己——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative021"]}},
    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "但某天她忽然发现了答案。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative022"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "啊，对了——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv01_Narrative023"]}},
    {"op": "ModifyBackgroundExtended", "line": 75, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "140_2"}},
    {"op": "ModifyBackgroundExtended", "line": 76, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 77, "indent": 0, "params": {"WaitMode": "1.8"}},
