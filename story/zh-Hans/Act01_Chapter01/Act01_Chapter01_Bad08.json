  "path": "Act01_Chapter01/Act01_Chapter01_Bad08",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 3, "indent": 1, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "label", "name": "Scene1-1-b8", "line": 9, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_1"}},
    {"op": "PlayBgm", "line": 16, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "做出若有所思的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "唔……怎么办呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "哎呀，有什么在意的地方吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "嗯。不过我也觉得这里没什么线索了，只不过……<br>\n这说不定，只是我的错觉……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "面对艾玛言辞闪烁的回答，雪莉不禁感到疑问。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "怎么回事？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "呃，我说了你别笑我哦？<br>\n其实进来这里之后，我就一直觉得——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema003"]}},
    {"op": "HideAllCharacters", "line": 41, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "艾玛、雪莉，<br>\n我们准备去其他地方调查了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Leia001"]}},
    {"op": "HideAllCharacters", "line": 46, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmR3"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "呵呵，希望你们能找到线索哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Margo001"]}},
    {"op": "HideAllCharacters", "line": 51, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "啊，嗯，好……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema004"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "蕾雅、玛格、米莉亚三人<br>\n离开了淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative003"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "她们前脚刚走，<br>\n汉娜后脚就回来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "汉娜，你没事吧！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema005"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "……没事哦？一点都没事。<br>\n所以，你们有找到什么线索吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "现在还没有……<br>\n不过，艾玛说她有些在意的地方。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "啊，嗯……<br>\n所以，你们听了真的别取笑我哦？我说……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema006"]}},
    {"op": "HideAllCharacters", "line": 78, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 79, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "向雪莉和汉娜再次强调后，<br>\n艾玛怯怯说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative005"]}},
    {"op": "PlayBgm", "line": 83, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "你们不感觉，从进来这里之后<br>\n就一直有人在盯着我们吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema007"]}},
    {"op": "HideAllCharacters", "line": 89, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "汉娜和雪莉对视了一下，<br>\n然后转头面向艾玛，同时摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "唔，我没感觉呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry004"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "我也是，完全没感觉。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "是吗……<br>\n到底是我的错觉吗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema008"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "三人开始环视整个淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "难不成，有某处设置了<br>\n摄像头……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 113, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "呃！？如果是真的话，那也太差劲了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 118, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "雪莉和汉娜开始四处认真搜索，<br>\n艾玛也开始认真调查周边——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 122, "indent": 0, "params": {"SfxPath": "Sfx_181", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "此时，忽然响起少女的笑声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "欸……！？刚刚的声音是怎么回事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema009"]}},
    {"op": "HideAllCharacters", "line": 130, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "那明显不是雪莉或汉娜的声音。<br>\n声音似乎是从房内设置的<br>\n镜子处发出的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 135, "indent": 0, "params": {"SfxPath": "Sfx_35", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 137, "indent": 0, "params": {"Scale": [2.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [35.0], "AppearanceAndTransition": "30_1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "艾玛战战兢兢地望向碎掉的镜子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative011"]}},
    {"op": "PlaySfxModified", "line": 142, "indent": 0, "params": {"SfxPath": "Sfx_20", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "而碎裂的镜子上，裂痕竟开始了生长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "噫！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema010"]}},
    {"op": "StopBgm", "line": 150, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "从镜子中，有人朝艾玛伸出了双手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative013"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "（怎、怎么回事……！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema011"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "纤细而苍白的手，紧紧抓住艾玛的双肩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative014"]}},
    {"op": "PlaySfxModified", "line": 158, "indent": 0, "params": {"SfxPath": "Sfx_181", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "——我想你的能量频率应该和我一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative015"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "漂亮的粉色头发……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative016"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "——我说，你可以把它让给我吗？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative017"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema012"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "艾玛没来得及发出声音，<br>\n便被拉进了镜子里面——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative018"]}},
    {"op": "ResetText", "line": 176, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 178, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 179, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 180, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 181, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 184, "indent": 0, "params": {"SfxPath": "Sfx_60", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 186, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "刚刚的声音是什么？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 190, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "艾玛是不是掉了什么东西呀？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 195, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "汉娜和雪莉向发出声音的方向走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "艾玛？<br>\n……哎呀，人不在。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry007"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "那里好像掉了手机欸。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna005"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "顺着汉娜手指方向看去，<br>\n能看到一部手机掉在了地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 208, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "唔……刚刚的声音<br>\n会不会是手机掉下来的声音呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry008"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "说着，雪莉捡起了手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative021"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "那是艾玛的手机吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna006"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "哎呀？开不了机呢……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry009"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "手机似乎是掉下来的时候摔坏了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "说来，艾玛到底跑哪里去了啊！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna007"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "不知道呢。会不会哪里有暗门……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry010"]}},
    {"op": "ResetText", "line": 226, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 228, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 229, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 230, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlayBgm", "line": 232, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 234, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "雪莉！汉娜！<br>\n我在这里！求你们快注意到我！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema013"]}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "艾玛向【镜子另一侧】的<br>\n雪莉和汉娜大声呼救。<br>\n但是，她的声音传不到两人的耳中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative023"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "怎、怎么一回事……？<br>\n这里难道是镜子里面的世界……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema014"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "雪莉和汉娜在镜子另一侧的淋浴房<br>\n搜索着暗门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative024"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "而当艾玛看见在她们背后出现的人影时，<br>\n不禁发出了疑惑的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative025"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "假、假的吧……怎么会！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "哎呀，艾玛？<br>\n真是的，你跑哪里去了？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna008"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "你突然不见，<br>\n吓了我们一跳！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry011"]}},
    {"op": "HideAllCharacters", "line": 255, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "抱歉抱歉。<br>\n我听见外面有些动静，就去看了一下。<br>\n不过，好像是我的错觉。", "AuthorId": "EmaFake", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_EmaFake001"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "有着艾玛外貌的【某物】<br>\n正在跟雪莉和汉娜二人对话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative026"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "为、为什么……那是谁？<br>\n明明我在这里……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema016"]}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "我们该走啦。", "AuthorId": "EmaFake", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_EmaFake002"]}},
    {"op": "HideAllCharacters", "line": 270, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 271, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 272, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "嗯。<br>\n这里也没什么值得调查的地方了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Hanna009"]}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "啊，对了。这里掉了一部手机，<br>\n是不是艾玛你的？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Sherry012"]}},
    {"op": "HideAllCharacters", "line": 278, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "雪莉和汉娜，准备和有着艾玛外貌的【那个东西】<br>\n离开淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative027"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "你们两个等一下！那个不是我！<br>\n我在这里！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Ema017"]}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "艾玛的诉说不过是徒劳，三人离开了镜子前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative028"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "在离去前，有着艾玛外貌的【某物】<br>\n短暂地回过头来看向真正的艾玛所在的镜子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 288, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "呵呵呵……", "AuthorId": "EmaFake", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad08_EmaFake003"]}},
    {"op": "ProcessBadEnd", "line": 298, "indent": 0, "params": {"Number": 8}}
  ],
  "translations": {
  "0101Bad08_Narrative001": "做出若有所思的表情。",
  "0101Bad08_Ema001": "唔……怎么办呢……",
  "0101Bad08_Sherry001": "哎呀，有什么在意的地方吗？",
  "0101Bad08_Ema002": "嗯。不过我也觉得这里没什么线索了，只不过……<br>\n这说不定，只是我的错觉……",
  "0101Bad08_Narrative002": "面对艾玛言辞闪烁的回答，雪莉不禁感到疑问。",
  "0101Bad08_Sherry002": "怎么回事？",
  "0101Bad08_Ema003": "呃，我说了你别笑我哦？<br>\n其实进来这里之后，我就一直觉得——",
  "0101Bad08_Leia001": "艾玛、雪莉，<br>\n我们准备去其他地方调查了。",
  "0101Bad08_Margo001": "呵呵，希望你们能找到线索哦。",
  "0101Bad08_Ema004": "啊，嗯，好……",
  "0101Bad08_Narrative003": "蕾雅、玛格、米莉亚三人<br>\n离开了淋浴房。",
  "0101Bad08_Narrative004": "她们前脚刚走，<br>\n汉娜后脚就回来了。",
  "0101Bad08_Ema005": "汉娜，你没事吧！？",
  "0101Bad08_Hanna001": "……没事哦？一点都没事。<br>\n所以，你们有找到什么线索吗？",
  "0101Bad08_Sherry003": "现在还没有……<br>\n不过，艾玛说她有些在意的地方。",
  "0101Bad08_Ema006": "啊，嗯……<br>\n所以，你们听了真的别取笑我哦？我说……",
  "0101Bad08_Narrative005": "向雪莉和汉娜再次强调后，<br>\n艾玛怯怯说道。",
  "0101Bad08_Ema007": "你们不感觉，从进来这里之后<br>\n就一直有人在盯着我们吗……？",
  "0101Bad08_Narrative006": "汉娜和雪莉对视了一下，<br>\n然后转头面向艾玛，同时摇了摇头。",
  "0101Bad08_Sherry004": "唔，我没感觉呢。",
  "0101Bad08_Hanna002": "我也是，完全没感觉。",
  "0101Bad08_Ema008": "是吗……<br>\n到底是我的错觉吗……",
  "0101Bad08_Narrative007": "三人开始环视整个淋浴房。",
  "0101Bad08_Sherry005": "难不成，有某处设置了<br>\n摄像头……？",
  "0101Bad08_Hanna003": "呃！？如果是真的话，那也太差劲了！",
  "0101Bad08_Narrative008": "雪莉和汉娜开始四处认真搜索，<br>\n艾玛也开始认真调查周边——",
  "0101Bad08_Narrative009": "此时，忽然响起少女的笑声。",
  "0101Bad08_Ema009": "欸……！？刚刚的声音是怎么回事……",
  "0101Bad08_Narrative010": "那明显不是雪莉或汉娜的声音。<br>\n声音似乎是从房内设置的<br>\n镜子处发出的。",
  "0101Bad08_Narrative011": "艾玛战战兢兢地望向碎掉的镜子。",
  "0101Bad08_Narrative012": "而碎裂的镜子上，裂痕竟开始了生长。",
  "0101Bad08_Ema010": "噫！？",
  "0101Bad08_Narrative013": "从镜子中，有人朝艾玛伸出了双手。",
  "0101Bad08_Ema011": "（怎、怎么回事……！？）",
  "0101Bad08_Narrative014": "纤细而苍白的手，紧紧抓住艾玛的双肩。",
  "0101Bad08_Narrative015": "——我想你的能量频率应该和我一样。",
  "0101Bad08_Narrative016": "漂亮的粉色头发……",
  "0101Bad08_Narrative017": "——我说，你可以把它让给我吗？",
  "0101Bad08_Ema012": "！？",
  "0101Bad08_Narrative018": "艾玛没来得及发出声音，<br>\n便被拉进了镜子里面——",
  "0101Bad08_Hanna004": "刚刚的声音是什么？",
  "0101Bad08_Sherry006": "艾玛是不是掉了什么东西呀？",
  "0101Bad08_Narrative019": "汉娜和雪莉向发出声音的方向走去。",
  "0101Bad08_Sherry007": "艾玛？<br>\n……哎呀，人不在。",
  "0101Bad08_Hanna005": "那里好像掉了手机欸。",
  "0101Bad08_Narrative020": "顺着汉娜手指方向看去，<br>\n能看到一部手机掉在了地上。",
  "0101Bad08_Sherry008": "唔……刚刚的声音<br>\n会不会是手机掉下来的声音呢？",
  "0101Bad08_Narrative021": "说着，雪莉捡起了手机。",
  "0101Bad08_Hanna006": "那是艾玛的手机吗？",
  "0101Bad08_Sherry009": "哎呀？开不了机呢……",
  "0101Bad08_Narrative022": "手机似乎是掉下来的时候摔坏了。",
  "0101Bad08_Hanna007": "说来，艾玛到底跑哪里去了啊！？",
  "0101Bad08_Sherry010": "不知道呢。会不会哪里有暗门……？",
  "0101Bad08_Ema013": "雪莉！汉娜！<br>\n我在这里！求你们快注意到我！！",
  "0101Bad08_Narrative023": "艾玛向【镜子另一侧】的<br>\n雪莉和汉娜大声呼救。<br>\n但是，她的声音传不到两人的耳中。",
  "0101Bad08_Ema014": "怎、怎么一回事……？<br>\n这里难道是镜子里面的世界……？",
  "0101Bad08_Narrative024": "雪莉和汉娜在镜子另一侧的淋浴房<br>\n搜索着暗门。",
  "0101Bad08_Narrative025": "而当艾玛看见在她们背后出现的人影时，<br>\n不禁发出了疑惑的声音。",
  "0101Bad08_Ema015": "假、假的吧……怎么会！？",
  "0101Bad08_Hanna008": "哎呀，艾玛？<br>\n真是的，你跑哪里去了？",
  "0101Bad08_Sherry011": "你突然不见，<br>\n吓了我们一跳！",
  "0101Bad08_EmaFake001": "抱歉抱歉。<br>\n我听见外面有些动静，就去看了一下。<br>\n不过，好像是我的错觉。",
  "0101Bad08_Narrative026": "有着艾玛外貌的【某物】<br>\n正在跟雪莉和汉娜二人对话。",
  "0101Bad08_Ema016": "为、为什么……那是谁？<br>\n明明我在这里……！？",
  "0101Bad08_EmaFake002": "我们该走啦。",
  "0101Bad08_Hanna009": "嗯。<br>\n这里也没什么值得调查的地方了。",
  "0101Bad08_Sherry012": "啊，对了。这里掉了一部手机，<br>\n是不是艾玛你的？",
  "0101Bad08_Narrative027": "雪莉和汉娜，准备和有着艾玛外貌的【那个东西】<br>\n离开淋浴房。",
  "0101Bad08_Ema017": "你们两个等一下！那个不是我！<br>\n我在这里！",
  "0101Bad08_Narrative028": "艾玛的诉说不过是徒劳，三人离开了镜子前。",
  "0101Bad08_Narrative029": "在离去前，有着艾玛外貌的【某物】<br>\n短暂地回过头来看向真正的艾玛所在的镜子。",
  "0101Bad08_EmaFake003": "呵呵呵……"
}
}
