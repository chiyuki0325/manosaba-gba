  "path": "Act01_Chapter01/Act01_Chapter01_Adv36",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-32", "line": 4, "indent": 0},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_1_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ChangeActorPivot", "line": 20, "indent": 0, "params": {"ActorIds": ["Stills-Front"], "PivotPoint": [0.5, 0.5]}},
    {"op": "ModifyBackgroundExtended", "line": 21, "indent": 0, "params": {"Id": "Stills", "Scale": [1.125], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "200_1"}},
    {"op": "ModifyBackgroundExtended", "line": 22, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyTextPrinter", "line": 25, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "——“请注视我吧。”她的心如此呐喊着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "莲见蕾雅必须变得比所有人都要引人注目。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "在她幼年时，母亲卧病在床，封闭了自己的内心。<br>\n一切从那时开始。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative003"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "从不直视任何人——也不说话——<br>\n甚至连女儿的存在都未能察觉——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative004"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "幼小的蕾雅，常常来到母亲的病房中<br>\n和她说话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative005"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "——没关系的，没什么好怕的！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative006"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "——蕾雅会保护妈妈的！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative007"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "——我一定会治好妈妈的病！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative008"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "——所以，所以……求你，看一看蕾雅吧！", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative009"]}},
    {"op": "HidePrinter", "line": 45, "indent": 0, "params": {}},
    {"op": "Wait", "line": 46, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 48, "indent": 0, "params": {"Id": "Stills", "Scale": [1.125], "Duration": 0.15000000596046448, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "200_2", "SubId": "Middle"}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "0.15"}},
    {"op": "HideActors", "line": 51, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.30000001192092896, "Lazy": 0}},
    {"op": "Wait", "line": 52, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 54, "indent": 0, "params": {"Id": "Stills", "Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "200_2", "SubId": "Middle"}},
    {"op": "Wait", "line": 55, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "曾经有且仅有一次，母亲看了病房内的电视。<br>\n而电视上正好播映着舞台剧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative010"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "或许，母亲只是单纯将视线<br>\n对准到了电视上而已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative011"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "尽管如此，映入母亲眼帘中的影像，<br>\n却成了蕾雅心中的希望。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative012"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "只要站在那里，<br>\n站在最显眼的地方，我一定能得到她的注视。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative013"]}},
    {"op": "HidePrinter", "line": 65, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 66, "indent": 0, "params": {"Visible": 0, "TintColor": "white", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 67, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"Visible": 1, "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 70, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "而这份愿望，成为了魔法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative014"]}},
    {"op": "HidePrinter", "line": 74, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 75, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 76, "indent": 0, "params": {"Id": "Stills", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "200_3"}},
    {"op": "ModifyBackgroundExtended", "line": 77, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 78, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "蕾雅获得了一份神奇力量，<br>\n能用来得到他人的注目。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative015"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "只要运用这份力量，<br>\n自己就能随时获得最引人注目的地位。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative016"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "蕾雅必须一直都是舞台的主角。<br>\n她认为，不这样做就没有意义。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative017"]}},
    {"op": "HidePrinter", "line": 86, "indent": 0, "params": {}},
    {"op": "Wait", "line": 87, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "SpawnShake", "line": 89, "indent": 0, "params": {"ActorId": "Camera", "ShakeCount": 2, "ShakeAmplitude": 0.15000000596046448, "AmplitudeVariation": 2.0, "ShakeHorizontally": 1, "ShakeVertically": 0}},
    {"op": "Wait", "line": 90, "indent": 0, "params": {"WaitMode": "0.05"}},
    {"op": "ModifyBackgroundExtended", "line": 92, "indent": 0, "params": {"Id": "Stills", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "200_4"}},
    {"op": "Wait", "line": 93, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "可是，不管用怎样的魔法——<br>\n母亲始终没有看见蕾雅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative018"]}},
    {"op": "HidePrinter", "line": 97, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 98, "indent": 0, "params": {"Id": "Stills", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "200_5"}},
    {"op": "Wait", "line": 99, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "我做得还不够。<br>\n我还要变得更显眼才行。<br>\n要比谁都要引人注目才行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative019"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "必须要除掉<br>\n比自己还要引人注目的人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative020"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "为了我的目标，我可以使出一切手段。<br>\n不管有多困难，不管有多肮脏。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative021"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "于是，在蕾雅的眼前，<br>\n又出现了一位比自己更显眼的人物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative022"]}},
    {"op": "HidePrinter", "line": 109, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 110, "indent": 0, "params": {"Id": "Stills", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "200_1"}},
    {"op": "Wait", "line": 111, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 113, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["68", "37", "true", "0", "#00000000"], "ScenePosition": [50.0, 50.20000076293945]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Visible": 0, "Rotation": [0.0, 0.0, 0.0], "Scale": [0.699999988079071], "TintColor": "#9fd6df", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 46.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "ChangeActorMaskability", "line": 115, "indent": 0, "params": {"ActorIds": ["Noah"], "Enable": 1}},
    {"op": "WaitForNextFrame", "line": 116, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Visible": 1, "Duration": 2.0999999046325684, "Lazy": 0, "IdAndAppearance": "Noah.Normal1"}},
    {"op": "Wait", "line": 119, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "StopBgm", "line": 121, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "那就是城崎诺亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative023"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "——有人在蕾雅的耳边悄声说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative024"]}},
    {"op": "HidePrinter", "line": 127, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 128, "indent": 0, "params": {"Visible": 0, "Rotation": [0.0, 0.0, 0.0], "Scale": [1.0], "TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "SolidColor", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [1.899999976158142], "Duration": 0.8999999761581421, "Lazy": 0, "ScenePosition": [40.0, 42.0], "IdAndAppearance": "Noah.Normal1", "SubId": "Middle"}},
    {"op": "WaitForNextFrame", "line": 130, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"Visible": 1, "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 133, "indent": 0, "params": {"ActorIds": ["Noah-Middle"], "Loop": 0, "ScenePositionX": "60", "EasingTypeName": "Linear", "Duration": "10"}},
    {"op": "Wait", "line": 134, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "不除掉引人注目的她，你就没法成为全场焦点哦？<br>\n真可怜啊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative025"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "就在那时，蕾雅决定要杀死城崎诺亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative026"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "这样一来，大家都只会注视我了。<br>\n可是到头来，果然。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative027"]}},
    {"op": "HidePrinter", "line": 142, "indent": 0, "params": {}},
    {"op": "ChangeActorMaskability", "line": 143, "indent": 0, "params": {"ActorIds": ["Noah"], "Enable": 0}},
    {"op": "DestroySpawnedExtended", "line": 144, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["0"], "LogWarning": 1}},
    {"op": "ModifyBackgroundExtended", "line": 145, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.0], "TintColor": "#ff0000", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "SolidColor"}},
    {"op": "HideActors", "line": 146, "indent": 0, "params": {"ActorIds": ["Stills", "Noah"], "Duration": 0.0, "Lazy": 0}},
    {"op": "HideActors", "line": 147, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Noah-Middle"], "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 148, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "谁都没在看自己。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative028"]}},
    {"op": "AnimateActorExtended", "line": 164, "indent": 0, "params": {"ActorIds": ["Noah-Middle"], "Loop": 0}},
    {"op": "HidePrinter", "line": 165, "indent": 0, "params": {}},
    {"op": "Wait", "line": 166, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "ModifyTextPrinter", "line": 168, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 169, "indent": 0, "params": {"Id": "Stills", "Scale": [1.399999976158142], "Duration": 0.8999999761581421, "Lazy": 0, "ScenePosition": [50.0, 48.0], "AppearanceAndTransition": "410_4", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 170, "indent": 0, "params": {"ActorId": "Stills-Middle", "Intensity": 1.0, "FadeDuration": 0.0}},
    {"op": "WaitForNextFrame", "line": 171, "indent": 0, "params": {}},
    {"op": "SpawnBlur", "line": 173, "indent": 0, "params": {"ActorId": "Stills-Middle", "Intensity": 0.0, "FadeDuration": 2.4000000953674316}},
    {"op": "AnimateActorExtended", "line": 174, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "Scale": "1.3", "EasingTypeName": "EaseOutQuad", "Duration": "2.7"}},
    {"op": "Wait", "line": 175, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PlayBgm", "line": 177, "indent": 0, "params": {"BgmPath": "Bgm_44_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "在封闭的天使像中，<br>\n蕾雅发出前所未有的惨叫声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative029"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "可是再也没人能看到蕾雅的样子了。<br>\n因为天使像已经关上了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative030"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "从天使像的下方，点滴渗出了血液，流淌在底座之上。<br>\n那应该就是蕾雅的血。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative031"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "讽刺的是，鲜活的红颜色<br>\n全都化作了美丽的蝴蝶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative032"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "不管流了多少血，<br>\n蕾雅似乎都并未死去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative033"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "只有天使像不断的颤动着，<br>\n血液不断的流淌着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative034"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "（因为蕾雅变成了魔女，<br>\n　所以她不会死……那，处刑什么时候才结束……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Ema001"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "喂，该住手了吧！她已经遭受足够的痛苦了吧！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Alisa001"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "亚里沙实在难以忍受，便喊道。<br>\n就在这时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative035"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "蕾雅持续的惨叫声，<br>\n最终变成了可怕的低吼声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative036"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "完全化作异形后的低吼声，<br>\n已不再听得出蕾雅的声音了。那简直就是野兽般的咆哮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative037"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "由于她已顺利变成魔女的残骸，<br>\n接下来她会被关进永恒的囚牢之中。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Warden001"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "典狱长再次宣言后，<br>\n紧接着传来机械的运作声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative038"]}},
    {"op": "PlaySfxModified", "line": 213, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HidePrinter", "line": 214, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 215, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 216, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 217, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 219, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionY": "42.5", "EasingTypeName": "EaseInQuad", "Duration": "0.9"}},
    {"op": "ModifyBackgroundExtended", "line": 220, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 221, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "这时机关开始运作，<br>\n将处刑台降至地下，移出了现场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative039"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "异形的咆哮声仍持续了一阵子，<br>\n不过随着地板的闭合，声音也完全消失不见了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative040"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "中心处原有的底座恢复了原位。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative041"]}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "就好像，<br>\n自始至终那里从没发生过任何事一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative042"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "艾玛吐出郁积在胸中的浊气，<br>\n将放置在腿上的拳头紧紧握住。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative043"]}},
    {"op": "HidePrinter", "line": 233, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 234, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0}},
    {"op": "HideActors", "line": 235, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 236, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [3.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [70.0, 61.0], "IdAndAppearance": "Ema.Cry1,ArmR3"}},
    {"op": "ModifyBackgroundExtended", "line": 238, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 239, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "（再见，蕾雅……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Ema002"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "啪嗒，啪嗒。<br>\n泪珠一滴滴落在艾玛的腿上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative044"]}},
    {"op": "StopBgm", "line": 249, "indent": 0, "params": {}},
    {"op": "HidePrinter", "line": 251, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 252, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Wait", "line": 253, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "——做得好。", "RevealSpeed": 0.05000000074505806, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative045"]}},
    {"op": "HidePrinter", "line": 260, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 261, "indent": 0, "params": {"Duration": 0.6000000238418579, "Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyTextPrinter", "line": 262, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Wait", "line": 263, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "（啊啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Ema003"]}},
    {"op": "HidePrinter", "line": 267, "indent": 0, "params": {}},
    {"op": "Wait", "line": 268, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Duration": 1.2000000476837158, "Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "Wait", "line": 271, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "艾玛低着头，渗出了泪水，<br>\n而她的嘴角则是稍微地——似乎得到了满足般地上扬着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative046"]}},
    {"op": "HidePrinter", "line": 275, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 276, "indent": 0, "params": {"Duration": 1.7999999523162842, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 277, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "HideActors", "line": 279, "indent": 0, "params": {"ActorIds": ["Ema"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 280, "indent": 0, "params": {"Scale": [2.0], "TintColor": "white", "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 60.0], "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 281, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.7999999523162842, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 282, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 284, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 285, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "寂静填满了整个审判庭。<br>\n一时间，没有任何人说任何话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative047"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "打破这份令人难以忍受的沉默的，<br>\n是典狱长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative048"]}},
    {"op": "HidePrinter", "line": 291, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 292, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["60", "200", "true", "0.5", "#000000cc"], "ScenePosition": [75.0, 50.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 293, "indent": 0, "params": {"Visible": 0, "Rotation": [0.0, 0.0, 0.0], "Scale": [1.2999999523162842], "TintColor": "white", "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 55.0], "AppearanceAndTransition": "14_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 294, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.2000000476837158], "Lazy": 0, "ScenePosition": [75.0, 55.0], "IdAndAppearance": "Warden.1", "SubId": "Middle"}},
    {"op": "ChangeActorMaskability", "line": 295, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Warden-Middle"], "Enable": 1}},
    {"op": "WaitForNextFrame", "line": 296, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 298, "indent": 0, "params": {"Visible": 1, "Lazy": 0, "AppearanceAndTransition": "14_1", "SubId": "Middle"}},
    {"op": "WaitForNextFrame", "line": 299, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 301, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Loop": 0, "ScenePositionY": "50", "EasingTypeName": "EaseOutQuad", "Duration": "0.6"}},
    {"op": "AnimateActorExtended", "line": 302, "indent": 0, "params": {"ActorIds": ["Warden-Middle"], "Loop": 0, "ScenePositionY": "50", "EasingTypeName": "EaseOutQuad", "Duration": "0.6"}},
    {"op": "Wait", "line": 303, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "能顺利结束真是太好了呢。<br>\n如果之后再发生凶杀案的话，<br>\n就会开展魔女审判。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Warden002"]}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "在下次审判到来之前，请大家跟往常一样，<br>\n老实规矩地作为囚犯生活下去吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Warden003"]}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "魔女审判，就此闭庭。<br>\n哎呀呀，真是辛苦大家了……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Warden004"]}},
    {"op": "HidePrinter", "line": 311, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 312, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Warden-Middle"], "Loop": 0}},
    {"op": "WaitForNextFrame", "line": 313, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 315, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.6"}},
    {"op": "AnimateActorExtended", "line": 316, "indent": 0, "params": {"ActorIds": ["Warden-Middle"], "Loop": 0, "ScenePositionY": "45", "EasingTypeName": "EaseOutQuad", "Duration": "0.6"}},
    {"op": "HideActors", "line": 317, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Warden-Middle"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 318, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Middle", "LogWarning": 1}},
    {"op": "Wait", "line": 319, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 321, "indent": 0, "params": {"Text": "审判结束了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative049"]}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "少女们互相观察着对方的表情，互相提防着，<br>\n慢吞吞地动身。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative050"]}},
    {"op": "PrintTextModified", "line": 325, "indent": 0, "params": {"Text": "真是累透了。<br>\n今晚要早点睡，要把这一切统统忘掉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative051"]}},
    {"op": "PrintTextModified", "line": 327, "indent": 0, "params": {"Text": "但此时——<br>\n有一位少女作出了超乎所有人意料的举动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative052"]}},
    {"op": "PlaySfxModified", "line": 333, "indent": 0, "params": {"SfxPath": "Sfx_38", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HidePrinter", "line": 334, "indent": 0, "params": {}},
    {"op": "ChangeActorMaskability", "line": 335, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Warden-Middle"], "Enable": 0}},
    {"op": "SpawnShake", "line": 336, "indent": 0, "params": {"ActorId": "Camera", "ShakeCount": 2, "ShakeAmplitude": 0.20000000298023224, "AmplitudeVariation": 0.019999999552965164, "ShakeHorizontally": 1, "ShakeVertically": 1}},
    {"op": "Wait", "line": 337, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "一道枪声响彻了审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative053"]}},
    {"op": "HidePrinter", "line": 341, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 342, "indent": 0, "params": {"Visible": 0, "Rotation": [0.0, 0.0, 8.0], "Scale": [0.8999999761581421], "TintColor": "white", "Duration": 0.0, "Lazy": 0, "ScenePosition": [25.0, 55.0], "IdAndAppearance": "AnAn.Fearful1", "SubId": "Middle"}},
    {"op": "WaitForNextFrame", "line": 343, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 345, "indent": 0, "params": {"Rotation": [0.0, 0.0, 8.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [60.0, 55.0], "AppearanceAndTransition": "14_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 346, "indent": 0, "params": {"Visible": 1, "Lazy": 0, "ScenePosition": [25.0, 55.0], "IdAndAppearance": "AnAn.Fearful1,Angle01/Option_Arms-", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 347, "indent": 0, "params": {"Rotation": [0.0, 0.0, 8.0], "Scale": [1.100000023841858], "Lazy": 0, "ScenePosition": [75.0, 55.0], "IdAndAppearance": "Miria.Fearful1,ArmR10,ArmL4", "SubId": "Middle"}},
    {"op": "WaitForNextFrame", "line": 348, "indent": 0, "params": {}},
    {"op": "SpawnBlur", "line": 350, "indent": 0, "params": {"ActorId": "AnAn-Middle", "Intensity": 0.10000000149011612, "FadeDuration": 0.0}},
    {"op": "Wait", "line": 351, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PlayBgm", "line": 353, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "少女们瞬间再次陷入了恐慌，<br>\n身体因紧张动弹不得。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative054"]}},
    {"op": "HidePrinter", "line": 357, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 358, "indent": 0, "params": {"Rotation": [0.0, 0.0, -60.0], "Scale": [1.100000023841858], "TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "ScenePosition": [45.0, 150.0], "IdAndAppearance": "Warden.1", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 360, "indent": 0, "params": {"ActorId": "Warden-Front", "Intensity": 0.5, "FadeDuration": 0.0}},
    {"op": "WaitForNextFrame", "line": 361, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 363, "indent": 0, "params": {"ActorIds": ["Warden-Front"], "Loop": 0, "ScenePositionY": "-100", "EasingTypeName": "EaseInQuad", "Duration": "1.2"}},
    {"op": "Wait", "line": 364, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "SpawnShake", "line": 366, "indent": 0, "params": {"ActorId": "Camera", "ShakeCount": 2, "ShakeAmplitude": 0.10000000149011612, "AmplitudeVariation": 0.20000000298023224, "ShakeHorizontally": 0, "ShakeVertically": 1}},
    {"op": "Wait", "line": 367, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 369, "indent": 0, "params": {"Text": "而子弹贯穿的则是——<br>\n正要飞离此处的典狱长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative055"]}},
    {"op": "PlaySfxModified", "line": 375, "indent": 0, "params": {"SfxPath": "Sfx_39", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 377, "indent": 0, "params": {"Text": "看来那一发子弹已完全要了它的命，<br>\n落在地板上的典狱长陷入了沉默，一动也不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative056"]}},
    {"op": "HidePrinter", "line": 379, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 380, "indent": 0, "params": {"ActorIds": ["Warden-Middle", "Warden-Front"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 381, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "ScenePosition": [65.0, 35.0], "AppearanceAndTransition": "14_1"}},
    {"op": "ModifyCharacterExtended", "line": 382, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [1.2000000476837158], "Duration": 0.0, "Lazy": 0, "ScenePosition": [65.0, 35.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "HideActors", "line": 383, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "AnAn-Middle", "Miria-Middle", "Warden-Front"], "Lazy": 0}},
    {"op": "Wait", "line": 384, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 386, "indent": 0, "params": {"Text": "（究、究竟是谁！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Ema004"]}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "艾玛用视线快速扫描了整个室内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative057"]}},
    {"op": "HidePrinter", "line": 394, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 395, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 396, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "HideActors", "line": 398, "indent": 0, "params": {"ActorIds": ["MainBackground", "Ema"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 399, "indent": 0, "params": {"Id": "Stills", "Scale": [1.125], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "120_1"}},
    {"op": "ModifyBackgroundExtended", "line": 401, "indent": 0, "params": {"Duration": 1.5, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 402, "indent": 0, "params": {"WaitMode": "2.1"}},
    {"op": "PrintTextModified", "line": 404, "indent": 0, "params": {"Text": "而架起枪的那位少女<br>\n静静开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Narrative058"]}},
    {"op": "PrintTextModified", "line": 406, "indent": 0, "params": {"Text": "这出闹剧究竟要演到什么时候？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 408, "indent": 0, "params": {"Text": "这场死亡游戏的幕后黑手，<br>\n其实就在我们之中，没错吧？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv36_Nanoka002"]}},
    {"op": "UpdateWitchBook", "line": 414, "indent": 0, "params": {"Id": "Leia", "Category": "Profile", "Version": 2}},
    {"op": "UpdateWitchBook", "line": 415, "indent": 0, "params": {"Id": "Noah", "Category": "Profile", "Version": 6}},
    {"op": "SetCustomVariable", "line": 421, "indent": 0, "params": {"Expression": "g_gameProgress = max(2, g_gameProgress)"}},
    {"op": "Gosub", "line": 422, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 424, "indent": 0, "params": {"Path": "Act01_Chapter02/Act01_Chapter02_Adv01", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv36_Narrative001": "——“请注视我吧。”她的心如此呐喊着。",
  "0101Adv36_Narrative002": "莲见蕾雅必须变得比所有人都要引人注目。",
  "0101Adv36_Narrative003": "在她幼年时，母亲卧病在床，封闭了自己的内心。<br>\n一切从那时开始。",
  "0101Adv36_Narrative004": "从不直视任何人——也不说话——<br>\n甚至连女儿的存在都未能察觉——",
  "0101Adv36_Narrative005": "幼小的蕾雅，常常来到母亲的病房中<br>\n和她说话。",
  "0101Adv36_Narrative006": "——没关系的，没什么好怕的！",
  "0101Adv36_Narrative007": "——蕾雅会保护妈妈的！",
  "0101Adv36_Narrative008": "——我一定会治好妈妈的病！",
  "0101Adv36_Narrative009": "——所以，所以……求你，看一看蕾雅吧！",
  "0101Adv36_Narrative010": "曾经有且仅有一次，母亲看了病房内的电视。<br>\n而电视上正好播映着舞台剧。",
  "0101Adv36_Narrative011": "或许，母亲只是单纯将视线<br>\n对准到了电视上而已。",
  "0101Adv36_Narrative012": "尽管如此，映入母亲眼帘中的影像，<br>\n却成了蕾雅心中的希望。",
  "0101Adv36_Narrative013": "只要站在那里，<br>\n站在最显眼的地方，我一定能得到她的注视。",
  "0101Adv36_Narrative014": "而这份愿望，成为了魔法。",
  "0101Adv36_Narrative015": "蕾雅获得了一份神奇力量，<br>\n能用来得到他人的注目。",
  "0101Adv36_Narrative016": "只要运用这份力量，<br>\n自己就能随时获得最引人注目的地位。",
  "0101Adv36_Narrative017": "蕾雅必须一直都是舞台的主角。<br>\n她认为，不这样做就没有意义。",
  "0101Adv36_Narrative018": "可是，不管用怎样的魔法——<br>\n母亲始终没有看见蕾雅。",
  "0101Adv36_Narrative019": "我做得还不够。<br>\n我还要变得更显眼才行。<br>\n要比谁都要引人注目才行。",
  "0101Adv36_Narrative020": "必须要除掉<br>\n比自己还要引人注目的人。",
  "0101Adv36_Narrative021": "为了我的目标，我可以使出一切手段。<br>\n不管有多困难，不管有多肮脏。",
  "0101Adv36_Narrative022": "于是，在蕾雅的眼前，<br>\n又出现了一位比自己更显眼的人物。",
  "0101Adv36_Narrative023": "那就是城崎诺亚。",
  "0101Adv36_Narrative024": "——有人在蕾雅的耳边悄声说道。",
  "0101Adv36_Narrative025": "不除掉引人注目的她，你就没法成为全场焦点哦？<br>\n真可怜啊。",
  "0101Adv36_Narrative026": "就在那时，蕾雅决定要杀死城崎诺亚。",
  "0101Adv36_Narrative027": "这样一来，大家都只会注视我了。<br>\n可是到头来，果然。",
  "0101Adv36_Narrative028": "谁都没在看自己。",
  "0101Adv36_Narrative029": "在封闭的天使像中，<br>\n蕾雅发出前所未有的惨叫声。",
  "0101Adv36_Narrative030": "可是再也没人能看到蕾雅的样子了。<br>\n因为天使像已经关上了。",
  "0101Adv36_Narrative031": "从天使像的下方，点滴渗出了血液，流淌在底座之上。<br>\n那应该就是蕾雅的血。",
  "0101Adv36_Narrative032": "讽刺的是，鲜活的红颜色<br>\n全都化作了美丽的蝴蝶。",
  "0101Adv36_Narrative033": "不管流了多少血，<br>\n蕾雅似乎都并未死去。",
  "0101Adv36_Narrative034": "只有天使像不断的颤动着，<br>\n血液不断的流淌着。",
  "0101Adv36_Ema001": "（因为蕾雅变成了魔女，<br>\n　所以她不会死……那，处刑什么时候才结束……？）",
  "0101Adv36_Alisa001": "喂，该住手了吧！她已经遭受足够的痛苦了吧！！",
  "0101Adv36_Narrative035": "亚里沙实在难以忍受，便喊道。<br>\n就在这时。",
  "0101Adv36_Narrative036": "蕾雅持续的惨叫声，<br>\n最终变成了可怕的低吼声。",
  "0101Adv36_Narrative037": "完全化作异形后的低吼声，<br>\n已不再听得出蕾雅的声音了。那简直就是野兽般的咆哮。",
  "0101Adv36_Warden001": "由于她已顺利变成魔女的残骸，<br>\n接下来她会被关进永恒的囚牢之中。",
  "0101Adv36_Narrative038": "典狱长再次宣言后，<br>\n紧接着传来机械的运作声。",
  "0101Adv36_Narrative039": "这时机关开始运作，<br>\n将处刑台降至地下，移出了现场。",
  "0101Adv36_Narrative040": "异形的咆哮声仍持续了一阵子，<br>\n不过随着地板的闭合，声音也完全消失不见了。",
  "0101Adv36_Narrative041": "中心处原有的底座恢复了原位。",
  "0101Adv36_Narrative042": "就好像，<br>\n自始至终那里从没发生过任何事一样。",
  "0101Adv36_Narrative043": "艾玛吐出郁积在胸中的浊气，<br>\n将放置在腿上的拳头紧紧握住。",
  "0101Adv36_Ema002": "（再见，蕾雅……）",
  "0101Adv36_Narrative044": "啪嗒，啪嗒。<br>\n泪珠一滴滴落在艾玛的腿上。",
  "0101Adv36_Narrative045": "——做得好。",
  "0101Adv36_Ema003": "（啊啊……）",
  "0101Adv36_Narrative046": "艾玛低着头，渗出了泪水，<br>\n而她的嘴角则是稍微地——似乎得到了满足般地上扬着。",
  "0101Adv36_Narrative047": "寂静填满了整个审判庭。<br>\n一时间，没有任何人说任何话。",
  "0101Adv36_Narrative048": "打破这份令人难以忍受的沉默的，<br>\n是典狱长。",
  "0101Adv36_Warden002": "能顺利结束真是太好了呢。<br>\n如果之后再发生凶杀案的话，<br>\n就会开展魔女审判。",
  "0101Adv36_Warden003": "在下次审判到来之前，请大家跟往常一样，<br>\n老实规矩地作为囚犯生活下去吧。",
  "0101Adv36_Warden004": "魔女审判，就此闭庭。<br>\n哎呀呀，真是辛苦大家了……",
  "0101Adv36_Narrative049": "审判结束了。",
  "0101Adv36_Narrative050": "少女们互相观察着对方的表情，互相提防着，<br>\n慢吞吞地动身。",
  "0101Adv36_Narrative051": "真是累透了。<br>\n今晚要早点睡，要把这一切统统忘掉。",
  "0101Adv36_Narrative052": "但此时——<br>\n有一位少女作出了超乎所有人意料的举动。",
  "0101Adv36_Narrative053": "一道枪声响彻了审判庭。",
  "0101Adv36_Narrative054": "少女们瞬间再次陷入了恐慌，<br>\n身体因紧张动弹不得。",
  "0101Adv36_Narrative055": "而子弹贯穿的则是——<br>\n正要飞离此处的典狱长。",
  "0101Adv36_Narrative056": "看来那一发子弹已完全要了它的命，<br>\n落在地板上的典狱长陷入了沉默，一动也不动。",
  "0101Adv36_Ema004": "（究、究竟是谁！？）",
  "0101Adv36_Narrative057": "艾玛用视线快速扫描了整个室内。",
  "0101Adv36_Narrative058": "而架起枪的那位少女<br>\n静静开口说道。",
  "0101Adv36_Nanoka001": "这出闹剧究竟要演到什么时候？",
  "0101Adv36_Nanoka002": "这场死亡游戏的幕后黑手，<br>\n其实就在我们之中，没错吧？"
}
}
