  "path": "Act01_Chapter01/Act01_Chapter01_Bad03",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 3, "indent": 1, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "label", "name": "Scene1-1-b3", "line": 9, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "表示了同意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "嗯，说不定能发现一些<br>\n有助于越狱的提示。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema001"]}},
    {"op": "HideAllCharacters", "line": 22, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛和雪莉从最边上的书架开始，按顺序调查书本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative002"]}},
    {"op": "PlayBgm", "line": 26, "indent": 0, "params": {"BgmPath": "Bgm_27_1", "Volume": 0.6000000238418579, "Loop": 1, "FadeInDuration": 2.0}},
    {"op": "PlayBgm", "line": 27, "indent": 0, "params": {"BgmPath": "Bgm_27_2", "Volume": 0.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "很多书都没办法阅读啊。<br>\n似乎也没有明显的信息……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema002"]}},
    {"op": "HideAllCharacters", "line": 33, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "时间不断前进，但她们仍毫无收获。<br>\n此时，艾玛打开了不知是第几册的书本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative003"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "<color=#ff0000>【好恨】</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "噫……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema003"]}},
    {"op": "HideAllCharacters", "line": 43, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "艾玛？你怎么啦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 48, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "这、这本书……！<br>\n又出现了像刚刚一样的文字！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "噢噢，真叫人兴奋耶！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Sherry002"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "雪莉的眼睛闪烁着光，转头看向艾玛手上的书本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative005"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "哎呀，好像这里也写了些什么耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Sherry003"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "在页面边缘处，同样留下了疑似血字的<br>\n<color=#ff0000>【←】</color>标记。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "这个箭头是什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "唔……会不会是指示我们翻开下一页呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Sherry004"]}},
    {"op": "PlaySfxModified", "line": 69, "indent": 0, "params": {"SfxPath": "Sfx_43", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "原来如此，艾玛恍然大悟般翻开了下一页。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema006"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "艾玛顿时变得脸色煞白。<br>\n书本上出现的不再是像之前一样的短短一行字，<br>\n而是一篇密密麻麻的文章。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative008"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "这、这是什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema007"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "看来真的是之前被抓来这里的人<br>\n留下的文字。你看。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Sherry005"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "艾玛的视线转到雪莉指向的部分。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative009"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "<color=#ff0000>一醒来，发现自己在牢房之中——</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative010"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "<color=#ff0000>年纪相近的女孩子被关在一起——</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative011"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "囚犯、魔女、凶杀案……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema008"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "跟我们目前的状况，<br>\n还有典狱长的说明都是一致的呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "艾玛和雪莉继续往下阅读。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative012"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "只不过，多处字迹都出现了墨水化开或消失的现象，<br>\n只能断断续续地看下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative013"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "文章一开头也只是平淡地记录着发生的事情，<br>\n但越往后，文章内就混有越多的诅咒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative014"]}},
    {"op": "PlayBgm", "line": 101, "indent": 0, "params": {"BgmPath": "Bgm_27_1", "Volume": 0.0, "Loop": 1, "FadeInDuration": 0.0, "Duration": 2.0}},
    {"op": "PlayBgm", "line": 102, "indent": 0, "params": {"BgmPath": "Bgm_27_2", "Volume": 0.800000011920929, "Loop": 1, "FadeInDuration": 0.0, "Duration": 2.0}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "<color=#ff0000>憎恨，不可原谅，再也不信任任何人——</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative015"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "对下一个人被杀的或许就是自己的恐惧。<br>\n对其他少女的怀疑和怨恨话语——这些元素不断在文章中重复。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative016"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "<color=#ff0000>终于，只剩下3个人了。</color><br>\n<color=#ff0000>这下，也许总归轮到我死了。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative017"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "<color=#ff0000>救命。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative018"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "<color=#ff0000>我想回家。</color><br>\n<color=#ff0000>爸爸、妈妈，我想见你们。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative019"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "<color=#ff0000>为什么我非得遇到这些事不可？</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative020"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "<color=#ff0000>我没有错。</color><br>\n<color=#ff0000>我没有错。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative021"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "<color=#ff0000>明明我没有错，为什么是我？</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative022"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "<color=#ff0000>好恨。</color><br>\n<color=#ff0000>不可原谅。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative023"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "<color=#ff0000>再这么下去，只会被杀。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative024"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "<color=#ff0000>对了。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative025"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "<color=#ff0000>我想到办法了。</color><br>\n<color=#ff0000>为什么我一直以来都没察觉到呢。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative026"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "<color=#ff0000>只要在被杀之前，我去杀死其他人就好了。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative027"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "<color=#ff0000>不过，她们肯定也在想同一回事。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative028"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "<color=#ff0000>不可原谅。不可原谅。不可原谅。</color><br>\n<color=#ff0000>我要诅咒。承受痛苦吧。</color><br>\n<color=#ff0000>该承受痛苦的，是你们才对。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative029"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "<color=#ff0000>在痛苦之中，去死就好了。</color>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative030"]}},
    {"op": "StopBgm", "line": 136, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "读到下一行字后，艾玛发出短暂的惊叫声，<br>\n把手从书本上抽开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative031"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "<color=#ff0000>【现在正看到这行字的你也去死吧】</color>", "RevealSpeed": 0.05000000074505806, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative032"]}},
    {"op": "PlayBgm", "line": 146, "indent": 0, "params": {"BgmPath": "Bgm_27_3", "Volume": 1.0, "Loop": 1, "FadeInDuration": 2.0}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "艾玛，好像后面还写了东西耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Sherry007"]}},
    {"op": "PlaySfxModified", "line": 153, "indent": 0, "params": {"SfxPath": "Sfx_43", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "这次换雪莉拿起书本，<br>\n往后又翻了一页——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative033"]}},
    {"op": "HideAllCharacters", "line": 161, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 162, "indent": 0, "params": {"Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [50.0, 80.0], "IdAndAppearance": "Sherry.Pensive1", "SubId": "Middle"}},
    {"op": "PlaySfxModified", "line": 166, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "（欸？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema009"]}},
    {"op": "AnimateActorExtended", "line": 170, "indent": 0, "params": {"ActorIds": ["Sherry-Middle"], "Loop": 0, "ScenePositionY": "80|90|100", "Duration": "1|1|1"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "书本膨胀变大，把雪莉的头包裹了进去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative034"]}},
    {"op": "PlaySfxModified", "line": 175, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "AnimateActorExtended", "line": 176, "indent": 0, "params": {"ActorIds": ["Sherry-Middle"], "Loop": 0, "ScenePositionY": "120|130|140", "Duration": "1|1|1"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "书本发出如同嚼肉般的声音，<br>\n渐渐将雪莉的全身吞没。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative035"]}},
    {"op": "HideAllCharacters", "line": 180, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HideActors", "line": 181, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "啊……啊啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Ema010"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "没过多久，雪莉的身体便不留痕迹地消失了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative036"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "随后书本飘浮在半空中，好像要给艾玛展示什么似的，<br>\n翻开了书本上的某页。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative037"]}},
    {"op": "ModifyBackgroundExtended", "line": 190, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "上面什么都没写，<br>\n只展露出了如同涂黑页面般的黑暗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative038"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "面对超过理解速度的事态发展，<br>\n艾玛只能呆站在原地，一动不动——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad03_Narrative039"]}},
    {"op": "PlaySfxModified", "line": 197, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 198, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlaySfxModified", "line": 201, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 202, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ProcessBadEnd", "line": 208, "indent": 0, "params": {"Number": 3}}
  ],
  "translations": {
  "0101Bad03_Narrative001": "表示了同意。",
  "0101Bad03_Ema001": "嗯，说不定能发现一些<br>\n有助于越狱的提示。",
  "0101Bad03_Narrative002": "艾玛和雪莉从最边上的书架开始，按顺序调查书本。",
  "0101Bad03_Ema002": "很多书都没办法阅读啊。<br>\n似乎也没有明显的信息……",
  "0101Bad03_Narrative003": "时间不断前进，但她们仍毫无收获。<br>\n此时，艾玛打开了不知是第几册的书本。",
  "0101Bad03_Narrative004": "<color=#ff0000>【好恨】</color>",
  "0101Bad03_Ema003": "噫……！？",
  "0101Bad03_Sherry001": "艾玛？你怎么啦？",
  "0101Bad03_Ema004": "这、这本书……！<br>\n又出现了像刚刚一样的文字！",
  "0101Bad03_Sherry002": "噢噢，真叫人兴奋耶！",
  "0101Bad03_Narrative005": "雪莉的眼睛闪烁着光，转头看向艾玛手上的书本。",
  "0101Bad03_Sherry003": "哎呀，好像这里也写了些什么耶。",
  "0101Bad03_Narrative006": "在页面边缘处，同样留下了疑似血字的<br>\n<color=#ff0000>【←】</color>标记。",
  "0101Bad03_Ema005": "这个箭头是什么？",
  "0101Bad03_Sherry004": "唔……会不会是指示我们翻开下一页呢。",
  "0101Bad03_Narrative007": "原来如此，艾玛恍然大悟般翻开了下一页。",
  "0101Bad03_Ema006": "！！",
  "0101Bad03_Narrative008": "艾玛顿时变得脸色煞白。<br>\n书本上出现的不再是像之前一样的短短一行字，<br>\n而是一篇密密麻麻的文章。",
  "0101Bad03_Ema007": "这、这是什么……",
  "0101Bad03_Sherry005": "看来真的是之前被抓来这里的人<br>\n留下的文字。你看。",
  "0101Bad03_Narrative009": "艾玛的视线转到雪莉指向的部分。",
  "0101Bad03_Narrative010": "<color=#ff0000>一醒来，发现自己在牢房之中——</color>",
  "0101Bad03_Narrative011": "<color=#ff0000>年纪相近的女孩子被关在一起——</color>",
  "0101Bad03_Ema008": "囚犯、魔女、凶杀案……",
  "0101Bad03_Sherry006": "跟我们目前的状况，<br>\n还有典狱长的说明都是一致的呢。",
  "0101Bad03_Narrative012": "艾玛和雪莉继续往下阅读。",
  "0101Bad03_Narrative013": "只不过，多处字迹都出现了墨水化开或消失的现象，<br>\n只能断断续续地看下去。",
  "0101Bad03_Narrative014": "文章一开头也只是平淡地记录着发生的事情，<br>\n但越往后，文章内就混有越多的诅咒。",
  "0101Bad03_Narrative015": "<color=#ff0000>憎恨，不可原谅，再也不信任任何人——</color>",
  "0101Bad03_Narrative016": "对下一个人被杀的或许就是自己的恐惧。<br>\n对其他少女的怀疑和怨恨话语——这些元素不断在文章中重复。",
  "0101Bad03_Narrative017": "<color=#ff0000>终于，只剩下3个人了。</color><br>\n<color=#ff0000>这下，也许总归轮到我死了。</color>",
  "0101Bad03_Narrative018": "<color=#ff0000>救命。</color>",
  "0101Bad03_Narrative019": "<color=#ff0000>我想回家。</color><br>\n<color=#ff0000>爸爸、妈妈，我想见你们。</color>",
  "0101Bad03_Narrative020": "<color=#ff0000>为什么我非得遇到这些事不可？</color>",
  "0101Bad03_Narrative021": "<color=#ff0000>我没有错。</color><br>\n<color=#ff0000>我没有错。</color>",
  "0101Bad03_Narrative022": "<color=#ff0000>明明我没有错，为什么是我？</color>",
  "0101Bad03_Narrative023": "<color=#ff0000>好恨。</color><br>\n<color=#ff0000>不可原谅。</color>",
  "0101Bad03_Narrative024": "<color=#ff0000>再这么下去，只会被杀。</color>",
  "0101Bad03_Narrative025": "<color=#ff0000>对了。</color>",
  "0101Bad03_Narrative026": "<color=#ff0000>我想到办法了。</color><br>\n<color=#ff0000>为什么我一直以来都没察觉到呢。</color>",
  "0101Bad03_Narrative027": "<color=#ff0000>只要在被杀之前，我去杀死其他人就好了。</color>",
  "0101Bad03_Narrative028": "<color=#ff0000>不过，她们肯定也在想同一回事。</color>",
  "0101Bad03_Narrative029": "<color=#ff0000>不可原谅。不可原谅。不可原谅。</color><br>\n<color=#ff0000>我要诅咒。承受痛苦吧。</color><br>\n<color=#ff0000>该承受痛苦的，是你们才对。</color>",
  "0101Bad03_Narrative030": "<color=#ff0000>在痛苦之中，去死就好了。</color>",
  "0101Bad03_Narrative031": "读到下一行字后，艾玛发出短暂的惊叫声，<br>\n把手从书本上抽开。",
  "0101Bad03_Narrative032": "<color=#ff0000>【现在正看到这行字的你也去死吧】</color>",
  "0101Bad03_Sherry007": "艾玛，好像后面还写了东西耶。",
  "0101Bad03_Narrative033": "这次换雪莉拿起书本，<br>\n往后又翻了一页——",
  "0101Bad03_Ema009": "（欸？）",
  "0101Bad03_Narrative034": "书本膨胀变大，把雪莉的头包裹了进去。",
  "0101Bad03_Narrative035": "书本发出如同嚼肉般的声音，<br>\n渐渐将雪莉的全身吞没。",
  "0101Bad03_Ema010": "啊……啊啊……",
  "0101Bad03_Narrative036": "没过多久，雪莉的身体便不留痕迹地消失了。",
  "0101Bad03_Narrative037": "随后书本飘浮在半空中，好像要给艾玛展示什么似的，<br>\n翻开了书本上的某页。",
  "0101Bad03_Narrative038": "上面什么都没写，<br>\n只展露出了如同涂黑页面般的黑暗。",
  "0101Bad03_Narrative039": "面对超过理解速度的事态发展，<br>\n艾玛只能呆站在原地，一动不动——"
}
}
