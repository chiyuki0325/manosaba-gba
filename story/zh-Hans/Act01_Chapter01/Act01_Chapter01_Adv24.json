{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter01/Act01_Chapter01_Adv24",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-20", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_2"}},
    {"op": "ModifyBackgroundExtended", "line": 16, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "集合到会客厅的少女共有11位。<br>\n每个人都略显尴尬地回避着其他人的视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "站在艾玛身旁的是<br>\n雪莉和梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1,ArmR4,ArmL1"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "艾玛，你没事吧？<br>\n看你现在好像随时会昏倒的样子……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Sherry001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "还、还是在沙发上坐着会比较好……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "对于陷入这种状况也还在关心她的二位，<br>\n艾玛努力挤出了一个笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "我没事的。震惊的不只有我，<br>\n大家肯定也一样……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "除了凶手之外。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema002"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（……我们之中有杀害诺亚的凶手？<br>\n　怎么可能呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema003"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "艾玛的视线摇摆不定，<br>\n想要悄悄观察大家的反应。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative004"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "所有人都脸色苍白，<br>\n满脸写着难以置信。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative005"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "怎么可能，会有凶手……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema004"]}},
    {"op": "HideAllCharacters", "line": 58, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "艾玛的自言自语有些苍白无力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative006"]}},
    {"op": "PlaySfxModified", "line": 66, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "这时，随着天花板边上传来一阵翅膀拍动的声音，<br>\n典狱长现身了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative007"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "唉……结果还是<br>\n发生了凶杀案……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden001"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "今晚，将会举行【魔女审判】。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden002"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "请各位务必从在押囚犯当中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden003"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "我们会用特殊方法行刑，<br>\n令不会轻易死亡的魔女永久地安息。<br>\n那会是非常……非常残酷的方法。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden004"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "另外，有件事要向全体囚犯通告。<br>\n如果没有选出凶手，将会对所有人处刑。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden005"]}},
    {"op": "HideAllCharacters", "line": 82, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "听到典狱长轻松说出十分可怕的宣言，<br>\n少女们开始躁动起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "虽然我很不想增加无谓的工作，<br>\n不过各位本来就是<br>\n以危险分子的身份囚禁在此……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden006"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "只是……主人说……不对，<br>\n总之呢，以我们监牢管理方的感受而言，<br>\n要是全员处死就太可怜了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden007"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "所以呢，各位一定要<br>\n选出一位【魔女】，<br>\n只把【魔女】做掉就好了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden008"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "说到底，只有在<br>\n无法选定【魔女】的情况下<br>\n才会触发全员处死的规定。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden009"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "请各位努力找到凶手哦……<br>\n只要找到凶手，就能活下来……<br>\n哎，总之，大家乐观一点享受当下的状况吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden010"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "啊，还有，为了避免搜查期间有人做手脚，<br>\n请大家不要随意触碰遗体。<br>\n现场也请保持原状不动。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden011"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "那么，就拜托大家进行搜查了。<br>\n啊！不过搜查也挺难的，大家不要勉强自己哦……<br>\n搞不懂的话，各位只要去死就好了……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden012"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "搜查期限到魔女审判开庭广播为止。<br>\n只要我还没下班，视乎我的心情，也会回答各位的提问……<br>\n或许吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Warden013"]}},
    {"op": "PlaySfxModified", "line": 108, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 110, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "典狱长结束了自说自话后<br>\n便离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "必须要在审判中选一个人去死。<br>\n艾玛感到自己全身手脚冰凉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative010"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "（如果不能在今天之内找到凶手，就要全体处死……？<br>\n　时间也太不够用了！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "（而且，我不愿意相信<br>\n　我们之中竟有人行凶杀人！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema006"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "（可是，诺亚确实是被人杀死的……<br>\n　太过分了……无法原谅……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema007"]}},
    {"op": "HideAllCharacters", "line": 126, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "会客厅充斥着一股尴尬的沉默。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative011"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "像是在猜测他人的想法一样，<br>\n每个人的视线都游离不定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative012"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "少女们度过的共同生活仅仅数日。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative013"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "正如玛格所说，<br>\n大家对彼此都不甚熟悉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative014"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "要在这种情况下互相信任，<br>\n真的是非常，非常困难。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "之后，蕾雅站在室内正中心。<br>\n所有人的目光集中在她身上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative016"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "发生这样的事，我真的很难受……<br>\n但，我想要找出凶手。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Leia001"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR5,ArmL1"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "我同意。<br>\n我也不想蒙冤被判死刑。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Margo001"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "这起凶杀案的凶手，<br>\n应当以【魔女】的身份老实接受惩罚。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Margo002"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR1,ArmL2"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "嗯，我相信大家都是这个想法。<br>\n没多少时间了，我们分头去搜查吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "蕾雅和玛格二人<br>\n正准备离开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative017"]}},
    {"op": "HideAllCharacters", "line": 160, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "艾玛慌张了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "等、等一下，蕾雅！<br>\n只要知道谁是凶手，就要把她送上处刑台吗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema008"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "蕾雅从艾玛身边走过。<br>\n她的脸因难受扭作一团。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 171, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 172, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["40", "200", "true", "0.3", "#000000"], "ScenePosition": [80.0, 50.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "ForeFront"}},
    {"op": "ModifyBackgroundExtended", "line": 173, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Lazy": 0, "ScenePosition": [40.0, 44.0], "AppearanceAndTransition": "5_2", "SubId": "ForeFront"}},
    {"op": "SpawnBlur", "line": 174, "indent": 0, "params": {"ActorId": "MainBackground-ForeFront"}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.2000000476837158], "Lazy": 0, "ScenePosition": [80.0, 38.0], "IdAndAppearance": "Leia.Normal1", "SubId": "ForeFront"}},
    {"op": "ChangeActorMaskability", "line": 176, "indent": 0, "params": {"ActorIds": ["MainBackground-ForeFront", "Leia-ForeFront"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 177, "indent": 0, "params": {"ActorIds": ["MainBackground-ForeFront"], "Loop": 0, "ScenePositionY": "40", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 178, "indent": 0, "params": {"ActorIds": ["Leia-ForeFront"], "Loop": 0, "ScenePositionY": "30", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 179, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "这是为了帮助大家。<br>\n而且我心里已经有了可疑人选。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "欸……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema009"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "听到蕾雅的话后，<br>\n艾玛惊得呆住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative020"]}},
    {"op": "HideActors", "line": 189, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "此时蕾雅的眼神，<br>\n指向了汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Angry1,ArmR3,ArmL1", "SubId": "ForeFront"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "远野汉娜。<br>\n——你就是杀害了城崎诺亚的凶手，对不对？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Leia004"]}},
    {"op": "HideActors", "line": 197, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "什么……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Angry1", "SubId": "ForeFront"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "虽然我还没仔细调查，<br>\n但是现场没有留下足迹。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Leia005"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "也就是说……只有拥有飘浮魔法的人<br>\n才有办法作案，我没说错吧？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Leia006"]}},
    {"op": "HideActors", "line": 208, "indent": 0, "params": {"ActorIds": ["Hanna"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "汉娜她不可能是凶手！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema010"]}},
    {"op": "HideActors", "line": 213, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Leia.Angry1,ArmR2,ArmL1", "SubId": "ForeFront"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "……你如果是这么想的话，就去搜查吧。<br>\n我今晚会让一切水落石出。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Leia007"]}},
    {"op": "HideAllCharacters", "line": 218, "indent": 0, "params": {"Lazy": 0}},
    {"op": "AnimateActorExtended", "line": 219, "indent": 0, "params": {"ActorIds": ["MainBackground-ForeFront"], "Loop": 0, "ScenePositionY": "36", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 220, "indent": 0, "params": {"ActorIds": ["Leia-ForeFront"], "Loop": 0, "ScenePositionY": "22", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "HideActors", "line": 221, "indent": 0, "params": {"ActorIds": ["MainBackground-ForeFront", "Leia-ForeFront"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 222, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "ForeFront", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "蕾雅一脸阴沉地走出了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative022"]}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "（因为想帮助大家，她必须要选某个人做魔女……<br>\n　所以蕾雅她也变得相当冷酷……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema011"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "（虽然我懂她的想法，可是，我怎么可以怀疑汉娜！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema012"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "可可、奈叶香、亚里沙三人<br>\n也各自走出了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative023"]}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "安安坐在沙发上，梅露露一脸担心地<br>\n坐在她的身旁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "那，我就带安安小姐去医务室了。<br>\n以安安小姐现在的情况，她根本没法参加搜查……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 238, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Fearful1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "安安是第一个发现诺亚的尸体的人。<br>\n事情造成的冲击太大，她现在脸色煞白，身体还在不断颤抖着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative025"]}},
    {"op": "HideAllCharacters", "line": 243, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "是啊……希望你可以好好照顾她。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema013"]}},
    {"op": "HideAllCharacters", "line": 248, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "梅露露搀扶着安安走出去了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative026"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "留在原地的只剩<br>\n艾玛、雪莉和汉娜三人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative027"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "汉娜正低头咬着嘴唇。<br>\n她似乎相当难受，两只眼睛都是湿乎乎的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative028"]}},
    {"op": "HideAllCharacters", "line": 256, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "汉娜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema014"]}},
    {"op": "HideAllCharacters", "line": 261, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR15,ArmL1"}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "是时候该侦探出马了！<br>\n我们一起去找到真凶，洗刷汉娜的冤屈吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Sherry003"]}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "雪莉充满干劲地说道。<br>\n艾玛受到感染，表情也变得缓和些了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative029"]}},
    {"op": "HideAllCharacters", "line": 268, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 269, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "对、对啊，汉娜才不是凶手。<br>\n绝对不能让她被处刑！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 273, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "就靠我们找出真凶吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Ema016"]}},
    {"op": "HideAllCharacters", "line": 277, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "……说得对，一定要找到凶手。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Hanna002"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "几乎要哭出来的汉娜，<br>\n也终于抬起了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative030"]}},
    {"op": "HideAllCharacters", "line": 284, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "艾玛她们乘着这股气势，<br>\n开始参与城崎诺亚遇害一案的搜查。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv24_Narrative031"]}},
    {"op": "SetCustomVariable", "line": 292, "indent": 0, "params": {"Expression": "chosenAreaFlag = 0"}},
    {"op": "Gosub", "line": 293, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 295, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv25", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv24_Narrative001": "集合到会客厅的少女共有11位。<br>\n每个人都略显尴尬地回避着其他人的视线。",
  "0101Adv24_Narrative002": "站在艾玛身旁的是<br>\n雪莉和梅露露。",
  "0101Adv24_Sherry001": "艾玛，你没事吧？<br>\n看你现在好像随时会昏倒的样子……",
  "0101Adv24_Meruru001": "还、还是在沙发上坐着会比较好……",
  "0101Adv24_Narrative003": "对于陷入这种状况也还在关心她的二位，<br>\n艾玛努力挤出了一个笑容。",
  "0101Adv24_Ema001": "我没事的。震惊的不只有我，<br>\n大家肯定也一样……",
  "0101Adv24_Sherry002": "除了凶手之外。",
  "0101Adv24_Ema002": "……",
  "0101Adv24_Ema003": "（……我们之中有杀害诺亚的凶手？<br>\n　怎么可能呢）",
  "0101Adv24_Narrative004": "艾玛的视线摇摆不定，<br>\n想要悄悄观察大家的反应。",
  "0101Adv24_Narrative005": "所有人都脸色苍白，<br>\n满脸写着难以置信。",
  "0101Adv24_Ema004": "怎么可能，会有凶手……",
  "0101Adv24_Narrative006": "艾玛的自言自语有些苍白无力。",
  "0101Adv24_Narrative007": "这时，随着天花板边上传来一阵翅膀拍动的声音，<br>\n典狱长现身了。",
  "0101Adv24_Warden001": "唉……结果还是<br>\n发生了凶杀案……",
  "0101Adv24_Warden002": "今晚，将会举行【魔女审判】。",
  "0101Adv24_Warden003": "请各位务必从在押囚犯当中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑。",
  "0101Adv24_Warden004": "我们会用特殊方法行刑，<br>\n令不会轻易死亡的魔女永久地安息。<br>\n那会是非常……非常残酷的方法。",
  "0101Adv24_Warden005": "另外，有件事要向全体囚犯通告。<br>\n如果没有选出凶手，将会对所有人处刑。",
  "0101Adv24_Narrative008": "听到典狱长轻松说出十分可怕的宣言，<br>\n少女们开始躁动起来。",
  "0101Adv24_Warden006": "虽然我很不想增加无谓的工作，<br>\n不过各位本来就是<br>\n以危险分子的身份囚禁在此……",
  "0101Adv24_Warden007": "只是……主人说……不对，<br>\n总之呢，以我们监牢管理方的感受而言，<br>\n要是全员处死就太可怜了。",
  "0101Adv24_Warden008": "所以呢，各位一定要<br>\n选出一位【魔女】，<br>\n只把【魔女】做掉就好了。",
  "0101Adv24_Warden009": "说到底，只有在<br>\n无法选定【魔女】的情况下<br>\n才会触发全员处死的规定。",
  "0101Adv24_Warden010": "请各位努力找到凶手哦……<br>\n只要找到凶手，就能活下来……<br>\n哎，总之，大家乐观一点享受当下的状况吧。",
  "0101Adv24_Warden011": "啊，还有，为了避免搜查期间有人做手脚，<br>\n请大家不要随意触碰遗体。<br>\n现场也请保持原状不动。",
  "0101Adv24_Warden012": "那么，就拜托大家进行搜查了。<br>\n啊！不过搜查也挺难的，大家不要勉强自己哦……<br>\n搞不懂的话，各位只要去死就好了……",
  "0101Adv24_Warden013": "搜查期限到魔女审判开庭广播为止。<br>\n只要我还没下班，视乎我的心情，也会回答各位的提问……<br>\n或许吧。",
  "0101Adv24_Narrative009": "典狱长结束了自说自话后<br>\n便离开了。",
  "0101Adv24_Narrative010": "必须要在审判中选一个人去死。<br>\n艾玛感到自己全身手脚冰凉。",
  "0101Adv24_Ema005": "（如果不能在今天之内找到凶手，就要全体处死……？<br>\n　时间也太不够用了！）",
  "0101Adv24_Ema006": "（而且，我不愿意相信<br>\n　我们之中竟有人行凶杀人！）",
  "0101Adv24_Ema007": "（可是，诺亚确实是被人杀死的……<br>\n　太过分了……无法原谅……）",
  "0101Adv24_Narrative011": "会客厅充斥着一股尴尬的沉默。",
  "0101Adv24_Narrative012": "像是在猜测他人的想法一样，<br>\n每个人的视线都游离不定。",
  "0101Adv24_Narrative013": "少女们度过的共同生活仅仅数日。",
  "0101Adv24_Narrative014": "正如玛格所说，<br>\n大家对彼此都不甚熟悉。",
  "0101Adv24_Narrative015": "要在这种情况下互相信任，<br>\n真的是非常，非常困难。",
  "0101Adv24_Narrative016": "之后，蕾雅站在室内正中心。<br>\n所有人的目光集中在她身上。",
  "0101Adv24_Leia001": "发生这样的事，我真的很难受……<br>\n但，我想要找出凶手。",
  "0101Adv24_Margo001": "我同意。<br>\n我也不想蒙冤被判死刑。",
  "0101Adv24_Margo002": "这起凶杀案的凶手，<br>\n应当以【魔女】的身份老实接受惩罚。",
  "0101Adv24_Leia002": "嗯，我相信大家都是这个想法。<br>\n没多少时间了，我们分头去搜查吧。",
  "0101Adv24_Narrative017": "蕾雅和玛格二人<br>\n正准备离开。",
  "0101Adv24_Narrative018": "艾玛慌张了起来。",
  "0101Adv24_Ema008": "等、等一下，蕾雅！<br>\n只要知道谁是凶手，就要把她送上处刑台吗！？",
  "0101Adv24_Narrative019": "蕾雅从艾玛身边走过。<br>\n她的脸因难受扭作一团。",
  "0101Adv24_Leia003": "这是为了帮助大家。<br>\n而且我心里已经有了可疑人选。",
  "0101Adv24_Ema009": "欸……！？",
  "0101Adv24_Narrative020": "听到蕾雅的话后，<br>\n艾玛惊得呆住了。",
  "0101Adv24_Narrative021": "此时蕾雅的眼神，<br>\n指向了汉娜。",
  "0101Adv24_Leia004": "远野汉娜。<br>\n——你就是杀害了城崎诺亚的凶手，对不对？",
  "0101Adv24_Hanna001": "什么……",
  "0101Adv24_Leia005": "虽然我还没仔细调查，<br>\n但是现场没有留下足迹。",
  "0101Adv24_Leia006": "也就是说……只有拥有飘浮魔法的人<br>\n才有办法作案，我没说错吧？",
  "0101Adv24_Ema010": "汉娜她不可能是凶手！",
  "0101Adv24_Leia007": "……你如果是这么想的话，就去搜查吧。<br>\n我今晚会让一切水落石出。",
  "0101Adv24_Narrative022": "蕾雅一脸阴沉地走出了会客厅。",
  "0101Adv24_Ema011": "（因为想帮助大家，她必须要选某个人做魔女……<br>\n　所以蕾雅她也变得相当冷酷……）",
  "0101Adv24_Ema012": "（虽然我懂她的想法，可是，我怎么可以怀疑汉娜！）",
  "0101Adv24_Narrative023": "可可、奈叶香、亚里沙三人<br>\n也各自走出了会客厅。",
  "0101Adv24_Narrative024": "安安坐在沙发上，梅露露一脸担心地<br>\n坐在她的身旁。",
  "0101Adv24_Meruru002": "那，我就带安安小姐去医务室了。<br>\n以安安小姐现在的情况，她根本没法参加搜查……",
  "0101Adv24_Narrative025": "安安是第一个发现诺亚的尸体的人。<br>\n事情造成的冲击太大，她现在脸色煞白，身体还在不断颤抖着。",
  "0101Adv24_Ema013": "是啊……希望你可以好好照顾她。",
  "0101Adv24_Narrative026": "梅露露搀扶着安安走出去了。",
  "0101Adv24_Narrative027": "留在原地的只剩<br>\n艾玛、雪莉和汉娜三人。",
  "0101Adv24_Narrative028": "汉娜正低头咬着嘴唇。<br>\n她似乎相当难受，两只眼睛都是湿乎乎的。",
  "0101Adv24_Ema014": "汉娜……",
  "0101Adv24_Sherry003": "是时候该侦探出马了！<br>\n我们一起去找到真凶，洗刷汉娜的冤屈吧！",
  "0101Adv24_Narrative029": "雪莉充满干劲地说道。<br>\n艾玛受到感染，表情也变得缓和些了。",
  "0101Adv24_Ema015": "对、对啊，汉娜才不是凶手。<br>\n绝对不能让她被处刑！",
  "0101Adv24_Ema016": "就靠我们找出真凶吧！",
  "0101Adv24_Hanna002": "……说得对，一定要找到凶手。",
  "0101Adv24_Narrative030": "几乎要哭出来的汉娜，<br>\n也终于抬起了头。",
  "0101Adv24_Narrative031": "艾玛她们乘着这股气势，<br>\n开始参与城崎诺亚遇害一案的搜查。"
}
}
