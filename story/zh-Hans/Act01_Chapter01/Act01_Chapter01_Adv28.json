    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_2"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "会客厅里有一个地方，<br>\n令艾玛非常非常地在意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative001"]}},
    {"op": "ResetText", "line": 26, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 27, "indent": 0, "params": {"Offset": [8.0, 0.0], "Zoom": 0.6000000238418579, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 28, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（挂在墙壁上的弩枪被人偷走了……<br>\n　究竟是谁，在什么时候偷走的……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Ema001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "艾玛站在会客厅的墙壁前<br>\n思索着这个问题。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "这时，奈叶香进来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative003"]}},
    {"op": "ResetText", "line": 36, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 37, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 38, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "啊，奈叶香你好。<br>\n你也在调查案件吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Sherry001"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "……你管我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka001"]}},
    {"op": "HideAllCharacters", "line": 46, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "听到奈叶香冷淡的回应，<br>\n汉娜有些生气地鼓起了嘴。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "什么叫“你管我”，<br>\n现在可是死了人欸？你这是什么态度。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Hanna001"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "…………", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka002"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "奈叶香并未投去冰冷的眼神，<br>\n可是汉娜却不禁后退了一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "明明没有她身上感受到压迫感，明明没有感觉她可怕，<br>\n可汉娜却感觉有些后悔跟她讲话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative006"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "那是一种不可言说的感觉，<br>\n就好像一旦触碰，就会吸入其中无法挣脱的，深渊般的感觉——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative007"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "尽管在奈叶香身上感受到了这种感觉，<br>\n可艾玛还是下定了决心，发起提问。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "奈叶香，我有事问你，<br>\n你之前说有人偷了会客厅的弩枪，对吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Ema002"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "那又怎么了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "艾玛被她用充满疑心的阴暗眼神盯着，<br>\n不禁吞了吞口水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "因为我看你一直很关心弩枪的问题。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Ema003"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "为了在这座监牢保命，武器是必需的。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "弩枪摆在那么明显的地方，<br>\n我想大家肯定都多少在意过这事。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka005"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "话讲完了？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka006"]}},
    {"op": "HideAllCharacters", "line": 88, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "奈叶香正打算离开，<br>\n而雪莉这时却拦住她的去路。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "还有一件事要问你！<br>\n——你的魔法是什么？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Sherry002"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "……没必要告诉你。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka007"]}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "别这样说嘛！<br>\n我超在意大家会用什么魔法的～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 103, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "不管雪莉怎样恳求，奈叶香都不愿意回答，<br>\n打算径直离开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "奈叶香你也太可疑了，还一直当一匹孤狼。<br>\n最坏的情况下，你会被别人当做【魔女】哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Sherry004"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "雪莉脸上保持着微笑，<br>\n嘴上却说出了吓人的话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative012"]}},
    {"op": "HideAllCharacters", "line": 113, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "雪、雪莉！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Ema004"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "奈叶香止住了脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative013"]}},
    {"op": "HideAllCharacters", "line": 120, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "当成魔女又怎样，随便你们。<br>\n——反正最后大家都会死。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Nanoka008"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "（欸……？<br>\n　那是什么意思……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Ema005"]}},
    {"op": "HideAllCharacters", "line": 127, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "艾玛转过头来，但已不见奈叶香的身影，<br>\n就好像刚刚的一切都是幻觉似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv28_Narrative014"]}},
    {"op": "Gosub", "line": 136, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 138, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv25", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv28_Narrative001": "会客厅里有一个地方，<br>\n令艾玛非常非常地在意。",
  "0101Adv28_Ema001": "（挂在墙壁上的弩枪被人偷走了……<br>\n　究竟是谁，在什么时候偷走的……？）",
  "0101Adv28_Narrative002": "艾玛站在会客厅的墙壁前<br>\n思索着这个问题。",
  "0101Adv28_Narrative003": "这时，奈叶香进来了。",
  "0101Adv28_Sherry001": "啊，奈叶香你好。<br>\n你也在调查案件吗？",
  "0101Adv28_Nanoka001": "……你管我。",
  "0101Adv28_Narrative004": "听到奈叶香冷淡的回应，<br>\n汉娜有些生气地鼓起了嘴。",
  "0101Adv28_Hanna001": "什么叫“你管我”，<br>\n现在可是死了人欸？你这是什么态度。",
  "0101Adv28_Nanoka002": "…………",
  "0101Adv28_Narrative005": "奈叶香并未投去冰冷的眼神，<br>\n可是汉娜却不禁后退了一步。",
  "0101Adv28_Narrative006": "明明没有她身上感受到压迫感，明明没有感觉她可怕，<br>\n可汉娜却感觉有些后悔跟她讲话。",
  "0101Adv28_Narrative007": "那是一种不可言说的感觉，<br>\n就好像一旦触碰，就会吸入其中无法挣脱的，深渊般的感觉——",
  "0101Adv28_Narrative008": "尽管在奈叶香身上感受到了这种感觉，<br>\n可艾玛还是下定了决心，发起提问。",
  "0101Adv28_Ema002": "奈叶香，我有事问你，<br>\n你之前说有人偷了会客厅的弩枪，对吗？",
  "0101Adv28_Nanoka003": "那又怎么了。",
  "0101Adv28_Narrative009": "艾玛被她用充满疑心的阴暗眼神盯着，<br>\n不禁吞了吞口水。",
  "0101Adv28_Ema003": "因为我看你一直很关心弩枪的问题。",
  "0101Adv28_Nanoka004": "为了在这座监牢保命，武器是必需的。",
  "0101Adv28_Nanoka005": "弩枪摆在那么明显的地方，<br>\n我想大家肯定都多少在意过这事。",
  "0101Adv28_Nanoka006": "话讲完了？",
  "0101Adv28_Narrative010": "奈叶香正打算离开，<br>\n而雪莉这时却拦住她的去路。",
  "0101Adv28_Sherry002": "还有一件事要问你！<br>\n——你的魔法是什么？",
  "0101Adv28_Nanoka007": "……没必要告诉你。",
  "0101Adv28_Sherry003": "别这样说嘛！<br>\n我超在意大家会用什么魔法的～！",
  "0101Adv28_Narrative011": "不管雪莉怎样恳求，奈叶香都不愿意回答，<br>\n打算径直离开。",
  "0101Adv28_Sherry004": "奈叶香你也太可疑了，还一直当一匹孤狼。<br>\n最坏的情况下，你会被别人当做【魔女】哦？",
  "0101Adv28_Narrative012": "雪莉脸上保持着微笑，<br>\n嘴上却说出了吓人的话。",
  "0101Adv28_Ema004": "雪、雪莉！？",
  "0101Adv28_Narrative013": "奈叶香止住了脚步。",
  "0101Adv28_Nanoka008": "当成魔女又怎样，随便你们。<br>\n——反正最后大家都会死。",
  "0101Adv28_Ema005": "（欸……？<br>\n　那是什么意思……？）",
  "0101Adv28_Narrative014": "艾玛转过头来，但已不见奈叶香的身影，<br>\n就好像刚刚的一切都是幻觉似的。"
}
}
