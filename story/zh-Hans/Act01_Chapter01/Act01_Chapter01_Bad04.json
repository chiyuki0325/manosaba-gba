    {"op": "ModifyBackgroundExtended", "line": 122, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [-20.0, 16.0], "AppearanceAndTransition": "21_1", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [20.0, 32.0], "IdAndAppearance": "Hanna.Pensive1,ArmR2,ArmL2", "SubId": "Front"}},
