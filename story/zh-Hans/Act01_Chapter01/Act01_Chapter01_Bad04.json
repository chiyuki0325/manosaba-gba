    {"op": "AnimateActorExtended", "line": 126, "indent": 0, "params": {"ActorIds": ["Hanna-Front"], "Loop": 0, "ScenePositionY": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 127, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema008"]}},
    {"op": "PlaySfxModified", "line": 131, "indent": 0, "params": {"SfxPath": "Sfx_184", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "呜！不要再打我了！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Hanna004"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "室内呈现的景象，<br>\n跟艾玛的想像有少许出入。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "看守手里的是……尺子？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema009"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "汉娜被绑在十字架上，<br>\n但用来敲打她的并不是拷问工具，而是尺子。<br>\n就好像老师或者父母责罚小朋友一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative012"]}},
    {"op": "HidePrinter", "line": 143, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 144, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Hanna-Front"], "Loop": 0}},
    {"op": "WaitForNextFrame", "line": 145, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 146, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "44", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 147, "indent": 0, "params": {"ActorIds": ["Hanna-Front"], "Loop": 0, "ScenePositionY": "48", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "HideActors", "line": 148, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Hanna-Front"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 149, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "看守举起尺子，敲打汉娜的脸颊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative013"]}},
    {"op": "PlaySfxModified", "line": 155, "indent": 0, "params": {"SfxPath": "Sfx_184", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 156, "indent": 0, "params": {}},
    {"op": "Wait", "line": 157, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR4"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "艾玛，我们去救汉娜吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry004"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "可、可是，我们要怎么救……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "就是这么做！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 170, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 171, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PlayBgm", "line": 173, "indent": 0, "params": {"BgmPath": "Bgm_12_1_Loop", "IntroBgmPath": "Bgm_12_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "欸，等一下雪莉！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema011"]}},
    {"op": "PlaySfxModified", "line": 179, "indent": 0, "params": {"SfxPath": "Sfx_185", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "雪莉握紧拳头，<br>\n狠狠往惩罚室的门上砸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative014"]}},
    {"op": "ResetText", "line": 184, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 185, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "21_1"}},
    {"op": "ModifyBackgroundExtended", "line": 187, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 190, "indent": 0, "params": {"SfxPath": "Sfx_61", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HidePrinter", "line": 192, "indent": 0, "params": {}},
