    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "18_1"}},
