    {"op": "AnimateActorExtended", "line": 198, "indent": 0, "params": {"ActorIds": ["Hanna-Front"], "Loop": 0, "ScenePositionY": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "Wait", "line": 199, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "怎、怎么回事！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Hanna005"]}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "汉娜，我们来救你了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry006"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "面对破门而入的雪莉，<br>\n汉娜哑口无言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "等、等一下雪莉！<br>\n不可以啊，要是抵抗看守的话……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema012"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "——会跟希罗一样被杀的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative016"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "对啊！我没事的，<br>\n你别做傻事啊！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Hanna006"]}},
    {"op": "HidePrinter", "line": 217, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 218, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Hanna-Front"], "Loop": 0}},
    {"op": "WaitForNextFrame", "line": 219, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 220, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionY": "44", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "AnimateActorExtended", "line": 221, "indent": 0, "params": {"ActorIds": ["Hanna-Front"], "Loop": 0, "ScenePositionY": "48", "EasingTypeName": "EaseOutQuad", "Duration": "0.5"}},
    {"op": "HideActors", "line": 222, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Hanna-Front"], "Lazy": 0}},
    {"op": "DestroySpawnedExtended", "line": 223, "indent": 0, "params": {"Path": "MaskingRectangle", "SubId": "Front", "LogWarning": 1}},
    {"op": "HideAllCharacters", "line": 225, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 226, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "不不，不试试怎么知道呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry007"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "雪莉往前踏出一步，<br>\n靠近看守。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative017"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "只要使出百分之二百的真本事，<br>\n说不定就能轻松杀死它哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "而且这里还有好多的武器！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry009"]}},
    {"op": "HideAllCharacters", "line": 239, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "雪莉拿起近处的金属棒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Jailer"}},
    {"op": "AnimateActorExtended", "line": 244, "indent": 0, "params": {"ActorIds": ["Jailer"], "Loop": 0, "ScenePositionX": "15", "ScenePositionY": "8", "Scale": "1.4"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "看守察觉到了雪莉抵抗的想法，<br>\n于是朝她挥下镰刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 248, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Surprised1,ArmR8"}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry010"]}},
    {"op": "HideAllCharacters", "line": 253, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 254, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "雪莉躲开镰刀的攻势，<br>\n并用铁棒击打看守。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 258, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 259, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Angry1,ArmR8"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "唔啊啊啊啊啊啊！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry011"]}},
    {"op": "PlaySfxModified", "line": 264, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 266, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "看守往后一仰，<br>\n雪莉毫不留情发出追击。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "艾玛！趁现在，<br>\n快给汉娜松绑，带她逃跑！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry012"]}},
    {"op": "HideAllCharacters", "line": 274, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 275, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "欸、欸欸欸！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema013"]}},
    {"op": "HideAllCharacters", "line": 279, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "动作快！<br>\n我不知道我能坚持多久！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry013"]}},
    {"op": "HideAllCharacters", "line": 284, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "我、我知道了……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema014"]}},
    {"op": "HideAllCharacters", "line": 289, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "艾玛飞奔向十字架，<br>\n为汉娜松绑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 293, "indent": 0, "params": {"Scale": [1.399999976158142], "Lazy": 0, "ScenePosition": [50.0, 8.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "不管雪莉用怪力如何殴打，<br>\n看守都没有濒死的迹象。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative023"]}},
    {"op": "HideAllCharacters", "line": 297, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 300, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 302, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Surprised1,ArmR8"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "哇哟！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry014"]}},
    {"op": "HideAllCharacters", "line": 306, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "不仅不死，<br>\n还以可怕的速度挥出反击的镰刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative024"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "雪莉用铁棒瞬间招架住了攻击，<br>\n但铁棒直接断成了两截。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 312, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "那，我就用这个……！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry015"]}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "武器要多少有多少。<br>\n雪莉握住似乎是用来处刑的剑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative026"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "呀啊啊啊啊！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry016"]}},
    {"op": "HideAllCharacters", "line": 320, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "雪莉手持利剑，向看守发起冲锋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative027"]}},
    {"op": "StopBgm", "line": 324, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 327, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 329, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "咕……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema015"]}},
    {"op": "PrintTextModified", "line": 337, "indent": 0, "params": {"Text": "啊……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Hanna007"]}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "……哎呀？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry017"]}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "但雪莉的剑贯穿的，并不是看守。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative028"]}},
    {"op": "PlayBgm", "line": 343, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 345, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "21_1"}},
    {"op": "ModifyBackgroundExtended", "line": 346, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 347, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "而是艾玛和汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative029"]}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "在看守的身后，<br>\n艾玛正在十字架处为汉娜松绑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative030"]}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "而看守躲开了雪莉的冲锋，<br>\n自然剑就刺中了她们两个。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 355, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR19,ArmL14", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 357, "indent": 0, "params": {"Text": "……哎呀，失败了呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry018"]}},
    {"op": "PrintTextModified", "line": 359, "indent": 0, "params": {"Text": "我还以为能救到的。<br>\n可是……结果还是搞砸了呢。<br>\n艾玛、汉娜，对不起。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry019"]}},
    {"op": "ModifyCharacterExtended", "line": 361, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [40.0, 50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 363, "indent": 0, "params": {"Text": "雪莉呆呆地说道。在她背后，<br>\n看守举起了镰刀——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative032"]}},
    {"op": "HideAllCharacters", "line": 365, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 368, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 370, "indent": 0, "params": {"TintColor": "#ff0000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 371, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ProcessBadEnd", "line": 377, "indent": 0, "params": {"Number": 4}}
  ],
  "translations": {
  "0101Bad04_Ema001": "往刚刚见到的招待所方向逃吧！",
  "0101Bad04_Sherry001": "我知道了！我们可以藏建筑物里面，<br>\n躲一阵子等它们走开，对不对！",
  "0101Bad04_Narrative001": "但艾玛她们的想法过于单纯了。",
  "0101Bad04_Narrative002": "在逃跑方向上，看守正拦在路中间等着她们。",
  "0101Bad04_Hanna001": "怎会这样！？",
  "0101Bad04_Narrative003": "三人一下子就被看守抓住了。<br>\n然后——",
  "0101Bad04_Narrative004": "只有汉娜被送进了惩罚室。",
  "0101Bad04_Ema002": "为什么！？为什么只有汉娜进去了……！",
  "0101Bad04_Sherry002": "就是啊！<br>\n明明想要弄坏墙壁的是我……",
  "0101Bad04_Ema003": "（记得那里有十字架之类的拷问工具……）",
  "0101Bad04_Narrative005": "艾玛回想起亚里沙被抓的情形，<br>\n不禁浑身颤抖。",
  "0101Bad04_Ema004": "她肯定会被惩罚……",
  "0101Bad04_Narrative006": "门上有个小窗，<br>\n能看到室内的状况。",
  "0101Bad04_Ema005": "（怎么办……我不敢看里面。<br>\n　要是汉娜遭了严刑的话……）",
  "0101Bad04_Sherry003": "…………",
  "0101Bad04_Narrative007": "艾玛和雪莉两人都下不了决心，<br>\n只能呆站在门前一动不动。",
  "0101Bad04_Ema006": "噫……！什、什么情况……！？",
  "0101Bad04_Narrative008": "艾玛听见门后传来令人不安的声音，<br>\n不由得往雪莉身上倚靠。",
  "0101Bad04_Hanna002": "呀！你、你干什么！？",
  "0101Bad04_Narrative009": "能听见里面传来用什么东西敲打的声音<br>\n还有汉娜的声音。",
  "0101Bad04_Hanna003": "好痛！住手呀！？",
  "0101Bad04_Ema007": "汉娜她没事吧！？",
  "0101Bad04_Narrative010": "艾玛和雪莉从小窗看向室内。",
  "0101Bad04_Ema008": "……！？",
  "0101Bad04_Hanna004": "呜！不要再打我了！？",
  "0101Bad04_Narrative011": "室内呈现的景象，<br>\n跟艾玛的想像有少许出入。",
  "0101Bad04_Ema009": "看守手里的是……尺子？",
  "0101Bad04_Narrative012": "汉娜被绑在十字架上，<br>\n但用来敲打她的并不是拷问工具，而是尺子。<br>\n就好像老师或者父母责罚小朋友一样。",
  "0101Bad04_Narrative013": "看守举起尺子，敲打汉娜的脸颊。",
  "0101Bad04_Sherry004": "艾玛，我们去救汉娜吧。",
  "0101Bad04_Ema010": "可、可是，我们要怎么救……",
  "0101Bad04_Sherry005": "就是这么做！",
  "0101Bad04_Ema011": "欸，等一下雪莉！？",
  "0101Bad04_Narrative014": "雪莉握紧拳头，<br>\n狠狠往惩罚室的门上砸。",
  "0101Bad04_Hanna005": "怎、怎么回事！？",
  "0101Bad04_Sherry006": "汉娜，我们来救你了！",
  "0101Bad04_Narrative015": "面对破门而入的雪莉，<br>\n汉娜哑口无言。",
  "0101Bad04_Ema012": "等、等一下雪莉！<br>\n不可以啊，要是抵抗看守的话……！",
  "0101Bad04_Narrative016": "——会跟希罗一样被杀的。",
  "0101Bad04_Hanna006": "对啊！我没事的，<br>\n你别做傻事啊！",
  "0101Bad04_Sherry007": "不不，不试试怎么知道呢？",
  "0101Bad04_Narrative017": "雪莉往前踏出一步，<br>\n靠近看守。",
  "0101Bad04_Sherry008": "只要使出百分之二百的真本事，<br>\n说不定就能轻松杀死它哦？",
  "0101Bad04_Sherry009": "而且这里还有好多的武器！",
  "0101Bad04_Narrative018": "雪莉拿起近处的金属棒。",
  "0101Bad04_Narrative019": "看守察觉到了雪莉抵抗的想法，<br>\n于是朝她挥下镰刀。",
  "0101Bad04_Sherry010": "！",
  "0101Bad04_Narrative020": "雪莉躲开镰刀的攻势，<br>\n并用铁棒击打看守。",
  "0101Bad04_Sherry011": "唔啊啊啊啊啊啊！",
  "0101Bad04_Narrative021": "看守往后一仰，<br>\n雪莉毫不留情发出追击。",
  "0101Bad04_Sherry012": "艾玛！趁现在，<br>\n快给汉娜松绑，带她逃跑！",
  "0101Bad04_Ema013": "欸、欸欸欸！？",
  "0101Bad04_Sherry013": "动作快！<br>\n我不知道我能坚持多久！",
  "0101Bad04_Ema014": "我、我知道了……！",
  "0101Bad04_Narrative022": "艾玛飞奔向十字架，<br>\n为汉娜松绑。",
  "0101Bad04_Narrative023": "不管雪莉用怪力如何殴打，<br>\n看守都没有濒死的迹象。",
  "0101Bad04_Sherry014": "哇哟！",
  "0101Bad04_Narrative024": "不仅不死，<br>\n还以可怕的速度挥出反击的镰刀。",
  "0101Bad04_Narrative025": "雪莉用铁棒瞬间招架住了攻击，<br>\n但铁棒直接断成了两截。",
  "0101Bad04_Sherry015": "那，我就用这个……！",
  "0101Bad04_Narrative026": "武器要多少有多少。<br>\n雪莉握住似乎是用来处刑的剑。",
  "0101Bad04_Sherry016": "呀啊啊啊啊！",
  "0101Bad04_Narrative027": "雪莉手持利剑，向看守发起冲锋。",
  "0101Bad04_Ema015": "咕……",
  "0101Bad04_Hanna007": "啊……",
  "0101Bad04_Sherry017": "……哎呀？",
  "0101Bad04_Narrative028": "但雪莉的剑贯穿的，并不是看守。",
  "0101Bad04_Narrative029": "而是艾玛和汉娜。",
  "0101Bad04_Narrative030": "在看守的身后，<br>\n艾玛正在十字架处为汉娜松绑。",
  "0101Bad04_Narrative031": "而看守躲开了雪莉的冲锋，<br>\n自然剑就刺中了她们两个。",
  "0101Bad04_Sherry018": "……哎呀，失败了呢。",
  "0101Bad04_Sherry019": "我还以为能救到的。<br>\n可是……结果还是搞砸了呢。<br>\n艾玛、汉娜，对不起。",
  "0101Bad04_Narrative032": "雪莉呆呆地说道。在她背后，<br>\n看守举起了镰刀——"
