    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "往刚刚见到的招待所方向逃吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema001"]}},
    {"op": "HideAllCharacters", "line": 22, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "我知道了！我们可以藏建筑物里面，<br>\n躲一阵子等它们走开，对不对！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 27, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 28, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 29, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "22_1"}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "但艾玛她们的想法过于单纯了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative001"]}},
    {"op": "Wait", "line": 34, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 35, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "在逃跑方向上，看守正拦在路中间等着她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative002"]}},
    {"op": "HideAllCharacters", "line": 39, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "怎会这样！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 45, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "三人一下子就被看守抓住了。<br>\n然后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative003"]}},
    {"op": "ResetText", "line": 49, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 50, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 52, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "3_2"}},
    {"op": "Wait", "line": 53, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 54, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 57, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 59, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "只有汉娜被送进了惩罚室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1,ArmR4"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "为什么！？为什么只有汉娜进去了……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema002"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "就是啊！<br>\n明明想要弄坏墙壁的是我……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry002"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "（记得那里有十字架之类的拷问工具……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema003"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "艾玛回想起亚里沙被抓的情形，<br>\n不禁浑身颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative005"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "她肯定会被惩罚……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema004"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "门上有个小窗，<br>\n能看到室内的状况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative006"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "（怎么办……我不敢看里面。<br>\n　要是汉娜遭了严刑的话……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema005"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "…………", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Sherry003"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "艾玛和雪莉两人都下不了决心，<br>\n只能呆站在门前一动不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 85, "indent": 0, "params": {"SfxPath": "Sfx_183", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Surprised1,ArmR4"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "噫……！什、什么情况……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema006"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "艾玛听见门后传来令人不安的声音，<br>\n不由得往雪莉身上倚靠。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 95, "indent": 0, "params": {"SfxPath": "Sfx_183", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "呀！你、你干什么！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Hanna002"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "能听见里面传来用什么东西敲打的声音<br>\n还有汉娜的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative009"]}},
    {"op": "PlaySfxModified", "line": 103, "indent": 0, "params": {"SfxPath": "Sfx_183", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "好痛！住手呀！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Hanna003"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "汉娜她没事吧！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Ema007"]}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "艾玛和雪莉从小窗看向室内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Bad04_Narrative010"]}},
    {"op": "HidePrinter", "line": 120, "indent": 0, "params": {}},
