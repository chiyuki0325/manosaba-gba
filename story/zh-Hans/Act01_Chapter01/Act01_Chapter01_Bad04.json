    {"op": "ModifyBackgroundExtended", "line": 194, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.7999999523162842], "Lazy": 0, "ScenePosition": [-20.0, 16.0], "AppearanceAndTransition": "21_1", "SubId": "Front"}},
