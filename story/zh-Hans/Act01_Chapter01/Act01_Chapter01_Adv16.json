  "path": "Act01_Chapter01/Act01_Chapter01_Adv16",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-12", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyBackgroundExtended", "line": 12, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 13, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "从那以后，过去了一整天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative001"]}},
    {"op": "PlayBgm", "line": 21, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "囚犯少女们遵照规定行动，<br>\n各自以自己喜好的方式度过一天的日常。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "然后，她们逐渐地<br>\n开始习惯这座监牢内的生活。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative003"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "今天也一样——到了晚餐时间，<br>\n少女们陆陆续续来到了食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "（今天又没看到诺亚她……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Ema001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "诺亚好像完全没来过用餐。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative005"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "感到担心的艾玛好几次邀她吃饭，<br>\n可是她一门心思在画画上，根本不打算走出房门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Scale": [0.800000011920929], "Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "不过安安倒是会来用餐。<br>\n虽然她脸色还是不太好，但看起来渐渐有好转。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "艾玛轻叹一口气，<br>\n开始和雪莉、汉娜和梅露露她们一起用餐。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "难吃。难吃死了……！该死的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Hanna001"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "虽然汉娜嘴上在抱怨，但还是一勺勺往嘴里送饭菜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative009"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "这里的饭菜不管是外观还是味道都十分差劲，令人食欲大减，<br>\n可艾玛也还是吃了下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative010"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "（为了逃出这个地方，我要保存好体力）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Ema002"]}},
    {"op": "HideAllCharacters", "line": 57, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "这时，在不远处的另一桌，<br>\n传来了吵闹的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative011"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "是真的！我从她本人嘴里听说的！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Coco001"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "她说她就是那个有名的艺术家【气球】！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Coco002"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "（“气球”……是说诺亚？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "哦？看来这个话题在她们那一组也很火热耶。<br>\n说到“气球”，那真是无人不知无人不晓啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Sherry001"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "气球……？什么气球……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Meruru001"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "看样子，梅露露并不知道这事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative012"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "（哎，虽然我一开始也不知道啦……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "这时，汉娜却露出一脸震惊，<br>\n连手里的汤匙也吓掉了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative013"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "“气球”被抓到这里了？怎么可能……！<br>\n究竟是谁哇！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "是城崎诺亚哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 91, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "哈啊！？假的吧！？<br>\n说到【气球】，<br>\n网络上可是一天都没少过他的话题欸！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Hanna003"]}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "他的画会忽然间出现在某个地方，但从未有人看见过他<br>\n作画的样子……其真实身份充满谜团……而那充满艺术的绘画<br>\n令年轻族群为主的多数人为之倾倒……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "而她居然就是那个世界有名的艺术家！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Hanna005"]}},
    {"op": "HideAllCharacters", "line": 104, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "谢谢你的热心说明。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 109, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "在这个热衷于谈论诺亚轶事的食堂之中——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative014"]}},
    {"op": "PlaySfxModified", "line": 121, "indent": 0, "params": {"SfxPath": "Sfx_20", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "StopBgm", "line": 122, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "忽然间，有人把餐盘摔在地上，<br>\n发出巨大的声响。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative015"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "全场的气氛凝固了，<br>\n生出一片寂静。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "慢悠悠站起身的，<br>\n是在远处独自用餐的亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative017"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "终于被放出惩罚室的她，<br>\n神情明显比其他少女更加憔悴。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative018"]}},
    {"op": "PlayBgm", "line": 138, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "你们吵死了。<br>\n老是聊别人的八卦……！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Alisa001"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "害我不爽的家伙，<br>\n我要把你们全杀光！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "她尖锐的眼神扫向在场的所有少女。<br>\n在这股压迫感之下，艾玛不禁吞了吞口水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative019"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "（她说要全杀光……<br>\n　难道是出现了魔女的杀人冲动……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "我可不能当没听到这句话。<br>\n亚里沙，你是不是已经受到危险想法的控制了？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1,ArmR5,ArmL2"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "我想你肯定遇到了一些难受的事，<br>\n只要你愿意，我可以听你倾诉。<br>\n有什么烦恼的话，我希望你可以说出口来。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Leia002"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "蕾雅站起来，用平静的语气向她说道。<br>\n亚里沙咂了咂舌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 160, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "模范生给我闭嘴。<br>\n我的事由我自己说了算。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Alisa003"]}},
    {"op": "HideAllCharacters", "line": 165, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "丢下这句话后，亚里沙离开了食堂。<br>\n这之后的用餐环境十分安静，没再吵闹过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "（难道亚里沙她真的……不，不可能有的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Ema006"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "她看见，汉娜拿着汤匙的手<br>\n不断地在发抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Narrative022"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "（大家都很害怕……害怕有人会做出什么不好的事）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv16_Ema007"]}},
    {"op": "Gosub", "line": 181, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 183, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv17", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv16_Narrative001": "从那以后，过去了一整天。",
  "0101Adv16_Narrative002": "囚犯少女们遵照规定行动，<br>\n各自以自己喜好的方式度过一天的日常。",
  "0101Adv16_Narrative003": "然后，她们逐渐地<br>\n开始习惯这座监牢内的生活。",
  "0101Adv16_Narrative004": "今天也一样——到了晚餐时间，<br>\n少女们陆陆续续来到了食堂。",
  "0101Adv16_Ema001": "（今天又没看到诺亚她……）",
  "0101Adv16_Narrative005": "诺亚好像完全没来过用餐。",
  "0101Adv16_Narrative006": "感到担心的艾玛好几次邀她吃饭，<br>\n可是她一门心思在画画上，根本不打算走出房门。",
  "0101Adv16_Narrative007": "不过安安倒是会来用餐。<br>\n虽然她脸色还是不太好，但看起来渐渐有好转。",
  "0101Adv16_Narrative008": "艾玛轻叹一口气，<br>\n开始和雪莉、汉娜和梅露露她们一起用餐。",
  "0101Adv16_Hanna001": "难吃。难吃死了……！该死的。",
  "0101Adv16_Narrative009": "虽然汉娜嘴上在抱怨，但还是一勺勺往嘴里送饭菜。",
  "0101Adv16_Narrative010": "这里的饭菜不管是外观还是味道都十分差劲，令人食欲大减，<br>\n可艾玛也还是吃了下去。",
  "0101Adv16_Ema002": "（为了逃出这个地方，我要保存好体力）",
  "0101Adv16_Narrative011": "这时，在不远处的另一桌，<br>\n传来了吵闹的声音。",
  "0101Adv16_Coco001": "是真的！我从她本人嘴里听说的！",
  "0101Adv16_Coco002": "她说她就是那个有名的艺术家【气球】！",
  "0101Adv16_Ema003": "（“气球”……是说诺亚？）",
  "0101Adv16_Sherry001": "哦？看来这个话题在她们那一组也很火热耶。<br>\n说到“气球”，那真是无人不知无人不晓啊。",
  "0101Adv16_Meruru001": "气球……？什么气球……？",
  "0101Adv16_Narrative012": "看样子，梅露露并不知道这事。",
  "0101Adv16_Ema004": "（哎，虽然我一开始也不知道啦……）",
  "0101Adv16_Narrative013": "这时，汉娜却露出一脸震惊，<br>\n连手里的汤匙也吓掉了。",
  "0101Adv16_Hanna002": "“气球”被抓到这里了？怎么可能……！<br>\n究竟是谁哇！？",
  "0101Adv16_Sherry002": "是城崎诺亚哦。",
  "0101Adv16_Hanna003": "哈啊！？假的吧！？<br>\n说到【气球】，<br>\n网络上可是一天都没少过他的话题欸！",
  "0101Adv16_Hanna004": "他的画会忽然间出现在某个地方，但从未有人看见过他<br>\n作画的样子……其真实身份充满谜团……而那充满艺术的绘画<br>\n令年轻族群为主的多数人为之倾倒……",
  "0101Adv16_Hanna005": "而她居然就是那个世界有名的艺术家！",
  "0101Adv16_Sherry003": "谢谢你的热心说明。",
  "0101Adv16_Narrative014": "在这个热衷于谈论诺亚轶事的食堂之中——",
  "0101Adv16_Narrative015": "忽然间，有人把餐盘摔在地上，<br>\n发出巨大的声响。",
  "0101Adv16_Narrative016": "全场的气氛凝固了，<br>\n生出一片寂静。",
  "0101Adv16_Narrative017": "慢悠悠站起身的，<br>\n是在远处独自用餐的亚里沙。",
  "0101Adv16_Narrative018": "终于被放出惩罚室的她，<br>\n神情明显比其他少女更加憔悴。",
  "0101Adv16_Alisa001": "你们吵死了。<br>\n老是聊别人的八卦……！",
  "0101Adv16_Alisa002": "害我不爽的家伙，<br>\n我要把你们全杀光！",
  "0101Adv16_Narrative019": "她尖锐的眼神扫向在场的所有少女。<br>\n在这股压迫感之下，艾玛不禁吞了吞口水。",
  "0101Adv16_Ema005": "（她说要全杀光……<br>\n　难道是出现了魔女的杀人冲动……？）",
  "0101Adv16_Leia001": "我可不能当没听到这句话。<br>\n亚里沙，你是不是已经受到危险想法的控制了？",
  "0101Adv16_Leia002": "我想你肯定遇到了一些难受的事，<br>\n只要你愿意，我可以听你倾诉。<br>\n有什么烦恼的话，我希望你可以说出口来。",
  "0101Adv16_Narrative020": "蕾雅站起来，用平静的语气向她说道。<br>\n亚里沙咂了咂舌。",
  "0101Adv16_Alisa003": "模范生给我闭嘴。<br>\n我的事由我自己说了算。",
  "0101Adv16_Narrative021": "丢下这句话后，亚里沙离开了食堂。<br>\n这之后的用餐环境十分安静，没再吵闹过。",
  "0101Adv16_Ema006": "（难道亚里沙她真的……不，不可能有的……）",
  "0101Adv16_Narrative022": "她看见，汉娜拿着汤匙的手<br>\n不断地在发抖。",
  "0101Adv16_Ema007": "（大家都很害怕……害怕有人会做出什么不好的事）"
}
}
