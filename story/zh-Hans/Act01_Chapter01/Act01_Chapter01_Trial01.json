    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "艾、艾玛小姐……！<br>\n如果有在意的地方，<br>\n请你指出它吧……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Meruru001"]}},
