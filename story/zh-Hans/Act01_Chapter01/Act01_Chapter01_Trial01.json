    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "等一下……！<br>\n那真的是用血画的吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema003"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "说不定……那其实是油漆，或者是什么别的画具呢？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 142, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "不，那就是血！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry006"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 146, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Left"}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR1_1,Eyes1_Pensive_Open1,Mouth1_Normal_Open2"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "……看凝固的特征和气味，<br>\n应该就是血液没错……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Normal1,ArmR1,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 152, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "放在现场的红色颜料<br>\n也没有使用过的痕迹哦？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Normal1,ArmR2,ArmL1"}},
