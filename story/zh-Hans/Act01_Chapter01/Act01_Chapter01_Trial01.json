    {"op": "PrintDebateText", "line": 27, "indent": 0, "params": {"Text": "我找到的证据……<br>\n那就是<br>\n死亡讯息！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0101Trial01_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Normal1,ArmR2,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 30, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 31, "indent": 0, "params": {"Text": "死亡讯息……<br>\n就是所谓的<br>\n【死者在死前留下的话语】？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0101Trial01_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 34, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 35, "indent": 0, "params": {"Text": "……你说<br>\n尸体旁边留下了<br>\n死亡讯息？", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 0.0}, "text_ids": {"Text": ["0101Trial01_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR15,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 38, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 39, "indent": 0, "params": {"Text": "对。<br>\n请大家<br>\n仔细观察尸体……", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": 0.0}, "text_ids": {"Text": ["0101Trial01_Sherry002"]}},
    {"op": "SpawnExtended", "line": 41, "indent": 0, "params": {"Path": "Clue", "Params": ["1-11"]}},
    {"op": "PrintDebateText", "line": 42, "indent": 0, "params": {"Text": "看尸体的下面，<br>\n还有旁边……<br>\n在这些地方都有<link=\"Objection_01_01_01_01\">用血画下</link><br>\n的蝴蝶绘画！", "RevealSpeed": 1.0, "ScenePosition": [65.0, 35.0]}, "text_ids": {"Text": ["0101Trial01_Sherry003"]}},
    {"op": "PrintDebateText", "line": 44, "indent": 0, "params": {"Text": "恐怕那些是<br>\n被害人在临死前<br>\n<link=\"Objection_01_01_01_02\">用手上的笔</link>画下的<br>\n死者寄语……", "RevealSpeed": 1.0, "ScenePosition": [65.0, 35.0]}, "text_ids": {"Text": ["0101Trial01_Sherry004"]}},
    {"op": "DestroySpawnedExtended", "line": 46, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL3"}},
