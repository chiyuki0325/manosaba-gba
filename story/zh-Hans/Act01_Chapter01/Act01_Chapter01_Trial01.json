    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "（不、不至于吧……！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "（好像因为指出的地方不对，<br>\n　大家对我的印象都变差了……！<br>\n　重新再想一遍吧……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema006"]}},
