    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "你说是【用笔画的】……真的是这样吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema007"]}},
