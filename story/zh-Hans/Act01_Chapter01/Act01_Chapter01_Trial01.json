    {"op": "PrintTextModified", "line": 444, "indent": 0, "params": {"Text": "那当然就是，玛格你！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry013"]}},
    {"op": "PlaySfxModified", "line": 447, "indent": 0, "params": {"SfxPath": "Sfx_Common_2", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 449, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Smile1,Angle01/Facial/Eyes>Eyes_Smile_Closed,ArmR1,ArmL4"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 450, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 454, "indent": 0, "params": {"Text": "哎呀呀……我？<br>\n真是有趣的推理♪", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Margo006"]}},
    {"op": "PrintTextModified", "line": 458, "indent": 0, "params": {"Text": "……能告诉我具体是为什么吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Margo007"]}},
    {"op": "ModifyCharacterExtended", "line": 460, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 461, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center", "ZoomLevel": 3}},
    {"op": "PrintTextModified", "line": 463, "indent": 0, "params": {"Text": "（雪莉她充满了自信……！<br>\n　可是，真的是这样吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema024"]}},
    {"op": "ModifyCharacterExtended", "line": 465, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open"}},
    {"op": "PrintTextModified", "line": 466, "indent": 0, "params": {"Text": "（那幅画我好像记得是……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema025"]}},
    {"op": "PlaySfxModified", "line": 469, "indent": 0, "params": {"SfxPath": "Sfx_Common_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 471, "indent": 0, "params": {"Text": "（……嗯？怎么回事？<br>\n　我好像在哪里见过它……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema026"]}},
    {"op": "PlaySfxModified", "line": 474, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 476, "indent": 0, "params": {}},
    {"op": "GosubToSplitPerspectiveStageScreens", "line": 477, "indent": 0, "params": {"Index": 1, "LookCharacterId": "Meruru", "Composition": "Left", "RollDirection": "Right"}},
    {"op": "ModifyCharacterExtended", "line": 479, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Surprised_Open2"}},
    {"op": "PrintTextModified", "line": 480, "indent": 0, "params": {"Text": "……艾玛小姐。<br>\n如果你有什么想确认的，<br>\n请你打开【魔女图鉴】看一下。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 482, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 483, "indent": 0, "params": {"Text": "【魔女图鉴】……<br>\n是手机里面的那个APP吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema027"]}},
    {"op": "ModifyCharacterExtended", "line": 485, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Flushed_Closed1"}},
    {"op": "PrintTextModified", "line": 486, "indent": 0, "params": {"Text": "是的……！<br>\n里面可以看到各种信息，比如案件的资料，<br>\n每个人的资料，还有这个大宅的平面图……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Meruru005"]}},
    {"op": "PrintTextModified", "line": 488, "indent": 0, "params": {"Text": "谢谢你，梅露露……！<br>\n我等下会看的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema028"]}},
    {"op": "ResetText", "line": 490, "indent": 0, "params": {}},
    {"op": "HidePerspectiveStageScreen", "line": 491, "indent": 0, "params": {"Index": 1, "Reset": 1, "Wait": 1}},
    {"op": "PrintTextModified", "line": 493, "indent": 0, "params": {"Text": "（雪莉的发言……<br>\n　和我调查到的情报和资料是否一致呢？<br>\n　现在来比对一下吧……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema029"]}},
    {"op": "GotoModified", "line": 495, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Trial02", "ResetState": ["-"]}}
  ],
  "translations": {
  "0101Trial01_Sherry001": "我找到的证据……<br>\n那就是<br>\n死亡讯息！",
  "0101Trial01_Margo001": "死亡讯息……<br>\n就是所谓的<br>\n【死者在死前留下的话语】？",
  "0101Trial01_Alisa001": "……你说<br>\n尸体旁边留下了<br>\n死亡讯息？",
  "0101Trial01_Sherry002": "对。<br>\n请大家<br>\n仔细观察尸体……",
  "0101Trial01_Sherry003": "看尸体的下面，<br>\n还有旁边……<br>\n在这些地方都有<link=\"Objection_01_01_01_01\">用血画下</link><br>\n的蝴蝶绘画！",
  "0101Trial01_Sherry004": "恐怕那些是<br>\n被害人在临死前<br>\n<link=\"Objection_01_01_01_02\">用手上的笔</link>画下的<br>\n死者寄语……",
  "0101Trial01_Sherry005": "也就是说，<br>\n这是诺亚的<br>\n死亡讯息！",
  "0101Trial01_Ema001": "（刚刚雪莉的发言里……<br>\n　好像出现了令人在意的地方……）",
  "0101Trial01_Meruru001": "艾、艾玛小姐……！<br>\n如果有在意的地方，<br>\n请你指出它吧……！",
  "0101Trial01_Ema002": "……嗯！我明白了！<br>\n我会试试看……！",
  "0101Trial01_Choice001": "画画用的不是血",
  "Common_Return": "返回",
  "0101Trial01_Choice002": "画画用的不是笔",
  "0101Trial01_Ema003": "等一下……！<br>\n那真的是用血画的吗？",
  "0101Trial01_Ema004": "说不定……那其实是油漆，或者是什么别的画具呢？",
  "0101Trial01_Sherry006": "不，那就是血！",
  "0101Trial01_Meruru002": "……看凝固的特征和气味，<br>\n应该就是血液没错……",
  "0101Trial01_Hanna001": "放在现场的红色颜料<br>\n也没有使用过的痕迹哦？",
  "0101Trial01_Margo002": "看来，画画用的应该就是诺亚的血没错。",
  "0101Trial01_Alisa002": "……我说，你连血都没见过吗？<br>\n真是无知兼白痴……",
  "0101Trial01_Ema005": "（不、不至于吧……！？）",
  "0101Trial01_Ema006": "（好像因为指出的地方不对，<br>\n　大家对我的印象都变差了……！<br>\n　重新再想一遍吧……！）",
  "0101Trial01_Ema007": "你说是【用笔画的】……真的是这样吗？",
  "0101Trial01_Sherry007": "这个……确实，就算不是笔也应该可以做到。",
  "0101Trial01_Margo003": "我记得诺亚是擅长喷漆画的艺术家……<br>\n不过你要指出的应该不是这一点吧？",
  "0101Trial01_Ema008": "（诺亚在临死前作画的方法……<br>\n　那就是……！）",
  "0101Trial01_Choice003": "手指",
  "0101Trial01_Choice004": "魔法",
  "0101Trial01_Choice005": "吹气",
  "0101Trial01_Ema009": "诺亚她会不会是<br>\n用手指画画的呢……",
  "0101Trial01_Coco001": "……为什么？<br>\n你这个结论从哪来的？",
  "0101Trial01_Alisa003": "明明有其他方法，<br>\n有必要一定要用手指画吗……？",
  "0101Trial01_Meruru003": "……可、可是她的手指头上面没有沾上血……",
  "0101Trial01_Ema010": "……嗯，我也很想确认看看这件事……",
  "0101Trial01_Coco002": "哈？",
  "0101Trial01_Ema011": "对、对不起……<br>\n没什么……",
  "0101Trial01_Ema012": "（……大家的眼神好冰冷……<br>\n　我得注意不要说奇怪的话……）",
  "0101Trial01_Ema013": "……大家有听说过【滴画法】吗？",
  "0101Trial01_Ema014": "这是一种往颜料上吹气来制作绘画的技巧。",
  "0101Trial01_Miria001": "……那个技巧和现在的情况有什么关系吗……？",
  "0101Trial01_Hanna002": "要画这么大一幅画，岂不是要吹到缺氧憋死！？",
  "0101Trial01_Margo004": "实际上诺亚还真是死掉了哦？",
  "0101Trial01_Alisa004": "这不是开玩笑的时候吧。",
  "0101Trial01_AnAn001": "『请你反省』",
  "0101Trial01_Ema015": "……对不起。",
  "0101Trial01_Ema016": "（还没详细说明，就惹大家生气了……）",
  "0101Trial01_Ema017": "（我得认真思考以后再发言……！）",
  "0101Trial01_Ema018": "……大家知道诺亚的魔法是什么吗？",
  "0101Trial01_Ema019": "我亲耳听她讲……<br>\n她的魔法是【操作液体的魔法】……<br>\n她就是靠这个来画画的。",
  "0101Trial01_Sherry008": "啊……！",
  "0101Trial01_Ema020": "所以我想，蝴蝶绘画<br>\n是用诺亚的魔法<br>\n画出来的。",
  "0101Trial01_Margo005": "……我也觉得，以诺亚的出血量，<br>\n用笔画这么大的画<br>\n并不现实。",
  "0101Trial01_Leia001": "……一般情况下，用自己的血<br>\n画这么大的画，恐怕是不可能的。",
  "0101Trial01_Leia002": "这幅画是诺亚死后经其他人之手<br>\n画下的，这样想才更自然。<br>\n……只不过。",
  "0101Trial01_Leia003": "在这座监牢里面，还有另一种可能性……<br>\n那就是排在物理法则之后的<br>\n叫做【魔法】的第二法则。",
  "0101Trial01_Sherry009": "诺亚在临死前，使用了魔法，<br>\n瞬间就画了这幅画……<br>\n这样想确实说得通！",
  "0101Trial01_Ema021": "（太好了……！<br>\n　成功说服雪莉了……！）",
  "0101Trial01_Sherry010": "……可是这样一来，结论就只有一个了。",
  "0101Trial01_Ema022": "（……欸？）",
  "0101Trial01_Sherry011": "那幅画就是<br>\n诺亚的死亡讯息！<br>\n她想通过这幅画，告诉我们一些事实！",
  "0101Trial01_Ema023": "（欸……！？是这样吗！？）",
  "0101Trial01_Coco003": "……所以呢？如果说那幅画是死亡讯息，<br>\n那凶手究竟是谁？",
  "0101Trial01_Sherry012": "凶手……",
  "0101Trial01_Sherry013": "那当然就是，玛格你！",
  "0101Trial01_Margo006": "哎呀呀……我？<br>\n真是有趣的推理♪",
  "0101Trial01_Margo007": "……能告诉我具体是为什么吗？",
  "0101Trial01_Ema024": "（雪莉她充满了自信……！<br>\n　可是，真的是这样吗……？）",
  "0101Trial01_Ema025": "（那幅画我好像记得是……）",
  "0101Trial01_Ema026": "（……嗯？怎么回事？<br>\n　我好像在哪里见过它……？）",
  "0101Trial01_Meruru004": "……艾玛小姐。<br>\n如果你有什么想确认的，<br>\n请你打开【魔女图鉴】看一下。",
  "0101Trial01_Ema027": "【魔女图鉴】……<br>\n是手机里面的那个APP吗？",
  "0101Trial01_Meruru005": "是的……！<br>\n里面可以看到各种信息，比如案件的资料，<br>\n每个人的资料，还有这个大宅的平面图……！",
  "0101Trial01_Ema028": "谢谢你，梅露露……！<br>\n我等下会看的！",
  "0101Trial01_Ema029": "（雪莉的发言……<br>\n　和我调查到的情报和资料是否一致呢？<br>\n　现在来比对一下吧……！）"
}
}
