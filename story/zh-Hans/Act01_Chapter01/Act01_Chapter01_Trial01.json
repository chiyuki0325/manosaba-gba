    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "这个……确实，就算不是笔也应该可以做到。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry007"]}},
