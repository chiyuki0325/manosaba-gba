    {"op": "PrintDebateText", "line": 49, "indent": 0, "params": {"Text": "也就是说，<br>\n这是诺亚的<br>\n死亡讯息！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0101Trial01_Sherry005"]}},
