    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "（刚刚雪莉的发言里……<br>\n　好像出现了令人在意的地方……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema001"]}},
    {"op": "ResetText", "line": 67, "indent": 0, "params": {}},
