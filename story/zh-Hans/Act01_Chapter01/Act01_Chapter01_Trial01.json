    {"op": "label", "name": "Judge1-1-6", "line": 241, "indent": 0},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 244, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "诺亚她会不会是<br>\n用手指画画的呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema009"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 249, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "……为什么？<br>\n你这个结论从哪来的？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 253, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,ArmR2,ArmL1,Option-ArmL-Off"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 254, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "明明有其他方法，<br>\n有必要一定要用手指画吗……？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Alisa003"]}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 258, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Left"}},
    {"op": "ModifyCharacterExtended", "line": 260, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Normal1,ArmR1_1,Eyes1_Pensive_Open1,Mouth1_Normal_Open2"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "……可、可是她的手指头上面没有沾上血……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 264, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "……嗯，我也很想确认看看这件事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 268, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1,ArmR2,ArmL3,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Gross_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 269, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "哈？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 273, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR6,ArmL6,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 274, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "对、对不起……<br>\n没什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema011"]}},
    {"op": "Damage", "line": 278, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Middle"}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "（……大家的眼神好冰冷……<br>\n　我得注意不要说奇怪的话……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema012"]}},
    {"op": "GotoModified", "line": 283, "indent": 0, "params": {"Path": ".Judge1-1-4"}},
    {"op": "label", "name": "Judge1-1-7", "line": 289, "indent": 0},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR8,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 292, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "……大家有听说过【滴画法】吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema013"]}},
    {"op": "ModifyCharacterExtended", "line": 296, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Middle"}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "这是一种往颜料上吹气来制作绘画的技巧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1,ArmR9,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 301, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Miria", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "……那个技巧和现在的情况有什么关系吗……？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 306, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "要画这么大一幅画，岂不是要吹到缺氧憋死！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 312, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Smile1,ArmR1,ArmL4"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 313, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "实际上诺亚还真是死掉了哦？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Margo004"]}},
    {"op": "ModifyCharacterExtended", "line": 317, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1,ArmR2,ArmL1,Option-ArmL-Off"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 318, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "这不是开玩笑的时候吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Alisa004"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-,Angle01/Head/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 323, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Anan", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 325, "indent": 0, "params": {"Text": "『请你反省』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_AnAn001"]}},
    {"op": "ModifyCharacterExtended", "line": 327, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR6,ArmL6"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 328, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "……对不起。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema015"]}},
    {"op": "Damage", "line": 332, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "（还没详细说明，就惹大家生气了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema016"]}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "（我得认真思考以后再发言……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema017"]}},
    {"op": "GotoModified", "line": 338, "indent": 0, "params": {"Path": ".Judge1-1-4"}},
    {"op": "label", "name": "Judge1-1-5", "line": 344, "indent": 0},
    {"op": "StopBgm", "line": 346, "indent": 0, "params": {}},
    {"op": "Gosub", "line": 347, "indent": 0, "params": {"Path": "System/System_Subroutine.AdditionalDebate-CutIn-2"}},
    {"op": "ModifyCharacterExtended", "line": 348, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 349, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "……大家知道诺亚的魔法是什么吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema018"]}},
    {"op": "ModifyCharacterExtended", "line": 353, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL11,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Middle"}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "我亲耳听她讲……<br>\n她的魔法是【操作液体的魔法】……<br>\n她就是靠这个来画画的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema019"]}},
    {"op": "PlaySfxModified", "line": 358, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Surprised1,ArmR1,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 361, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 363, "indent": 0, "params": {"Text": "啊……！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry008"]}},
    {"op": "PlayBgm", "line": 366, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 368, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR8,ArmL1,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 369, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 371, "indent": 0, "params": {"Text": "所以我想，蝴蝶绘画<br>\n是用诺亚的魔法<br>\n画出来的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema020"]}},
    {"op": "ModifyCharacterExtended", "line": 373, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Normal1,ArmR2,ArmL5,Angle01/Facial/Mouth>Mouth_Neutral_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 374, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "……我也觉得，以诺亚的出血量，<br>\n用笔画这么大的画<br>\n并不现实。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Margo005"]}},
    {"op": "ModifyCharacterExtended", "line": 378, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1,Arms,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 379, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 381, "indent": 0, "params": {"Text": "……一般情况下，用自己的血<br>\n画这么大的画，恐怕是不可能的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Leia001"]}},
    {"op": "PrintTextModified", "line": 383, "indent": 0, "params": {"Text": "这幅画是诺亚死后经其他人之手<br>\n画下的，这样想才更自然。<br>\n……只不过。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 385, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR5,ArmL7,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Middle"}},
    {"op": "PrintTextModified", "line": 387, "indent": 0, "params": {"Text": "在这座监牢里面，还有另一种可能性……<br>\n那就是排在物理法则之后的<br>\n叫做【魔法】的第二法则。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 389, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR9,ArmL4"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 390, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 392, "indent": 0, "params": {"Text": "诺亚在临死前，使用了魔法，<br>\n瞬间就画了这幅画……<br>\n这样想确实说得通！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry009"]}},
    {"op": "ModifyCharacterExtended", "line": 394, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Smile_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 395, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 397, "indent": 0, "params": {"Text": "（太好了……！<br>\n　成功说服雪莉了……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema021"]}},
    {"op": "PlaySfxModified", "line": 400, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 402, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR3,ArmL4,Angle01/Facial/Mouth>Mouth_Neutral_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 403, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 405, "indent": 0, "params": {"Text": "……可是这样一来，结论就只有一个了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 407, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 408, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 410, "indent": 0, "params": {"Text": "（……欸？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema022"]}},
    {"op": "PlaySfxModified", "line": 413, "indent": 0, "params": {"SfxPath": "Sfx_Common_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 415, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1,ArmR15,ArmL4"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 416, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "ZoomLevel": 3}},
    {"op": "PrintTextModified", "line": 418, "indent": 0, "params": {"Text": "那幅画就是<br>\n诺亚的死亡讯息！<br>\n她想通过这幅画，告诉我们一些事实！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry011"]}},
    {"op": "PlaySfxModified", "line": 421, "indent": 0, "params": {"SfxPath": "Sfx_Common_7", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 423, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1,ArmR3,ArmL1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 424, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 426, "indent": 0, "params": {"Text": "（欸……！？是这样吗！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema023"]}},
    {"op": "ModifyCharacterExtended", "line": 428, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1,ArmR2,ArmL2,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 429, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 431, "indent": 0, "params": {"Text": "……所以呢？如果说那幅画是死亡讯息，<br>\n那凶手究竟是谁？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 433, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR6,ArmL4"}},
    {"op": "StopBgm", "line": 434, "indent": 0, "params": {}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 435, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "ZoomLevel": 3}},
    {"op": "PrintTextModified", "line": 437, "indent": 0, "params": {"Text": "凶手……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Sherry012"]}},
    {"op": "PlaySfxModified", "line": 440, "indent": 0, "params": {"SfxPath": "Sfx_Common_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 441, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1,ArmR13,ArmL4"}},
