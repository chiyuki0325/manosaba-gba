    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "看来，画画用的应该就是诺亚的血没错。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Normal1,ArmR2,ArmL1,Option-ArmL-Off"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 162, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "……我说，你连血都没见过吗？<br>\n真是无知兼白痴……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Alisa002"]}},
    {"op": "Damage", "line": 166, "indent": 0, "params": {}},
