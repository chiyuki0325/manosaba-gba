    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "……嗯！我明白了！<br>\n我会试试看……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial01_Ema002"]}},
