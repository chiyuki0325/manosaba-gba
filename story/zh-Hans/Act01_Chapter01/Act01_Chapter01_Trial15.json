    {"op": "ModifyTextPrinter", "line": 3, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Gosub", "line": 4, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 11, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 15, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "label", "name": "Judge1-15-1", "line": 17, "indent": 0},
    {"op": "SpawnExtended", "line": 23, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S01", "Wait": 0}},
    {"op": "Wait", "line": 24, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "这是昨晚晚餐后发生的事。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia001"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "莲见蕾雅杀死了城崎诺亚。<br>\n简而言之，事实就是这样。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "……我很想保护大家。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia003"]}},
    {"op": "ResetText", "line": 39, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 40, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 41, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 44, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S02", "Wait": 0}},
    {"op": "Wait", "line": 45, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "……一切都是巧合。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia004"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "碰巧，我拿着弩枪的箭。<br>\n本来我想把它藏起来，<br>\n避免有人把它当凶器，伤害大家。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia005"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "碰巧，我捡到了奈叶香的发带，放到了口袋里。<br>\n本来我想找到物主，<br>\n把它还回去的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia006"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "碰巧，我路过那房间的时候，<br>\n里面涂满了还未干的颜料。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia007"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "……而在那正中间，我看到了她。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia008"]}},
    {"op": "ResetText", "line": 57, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 58, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S02", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 59, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 62, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S03", "Wait": 0}},
    {"op": "Wait", "line": 63, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "我的魔法是固定视线。<br>\n也可以说是固定对方的注意力。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia009"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "我把诺亚碰巧望着天花板的视线<br>\n直接固定住了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia010"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "……所谓艺术家，脑子里在想什么，一般人怎么知道呢。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia011"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "她到死为止……都一直在望着空无一物的天花板。<br>\n直到胸部中箭，倒地身亡。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia012"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "……或许，她连自己是被谁杀的都不知道。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia013"]}},
    {"op": "ResetText", "line": 75, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 76, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S03", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 77, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 80, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S04", "Wait": 0}},
    {"op": "Wait", "line": 81, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "我固定好她的视线后，为了不在颜料上留下足迹，<br>\n组装了一把长距离武器。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia014"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "我拆解了旁边的扫帚，<br>\n跟我携带的剑组合到一起。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia015"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "然后我在顶端上绑了那支箭。<br>\n用的当然是奈叶香的发带。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia016"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "之后就跟艾玛说的一样。<br>\n我用顶端的箭，刺穿了动弹不得的诺亚的心脏。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia017"]}},
    {"op": "ResetText", "line": 91, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 92, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S04", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 93, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 96, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S05", "Wait": 0}},
    {"op": "Wait", "line": 97, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "只不过，那时出了个意外。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia018"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "看来只靠发带固定，是承受不了冲击的。<br>\n临时武器很快便解体了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia019"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "尽管我花了些功夫，总算回收了剑和发带……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia020"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "看来那时剑尖刮到了地板，<br>\n颜料也沾到上面了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia021"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "当时我根本没发现。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia022"]}},
    {"op": "ResetText", "line": 109, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 110, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S05", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 111, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 114, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S06", "Wait": 0}},
    {"op": "Wait", "line": 115, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "杀死诺亚后，<br>\n我佯装无事发生，参加了可可的直播。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia023"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "可能是因为刚刚杀了人，我感觉有点兴奋。<br>\n结果演了不熟的杂技，还留了证据。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia024"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "之后在回去的路上……在路过诺亚房间前，<br>\n我想着，尸体越晚发现越好。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia025"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "所以我佯装无事，跟可可和米莉亚两个人聊着天……<br>\n一边走着，一边将她们的视线固定在我身上。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia026"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "因为只有一瞬间，我猜她们也不会发现有什么不对劲。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia027"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "我们就是这样无视了倒在身边的诺亚，<br>\n回到了房间里。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia028"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "第二天在大家找线索的时候，我把发带扔到了湖边。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia029"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "……不过事后看来，很快被亚里沙找到了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia030"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "我有发现剑尖沾了颜料，慌慌张张地把它擦掉了……<br>\n没想到颜料竟然还沾到那颗苹果上了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia031"]}},
    {"op": "ResetText", "line": 135, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 136, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S06", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 141, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S01", "Wait": 0}},
    {"op": "Wait", "line": 142, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "这就是……莲见蕾雅犯下的，城崎诺亚凶杀案的全貌。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia032"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "……好啦，闭幕时间到了。<br>\n这场演出到此结束。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia033"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "——感谢大家观看，我最后的一场戏。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Trial15_Leia034"]}},
    {"op": "ResetText", "line": 152, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 153, "indent": 0, "params": {"Path": "Reenact_Ch01_E01_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 154, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "SetCustomVariable", "line": 160, "indent": 0, "params": {"Expression": "isReenact = false"}},
    {"op": "Gosub", "line": 161, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 163, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv35", "SoftReset": 1}}
  ],
  "translations": {
  "0101Trial15_Leia001": "这是昨晚晚餐后发生的事。",
  "0101Trial15_Leia002": "莲见蕾雅杀死了城崎诺亚。<br>\n简而言之，事实就是这样。",
  "0101Trial15_Leia003": "……我很想保护大家。",
  "0101Trial15_Leia004": "……一切都是巧合。",
  "0101Trial15_Leia005": "碰巧，我拿着弩枪的箭。<br>\n本来我想把它藏起来，<br>\n避免有人把它当凶器，伤害大家。",
  "0101Trial15_Leia006": "碰巧，我捡到了奈叶香的发带，放到了口袋里。<br>\n本来我想找到物主，<br>\n把它还回去的。",
  "0101Trial15_Leia007": "碰巧，我路过那房间的时候，<br>\n里面涂满了还未干的颜料。",
  "0101Trial15_Leia008": "……而在那正中间，我看到了她。",
  "0101Trial15_Leia009": "我的魔法是固定视线。<br>\n也可以说是固定对方的注意力。",
  "0101Trial15_Leia010": "我把诺亚碰巧望着天花板的视线<br>\n直接固定住了。",
  "0101Trial15_Leia011": "……所谓艺术家，脑子里在想什么，一般人怎么知道呢。",
  "0101Trial15_Leia012": "她到死为止……都一直在望着空无一物的天花板。<br>\n直到胸部中箭，倒地身亡。",
  "0101Trial15_Leia013": "……或许，她连自己是被谁杀的都不知道。",
  "0101Trial15_Leia014": "我固定好她的视线后，为了不在颜料上留下足迹，<br>\n组装了一把长距离武器。",
  "0101Trial15_Leia015": "我拆解了旁边的扫帚，<br>\n跟我携带的剑组合到一起。",
  "0101Trial15_Leia016": "然后我在顶端上绑了那支箭。<br>\n用的当然是奈叶香的发带。",
  "0101Trial15_Leia017": "之后就跟艾玛说的一样。<br>\n我用顶端的箭，刺穿了动弹不得的诺亚的心脏。",
  "0101Trial15_Leia018": "只不过，那时出了个意外。",
  "0101Trial15_Leia019": "看来只靠发带固定，是承受不了冲击的。<br>\n临时武器很快便解体了。",
  "0101Trial15_Leia020": "尽管我花了些功夫，总算回收了剑和发带……",
  "0101Trial15_Leia021": "看来那时剑尖刮到了地板，<br>\n颜料也沾到上面了。",
  "0101Trial15_Leia022": "当时我根本没发现。",
  "0101Trial15_Leia023": "杀死诺亚后，<br>\n我佯装无事发生，参加了可可的直播。",
  "0101Trial15_Leia024": "可能是因为刚刚杀了人，我感觉有点兴奋。<br>\n结果演了不熟的杂技，还留了证据。",
  "0101Trial15_Leia025": "之后在回去的路上……在路过诺亚房间前，<br>\n我想着，尸体越晚发现越好。",
  "0101Trial15_Leia026": "所以我佯装无事，跟可可和米莉亚两个人聊着天……<br>\n一边走着，一边将她们的视线固定在我身上。",
  "0101Trial15_Leia027": "因为只有一瞬间，我猜她们也不会发现有什么不对劲。",
  "0101Trial15_Leia028": "我们就是这样无视了倒在身边的诺亚，<br>\n回到了房间里。",
  "0101Trial15_Leia029": "第二天在大家找线索的时候，我把发带扔到了湖边。",
  "0101Trial15_Leia030": "……不过事后看来，很快被亚里沙找到了。",
  "0101Trial15_Leia031": "我有发现剑尖沾了颜料，慌慌张张地把它擦掉了……<br>\n没想到颜料竟然还沾到那颗苹果上了。",
  "0101Trial15_Leia032": "这就是……莲见蕾雅犯下的，城崎诺亚凶杀案的全貌。",
  "0101Trial15_Leia033": "……好啦，闭幕时间到了。<br>\n这场演出到此结束。",
  "0101Trial15_Leia034": "——感谢大家观看，我最后的一场戏。"
}
}
