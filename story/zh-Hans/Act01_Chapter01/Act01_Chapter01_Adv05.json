  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-1-1", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 6, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "ModifyBackgroundExtended", "line": 7, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 8, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 10, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 12, "indent": 0, "params": {"Text": "沾满鲜血的会客厅内，<br>\n少女们陷入了恐慌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 14, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Jailer"}},
    {"op": "AnimateActorExtended", "line": 15, "indent": 0, "params": {"ActorIds": ["Jailer"], "Loop": 0, "ScenePositionX": "30|50|70", "Duration": "2|2|2"}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "………", "AuthorId": "Jailer", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Jailer001"]}},
    {"op": "PlaySfxModified", "line": 19, "indent": 0, "params": {"SfxPath": "Sfx_5", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "唯一在室内缓慢行动的，<br>\n只有看守了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative002"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "看守正在打扫二阶堂希罗的尸体。<br>\n在此作业期间——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 25, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Fearful1,Option-ArmL-Off,ArmR2,ArmL4"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "呜……！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Alisa001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "有一位难耐恐惧的少女<br>\n猛然开始狂奔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "看守对逃跑行动作出了反应。<br>\n它开始以迅猛之势追赶那位少女，紫藤亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "（危险！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Jailer.1", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 42, "indent": 0, "params": {"ActorIds": ["Jailer-Middle"], "Loop": 0, "ScenePositionX": "15", "ScenePositionY": "8", "Scale": "1.4"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "跟在亚里沙身后的看守，手上的镰刀亮起寒光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative006"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "面对即将二度降临的悲剧，<br>\n大部分少女都捂住了眼睛，发出了惊叫声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 48, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "ResetText", "line": 51, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 52, "indent": 0, "params": {"SlotNumber": 1, "Wait": 0}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "等一下！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia001"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "一位少女用威严的声音说道。<br>\n在场的所有人都回过神来看着她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative008"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "那位少女——莲见蕾雅<br>\n拔出了腰间的刺剑，站到亚里沙和看守二位中间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative009"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "不许对她出手！<br>\n我不会再让悲剧发生！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia002"]}},
    {"op": "HideAllCharacters", "line": 62, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Jailer.1", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 64, "indent": 0, "params": {"ActorIds": ["Jailer-Middle"], "Loop": 0, "ScenePositionX": "85", "ScenePositionY": "8", "Scale": "1.4"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "看守似乎没有听进去，<br>\n继续用力挥下镰刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 68, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 69, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（不要再这样了——！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema002"]}},
    {"op": "StopBgm", "line": 73, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "艾玛她……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative011"]}},
    {"op": "AddChoice", "line": 83, "indent": 0, "params": {"ChoiceSummary": "挡在蕾雅的身前", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv05_Choice001"]}},
    {"op": "GotoModified", "line": 84, "indent": 1, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Bad01", "ResetState": ["-"]}},
    {"op": "AddChoice", "line": 86, "indent": 0, "params": {"ChoiceSummary": "选择了旁观", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0101Adv05_Choice002"]}},
    {"op": "GotoModified", "line": 87, "indent": 1, "params": {"Path": ".Choice1-1-1"}},
    {"op": "StopForChoice", "line": 89, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice1-1-1", "line": 91, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 93, "indent": 0, "params": {"Number": 1}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "——哈！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia003"]}},
    {"op": "PlaySfxModified", "line": 102, "indent": 0, "params": {"SfxPath": "Sfx_178", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 103, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "蕾雅瞬间往后方跳去，<br>\n让看守砍了个空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Surprised1,Option-ArmL-Off,ArmR2,ArmL4"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "蕾雅保持着握剑姿势，<br>\n以坚决的眼神直视看守。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative013"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "她没有违反规定。<br>\n你没有理由杀她。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia004"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "在蕾雅身后站着的亚里沙<br>\n大概是丧失了逃跑的欲望，呆站在原地一动不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative014"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "你为什么……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Alisa002"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "我想保护你们。<br>\n所以，我们大家都应该冷静下来。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia005"]}},
    {"op": "HideAllCharacters", "line": 120, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "…………", "AuthorId": "Jailer", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Jailer002"]}},
    {"op": "HideAllCharacters", "line": 125, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "看守不再挥动镰刀，回到了原先的打扫作业中。<br>\n或许，刚才的行动只是出于警告目的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative015"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "接着，它扛起希罗的尸体离开了房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative016"]}},
    {"op": "PlayBgm", "line": 131, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "随着看守的离开，<br>\n少女之间紧绷的气氛终于有了稍许缓解。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative017"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "只不过，尽管希罗的尸体已打扫干净，<br>\n但室内仍充满着沉闷的血液气味。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative018"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "刚刚有人说过，<br>\n这个房间【很臭】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative019"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "会客厅装点着恶趣味装饰，散发着邪气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative020"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "如果说，这里的绒毯、沙发、窗帘，每样东西都在长年累月间<br>\n吮吸着少女们的鲜血——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Fearful1,ArmL8"}},
    {"op": "EmoteNod", "line": 144, "indent": 0, "params": {"ActorIds": ["Coco"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "呜，呕呕呕……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Coco001"]}},
    {"op": "HideAllCharacters", "line": 148, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "一想到这些或许就是事实，可可便吐了出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative022"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "到现在都没人想吐，这才是怪事。<br>\n现在的状况，就是如此地脱离常轨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative023"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "这时有人站到了中间。<br>\n不用多想，那就是蕾雅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "大家，请听我说！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia006"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "看来，我们被迫只能在这里共同生活了。<br>\n虽然不知道要待到什么时候……<br>\n现在我们还是乖乖照做吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia007"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "尽管我们才刚认识不久，<br>\n但是我想尽量保护你们。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia008"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "像刚才希罗作出的举动，<br>\n还有像亚里沙刚才那样的逃跑行为，<br>\n有可能会危及我们所有人。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia009"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "我希望大家今后可以谨慎行动。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia010"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "啧……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Alisa003"]}},
    {"op": "HideAllCharacters", "line": 173, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "亚里沙无法反驳，<br>\n只好咂了咂舌宣泄不满。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "……首先，请大家看一下自己的口袋。<br>\n应该每个人都发了一部手机。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia011"]}},
    {"op": "HideAllCharacters", "line": 181, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "听蕾雅这么讲，<br>\n所有人都摸了摸自己的口袋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative026"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "（真的欸……虽然不是我自己的，<br>\n　不过确实有一部智能手机……<br>\n　难道可以用它联络外界！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "遗憾的是，没有信号，<br>\n不能用来和外界联络。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia012"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "我们是被抓来这个地方的，<br>\n有信号才奇怪……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia013"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "希望瞬间破灭，<br>\n艾玛失望地垂下肩膀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative027"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "在手机里面，<br>\n有一个叫【魔女图鉴】的APP。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia014"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "刚才典狱长也讲了，<br>\n【魔女图鉴】好像就是规则手册。<br>\n里面收录了监牢的地图和规定，还有我们囚犯的资料。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia015"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "请大家都认真去看【魔女图鉴】里面<br>\n记录的规定，一起生活下去吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia016"]}},
    {"op": "GosubResetWitchBook", "line": 201, "indent": 0, "params": {"Path": "System/System_ResetWitchBook"}},
    {"op": "SetCustomVariable", "line": 203, "indent": 0, "params": {"Expression": "hasWitchBook = true"}},
    {"op": "ShowUI", "line": 204, "indent": 0, "params": {"UINames": ["WitchBookButtonUI"]}},
    {"op": "HideAllCharacters", "line": 205, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 206, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL7"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "……开什么玩笑！<br>\n我才不管什么规定不规定！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Alisa004"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "什么魔女什么囚犯都见鬼去吧！<br>\n我一秒都不想待在这个地方。<br>\n我要离开这里！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Alisa005"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "面对咬牙切齿的亚里沙，<br>\n蕾雅忧愁地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative028"]}},
    {"op": "HideAllCharacters", "line": 214, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 215, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR5"}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "你要是再表现出反抗的态度，<br>\n我可不知道看守会对你做出什么事来。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia017"]}},
    {"op": "HideAllCharacters", "line": 219, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "跟你没关系吧，你管我！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Alisa006"]}},
    {"op": "HideAllCharacters", "line": 224, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "亚里沙咂了咂舌，离开了会客厅。<br>\n蕾雅无可奈何地耸了耸肩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "除了她，剩下来的人应该可以好好配合吧？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia018"]}},
    {"op": "HideAllCharacters", "line": 232, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "……我也，不愿意。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema004"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "艾玛往前走出一步，开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative030"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "我才不要听，杀死希罗的<br>\n那帮家伙讲的话！<br>\n我绝对不会原谅它们！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema005"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "双眼闪着泪花的艾玛坚定说道。<br>\n蕾雅露出了有些惊讶的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative031"]}},
    {"op": "HideAllCharacters", "line": 243, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "是这样啊。<br>\n你好像认识希罗，对吗。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia019"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "不过在我看来，你们好像关系并不是很好？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia020"]}},
    {"op": "HideAllCharacters", "line": 250, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 251, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "因为，希罗她……<br>\n希罗她是一个正直的人……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema006"]}},
    {"op": "HideAllCharacters", "line": 255, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR5"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "蕾雅轻轻叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative032"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "唉，我知道你不打算遵守了。<br>\n我也不会强迫你。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia021"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "不过，我希望大家可以温和一些。<br>\n我们无法和引来危险的分子一起行动。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia022"]}},
    {"op": "HideAllCharacters", "line": 264, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 265, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmL6"}},
    {"op": "EmoteJumpDouble", "line": 266, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "我也来我也来！<br>\n我也要选艾玛这边～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Sherry001"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "雪莉兴奋地举起了手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative033"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "艾玛惊讶得张大了双眼，<br>\n事情的发展超出了她的预料。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative034"]}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmL8"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "选边就要选有趣的一边，这就是我的信条！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR13,ArmL1"}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "而艾玛你！<br>\n我从你的身上闻到了一股超浓郁的有趣味道！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 282, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 283, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3,ArmL1"}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "浓郁的，味道……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema007"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "不知何时，艾玛的身边<br>\n又多了汉娜和梅露露两个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative035"]}},
    {"op": "ModifyCharacterExtended", "line": 289, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 290, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "我也要和你站一边。<br>\n本小姐最讨厌那种一副大人物的样子指指点点的人了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Hanna001"]}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "看样子，她并没有想着支持艾玛，<br>\n而只是单纯地看不惯蕾雅。<br>\n虽然自尊受伤，不过还蛮有骨气的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative036"]}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "呜呜……艾玛小姐……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Meruru001"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "而梅露露好像有点怕生，<br>\n她紧紧贴住了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative037"]}},
    {"op": "HideAllCharacters", "line": 300, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 301, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL11"}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "哎呀呀～？<br>\n意见分成两派了耶。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 305, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 306, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Normal1,ArmR5"}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "……看来的确如此。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia023"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "大家能齐心协力度过难关那就最好，<br>\n不过意见不合就没办法了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia024"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "我们先回地下去吧。<br>\n根据规定，现在是必须待在地下牢房内的时间。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Leia025"]}},
    {"op": "HideAllCharacters", "line": 314, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "蕾雅动身后，<br>\n决定和她坐同一条船的少女们<br>\n也都跟在她身后离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative038"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "留在会客厅内的，<br>\n就只剩艾玛、雪莉、汉娜和梅露露4个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Narrative039"]}},
    {"op": "HideAllCharacters", "line": 320, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 321, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "EmoteJumpDouble", "line": 322, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "然后呢然后呢？？我们接下来做什么？<br>\n大家齐心协力去弄死看守？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 326, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 327, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "不、不可以啦。<br>\n会像希罗那样被杀死的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema008"]}},
    {"op": "HideAllCharacters", "line": 331, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "（不能原谅杀死希罗的看守，还有典狱长……<br>\n　可是……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema009"]}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "（不多加考虑冲动行事，只会落得同样的下场。<br>\n　我一定要冷静行动）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema010"]}},
    {"op": "HideAllCharacters", "line": 337, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 338, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "……总之，我们先回地下去吧。<br>\n我们也应该看一下规定才对。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema011"]}},
    {"op": "HideAllCharacters", "line": 342, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 343, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "嗯说的也是呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 347, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 348, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "不过我并不打算坐以待毙。<br>\n……它们杀死了希罗，<br>\n我绝不会原谅。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0101Adv05_Ema012"]}},
    {"op": "Gosub", "line": 356, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 358, "indent": 0, "params": {"Path": "Act01_Chapter01/Act01_Chapter01_Adv06", "SoftReset": 1}}
  ],
  "translations": {
  "0101Adv05_Narrative001": "沾满鲜血的会客厅内，<br>\n少女们陷入了恐慌。",
  "0101Adv05_Jailer001": "………",
  "0101Adv05_Narrative002": "唯一在室内缓慢行动的，<br>\n只有看守了。",
  "0101Adv05_Narrative003": "看守正在打扫二阶堂希罗的尸体。<br>\n在此作业期间——",
  "0101Adv05_Alisa001": "呜……！",
  "0101Adv05_Narrative004": "有一位难耐恐惧的少女<br>\n猛然开始狂奔。",
  "0101Adv05_Narrative005": "看守对逃跑行动作出了反应。<br>\n它开始以迅猛之势追赶那位少女，紫藤亚里沙。",
  "0101Adv05_Ema001": "（危险！）",
  "0101Adv05_Narrative006": "跟在亚里沙身后的看守，手上的镰刀亮起寒光。",
  "0101Adv05_Narrative007": "面对即将二度降临的悲剧，<br>\n大部分少女都捂住了眼睛，发出了惊叫声。",
  "0101Adv05_Leia001": "等一下！",
  "0101Adv05_Narrative008": "一位少女用威严的声音说道。<br>\n在场的所有人都回过神来看着她。",
  "0101Adv05_Narrative009": "那位少女——莲见蕾雅<br>\n拔出了腰间的刺剑，站到亚里沙和看守二位中间。",
  "0101Adv05_Leia002": "不许对她出手！<br>\n我不会再让悲剧发生！",
  "0101Adv05_Narrative010": "看守似乎没有听进去，<br>\n继续用力挥下镰刀。",
  "0101Adv05_Ema002": "（不要再这样了——！）",
  "0101Adv05_Narrative011": "艾玛她……",
  "0101Adv05_Choice001": "挡在蕾雅的身前",
  "0101Adv05_Choice002": "选择了旁观",
  "0101Adv05_Leia003": "——哈！",
  "0101Adv05_Narrative012": "蕾雅瞬间往后方跳去，<br>\n让看守砍了个空。",
  "0101Adv05_Narrative013": "蕾雅保持着握剑姿势，<br>\n以坚决的眼神直视看守。",
  "0101Adv05_Leia004": "她没有违反规定。<br>\n你没有理由杀她。",
  "0101Adv05_Narrative014": "在蕾雅身后站着的亚里沙<br>\n大概是丧失了逃跑的欲望，呆站在原地一动不动。",
  "0101Adv05_Alisa002": "你为什么……",
  "0101Adv05_Leia005": "我想保护你们。<br>\n所以，我们大家都应该冷静下来。",
  "0101Adv05_Jailer002": "…………",
  "0101Adv05_Narrative015": "看守不再挥动镰刀，回到了原先的打扫作业中。<br>\n或许，刚才的行动只是出于警告目的。",
  "0101Adv05_Narrative016": "接着，它扛起希罗的尸体离开了房间。",
  "0101Adv05_Narrative017": "随着看守的离开，<br>\n少女之间紧绷的气氛终于有了稍许缓解。",
  "0101Adv05_Narrative018": "只不过，尽管希罗的尸体已打扫干净，<br>\n但室内仍充满着沉闷的血液气味。",
  "0101Adv05_Narrative019": "刚刚有人说过，<br>\n这个房间【很臭】。",
  "0101Adv05_Narrative020": "会客厅装点着恶趣味装饰，散发着邪气。",
  "0101Adv05_Narrative021": "如果说，这里的绒毯、沙发、窗帘，每样东西都在长年累月间<br>\n吮吸着少女们的鲜血——",
  "0101Adv05_Coco001": "呜，呕呕呕……",
  "0101Adv05_Narrative022": "一想到这些或许就是事实，可可便吐了出来。",
  "0101Adv05_Narrative023": "到现在都没人想吐，这才是怪事。<br>\n现在的状况，就是如此地脱离常轨。",
  "0101Adv05_Narrative024": "这时有人站到了中间。<br>\n不用多想，那就是蕾雅。",
  "0101Adv05_Leia006": "大家，请听我说！",
  "0101Adv05_Leia007": "看来，我们被迫只能在这里共同生活了。<br>\n虽然不知道要待到什么时候……<br>\n现在我们还是乖乖照做吧。",
  "0101Adv05_Leia008": "尽管我们才刚认识不久，<br>\n但是我想尽量保护你们。",
  "0101Adv05_Leia009": "像刚才希罗作出的举动，<br>\n还有像亚里沙刚才那样的逃跑行为，<br>\n有可能会危及我们所有人。",
  "0101Adv05_Leia010": "我希望大家今后可以谨慎行动。",
  "0101Adv05_Alisa003": "啧……",
  "0101Adv05_Narrative025": "亚里沙无法反驳，<br>\n只好咂了咂舌宣泄不满。",
  "0101Adv05_Leia011": "……首先，请大家看一下自己的口袋。<br>\n应该每个人都发了一部手机。",
  "0101Adv05_Narrative026": "听蕾雅这么讲，<br>\n所有人都摸了摸自己的口袋。",
  "0101Adv05_Ema003": "（真的欸……虽然不是我自己的，<br>\n　不过确实有一部智能手机……<br>\n　难道可以用它联络外界！？）",
  "0101Adv05_Leia012": "遗憾的是，没有信号，<br>\n不能用来和外界联络。",
  "0101Adv05_Leia013": "我们是被抓来这个地方的，<br>\n有信号才奇怪……",
  "0101Adv05_Narrative027": "希望瞬间破灭，<br>\n艾玛失望地垂下肩膀。",
  "0101Adv05_Leia014": "在手机里面，<br>\n有一个叫【魔女图鉴】的APP。",
  "0101Adv05_Leia015": "刚才典狱长也讲了，<br>\n【魔女图鉴】好像就是规则手册。<br>\n里面收录了监牢的地图和规定，还有我们囚犯的资料。",
  "0101Adv05_Leia016": "请大家都认真去看【魔女图鉴】里面<br>\n记录的规定，一起生活下去吧。",
  "0101Adv05_Alisa004": "……开什么玩笑！<br>\n我才不管什么规定不规定！",
  "0101Adv05_Alisa005": "什么魔女什么囚犯都见鬼去吧！<br>\n我一秒都不想待在这个地方。<br>\n我要离开这里！",
  "0101Adv05_Narrative028": "面对咬牙切齿的亚里沙，<br>\n蕾雅忧愁地叹了口气。",
  "0101Adv05_Leia017": "你要是再表现出反抗的态度，<br>\n我可不知道看守会对你做出什么事来。",
  "0101Adv05_Alisa006": "跟你没关系吧，你管我！",
  "0101Adv05_Narrative029": "亚里沙咂了咂舌，离开了会客厅。<br>\n蕾雅无可奈何地耸了耸肩。",
  "0101Adv05_Leia018": "除了她，剩下来的人应该可以好好配合吧？",
  "0101Adv05_Ema004": "……我也，不愿意。",
  "0101Adv05_Narrative030": "艾玛往前走出一步，开口说道。",
  "0101Adv05_Ema005": "我才不要听，杀死希罗的<br>\n那帮家伙讲的话！<br>\n我绝对不会原谅它们！",
  "0101Adv05_Narrative031": "双眼闪着泪花的艾玛坚定说道。<br>\n蕾雅露出了有些惊讶的表情。",
  "0101Adv05_Leia019": "是这样啊。<br>\n你好像认识希罗，对吗。",
  "0101Adv05_Leia020": "不过在我看来，你们好像关系并不是很好？",
  "0101Adv05_Ema006": "因为，希罗她……<br>\n希罗她是一个正直的人……",
  "0101Adv05_Narrative032": "蕾雅轻轻叹了口气。",
  "0101Adv05_Leia021": "唉，我知道你不打算遵守了。<br>\n我也不会强迫你。",
  "0101Adv05_Leia022": "不过，我希望大家可以温和一些。<br>\n我们无法和引来危险的分子一起行动。",
  "0101Adv05_Sherry001": "我也来我也来！<br>\n我也要选艾玛这边～！",
  "0101Adv05_Narrative033": "雪莉兴奋地举起了手。",
  "0101Adv05_Narrative034": "艾玛惊讶得张大了双眼，<br>\n事情的发展超出了她的预料。",
  "0101Adv05_Sherry002": "选边就要选有趣的一边，这就是我的信条！",
  "0101Adv05_Sherry003": "而艾玛你！<br>\n我从你的身上闻到了一股超浓郁的有趣味道！",
  "0101Adv05_Ema007": "浓郁的，味道……？",
  "0101Adv05_Narrative035": "不知何时，艾玛的身边<br>\n又多了汉娜和梅露露两个人。",
  "0101Adv05_Hanna001": "我也要和你站一边。<br>\n本小姐最讨厌那种一副大人物的样子指指点点的人了。",
  "0101Adv05_Narrative036": "看样子，她并没有想着支持艾玛，<br>\n而只是单纯地看不惯蕾雅。<br>\n虽然自尊受伤，不过还蛮有骨气的。",
  "0101Adv05_Meruru001": "呜呜……艾玛小姐……",
  "0101Adv05_Narrative037": "而梅露露好像有点怕生，<br>\n她紧紧贴住了艾玛。",
  "0101Adv05_Sherry004": "哎呀呀～？<br>\n意见分成两派了耶。",
  "0101Adv05_Leia023": "……看来的确如此。",
  "0101Adv05_Leia024": "大家能齐心协力度过难关那就最好，<br>\n不过意见不合就没办法了。",
  "0101Adv05_Leia025": "我们先回地下去吧。<br>\n根据规定，现在是必须待在地下牢房内的时间。",
  "0101Adv05_Narrative038": "蕾雅动身后，<br>\n决定和她坐同一条船的少女们<br>\n也都跟在她身后离开了。",
  "0101Adv05_Narrative039": "留在会客厅内的，<br>\n就只剩艾玛、雪莉、汉娜和梅露露4个人。",
  "0101Adv05_Sherry005": "然后呢然后呢？？我们接下来做什么？<br>\n大家齐心协力去弄死看守？",
  "0101Adv05_Ema008": "不、不可以啦。<br>\n会像希罗那样被杀死的。",
  "0101Adv05_Ema009": "（不能原谅杀死希罗的看守，还有典狱长……<br>\n　可是……）",
  "0101Adv05_Ema010": "（不多加考虑冲动行事，只会落得同样的下场。<br>\n　我一定要冷静行动）",
  "0101Adv05_Ema011": "……总之，我们先回地下去吧。<br>\n我们也应该看一下规定才对。",
  "0101Adv05_Sherry006": "嗯说的也是呢。",
  "0101Adv05_Ema012": "不过我并不打算坐以待毙。<br>\n……它们杀死了希罗，<br>\n我绝不会原谅。"
}
}
