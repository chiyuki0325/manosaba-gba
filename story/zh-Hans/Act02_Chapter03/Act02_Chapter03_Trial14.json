    {"op": "ModifyTextPrinter", "line": 3, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Gosub", "line": 4, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 11, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 15, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "label", "name": "Judge8-14-1", "line": 17, "indent": 0},
    {"op": "SpawnExtended", "line": 24, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S01", "Wait": 0}},
    {"op": "Wait", "line": 25, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "——那里有这么一幅画。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "是安安把这幅画的最终成品的模样<br>\n告诉诺亚的哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "那幅画里有安安，<br>\n有艾玛。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah003"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "诺亚不由得感叹，太棒了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah004"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "……可是啊。<br>\n诺亚在画上添了几笔。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah005"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "诺亚在安安的画上东涂西抹，<br>\n把她的画给毁了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah006"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "因为……<br>\n诺亚以为只要把安安画里所展示的结局涂改过来，<br>\n就没有人会怀疑诺亚。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah007"]}},
    {"op": "ResetText", "line": 41, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 42, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 43, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 47, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S02", "Wait": 0}},
    {"op": "Wait", "line": 48, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "安安首先做的，<br>\n是做好装死所需要的准备。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah008"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "一开始她就打算装成是一场意外，<br>\n自己从阳台上跳下去。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah009"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "只是她好像没有料到<br>\n希罗会出现就是了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah010"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "尽管出现了意外情况，安安也没有取消计划，照常执行。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah011"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "因为这是一个就算失败了也无所谓的计划。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah012"]}},
    {"op": "ResetText", "line": 60, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 61, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S02", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 62, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 68, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S03", "Wait": 0}},
    {"op": "Wait", "line": 69, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "安安用吊床在中庭内<br>\n做了一个安全网。<br>\n她朝着吊床从阳台跳了下来。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah013"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "她说她把手机丢在中庭里<br>\n当标记了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah014"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "安安掉下来后<br>\n就马上撕破藏在胸口的那袋红色颜料，<br>\n然后拿起事前掰下来藏好的铁栅放在胸口。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah015"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "艾玛她们从阳台看到安安，<br>\n都误以为安安已经死了。<br>", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah016"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "……安安她真厉害啊。<br>\n这全都是她自己一个人想出来的哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah017"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "诺亚绝对想不出来这种计划～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah018"]}},
    {"op": "ResetText", "line": 83, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 84, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S03", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 89, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S04", "Wait": 0}},
    {"op": "Wait", "line": 90, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "看到艾玛她们转身回到画室里去以后，<br>\n安安笑着坐了起来。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah019"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "看到一切按计划进行，<br>\n她很是高兴。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah020"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "计划进展顺利让安安松了一口气。<br>\n所以啊……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah021"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "诺亚就趁着她没注意，<br>\n从她的背后用铁栅刺穿了她的身体。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah022"]}},
    {"op": "PlaySfxModified", "line": 101, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 104, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 105, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S04", "Wait": 0, "LogWarning": 1}},
    {"op": "ModifyBackgroundExtended", "line": 106, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 107, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 108, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "安安带着惊讶的神情，<br>\n就这样死掉了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah023"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "本来诺亚只要直接离开中庭就好……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah024"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "可是大概因为白天下了点雨？<br>\n地面上留下了诺亚的脚印。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah025"]}},
    {"op": "ModifyBackgroundExtended", "line": 116, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 117, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ResetText", "line": 123, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 124, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S05", "Wait": 0}},
    {"op": "Wait", "line": 125, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "所以诺亚用喷泉里的水把地面冲洗了一下。<br>\n就是用魔法哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah026"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "就像下雨一样……想像中庭就是画布，在上面画花纹。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah027"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "这肯定是诺亚这辈子用魔法用得最随心所欲的一次吧？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah028"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "以前诺亚的魔法总是不听使唤……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah029"]}},
    {"op": "ResetText", "line": 135, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 136, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S05", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 143, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S06", "Wait": 0}},
    {"op": "Wait", "line": 144, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "诺亚啊，<br>\n只是帮了安安一把哦？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah030"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "帮安安把假死<br>\n变成了真死。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah031"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "本来安安所描绘的画面里……<br>\n没有希罗跟诺亚……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah032"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "如果能保持这个画面，这肯定会是一幅更加美丽的画作，<br>\n能够达成一个更加美满的结局吧。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah033"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "可是……诺亚篡改了这个画面。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah034"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "大家肯定……不会原谅诺亚吧。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah035"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "大家……对不起哦？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah036"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "这幅不堪入目的丑陋画作……<br>\n你们看到了，也只会觉得为难吧……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial14_Noah037"]}},
    {"op": "ResetText", "line": 162, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 163, "indent": 0, "params": {"Path": "Reenact_Ch02_E03_S06", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 164, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "SetCustomVariable", "line": 166, "indent": 0, "params": {"Expression": "isReenact = false"}},
    {"op": "Gosub", "line": 167, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
