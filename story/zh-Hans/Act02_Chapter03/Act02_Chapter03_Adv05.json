{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter03/Act02_Chapter03_Adv05",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-3-5", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "走进中庭的时候，<br>\n我看到亚里沙正躺在吊床上歇息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "你不打算参加舞台剧制作吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "我走到亚里沙身边对她说道。<br>\n亚里沙嫌弃地坐起身来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "Wait", "line": 29, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "谁要干那种事。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "为什么？你应该多提升自己和他人的协作能力。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro002"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "亚里沙厌烦地瞪了瞪我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "切……烦不烦啊。<br>\n而且说回来，你一开始不是也反对吗。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa002"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "是啊。<br>\n但是，我现在认为这是有必要的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "加深大家的感情，有助于抑制凶杀案发生。<br>\n我不希望再有人牺牲了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Pensive1"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "……你这些话都是真心的？<br>\n依我看，<br>\n你是最有可能动手杀人的那个就是了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa003"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "仿佛在揣摩我的真实想法一般，<br>\n亚里沙直勾勾地盯着我看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Normal1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "你这家伙的话果然信不过。<br>\n怎么可能跟你这种人好好相处。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa004"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "这点我深有同感。<br>\n我也不觉得能跟你好好相处。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "可是基本的协作能力还是要有的吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro006"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "我向亚里沙露出一个微笑。<br>\n但她却恶狠狠地瞪了瞪我，那双眼睛仿佛要喷出熊熊大火似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative005"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "周围的空气一下子剑拔弩张起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 67, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 68, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 71, "indent": 0, "params": {"SfxPath": "Sfx_73", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 72, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "希罗，还有亚里沙，<br>\n你们在聊什么呀？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia001"]}},
    {"op": "HideAllCharacters", "line": 78, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Surprised1"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "又来了一个烦人的家伙……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa005"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "蕾雅出现后，亚里沙紧绷的弦突然放松，<br>\n声音中有些逃避的意思。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile1,ArmR8"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "我是不是打扰你们聊天了？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia002"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "没有，我们就只是闲聊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "那就好。话说回来……<br>\n希罗，你决定好要干什么没有？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "还没有。我还正在看呢。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "是吗。不用焦急，仔细想好再决定就行。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "你到这里来是要干什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro009"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "我想一边研读剧本，<br>\n一边简单练习一下台词。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia005"]}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "给我到其他地方练习去啊……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa006"]}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "不好意思，那可能有点难。<br>\n因为正式表演我也打算在这里办。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "只是练习而已，你到其他地方不也照样能练。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa007"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "我想尽量在一个跟表演场地相近的环境下排练嘛。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia007"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "一提到舞台剧，蕾雅会变得很严肃，<br>\n同时也让人感觉乐在其中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative008"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "看来，她身上散发出来的光芒，以及积极向上的态度，<br>\n正是一种能牵引其他人一同前进的力量。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmL8"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "啊对了，正好你在这里。<br>\n其实我有事想拜托亚里沙帮忙。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia008"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "啊？突然说的什么啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa008"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "我想在剧中增加角色。<br>\n希望亚里沙也能……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia009"]}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "我绝对不会答应。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa009"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "不等蕾雅说完，亚里沙就打断她的话，表现出拒绝的态度。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Cry1,ArmR8,ArmL4"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "别这么说嘛！这个角色只能交给你来演！<br>\n是司掌火焰的小仙子……！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia010"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "……为什么是我来演小仙子啊！<br>\n应该还有其他角色吧！？<br>\n不对，我根本不打算演什么舞台剧！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Alisa010"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Cry1,ArmR1,ArmL4"}},
    {"op": "HideActors", "line": 156, "indent": 0, "params": {"ActorIds": ["Alisa"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "等等，亚里沙！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia011"]}},
    {"op": "PlaySfxModified", "line": 161, "indent": 0, "params": {"SfxPath": "Sfx_173", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 163, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Pensive1,ArmR8,ArmL4"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "走掉了……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia012"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "看着亚里沙飞奔而去的背影，<br>\n蕾雅沮丧地小声说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "对了，希罗。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia013"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "蕾雅转头看向我，<br>\n这时她已经换上了一副和善的笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative012"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "变脸变得真快啊。<br>\n怎么有一种不祥的预感……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro010"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "我啊，还是想让你也来演小仙子。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia014"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "怎么又是小仙子。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR5,ArmL2"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "可是你想想，小仙子们围绕着我这个主演，是给周围增色的角色！<br>\n我认为这是舞台剧中非常重要的一点！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia015"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "请容我拒绝。<br>\n我再找找看有什么能帮忙的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Hiro012"]}},
    {"op": "HideAllCharacters", "line": 193, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 196, "indent": 0, "params": {"SfxPath": "Sfx_72", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "不管是亚里沙还是希罗都不好摆平呢。<br>\n但我是不会放弃的……呵呵呵。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Leia016"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "背后传来蕾雅无所畏忌的笑声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv05_Narrative013"]}},
    {"op": "Gosub", "line": 207, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 209, "indent": 0, "params": {"Path": "Act02_Chapter03/Act02_Chapter03_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0203Adv05_Narrative001": "走进中庭的时候，<br>\n我看到亚里沙正躺在吊床上歇息。",
  "0203Adv05_Hiro001": "你不打算参加舞台剧制作吗？",
  "0203Adv05_Narrative002": "我走到亚里沙身边对她说道。<br>\n亚里沙嫌弃地坐起身来。",
  "0203Adv05_Alisa001": "谁要干那种事。",
  "0203Adv05_Hiro002": "为什么？你应该多提升自己和他人的协作能力。",
  "0203Adv05_Narrative003": "亚里沙厌烦地瞪了瞪我。",
  "0203Adv05_Alisa002": "切……烦不烦啊。<br>\n而且说回来，你一开始不是也反对吗。",
  "0203Adv05_Hiro003": "是啊。<br>\n但是，我现在认为这是有必要的。",
  "0203Adv05_Hiro004": "加深大家的感情，有助于抑制凶杀案发生。<br>\n我不希望再有人牺牲了。",
  "0203Adv05_Alisa003": "……你这些话都是真心的？<br>\n依我看，<br>\n你是最有可能动手杀人的那个就是了。",
  "0203Adv05_Narrative004": "仿佛在揣摩我的真实想法一般，<br>\n亚里沙直勾勾地盯着我看。",
  "0203Adv05_Alisa004": "你这家伙的话果然信不过。<br>\n怎么可能跟你这种人好好相处。",
  "0203Adv05_Hiro005": "这点我深有同感。<br>\n我也不觉得能跟你好好相处。",
  "0203Adv05_Hiro006": "可是基本的协作能力还是要有的吧？",
  "0203Adv05_Narrative005": "我向亚里沙露出一个微笑。<br>\n但她却恶狠狠地瞪了瞪我，那双眼睛仿佛要喷出熊熊大火似的。",
  "0203Adv05_Narrative006": "周围的空气一下子剑拔弩张起来。",
  "0203Adv05_Leia001": "希罗，还有亚里沙，<br>\n你们在聊什么呀？",
  "0203Adv05_Alisa005": "又来了一个烦人的家伙……",
  "0203Adv05_Narrative007": "蕾雅出现后，亚里沙紧绷的弦突然放松，<br>\n声音中有些逃避的意思。",
  "0203Adv05_Leia002": "我是不是打扰你们聊天了？",
  "0203Adv05_Hiro007": "没有，我们就只是闲聊。",
  "0203Adv05_Leia003": "那就好。话说回来……<br>\n希罗，你决定好要干什么没有？",
  "0203Adv05_Hiro008": "还没有。我还正在看呢。",
  "0203Adv05_Leia004": "是吗。不用焦急，仔细想好再决定就行。",
  "0203Adv05_Hiro009": "你到这里来是要干什么？",
  "0203Adv05_Leia005": "我想一边研读剧本，<br>\n一边简单练习一下台词。",
  "0203Adv05_Alisa006": "给我到其他地方练习去啊……",
  "0203Adv05_Leia006": "不好意思，那可能有点难。<br>\n因为正式表演我也打算在这里办。",
  "0203Adv05_Alisa007": "只是练习而已，你到其他地方不也照样能练。",
  "0203Adv05_Leia007": "我想尽量在一个跟表演场地相近的环境下排练嘛。",
  "0203Adv05_Narrative008": "一提到舞台剧，蕾雅会变得很严肃，<br>\n同时也让人感觉乐在其中。",
  "0203Adv05_Narrative009": "看来，她身上散发出来的光芒，以及积极向上的态度，<br>\n正是一种能牵引其他人一同前进的力量。",
  "0203Adv05_Leia008": "啊对了，正好你在这里。<br>\n其实我有事想拜托亚里沙帮忙。",
  "0203Adv05_Alisa008": "啊？突然说的什么啊。",
  "0203Adv05_Leia009": "我想在剧中增加角色。<br>\n希望亚里沙也能……",
  "0203Adv05_Alisa009": "我绝对不会答应。",
  "0203Adv05_Narrative010": "不等蕾雅说完，亚里沙就打断她的话，表现出拒绝的态度。",
  "0203Adv05_Leia010": "别这么说嘛！这个角色只能交给你来演！<br>\n是司掌火焰的小仙子……！",
  "0203Adv05_Alisa010": "……为什么是我来演小仙子啊！<br>\n应该还有其他角色吧！？<br>\n不对，我根本不打算演什么舞台剧！",
  "0203Adv05_Leia011": "等等，亚里沙！",
  "0203Adv05_Leia012": "走掉了……",
  "0203Adv05_Narrative011": "看着亚里沙飞奔而去的背影，<br>\n蕾雅沮丧地小声说道。",
  "0203Adv05_Leia013": "对了，希罗。",
  "0203Adv05_Narrative012": "蕾雅转头看向我，<br>\n这时她已经换上了一副和善的笑容。",
  "0203Adv05_Hiro010": "变脸变得真快啊。<br>\n怎么有一种不祥的预感……",
  "0203Adv05_Leia014": "我啊，还是想让你也来演小仙子。",
  "0203Adv05_Hiro011": "怎么又是小仙子。",
  "0203Adv05_Leia015": "可是你想想，小仙子们围绕着我这个主演，是给周围增色的角色！<br>\n我认为这是舞台剧中非常重要的一点！",
  "0203Adv05_Hiro012": "请容我拒绝。<br>\n我再找找看有什么能帮忙的。",
  "0203Adv05_Leia016": "不管是亚里沙还是希罗都不好摆平呢。<br>\n但我是不会放弃的……呵呵呵。",
  "0203Adv05_Narrative013": "背后传来蕾雅无所畏忌的笑声。"
}
}
