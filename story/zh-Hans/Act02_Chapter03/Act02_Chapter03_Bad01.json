  "language": "zh-Hans",
  "path": "Act02_Chapter03/Act02_Chapter03_Bad01",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-3-b1", "line": 12, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 18, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "29_1"}},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 20, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Surprised1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "是啊，我确实有兴趣。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "诺亚就说嘛！大家都会想看的！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah001"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "只要安安愿意给我看，我就想看。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "吾辈……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "安安一脸苦闷地低下头，<br>\n含含糊糊地继续说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Flushed1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "……要是你们想看，<br>\n吾辈也不是不能给你们看……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn002"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "太好啦！<br>\n真期待能快点看到安安的小说呢。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah002"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "别抱那么大的期待。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn003"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "欸～诺亚做不到～<br>\n诺亚已经期待得不得了了嘛。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah003"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "唔唔……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn004"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "安安把小说写出来以后，<br>\n诺亚会给小说画很多很多插画！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah004"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "希罗也请期待一下哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah005"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "嗯，无论是小说还是插画，我都很期待能早日看到。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro003"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "在那以后，<br>\n她们两个一直热烈讨论者小说跟插画的话题。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative002"]}},
    {"op": "ResetText", "line": 65, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 66, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 67, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 69, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "又过了几天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative003"]}},
    {"op": "ResetText", "line": 73, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 75, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "ModifyBackgroundExtended", "line": 77, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 78, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（说起来，<br>\n　安安的小说写得怎样了呢）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro004"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "自那天起，安安也整天泡在诺亚的画室里，<br>\n同时进行剧本和小说的创作。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative004"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "前阵子听诺亚说，<br>\n安安好像快写完了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "（去看一下她的情况吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro005"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "等舞台剧的准备工作告一段落，<br>\n我便动身走向画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative006"]}},
    {"op": "ResetText", "line": 90, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 91, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000FF", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 92, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyBackgroundExtended", "line": 94, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "29_1"}},
    {"op": "ModifyBackgroundExtended", "line": 96, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#00000000", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 97, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Default"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "写作进展还行吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro006"]}},
    {"op": "HideAllCharacters", "line": 102, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Smile"}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Smile"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "啊，希罗……！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah006"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "……哦。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn005"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "诺亚正在画室里，看起来心情特别好。<br>\n还有安安，两眼正闪着激动的光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative007"]}},
    {"op": "EmoteJumpDouble", "line": 114, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "你听诺亚说！<br>\n安安的小说超级有趣哦！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah007"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "所以啊，<br>\n诺亚现在正在给小说画一张又一张插画！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah008"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "看来她们的工作重心<br>\n已经从舞台剧制作转移到小说创作上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative008"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "工作台上散落着一张张<br>\n写满文字的纸张跟画了图案的画纸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "诺亚真厉害。<br>\n这就是吾辈想像中里的景象。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn006"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "安安看起来十分感动。<br>\n她正目不转睛地盯着诺亚的画作。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative010"]}},
    {"op": "StopBgm", "line": 130, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "呵呵，好高兴～<br>\n但这还不算成品哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah009"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "什么意思？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro007"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "诺亚现在就来收尾～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah010"]}},
    {"op": "EmoteJump", "line": 138, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "Speed": 1.0}},
    {"op": "PlayBgm", "line": 140, "indent": 0, "params": {"BgmPath": "Bgm_34_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "喜笑颜开的诺亚拿起画笔划了几下后，<br>\n画里描绘的生物就逐一化为实体，<br>\n从纸面上跃出。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative011"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "看起来和真正存在的生物无异。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative012"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "这是……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile1"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "不管看几次都觉得好厉害。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn007"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "对吧对吧～？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah011"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "长角的兔子，气质神圣的白蛇。<br>\n除此以外，还有拥有锐利脚爪的飞鸟，<br>\n长得像龙的奇幻生物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative013"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "化为实体的那群生物就像跟诺亚和安安撒娇一般<br>\n往她们身上靠。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "其实啊，<br>\n除了这些小家伙以外还有其他动物哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah012"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "是吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "嗯！<br>\n诺亚从好几天前开始就跟安安一起想了好多，<br>\n也画出来好多。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah013"]}},
    {"op": "EmoteJumpDouble", "line": 170, "indent": 0, "params": {"ActorIds": ["Noah"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "对不对～安安？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah014"]}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Default"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "是啊，今天让它们守房间里去了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn008"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "啊，<br>\n可诺亚刚才回房间的时候不小心放走了几只……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah015"]}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "应该也有几只动物正在<br>\n房子里玩耍吧。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah016"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "那等会还是去抓回来比较好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro010"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "（不过，看起来也没有什么特别危险的动物，<br>\n　应该用不着太担心……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 190, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "看见少女和可爱生物嬉戏的温馨画面，<br>\n我的心也不由得放松了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative015"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "只是有一件事让我感到有些顾虑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 196, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "（诺亚的魔法竟然这都能做到吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro012"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "眼前的生物是那么的活灵活现，<br>\n让人想像不到那原本只是画中的形象。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "（说不定触感意外地……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro013"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "我这样想着，<br>\n向身旁一只像是兔子的生物伸出了手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative018"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "嗄啊啊啊啊啊啊！", "AuthorId": "Rabbit", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Rabbit001"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "SpawnShake", "line": 211, "indent": 0, "params": {"ActorId": "Hiro"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro014"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "一改刚才的温和模样，<br>\n那生物朝我露出威吓的獠牙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 219, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Angry"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "喂！<br>\n你怎么能这样凶希罗。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah017"]}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "就算受到诺亚跟安安的训斥，<br>\n兔子依然不减对我的敌意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 228, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "不仅这样，<br>\n就连其他生物也向我出显露出敌意，<br>\n仿佛要保护诺亚她们一般聚集到她们身边去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Default"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "看来它们只会亲近<br>\n创造者的安安跟诺亚呢。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro015"]}},
    {"op": "HideAllCharacters", "line": 236, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "怎么会……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah018"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "诺亚露出一副沮丧的模样。<br>\n此时，<br>\n闻声而至的众人也陆续走进了画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative022"]}},
    {"op": "HideAllCharacters", "line": 243, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Leia.Default"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "我刚才好像听到什么动物的叫声……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Leia001"]}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "欸……！<br>\n这些动物是怎么回事？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "重点是，这都是些什么动物？<br>\n兔子？可它头上长了角……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 256, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Default"}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "是诺亚画的。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn009"]}},
    {"op": "HideAllCharacters", "line": 261, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "诺亚？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Leia002"]}},
    {"op": "ModifyCharacterExtended", "line": 267, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "嗯，就是诺亚哦！<br>\n这都是打算用来给安安的小说做插画的，<br>\n诺亚画了好多呢。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah019"]}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "真的画了好多，超级多！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah020"]}},
    {"op": "ModifyCharacterExtended", "line": 273, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default"}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "用魔法竟然能让画里的生物<br>\n实体化到这种程度……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 277, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile"}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "你也太厉害了！诺亚！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "欸嘿嘿。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah021"]}},
    {"op": "ModifyCharacterExtended", "line": 285, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile"}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "这样的话，<br>\n这次舞台剧我们就能做到更多不同形式的表演。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 289, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Leia"}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "对了，机会难得，<br>\n要不让这些动物也上台表演——", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Leia006"]}},
    {"op": "StopBgm", "line": 293, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "说完，蕾雅往兔子走近一步。就在这时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative023"]}},
    {"op": "PlaySfxModified", "line": 298, "indent": 0, "params": {"SfxPath": "Sfx_46", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 299, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Fearful1"}},
    {"op": "Wait", "line": 300, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "HideActors", "line": 301, "indent": 0, "params": {"ActorIds": ["Leia"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "兔子朝蕾雅吐出一团火焰。<br>\n蕾雅瞬间被火焰吞没。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative024"]}},
    {"op": "PlaySfxModified", "line": 306, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 308, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "噫、咳哈……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Leia007"]}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "事情发生得实在过于突然，<br>\n在场所有人都只是呆呆地站着没有动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative025"]}},
    {"op": "HideAllCharacters", "line": 316, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hanna002"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "蕾雅……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Ema002"]}},
    {"op": "HideAllCharacters", "line": 324, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "烧得焦黑的蕾雅倒在地上。<br>\n——那似乎昭示着意外的开端。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative026"]}},
    {"op": "PlayBgm", "line": 328, "indent": 0, "params": {"BgmPath": "Bgm_34_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "围绕在诺亚跟安安身边的那群动物突然一跃而起，<br>\n向我们发起了攻击。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 332, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Fearful1"}},
    {"op": "Wait", "line": 333, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "ModifyCharacterExtended", "line": 334, "indent": 0, "params": {"Duration": 2.0, "Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna"}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "住……！住手！<br>\n别过来……不要！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hanna003"]}},
    {"op": "ResetText", "line": 338, "indent": 0, "params": {}},
    {"op": "ModifyCamera", "line": 339, "indent": 0, "params": {"Offset": [-2.0], "Zoom": 0.20000000298023224, "Duration": 0.20000000298023224, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 340, "indent": 0, "params": {"TintColor": "#550000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 341, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PlaySfxModified", "line": 344, "indent": 0, "params": {"SfxPath": "Sfx_10", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 346, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyCamera", "line": 347, "indent": 0, "params": {"Offset": [0.0], "Zoom": 0.0, "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 348, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 349, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 350, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Fearful1"}},
    {"op": "ModifyCharacterExtended", "line": 351, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Fearful1"}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "等、等等……！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah022"]}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "噫……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn010"]}},
    {"op": "PrintTextModified", "line": 357, "indent": 0, "params": {"Text": "汉娜被逼退至墙边。<br>\n龙把她的头颅给一下碾碎了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative028"]}},
    {"op": "HideAllCharacters", "line": 359, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 361, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "Wait", "line": 362, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 363, "indent": 0, "params": {"Duration": 4.0, "Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema"}},
    {"op": "PrintTextModified", "line": 365, "indent": 0, "params": {"Text": "不要……给我一边去！<br>\n诺亚，安安！<br>\n救我……快救我！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Ema003"]}},
    {"op": "HideAllCharacters", "line": 367, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 368, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Fearful1"}},
    {"op": "ModifyCharacterExtended", "line": 369, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Fearful1"}},
    {"op": "PrintTextModified", "line": 371, "indent": 0, "params": {"Text": "……啊，唔啊……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn011"]}},
    {"op": "PrintTextModified", "line": 373, "indent": 0, "params": {"Text": "艾玛！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah023"]}},
    {"op": "HideAllCharacters", "line": 375, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 376, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 377, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "Wait", "line": 378, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCamera", "line": 379, "indent": 0, "params": {"Offset": [0.0, 1.0], "Zoom": 0.20000000298023224, "Duration": 0.30000001192092896, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 380, "indent": 0, "params": {"TintColor": "#550000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 381, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PlaySfxModified", "line": 384, "indent": 0, "params": {"SfxPath": "Sfx_153", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "啊……呃……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Ema004"]}},
    {"op": "HideAllCharacters", "line": 390, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyCamera", "line": 391, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "Duration": 0.0, "Lazy": 0}},
    {"op": "PlaySfxModified", "line": 392, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 393, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 394, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 395, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 397, "indent": 0, "params": {"Text": "被白蛇缠住的艾玛痛苦地挣扎一番以后，<br>\n也倒下了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 399, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 400, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Fearful"}},
    {"op": "PrintTextModified", "line": 404, "indent": 0, "params": {"Text": "唔，唔……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_AnAn012"]}},
    {"op": "ModifyCharacterExtended", "line": 406, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Noah"}},
    {"op": "PrintTextModified", "line": 408, "indent": 0, "params": {"Text": "安安……？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah024"]}},
    {"op": "PrintTextModified", "line": 410, "indent": 0, "params": {"Text": "大概是无法接受<br>\n眼前突如其来的惨剧，<br>\n安安当场呕吐了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative030"]}},
    {"op": "HideAllCharacters", "line": 412, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 414, "indent": 0, "params": {"Text": "绞杀了艾玛的白蛇也来到了<br>\n我的面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 416, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Surprised"}},
    {"op": "PrintTextModified", "line": 418, "indent": 0, "params": {"Text": "希罗，快逃！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah025"]}},
    {"op": "HideAllCharacters", "line": 420, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 422, "indent": 0, "params": {"Text": "（我是想逃，可是……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro016"]}},
    {"op": "PrintTextModified", "line": 424, "indent": 0, "params": {"Text": "杀死了汉娜的龙就盘踞在门口，<br>\n围在诺亚跟安安身边的其他野兽也一直<br>\n对这边虎视眈眈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative032"]}},
    {"op": "PrintTextModified", "line": 426, "indent": 0, "params": {"Text": "（该怎么办……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro017"]}},
    {"op": "PrintTextModified", "line": 428, "indent": 0, "params": {"Text": "我有死亡回溯的魔法，<br>\n只要死了事情总能应付过去，<br>\n但诺亚应该是在几天前就开始画这些生物的画了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative033"]}},
    {"op": "PrintTextModified", "line": 430, "indent": 0, "params": {"Text": "（要是这样的话，就算通过死亡回溯到过去，<br>\n　它们也早就存在于监牢之内……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro018"]}},
    {"op": "ModifyBackgroundExtended", "line": 432, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 433, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 435, "indent": 0, "params": {"Text": "为时已晚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative034"]}},
    {"op": "ModifyBackgroundExtended", "line": 437, "indent": 0, "params": {"TintColor": "#550000FF", "Duration": 10.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 440, "indent": 0, "params": {"SfxPath": "Sfx_153", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 442, "indent": 0, "params": {"Text": "我想不到任何办法，<br>\n跟艾玛一样被白蛇缠住了脖子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative035"]}},
    {"op": "PrintTextModified", "line": 446, "indent": 0, "params": {"Text": "唔，呃……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro019"]}},
    {"op": "PrintTextModified", "line": 448, "indent": 0, "params": {"Text": "好痛苦，好痛苦好痛苦好痛苦——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative036"]}},
    {"op": "PrintTextModified", "line": 450, "indent": 0, "params": {"Text": "不要！希罗……希罗！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Noah026"]}},
    {"op": "PrintTextModified", "line": 452, "indent": 0, "params": {"Text": "诺亚想要冲过来，<br>\n却受到围绕在她身边的野兽<br>\n阻挡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative037"]}},
    {"op": "ModifyBackgroundExtended", "line": 454, "indent": 0, "params": {"TintColor": "#FFFFFFFF", "Duration": 15.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 456, "indent": 0, "params": {"Text": "一群神圣的野兽守卫着她们两人。<br>\n那个画面美丽得有如神话中的一幕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative038"]}},
    {"op": "PrintTextModified", "line": 458, "indent": 0, "params": {"Text": "明明是那么凄惨的时刻，<br>\n我的心情却宛如心灵得到洗涤一般圣洁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative039"]}},
    {"op": "PrintTextModified", "line": 460, "indent": 0, "params": {"Text": "（啊啊，<br>\n　你们真的成就了一部杰作啊——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Hiro020"]}},
    {"op": "PrintTextModified", "line": 462, "indent": 0, "params": {"Text": "眼前无法回避的事态让我感到深深的绝望，<br>\n但我依然带着满足的笑容咽下了最后一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Bad01_Narrative040"]}},
    {"op": "ProcessBadEnd", "line": 468, "indent": 0, "params": {"Number": 20}}
  ],
  "translations": {
  "0203Bad01_Hiro001": "是啊，我确实有兴趣。",
  "0203Bad01_Noah001": "诺亚就说嘛！大家都会想看的！",
  "0203Bad01_Hiro002": "只要安安愿意给我看，我就想看。",
  "0203Bad01_AnAn001": "吾辈……",
  "0203Bad01_Narrative001": "安安一脸苦闷地低下头，<br>\n含含糊糊地继续说道。",
  "0203Bad01_AnAn002": "……要是你们想看，<br>\n吾辈也不是不能给你们看……",
  "0203Bad01_Noah002": "太好啦！<br>\n真期待能快点看到安安的小说呢。",
  "0203Bad01_AnAn003": "别抱那么大的期待。",
  "0203Bad01_Noah003": "欸～诺亚做不到～<br>\n诺亚已经期待得不得了了嘛。",
  "0203Bad01_AnAn004": "唔唔……",
  "0203Bad01_Noah004": "安安把小说写出来以后，<br>\n诺亚会给小说画很多很多插画！",
  "0203Bad01_Noah005": "希罗也请期待一下哦。",
  "0203Bad01_Hiro003": "嗯，无论是小说还是插画，我都很期待能早日看到。",
  "0203Bad01_Narrative002": "在那以后，<br>\n她们两个一直热烈讨论者小说跟插画的话题。",
  "0203Bad01_Narrative003": "又过了几天。",
  "0203Bad01_Hiro004": "（说起来，<br>\n　安安的小说写得怎样了呢）",
  "0203Bad01_Narrative004": "自那天起，安安也整天泡在诺亚的画室里，<br>\n同时进行剧本和小说的创作。",
  "0203Bad01_Narrative005": "前阵子听诺亚说，<br>\n安安好像快写完了。",
  "0203Bad01_Hiro005": "（去看一下她的情况吧）",
  "0203Bad01_Narrative006": "等舞台剧的准备工作告一段落，<br>\n我便动身走向画室。",
  "0203Bad01_Hiro006": "写作进展还行吗？",
  "0203Bad01_Noah006": "啊，希罗……！",
  "0203Bad01_AnAn005": "……哦。",
  "0203Bad01_Narrative007": "诺亚正在画室里，看起来心情特别好。<br>\n还有安安，两眼正闪着激动的光。",
  "0203Bad01_Noah007": "你听诺亚说！<br>\n安安的小说超级有趣哦！",
  "0203Bad01_Noah008": "所以啊，<br>\n诺亚现在正在给小说画一张又一张插画！",
  "0203Bad01_Narrative008": "看来她们的工作重心<br>\n已经从舞台剧制作转移到小说创作上。",
  "0203Bad01_Narrative009": "工作台上散落着一张张<br>\n写满文字的纸张跟画了图案的画纸。",
  "0203Bad01_AnAn006": "诺亚真厉害。<br>\n这就是吾辈想像中里的景象。",
  "0203Bad01_Narrative010": "安安看起来十分感动。<br>\n她正目不转睛地盯着诺亚的画作。",
  "0203Bad01_Noah009": "呵呵，好高兴～<br>\n但这还不算成品哦。",
  "0203Bad01_Hiro007": "什么意思？",
  "0203Bad01_Noah010": "诺亚现在就来收尾～",
  "0203Bad01_Narrative011": "喜笑颜开的诺亚拿起画笔划了几下后，<br>\n画里描绘的生物就逐一化为实体，<br>\n从纸面上跃出。",
  "0203Bad01_Narrative012": "看起来和真正存在的生物无异。",
  "0203Bad01_Hiro008": "这是……",
  "0203Bad01_AnAn007": "不管看几次都觉得好厉害。",
  "0203Bad01_Noah011": "对吧对吧～？",
  "0203Bad01_Narrative013": "长角的兔子，气质神圣的白蛇。<br>\n除此以外，还有拥有锐利脚爪的飞鸟，<br>\n长得像龙的奇幻生物。",
  "0203Bad01_Narrative014": "化为实体的那群生物就像跟诺亚和安安撒娇一般<br>\n往她们身上靠。",
  "0203Bad01_Noah012": "其实啊，<br>\n除了这些小家伙以外还有其他动物哦。",
  "0203Bad01_Hiro009": "是吗？",
  "0203Bad01_Noah013": "嗯！<br>\n诺亚从好几天前开始就跟安安一起想了好多，<br>\n也画出来好多。",
  "0203Bad01_Noah014": "对不对～安安？",
  "0203Bad01_AnAn008": "是啊，今天让它们守房间里去了。",
  "0203Bad01_Noah015": "啊，<br>\n可诺亚刚才回房间的时候不小心放走了几只……",
  "0203Bad01_Noah016": "应该也有几只动物正在<br>\n房子里玩耍吧。",
  "0203Bad01_Hiro010": "那等会还是去抓回来比较好。",
  "0203Bad01_Hiro011": "（不过，看起来也没有什么特别危险的动物，<br>\n　应该用不着太担心……）",
  "0203Bad01_Narrative015": "看见少女和可爱生物嬉戏的温馨画面，<br>\n我的心也不由得放松了下来。",
  "0203Bad01_Narrative016": "只是有一件事让我感到有些顾虑。",
  "0203Bad01_Hiro012": "（诺亚的魔法竟然这都能做到吗）",
  "0203Bad01_Narrative017": "眼前的生物是那么的活灵活现，<br>\n让人想像不到那原本只是画中的形象。",
  "0203Bad01_Hiro013": "（说不定触感意外地……）",
  "0203Bad01_Narrative018": "我这样想着，<br>\n向身旁一只像是兔子的生物伸出了手。",
  "0203Bad01_Rabbit001": "嗄啊啊啊啊啊啊！",
  "0203Bad01_Hiro014": "——！",
  "0203Bad01_Narrative019": "一改刚才的温和模样，<br>\n那生物朝我露出威吓的獠牙。",
  "0203Bad01_Noah017": "喂！<br>\n你怎么能这样凶希罗。",
  "0203Bad01_Narrative020": "就算受到诺亚跟安安的训斥，<br>\n兔子依然不减对我的敌意。",
  "0203Bad01_Narrative021": "不仅这样，<br>\n就连其他生物也向我出显露出敌意，<br>\n仿佛要保护诺亚她们一般聚集到她们身边去。",
  "0203Bad01_Hiro015": "看来它们只会亲近<br>\n创造者的安安跟诺亚呢。",
  "0203Bad01_Noah018": "怎么会……",
  "0203Bad01_Narrative022": "诺亚露出一副沮丧的模样。<br>\n此时，<br>\n闻声而至的众人也陆续走进了画室。",
  "0203Bad01_Leia001": "我刚才好像听到什么动物的叫声……",
  "0203Bad01_Ema001": "欸……！<br>\n这些动物是怎么回事？",
  "0203Bad01_Hanna001": "重点是，这都是些什么动物？<br>\n兔子？可它头上长了角……",
  "0203Bad01_AnAn009": "是诺亚画的。",
  "0203Bad01_Leia002": "诺亚？",
  "0203Bad01_Noah019": "嗯，就是诺亚哦！<br>\n这都是打算用来给安安的小说做插画的，<br>\n诺亚画了好多呢。",
  "0203Bad01_Noah020": "真的画了好多，超级多！",
  "0203Bad01_Leia003": "用魔法竟然能让画里的生物<br>\n实体化到这种程度……",
  "0203Bad01_Leia004": "你也太厉害了！诺亚！",
  "0203Bad01_Noah021": "欸嘿嘿。",
  "0203Bad01_Leia005": "这样的话，<br>\n这次舞台剧我们就能做到更多不同形式的表演。",
  "0203Bad01_Leia006": "对了，机会难得，<br>\n要不让这些动物也上台表演——",
  "0203Bad01_Narrative023": "说完，蕾雅往兔子走近一步。就在这时候。",
  "0203Bad01_Narrative024": "兔子朝蕾雅吐出一团火焰。<br>\n蕾雅瞬间被火焰吞没。",
  "0203Bad01_Leia007": "噫、咳哈……",
  "0203Bad01_Narrative025": "事情发生得实在过于突然，<br>\n在场所有人都只是呆呆地站着没有动。",
  "0203Bad01_Hanna002": "——！",
  "0203Bad01_Ema002": "蕾雅……！？",
  "0203Bad01_Narrative026": "烧得焦黑的蕾雅倒在地上。<br>\n——那似乎昭示着意外的开端。",
  "0203Bad01_Narrative027": "围绕在诺亚跟安安身边的那群动物突然一跃而起，<br>\n向我们发起了攻击。",
  "0203Bad01_Hanna003": "住……！住手！<br>\n别过来……不要！！",
  "0203Bad01_Noah022": "等、等等……！",
  "0203Bad01_AnAn010": "噫……",
  "0203Bad01_Narrative028": "汉娜被逼退至墙边。<br>\n龙把她的头颅给一下碾碎了。",
  "0203Bad01_Ema003": "不要……给我一边去！<br>\n诺亚，安安！<br>\n救我……快救我！",
  "0203Bad01_AnAn011": "……啊，唔啊……",
  "0203Bad01_Noah023": "艾玛！",
  "0203Bad01_Ema004": "啊……呃……",
  "0203Bad01_Narrative029": "被白蛇缠住的艾玛痛苦地挣扎一番以后，<br>\n也倒下了。",
  "0203Bad01_AnAn012": "唔，唔……",
  "0203Bad01_Noah024": "安安……？",
  "0203Bad01_Narrative030": "大概是无法接受<br>\n眼前突如其来的惨剧，<br>\n安安当场呕吐了起来。",
  "0203Bad01_Narrative031": "绞杀了艾玛的白蛇也来到了<br>\n我的面前。",
  "0203Bad01_Noah025": "希罗，快逃！",
  "0203Bad01_Hiro016": "（我是想逃，可是……！）",
  "0203Bad01_Narrative032": "杀死了汉娜的龙就盘踞在门口，<br>\n围在诺亚跟安安身边的其他野兽也一直<br>\n对这边虎视眈眈。",
  "0203Bad01_Hiro017": "（该怎么办……）",
  "0203Bad01_Narrative033": "我有死亡回溯的魔法，<br>\n只要死了事情总能应付过去，<br>\n但诺亚应该是在几天前就开始画这些生物的画了。",
  "0203Bad01_Hiro018": "（要是这样的话，就算通过死亡回溯到过去，<br>\n　它们也早就存在于监牢之内……）",
  "0203Bad01_Narrative034": "为时已晚。",
  "0203Bad01_Narrative035": "我想不到任何办法，<br>\n跟艾玛一样被白蛇缠住了脖子。",
  "0203Bad01_Hiro019": "唔，呃……",
  "0203Bad01_Narrative036": "好痛苦，好痛苦好痛苦好痛苦——",
  "0203Bad01_Noah026": "不要！希罗……希罗！",
  "0203Bad01_Narrative037": "诺亚想要冲过来，<br>\n却受到围绕在她身边的野兽<br>\n阻挡。",
  "0203Bad01_Narrative038": "一群神圣的野兽守卫着她们两人。<br>\n那个画面美丽得有如神话中的一幕。",
  "0203Bad01_Narrative039": "明明是那么凄惨的时刻，<br>\n我的心情却宛如心灵得到洗涤一般圣洁。",
  "0203Bad01_Hiro020": "（啊啊，<br>\n　你们真的成就了一部杰作啊——）",
  "0203Bad01_Narrative040": "眼前无法回避的事态让我感到深深的绝望，<br>\n但我依然带着满足的笑容咽下了最后一口气。"
}
}
