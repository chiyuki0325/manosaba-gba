    {"op": "UpdateWitchBook", "line": 101, "indent": 0, "params": {"Id": "AnAn", "Category": "Profile", "Version": 6}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "投票结果不用说，自然是我——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative010"]}},
    {"op": "ModifyBackgroundExtended", "line": 105, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 106, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "于是，我被拘禁在惩罚室里了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative011"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "眼前的景象朦朦胧胧，看不真切。<br>\n一切仿佛都在远方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative012"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "（那时，艾玛是在……伪造现场吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Hiro002"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "我突然想到了这一点。<br>\n可是就连这个念头也飘然远去，<br>\n感觉全身的力气正在从身体深处被抽走。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative013"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "（就算是这样，我也做不到保持沉默）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Hiro003"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "就像昨晚，<br>\n安安再也无法忍受，向我们自白一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative014"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "从结果上来说，是我推了安安一把，害她掉了下去。<br>\n这是毫无疑问的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative015"]}},
    {"op": "ModifyBackgroundExtended", "line": 122, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 123, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "然后，安安死了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative016"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Hiro004"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "每次呼吸都会加重我的苦痛。<br>\n我已经看不到任何希望，<br>\n受到拘束的身体完全提不起挣扎的力气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative017"]}},
    {"op": "StopBgm", "line": 131, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "没有任何人来看我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative018"]}},
    {"op": "ResetText", "line": 135, "indent": 0, "params": {}},
