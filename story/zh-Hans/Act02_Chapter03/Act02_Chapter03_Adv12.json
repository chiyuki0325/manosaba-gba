    {"op": "Wait", "line": 139, "indent": 0, "params": {"WaitMode": "4"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "就这样——审判之时已到。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative019"]}},
