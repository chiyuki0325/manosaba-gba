    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "所有人都来到了会客厅。<br>\n在场没有一个人开口说话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful1,ArmR3"}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛像在忍受着什么似的咬紧嘴唇。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative002"]}},
    {"op": "HideAllCharacters", "line": 22, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Fearful1,ArmR8"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "蕾雅则是一副沮丧的模样，<br>\n抱着头苦恼不已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 27, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "得知安安的死以后，<br>\n其他人也因为这意外的打击而低垂着头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative004"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "至于我……我到现在依然没有任何真实感——<br>\n口里干渴，两脚发软，站都快要站不稳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative005"]}},
    {"op": "ResetText", "line": 33, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 36, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 38, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "就在此时，典狱长出现了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative006"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "哎呀呀……<br>\n发生凶杀案件了呢。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Warden001"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "最近这阵子明明那么和平……<br>\n果然你们还是无法抵抗那种冲动啊。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Warden002"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "那么接下来……<br>\n这次也请各位在审判开始前进行投票吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Warden003"]}},
    {"op": "HideAllCharacters", "line": 49, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "是我杀的……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Hiro001"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "是无意识的喃喃自语。<br>\n回过神来，我已经说出了这句话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative007"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "我的自首<br>\n让会客厅内的气氛骤然一变。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful1,ArmR3"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "希罗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "你这话是什么意思！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Hanna001"]}},
    {"op": "HideActors", "line": 65, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "这还能是什么意思，不就是像她说的那样……<br>\n希罗就是杀死安安的凶手。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Sherry001"]}},
    {"op": "HideActors", "line": 70, "indent": 0, "params": {"ActorIds": ["Hanna"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "希罗……把安安给……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Noah001"]}},
    {"op": "HideActors", "line": 75, "indent": 0, "params": {"ActorIds": ["Sherry"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "怎么会这样……可是，为什么……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Miria001"]}},
    {"op": "HideActors", "line": 80, "indent": 0, "params": {"ActorIds": ["Noah"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "都白费力气了呗。<br>\n就算再怎么继续玩好朋友过家家，<br>\n我们都已经……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Alisa001"]}},
    {"op": "HideActors", "line": 85, "indent": 0, "params": {"ActorIds": ["Miria"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Fearful1,ArmR1"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "希罗，你……！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Leia001"]}},
    {"op": "HideAllCharacters", "line": 90, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "我无法直视任何人的眼睛。<br>\n我只是低着头，静静等待投票结果的公布。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv12_Narrative009"]}},
    {"op": "ResetText", "line": 94, "indent": 0, "params": {}},
