  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-3-7", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "11_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlaySfxModified", "line": 19, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 21, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "艾玛，很好哦～<br>\n哦，侧面角度也棒极了～", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Ema.Flushed1"}},
    {"op": "PlaySfxModified", "line": 28, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我、我说，米莉亚……<br>\n别拍了，<br>\n你帮我看看我演得怎样吧……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Smile"}},
    {"op": "Wait", "line": 33, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 36, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "为难的表情也好可爱啊～", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria002"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Smile"}},
    {"op": "Wait", "line": 41, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 42, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "当我进入娱乐室的时候，<br>\n正好看到米莉亚拿着手机围着艾玛转。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Smile"}},
    {"op": "Wait", "line": 47, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 48, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "快门声咔嚓咔嚓地不停在房间内回响。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hiro.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "你们这……是在干什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro001"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "我无法判断是否可以走进房间内，<br>\n只好站在门口问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "啊，希罗……<br>\n我们这是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema002"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "艾玛对我的态度<br>\n有着些许的不知所措。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative004"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "可能是因为之前的冲突让她心有余悸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative005"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "在地下的房间里，<br>\n我跟艾玛依然完全没有交流。<br>\n这种疏远的关系一直维持至今。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "剧本不是已经出来了嘛？虽然就只有开头的一点点。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria003"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "艾玛吞吞吐吐地说不出话来，<br>\n米莉亚便代她开口，向我说明事情的缘由。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative007"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "所以艾玛<br>\n就来找大叔我来帮忙看看她演得怎样。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "……可我看你们也不像是那么回事啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro002"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "听到我的疑问，米莉亚难为情地笑了笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "这个嘛……怎么说呢……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria005"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "米莉亚含糊其辞的模样让我不解。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Surprised1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "就在这时候，米莉亚突然露出一副恍然大悟的模样，<br>\n迅速把手机镜头对准我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative010"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "然后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative011"]}},
    {"op": "PlaySfxModified", "line": 98, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "不知道出于什么想法，她给我拍了一张照。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "仔细检查过手机上的画面后，<br>\n米莉亚满意地点了点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Miria"}},
    {"op": "Wait", "line": 107, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [55.0], "IdAndAppearance": "Miria.Smile"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "接着，她把手机递到我面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative014"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "看，拍得很可爱哦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria006"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "手机画面上显示的，是我歪着头，一脸不明所以的照片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "……你这是想干什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro003"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "这种行为着实让人不快。<br>\n我皱着眉头，用镇静的语气问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Surprised"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "突、突然给你拍照，对不起！<br>\n最近大叔我有点沉迷摄影嘛。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria007"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "米莉亚慌忙向我解释道。<br>\n但她在下一瞬间，却显得有些忧伤。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "我们以后会怎样，不是谁都说不准嘛？<br>\n所以啊……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria008"]}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Angry1"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "大叔我就想着……<br>\n要把现在的每一个瞬间都记录下来！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria009"]}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "可是这样突然拍别人确实很没礼貌吧。<br>\n大叔我就是看着可爱，一下子没忍住……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria010"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "……没错。<br>\n未经允许擅自拍下照片，<br>\n被拍的人心里肯定会觉得不舒服。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro004"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "这种行为还有可能<br>\n侵害他人肖像权。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro005"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "假如你未经本人同意私自将照片公开，<br>\n也有可能被判定为诽谤或者侵犯个人隐私。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Surprised1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "我沉声静气地向米莉亚讲述<br>\n刑法的相关条文。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative018"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "若被认定造成诽谤，<br>\n将可能判处三年以下的有期徒刑，<br>\n并处五十万日元以下的罚款。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Fearful1"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "说到这里，米莉亚已经吓得脸色发白，<br>\n看着都让我觉得可怜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Cry1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "原来是这样……<br>\n呜呜……以后我会注意……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria011"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "可是，可是啊，<br>\n大叔我绝对不会把照片乱上传或者公开哦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria012"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "这一点我可以对天发誓，<br>\n不过，大叔我已经知道错了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria013"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "米莉亚低头丧气的，<br>\n看起来已经在反省。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative021"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "说不定没必要担心那么多。<br>\n也许外面世界的法律对我们来说已经没有意义了。<br>\n因为，我们早就是笼中鸟、阶下囚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative022"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "（话题虽然跑偏了，<br>\n　但我基本上明白了事情的前因后果）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro007"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "在品评艾玛演技如何的过程中，<br>\n米莉亚受到刚才所说的那股冲动驱使，开始给艾玛拍照。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "尽心尽力的艾玛<br>\n那么的楚楚可怜……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria014"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "台词说得磕磕巴巴，紧张得动作都不利索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative024"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "反正就是这一切全都戳中了米莉亚的喜好。<br>\n就像受到某种使命感所驱使一般，她大力主张这一点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Angry1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "那么可爱的样子一定得拍下来才行！", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria015"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Flushed"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "唔唔……<br>\n你别这样，太难为情了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema003"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "艾玛红着脸挤出这句话来。<br>\n突然，她神色黯淡，垂下头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "可是……选我真的好吗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Surprised"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "欸，你说的哪回事？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria016"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "我是个外行，演技完全不行，<br>\n就连背台词，都完全没有自信能做好……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema005"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "我这么没用，却让我出演重要角色，<br>\n还给我做了这么漂亮的舞台服……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 208, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "然后呢？<br>\n难不成你还想说要辞演？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro008"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "我不由地插嘴道。<br>\n话语不受我的控制冲口而出。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative027"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "除了蕾雅以外，所有人都是外行。<br>\n就算是这样，大家都斗志昂扬地在努力。<br>\n一句“没有自信”，你就想擅自一个人放弃？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "我、我没有这个意思！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema007"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "艾玛慌了神似的极力否定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative028"]}},
    {"op": "ModifyCharacterExtended", "line": 223, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "我肯定也是想努力的……<br>\n我只是，觉得心里没底……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Ema008"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "艾玛垂着眼，声音小得仿佛随时会消散在空气中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive"}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "欸……那个……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Miria017"]}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "站在我和艾玛之间的米莉亚看起来有点尴尬，<br>\n眼神游移不定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative030"]}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "察觉到这一点后，<br>\n我深深地呼出一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative031"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "虽然理智上知道应该怎么做，<br>\n但心里却仍有某种感情无法释怀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative032"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "为了避免出现更多的牺牲，<br>\n就算只是表面上也好，<br>\n我跟艾玛的关系也必须找到一个折中的点才行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative033"]}},
    {"op": "ModifyCharacterExtended", "line": 244, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "（我果然还是尽量避免跟艾玛对话为好）<br>", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Hiro010"]}},
    {"op": "HideAllCharacters", "line": 248, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "我无言，转身离开了娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv07_Narrative034"]}},
    {"op": "Gosub", "line": 257, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 259, "indent": 0, "params": {"Path": "Act02_Chapter03/Act02_Chapter03_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0203Adv07_Miria001": "艾玛，很好哦～<br>\n哦，侧面角度也棒极了～",
  "0203Adv07_Ema001": "我、我说，米莉亚……<br>\n别拍了，<br>\n你帮我看看我演得怎样吧……",
  "0203Adv07_Miria002": "为难的表情也好可爱啊～",
  "0203Adv07_Narrative001": "当我进入娱乐室的时候，<br>\n正好看到米莉亚拿着手机围着艾玛转。",
  "0203Adv07_Narrative002": "快门声咔嚓咔嚓地不停在房间内回响。",
  "0203Adv07_Hiro001": "你们这……是在干什么？",
  "0203Adv07_Narrative003": "我无法判断是否可以走进房间内，<br>\n只好站在门口问道。",
  "0203Adv07_Ema002": "啊，希罗……<br>\n我们这是……",
  "0203Adv07_Narrative004": "艾玛对我的态度<br>\n有着些许的不知所措。",
  "0203Adv07_Narrative005": "可能是因为之前的冲突让她心有余悸。",
  "0203Adv07_Narrative006": "在地下的房间里，<br>\n我跟艾玛依然完全没有交流。<br>\n这种疏远的关系一直维持至今。",
  "0203Adv07_Miria003": "剧本不是已经出来了嘛？虽然就只有开头的一点点。",
  "0203Adv07_Narrative007": "艾玛吞吞吐吐地说不出话来，<br>\n米莉亚便代她开口，向我说明事情的缘由。",
  "0203Adv07_Miria004": "所以艾玛<br>\n就来找大叔我来帮忙看看她演得怎样。",
  "0203Adv07_Hiro002": "……可我看你们也不像是那么回事啊。",
  "0203Adv07_Narrative008": "听到我的疑问，米莉亚难为情地笑了笑。",
  "0203Adv07_Miria005": "这个嘛……怎么说呢……",
  "0203Adv07_Narrative009": "米莉亚含糊其辞的模样让我不解。",
  "0203Adv07_Narrative010": "就在这时候，米莉亚突然露出一副恍然大悟的模样，<br>\n迅速把手机镜头对准我。",
  "0203Adv07_Narrative011": "然后——",
  "0203Adv07_Narrative012": "不知道出于什么想法，她给我拍了一张照。",
  "0203Adv07_Narrative013": "仔细检查过手机上的画面后，<br>\n米莉亚满意地点了点头。",
  "0203Adv07_Narrative014": "接着，她把手机递到我面前。",
  "0203Adv07_Miria006": "看，拍得很可爱哦。",
  "0203Adv07_Narrative015": "手机画面上显示的，是我歪着头，一脸不明所以的照片。",
  "0203Adv07_Hiro003": "……你这是想干什么？",
  "0203Adv07_Narrative016": "这种行为着实让人不快。<br>\n我皱着眉头，用镇静的语气问道。",
  "0203Adv07_Miria007": "突、突然给你拍照，对不起！<br>\n最近大叔我有点沉迷摄影嘛。",
  "0203Adv07_Narrative017": "米莉亚慌忙向我解释道。<br>\n但她在下一瞬间，却显得有些忧伤。",
  "0203Adv07_Miria008": "我们以后会怎样，不是谁都说不准嘛？<br>\n所以啊……",
  "0203Adv07_Miria009": "大叔我就想着……<br>\n要把现在的每一个瞬间都记录下来！",
  "0203Adv07_Miria010": "可是这样突然拍别人确实很没礼貌吧。<br>\n大叔我就是看着可爱，一下子没忍住……",
  "0203Adv07_Hiro004": "……没错。<br>\n未经允许擅自拍下照片，<br>\n被拍的人心里肯定会觉得不舒服。",
  "0203Adv07_Hiro005": "这种行为还有可能<br>\n侵害他人肖像权。",
  "0203Adv07_Hiro006": "假如你未经本人同意私自将照片公开，<br>\n也有可能被判定为诽谤或者侵犯个人隐私。",
  "0203Adv07_Narrative018": "我沉声静气地向米莉亚讲述<br>\n刑法的相关条文。",
  "0203Adv07_Narrative019": "若被认定造成诽谤，<br>\n将可能判处三年以下的有期徒刑，<br>\n并处五十万日元以下的罚款。",
  "0203Adv07_Narrative020": "说到这里，米莉亚已经吓得脸色发白，<br>\n看着都让我觉得可怜。",
  "0203Adv07_Miria011": "原来是这样……<br>\n呜呜……以后我会注意……",
  "0203Adv07_Miria012": "可是，可是啊，<br>\n大叔我绝对不会把照片乱上传或者公开哦。",
  "0203Adv07_Miria013": "这一点我可以对天发誓，<br>\n不过，大叔我已经知道错了。",
  "0203Adv07_Narrative021": "米莉亚低头丧气的，<br>\n看起来已经在反省。",
  "0203Adv07_Narrative022": "说不定没必要担心那么多。<br>\n也许外面世界的法律对我们来说已经没有意义了。<br>\n因为，我们早就是笼中鸟、阶下囚。",
  "0203Adv07_Hiro007": "（话题虽然跑偏了，<br>\n　但我基本上明白了事情的前因后果）",
  "0203Adv07_Narrative023": "在品评艾玛演技如何的过程中，<br>\n米莉亚受到刚才所说的那股冲动驱使，开始给艾玛拍照。",
  "0203Adv07_Miria014": "尽心尽力的艾玛<br>\n那么的楚楚可怜……",
  "0203Adv07_Narrative024": "台词说得磕磕巴巴，紧张得动作都不利索。",
  "0203Adv07_Narrative025": "反正就是这一切全都戳中了米莉亚的喜好。<br>\n就像受到某种使命感所驱使一般，她大力主张这一点。",
  "0203Adv07_Miria015": "那么可爱的样子一定得拍下来才行！",
  "0203Adv07_Ema003": "唔唔……<br>\n你别这样，太难为情了。",
  "0203Adv07_Narrative026": "艾玛红着脸挤出这句话来。<br>\n突然，她神色黯淡，垂下头来。",
  "0203Adv07_Ema004": "可是……选我真的好吗。",
  "0203Adv07_Miria016": "欸，你说的哪回事？",
  "0203Adv07_Ema005": "我是个外行，演技完全不行，<br>\n就连背台词，都完全没有自信能做好……",
  "0203Adv07_Ema006": "我这么没用，却让我出演重要角色，<br>\n还给我做了这么漂亮的舞台服……",
  "0203Adv07_Hiro008": "然后呢？<br>\n难不成你还想说要辞演？",
  "0203Adv07_Narrative027": "我不由地插嘴道。<br>\n话语不受我的控制冲口而出。",
  "0203Adv07_Hiro009": "除了蕾雅以外，所有人都是外行。<br>\n就算是这样，大家都斗志昂扬地在努力。<br>\n一句“没有自信”，你就想擅自一个人放弃？",
  "0203Adv07_Ema007": "我、我没有这个意思！",
  "0203Adv07_Narrative028": "艾玛慌了神似的极力否定。",
  "0203Adv07_Ema008": "我肯定也是想努力的……<br>\n我只是，觉得心里没底……",
  "0203Adv07_Narrative029": "艾玛垂着眼，声音小得仿佛随时会消散在空气中。",
  "0203Adv07_Miria017": "欸……那个……",
  "0203Adv07_Narrative030": "站在我和艾玛之间的米莉亚看起来有点尴尬，<br>\n眼神游移不定。",
  "0203Adv07_Narrative031": "察觉到这一点后，<br>\n我深深地呼出一口气。",
  "0203Adv07_Narrative032": "虽然理智上知道应该怎么做，<br>\n但心里却仍有某种感情无法释怀。",
  "0203Adv07_Narrative033": "为了避免出现更多的牺牲，<br>\n就算只是表面上也好，<br>\n我跟艾玛的关系也必须找到一个折中的点才行。",
  "0203Adv07_Hiro010": "（我果然还是尽量避免跟艾玛对话为好）<br>",
  "0203Adv07_Narrative034": "我无言，转身离开了娱乐室。"
}
}
