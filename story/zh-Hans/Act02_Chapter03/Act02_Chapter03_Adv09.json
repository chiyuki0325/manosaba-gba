  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter03/Act02_Chapter03_Adv09",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-3-9", "line": 4, "indent": 0},
    {"op": "PlayBgm", "line": 10, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 12, "indent": 0, "params": {"Text": "——过了几天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative001"]}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "自那之后，<br>\n我们一同尽心尽力投入到舞台剧的制作当中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative002"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "然后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative003"]}},
    {"op": "ResetText", "line": 18, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "ModifyBackgroundExtended", "line": 24, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 25, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "各位，可以听我说几句吗。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Leia001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "晚餐时刻。<br>\n蕾雅突然站起来向所有人说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmL3"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "首先请允许我在此向各位道谢。<br>\n衷心感谢大家。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Leia002"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "蕾雅把手放在胸口，<br>\n恭敬地鞠了一躬。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative005"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "多亏大家的努力，<br>\n舞台剧的制作进展非常顺利。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Leia003"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "从剧本、服装，到背景制作、演技训练……<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative006"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "在这几天里，我们一路同心协力，<br>\n只为打造一场舞台剧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative007"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "就连一开始那么抗拒的亚里沙，<br>\n也在不知不觉中参与进来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative008"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "我也在调查大魔女的空余时间内<br>\n尽所能地提供协助。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative009"]}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Default"}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Default,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "我自然而然地看向安安。<br>\n她应该也是一直看着我，我们的视线重合了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative010"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn001"]}},
    {"op": "HideAllCharacters", "line": 55, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "（哎呀呀）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro001"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "可能是感到窘迫吧，安安马上低下了头。<br>\n我轻轻叹了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "明天，我们的舞台剧终于要正式开演。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Leia004"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "蕾雅郑重其事地说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative012"]}},
    {"op": "HideAllCharacters", "line": 67, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "唔、唔唔，马上就要正式上场了呢。<br>\n我能好好演完吗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Smile"}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "我们花了这么多时间精力去练习，没问题的！<br>\n如果发生什么万一，我也会来圆场！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Sherry001"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "你这听起来也不怎么能让人放心啊……<br>\n不过嘛，我觉得艾玛肯定能演好。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hanna001"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "咦？<br>\n难不成这是在暗指我演不好？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Sherry002"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "面对紧张的艾玛，<br>\n雪莉和汉娜努力安抚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative013"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "已经尽最大努力反复练习过了，<br>\n所以你可以自信一点……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative014"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "看来她们的鼓励<br>\n让艾玛放下了一些心理负担。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "雪莉，汉娜……<br>\n谢谢你们！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Ema002"]}},
    {"op": "HideAllCharacters", "line": 91, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Default"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "安安，<br>\n剧本已经没有什么需要修改的地方了对吧？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "嗯，不用担心。<br>\n剧本真的写得很精彩哦！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Leia005"]}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "嗯，我光是读剧本就已经觉得很感人了。<br>\n安安真的很厉害呢。我也会加油的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Ema003"]}},
    {"op": "StopBgm", "line": 105, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 108, "indent": 0, "params": {"SfxPath": "Sfx_136", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 110, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "这时安安突然站了起来。<br>\n她惊恐得脸色发青。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative016"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Fearful1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "……不对。我要坦白。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn002"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "欸……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Ema004"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "写出剧本的人，不是吾辈。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn003"]}},
    {"op": "PlayBgm", "line": 129, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "安安挤出的这句话里掺杂着苦涩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "吾辈，根本没写多少。<br>\n所以说，那是让希罗帮忙，<br>\n甚至可以说，几乎都是希罗写出来的，作品……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn004"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "（用不着特意说出来吧……<br>\n　但我能理解她无法释怀的心情）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro002"]}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "这是什么时候的事……？<br>\n诺亚怎么完全不知道。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Noah001"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "吾辈写不出来，<br>\n希罗察觉到这一点后，就到图书室陪吾辈一起写……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn005"]}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "可剧情不都是你想出来的吗？<br>\n那你就是参与了啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "就是啊！<br>\n剧本是你跟希罗两个人携手创作出来的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 158, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Cry1"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn006"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "安安却没能接受这些安慰的话语，<br>\n早已泪眼汪汪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative018"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "我走到安安身旁，<br>\n轻轻把手放在她的头上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Default"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "确实大部分都是我在写。<br>\n可是你也没有逃避，一直努力到最后。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro003"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "为了写出自己认为有趣的作品，<br>\n你一直都在用心对待这份工作。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro004"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "这些我都看在眼里，我很清楚这一点。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 175, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "……嗯、嗯，诺亚也是！<br>\n诺亚也很清楚，<br>\n安安很拼命很努力！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Noah002"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Smile"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "没错，大叔我也看到了哦。<br>\n安安真的很认真。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Miria002"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Default"}},
    {"op": "ModifyCharacterExtended", "line": 186, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "你胸怀如此强大的意志，<br>\n今后会有长足进步的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro006"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "你将来不是要当文豪吗？<br>\n努力创作下一部作品就好。我很期待哦。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro007"]}},
    {"op": "HideAllCharacters", "line": 192, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "安安终于打起精神抬起了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 196, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Angry1"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "没、没错……！<br>\n吾辈终有一天会当上文豪。<br>\n等、等着瞧吧……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn007"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "下次吾辈一定会写出一部<br>\n让所有人感动得说不出话的巨作……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_AnAn008"]}},
    {"op": "HideAllCharacters", "line": 202, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Default"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "好。期待你的杰作。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro008"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "安安充满朝气的宣言<br>\n让在场一众少女之间的紧张气氛缓和了不少。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 209, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "还有诺亚还有诺亚！大家听诺亚说！<br>\n背景虽然还剩一点没画完……<br>\n能够画画，诺亚真的好开心～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Noah003"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "做布景的时候啊，<br>\n亚里沙帮了诺亚很多很多哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Noah004"]}},
    {"op": "HideAllCharacters", "line": 216, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah"}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Flushed1"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "啧，谁叫你老在中庭晃悠，我是没办法才做。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Alisa002"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "（——蕾雅的计划很顺利）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro009"]}},
    {"op": "HideAllCharacters", "line": 224, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "我打从心底地感受到。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative022"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "通过制作这场舞台剧，<br>\n确实加深了彼此之间的交流。<br>\n我甚至觉得，我们之间正在开始产生一种无法割舍的纽带。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative023"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "（即使不论那些，上演舞台剧这件事本身就让我非常期待……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "就让典狱长和看守一起来欣赏<br>\n我们倾心打造的精彩表演吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Leia006"]}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "只要看到我们之间关系有多么融洽，联系有多么紧密，<br>\n说不定它们就会改变心意。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Leia007"]}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "蕾雅眼中散发着光彩，<br>\n满怀热情地谈着心中理想。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative024"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "——这群少女同心协力打造出一场舞台剧，并且这期间无人被杀，<br>\n所以她们已经不会再变成魔女了。<br>\n让它们得出这样的结论，并释放所有人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative025"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "如果事情能这样发展，那该有多好。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative026"]}},
    {"op": "HideAllCharacters", "line": 244, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 246, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "说得对……嗯，加油吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Ema005"]}},
    {"op": "HideAllCharacters", "line": 250, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "蕾雅说的这些，说到底只是理想化的愿望。<br>\n尽管如此，她们也想要心怀希望吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative027"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "大家都认同这个理想，为了正式上演，<br>\n正在不断巩固彼此之间的团结。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative028"]}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "与此同时，我的心中也怀着一份冷静。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative029"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "只是让它们看一场舞台剧，<br>\n不可能让我们的状况发生任何改变。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative030"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "（就算是这样，这一切也有意义）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Hiro011"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "巩固彼此的关系确实有效。<br>\n最近这几天，完全没有会发生凶杀案的氛围。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative031"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "据我所知，这几天大家没有发生任何争执，<br>\n日子过得非常平和。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative032"]}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "虽然我跟艾玛之间的关系依然别扭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative033"]}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "不再让任何人继续牺牲，<br>\n并制裁一切不幸的元凶——大魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative034"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "这些一定都会顺利实现。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative035"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "虽然我并不会胸怀这种天真的理想，<br>\n但这几天的经历，让我也逐渐变得积极乐观起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv09_Narrative036"]}},
    {"op": "Gosub", "line": 274, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 276, "indent": 0, "params": {"Path": "Act02_Chapter03/Act02_Chapter03_Adv10", "SoftReset": 1}}
  ],
  "translations": {
  "0203Adv09_Narrative001": "——过了几天。",
  "0203Adv09_Narrative002": "自那之后，<br>\n我们一同尽心尽力投入到舞台剧的制作当中。",
  "0203Adv09_Narrative003": "然后——",
  "0203Adv09_Leia001": "各位，可以听我说几句吗。",
  "0203Adv09_Narrative004": "晚餐时刻。<br>\n蕾雅突然站起来向所有人说道。",
  "0203Adv09_Leia002": "首先请允许我在此向各位道谢。<br>\n衷心感谢大家。",
  "0203Adv09_Narrative005": "蕾雅把手放在胸口，<br>\n恭敬地鞠了一躬。",
  "0203Adv09_Leia003": "多亏大家的努力，<br>\n舞台剧的制作进展非常顺利。",
  "0203Adv09_Narrative006": "从剧本、服装，到背景制作、演技训练……<br>",
  "0203Adv09_Narrative007": "在这几天里，我们一路同心协力，<br>\n只为打造一场舞台剧。",
  "0203Adv09_Narrative008": "就连一开始那么抗拒的亚里沙，<br>\n也在不知不觉中参与进来。",
  "0203Adv09_Narrative009": "我也在调查大魔女的空余时间内<br>\n尽所能地提供协助。",
  "0203Adv09_Narrative010": "我自然而然地看向安安。<br>\n她应该也是一直看着我，我们的视线重合了。",
  "0203Adv09_AnAn001": "…………",
  "0203Adv09_Hiro001": "（哎呀呀）",
  "0203Adv09_Narrative011": "可能是感到窘迫吧，安安马上低下了头。<br>\n我轻轻叹了一口气。",
  "0203Adv09_Leia004": "明天，我们的舞台剧终于要正式开演。",
  "0203Adv09_Narrative012": "蕾雅郑重其事地说道。",
  "0203Adv09_Ema001": "唔、唔唔，马上就要正式上场了呢。<br>\n我能好好演完吗……",
  "0203Adv09_Sherry001": "我们花了这么多时间精力去练习，没问题的！<br>\n如果发生什么万一，我也会来圆场！",
  "0203Adv09_Hanna001": "你这听起来也不怎么能让人放心啊……<br>\n不过嘛，我觉得艾玛肯定能演好。",
  "0203Adv09_Sherry002": "咦？<br>\n难不成这是在暗指我演不好？",
  "0203Adv09_Narrative013": "面对紧张的艾玛，<br>\n雪莉和汉娜努力安抚。",
  "0203Adv09_Narrative014": "已经尽最大努力反复练习过了，<br>\n所以你可以自信一点……",
  "0203Adv09_Narrative015": "看来她们的鼓励<br>\n让艾玛放下了一些心理负担。",
  "0203Adv09_Ema002": "雪莉，汉娜……<br>\n谢谢你们！",
  "0203Adv09_Miria001": "安安，<br>\n剧本已经没有什么需要修改的地方了对吧？",
  "0203Adv09_Leia005": "嗯，不用担心。<br>\n剧本真的写得很精彩哦！",
  "0203Adv09_Ema003": "嗯，我光是读剧本就已经觉得很感人了。<br>\n安安真的很厉害呢。我也会加油的。",
  "0203Adv09_Narrative016": "这时安安突然站了起来。<br>\n她惊恐得脸色发青。",
  "0203Adv09_AnAn002": "……不对。我要坦白。",
  "0203Adv09_Ema004": "欸……",
  "0203Adv09_AnAn003": "写出剧本的人，不是吾辈。",
  "0203Adv09_Narrative017": "安安挤出的这句话里掺杂着苦涩。",
  "0203Adv09_AnAn004": "吾辈，根本没写多少。<br>\n所以说，那是让希罗帮忙，<br>\n甚至可以说，几乎都是希罗写出来的，作品……",
  "0203Adv09_Hiro002": "（用不着特意说出来吧……<br>\n　但我能理解她无法释怀的心情）",
  "0203Adv09_Noah001": "这是什么时候的事……？<br>\n诺亚怎么完全不知道。",
  "0203Adv09_AnAn005": "吾辈写不出来，<br>\n希罗察觉到这一点后，就到图书室陪吾辈一起写……",
  "0203Adv09_Alisa001": "可剧情不都是你想出来的吗？<br>\n那你就是参与了啊。",
  "0203Adv09_Sherry003": "就是啊！<br>\n剧本是你跟希罗两个人携手创作出来的！",
  "0203Adv09_AnAn006": "…………",
  "0203Adv09_Narrative018": "安安却没能接受这些安慰的话语，<br>\n早已泪眼汪汪。",
  "0203Adv09_Narrative019": "我走到安安身旁，<br>\n轻轻把手放在她的头上。",
  "0203Adv09_Hiro003": "确实大部分都是我在写。<br>\n可是你也没有逃避，一直努力到最后。",
  "0203Adv09_Hiro004": "为了写出自己认为有趣的作品，<br>\n你一直都在用心对待这份工作。",
  "0203Adv09_Hiro005": "这些我都看在眼里，我很清楚这一点。",
  "0203Adv09_Noah002": "……嗯、嗯，诺亚也是！<br>\n诺亚也很清楚，<br>\n安安很拼命很努力！",
  "0203Adv09_Miria002": "没错，大叔我也看到了哦。<br>\n安安真的很认真。",
  "0203Adv09_Hiro006": "你胸怀如此强大的意志，<br>\n今后会有长足进步的。",
  "0203Adv09_Hiro007": "你将来不是要当文豪吗？<br>\n努力创作下一部作品就好。我很期待哦。",
  "0203Adv09_Narrative020": "安安终于打起精神抬起了头。",
  "0203Adv09_AnAn007": "没、没错……！<br>\n吾辈终有一天会当上文豪。<br>\n等、等着瞧吧……！",
  "0203Adv09_AnAn008": "下次吾辈一定会写出一部<br>\n让所有人感动得说不出话的巨作……！",
  "0203Adv09_Hiro008": "好。期待你的杰作。",
  "0203Adv09_Narrative021": "安安充满朝气的宣言<br>\n让在场一众少女之间的紧张气氛缓和了不少。",
  "0203Adv09_Noah003": "还有诺亚还有诺亚！大家听诺亚说！<br>\n背景虽然还剩一点没画完……<br>\n能够画画，诺亚真的好开心～",
  "0203Adv09_Noah004": "做布景的时候啊，<br>\n亚里沙帮了诺亚很多很多哦。",
  "0203Adv09_Alisa002": "啧，谁叫你老在中庭晃悠，我是没办法才做。",
  "0203Adv09_Hiro009": "（——蕾雅的计划很顺利）",
  "0203Adv09_Narrative022": "我打从心底地感受到。",
  "0203Adv09_Narrative023": "通过制作这场舞台剧，<br>\n确实加深了彼此之间的交流。<br>\n我甚至觉得，我们之间正在开始产生一种无法割舍的纽带。",
  "0203Adv09_Hiro010": "（即使不论那些，上演舞台剧这件事本身就让我非常期待……）",
  "0203Adv09_Leia006": "就让典狱长和看守一起来欣赏<br>\n我们倾心打造的精彩表演吧。",
  "0203Adv09_Leia007": "只要看到我们之间关系有多么融洽，联系有多么紧密，<br>\n说不定它们就会改变心意。",
  "0203Adv09_Narrative024": "蕾雅眼中散发着光彩，<br>\n满怀热情地谈着心中理想。",
  "0203Adv09_Narrative025": "——这群少女同心协力打造出一场舞台剧，并且这期间无人被杀，<br>\n所以她们已经不会再变成魔女了。<br>\n让它们得出这样的结论，并释放所有人。",
  "0203Adv09_Narrative026": "如果事情能这样发展，那该有多好。",
  "0203Adv09_Ema005": "说得对……嗯，加油吧！",
  "0203Adv09_Narrative027": "蕾雅说的这些，说到底只是理想化的愿望。<br>\n尽管如此，她们也想要心怀希望吧。",
  "0203Adv09_Narrative028": "大家都认同这个理想，为了正式上演，<br>\n正在不断巩固彼此之间的团结。",
  "0203Adv09_Narrative029": "与此同时，我的心中也怀着一份冷静。",
  "0203Adv09_Narrative030": "只是让它们看一场舞台剧，<br>\n不可能让我们的状况发生任何改变。",
  "0203Adv09_Hiro011": "（就算是这样，这一切也有意义）",
  "0203Adv09_Narrative031": "巩固彼此的关系确实有效。<br>\n最近这几天，完全没有会发生凶杀案的氛围。",
  "0203Adv09_Narrative032": "据我所知，这几天大家没有发生任何争执，<br>\n日子过得非常平和。",
  "0203Adv09_Narrative033": "虽然我跟艾玛之间的关系依然别扭。",
  "0203Adv09_Narrative034": "不再让任何人继续牺牲，<br>\n并制裁一切不幸的元凶——大魔女。",
  "0203Adv09_Narrative035": "这些一定都会顺利实现。",
  "0203Adv09_Narrative036": "虽然我并不会胸怀这种天真的理想，<br>\n但这几天的经历，让我也逐渐变得积极乐观起来。"
}
}
