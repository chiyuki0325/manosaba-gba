  "path": "Act02_Chapter03/Act02_Chapter03_Adv06",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-3-6", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "29_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0, 40.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 40.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "我到画室看了看，<br>\n发现诺亚跟安安坐在桌边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "她们两个都正埋头干活。<br>\n诺亚嘴里边哼着歌边画画，而安安——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Angry1"}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "姆唔唔……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn001"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "则是神情严峻地盯着一大沓纸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "安安，还行不？<br>\n想到什么能让主角大展身手的情节了吗？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah001"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Angry1,Arms2,Angle01/Option_Arms>Option_Arms02_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "『此刻吾辈正在等待天启降临』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn002"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Default"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "那就是说，还没想到？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah002"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "唔……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn003"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "诺亚不经意的一句话，让安安发出烦恼的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative004"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "这一刻，她们两个看起来就像是正在学校上课的同学，<br>\n场面令人欣慰，但……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms02_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "『这种的怎样？』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn004"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "安安把一张写满文字的纸张<br>\n塞给诺亚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "我看看……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah003"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "欸……主角怎么在这个地方就死掉，<br>\n没见过这种的啊。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah004"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "粗略看了一遍内容，诺亚语气略带不满地说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Angry1,Arms2,Angle01/Option_Arms>Option_Arms02_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "『你不觉得，就是这样才够新颖吗？<br>\n　重要的是，不要被固有框架限制住想像力』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn005"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "『诺亚同为艺术家，肯定能够理解吾辈！』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn006"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "话是这么说……<br>\n可我觉得有些地方是不能改的。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Cry1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "可恶，果然不行吗……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn007"]}},
    {"op": "PlaySfxModified", "line": 82, "indent": 0, "params": {"SfxPath": "Sfx_135", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "安安把纸片揉成一团，<br>\n随手丢弃在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 87, "indent": 0, "params": {"SfxPath": "Sfx_135", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "啊啊，诺亚也画歪了～扔了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah006"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro001"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "令人欣慰。嗯，欣慰是欣慰……<br>\n可在我看来，<br>\n不停地往地上扔纸团，这种行为是不正确的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative009"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "（我得提醒一下，让她们尽快打扫……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro002"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn.Pensive1,ArmR1-Option-All"}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "……不小心连笔也给一起扔了。<br>\n笔在哪？诺亚，你有没有看到？", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn008"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "嗯～？在哪里呢？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah007"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "诺亚四处张望的时候<br>\n发现了我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "啊，是希罗。<br>\n希罗，你有没有看到安安的笔？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah008"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "我才刚来，肯定没看见啊。<br>\n你们要把身边收拾得更加整洁才行。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "啊，真的，到处都乱糟糟的……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah009"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "算了。正好我也在找有什么能帮忙的地方。<br>\n我来帮你们收拾，<br>\n你们就继续做好自己的工作吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "嘿嘿，希罗，谢谢你。<br>\n对了，就是呢，诺亚我……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah010"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "诺亚刚想对我说些什么，<br>\n却突然尴尬地把话吞了回去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "还是算了！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah011"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "（怎么回事？她想跟我说什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "吾辈的笔在哪里……<br>\n天启快要降临了啊……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn009"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "在我跟诺亚说话期间，安安一直垂头丧气，<br>\n眼角挂着泪花，深深叹气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative012"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "你的笔就由我来找。<br>\n暂时先用这个吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro006"]}},
    {"op": "SpawnExtended", "line": 148, "indent": 0, "params": {"Path": "Clue", "Params": ["10-1"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "麻……麻烦你了……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn010"]}},
    {"op": "DestroySpawnedExtended", "line": 154, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "HideAllCharacters", "line": 156, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "我递给安安一支钢笔，<br>\n脑海里突然闪现出一段似曾相识的回忆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative013"]}},
    {"op": "ResetText", "line": 160, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 166, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 168, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 169, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 170, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 172, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "400_1"}},
    {"op": "ModifyBackgroundExtended", "line": 174, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 175, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlayBgm", "line": 177, "indent": 0, "params": {"BgmPath": "Bgm_32_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "笔盒找不到了……<br>\n到底藏哪里去了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Ema001"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "真过分。<br>\n老是故意找茬……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Ema002"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "也不知道是谁干的。真叫人生气。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro007"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "……找不到也没办法。我的钢笔给你。<br>\n明天起，你就用这支笔吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro008"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "虽然是我用旧的东西，<br>\n但班上同学应该都知道这是我常用的笔。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro009"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "这样，他们应该就不会轻易下手了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro010"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "哇啊，真好！我以前就一直觉得，<br>\n希罗的钢笔超级气派的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Ema003"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "真是太好了，——。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Ema004"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "你打起精神来嘛。<br>\n对了，暑假时要不要晚上在这里碰面？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Ema005"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "这个屋顶，可是看烟花的头等席哦！<br>\n可漂亮了！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Ema006"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "可是，烟花是晚上八点才开始吧？<br>\n你们家也有门禁对吧。<br>\n我们要守规矩才行。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro011"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "就算监护人允许了，<br>\n我们也不应该在外面玩得太晚。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro012"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "真是的，希罗你总是这么一本正经……<br>\n你呢？你觉得怎样？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Ema007"]}},
    {"op": "ResetText", "line": 207, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 209, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 210, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 212, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 214, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "29_1"}},
    {"op": "StopBgm", "line": 216, "indent": 0, "params": {"FadeOutDuration": 5.0}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "（那时候我们约好了，<br>\n　要一起在屋顶看烟花）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro013"]}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "（……可是最终，这个约定没能实现）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro014"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "记忆的潮水向我汹涌袭来，把那天的晚霞冲刷得格外清晰。<br>\n每次我想要深呼吸时，喉咙都会一阵哽咽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative014"]}},
    {"op": "ModifyBackgroundExtended", "line": 224, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 225, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "我紧紧握住拳头，<br>\n强行把意识拉回现实中来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative015"]}},
    {"op": "PlayBgm", "line": 233, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "等我找到你的笔，记得把这支钢笔还我。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro015"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "跟安安说完，<br>\n我就开始收拾起散落在地面上的纸张。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative016"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "地上有几张软趴趴的纸，看着像泡过水似的。<br>\n我不由得在意起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative017"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "这软趴趴的纸是怎么回事？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "啊啊你说那些？<br>\n那是我用稀释得很淡的颜料画出来的画哦。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah012"]}},
    {"op": "HideAllCharacters", "line": 247, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "……原来是这样。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro017"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "确实像她说的那样，<br>\n纸面上能看到一片片淡淡的颜料残渍。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative018"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "但是，说实话无法判别到底画的是什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative019"]}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "（是花纹吗？也有一点像吧。<br>\n　可能这就是所谓艺术吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro018"]}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "艺术真的很深奥……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro019"]}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "我把好几个纸团扔进垃圾桶以后，<br>\n找到了安安的笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative020"]}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "看，找到你的笔了。<br>\n这样你就可以集中精神了吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro020"]}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "……是啊。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn011"]}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "不知道为什么，安安一脸不爽，<br>\n一手把笔给抢走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 269, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "她刚摆出一副要奋笔疾书的样子，<br>\n就突然抱着头趴在桌上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 273, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Fearful1"}},
    {"op": "Wait", "line": 274, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 275, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "AnAn"}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "唔……唔唔。瓶颈期到了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn012"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "可我看你也没写几个字啊？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "AnAn.Angry1"}},
    {"op": "Wait", "line": 282, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 283, "indent": 0, "params": {"Duration": 0.20000000298023224, "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "AnAn"}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "安安啪地一下抬起头来看向我，<br>\n仿佛有话要对我说似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 287, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn"}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "……艾玛演温蒂，不好。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn013"]}},
    {"op": "HideAllCharacters", "line": 291, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 292, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "AnAn"}},
    {"op": "ModifyCharacterExtended", "line": 293, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "艾玛吗？<br>\n欸，为什么这么说？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah013"]}},
    {"op": "ModifyCharacterExtended", "line": 297, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "因为……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn014"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "诺亚的问题让安安顿时语塞。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative024"]}},
    {"op": "HideAllCharacters", "line": 303, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "她随即转头<br>\n看向装饰在画室里的舞台服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 311, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "AnAn.Pensive"}},
    {"op": "SpawnExtended", "line": 313, "indent": 0, "params": {"Path": "Clue", "Params": ["9-13"]}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "……吾辈也想在天上飞。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn015"]}},
    {"op": "DestroySpawnedExtended", "line": 317, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "听到她低声嘟哝，我立刻就明白过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative026"]}},
    {"op": "PrintTextModified", "line": 321, "indent": 0, "params": {"Text": "原来是这个意思。<br>\n你想演温蒂吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro022"]}},
    {"op": "HideAllCharacters", "line": 323, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 324, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0, 40.0], "IdAndAppearance": "AnAn"}},
    {"op": "ModifyCharacterExtended", "line": 325, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Smile"}},
    {"op": "PrintTextModified", "line": 327, "indent": 0, "params": {"Text": "是这样啊！<br>\n那我们跟大家商量一下嘛！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah014"]}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "说不定现在还能换角色！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah015"]}},
    {"op": "ModifyCharacterExtended", "line": 331, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Fearful1,Arms2,Angle01/Option_Arms>Option_Arms02_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "『我上不了舞台演戏。吾辈写剧本就好』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn016"]}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "可能是后悔把那种话说出口吧，<br>\n安安用力摇了摇头，<br>\n再次陷入烦恼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 337, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "可是……完全写不下去……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn017"]}},
    {"op": "ModifyCharacterExtended", "line": 341, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "嗯……不在状态的时候索性找其他事情干，<br>\n转换一下心情也挺好的吧？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah016"]}},
    {"op": "ModifyCharacterExtended", "line": 345, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn"}},
    {"op": "PrintTextModified", "line": 347, "indent": 0, "params": {"Text": "……例如呢？干什么好？", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn018"]}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "嗯……干你喜欢的事就好哦。<br>\n安安喜欢干什么呢？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah017"]}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "……吾辈喜欢写小说。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn019"]}},
    {"op": "ModifyCharacterExtended", "line": 353, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile"}},
    {"op": "ResetText", "line": 355, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 356, "indent": 0, "params": {"SlotNumber": 20, "Wait": 0}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "这个好！<br>\n我想看安安写的小说～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah018"]}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Surprised"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_AnAn020"]}},
    {"op": "ModifyCharacterExtended", "line": 364, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "希罗也想看对不对？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah019"]}},
    {"op": "HideAllCharacters", "line": 368, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 369, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 371, "indent": 0, "params": {"Text": "诺亚向我问道。我……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative028"]}},
    {"op": "AddChoice", "line": 373, "indent": 0, "params": {"ChoiceSummary": "回答道：有兴趣", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0203Adv06_Choice001"]}},
    {"op": "GotoModified", "line": 374, "indent": 1, "params": {"Path": "Act02_Chapter03/Act02_Chapter03_Bad01", "ResetState": ["-"]}},
    {"op": "AddChoice", "line": 376, "indent": 0, "params": {"ChoiceSummary": "支支吾吾含糊其辞", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0203Adv06_Choice002"]}},
    {"op": "GotoModified", "line": 377, "indent": 1, "params": {"Path": ".Choice2-3-1"}},
    {"op": "StopForChoice", "line": 379, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice2-3-1", "line": 381, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 383, "indent": 0, "params": {"Number": 20}},
    {"op": "PlayBgm", "line": 385, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 387, "indent": 0, "params": {"Text": "我也不是不想看，只是现在我得先打扫。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro023"]}},
    {"op": "PrintTextModified", "line": 389, "indent": 0, "params": {"Text": "随口一句话搪塞过去后我就走开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative029"]}},
    {"op": "PrintTextModified", "line": 391, "indent": 0, "params": {"Text": "诺亚跟安安<br>\n在一旁热烈地讨论着小说或绘画的话题，<br>\n而我只是默默地继续打扫画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative030"]}},
    {"op": "PrintTextModified", "line": 393, "indent": 0, "params": {"Text": "就在我把到处乱放的全新画布<br>\n全部整理到一个地方的时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative031"]}},
    {"op": "StopBgm", "line": 395, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 397, "indent": 0, "params": {"Text": "（嗯……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro024"]}},
    {"op": "PrintTextModified", "line": 399, "indent": 0, "params": {"Text": "在拿起其中一块画布时，<br>\n我突然发现背面有些奇怪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative032"]}},
    {"op": "PrintTextModified", "line": 401, "indent": 0, "params": {"Text": "背面的木框上有一条小小的裂缝。<br>\n我用手指往里抠了一下，摸到了一个东西。<br>\n从粗糙的触感来看，那应该是纸片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative033"]}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "（什么东西……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro025"]}},
    {"op": "PrintTextModified", "line": 405, "indent": 0, "params": {"Text": "我小心翼翼地把里面的东西扯出来，<br>\n发现那是一张叠起来的纸片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative034"]}},
    {"op": "PrintTextModified", "line": 407, "indent": 0, "params": {"Text": "纸片已经泛黄，边缘也磨得起毛，<br>\n看起来放了很久。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative035"]}},
    {"op": "PlayBgm", "line": 409, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 415, "indent": 0, "params": {"Path": "Clue", "Params": ["2-1"]}},
    {"op": "UpdateWitchBook", "line": 416, "indent": 0, "params": {"Id": "17", "Category": "Note", "Version": 1}},
    {"op": "PrintTextModified", "line": 418, "indent": 0, "params": {"Text": "（上面写的是……关于大魔女的……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro026"]}},
    {"op": "DestroySpawnedExtended", "line": 420, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 422, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 424, "indent": 0, "params": {"Text": "希罗，怎么啦？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Noah020"]}},
    {"op": "PrintTextModified", "line": 426, "indent": 0, "params": {"Text": "……不，没什么。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Hiro027"]}},
    {"op": "HideAllCharacters", "line": 428, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 430, "indent": 0, "params": {"Text": "我连忙把纸条塞进口袋里，<br>\n随便应付了几句就继续打扫起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv06_Narrative036"]}},
    {"op": "Gosub", "line": 437, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 439, "indent": 0, "params": {"Path": "Act02_Chapter03/Act02_Chapter03_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0203Adv06_Narrative001": "我到画室看了看，<br>\n发现诺亚跟安安坐在桌边。",
  "0203Adv06_Narrative002": "她们两个都正埋头干活。<br>\n诺亚嘴里边哼着歌边画画，而安安——",
  "0203Adv06_AnAn001": "姆唔唔……",
  "0203Adv06_Narrative003": "则是神情严峻地盯着一大沓纸。",
  "0203Adv06_Noah001": "安安，还行不？<br>\n想到什么能让主角大展身手的情节了吗？",
  "0203Adv06_AnAn002": "『此刻吾辈正在等待天启降临』",
  "0203Adv06_Noah002": "那就是说，还没想到？",
  "0203Adv06_AnAn003": "唔……",
  "0203Adv06_Narrative004": "诺亚不经意的一句话，让安安发出烦恼的声音。",
  "0203Adv06_Narrative005": "这一刻，她们两个看起来就像是正在学校上课的同学，<br>\n场面令人欣慰，但……",
  "0203Adv06_AnAn004": "『这种的怎样？』",
  "0203Adv06_Narrative006": "安安把一张写满文字的纸张<br>\n塞给诺亚。",
  "0203Adv06_Noah003": "我看看……",
  "0203Adv06_Noah004": "欸……主角怎么在这个地方就死掉，<br>\n没见过这种的啊。",
  "0203Adv06_Narrative007": "粗略看了一遍内容，诺亚语气略带不满地说道。",
  "0203Adv06_AnAn005": "『你不觉得，就是这样才够新颖吗？<br>\n　重要的是，不要被固有框架限制住想像力』",
  "0203Adv06_AnAn006": "『诺亚同为艺术家，肯定能够理解吾辈！』",
  "0203Adv06_Noah005": "话是这么说……<br>\n可我觉得有些地方是不能改的。",
  "0203Adv06_AnAn007": "可恶，果然不行吗……！",
  "0203Adv06_Narrative008": "安安把纸片揉成一团，<br>\n随手丢弃在地上。",
  "0203Adv06_Noah006": "啊啊，诺亚也画歪了～扔了。",
  "0203Adv06_Hiro001": "…………",
  "0203Adv06_Narrative009": "令人欣慰。嗯，欣慰是欣慰……<br>\n可在我看来，<br>\n不停地往地上扔纸团，这种行为是不正确的。",
  "0203Adv06_Hiro002": "（我得提醒一下，让她们尽快打扫……）",
  "0203Adv06_AnAn008": "……不小心连笔也给一起扔了。<br>\n笔在哪？诺亚，你有没有看到？",
  "0203Adv06_Noah007": "嗯～？在哪里呢？",
  "0203Adv06_Narrative010": "诺亚四处张望的时候<br>\n发现了我。",
  "0203Adv06_Noah008": "啊，是希罗。<br>\n希罗，你有没有看到安安的笔？",
  "0203Adv06_Hiro003": "我才刚来，肯定没看见啊。<br>\n你们要把身边收拾得更加整洁才行。",
  "0203Adv06_Noah009": "啊，真的，到处都乱糟糟的……",
  "0203Adv06_Hiro004": "算了。正好我也在找有什么能帮忙的地方。<br>\n我来帮你们收拾，<br>\n你们就继续做好自己的工作吧。",
  "0203Adv06_Noah010": "嘿嘿，希罗，谢谢你。<br>\n对了，就是呢，诺亚我……",
  "0203Adv06_Narrative011": "诺亚刚想对我说些什么，<br>\n却突然尴尬地把话吞了回去。",
  "0203Adv06_Noah011": "还是算了！",
  "0203Adv06_Hiro005": "（怎么回事？她想跟我说什么……？）",
  "0203Adv06_AnAn009": "吾辈的笔在哪里……<br>\n天启快要降临了啊……",
  "0203Adv06_Narrative012": "在我跟诺亚说话期间，安安一直垂头丧气，<br>\n眼角挂着泪花，深深叹气。",
  "0203Adv06_Hiro006": "你的笔就由我来找。<br>\n暂时先用这个吧。",
  "0203Adv06_AnAn010": "麻……麻烦你了……",
  "0203Adv06_Narrative013": "我递给安安一支钢笔，<br>\n脑海里突然闪现出一段似曾相识的回忆。",
  "0203Adv06_Ema001": "笔盒找不到了……<br>\n到底藏哪里去了。",
  "0203Adv06_Ema002": "真过分。<br>\n老是故意找茬……",
  "0203Adv06_Hiro007": "也不知道是谁干的。真叫人生气。",
  "0203Adv06_Hiro008": "……找不到也没办法。我的钢笔给你。<br>\n明天起，你就用这支笔吧。",
  "0203Adv06_Hiro009": "虽然是我用旧的东西，<br>\n但班上同学应该都知道这是我常用的笔。",
  "0203Adv06_Hiro010": "这样，他们应该就不会轻易下手了。",
  "0203Adv06_Ema003": "哇啊，真好！我以前就一直觉得，<br>\n希罗的钢笔超级气派的！",
  "0203Adv06_Ema004": "真是太好了，——。",
  "0203Adv06_Ema005": "你打起精神来嘛。<br>\n对了，暑假时要不要晚上在这里碰面？",
  "0203Adv06_Ema006": "这个屋顶，可是看烟花的头等席哦！<br>\n可漂亮了！",
  "0203Adv06_Hiro011": "可是，烟花是晚上八点才开始吧？<br>\n你们家也有门禁对吧。<br>\n我们要守规矩才行。",
  "0203Adv06_Hiro012": "就算监护人允许了，<br>\n我们也不应该在外面玩得太晚。",
  "0203Adv06_Ema007": "真是的，希罗你总是这么一本正经……<br>\n你呢？你觉得怎样？",
  "0203Adv06_Hiro013": "（那时候我们约好了，<br>\n　要一起在屋顶看烟花）",
  "0203Adv06_Hiro014": "（……可是最终，这个约定没能实现）",
  "0203Adv06_Narrative014": "记忆的潮水向我汹涌袭来，把那天的晚霞冲刷得格外清晰。<br>\n每次我想要深呼吸时，喉咙都会一阵哽咽。",
  "0203Adv06_Narrative015": "我紧紧握住拳头，<br>\n强行把意识拉回现实中来。",
  "0203Adv06_Hiro015": "等我找到你的笔，记得把这支钢笔还我。",
  "0203Adv06_Narrative016": "跟安安说完，<br>\n我就开始收拾起散落在地面上的纸张。",
  "0203Adv06_Narrative017": "地上有几张软趴趴的纸，看着像泡过水似的。<br>\n我不由得在意起来。",
  "0203Adv06_Hiro016": "这软趴趴的纸是怎么回事？",
  "0203Adv06_Noah012": "啊啊你说那些？<br>\n那是我用稀释得很淡的颜料画出来的画哦。",
  "0203Adv06_Hiro017": "……原来是这样。",
  "0203Adv06_Narrative018": "确实像她说的那样，<br>\n纸面上能看到一片片淡淡的颜料残渍。",
  "0203Adv06_Narrative019": "但是，说实话无法判别到底画的是什么。",
  "0203Adv06_Hiro018": "（是花纹吗？也有一点像吧。<br>\n　可能这就是所谓艺术吧）",
  "0203Adv06_Hiro019": "艺术真的很深奥……",
  "0203Adv06_Narrative020": "我把好几个纸团扔进垃圾桶以后，<br>\n找到了安安的笔。",
  "0203Adv06_Hiro020": "看，找到你的笔了。<br>\n这样你就可以集中精神了吧。",
  "0203Adv06_AnAn011": "……是啊。",
  "0203Adv06_Narrative021": "不知道为什么，安安一脸不爽，<br>\n一手把笔给抢走了。",
  "0203Adv06_Narrative022": "她刚摆出一副要奋笔疾书的样子，<br>\n就突然抱着头趴在桌上。",
  "0203Adv06_AnAn012": "唔……唔唔。瓶颈期到了。",
  "0203Adv06_Hiro021": "可我看你也没写几个字啊？",
  "0203Adv06_Narrative023": "安安啪地一下抬起头来看向我，<br>\n仿佛有话要对我说似的。",
  "0203Adv06_AnAn013": "……艾玛演温蒂，不好。",
  "0203Adv06_Noah013": "艾玛吗？<br>\n欸，为什么这么说？",
  "0203Adv06_AnAn014": "因为……",
  "0203Adv06_Narrative024": "诺亚的问题让安安顿时语塞。",
  "0203Adv06_Narrative025": "她随即转头<br>\n看向装饰在画室里的舞台服。",
  "0203Adv06_AnAn015": "……吾辈也想在天上飞。",
  "0203Adv06_Narrative026": "听到她低声嘟哝，我立刻就明白过来。",
  "0203Adv06_Hiro022": "原来是这个意思。<br>\n你想演温蒂吗。",
  "0203Adv06_Noah014": "是这样啊！<br>\n那我们跟大家商量一下嘛！",
  "0203Adv06_Noah015": "说不定现在还能换角色！",
  "0203Adv06_AnAn016": "『我上不了舞台演戏。吾辈写剧本就好』",
  "0203Adv06_Narrative027": "可能是后悔把那种话说出口吧，<br>\n安安用力摇了摇头，<br>\n再次陷入烦恼。",
  "0203Adv06_AnAn017": "可是……完全写不下去……",
  "0203Adv06_Noah016": "嗯……不在状态的时候索性找其他事情干，<br>\n转换一下心情也挺好的吧？",
  "0203Adv06_AnAn018": "……例如呢？干什么好？",
  "0203Adv06_Noah017": "嗯……干你喜欢的事就好哦。<br>\n安安喜欢干什么呢？",
  "0203Adv06_AnAn019": "……吾辈喜欢写小说。",
  "0203Adv06_Noah018": "这个好！<br>\n我想看安安写的小说～",
  "0203Adv06_AnAn020": "……！",
  "0203Adv06_Noah019": "希罗也想看对不对？",
  "0203Adv06_Narrative028": "诺亚向我问道。我……",
  "0203Adv06_Choice001": "回答道：有兴趣",
  "0203Adv06_Choice002": "支支吾吾含糊其辞",
  "0203Adv06_Hiro023": "我也不是不想看，只是现在我得先打扫。",
  "0203Adv06_Narrative029": "随口一句话搪塞过去后我就走开了。",
  "0203Adv06_Narrative030": "诺亚跟安安<br>\n在一旁热烈地讨论着小说或绘画的话题，<br>\n而我只是默默地继续打扫画室。",
  "0203Adv06_Narrative031": "就在我把到处乱放的全新画布<br>\n全部整理到一个地方的时候。",
  "0203Adv06_Hiro024": "（嗯……？）",
  "0203Adv06_Narrative032": "在拿起其中一块画布时，<br>\n我突然发现背面有些奇怪。",
  "0203Adv06_Narrative033": "背面的木框上有一条小小的裂缝。<br>\n我用手指往里抠了一下，摸到了一个东西。<br>\n从粗糙的触感来看，那应该是纸片。",
  "0203Adv06_Hiro025": "（什么东西……？）",
  "0203Adv06_Narrative034": "我小心翼翼地把里面的东西扯出来，<br>\n发现那是一张叠起来的纸片。",
  "0203Adv06_Narrative035": "纸片已经泛黄，边缘也磨得起毛，<br>\n看起来放了很久。",
  "0203Adv06_Hiro026": "（上面写的是……关于大魔女的……！）",
  "0203Adv06_Noah020": "希罗，怎么啦？",
  "0203Adv06_Hiro027": "……不，没什么。",
  "0203Adv06_Narrative036": "我连忙把纸条塞进口袋里，<br>\n随便应付了几句就继续打扫起来。"
}
}
