    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_18_1_Loop", "IntroBgmPath": "Bgm_18_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Default,ArmR1,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Default,ArmR8,ArmL8"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "一走出监牢<br>\n我就看到了汉娜跟雪莉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "她们两个正拿着湿透的衣服<br>\n站在树下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative002"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "树与树之间挂了一根绳子，<br>\n看来她们是想晾晒衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative003"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "等等，雪莉！<br>\n晾的时候请先把衣服的皱褶给拉平！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna001"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "好～是这样吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Sherry001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "听到汉娜的提醒后，<br>\n雪莉便拉扯衣服……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative004"]}},
    {"op": "PlaySfxModified", "line": 36, "indent": 0, "params": {"SfxPath": "Sfx_45", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Sherry002"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "手上的衣服就被<br>\n活生生地撕开了一个大口子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Flushed,ArmR7,ArmL1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "不小心撕破了……欸嘿☆", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "你还“欸嘿”！<br>\n你真是个傻大力！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "对不起～！<br>\n我也没用力啊，真没想到……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Sherry004"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "汉娜无奈地叹了一口气，<br>\n然后一把抢过雪莉手中的衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "缝补一下应该还能穿。<br>\n或者用来做舞台服的材料也行……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna003"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "……真是的，我来把皱褶整平，<br>\n雪莉负责晾吧。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1,ArmR5,ArmL1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "好嘞～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Sherry005"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "你们两个辛苦了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hiro001"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "听到我的问候，<br>\n她们两个转过头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Default"}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR10,ArmL1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "啊，希罗！<br>\n嗯哼！我们在晾衣服哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Sherry006"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "看起来是这样呢。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hiro002"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "以前，<br>\n汉娜曾对囚犯服表示过不满。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative008"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "她觉得穿了一天就拿去烧毁太浪费，<br>\n洗干净了还能穿。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative009"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "虽然对是否违反规定有些许忧心，<br>\n但汉娜好像直接跟典狱长谈判并成功获得了允许。<br>\n这份行动力着实让人敬佩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative010"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "自此以后，<br>\n每天都能看到汉娜不辞劳苦地在洗衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative011"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "汉娜利索地把衣服摊开拉平，<br>\n俨然一副持家有道的主妇模样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "嗯，这次要晾的就这么多了。<br>\n接下来我就把这篮子里的都洗了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna005"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "汉娜从身边的一个篮子里拿出衣服，<br>\n放进盛满水的洗衣盆里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative013"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "然后拿起一个不知道从哪里找到的洗衣板<br>\n开始搓洗衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "看我用力搓搓搓搓搓搓！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Pensive1,ArmR10,ArmL11"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "该怎么说呢……<br>\n大小姐人设跑哪去了？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Sherry007"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "雪莉一边把汉娜交给自己的衣服晾起来，<br>\n一边疑惑地说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "你话真多呢！<br>\n快闭嘴给我乖乖晾衣服去好吗！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Pensive1,ArmR8,ArmL8"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "受到汉娜斥责，<br>\n雪莉赶紧继续晾衣服去了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "希罗要是有空的话也给我来帮忙！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna008"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "话锋突然一转，指向了在一旁默默看着她们的我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative017"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "欸？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hiro003"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "未等我回答，汉娜就把还没清洗的衣服扔向我。<br>\n我来不及反应，一把就接住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative018"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "为什么连我也要洗衣服？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "自己穿的衣服，<br>\n就应该自己洗自己晾！<br>\n这不是理所当然的吗！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hanna009"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "汉娜扔给我的，<br>\n确实就是我穿过的衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative019"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "……这么一说，我确实也无话可说。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hiro005"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "汉娜的理由非常正确。<br>\n最起码，我是这样认为的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative020"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "我拿起另一块洗衣板，<br>\n在另一个洗衣盆里开始搓洗衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative021"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "（我就陪她们一阵子吧……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Hiro006"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "我帮着汉娜跟雪莉把衣服都洗好了。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv08_Narrative022"]}},
    {"op": "Gosub", "line": 148, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 150, "indent": 0, "params": {"Path": "Act02_Chapter03/Act02_Chapter03_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0203Adv08_Narrative001": "一走出监牢<br>\n我就看到了汉娜跟雪莉。",
  "0203Adv08_Narrative002": "她们两个正拿着湿透的衣服<br>\n站在树下。",
  "0203Adv08_Narrative003": "树与树之间挂了一根绳子，<br>\n看来她们是想晾晒衣服。",
  "0203Adv08_Hanna001": "等等，雪莉！<br>\n晾的时候请先把衣服的皱褶给拉平！",
  "0203Adv08_Sherry001": "好～是这样吗？",
  "0203Adv08_Narrative004": "听到汉娜的提醒后，<br>\n雪莉便拉扯衣服……",
  "0203Adv08_Sherry002": "啊。",
  "0203Adv08_Narrative005": "手上的衣服就被<br>\n活生生地撕开了一个大口子。",
  "0203Adv08_Sherry003": "不小心撕破了……欸嘿☆",
  "0203Adv08_Hanna002": "你还“欸嘿”！<br>\n你真是个傻大力！",
  "0203Adv08_Sherry004": "对不起～！<br>\n我也没用力啊，真没想到……",
  "0203Adv08_Narrative006": "汉娜无奈地叹了一口气，<br>\n然后一把抢过雪莉手中的衣服。",
  "0203Adv08_Hanna003": "缝补一下应该还能穿。<br>\n或者用来做舞台服的材料也行……",
  "0203Adv08_Hanna004": "……真是的，我来把皱褶整平，<br>\n雪莉负责晾吧。",
  "0203Adv08_Sherry005": "好嘞～！",
  "0203Adv08_Hiro001": "你们两个辛苦了。",
  "0203Adv08_Narrative007": "听到我的问候，<br>\n她们两个转过头来。",
  "0203Adv08_Sherry006": "啊，希罗！<br>\n嗯哼！我们在晾衣服哦！",
  "0203Adv08_Hiro002": "看起来是这样呢。",
  "0203Adv08_Narrative008": "以前，<br>\n汉娜曾对囚犯服表示过不满。",
  "0203Adv08_Narrative009": "她觉得穿了一天就拿去烧毁太浪费，<br>\n洗干净了还能穿。",
  "0203Adv08_Narrative010": "虽然对是否违反规定有些许忧心，<br>\n但汉娜好像直接跟典狱长谈判并成功获得了允许。<br>\n这份行动力着实让人敬佩。",
  "0203Adv08_Narrative011": "自此以后，<br>\n每天都能看到汉娜不辞劳苦地在洗衣服。",
  "0203Adv08_Narrative012": "汉娜利索地把衣服摊开拉平，<br>\n俨然一副持家有道的主妇模样。",
  "0203Adv08_Hanna005": "嗯，这次要晾的就这么多了。<br>\n接下来我就把这篮子里的都洗了。",
  "0203Adv08_Narrative013": "汉娜从身边的一个篮子里拿出衣服，<br>\n放进盛满水的洗衣盆里。",
  "0203Adv08_Narrative014": "然后拿起一个不知道从哪里找到的洗衣板<br>\n开始搓洗衣服。",
  "0203Adv08_Hanna006": "看我用力搓搓搓搓搓搓！",
  "0203Adv08_Sherry007": "该怎么说呢……<br>\n大小姐人设跑哪去了？",
  "0203Adv08_Narrative015": "雪莉一边把汉娜交给自己的衣服晾起来，<br>\n一边疑惑地说道。",
  "0203Adv08_Hanna007": "你话真多呢！<br>\n快闭嘴给我乖乖晾衣服去好吗！",
  "0203Adv08_Narrative016": "受到汉娜斥责，<br>\n雪莉赶紧继续晾衣服去了。",
  "0203Adv08_Hanna008": "希罗要是有空的话也给我来帮忙！",
  "0203Adv08_Narrative017": "话锋突然一转，指向了在一旁默默看着她们的我。",
  "0203Adv08_Hiro003": "欸？",
  "0203Adv08_Narrative018": "未等我回答，汉娜就把还没清洗的衣服扔向我。<br>\n我来不及反应，一把就接住了。",
  "0203Adv08_Hiro004": "为什么连我也要洗衣服？",
  "0203Adv08_Hanna009": "自己穿的衣服，<br>\n就应该自己洗自己晾！<br>\n这不是理所当然的吗！",
  "0203Adv08_Narrative019": "汉娜扔给我的，<br>\n确实就是我穿过的衣服。",
  "0203Adv08_Hiro005": "……这么一说，我确实也无话可说。",
  "0203Adv08_Narrative020": "汉娜的理由非常正确。<br>\n最起码，我是这样认为的。",
  "0203Adv08_Narrative021": "我拿起另一块洗衣板，<br>\n在另一个洗衣盆里开始搓洗衣服。",
  "0203Adv08_Hiro006": "（我就陪她们一阵子吧……）",
  "0203Adv08_Narrative022": "我帮着汉娜跟雪莉把衣服都洗好了。<br>"
}
}
