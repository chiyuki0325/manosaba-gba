    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "那就<br>\n麻烦你了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Sherry007"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 190, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "嗯，交给我吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia007"]}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL5,Eyes1_Normal_Open3,Mouth1_Fearful_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 194, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "（艾玛的一句话……改变了审判庭内的气氛）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL5,Eyes1_Angry_Open3,Mouth1_Flushed_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 198, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "（变得温温吞吞，让人反感）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL5,Eyes1_Normal_Closed1,Mouth1_Determined_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 202, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "（可是……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Hiro010"]}},
    {"op": "PlaySfxModified", "line": 206, "indent": 0, "params": {"SfxPath": "Sfx_Common_2", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 211, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "（既然话已经说到这个份上，<br>\n　我也没法再继续当旁观者了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Hiro011"]}},
    {"op": "StopBgm", "line": 214, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "ModifyCharacterExtended", "line": 216, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes2_Angry_Open2,Mouth1_Determined_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 217, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "（我会……承担自己该负的责任）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Hiro012"]}},
    {"op": "PlayBgm", "line": 220, "indent": 0, "params": {"BgmPath": "Bgm_45_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 225, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "Wait", "line": 226, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "SpawnExtended", "line": 227, "indent": 0, "params": {"Path": "Clue", "Params": ["8-1"]}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "首先……<br>\n被害人是安安。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia008"]}},
    {"op": "ModifyCharacterExtended", "line": 231, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 232, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "她的尸体是在中庭被发现的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia009"]}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 236, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "……铁栅栏从她背后插入贯穿心脏，当场死亡。<br>\n这毫无疑问就是死因了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia010"]}},
    {"op": "DestroySpawnedExtended", "line": 239, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 241, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Fearful_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 242, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "另外从尸体的状况看来，<br>\n死亡时间大概是在发现尸体前的30分钟到1小时之间。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia011"]}},
    {"op": "PlaySfxModified", "line": 246, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR17,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 249, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "发现尸体的地点是在中庭对吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL3,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Normal_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 253, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "没错。发现尸体的人是我。<br>\n当时尸体的周围留下了大量的血迹。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia012"]}},
    {"op": "ResetText", "line": 263, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 264, "indent": 0, "params": {"Path": "Clue", "Params": ["8-1"]}},
    {"op": "ShowToastUI", "line": 265, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 266, "indent": 0, "params": {"Id": "8-1", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 267, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 268, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL3,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 271, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "从现场状况可以推断安安是从上方<br>\n坠落到中庭的铁栅栏上。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia013"]}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR3,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 275, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "大概是承受不住人体坠落的冲击，<br>\n有几根栅栏在根部处折断了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia014"]}},
    {"op": "ResetText", "line": 284, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 285, "indent": 0, "params": {"Path": "Clue", "Params": ["8-2"]}},
    {"op": "ShowToastUI", "line": 286, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 287, "indent": 0, "params": {"Id": "8-2", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 288, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 289, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR3,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 292, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "还有就是，<br>\n附近好像还能看到吊床的残骸……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia015"]}},
    {"op": "PlaySfxModified", "line": 296, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 298, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 299, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "……啧。<br>\n那是我做的吊床。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Alisa007"]}},
    {"op": "ModifyCharacterExtended", "line": 302, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 303, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "只不过是随便制作的，<br>\n淋淋雨吹吹风估计就会烂掉。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Alisa008"]}},
    {"op": "ModifyCharacterExtended", "line": 306, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Fearful_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 307, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "原来是这样。<br>\n现场确实也有着下过雨的痕迹。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia016"]}},
    {"op": "ModifyCharacterExtended", "line": 310, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Closed03,Angle01/Facial/Mouth>Mouth_Fearful_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 311, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "而且，当时尸体周围的地面是一片泥泞。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia017"]}},
    {"op": "ModifyCharacterExtended", "line": 314, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Closed03,Angle01/Facial/Mouth>Mouth_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 315, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "大概是昨晚那场雨导致的吧。<br>\n可是地面上没有留下任何足迹。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia018"]}},
    {"op": "ModifyCharacterExtended", "line": 318, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 319, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "还有就是……中庭中央有一座干涸了的喷泉。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia019"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 323, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "有关中庭的情报，<br>\n大致上就是这些。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia020"]}},
    {"op": "ResetText", "line": 331, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 332, "indent": 0, "params": {"Path": "Clue", "Params": ["8-3"]}},
    {"op": "ShowToastUI", "line": 333, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 334, "indent": 0, "params": {"Id": "8-3", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 335, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 336, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "ModifyCharacterExtended", "line": 338, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 339, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "综合以上状况来看，<br>\n安安是从位于二楼的诺亚的画室阳台跌落至中庭，<br>\n这样来想会比较合理吧。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia021"]}},
    {"op": "ResetText", "line": 348, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 349, "indent": 0, "params": {"Path": "Clue", "Params": ["8-4"]}},
    {"op": "ShowToastUI", "line": 350, "indent": 0, "params": {"Text": "魔女图鉴 更新…"}, "text_ids": {"Text": ["Toast_001"]}},
    {"op": "UpdateWitchBook", "line": 351, "indent": 0, "params": {"Id": "8-4", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 352, "indent": 0, "params": {"WaitMode": "i1.2"}},
    {"op": "DestroySpawnedExtended", "line": 353, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "Wait", "line": 354, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 357, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "原来如此原来如此！<br>\n那么事情真相是显而易见的呢！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Sherry009"]}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 361, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "……说得没错。<br>\n作为尸体的第一发现人，且调查过现场的我<br>\n先来发表一下自己的想法。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia022"]}},
    {"op": "StopBgm", "line": 364, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 366, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 367, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "……这单纯只是我看到现场以后得出的见解。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Trial00_Leia023"]}},
