    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "把画室都收拾好以后，艾玛带着我，<br>\n沿着一楼的过道走向中庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "就在我们两个走在过道上的时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "呜哇啊啊啊啊啊啊！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "传来蕾雅的悲鸣。<br>\n听起来应该是从中庭传来的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative003"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "这，不可能……为什么，会这样……<br>\n啊啊啊啊啊啊！呜啊啊啊啊啊啊！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia002"]}},
    {"op": "PlaySfxModified", "line": 27, "indent": 0, "params": {"SfxPath": "Sfx_58", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "过了一会，<br>\n蕾雅跌跌撞撞地冲进过道，向这边跑来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative004"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "看到我跟艾玛后，<br>\n她向我们投来了求助的目光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Fearful1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "希罗……艾玛……！！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia003"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "蕾雅……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Hiro001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "我跟艾玛都没有说话。<br>\n我们心里都清楚蕾雅看到了什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Fearful1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "我好像听到下雨了，<br>\n开始担心布景会不会出问题……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia004"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "于是到中庭看了看……<br>\n跟我想的一样，布景上的颜料都被雨水打湿，糊成一团……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia005"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "艰难地挤出这几句话后，<br>\n蕾雅摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "不对，我想说的不是这种事……！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia006"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "一反平常从容不迫的举止，<br>\n她显得非常慌乱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Cry1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "安安她……死了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia007"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "蕾雅的语气异常沉重，<br>\n仿佛不愿意承认刚才自己见到的现实。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Narrative009"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "……我知道。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Cry1"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "……欸？<br>\n希罗，这是怎么……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv11_Leia008"]}},
