    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "审判过后，<br>\n我独自来到地下焚烧炉室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative001"]}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "打开门，室内一片阴暗，<br>\n烧焦的残渣不规律地层叠堆砌着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative002"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "房间里还放了几袋焚烧前的垃圾，<br>\n还有一些没有全部烧完的物件。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative003"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "纸质类的物品特别不好烧，<br>\n如果叠在一起的话还很容易烧不着保留下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative004"]}},
    {"op": "PlaySfxModified", "line": 24, "indent": 0, "params": {"SfxPath": "Sfx_143", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "我毫不犹豫地把手伸进那堆灰烬的小山丘里翻找。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative005"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（肯定，肯定还留着）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Hiro001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我没有任何证据。<br>\n即使如此，我也不会停止寻找。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative006"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "我奋不顾身，忘我地一次又一次<br>\n把翻出来的焦黑纸片和金属片抓住，再往外扔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative007"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "终于——我找到了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative008"]}},
    {"op": "ResetText", "line": 36, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 39, "indent": 0, "params": {"SfxPath": "Sfx_66", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 41, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "我用满是煤黑的双手，<br>\n小心翼翼地打开纸片，<br>\n生怕把它弄得更脏。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative009"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "那里面是——真正由诺亚画出来的画。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative010"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "能找到这幅画，<br>\n说不定是奇迹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative011"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "原来是这样……确实不怎么好看。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Hiro002"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "我低头看着诺亚的画作，<br>\n忍不住轻笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative012"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "啪嗒，啪嗒。<br>\n纸片上落下泪滴。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative013"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "一滴，又一滴。<br>\n泪水不住地往下掉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative014"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "就好像下了一场雨一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv15_Narrative015"]}},
