    {"op": "PrintTextModified", "line": 426, "indent": 0, "params": {"Text": "求求你，要活下去……！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema012"]}},
    {"op": "ResetText", "line": 428, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 429, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 430, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 432, "indent": 0, "params": {"Text": "平常那么让我厌烦的艾玛的说话声，<br>\n这时候却直穿我的心底。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative065"]}},
    {"op": "PrintTextModified", "line": 434, "indent": 0, "params": {"Text": "只有艾玛的说话声，<br>\n只有回响的雨声，<br>\n才能让我勉强保持清醒，知道自己身在何处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative066"]}},
    {"op": "PrintTextModified", "line": 436, "indent": 0, "params": {"Text": "可我依然怀着一种旁观者般的漠然，<br>\n无法接受面前发生的事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative067"]}},
