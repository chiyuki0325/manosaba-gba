  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-3-10", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "晚餐后，放风时间到了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative001"]}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "冲完澡后，<br>\n我在二楼的过道漫无目的地散步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative002"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "（要不去图书室看看……<br>\n　说不定能发现什么跟大魔女<br>\n　有关系的线索）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro001"]}},
    {"op": "PlayBgm", "line": 20, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 23, "indent": 0, "params": {"SfxPath": "Sfx_64", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "就在我前往图书室的路上，<br>\n画室中传来了声响。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative003"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "（画室里有人？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "我转身向画室走去，<br>\n在门前站定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative004"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "就在我握住门把，<br>\n正打算开门的时候——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative005"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "你、你先冷静下来，安安！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "少、少废话……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_AnAn001"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "门后传来剑拔弩张的声音，<br>\n让我不由得倒吸一口凉气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative006"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "快、快住手……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema002"]}},
    {"op": "StopBgm", "line": 47, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "艾玛的语气很迫切。<br>\n那不是普通争执时会发出的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative007"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro003"]}},
    {"op": "ResetText", "line": 55, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 58, "indent": 0, "params": {"SfxPath": "Sfx_137", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 60, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 61, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 63, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [0.0], "AppearanceAndTransition": "29_2"}},
    {"op": "ModifyBackgroundExtended", "line": 65, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 66, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 68, "indent": 0, "params": {"BgmPath": "Bgm_25_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "察觉到房间内险恶的气氛，<br>\n我急忙破门而入。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative008"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "房间里一片狼藉。<br>\n艾玛跟安安正纠缠在一起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "AnAn.Angry1,Angle01/Option_Arms-,Angle01/Option_ArmR-,ArmR5,ArmL11"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "住、住手，安安！<br>\n你为什么要这样做……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema003"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "……闭嘴！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_AnAn002"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "唔，唔唔……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema004"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "安安带着一脸阴沉且充满杀气的神色<br>\n揪住艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative010"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "而艾玛则是一脸拼死抵抗的模样，<br>\n勉强抵抗住安安的袭击。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative011"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "安安手中闪过一道黯淡亮光。<br>\n她反手握着一把小刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative012"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "锐利的刀锋正向着艾玛刺去。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative013"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "看到这一幕的瞬间，<br>\n我下意识冲了过去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Hiro.Angry1,ArmR12,ArmL12"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "你们在做什么！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro"}},
    {"op": "Wait", "line": 98, "indent": 0, "params": {"WaitMode": "0.1"}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [35.0], "IdAndAppearance": "Ema"}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "AnAn"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "看到我的突然出现，<br>\n安安一声啧舌，放开了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Duration": 3.0, "Lazy": 0, "ScenePosition": [90.0], "IdAndAppearance": "AnAn.Angry"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "别来，妨碍吾辈……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_AnAn003"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "安安一边用刀尖指着我，<br>\n一边慢慢往后退。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative016"]}},
    {"op": "HideAllCharacters", "line": 110, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "就这么退到阳台那边去了。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative017"]}},
    {"op": "ModifyBackgroundExtended", "line": 114, "indent": 0, "params": {"Scale": [3.0], "Lazy": 0, "ScenePosition": [-50.0], "AppearanceAndTransition": "29_2"}},
    {"op": "Wait", "line": 115, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "到底发生了什么事！？<br>\n先把刀给我！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Angry"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "不要……", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_AnAn004"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [55.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "我抓住安安的手腕，<br>\n想要强行抢走小刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Duration": 2.0, "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Duration": 2.0, "Lazy": 0, "ScenePosition": [85.0], "IdAndAppearance": "AnAn"}},
    {"op": "SpawnShake", "line": 130, "indent": 0, "params": {"ActorId": "Hiro"}},
    {"op": "SpawnShake", "line": 131, "indent": 0, "params": {"ActorId": "AnAn"}},
    {"op": "Wait", "line": 132, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "我们互相扭扯着，<br>\n逐渐向阳台的栏杆靠近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative019"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "——放手！！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_AnAn005"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "安安不耐烦似的狠狠喊道。<br>\n就在那一刹那。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [100.0], "IdAndAppearance": "AnAn"}},
    {"op": "HideActors", "line": 142, "indent": 0, "params": {"ActorIds": ["AnAn"], "Lazy": 0}},
    {"op": "Wait", "line": 143, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "我突然身体不受控制，<br>\n一下子放开了抓住她的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0, 30.0], "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "SpawnShake", "line": 148, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 151, "indent": 0, "params": {"SfxPath": "Sfx_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "呜……！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro006"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "应该是安安的魔法吧。<br>\n我的身体不自然地被弹开，<br>\n顺势跌坐在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative022"]}},
    {"op": "PlaySfxModified", "line": 160, "indent": 0, "params": {"SfxPath": "Sfx_17", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "安安似乎也被一股神奇的力量推开，<br>\n失去平衡，手上的小刀当场跌落。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative023"]}},
    {"op": "HideAllCharacters", "line": 164, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "啊……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema005"]}},
    {"op": "ModifyBackgroundExtended", "line": 169, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 170, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "HideAllCharacters", "line": 171, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCamera", "line": 172, "indent": 0, "params": {"Offset": [8.199999809265137, 2.0], "Zoom": 0.75, "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Scale": [0.44999998807907104], "Duration": 0.0, "Lazy": 0, "ScenePosition": [82.0, 65.0], "IdAndAppearance": "AnAn.Fearful1"}},
    {"op": "ModifyBackgroundExtended", "line": 174, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 175, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "StopBgm", "line": 177, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "那一刹那，<br>\n安安因恐惧而扭曲的表情在我眼前闪过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative024"]}},
    {"op": "ModifyBackgroundExtended", "line": 181, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 182, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Scale": [0.41999998688697815], "Duration": 0.0, "Lazy": 0, "IdAndAppearance": "AnAn.Fearful1"}},
    {"op": "ModifyBackgroundExtended", "line": 184, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 185, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "时间仿佛缓慢播放的定格画面一般。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative025"]}},
    {"op": "ModifyBackgroundExtended", "line": 189, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 190, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Scale": [0.4000000059604645], "Duration": 0.0, "Lazy": 0, "ScenePosition": [0.0, 67.0], "IdAndAppearance": "AnAn.Surprised1"}},
    {"op": "ModifyBackgroundExtended", "line": 192, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 193, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "安安的身体越过栏杆，<br>\n飘浮在半空中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative026"]}},
    {"op": "ModifyBackgroundExtended", "line": 197, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 198, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Scale": [0.3499999940395355], "Duration": 0.0, "Lazy": 0, "ScenePosition": [0.0, 60.0], "IdAndAppearance": "AnAn"}},
    {"op": "ModifyBackgroundExtended", "line": 200, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 201, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "随后犹如受到重力的牵引一般，<br>\n慢慢地垂直落下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative027"]}},
    {"op": "ModifyBackgroundExtended", "line": 205, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 206, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Scale": [0.3100000023841858], "Duration": 0.0, "Lazy": 0, "ScenePosition": [0.0, 55.0], "IdAndAppearance": "AnAn.Fearful1"}},
    {"op": "ModifyBackgroundExtended", "line": 208, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 209, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "四周的杂音和风声全都戛然而止，<br>\n在这个死寂的空间里，唯有安安逐渐远去的身影烙印在我眼底。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative028"]}},
    {"op": "ModifyBackgroundExtended", "line": 213, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 214, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "HideAllCharacters", "line": 215, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 216, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 217, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "最后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative029"]}},
    {"op": "SpawnShake", "line": 221, "indent": 0, "params": {"ActorId": "MainBackground"}},
    {"op": "PlaySfxModified", "line": 224, "indent": 0, "params": {"SfxPath": "Sfx_23", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 226, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "一声让人脊背发凉的沉闷声音响起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative030"]}},
    {"op": "ResetText", "line": 230, "indent": 0, "params": {}},
    {"op": "Wait", "line": 231, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "（是我，把她推下去了……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro007"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "虽说不是故意的，<br>\n但确实是我的抢夺使她掉了下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative031"]}},
    {"op": "ResetText", "line": 237, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 238, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 239, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "认识到这个事实的时候，我倒吸了一口凉气，<br>\n两眼发黑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative032"]}},
    {"op": "ModifyCamera", "line": 243, "indent": 0, "params": {"Offset": [3.0, 0.0], "Zoom": 0.30000001192092896, "Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 244, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 245, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [47.0], "IdAndAppearance": "Ema.Fearful1,ArmR3"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "安安，你没事……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema006"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "艾玛也来到阳台上，<br>\n我们探头越过栏杆往下看去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative033"]}},
    {"op": "ModifyBackgroundExtended", "line": 253, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 254, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 256, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "在夜色的掩盖下，<br>\n我们无法看清安安身在何处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative034"]}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "可我们依然睁大眼睛，在黑暗中拼命地寻找——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative035"]}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro008"]}},
    {"op": "StopBgm", "line": 264, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "找到了。<br>\n可悲的是，我们找到了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative036"]}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "找到了夜色中微微浮现的【那东西】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative037"]}},
    {"op": "HidePrinter", "line": 270, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 272, "indent": 0, "params": {"BgmPath": "Bgm_16_1_Loop", "IntroBgmPath": "Bgm_16_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 274, "indent": 0, "params": {"Id": "Stills", "Scale": [2.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [5.0, -10.0], "AppearanceAndTransition": "340_1"}},
    {"op": "AnimateActorExtended", "line": 275, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "ScenePositionX": "30", "EasingTypeName": "EaseOutQuad", "Duration": "3"}},
    {"op": "ModifyBackgroundExtended", "line": 276, "indent": 0, "params": {"Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 277, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "AnimateActorExtended", "line": 279, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 280, "indent": 0, "params": {"Id": "Stills", "Scale": [3.0], "Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [75.0, 75.0], "AppearanceAndTransition": "340_1", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 281, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "60", "EasingTypeName": "EaseOutQuad", "Duration": "2"}},
    {"op": "Wait", "line": 282, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "AnimateActorExtended", "line": 284, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 285, "indent": 0, "params": {"Id": "Stills", "Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "340_1"}},
    {"op": "SpawnBlur", "line": 286, "indent": 0, "params": {"ActorId": "Stills", "FadeDuration": 0.0}},
    {"op": "AnimateActorExtended", "line": 287, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "ScenePositionX": "50", "ScenePositionY": "50", "Scale": "1.15", "EasingTypeName": "EaseOutQuad", "Duration": "2.4"}},
    {"op": "SpawnBlur", "line": 288, "indent": 0, "params": {"ActorId": "Stills", "Intensity": 0.0, "FadeDuration": 1.5}},
    {"op": "HideActors", "line": 289, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 290, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "阳台下方，中庭内安装着栅栏。<br>\n被栅栏从后背贯穿的是……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative038"]}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "夏目安安——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative039"]}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "也许是因为跌落造成的冲击，好几根栅栏都弯折了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative040"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "从她那副仰面朝天的身躯穿刺而出的，<br>\n是一根长枪般尖锐的栅栏尖端。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative041"]}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "就算距离这么远也能一眼看出，<br>\n那就是贯穿安安的致命伤。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative042"]}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "从安安胸口喷涌而出的血液，<br>\n把地面染成一片鲜红。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative043"]}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "仿佛被图钉固定住的蝴蝶标本一般。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative044"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "怎么会这样……安安！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema007"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "艾玛大概也看到了尸体。她悲痛地喊着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative045"]}},
    {"op": "ResetText", "line": 310, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 311, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 312, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 314, "indent": 0, "params": {"ActorIds": ["Stills", "Stills-Middle"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "是我……是我杀了她。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro009"]}},
    {"op": "ModifyBackgroundExtended", "line": 318, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "29_2"}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "视野里的一切在颠簸。<br>\n脑子里一片空白，完全无法思考。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative046"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "恍惚间似乎听到有人在呼唤我。<br>\n但我无法理解那到底是谁，<br>\n到底说了些什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative047"]}},
    {"op": "ModifyBackgroundExtended", "line": 324, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 325, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 327, "indent": 0, "params": {"Text": "当回过神来时，我发现自己身在画室内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative048"]}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "看来是艾玛把我从阳台拉进来了。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative049"]}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "（艾玛呢？艾玛到底在干什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro010"]}},
    {"op": "StopBgm", "line": 333, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "艾玛在阳台。<br>\n我呆滞地抬头望向夜空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative050"]}},
    {"op": "PrintTextModified", "line": 337, "indent": 0, "params": {"Text": "零星的水滴从天而降，<br>\n仿佛天空也在叹息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative051"]}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "一滴，两滴。<br>\n水滴画出的线条渐渐变得密集起来，<br>\n耳边是水滴接连不断敲打地面的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative052"]}},
    {"op": "PlayBgm", "line": 342, "indent": 0, "params": {"BgmPath": "Ambi_8_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 343, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ResetText", "line": 345, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 348, "indent": 0, "params": {"SfxPath": "Sfx_79", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 349, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "就像要抓住这个机会似的，<br>\n在雨声的掩护下，艾玛开始用力踢打阳台的栏杆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative053"]}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "无法理解艾玛在干什么。<br>\n现在的我无法正常思考，连站都站不起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative054"]}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "倾泻而下的雨声回荡着，<br>\n不断搅乱我的心绪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative055"]}},
    {"op": "ResetText", "line": 357, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 359, "indent": 0, "params": {"SfxPath": "Sfx_61", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 361, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 363, "indent": 0, "params": {"Text": "也许是因为早已老旧失修，<br>\n在艾玛不断踢打之下，<br>\n栏杆终于彻底损坏了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative056"]}},
    {"op": "PrintTextModified", "line": 365, "indent": 0, "params": {"Text": "艾玛捡起地上的刀子，<br>\n回到画室内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative057"]}},
    {"op": "ModifyCharacterExtended", "line": 367, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Cry1,ArmR1"}},
    {"op": "PrintTextModified", "line": 369, "indent": 0, "params": {"Text": "她开始收拾房间，<br>\n像是要把争执的痕迹全部去除一样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative058"]}},
    {"op": "PrintTextModified", "line": 371, "indent": 0, "params": {"Text": "她的脸颊满是水痕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative059"]}},
    {"op": "PrintTextModified", "line": 373, "indent": 0, "params": {"Text": "那是屋檐也无法遮挡的雨水，<br>\n还是她流下的泪水呢。<br>\n也许两者都有。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative060"]}},
    {"op": "PrintTextModified", "line": 375, "indent": 0, "params": {"Text": "哈啊，哈啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema008"]}},
    {"op": "PrintTextModified", "line": 377, "indent": 0, "params": {"Text": "就在她拼命忙活的时候——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative061"]}},
    {"op": "ModifyCharacterExtended", "line": 379, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 381, "indent": 0, "params": {"Text": "……啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema009"]}},
    {"op": "ModifyCharacterExtended", "line": 383, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Ema"}},
    {"op": "HideAllCharacters", "line": 384, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 387, "indent": 0, "params": {"SfxPath": "Sfx_140", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 389, "indent": 0, "params": {"Text": "艾玛不小心<br>\n踢到了一个油漆桶。<br>\n红色的油漆撒了一地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative062"]}},
    {"op": "PlaySfxModified", "line": 392, "indent": 0, "params": {"SfxPath": "Sfx_141", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 394, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 20.0], "IdAndAppearance": "Ema.Cry"}},
    {"op": "Wait", "line": 395, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCharacterExtended", "line": 396, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Ema.Cry"}},
    {"op": "PrintTextModified", "line": 400, "indent": 0, "params": {"Text": "哈啊，哈啊……呜。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Ema010"]}},
    {"op": "PrintTextModified", "line": 402, "indent": 0, "params": {"Text": "她连忙拿起一块抹布擦拭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative063"]}},
    {"op": "HideAllCharacters", "line": 404, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 406, "indent": 0, "params": {"Text": "（艾玛这么拼命，到底是为了什么——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro011"]}},
    {"op": "PrintTextModified", "line": 408, "indent": 0, "params": {"Text": "目睹安安的死亡后，<br>\n即使满面泪痕，<br>\n但艾玛仍在拼命地干活。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Narrative064"]}},
    {"op": "PrintTextModified", "line": 410, "indent": 0, "params": {"Text": "（为了谁——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0203Adv10_Hiro012"]}},
    {"op": "ResetText", "line": 412, "indent": 0, "params": {}},
