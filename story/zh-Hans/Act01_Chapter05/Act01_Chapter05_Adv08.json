  "translations": {
  "0105Adv08_Narrative001": "不知跑了多远。",
  "0105Adv08_Narrative002": "可可和玛格的身影都不见了。<br>\n看守、典狱长和梅露露的气息也消失了。",
  "0105Adv08_Narrative003": "艾玛成了孤身一人<br>\n——回到了监牢前。",
  "0105Adv08_Narrative004": "她无力地跪倒在地，蜷缩成一团。",
  "0105Adv08_Ema001": "（已经没有人在了。也无处可逃了）",
  "0105Adv08_Ema002": "（我什么都没做到）",
  "0105Adv08_Ema003": "啊啊——啊啊啊啊啊啊——！！",
  "0105Adv08_Ema004": "呜啊啊啊啊啊啊——啊啊啊啊啊！！",
  "0105Adv08_Ema005": "啊、啊啊、啊啊呜——啊啊啊啊啊啊！！",
  "0105Adv08_Narrative005": "艾玛再也无法忍受，<br>\n她浑身颤抖，不断发出悲痛欲绝的哭喊。"
}
