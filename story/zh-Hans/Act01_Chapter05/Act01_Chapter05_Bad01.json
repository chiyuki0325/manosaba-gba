  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-5-b1", "line": 8, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "StopBgm", "line": 18, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 19, "indent": 0, "params": {"BgmPath": "Bgm_24_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "等一下！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Ema001"]}},
    {"op": "HideAllCharacters", "line": 25, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "艾玛……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Margo001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "艾玛挣脱玛格的阻拦，<br>\n朝梅露露跑去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative001"]}},
    {"op": "HideActors", "line": 32, "indent": 0, "params": {"ActorIds": ["Margo"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Angry1,ArmR3,ArmL7"}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "梅露露！我们再好好谈谈吧！<br>\n根本不需要做这种事啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "艾玛小姐……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru001"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "艾玛紧紧握住梅露露的手，<br>\n拼命地诉说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "梅露露你是我的朋友啊！<br>\n所以你根本没必要……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "艾玛小姐，谢谢你。<br>\n能听到你这样说，我真是太高兴了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru002"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "艾玛小姐对我来说，<br>\n果然是无可替代而珍贵的朋友呢。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru003"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "面对静静微笑的梅露露，<br>\n艾玛的眼中闪现出一丝希望的光芒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Smile"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "那、那么！你——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Ema004"]}},
    {"op": "StopBgm", "line": 60, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "对不起。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "欸……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Ema005"]}},
    {"op": "HideAllCharacters", "line": 70, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "不知何时靠近的看守，<br>\n朝着艾玛的脖子挥下了镰刀。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative004"]}},
    {"op": "PlayBgm", "line": 74, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PlaySfxModified", "line": 77, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 78, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "……唉。看来……<br>\n她是无法沟通的对象呢……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Margo002"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "可、可恶……你这混蛋！<br>\n为什么！？莫名其妙！等一下啊，救命！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Coco001"]}},
    {"op": "HideAllCharacters", "line": 89, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "玛格小姐，还有可可小姐……对不起。<br>\n但是我必须要好好收尾才行……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru005"]}},
    {"op": "ResetText", "line": 94, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 95, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 96, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlaySfxModified", "line": 99, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PlaySfxModified", "line": 103, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 104, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "ModifyBackgroundExtended", "line": 106, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 107, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "……对不起，大家。<br>\n你们都是非常好的人。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru006"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "我绝对不会忘记大家的……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru007"]}},
    {"op": "HideAllCharacters", "line": 115, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "看着滚落在地的三颗头颅，<br>\n梅露露静静地流下泪水。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "寂静的时间持续了几秒钟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative006"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "不久，梅露露擦干眼泪……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative007"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "坚毅地在胸前握紧双拳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "……好了！<br>\n让我们努力准备下一轮吧！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru008"]}},
    {"op": "ResetText", "line": 129, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 131, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 133, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyBackgroundExtended", "line": 135, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyBackgroundExtended", "line": 138, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlayBgm", "line": 140, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "——几小时过去了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative009"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "梅露露的脚步声在地下回响，<br>\n她正在巡视牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 147, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "梅露露大人，那个……遗体已经处理完毕了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden001"]}},
    {"op": "HideAllCharacters", "line": 154, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "谢谢你。<br>\n这次看来会很忙啊。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru009"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "毕竟留下了很多线索呢。<br>\n在下一批预备魔女来之前，<br>\n必须要确实地消除痕迹才行。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru010"]}},
    {"op": "HideAllCharacters", "line": 161, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "地下也有些损坏，<br>\n好像还发现了奈叶香小姐的涂鸦。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden002"]}},
    {"op": "HideAllCharacters", "line": 166, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "必须更加、更加彻底地<br>\n消除所有令人担忧的东西……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru011"]}},
    {"op": "HideAllCharacters", "line": 171, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "这次的预备魔女相当优秀呢。<br>\n梅露露大人好几次都差点哭出来了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden003"]}},
    {"op": "HideAllCharacters", "line": 176, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "真是的，我才没有哭呢。<br>\n……咦？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru012"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "说着，梅露露捡起房间角落里掉落的纸片，<br>\n仔细阅读起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative011"]}},
    {"op": "HideAllCharacters", "line": 183, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "……您在读什么？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden004"]}},
    {"op": "HideAllCharacters", "line": 188, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "似乎是雪莉小姐写给艾玛小姐的信……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru013"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "梅露露随即开始轻声啜泣。<br>\n她小心翼翼地将信件抱在胸前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Cry"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "雪莉小姐真是个重视朋友的人呢。<br>\n看到如此美丽的友情，我真的很感动。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru014"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "谢谢你们给予我这宝贵的时光。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru015"]}},
    {"op": "HideAllCharacters", "line": 201, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "被玛格小姐改造过的牢房<br>\n也得修复呢……唉。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden005"]}},
    {"op": "HideAllCharacters", "line": 206, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "啊，是的。装扮得那么可爱，<br>\n真有点可惜呢。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru016"]}},
    {"op": "HideAllCharacters", "line": 211, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "梅露露用附近的灯笼点燃了信，<br>\n然后随意地将其扔在走廊的角落。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative013"]}},
    {"op": "ModifyBackgroundExtended", "line": 215, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "之后，梅露露花费了大量时间，<br>\n有时甚至通宵达旦，巡视了每个房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative014"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "这一切都是为了迎接下一批预备魔女的准备工作——<br>\n恢复原状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "红色的蝴蝶……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru017"]}},
    {"op": "HideAllCharacters", "line": 225, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "梅露露拿着一本打开的书，<br>\n恍惚地看着窗边飞舞的红色蝴蝶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative016"]}},
    {"op": "PlaySfxModified", "line": 230, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "与此同时，典狱长一个飞扑，<br>\n迅速地叼住蝴蝶吞了下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "咕噜噜……失礼了。是诺亚小姐的魔法啊。<br>\n这次也出现了【不会消失的魔法】呢。唉……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden006"]}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "这可真麻烦啊……<br>\n无法消除的痕迹实在太多了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden007"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "比如中庭的彩虹，还有图书室的那个。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden008"]}},
    {"op": "HideAllCharacters", "line": 242, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "典狱长厌恶地看向<br>\n图书室里盛开的樱花。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 246, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile1"}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "我觉得很漂亮，所以蛮喜欢的哦。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru018"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "但是说不好会在某种情况下，<br>\n以某种方式帮到囚犯们……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru019"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "梅露露面露难色笑了笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 254, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "这时，看守发出爬行般的沙沙声<br>\n向她靠近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative020"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "它用身上的多只手拿着好几本书，<br>\n将其中一本递给了梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 260, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 261, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "啊，这本书里也写着大魔女大人的事吗？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru020"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "看守缓缓点头。<br>\n看到这个回答，梅露露的脸瞬间变得通红。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 267, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Flushed"}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "哇啊啊……！谢谢你！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru021"]}},
    {"op": "HideAllCharacters", "line": 271, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "她像个孩子一样，小心翼翼地抱住书本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 275, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "只要找一下还是能找到的呢……<br>\n当玛格小姐开始解读的时候，我可紧张坏了……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden009"]}},
    {"op": "HideAllCharacters", "line": 279, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "相比被发现，只要能看到一点点大魔女大人的记录，<br>\n对我来说就很高兴了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru022"]}},
    {"op": "HideAllCharacters", "line": 284, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 286, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "就这样，监牢中一成不变的日子<br>\n今天也依然延续下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative024"]}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "不——<br>\n即使有什么变化，一切最终都会恢复原状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative025"]}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "几天后，大致完成复原工作的梅露露<br>\n和典狱长在中庭摆开了茶具。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 294, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "话说回来，我决定在监牢里<br>\n放一台DVD播放器了。<br>\n典狱长先生，你觉得这里面哪个比较好呢？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru023"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "梅露露将手中的DVD包装盒<br>\n展示在典狱长面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "我在想下次也得用这类方法<br>\n给她们施加压力，<br>\n不过一直不知道选哪个好……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru024"]}},
    {"op": "HideAllCharacters", "line": 304, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "《最恐怖的灵异地点影像》<br>\n《世界上最可怕的灵异照片》", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative028"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "看到这些标题，<br>\n典狱长轻轻叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 310, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "……随便哪个都行吧？<br>\n哪个看起来都很无聊……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden010"]}},
    {"op": "HideAllCharacters", "line": 314, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 315, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 317, "indent": 0, "params": {"Text": "那就都放吧。<br>\n希望这样<br>\n能加快魔女化的进程……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru025"]}},
    {"op": "HideAllCharacters", "line": 319, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 320, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "这种东西真的能加快吗……？<br>\n无论怎么想，感觉都不会有人看……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden011"]}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "比这更重要的是，我希望您能从上次的候选人中<br>\n选择下一个看守。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden012"]}},
    {"op": "HideAllCharacters", "line": 326, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 327, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "啊，对了。<br>\n这次该让谁当看守呢。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru026"]}},
    {"op": "HideAllCharacters", "line": 331, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 332, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "请选个好控制的人吧。<br>\n如果还留有反抗意识的话会很麻烦……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden013"]}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "话说回来，DVD播放器<br>\n是什么时候订购的啊？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden014"]}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "我还以为梅露露大人<br>\n不懂电子设备呢。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden015"]}},
    {"op": "HideAllCharacters", "line": 340, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 341, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 343, "indent": 0, "params": {"Text": "呵呵。<br>\n请不要把我当成老婆婆。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru027"]}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "我从珍贵的朋友们那里<br>\n学到了很多东西呢。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru028"]}},
    {"op": "ModifyCharacterExtended", "line": 347, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "特别是……那个人给我留下了深刻的印象。<br>\n艾……艾……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru029"]}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "梅露露话说到一半，<br>\n带着不太自信的微笑开口道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative030"]}},
    {"op": "ModifyCharacterExtended", "line": 353, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "艾娜？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Meruru030"]}},
    {"op": "HideAllCharacters", "line": 357, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 358, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 360, "indent": 0, "params": {"Text": "是艾玛。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Warden016"]}},
    {"op": "HideAllCharacters", "line": 362, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "梅露露和典狱长一边轻松地交谈，<br>\n一边继续品茶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative031"]}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "在下一场惨剧开始之前的短暂时光里，<br>\n监牢正包裹在寂静之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad01_Narrative032"]}},
    {"op": "ProcessBadEnd", "line": 372, "indent": 0, "params": {"Number": 14}}
  ],
  "translations": {
  "0105Bad01_Ema001": "等一下！！",
  "0105Bad01_Margo001": "艾玛……",
  "0105Bad01_Narrative001": "艾玛挣脱玛格的阻拦，<br>\n朝梅露露跑去。",
  "0105Bad01_Ema002": "梅露露！我们再好好谈谈吧！<br>\n根本不需要做这种事啊！",
  "0105Bad01_Meruru001": "艾玛小姐……",
  "0105Bad01_Narrative002": "艾玛紧紧握住梅露露的手，<br>\n拼命地诉说。",
  "0105Bad01_Ema003": "梅露露你是我的朋友啊！<br>\n所以你根本没必要……",
  "0105Bad01_Meruru002": "艾玛小姐，谢谢你。<br>\n能听到你这样说，我真是太高兴了。",
  "0105Bad01_Meruru003": "艾玛小姐对我来说，<br>\n果然是无可替代而珍贵的朋友呢。",
  "0105Bad01_Narrative003": "面对静静微笑的梅露露，<br>\n艾玛的眼中闪现出一丝希望的光芒。",
  "0105Bad01_Ema004": "那、那么！你——",
  "0105Bad01_Meruru004": "对不起。",
  "0105Bad01_Ema005": "欸……？",
  "0105Bad01_Narrative004": "不知何时靠近的看守，<br>\n朝着艾玛的脖子挥下了镰刀。",
  "0105Bad01_Margo002": "……唉。看来……<br>\n她是无法沟通的对象呢……",
  "0105Bad01_Coco001": "可、可恶……你这混蛋！<br>\n为什么！？莫名其妙！等一下啊，救命！",
  "0105Bad01_Meruru005": "玛格小姐，还有可可小姐……对不起。<br>\n但是我必须要好好收尾才行……",
  "0105Bad01_Meruru006": "……对不起，大家。<br>\n你们都是非常好的人。",
  "0105Bad01_Meruru007": "我绝对不会忘记大家的……",
  "0105Bad01_Narrative005": "看着滚落在地的三颗头颅，<br>\n梅露露静静地流下泪水。",
  "0105Bad01_Narrative006": "寂静的时间持续了几秒钟。",
  "0105Bad01_Narrative007": "不久，梅露露擦干眼泪……",
  "0105Bad01_Narrative008": "坚毅地在胸前握紧双拳。",
  "0105Bad01_Meruru008": "……好了！<br>\n让我们努力准备下一轮吧！",
  "0105Bad01_Narrative009": "——几小时过去了。",
  "0105Bad01_Narrative010": "梅露露的脚步声在地下回响，<br>\n她正在巡视牢房。",
  "0105Bad01_Warden001": "梅露露大人，那个……遗体已经处理完毕了。",
  "0105Bad01_Meruru009": "谢谢你。<br>\n这次看来会很忙啊。",
  "0105Bad01_Meruru010": "毕竟留下了很多线索呢。<br>\n在下一批预备魔女来之前，<br>\n必须要确实地消除痕迹才行。",
  "0105Bad01_Warden002": "地下也有些损坏，<br>\n好像还发现了奈叶香小姐的涂鸦。",
  "0105Bad01_Meruru011": "必须更加、更加彻底地<br>\n消除所有令人担忧的东西……",
  "0105Bad01_Warden003": "这次的预备魔女相当优秀呢。<br>\n梅露露大人好几次都差点哭出来了。",
  "0105Bad01_Meruru012": "真是的，我才没有哭呢。<br>\n……咦？",
  "0105Bad01_Narrative011": "说着，梅露露捡起房间角落里掉落的纸片，<br>\n仔细阅读起来。",
  "0105Bad01_Warden004": "……您在读什么？",
  "0105Bad01_Meruru013": "似乎是雪莉小姐写给艾玛小姐的信……",
  "0105Bad01_Narrative012": "梅露露随即开始轻声啜泣。<br>\n她小心翼翼地将信件抱在胸前。",
  "0105Bad01_Meruru014": "雪莉小姐真是个重视朋友的人呢。<br>\n看到如此美丽的友情，我真的很感动。",
  "0105Bad01_Meruru015": "谢谢你们给予我这宝贵的时光。",
  "0105Bad01_Warden005": "被玛格小姐改造过的牢房<br>\n也得修复呢……唉。",
  "0105Bad01_Meruru016": "啊，是的。装扮得那么可爱，<br>\n真有点可惜呢。",
  "0105Bad01_Narrative013": "梅露露用附近的灯笼点燃了信，<br>\n然后随意地将其扔在走廊的角落。",
  "0105Bad01_Narrative014": "之后，梅露露花费了大量时间，<br>\n有时甚至通宵达旦，巡视了每个房间。",
  "0105Bad01_Narrative015": "这一切都是为了迎接下一批预备魔女的准备工作——<br>\n恢复原状。",
  "0105Bad01_Meruru017": "红色的蝴蝶……？",
  "0105Bad01_Narrative016": "梅露露拿着一本打开的书，<br>\n恍惚地看着窗边飞舞的红色蝴蝶。",
  "0105Bad01_Narrative017": "与此同时，典狱长一个飞扑，<br>\n迅速地叼住蝴蝶吞了下去。",
  "0105Bad01_Warden006": "咕噜噜……失礼了。是诺亚小姐的魔法啊。<br>\n这次也出现了【不会消失的魔法】呢。唉……",
  "0105Bad01_Warden007": "这可真麻烦啊……<br>\n无法消除的痕迹实在太多了。",
  "0105Bad01_Warden008": "比如中庭的彩虹，还有图书室的那个。",
  "0105Bad01_Narrative018": "典狱长厌恶地看向<br>\n图书室里盛开的樱花。",
  "0105Bad01_Meruru018": "我觉得很漂亮，所以蛮喜欢的哦。",
  "0105Bad01_Meruru019": "但是说不好会在某种情况下，<br>\n以某种方式帮到囚犯们……",
  "0105Bad01_Narrative019": "梅露露面露难色笑了笑。",
  "0105Bad01_Narrative020": "这时，看守发出爬行般的沙沙声<br>\n向她靠近。",
  "0105Bad01_Narrative021": "它用身上的多只手拿着好几本书，<br>\n将其中一本递给了梅露露。",
  "0105Bad01_Meruru020": "啊，这本书里也写着大魔女大人的事吗？",
  "0105Bad01_Narrative022": "看守缓缓点头。<br>\n看到这个回答，梅露露的脸瞬间变得通红。",
  "0105Bad01_Meruru021": "哇啊啊……！谢谢你！",
  "0105Bad01_Narrative023": "她像个孩子一样，小心翼翼地抱住书本。",
  "0105Bad01_Warden009": "只要找一下还是能找到的呢……<br>\n当玛格小姐开始解读的时候，我可紧张坏了……",
  "0105Bad01_Meruru022": "相比被发现，只要能看到一点点大魔女大人的记录，<br>\n对我来说就很高兴了。",
  "0105Bad01_Narrative024": "就这样，监牢中一成不变的日子<br>\n今天也依然延续下去。",
  "0105Bad01_Narrative025": "不——<br>\n即使有什么变化，一切最终都会恢复原状。",
  "0105Bad01_Narrative026": "几天后，大致完成复原工作的梅露露<br>\n和典狱长在中庭摆开了茶具。",
  "0105Bad01_Meruru023": "话说回来，我决定在监牢里<br>\n放一台DVD播放器了。<br>\n典狱长先生，你觉得这里面哪个比较好呢？",
  "0105Bad01_Narrative027": "梅露露将手中的DVD包装盒<br>\n展示在典狱长面前。",
  "0105Bad01_Meruru024": "我在想下次也得用这类方法<br>\n给她们施加压力，<br>\n不过一直不知道选哪个好……",
  "0105Bad01_Narrative028": "《最恐怖的灵异地点影像》<br>\n《世界上最可怕的灵异照片》",
  "0105Bad01_Narrative029": "看到这些标题，<br>\n典狱长轻轻叹了口气。",
  "0105Bad01_Warden010": "……随便哪个都行吧？<br>\n哪个看起来都很无聊……",
  "0105Bad01_Meruru025": "那就都放吧。<br>\n希望这样<br>\n能加快魔女化的进程……",
  "0105Bad01_Warden011": "这种东西真的能加快吗……？<br>\n无论怎么想，感觉都不会有人看……",
  "0105Bad01_Warden012": "比这更重要的是，我希望您能从上次的候选人中<br>\n选择下一个看守。",
  "0105Bad01_Meruru026": "啊，对了。<br>\n这次该让谁当看守呢。",
  "0105Bad01_Warden013": "请选个好控制的人吧。<br>\n如果还留有反抗意识的话会很麻烦……",
  "0105Bad01_Warden014": "话说回来，DVD播放器<br>\n是什么时候订购的啊？",
  "0105Bad01_Warden015": "我还以为梅露露大人<br>\n不懂电子设备呢。",
  "0105Bad01_Meruru027": "呵呵。<br>\n请不要把我当成老婆婆。",
  "0105Bad01_Meruru028": "我从珍贵的朋友们那里<br>\n学到了很多东西呢。",
  "0105Bad01_Meruru029": "特别是……那个人给我留下了深刻的印象。<br>\n艾……艾……",
  "0105Bad01_Narrative030": "梅露露话说到一半，<br>\n带着不太自信的微笑开口道。",
  "0105Bad01_Meruru030": "艾娜？",
  "0105Bad01_Warden016": "是艾玛。",
  "0105Bad01_Narrative031": "梅露露和典狱长一边轻松地交谈，<br>\n一边继续品茶。",
  "0105Bad01_Narrative032": "在下一场惨剧开始之前的短暂时光里，<br>\n监牢正包裹在寂静之中。"
}
}
