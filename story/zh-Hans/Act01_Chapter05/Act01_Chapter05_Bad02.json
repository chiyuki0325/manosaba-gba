  "path": "Act01_Chapter05/Act01_Chapter05_Bad02",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-5-b2", "line": 8, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "14_1"}},
    {"op": "ModifyCharacterExtended", "line": 15, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "ModifyBackgroundExtended", "line": 17, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 18, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 20, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "……孤身、一人……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛喃喃自语，仿佛在说梦话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "呜呜……<br>\n温柔的艾玛小姐……你一定能理解我的，对吧？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（……她究竟在说些什么？<br>\n　我根本无法想像梅露露的心情）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "（……但是，如果现在逃离梅露露的话<br>\n　……我会变成什么样呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（连离开这个岛的方法都找不到。<br>\n　独自一人，躲躲藏藏）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema004"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "艾玛脸色苍白，双手紧紧抱住<br>\n自己颤抖的身体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [15.0], "IdAndAppearance": "Ema.Fearful"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（肯定……只有死路一条……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema005"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "（该怎么办……<br>\n　我完全不知道）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "艾玛走向梅露露，静静地低下了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "长达数十秒的沉默。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative004"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "最后，用微弱的声音低语道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "——我也和梅露露一样哦。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema007"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "我最讨厌孤单了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema008"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "每句话之间<br>\n都隔了好几次呼吸那么长的停顿。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "（咦……我在说什么啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema009"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "（我知道自己在说什么吗？<br>\n　她明明把大家都杀了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema010"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "梅露露突然靠近，抓住了艾玛的双肩，<br>\n仿佛要打断艾玛的内心挣扎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "我就知道<br>\n艾玛小姐会这么说！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru002"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "你不想死对吧？<br>\n不想逃跑对吧？我们是朋友对吧？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "我当然理解你的烦恼。<br>\n感觉像是背叛了大家，很痛苦吧。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru004"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "梅露露悲伤地垂下眼帘，<br>\n随后突然绽放笑容，拍了拍手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "但没关系！<br>\n大家都死了。不幸中的万幸……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru005"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "就算背叛也没人会责备你。<br>\n所以你不会成为坏人。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru006"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "对艾玛小姐来说，安慰我<br>\n就是保持善良的唯一方法。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru007"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "……是、啊。<br>\n也许……是这样吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Fearful"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "（……好恶心）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema012"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "（她把大家的死当成什么了？<br>\n　这个人太奇怪了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema013"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "（但是……无论如何……<br>\n　我都没有勇气拒绝）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema014"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "（因为这只手，一定是我人生中<br>\n　最后一次朝我伸来的救赎）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema015"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "艾玛轻轻握住梅露露的手，<br>\n勉强挤出一丝僵硬的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "……梅露露。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema016"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "艾玛将自己的手覆在<br>\n抓住自己肩膀的梅露露的手上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "用微弱的、颤抖的声音，<br>\n犹豫着……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "压抑住所有的情感，<br>\n挤出了那句话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "……救救我。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema017"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "……嗯。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru008"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "听到艾玛的话，<br>\n梅露露也静静地微笑着，流下了一滴眼泪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "艾玛小姐……受拯救的是我才对。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru009"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "到现在为止，<br>\n从来没有人愿意靠近我。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru010"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "一直以来，我都很寂寞……<br>\n但大家的死并非毫无意义。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru011"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "因为，我遇到了这么棒的朋友。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru012"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "梅露露害羞地笑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "……嗯，嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema018"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "于是梅露露温柔地将艾玛抱在怀里。<br>\n艾玛静静地不断点头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "我好高兴……<br>\n以前从来没有过这样的事。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru013"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "（已经什么都搞不明白了。<br>\n　脑海中的思绪一片混乱）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema019"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "（总之……必须要接受<br>\n　梅露露）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema020"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "（我不能抛弃她。<br>\n　否则，我就……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema021"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "你不会抛弃我吧？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru014"]}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "……嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema022"]}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "……艾玛小姐……！<br>\n我大概，一定不会杀你的！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru015"]}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "（是啊。<br>\n　梅露露说话的时候是很温和的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema023"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "（她总是为别人着想，<br>\n　是个能为他人流泪的，温柔的人……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema024"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "（所以……我没有搞错。<br>\n　这是正确的选择）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema025"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "（现在，把内心放空吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema026"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "艾玛回应着拥抱自己的梅露露，<br>\n将手臂环绕在她的背上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "……我们一起寻找大魔女吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema027"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "……可以吗？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru016"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "……当然。<br>\n我也想解开诅咒。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema028"]}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "真让人安心……<br>\n至今，我都是一个人思考和做着各种事情。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru017"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Smile"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "我们马上……<br>\n准备迎接下一批预备魔女吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema029"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "为了能尽快找到大魔女。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema030"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "艾玛和梅露露手牵着手，<br>\n一起离开了审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative017"]}},
    {"op": "StopBgm", "line": 197, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 198, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 199, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 200, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 202, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "就这样，艾玛也成为了监牢的管理者，<br>\n和梅露露一起参与今后的计划——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative018"]}},
    {"op": "ModifyBackgroundExtended", "line": 208, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "PlayBgm", "line": 210, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 212, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 213, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "新来的人，听说是单亲家庭，我调查了一下，<br>\n她父亲因为债务自杀了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema031"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "这有什么问题吗？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru018"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "我们偷走另一个人的重要物品吧。<br>\n嫁祸给她，然后要求她归还。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema032"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "这大概会让她想起父亲的事，<br>\n刺激到她的心理创伤。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema033"]}},
    {"op": "ModifyCharacterExtended", "line": 223, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "哇，太棒了！<br>\n这样的话魔女化应该会马上得到触发。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru019"]}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "是啊。<br>\n其他人的心理创伤也要好好调查……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema034"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "平淡地说完后，<br>\n艾玛突然停住了呼吸，惊讶地睁大了眼睛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "（说起来，最近我什么都感觉不到了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema035"]}},
    {"op": "HideAllCharacters", "line": 237, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "尽管在制定伤害陌生人的计划，<br>\n艾玛的心却没有丝毫痛苦或罪恶感。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative020"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "就像平静的海面一样。<br>\n安静而平和。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative021"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "（多亏如此，我似乎不用担心会变成魔女了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema036"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "（如果一直纠结下去就没完没了，<br>\n　没办法啊，没办法……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema037"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "ModifyCharacterExtended", "line": 248, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "呵呵，艾玛小姐最近笑得更多了呢。<br>\n我很高兴。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru020"]}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "欸？我在笑吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema038"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "你没注意到吗？<br>\n现在也是，脸上露出了开心的表情哦。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru021"]}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "（我，看起来很开心……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema039"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "艾玛摸了摸自己的脸颊，<br>\n确实感觉嘴角上扬了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 260, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "刚好收到了下一批人选的资料，<br>\n待会能一起看看吗……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru022"]}},
    {"op": "ModifyCharacterExtended", "line": 264, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "当然可以。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema040"]}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "艾玛微笑着点头，<br>\n梅露露似乎松了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "艾玛小姐果然很可靠。<br>\n我一个人的话，是想不到这么多的……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru023"]}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Smile"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "只要我能帮上忙就好。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema041"]}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "艾玛高兴地说着，握住了梅露露的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 280, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "距离下一批预备魔女到来还有一点时间，<br>\n我们一起努力准备吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema042"]}},
    {"op": "ModifyCharacterExtended", "line": 284, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "好的。<br>\n这次一定要找到大魔女大人。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru024"]}},
    {"op": "ModifyBackgroundExtended", "line": 288, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "之后过了一段时间，<br>\n新的预备魔女们来到了监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative025"]}},
    {"op": "ResetText", "line": 292, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 293, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 294, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 295, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 297, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 299, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 300, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "这是什么鬼地方啊！", "AuthorId": "WitchCandidate1", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_WitchCandidate1001"]}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "我想回家。", "AuthorId": "WitchCandidate2", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_WitchCandidate2001"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "……吵死了。<br>\n别叽叽喳喳的。", "AuthorId": "WitchCandidate3", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_WitchCandidate3001"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "在久违地喧闹起来的监牢里，<br>\n艾玛和梅露露混在其他预备魔女中，<br>\n默默观察着情况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative026"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "（……真怀念我第一次来这里的那天啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema043"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "那天，大家也像今天这样<br>\n各自表露着心中的慌乱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative027"]}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "（但是，现在已经和那时不同了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema044"]}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "现在的艾玛，是以管理者的身份待在了这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative028"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "（希望大魔女就在这些人中间）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema045"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "正当艾玛这么想着时，<br>\n梅露露拉了拉她的袖子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "怎么了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema046"]}},
    {"op": "HideAllCharacters", "line": 326, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "其他预备魔女开始向会客厅走去。<br>\n在队伍的最后，艾玛和梅露露<br>\n悄悄交谈着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative030"]}},
    {"op": "ModifyCharacterExtended", "line": 330, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "那个，我……能做好吗？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru025"]}},
    {"op": "ModifyCharacterExtended", "line": 334, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default"}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "不用担心。<br>\n这次有我和你一起。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema047"]}},
    {"op": "HideAllCharacters", "line": 338, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "眼神略显暗淡的艾玛微笑着，握住了梅露露的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative031"]}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "两人的手指紧紧交缠，<br>\n仿佛在探寻对方的体温，不愿放开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative032"]}},
    {"op": "ModifyCharacterExtended", "line": 344, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0], "IdAndAppearance": "Ema.Smile"}},
    {"op": "ModifyCharacterExtended", "line": 345, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 347, "indent": 0, "params": {"Text": "我最喜欢梅露露了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Ema048"]}},
    {"op": "ModifyCharacterExtended", "line": 349, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "我也最喜欢艾玛小姐了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Meruru026"]}},
    {"op": "HideAllCharacters", "line": 353, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "听到梅露露的回应，<br>\n艾玛加重了握手的力度。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative033"]}},
    {"op": "PrintTextModified", "line": 357, "indent": 0, "params": {"Text": "艾玛注视着走在走廊上的<br>\n预备魔女们的背影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative034"]}},
    {"op": "PrintTextModified", "line": 359, "indent": 0, "params": {"Text": "不知道下一次听到惨叫声会是什么时候。<br>\n下一次听到求饶声又会是什么时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative035"]}},
    {"op": "PrintTextModified", "line": 361, "indent": 0, "params": {"Text": "在这仿佛永无止境的循环中，<br>\n除了被握住的手的温暖，一切都似乎是虚幻的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative036"]}},
    {"op": "PrintTextModified", "line": 363, "indent": 0, "params": {"Text": "艾玛决定永远不放开这只确实存在的手，<br>\n继续走在这条昏暗的道路上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative037"]}},
    {"op": "PrintTextModified", "line": 365, "indent": 0, "params": {"Text": "而代价，就是她们的生命。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Bad02_Narrative038"]}},
    {"op": "ProcessBadEnd", "line": 375, "indent": 0, "params": {"Number": 15}}
  ],
  "translations": {
  "0105Bad02_Ema001": "……孤身、一人……",
  "0105Bad02_Narrative001": "艾玛喃喃自语，仿佛在说梦话。",
  "0105Bad02_Meruru001": "呜呜……<br>\n温柔的艾玛小姐……你一定能理解我的，对吧？",
  "0105Bad02_Ema002": "（……她究竟在说些什么？<br>\n　我根本无法想像梅露露的心情）",
  "0105Bad02_Ema003": "（……但是，如果现在逃离梅露露的话<br>\n　……我会变成什么样呢）",
  "0105Bad02_Ema004": "（连离开这个岛的方法都找不到。<br>\n　独自一人，躲躲藏藏）",
  "0105Bad02_Narrative002": "艾玛脸色苍白，双手紧紧抱住<br>\n自己颤抖的身体。",
  "0105Bad02_Ema005": "（肯定……只有死路一条……）",
  "0105Bad02_Ema006": "（该怎么办……<br>\n　我完全不知道）",
  "0105Bad02_Narrative003": "艾玛走向梅露露，静静地低下了头。",
  "0105Bad02_Narrative004": "长达数十秒的沉默。",
  "0105Bad02_Narrative005": "最后，用微弱的声音低语道。",
  "0105Bad02_Ema007": "——我也和梅露露一样哦。",
  "0105Bad02_Ema008": "我最讨厌孤单了。",
  "0105Bad02_Narrative006": "每句话之间<br>\n都隔了好几次呼吸那么长的停顿。",
  "0105Bad02_Ema009": "（咦……我在说什么啊）",
  "0105Bad02_Ema010": "（我知道自己在说什么吗？<br>\n　她明明把大家都杀了）",
  "0105Bad02_Narrative007": "梅露露突然靠近，抓住了艾玛的双肩，<br>\n仿佛要打断艾玛的内心挣扎。",
  "0105Bad02_Meruru002": "我就知道<br>\n艾玛小姐会这么说！",
  "0105Bad02_Meruru003": "你不想死对吧？<br>\n不想逃跑对吧？我们是朋友对吧？",
  "0105Bad02_Meruru004": "我当然理解你的烦恼。<br>\n感觉像是背叛了大家，很痛苦吧。",
  "0105Bad02_Narrative008": "梅露露悲伤地垂下眼帘，<br>\n随后突然绽放笑容，拍了拍手。",
  "0105Bad02_Meruru005": "但没关系！<br>\n大家都死了。不幸中的万幸……！",
  "0105Bad02_Meruru006": "就算背叛也没人会责备你。<br>\n所以你不会成为坏人。",
  "0105Bad02_Meruru007": "对艾玛小姐来说，安慰我<br>\n就是保持善良的唯一方法。",
  "0105Bad02_Ema011": "……是、啊。<br>\n也许……是这样吧。",
  "0105Bad02_Ema012": "（……好恶心）",
  "0105Bad02_Ema013": "（她把大家的死当成什么了？<br>\n　这个人太奇怪了……）",
  "0105Bad02_Ema014": "（但是……无论如何……<br>\n　我都没有勇气拒绝）",
  "0105Bad02_Ema015": "（因为这只手，一定是我人生中<br>\n　最后一次朝我伸来的救赎）",
  "0105Bad02_Narrative009": "艾玛轻轻握住梅露露的手，<br>\n勉强挤出一丝僵硬的微笑。",
  "0105Bad02_Ema016": "……梅露露。",
  "0105Bad02_Narrative010": "艾玛将自己的手覆在<br>\n抓住自己肩膀的梅露露的手上。",
  "0105Bad02_Narrative011": "用微弱的、颤抖的声音，<br>\n犹豫着……",
  "0105Bad02_Narrative012": "压抑住所有的情感，<br>\n挤出了那句话。",
  "0105Bad02_Ema017": "……救救我。",
  "0105Bad02_Meruru008": "……嗯。",
  "0105Bad02_Narrative013": "听到艾玛的话，<br>\n梅露露也静静地微笑着，流下了一滴眼泪。",
  "0105Bad02_Meruru009": "艾玛小姐……受拯救的是我才对。",
  "0105Bad02_Meruru010": "到现在为止，<br>\n从来没有人愿意靠近我。",
  "0105Bad02_Meruru011": "一直以来，我都很寂寞……<br>\n但大家的死并非毫无意义。",
  "0105Bad02_Meruru012": "因为，我遇到了这么棒的朋友。",
  "0105Bad02_Narrative014": "梅露露害羞地笑了。",
  "0105Bad02_Ema018": "……嗯，嗯。",
  "0105Bad02_Narrative015": "于是梅露露温柔地将艾玛抱在怀里。<br>\n艾玛静静地不断点头。",
  "0105Bad02_Meruru013": "我好高兴……<br>\n以前从来没有过这样的事。",
  "0105Bad02_Ema019": "（已经什么都搞不明白了。<br>\n　脑海中的思绪一片混乱）",
  "0105Bad02_Ema020": "（总之……必须要接受<br>\n　梅露露）",
  "0105Bad02_Ema021": "（我不能抛弃她。<br>\n　否则，我就……）",
  "0105Bad02_Meruru014": "你不会抛弃我吧？",
  "0105Bad02_Ema022": "……嗯。",
  "0105Bad02_Meruru015": "……艾玛小姐……！<br>\n我大概，一定不会杀你的！",
  "0105Bad02_Ema023": "（是啊。<br>\n　梅露露说话的时候是很温和的……）",
  "0105Bad02_Ema024": "（她总是为别人着想，<br>\n　是个能为他人流泪的，温柔的人……）",
  "0105Bad02_Ema025": "（所以……我没有搞错。<br>\n　这是正确的选择）",
  "0105Bad02_Ema026": "（现在，把内心放空吧）",
  "0105Bad02_Narrative016": "艾玛回应着拥抱自己的梅露露，<br>\n将手臂环绕在她的背上。",
  "0105Bad02_Ema027": "……我们一起寻找大魔女吧。",
  "0105Bad02_Meruru016": "……可以吗？",
  "0105Bad02_Ema028": "……当然。<br>\n我也想解开诅咒。",
  "0105Bad02_Meruru017": "真让人安心……<br>\n至今，我都是一个人思考和做着各种事情。",
  "0105Bad02_Ema029": "我们马上……<br>\n准备迎接下一批预备魔女吧。",
  "0105Bad02_Ema030": "为了能尽快找到大魔女。",
  "0105Bad02_Narrative017": "艾玛和梅露露手牵着手，<br>\n一起离开了审判庭。",
  "0105Bad02_Narrative018": "就这样，艾玛也成为了监牢的管理者，<br>\n和梅露露一起参与今后的计划——",
  "0105Bad02_Ema031": "新来的人，听说是单亲家庭，我调查了一下，<br>\n她父亲因为债务自杀了。",
  "0105Bad02_Meruru018": "这有什么问题吗？",
  "0105Bad02_Ema032": "我们偷走另一个人的重要物品吧。<br>\n嫁祸给她，然后要求她归还。",
  "0105Bad02_Ema033": "这大概会让她想起父亲的事，<br>\n刺激到她的心理创伤。",
  "0105Bad02_Meruru019": "哇，太棒了！<br>\n这样的话魔女化应该会马上得到触发。",
  "0105Bad02_Ema034": "是啊。<br>\n其他人的心理创伤也要好好调查……",
  "0105Bad02_Narrative019": "平淡地说完后，<br>\n艾玛突然停住了呼吸，惊讶地睁大了眼睛。",
  "0105Bad02_Ema035": "（说起来，最近我什么都感觉不到了……）",
  "0105Bad02_Narrative020": "尽管在制定伤害陌生人的计划，<br>\n艾玛的心却没有丝毫痛苦或罪恶感。",
  "0105Bad02_Narrative021": "就像平静的海面一样。<br>\n安静而平和。",
  "0105Bad02_Ema036": "（多亏如此，我似乎不用担心会变成魔女了）",
  "0105Bad02_Ema037": "（如果一直纠结下去就没完没了，<br>\n　没办法啊，没办法……）",
  "0105Bad02_Meruru020": "呵呵，艾玛小姐最近笑得更多了呢。<br>\n我很高兴。",
  "0105Bad02_Ema038": "欸？我在笑吗？",
  "0105Bad02_Meruru021": "你没注意到吗？<br>\n现在也是，脸上露出了开心的表情哦。",
  "0105Bad02_Ema039": "（我，看起来很开心……？）",
  "0105Bad02_Narrative022": "艾玛摸了摸自己的脸颊，<br>\n确实感觉嘴角上扬了。",
  "0105Bad02_Meruru022": "刚好收到了下一批人选的资料，<br>\n待会能一起看看吗……？",
  "0105Bad02_Ema040": "当然可以。",
  "0105Bad02_Narrative023": "艾玛微笑着点头，<br>\n梅露露似乎松了一口气。",
  "0105Bad02_Meruru023": "艾玛小姐果然很可靠。<br>\n我一个人的话，是想不到这么多的……",
  "0105Bad02_Ema041": "只要我能帮上忙就好。",
  "0105Bad02_Narrative024": "艾玛高兴地说着，握住了梅露露的手。",
  "0105Bad02_Ema042": "距离下一批预备魔女到来还有一点时间，<br>\n我们一起努力准备吧。",
  "0105Bad02_Meruru024": "好的。<br>\n这次一定要找到大魔女大人。",
  "0105Bad02_Narrative025": "之后过了一段时间，<br>\n新的预备魔女们来到了监牢。",
  "0105Bad02_WitchCandidate1001": "这是什么鬼地方啊！",
  "0105Bad02_WitchCandidate2001": "我想回家。",
  "0105Bad02_WitchCandidate3001": "……吵死了。<br>\n别叽叽喳喳的。",
  "0105Bad02_Narrative026": "在久违地喧闹起来的监牢里，<br>\n艾玛和梅露露混在其他预备魔女中，<br>\n默默观察着情况。",
  "0105Bad02_Ema043": "（……真怀念我第一次来这里的那天啊）",
  "0105Bad02_Narrative027": "那天，大家也像今天这样<br>\n各自表露着心中的慌乱。",
  "0105Bad02_Ema044": "（但是，现在已经和那时不同了）",
  "0105Bad02_Narrative028": "现在的艾玛，是以管理者的身份待在了这里。",
  "0105Bad02_Ema045": "（希望大魔女就在这些人中间）",
  "0105Bad02_Narrative029": "正当艾玛这么想着时，<br>\n梅露露拉了拉她的袖子。",
  "0105Bad02_Ema046": "怎么了？",
  "0105Bad02_Narrative030": "其他预备魔女开始向会客厅走去。<br>\n在队伍的最后，艾玛和梅露露<br>\n悄悄交谈着。",
  "0105Bad02_Meruru025": "那个，我……能做好吗？",
  "0105Bad02_Ema047": "不用担心。<br>\n这次有我和你一起。",
  "0105Bad02_Narrative031": "眼神略显暗淡的艾玛微笑着，握住了梅露露的手。",
  "0105Bad02_Narrative032": "两人的手指紧紧交缠，<br>\n仿佛在探寻对方的体温，不愿放开。",
  "0105Bad02_Ema048": "我最喜欢梅露露了。",
  "0105Bad02_Meruru026": "我也最喜欢艾玛小姐了。",
  "0105Bad02_Narrative033": "听到梅露露的回应，<br>\n艾玛加重了握手的力度。",
  "0105Bad02_Narrative034": "艾玛注视着走在走廊上的<br>\n预备魔女们的背影。",
  "0105Bad02_Narrative035": "不知道下一次听到惨叫声会是什么时候。<br>\n下一次听到求饶声又会是什么时候。",
  "0105Bad02_Narrative036": "在这仿佛永无止境的循环中，<br>\n除了被握住的手的温暖，一切都似乎是虚幻的。",
  "0105Bad02_Narrative037": "艾玛决定永远不放开这只确实存在的手，<br>\n继续走在这条昏暗的道路上。",
  "0105Bad02_Narrative038": "而代价，就是她们的生命。"
}
}
