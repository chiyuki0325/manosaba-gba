  "path": "Act01_Chapter05/Act01_Chapter05_Adv03",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-5-3", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "310_1"}},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_26_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛回到了案发现场，也就是审判庭，<br>\n决定调查奈叶香的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "（必须要先调查这里才行……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "刚才艾玛差点被处刑的地方，<br>\n正横亘着奈叶香的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "奈叶香到底是不是被人杀害的呢……<br>\n光看外表看不出来呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Margo001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "呜呜……为什么连奈叶香小姐都……<br>\n这种日子到底要持续到什么时候……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Meruru001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "……大概要持续到所有人都死光吧。<br>\n不过我可不会死。<br>\n我一定要活到最后……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Coco001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "艾玛瞥了一眼在稍远处交谈的少女们，<br>\n走近奈叶香的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative003"]}},
    {"op": "PlaySfxModified", "line": 35, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 40, "indent": 0, "params": {"Path": "Clue", "Params": ["5-13"]}},
    {"op": "UpdateWitchBook", "line": 41, "indent": 0, "params": {"Id": "5-13", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 42, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（和玛格说的一样，<br>\n　没有明显外伤，死因不明……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema002"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "（表面有些冻结的痕迹……<br>\n　是冻死……？不，不可能）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema003"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（还没有证据能证明是冻死。<br>\n　再仔细调查一下吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema004"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "无论经历多少次都不可能习惯。<br>\n艾玛强忍着抗拒的心情，<br>\n用颤抖的双手仔细检查奈叶香的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative004"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "其他三名少女聚在一起，<br>\n只是默默地看着艾玛行动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative005"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "她们脸上写满了摇摆不定，<br>\n一副不知是该帮助艾玛，还是该怀疑艾玛的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "就在这时，梅露露下定决心，向前一步，<br>\n站在了艾玛身边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative007"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "艾玛小姐，我也来帮忙……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Meruru002"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "梅露露……谢谢你。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema005"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "艾玛一道谢，<br>\n梅露露就好像要哭出来似的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative008"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "请不要感谢我……<br>\n我又胆小、又爱哭，所以……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Meruru003"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "我很讨厌这样的自己……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Meruru004"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "梅露露的手轻轻碰触艾玛的膝盖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative009"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "是刚才险些被处刑，看守准备拘禁艾玛的时候，<br>\n因为挣扎导致受了些皮外伤。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative010"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "（原来受伤了啊，我自己都没发现……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema006"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "膝盖附近升起一股暖流，<br>\n擦伤慢慢消失了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative011"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "艾玛紧紧握住梅露露发光的手，<br>\n微笑着说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative012"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "和梅露露相遇的那天，<br>\n你也是像这样，帮我治疗了呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema007"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "而且审判过程中也一直支持着我。<br>\n其实我一直都在被梅露露拯救。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema008"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "所以，不要责怪自己。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema009"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "听到艾玛的话，梅露露咬着嘴唇，<br>\n强忍着随时都要哭出来的冲动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative013"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "梅露露掌心的温暖<br>\n似乎给艾玛带来了力量。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative014"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "……根据我的调查，<br>\n奈叶香小姐果然还是死因不明……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Meruru005"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "口腔里看起来有伤，<br>\n但又不像是致命伤……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Meruru006"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "是啊……有很多令人费解之处，<br>\n更不知道她到底是怎么死的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema010"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "一边说着，一边检查奈叶香尸体，<br>\n这时忽然在奈叶香口袋里发现了一张折叠着的小小纸条。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative015"]}},
    {"op": "SpawnExtended", "line": 99, "indent": 0, "params": {"Path": "Clue", "Params": ["5-8"]}},
    {"op": "UpdateWitchBook", "line": 100, "indent": 0, "params": {"Id": "5-8", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 101, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "（这是……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema011"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "纸条上潦草地写着<br>\n【169231】这样一串数字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative016"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（是暗号？难道是指向凶手的线索？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema012"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "虽然想不明白，<br>\n但看起来可能是重要线索，<br>\n所以还是收了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative017"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "（……这是……<br>\n　她指尖上沾着一点点血）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema013"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "奈叶香的指尖虽然没有伤口，<br>\n但却沾着轻微血迹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative018"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "（……这到底是什么呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema014"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "……之后又调查了一会，<br>\n但没有发现其他线索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative019"]}},
    {"op": "HidePrinter", "line": 119, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 120, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "13_1"}},
    {"op": "HideActors", "line": 121, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 122, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 123, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "有些地方我想去看看，<br>\n所以我现在打算去调查其他地方。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Ema015"]}},
    {"op": "HideAllCharacters", "line": 129, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "艾玛这么说着，<br>\n可可就一脸不情愿地走了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "那，<br>\n就由我来陪同艾玛亲……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Coco002"]}},
    {"op": "HideAllCharacters", "line": 137, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "好。我们就留在这里。<br>\n——艾玛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Margo002"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "艾玛突然被玛格喊住，<br>\n于是猛地抬头看向她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Angry1,ArmR5"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "对你来说，<br>\n这一定是最后一次审判了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Margo003"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "你说过，不会让任何人死去，<br>\n大家会一起逃出监牢，对吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Margo004"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "那就让我好好看看你的本事吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Margo005"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "玛格从容地微笑着，<br>\n用挑战的视线煽动着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv03_Narrative022"]}},
    {"op": "Gosub", "line": 159, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 161, "indent": 0, "params": {"Path": "Act01_Chapter05/Act01_Chapter05_Adv02", "SoftReset": 1}}
  ],
  "translations": {
  "0105Adv03_Narrative001": "艾玛回到了案发现场，也就是审判庭，<br>\n决定调查奈叶香的尸体。",
  "0105Adv03_Ema001": "（必须要先调查这里才行……）",
  "0105Adv03_Narrative002": "刚才艾玛差点被处刑的地方，<br>\n正横亘着奈叶香的尸体。",
  "0105Adv03_Margo001": "奈叶香到底是不是被人杀害的呢……<br>\n光看外表看不出来呢。",
  "0105Adv03_Meruru001": "呜呜……为什么连奈叶香小姐都……<br>\n这种日子到底要持续到什么时候……",
  "0105Adv03_Coco001": "……大概要持续到所有人都死光吧。<br>\n不过我可不会死。<br>\n我一定要活到最后……",
  "0105Adv03_Narrative003": "艾玛瞥了一眼在稍远处交谈的少女们，<br>\n走近奈叶香的尸体。",
  "0105Adv03_Ema002": "（和玛格说的一样，<br>\n　没有明显外伤，死因不明……）",
  "0105Adv03_Ema003": "（表面有些冻结的痕迹……<br>\n　是冻死……？不，不可能）",
  "0105Adv03_Ema004": "（还没有证据能证明是冻死。<br>\n　再仔细调查一下吧）",
  "0105Adv03_Narrative004": "无论经历多少次都不可能习惯。<br>\n艾玛强忍着抗拒的心情，<br>\n用颤抖的双手仔细检查奈叶香的尸体。",
  "0105Adv03_Narrative005": "其他三名少女聚在一起，<br>\n只是默默地看着艾玛行动。",
  "0105Adv03_Narrative006": "她们脸上写满了摇摆不定，<br>\n一副不知是该帮助艾玛，还是该怀疑艾玛的样子。",
  "0105Adv03_Narrative007": "就在这时，梅露露下定决心，向前一步，<br>\n站在了艾玛身边。",
  "0105Adv03_Meruru002": "艾玛小姐，我也来帮忙……",
  "0105Adv03_Ema005": "梅露露……谢谢你。",
  "0105Adv03_Narrative008": "艾玛一道谢，<br>\n梅露露就好像要哭出来似的。",
  "0105Adv03_Meruru003": "请不要感谢我……<br>\n我又胆小、又爱哭，所以……",
  "0105Adv03_Meruru004": "我很讨厌这样的自己……",
  "0105Adv03_Narrative009": "梅露露的手轻轻碰触艾玛的膝盖。",
  "0105Adv03_Narrative010": "是刚才险些被处刑，看守准备拘禁艾玛的时候，<br>\n因为挣扎导致受了些皮外伤。",
  "0105Adv03_Ema006": "（原来受伤了啊，我自己都没发现……）",
  "0105Adv03_Narrative011": "膝盖附近升起一股暖流，<br>\n擦伤慢慢消失了。",
  "0105Adv03_Narrative012": "艾玛紧紧握住梅露露发光的手，<br>\n微笑着说。",
  "0105Adv03_Ema007": "和梅露露相遇的那天，<br>\n你也是像这样，帮我治疗了呢。",
  "0105Adv03_Ema008": "而且审判过程中也一直支持着我。<br>\n其实我一直都在被梅露露拯救。",
  "0105Adv03_Ema009": "所以，不要责怪自己。",
  "0105Adv03_Narrative013": "听到艾玛的话，梅露露咬着嘴唇，<br>\n强忍着随时都要哭出来的冲动。",
  "0105Adv03_Narrative014": "梅露露掌心的温暖<br>\n似乎给艾玛带来了力量。",
  "0105Adv03_Meruru005": "……根据我的调查，<br>\n奈叶香小姐果然还是死因不明……",
  "0105Adv03_Meruru006": "口腔里看起来有伤，<br>\n但又不像是致命伤……",
  "0105Adv03_Ema010": "是啊……有很多令人费解之处，<br>\n更不知道她到底是怎么死的……",
  "0105Adv03_Narrative015": "一边说着，一边检查奈叶香尸体，<br>\n这时忽然在奈叶香口袋里发现了一张折叠着的小小纸条。",
  "0105Adv03_Ema011": "（这是……？）",
  "0105Adv03_Narrative016": "纸条上潦草地写着<br>\n【169231】这样一串数字。",
  "0105Adv03_Ema012": "（是暗号？难道是指向凶手的线索？）",
  "0105Adv03_Narrative017": "虽然想不明白，<br>\n但看起来可能是重要线索，<br>\n所以还是收了起来。",
  "0105Adv03_Ema013": "（……这是……<br>\n　她指尖上沾着一点点血）",
  "0105Adv03_Narrative018": "奈叶香的指尖虽然没有伤口，<br>\n但却沾着轻微血迹。",
  "0105Adv03_Ema014": "（……这到底是什么呢）",
  "0105Adv03_Narrative019": "……之后又调查了一会，<br>\n但没有发现其他线索。",
  "0105Adv03_Ema015": "有些地方我想去看看，<br>\n所以我现在打算去调查其他地方。",
  "0105Adv03_Narrative020": "艾玛这么说着，<br>\n可可就一脸不情愿地走了过来。",
  "0105Adv03_Coco002": "那，<br>\n就由我来陪同艾玛亲……",
  "0105Adv03_Margo002": "好。我们就留在这里。<br>\n——艾玛。",
  "0105Adv03_Narrative021": "艾玛突然被玛格喊住，<br>\n于是猛地抬头看向她。",
  "0105Adv03_Margo003": "对你来说，<br>\n这一定是最后一次审判了。",
  "0105Adv03_Margo004": "你说过，不会让任何人死去，<br>\n大家会一起逃出监牢，对吧。",
  "0105Adv03_Margo005": "那就让我好好看看你的本事吧。",
  "0105Adv03_Narrative022": "玛格从容地微笑着，<br>\n用挑战的视线煽动着艾玛。"
}
}
