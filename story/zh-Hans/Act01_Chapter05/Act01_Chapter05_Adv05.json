    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "熟悉的钟声响起，<br>\n艾玛等人回到了审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv05_Narrative002"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "奈叶香的尸体已经像亚里沙一样被处理掉了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv05_Narrative003"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "艾玛、可可、玛格、梅露露四人<br>\n静静地站在证人席前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv05_Narrative004"]}},
