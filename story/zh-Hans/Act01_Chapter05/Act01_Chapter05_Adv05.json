  "translations": {
  "0105Adv05_Narrative001": "在剩余的时间内搜索周边时——",
  "0105Adv05_Narrative002": "熟悉的钟声响起，<br>\n艾玛等人回到了审判庭。",
  "0105Adv05_Narrative003": "奈叶香的尸体已经像亚里沙一样被处理掉了。",
  "0105Adv05_Narrative004": "艾玛、可可、玛格、梅露露四人<br>\n静静地站在证人席前。",
  "0105Adv05_Margo001": "没想到一天之内要进行两次审判呢。",
  "0105Adv05_Coco001": "快点结束吧～，<br>\n我已经累趴下啦～",
  "0105Adv05_Meruru001": "艾玛小姐……",
  "0105Adv05_Narrative005": "看到梅露露眼中流露出不安，<br>\n艾玛坚定地朝她点头。",
  "0105Adv05_Ema001": "（没事的，梅露露。<br>\n　我已经把能做的都做了）",
  "0105Adv05_Ema002": "（这一定是我最后的审判了）",
  "0105Adv05_Ema003": "（我一定要找出【魔女】——！）",
  "0105Adv05_Warden001": "那么，魔女审判现在开庭！"
}
