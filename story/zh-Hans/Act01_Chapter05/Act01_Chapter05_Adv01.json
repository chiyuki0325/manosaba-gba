    {"op": "label", "name": "Scene1-5-1", "line": 13, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 20, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 23, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "走出审判庭，<br>\n艾玛长长地舒了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "身旁的可可一脸沮丧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "吓死人了……搞不懂奈叶香怎么就死了，<br>\n还出现在那里……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR3,ArmL2"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "不过对艾玛亲来说，倒是好事吧。<br>\n总算是捡回一条命了嘛。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Coco002"]}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema001"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "（奈叶香被杀，怎么可能是好事……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema002"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "（但我确实为了自己活下去，<br>\n　利用了奈叶香的死……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema003"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "——由于处刑台上出现了奈叶香的尸体，<br>\n艾玛以此为依据拼命说服了典狱长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative003"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "她坚称，自己是重要证人，<br>\n在奈叶香被杀案真相大白之前<br>\n不应执行处刑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative004"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "于是，典狱长勉强同意再次举行魔女审判，<br>\n并额外允许短暂的调查。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "直到下次审判开始，典狱长允许调查的时间<br>\n仅仅只有一小时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative006"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "（留给我的时间，实在太少了……<br>\n　就算现在不被处刑，这样下去我也会……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema004"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "内心的黑暗不断膨胀，<br>\n艾玛感到一阵强烈的眩晕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "你看起来快撑不住了啊……<br>\n这样还能调查吗？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Coco003"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "……就算做不到也必须去做。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema005"]}},
    {"op": "HideAllCharacters", "line": 66, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "唉……你这么拼命，<br>\n我陪着你拼命也很累啊。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Coco004"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（但又不能叫她不要跟着我……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema006"]}},
    {"op": "HideAllCharacters", "line": 73, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "和可可一起行动<br>\n是有原因的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative008"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "因为这次是破格允许调查，<br>\n典狱长提出了一些限制条件。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative009"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "为了保全尸体证据，<br>\n要求两个人留在审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative010"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "而且，如果艾玛要外出调查，<br>\n必须有人陪同。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative011"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "少女们在尴尬的气氛中简单商量后，<br>\n决定由玛格和梅露露留下来负责保全证据，<br>\n可可负责陪同艾玛调查。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "时间不多了，<br>\n我们赶快开始调查吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema007"]}},
    {"op": "HideAllCharacters", "line": 89, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "艾玛快步走出，<br>\n可可一脸疲惫地跟在后面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "……喂，如果你想逃跑，<br>\n我可会毫不留情地告诉典狱长哦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Coco005"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "（……可可一定认为，<br>\n　杀害亚里沙的凶手就是我，<br>\n　而且奈叶香也是我杀的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema008"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "嗯，那样就好。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema009"]}},
    {"op": "HideAllCharacters", "line": 103, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "艾玛转过头回答道。<br>\n可可尴尬地移开了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative014"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（现在我身边已经没有任何人……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema010"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "从预感到所有人都会背弃自己，<br>\n让自己孤立无援的那一刻起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative015"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "——艾玛的内心中，有什么在蠢蠢欲动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative016"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "艾玛用力摇了摇头，<br>\n努力追寻心中残存的光芒。<br>\n再次回想起至今为止，与那些少女们一同编织出的牵绊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative017"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "（我并不是孤身一人）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Ema011"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "深呼吸后，意识变得清晰，<br>\n能够坚定地直视前方了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative018"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "这一次，<br>\n艾玛坚定地迈出了调查的脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0105Adv01_Narrative019"]}},
    {"op": "SetCustomVariable", "line": 121, "indent": 0, "params": {"Expression": "chosenAreaFlag = 0"}},
    {"op": "Gosub", "line": 122, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 124, "indent": 0, "params": {"Path": "Act01_Chapter05/Act01_Chapter05_Adv02", "SoftReset": 1}}
  ],
  "translations": {
  "0105Adv01_Narrative001": "走出审判庭，<br>\n艾玛长长地舒了一口气。",
  "0105Adv01_Narrative002": "身旁的可可一脸沮丧。",
  "0105Adv01_Coco001": "吓死人了……搞不懂奈叶香怎么就死了，<br>\n还出现在那里……",
  "0105Adv01_Coco002": "不过对艾玛亲来说，倒是好事吧。<br>\n总算是捡回一条命了嘛。",
  "0105Adv01_Ema001": "…………",
  "0105Adv01_Ema002": "（奈叶香被杀，怎么可能是好事……）",
  "0105Adv01_Ema003": "（但我确实为了自己活下去，<br>\n　利用了奈叶香的死……）",
  "0105Adv01_Narrative003": "——由于处刑台上出现了奈叶香的尸体，<br>\n艾玛以此为依据拼命说服了典狱长。",
  "0105Adv01_Narrative004": "她坚称，自己是重要证人，<br>\n在奈叶香被杀案真相大白之前<br>\n不应执行处刑。",
  "0105Adv01_Narrative005": "于是，典狱长勉强同意再次举行魔女审判，<br>\n并额外允许短暂的调查。",
  "0105Adv01_Narrative006": "直到下次审判开始，典狱长允许调查的时间<br>\n仅仅只有一小时。",
  "0105Adv01_Ema004": "（留给我的时间，实在太少了……<br>\n　就算现在不被处刑，这样下去我也会……）",
  "0105Adv01_Narrative007": "内心的黑暗不断膨胀，<br>\n艾玛感到一阵强烈的眩晕。",
  "0105Adv01_Coco003": "你看起来快撑不住了啊……<br>\n这样还能调查吗？",
  "0105Adv01_Ema005": "……就算做不到也必须去做。",
  "0105Adv01_Coco004": "唉……你这么拼命，<br>\n我陪着你拼命也很累啊。",
  "0105Adv01_Ema006": "（但又不能叫她不要跟着我……）",
  "0105Adv01_Narrative008": "和可可一起行动<br>\n是有原因的。",
  "0105Adv01_Narrative009": "因为这次是破格允许调查，<br>\n典狱长提出了一些限制条件。",
  "0105Adv01_Narrative010": "为了保全尸体证据，<br>\n要求两个人留在审判庭。",
  "0105Adv01_Narrative011": "而且，如果艾玛要外出调查，<br>\n必须有人陪同。",
  "0105Adv01_Narrative012": "少女们在尴尬的气氛中简单商量后，<br>\n决定由玛格和梅露露留下来负责保全证据，<br>\n可可负责陪同艾玛调查。",
  "0105Adv01_Ema007": "时间不多了，<br>\n我们赶快开始调查吧。",
  "0105Adv01_Narrative013": "艾玛快步走出，<br>\n可可一脸疲惫地跟在后面。",
  "0105Adv01_Coco005": "……喂，如果你想逃跑，<br>\n我可会毫不留情地告诉典狱长哦。",
  "0105Adv01_Ema008": "（……可可一定认为，<br>\n　杀害亚里沙的凶手就是我，<br>\n　而且奈叶香也是我杀的……）",
  "0105Adv01_Ema009": "嗯，那样就好。",
  "0105Adv01_Narrative014": "艾玛转过头回答道。<br>\n可可尴尬地移开了视线。",
  "0105Adv01_Ema010": "（现在我身边已经没有任何人……）",
  "0105Adv01_Narrative015": "从预感到所有人都会背弃自己，<br>\n让自己孤立无援的那一刻起。",
  "0105Adv01_Narrative016": "——艾玛的内心中，有什么在蠢蠢欲动。",
  "0105Adv01_Narrative017": "艾玛用力摇了摇头，<br>\n努力追寻心中残存的光芒。<br>\n再次回想起至今为止，与那些少女们一同编织出的牵绊。",
  "0105Adv01_Ema011": "（我并不是孤身一人）",
  "0105Adv01_Narrative018": "深呼吸后，意识变得清晰，<br>\n能够坚定地直视前方了。",
  "0105Adv01_Narrative019": "这一次，<br>\n艾玛坚定地迈出了调查的脚步。"
}
}
