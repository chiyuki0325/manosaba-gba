    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "……魔女之岛再一次翱翔于天际。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial00_Yuki005"]}},
