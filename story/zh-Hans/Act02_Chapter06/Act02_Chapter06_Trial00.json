    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "接下来，我会周游世界。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial00_Yuki007"]}},
