    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "什么……！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial00_Hiro003"]}},
    {"op": "StopBgm", "line": 222, "indent": 0, "params": {}},
