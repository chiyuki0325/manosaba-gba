    {"op": "ModifyTextPrinter", "line": 3, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Gosub", "line": 4, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 14, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 15, "indent": 0, "params": {"BgmPath": "Bgm_1_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 20, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S01", "Wait": 0}},
    {"op": "Wait", "line": 21, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "那是一个，很久很久以前的故事。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "曾经在那座岛上，有许多魔女和睦地生活在一起。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki002"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "魔女们天生拥有魔法的力量，<br>\n并发展出了独属于她们的文明。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki003"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "她们偶尔与来到岛上的人类接触，<br>\n却始终避免与外界打交道，过着平静的生活。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki004"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "但——<br>\n和平的日常，迎来了终结。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki005"]}},
    {"op": "ResetText", "line": 33, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 34, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 35, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 38, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S02", "Wait": 0}},
    {"op": "Wait", "line": 39, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "人类的军队出现了。<br>\n他们捕捉、杀害魔女们，还破坏了岛屿。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki006"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "活下来的是统治魔女之岛的大魔女中的一人……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki007"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "年纪最小，却最擅长魔法的——雪。<br>\n只有小雪一人幸存。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki008"]}},
    {"op": "ResetText", "line": 47, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 48, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S02", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 49, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 52, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S03", "Wait": 0}},
    {"op": "Wait", "line": 53, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "她决心为同胞复仇。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki009"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "为了让人们遭受和魔女们同样的命运，<br>\n她剥裂自己的灵魂，<br>\n将其转化为魔女因子并散播给人类。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki010"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "这是一种诅咒。能让人类变成自己创造出来的幻想怪物——<br>\n【魔女】，并最终死去。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki011"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "她在复仇心的支配下，<br>\n将一个捡来的人类少女……<br>\n梅露露当作实验体，完成了术法。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki012"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "虽然因为人类的繁殖力太强，<br>\n要让每个人都感染魔女因子需要很长时间……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki013"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "但她始终没有放弃。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki014"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "许多年后，<br>\n当几乎所有人类都成功植入了魔女因子时……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki015"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "她遇见了两个少女。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki016"]}},
    {"op": "ResetText", "line": 71, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 72, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S03", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 73, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 76, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S04", "Wait": 0}},
    {"op": "Wait", "line": 77, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "那就是艾玛和希罗。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki017"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "在与她们心灵相通的过程中，<br>\n小雪心中的复仇之火逐渐变得黯淡。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki018"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "她的内心……产生了迷茫。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki019"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "但是她无法停下。<br>\n……她不可以停下。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki020"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "所以，她把一切都托付给了艾玛。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki021"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "将人类的命运……以及自己的复仇计划……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki022"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "如同将赌注交给命运，<br>\n她把自己精心铺陈的计划，<br>\n托付给了他人之手。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki023"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "最终……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki024"]}},
    {"op": "ResetText", "line": 95, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 96, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S04", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 97, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 100, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S05", "Wait": 0}},
    {"op": "Wait", "line": 101, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "我终究……还是没有做到。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki025"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "是太过漫长的岁月让感情渐渐麻木……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki026"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "还是我与人类交集得太深……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki027"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我的复仇之心……已经锈蚀了。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki028"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "岛上的魔女们……会不会笑我呢。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki029"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "那些变成魔女、因此死去的人类们……<br>\n会不会怨恨我呢。", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki030"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "即便如此……", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki031"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "此刻我只想，<br>\n任由自己沉浸在这温柔的浅眠之中——", "AuthorId": "Yuki", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0206Trial10_Yuki032"]}},
    {"op": "ResetText", "line": 119, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 120, "indent": 0, "params": {"Path": "Reenact_Ch02_E06_S05", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 121, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "SetCustomVariable", "line": 123, "indent": 0, "params": {"Expression": "isReenact = false"}},
    {"op": "Gosub", "line": 124, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 126, "indent": 0, "params": {"Path": "Act02_Chapter05/Act02_Chapter05_Adv06", "SoftReset": 1}}
  ],
  "translations": {
  "0206Trial10_Yuki001": "那是一个，很久很久以前的故事。",
  "0206Trial10_Yuki002": "曾经在那座岛上，有许多魔女和睦地生活在一起。",
  "0206Trial10_Yuki003": "魔女们天生拥有魔法的力量，<br>\n并发展出了独属于她们的文明。",
  "0206Trial10_Yuki004": "她们偶尔与来到岛上的人类接触，<br>\n却始终避免与外界打交道，过着平静的生活。",
  "0206Trial10_Yuki005": "但——<br>\n和平的日常，迎来了终结。",
  "0206Trial10_Yuki006": "人类的军队出现了。<br>\n他们捕捉、杀害魔女们，还破坏了岛屿。",
  "0206Trial10_Yuki007": "活下来的是统治魔女之岛的大魔女中的一人……",
  "0206Trial10_Yuki008": "年纪最小，却最擅长魔法的——雪。<br>\n只有小雪一人幸存。",
  "0206Trial10_Yuki009": "她决心为同胞复仇。",
  "0206Trial10_Yuki010": "为了让人们遭受和魔女们同样的命运，<br>\n她剥裂自己的灵魂，<br>\n将其转化为魔女因子并散播给人类。",
  "0206Trial10_Yuki011": "这是一种诅咒。能让人类变成自己创造出来的幻想怪物——<br>\n【魔女】，并最终死去。",
  "0206Trial10_Yuki012": "她在复仇心的支配下，<br>\n将一个捡来的人类少女……<br>\n梅露露当作实验体，完成了术法。",
  "0206Trial10_Yuki013": "虽然因为人类的繁殖力太强，<br>\n要让每个人都感染魔女因子需要很长时间……",
  "0206Trial10_Yuki014": "但她始终没有放弃。",
  "0206Trial10_Yuki015": "许多年后，<br>\n当几乎所有人类都成功植入了魔女因子时……",
  "0206Trial10_Yuki016": "她遇见了两个少女。",
  "0206Trial10_Yuki017": "那就是艾玛和希罗。",
  "0206Trial10_Yuki018": "在与她们心灵相通的过程中，<br>\n小雪心中的复仇之火逐渐变得黯淡。",
  "0206Trial10_Yuki019": "她的内心……产生了迷茫。",
  "0206Trial10_Yuki020": "但是她无法停下。<br>\n……她不可以停下。",
  "0206Trial10_Yuki021": "所以，她把一切都托付给了艾玛。",
  "0206Trial10_Yuki022": "将人类的命运……以及自己的复仇计划……",
  "0206Trial10_Yuki023": "如同将赌注交给命运，<br>\n她把自己精心铺陈的计划，<br>\n托付给了他人之手。",
  "0206Trial10_Yuki024": "最终……",
  "0206Trial10_Yuki025": "我终究……还是没有做到。",
  "0206Trial10_Yuki026": "是太过漫长的岁月让感情渐渐麻木……",
  "0206Trial10_Yuki027": "还是我与人类交集得太深……",
  "0206Trial10_Yuki028": "我的复仇之心……已经锈蚀了。",
  "0206Trial10_Yuki029": "岛上的魔女们……会不会笑我呢。",
  "0206Trial10_Yuki030": "那些变成魔女、因此死去的人类们……<br>\n会不会怨恨我呢。",
  "0206Trial10_Yuki031": "即便如此……",
  "0206Trial10_Yuki032": "此刻我只想，<br>\n任由自己沉浸在这温柔的浅眠之中——"
}
}
