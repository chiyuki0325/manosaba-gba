    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "从那以后不知又过了多少天……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative001"]}},
    {"op": "ResetText", "line": 22, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 23, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 24, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 25, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyBackgroundExtended", "line": 26, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 27, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "到点了吃饭，吃完洗澡，然后盖上毛毯躺下睡觉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "这群少女犹如机器一般，<br>\n麻木地遵守着规定，浑浑噩噩地度日。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative003"]}},
    {"op": "ResetText", "line": 33, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 34, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 35, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 36, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "10_1"}},
    {"op": "ModifyBackgroundExtended", "line": 37, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 38, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema001"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "啊啊艾玛亲，你还活着呀。<br>\n好顽强的生命力。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Coco001"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "倒不如说你死了就要开审判找魔女了啊。<br>\n你就尽管挣扎，多活一天是一天吧。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Coco002"]}},
    {"op": "HideAllCharacters", "line": 51, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "嗯、嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema002"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "拜啦。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Coco003"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "身体的疲惫，内心的恐惧。<br>\n这一切让少女移开了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative004"]}},
    {"op": "ResetText", "line": 65, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 66, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 67, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 68, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "ModifyBackgroundExtended", "line": 69, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 70, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "让我们苟且活着的目的究竟是什么呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Margo001"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "既然一辈子都没打算放我们走，<br>\n倒不如干脆点，把我们都杀了算了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Margo002"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "这简直就是折磨。就是在温水煮青蛙。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Margo003"]}},
    {"op": "HideAllCharacters", "line": 80, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema003"]}},
    {"op": "HideAllCharacters", "line": 85, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "对自己仍活在世上的感觉早已磨灭，<br>\n少女怀抱着空虚感，有如梦呓一般轻声说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative005"]}},
    {"op": "ResetText", "line": 89, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 90, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 91, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 92, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_1"}},
    {"op": "ModifyBackgroundExtended", "line": 93, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 94, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "好安静啊……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru001"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "早些时候明明还很热闹，<br>\n但现在这样……感觉真是凄凉。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 102, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema004"]}},
    {"op": "HideAllCharacters", "line": 107, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "回想着那段无法挽回的时光，<br>\n少女在感到宽慰的同时，眼泪也缓缓流下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative006"]}},
    {"op": "ResetText", "line": 115, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 116, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 117, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 118, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "7_1"}},
    {"op": "ModifyBackgroundExtended", "line": 119, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 120, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "……艾玛小姐，我们要不去散散步？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru003"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "或许是一时的起意，<br>\n梅露露站起来说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "散步？去哪里散步？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema005"]}},
    {"op": "HideAllCharacters", "line": 133, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "这个……哪里都行。<br>\n我只是觉得，要是一直哭丧着脸，<br>\n肯定会被雪莉小姐和汉娜小姐责骂。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "我们不能认输，得打起精神来才行。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru005"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "带着红肿的双眼，<br>\n梅露露打起精神笑了笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative008"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "说、说得对……我不想认输。<br>\n我们还活着，还能继续努力。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema006"]}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "嗯……我们走吧，艾玛小姐！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru006"]}},
    {"op": "HideAllCharacters", "line": 154, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 155, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 156, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 157, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 159, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "10_1"}},
    {"op": "ModifyBackgroundExtended", "line": 160, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 161, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "……话虽如此，<br>\n在这座监牢内，她们能去的地方十分有限。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative009"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "艾玛和梅露露手牵着手，<br>\n踏上楼梯往楼上的娱乐室走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 168, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我们要尽情地玩一顿，<br>\n尽情地笑一顿，这样肯定就能打起精神来。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru007"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "我呢，希望大家都能一直充满活力。<br>\n希望大家都能一直笑着，一直阳光地活着。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru008"]}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "……我们玩什么好呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 178, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "我、我看看……我也没怎么跟别人一起玩过。<br>\n但、但不管怎样！我们要大闹一番！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru009"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "看着莫名兴奋起来的梅露露，<br>\n艾玛不由得满面春风起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "都还没开始就想着大闹一番啊？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "是、是的……不可以吗？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru010"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Smile1"}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "当然可以，就按你说的，<br>\n我们今天绝对要玩一个闹翻天！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema009"]}},
    {"op": "HideAllCharacters", "line": 196, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "听到这句话，梅露露笑着点了点头，<br>\n抢先踏上了一级台阶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative012"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "艾玛看着她的背影向她说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "还好有梅露露在。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema010"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "我们要一直在一起哦。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema011"]}},
    {"op": "HideAllCharacters", "line": 208, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "（不要丢下我一个人）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema012"]}},
    {"op": "HideAllCharacters", "line": 212, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "嗯……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Meruru011"]}},
    {"op": "HideAllCharacters", "line": 217, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "这是此时此地唯一确定的事物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative014"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "掌心传来的温暖<br>\n此刻成为了艾玛的救赎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative015"]}},
    {"op": "ResetText", "line": 223, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 224, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 225, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 226, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_2"}},
    {"op": "ModifyBackgroundExtended", "line": 227, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 228, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "——又过了几天。<br>\n艾玛今天也跟前几天一样，<br>\n漫无目的地到处闲逛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative016"]}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "一成不变的日子一天天过去。时间一长，<br>\n竟让人觉得这种日常其实还算安稳。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative017"]}},
    {"op": "PlaySfxModified", "line": 235, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 237, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "突然，艾玛听到一阵翅膀拍动的声音，<br>\n吓得摆起了架势。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative018"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "原来是典狱长飞来了。<br>\n它看到艾玛后，驻足留在了原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "哎呀，这不是樱羽艾玛小姐嘛。<br>\n最近日子这么和平，真是万幸。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Warden001"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema013"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "只要在监牢或室外到处走动，<br>\n偶尔会像这样遇到典狱长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative020"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "但它既不是会让人想要闲谈几句的对象，<br>\n艾玛也不清楚应不应该憎恨它。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative021"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "说到底，典狱长不过是在履行自己的职务，<br>\n做好运营监牢的工作而已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 255, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "唯一的问题是处刑台的状态不太好，<br>\n其实上次处刑时就已经这样……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Warden002"]}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "我已经安排了，明天下午<br>\n得认真地做一次检修。忙死了……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Warden003"]}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "艾玛不自觉地把视线转向过道前方的审判庭。<br>\n平常一直关得紧紧的大门现在却是打开的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative023"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "看来典狱长就是因为来回进出审判庭<br>\n才会到处飞来飞去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 265, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "这座监牢也已经十分破旧了，<br>\n真希望能给我多招几个勤快的员工呢……<br>\n真会使唤鸟啊……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Warden004"]}},
    {"op": "HideAllCharacters", "line": 269, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 272, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "发了几句牢骚以后，<br>\n典狱长马上又飞走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema014"]}},
    {"op": "HideAllCharacters", "line": 282, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "艾玛来到窗边，轻轻地叹了一口气。<br>\n为了转换一下心情，她注视着彩绘玻璃外的景色。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative026"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "晚餐时间还没到，<br>\n但天色却已经变得相当昏暗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative027"]}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "（把我们关在监牢里<br>\n　到底有什么目的……<br>\n　这问题就算问了，估计它们也不会回答吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema015"]}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "（果然它们是在等所有人都变成魔女吗）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema016"]}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "（那就是迟早的事了……<br>\n　被关在这种地方，大家迟早都会变成魔女……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema017"]}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "只是艾玛心里一直觉得哪里不对劲。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative028"]}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "（我真的是魔女吗？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema018"]}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "（为什么只有我不能用魔法）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema019"]}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "（如果我不是魔女的话，<br>\n　那最后只会剩下我一个人活着……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema020"]}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "艾玛伸手摸进口袋，<br>\n如同抓住护身符一般握紧里面的钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative029"]}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "（我不要孤零零一个人……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema021"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "就在艾玛带着泫然欲泣的心绪望着窗外时，<br>\n视野里突然纷纷扬扬地落下点点白色。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative030"]}},
    {"op": "ModifyCharacterExtended", "line": 308, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "欸……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema022"]}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "那些从暗淡的夜空中静静地飘扬而下的东西，<br>\n从方向看来，应该落在了湖的附近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative031"]}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "在艾玛的认知里，现在应该是春天才对。<br>\n眼前梦幻而荒诞的景象让她看得出了神。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Narrative032"]}},
    {"op": "ModifyCharacterExtended", "line": 316, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "雪……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv01_Ema023"]}},
    {"op": "Gosub", "line": 320, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 322, "indent": 0, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Adv02", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv01_Narrative001": "从那以后不知又过了多少天……",
  "0104Adv01_Narrative002": "到点了吃饭，吃完洗澡，然后盖上毛毯躺下睡觉。",
  "0104Adv01_Narrative003": "这群少女犹如机器一般，<br>\n麻木地遵守着规定，浑浑噩噩地度日。",
  "0104Adv01_Ema001": "啊……",
  "0104Adv01_Coco001": "啊啊艾玛亲，你还活着呀。<br>\n好顽强的生命力。",
  "0104Adv01_Coco002": "倒不如说你死了就要开审判找魔女了啊。<br>\n你就尽管挣扎，多活一天是一天吧。",
  "0104Adv01_Ema002": "嗯、嗯。",
  "0104Adv01_Coco003": "拜啦。",
  "0104Adv01_Narrative004": "身体的疲惫，内心的恐惧。<br>\n这一切让少女移开了视线。",
  "0104Adv01_Margo001": "让我们苟且活着的目的究竟是什么呢。",
  "0104Adv01_Margo002": "既然一辈子都没打算放我们走，<br>\n倒不如干脆点，把我们都杀了算了。",
  "0104Adv01_Margo003": "这简直就是折磨。就是在温水煮青蛙。",
  "0104Adv01_Ema003": "…………",
  "0104Adv01_Narrative005": "对自己仍活在世上的感觉早已磨灭，<br>\n少女怀抱着空虚感，有如梦呓一般轻声说道。",
  "0104Adv01_Meruru001": "好安静啊……",
  "0104Adv01_Meruru002": "早些时候明明还很热闹，<br>\n但现在这样……感觉真是凄凉。",
  "0104Adv01_Ema004": "嗯……",
  "0104Adv01_Narrative006": "回想着那段无法挽回的时光，<br>\n少女在感到宽慰的同时，眼泪也缓缓流下。",
  "0104Adv01_Meruru003": "……艾玛小姐，我们要不去散散步？",
  "0104Adv01_Narrative007": "或许是一时的起意，<br>\n梅露露站起来说道。",
  "0104Adv01_Ema005": "散步？去哪里散步？",
  "0104Adv01_Meruru004": "这个……哪里都行。<br>\n我只是觉得，要是一直哭丧着脸，<br>\n肯定会被雪莉小姐和汉娜小姐责骂。",
  "0104Adv01_Meruru005": "我们不能认输，得打起精神来才行。",
  "0104Adv01_Narrative008": "带着红肿的双眼，<br>\n梅露露打起精神笑了笑。",
  "0104Adv01_Ema006": "说、说得对……我不想认输。<br>\n我们还活着，还能继续努力。",
  "0104Adv01_Meruru006": "嗯……我们走吧，艾玛小姐！",
  "0104Adv01_Narrative009": "……话虽如此，<br>\n在这座监牢内，她们能去的地方十分有限。",
  "0104Adv01_Narrative010": "艾玛和梅露露手牵着手，<br>\n踏上楼梯往楼上的娱乐室走去。",
  "0104Adv01_Meruru007": "我们要尽情地玩一顿，<br>\n尽情地笑一顿，这样肯定就能打起精神来。",
  "0104Adv01_Meruru008": "我呢，希望大家都能一直充满活力。<br>\n希望大家都能一直笑着，一直阳光地活着。",
  "0104Adv01_Ema007": "……我们玩什么好呢。",
  "0104Adv01_Meruru009": "我、我看看……我也没怎么跟别人一起玩过。<br>\n但、但不管怎样！我们要大闹一番！",
  "0104Adv01_Narrative011": "看着莫名兴奋起来的梅露露，<br>\n艾玛不由得满面春风起来。",
  "0104Adv01_Ema008": "都还没开始就想着大闹一番啊？",
  "0104Adv01_Meruru010": "是、是的……不可以吗？",
  "0104Adv01_Ema009": "当然可以，就按你说的，<br>\n我们今天绝对要玩一个闹翻天！",
  "0104Adv01_Narrative012": "听到这句话，梅露露笑着点了点头，<br>\n抢先踏上了一级台阶。",
  "0104Adv01_Narrative013": "艾玛看着她的背影向她说道。",
  "0104Adv01_Ema010": "还好有梅露露在。",
  "0104Adv01_Ema011": "我们要一直在一起哦。",
  "0104Adv01_Ema012": "（不要丢下我一个人）",
  "0104Adv01_Meruru011": "嗯……！",
  "0104Adv01_Narrative014": "这是此时此地唯一确定的事物。",
  "0104Adv01_Narrative015": "掌心传来的温暖<br>\n此刻成为了艾玛的救赎。",
  "0104Adv01_Narrative016": "——又过了几天。<br>\n艾玛今天也跟前几天一样，<br>\n漫无目的地到处闲逛。",
  "0104Adv01_Narrative017": "一成不变的日子一天天过去。时间一长，<br>\n竟让人觉得这种日常其实还算安稳。",
  "0104Adv01_Narrative018": "突然，艾玛听到一阵翅膀拍动的声音，<br>\n吓得摆起了架势。",
  "0104Adv01_Narrative019": "原来是典狱长飞来了。<br>\n它看到艾玛后，驻足留在了原地。",
  "0104Adv01_Warden001": "哎呀，这不是樱羽艾玛小姐嘛。<br>\n最近日子这么和平，真是万幸。",
  "0104Adv01_Ema013": "…………",
  "0104Adv01_Narrative020": "只要在监牢或室外到处走动，<br>\n偶尔会像这样遇到典狱长。",
  "0104Adv01_Narrative021": "但它既不是会让人想要闲谈几句的对象，<br>\n艾玛也不清楚应不应该憎恨它。",
  "0104Adv01_Narrative022": "说到底，典狱长不过是在履行自己的职务，<br>\n做好运营监牢的工作而已。",
  "0104Adv01_Warden002": "唯一的问题是处刑台的状态不太好，<br>\n其实上次处刑时就已经这样……",
  "0104Adv01_Warden003": "我已经安排了，明天下午<br>\n得认真地做一次检修。忙死了……",
  "0104Adv01_Narrative023": "艾玛不自觉地把视线转向过道前方的审判庭。<br>\n平常一直关得紧紧的大门现在却是打开的。",
  "0104Adv01_Narrative024": "看来典狱长就是因为来回进出审判庭<br>\n才会到处飞来飞去。",
  "0104Adv01_Warden004": "这座监牢也已经十分破旧了，<br>\n真希望能给我多招几个勤快的员工呢……<br>\n真会使唤鸟啊……",
  "0104Adv01_Narrative025": "发了几句牢骚以后，<br>\n典狱长马上又飞走了。",
  "0104Adv01_Ema014": "……",
  "0104Adv01_Narrative026": "艾玛来到窗边，轻轻地叹了一口气。<br>\n为了转换一下心情，她注视着彩绘玻璃外的景色。",
  "0104Adv01_Narrative027": "晚餐时间还没到，<br>\n但天色却已经变得相当昏暗。",
  "0104Adv01_Ema015": "（把我们关在监牢里<br>\n　到底有什么目的……<br>\n　这问题就算问了，估计它们也不会回答吧）",
  "0104Adv01_Ema016": "（果然它们是在等所有人都变成魔女吗）",
  "0104Adv01_Ema017": "（那就是迟早的事了……<br>\n　被关在这种地方，大家迟早都会变成魔女……）",
  "0104Adv01_Narrative028": "只是艾玛心里一直觉得哪里不对劲。",
  "0104Adv01_Ema018": "（我真的是魔女吗？）",
  "0104Adv01_Ema019": "（为什么只有我不能用魔法）",
  "0104Adv01_Ema020": "（如果我不是魔女的话，<br>\n　那最后只会剩下我一个人活着……？）",
  "0104Adv01_Narrative029": "艾玛伸手摸进口袋，<br>\n如同抓住护身符一般握紧里面的钢笔。",
  "0104Adv01_Ema021": "（我不要孤零零一个人……）",
  "0104Adv01_Narrative030": "就在艾玛带着泫然欲泣的心绪望着窗外时，<br>\n视野里突然纷纷扬扬地落下点点白色。",
  "0104Adv01_Ema022": "欸……？",
  "0104Adv01_Narrative031": "那些从暗淡的夜空中静静地飘扬而下的东西，<br>\n从方向看来，应该落在了湖的附近。",
  "0104Adv01_Narrative032": "在艾玛的认知里，现在应该是春天才对。<br>\n眼前梦幻而荒诞的景象让她看得出了神。",
  "0104Adv01_Ema023": "雪……"
}
}
