    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 35, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 36, "indent": 0, "params": {"Text": "亚里沙<br>\n喝的安眠药，<br>\n是那种过量服用<br>\n【也不会当场死亡】的药物……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 39, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 40, "indent": 0, "params": {"Text": "我说得没错吧，<br>\n梅露露。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Default"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 43, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 44, "indent": 0, "params": {"Text": "是、是的……<br>\n安眠药毕竟不是剧毒，<br>\n喝了也不会<br>\n令人当场死亡……", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0104Trial11_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 47, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 48, "indent": 0, "params": {"Text": "……那么，<br>\n昨晚亚里沙<br>\n在喝药之后，<br>\n应该也没有<br>\n立即死亡才对。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Margo003"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 51, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 52, "indent": 0, "params": {"Text": "……然后昨晚<br>\n艾玛在地下进行了<br>\n移动处刑台的操作，没错吧？", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Margo004"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR5,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 55, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 56, "indent": 0, "params": {"Text": "等、等一下……！<br>\n现在还没弄清楚<br>\n我按下的按钮<br>\n到底是不是<br>\n处刑台的操作按钮吧……！", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0104Trial11_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 59, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 60, "indent": 0, "params": {"Text": "如果你操作过<br>\n地下的控制面板的话，<br>\n那应该就是按过了。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Warden001"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 63, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 64, "indent": 0, "params": {"Text": "因为处刑台的升降按钮<br>\n就安装在<br>\n随手就能按下的位置。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Warden002"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 67, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 68, "indent": 0, "params": {"Text": "并且昨晚<br>\n处刑台<br>\n只升降过一次。<br>\n……这点可以从历史记录<br>\n得到确认。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Warden003"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Gross_Open,Angle01/Facial/Sweat>Sweat01,Angle01/Facial/Pale>Pale01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 71, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 72, "indent": 0, "params": {"Text": "那、<br>\n那就是说……<br>\n由于艾玛亲的操作，<br>\n睡着的亚里沙<br>\n被关到<br>\n地下了……！？", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0104Trial11_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Pale>Pale01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 77, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 78, "indent": 0, "params": {"Text": "如果……<br>\n真是这样……<br>\n那把亚里沙<br>\n活活冻死的<br>\n凶手就是……", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Margo005"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 81, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 82, "indent": 0, "params": {"Text": "<link=\"Objection_01_04_11_01\">樱羽艾玛</link>……<br>\n凶手就是你。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0104Trial11_Margo006"]}},
