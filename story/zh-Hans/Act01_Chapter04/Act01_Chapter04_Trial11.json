    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "……这样啊……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo009"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 202, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "可、可亚里沙是自己<br>\n主动喝的安眠药！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 206, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "她肯定是从一开始就想着自杀……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 210, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "至少我并不是蓄意想要<br>\n害死亚里沙的……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.ArmR12_2,ArmL13,Eyes2_Cry_Closed2,Mouth2_Normal_Open3,Pale2_1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 214, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "可、可是……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Meruru002"]}},
    {"op": "PlaySfxModified", "line": 218, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.ArmR12_2,ArmL13,Eyes2_Cry_Closed2,Mouth2_Normal_Open3,Pale2_1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 221, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "如果能早一步找到亚里沙小姐进行急救的话，<br>\n说不定她就有救了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 225, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "但、但是……这……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema009"]}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 229, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "这是……意外……！<br>\n只是亚里沙当时刚好人在处刑台上……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema010"]}},
    {"op": "PlaySfxModified", "line": 233, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 236, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "……真的假的。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 240, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "欸……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 244, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "根本没有任何证据能证明你说的话好吗！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Coco003"]}},
    {"op": "PlaySfxModified", "line": 248, "indent": 0, "params": {"SfxPath": "Sfx_Common_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR13,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 251, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "你就是幕后黑手，你早就知道地下的构造……<br>\n你杀死亚里沙都是有预谋的对不对！？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 254, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 255, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "没、没有这样的事……！<br>\n为什么……会变成这样……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 259, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "……会不会是艾玛把睡着了的亚里沙<br>\n放到电椅上的呢，<br>\n这也是有可能的吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo010"]}},
    {"op": "ModifyCharacterExtended", "line": 262, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Pensive_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 263, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "之后她操纵升降台把亚里沙移动到了地下……<br>\n目的就是要冻死亚里沙。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo011"]}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 267, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "如果艾玛就是幕后黑手，那一切都是可行的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo012"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR2-1,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Scream_Closed01,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 271, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "我没有做过这些事！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema013"]}},
    {"op": "ModifyCharacterExtended", "line": 274, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Head1,ArmR8_1,ArmL8,Eyes1_Pensive_Open2,Mouth1_Normal_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 275, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "可、可是……也没有证据……证明你没有做过。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 279, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "艾玛的操作害死了亚里沙，<br>\n这一点应该已经明确证实了吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo013"]}},
    {"op": "ModifyCharacterExtended", "line": 282, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 283, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "那么，<br>\n你能够证明……<br>\n【自己对亚里沙没有杀意】这一点吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo014"]}},
    {"op": "ModifyCharacterExtended", "line": 286, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 287, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "这、这个……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 290, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 291, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "……我说啊，<br>\n这么一来……你们不觉得<br>\n至今的凶杀案都很可疑吗……？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Coco005"]}},
    {"op": "ModifyCharacterExtended", "line": 294, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 295, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 296, "indent": 0, "params": {"Text": "在之前的审判里，<br>\n每次都是艾玛亲<br>\n率先向大家指证【谁是凶手】……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Coco006"]}},
    {"op": "ModifyCharacterExtended", "line": 298, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 299, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 300, "indent": 0, "params": {"Text": "不、不对……！<br>\n我只是想揭开事情的真相而已……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 302, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Angry_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 303, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "会不会这一切都是你在背地里算计我们！？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Coco007"]}},
    {"op": "ModifyCharacterExtended", "line": 306, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Angry_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 307, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "比如安安……<br>\n如果你什么都没做那她就不会杀人了！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Coco008"]}},
    {"op": "ModifyCharacterExtended", "line": 310, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 311, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "我、我……不是这样的……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema016"]}},
    {"op": "ModifyCharacterExtended", "line": 314, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Cry_Lifeless01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 315, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "（大家……为什么……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema017"]}},
    {"op": "PlaySfxModified", "line": 319, "indent": 0, "params": {"SfxPath": "Sfx_Common_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 321, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR7,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Scream_Closed02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 322, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "不对……我没有杀人！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema018"]}},
    {"op": "PlaySfxModified", "line": 326, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 330, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 331, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "…………", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo015"]}},
    {"op": "PlaySfxModified", "line": 335, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 339, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Meruru.Head2,ArmR1_2,ArmL6,Eyes2_Cry_Closed3,Mouth2_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 340, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Meruru", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "呜……呜呜……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Meruru005"]}},
    {"op": "PlaySfxModified", "line": 344, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 348, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Closed,Angle01/Facial/Sweat>Sweat01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 349, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Coco", "Composition": "Right"}},
