    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "不对……！<br>\n我没有杀死亚里沙！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema003"]}},
    {"op": "PlaySfxModified", "line": 163, "indent": 0, "params": {"SfxPath": "Sfx_Common_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 165, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 166, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "而且……<br>\n我当时也不知道那些按钮哪个是哪个！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema004"]}},
    {"op": "PlaySfxModified", "line": 170, "indent": 0, "params": {"SfxPath": "Sfx_Common_3", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Scream_Closed01,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 173, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "就算亚里沙是冻死的……<br>\n我也从没想过要杀人！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Ema005"]}},
    {"op": "PlaySfxModified", "line": 177, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 180, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "……【过失致死】。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo007"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 184, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Margo", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "我说，典狱长。<br>\n如果是【过失杀人】的情况<br>\n应该怎么办……？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Margo008"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 188, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "……一切由各位自行决定。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Warden004"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Warden.1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 192, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Warden", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "决定权在你们手里。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Trial11_Warden005"]}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Closed"}},
