{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter04/Act01_Chapter04_Adv03",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-4-3", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "17_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_41_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "呜呜，呜呜呜……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 20, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "湖边只剩亚里沙一个人蹲在地上，<br>\n不断发出无力的呻吟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "差点就把艾玛杀了。<br>\n这一事实将亚里沙逼入了穷途末路之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "那阵绝望之感，甚至把她逼得想要把自己烧成灰烬。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative003"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "但亚里沙燃起的那团神奇的火焰却不会如她所愿，<br>\n点燃她的身体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "为什么，为什么烧不着我自己！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 34, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 37, "indent": 0, "params": {"SfxPath": "Sfx_65", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "她一拳一拳地打在地上，<br>\n除了折磨自己以外，她无能为力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative005"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "她左手握拳，带着憎恶用尽全身力气敲打在地上。<br>\n手上的皮肤擦破，渗出了鲜红的血液。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative006"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "点滴落在地面上的血化作蝴蝶的绘画，<br>\n又渐渐跟飘落的雪花重叠混合。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,ArmR4,ArmL6"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "可恶，可恶，可恶！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa003"]}},
    {"op": "HideAllCharacters", "line": 49, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "——亚里沙小姐。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 54, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "这时，亚里沙的背后传来一声呼唤。<br>\n她回过神来，转头往回看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "冰上……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa004"]}},
    {"op": "HideAllCharacters", "line": 62, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "梅露露站在亚里沙的身后。<br>\n她看着很难受，眼泪一直在眼眶里打转。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative009"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "亚里沙小姐，请你不要再伤害自己……<br>\n我已经，看不下去了……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 69, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry,ArmR1,ArmL8"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "别过来！不要管我！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa005"]}},
    {"op": "HideAllCharacters", "line": 74, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "亚里沙压抑不住心里的冲动，<br>\n冲着梅露露放出了一团火焰。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 79, "indent": 0, "params": {"SfxPath": "Sfx_46", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "火焰的势头以及蕴含的热量，跟之前朝着艾玛<br>\n放出的火团完全天差地别。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative011"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "亚里沙的魔女化程度已经加深，她的魔法变得十分强大。<br>\n火焰把梅露露整个人都包裹了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative012"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "啊啊啊啊啊！！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru003"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "梅露露随即倒地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative013"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "看着在熊熊火焰下燃烧的梅露露，<br>\n亚里沙恢复了一点神志。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Fearful1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "啊、啊，冰上，怎么会这样……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa006"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "眨眼间，梅露露似乎已被烧成灰烬。望见此情此景的亚里沙，<br>\n在绝望的蒙蔽下，只觉得眼前一片漆黑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative015"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "是我，杀的……？<br>\n变成魔女的我……杀人了，啊啊啊啊啊！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa007"]}},
    {"op": "HideAllCharacters", "line": 99, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "亚里沙也跪在了地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative016"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "过了一会，火焰熄灭了。<br>\n这时地上应该躺着梅露露被烧焦的尸体才对。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative017"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "但梅露露却爬了起来——她还活着。<br>\n就连一点烧伤的痕迹都没有。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Surprised1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "冰上……？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa008"]}},
    {"op": "HideAllCharacters", "line": 111, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "我没事。我用治愈魔法勉强挺过来了……<br>\n亚里沙小姐没有杀死任何人。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru004"]}},
    {"op": "HideAllCharacters", "line": 116, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "是、是吗，原来是治愈魔法……太好了……<br>\n冰上，对不起。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa009"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "但对我来说，是谁都没关系。<br>\n只要有人靠近我，我肯定会想杀人……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa010"]}},
    {"op": "HideAllCharacters", "line": 123, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "请你冲着我来。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru005"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Surprised1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "欸……？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa011"]}},
    {"op": "HideAllCharacters", "line": 133, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "当你压抑不住这股冲动时，就请冲着我来。<br>\n我会用魔法挺过去的……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru006"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "亚里沙小姐这么痛苦的模样，我实在看不下去……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru007"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "梅露露站起身来，<br>\n向着亚里沙走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "虽然亚里沙小姐一直表现得很坚强，<br>\n但其实是个温柔善良的人……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru008"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "你一直害怕伤害到其他人，<br>\n害怕得不得了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru009"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "我也跟你一样。<br>\n其实我们都一样。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru010"]}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "冰上……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa012"]}},
    {"op": "HideAllCharacters", "line": 161, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 163, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 164, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 165, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 166, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_1"}},
    {"op": "ModifyBackgroundExtended", "line": 167, "indent": 0, "params": {"Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 168, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "梅露露拿起亚里沙的手<br>\n按在自己的脸颊上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative020"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "然后露出一个欲哭还笑的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative021"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "我也胆小得很，<br>\n总是害怕自己会伤害到其他人……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru011"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "对不起，我这个胆小鬼能做的，只有这么一点小事。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru012"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "……怎么还道起歉来了呢。<br>\n一直以来你不都会为了其他人拼尽全力嘛。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa013"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "哎，你啊，总是在道歉呢。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa014"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "亚里沙的手捧着梅露露的脸，<br>\n但那双手已然异于常人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative022"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "她的外表也同样地，<br>\n越来越像残骸了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative023"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "请你不要再伤害自己……<br>\n大家都很需要亚里沙小姐。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru013"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "请不要丢下我们……请你继续留在我们的身边。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru014"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "梅露露的语气是那么的温柔，<br>\n让亚里沙感到一阵不可言喻的安宁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative024"]}},
    {"op": "HideActors", "line": 192, "indent": 0, "params": {"ActorIds": ["Stills"], "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "Wait", "line": 193, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "啊……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa015"]}},
    {"op": "HideAllCharacters", "line": 199, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "亚里沙低头看了看自己那双已经化为异形的双手，<br>\n发现上面的伤已经愈合。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative025"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "明明刚才还杀意顿起攻击了梅露露，<br>\n但现在亚里沙已经冷静下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "你的治疗魔法，<br>\n能够抑制魔女化吗？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa016"]}},
    {"op": "HideAllCharacters", "line": 209, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "梅露露吃了一惊，向着亚里沙摆了摆手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Surprised"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "不、不行，我想应该抑制不了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru015"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "不过你应该也冷静下来一点了吧。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru016"]}},
    {"op": "HideAllCharacters", "line": 219, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "……好像是这样。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa017"]}},
    {"op": "HideAllCharacters", "line": 224, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "抬头窥探夜色，<br>\n能看到雪还在下——<br>\n像是想要令失去冷静的身体得到冷却一般。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative028"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "对于受到灼热诅咒的亚里沙来说，<br>\n这阵冰冷甚至算得上是一种救赎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative029"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "亚里沙深深吐了一口气。<br>\n她的内心已经基本上平静下来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative030"]}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "ModifyCharacterExtended", "line": 233, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "谢谢你，冰上。<br>\n但我不会再伤害你了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa018"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "我不会变成魔女。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa019"]}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Surprised"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "真、真的吗……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru017"]}},
    {"op": "ModifyCharacterExtended", "line": 243, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "嗯。我不想杀人，也不想伤害任何人。<br>\n我绝对不会变成魔女。我跟你约好了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa020"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "亚里沙小姐……太好了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru018"]}},
    {"op": "ModifyCharacterExtended", "line": 251, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Smile1,Option-ArmL-Off,ArmR1,ArmL3"}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "不……我才应该，跟你说谢谢。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa021"]}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "总感觉……事情都想明白了。<br>\n我来保护你们。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa022"]}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "……我绝对，会保护好你们。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Alisa023"]}},
    {"op": "ModifyCharacterExtended", "line": 259, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "……嗯！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Meruru019"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "亚里沙终于再次展露笑容。<br>\n梅露露也跟着笑了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv03_Narrative031"]}},
    {"op": "Gosub", "line": 265, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 267, "indent": 0, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv03_Alisa001": "呜呜，呜呜呜……",
  "0104Adv03_Narrative001": "湖边只剩亚里沙一个人蹲在地上，<br>\n不断发出无力的呻吟。",
  "0104Adv03_Narrative002": "差点就把艾玛杀了。<br>\n这一事实将亚里沙逼入了穷途末路之中。",
  "0104Adv03_Narrative003": "那阵绝望之感，甚至把她逼得想要把自己烧成灰烬。",
  "0104Adv03_Narrative004": "但亚里沙燃起的那团神奇的火焰却不会如她所愿，<br>\n点燃她的身体。",
  "0104Adv03_Alisa002": "为什么，为什么烧不着我自己！",
  "0104Adv03_Narrative005": "她一拳一拳地打在地上，<br>\n除了折磨自己以外，她无能为力。",
  "0104Adv03_Narrative006": "她左手握拳，带着憎恶用尽全身力气敲打在地上。<br>\n手上的皮肤擦破，渗出了鲜红的血液。",
  "0104Adv03_Narrative007": "点滴落在地面上的血化作蝴蝶的绘画，<br>\n又渐渐跟飘落的雪花重叠混合。",
  "0104Adv03_Alisa003": "可恶，可恶，可恶！！",
  "0104Adv03_Meruru001": "——亚里沙小姐。",
  "0104Adv03_Narrative008": "这时，亚里沙的背后传来一声呼唤。<br>\n她回过神来，转头往回看。",
  "0104Adv03_Alisa004": "冰上……",
  "0104Adv03_Narrative009": "梅露露站在亚里沙的身后。<br>\n她看着很难受，眼泪一直在眼眶里打转。",
  "0104Adv03_Meruru002": "亚里沙小姐，请你不要再伤害自己……<br>\n我已经，看不下去了……！",
  "0104Adv03_Alisa005": "别过来！不要管我！",
  "0104Adv03_Narrative010": "亚里沙压抑不住心里的冲动，<br>\n冲着梅露露放出了一团火焰。",
  "0104Adv03_Narrative011": "火焰的势头以及蕴含的热量，跟之前朝着艾玛<br>\n放出的火团完全天差地别。",
  "0104Adv03_Narrative012": "亚里沙的魔女化程度已经加深，她的魔法变得十分强大。<br>\n火焰把梅露露整个人都包裹了起来。",
  "0104Adv03_Meruru003": "啊啊啊啊啊！！",
  "0104Adv03_Narrative013": "梅露露随即倒地。",
  "0104Adv03_Narrative014": "看着在熊熊火焰下燃烧的梅露露，<br>\n亚里沙恢复了一点神志。",
  "0104Adv03_Alisa006": "啊、啊，冰上，怎么会这样……",
  "0104Adv03_Narrative015": "眨眼间，梅露露似乎已被烧成灰烬。望见此情此景的亚里沙，<br>\n在绝望的蒙蔽下，只觉得眼前一片漆黑。",
  "0104Adv03_Alisa007": "是我，杀的……？<br>\n变成魔女的我……杀人了，啊啊啊啊啊！！",
  "0104Adv03_Narrative016": "亚里沙也跪在了地上。",
  "0104Adv03_Narrative017": "过了一会，火焰熄灭了。<br>\n这时地上应该躺着梅露露被烧焦的尸体才对。",
  "0104Adv03_Narrative018": "但梅露露却爬了起来——她还活着。<br>\n就连一点烧伤的痕迹都没有。",
  "0104Adv03_Alisa008": "冰上……？",
  "0104Adv03_Meruru004": "我没事。我用治愈魔法勉强挺过来了……<br>\n亚里沙小姐没有杀死任何人。",
  "0104Adv03_Alisa009": "是、是吗，原来是治愈魔法……太好了……<br>\n冰上，对不起。",
  "0104Adv03_Alisa010": "但对我来说，是谁都没关系。<br>\n只要有人靠近我，我肯定会想杀人……",
  "0104Adv03_Meruru005": "请你冲着我来。",
  "0104Adv03_Alisa011": "欸……？",
  "0104Adv03_Meruru006": "当你压抑不住这股冲动时，就请冲着我来。<br>\n我会用魔法挺过去的……",
  "0104Adv03_Meruru007": "亚里沙小姐这么痛苦的模样，我实在看不下去……",
  "0104Adv03_Narrative019": "梅露露站起身来，<br>\n向着亚里沙走去。",
  "0104Adv03_Meruru008": "虽然亚里沙小姐一直表现得很坚强，<br>\n但其实是个温柔善良的人……",
  "0104Adv03_Meruru009": "你一直害怕伤害到其他人，<br>\n害怕得不得了。",
  "0104Adv03_Meruru010": "我也跟你一样。<br>\n其实我们都一样。",
  "0104Adv03_Alisa012": "冰上……",
  "0104Adv03_Narrative020": "梅露露拿起亚里沙的手<br>\n按在自己的脸颊上。",
  "0104Adv03_Narrative021": "然后露出一个欲哭还笑的表情。",
  "0104Adv03_Meruru011": "我也胆小得很，<br>\n总是害怕自己会伤害到其他人……",
  "0104Adv03_Meruru012": "对不起，我这个胆小鬼能做的，只有这么一点小事。",
  "0104Adv03_Alisa013": "……怎么还道起歉来了呢。<br>\n一直以来你不都会为了其他人拼尽全力嘛。",
  "0104Adv03_Alisa014": "哎，你啊，总是在道歉呢。",
  "0104Adv03_Narrative022": "亚里沙的手捧着梅露露的脸，<br>\n但那双手已然异于常人。",
  "0104Adv03_Narrative023": "她的外表也同样地，<br>\n越来越像残骸了。",
  "0104Adv03_Meruru013": "请你不要再伤害自己……<br>\n大家都很需要亚里沙小姐。",
  "0104Adv03_Meruru014": "请不要丢下我们……请你继续留在我们的身边。",
  "0104Adv03_Narrative024": "梅露露的语气是那么的温柔，<br>\n让亚里沙感到一阵不可言喻的安宁。",
  "0104Adv03_Alisa015": "啊……",
  "0104Adv03_Narrative025": "亚里沙低头看了看自己那双已经化为异形的双手，<br>\n发现上面的伤已经愈合。",
  "0104Adv03_Narrative026": "明明刚才还杀意顿起攻击了梅露露，<br>\n但现在亚里沙已经冷静下来。",
  "0104Adv03_Alisa016": "你的治疗魔法，<br>\n能够抑制魔女化吗？",
  "0104Adv03_Narrative027": "梅露露吃了一惊，向着亚里沙摆了摆手。",
  "0104Adv03_Meruru015": "不、不行，我想应该抑制不了……",
  "0104Adv03_Meruru016": "不过你应该也冷静下来一点了吧。",
  "0104Adv03_Alisa017": "……好像是这样。",
  "0104Adv03_Narrative028": "抬头窥探夜色，<br>\n能看到雪还在下——<br>\n像是想要令失去冷静的身体得到冷却一般。",
  "0104Adv03_Narrative029": "对于受到灼热诅咒的亚里沙来说，<br>\n这阵冰冷甚至算得上是一种救赎。",
  "0104Adv03_Narrative030": "亚里沙深深吐了一口气。<br>\n她的内心已经基本上平静下来了。",
  "0104Adv03_Alisa018": "谢谢你，冰上。<br>\n但我不会再伤害你了。",
  "0104Adv03_Alisa019": "我不会变成魔女。",
  "0104Adv03_Meruru017": "真、真的吗……？",
  "0104Adv03_Alisa020": "嗯。我不想杀人，也不想伤害任何人。<br>\n我绝对不会变成魔女。我跟你约好了。",
  "0104Adv03_Meruru018": "亚里沙小姐……太好了。",
  "0104Adv03_Alisa021": "不……我才应该，跟你说谢谢。",
  "0104Adv03_Alisa022": "总感觉……事情都想明白了。<br>\n我来保护你们。",
  "0104Adv03_Alisa023": "……我绝对，会保护好你们。",
  "0104Adv03_Meruru019": "……嗯！",
  "0104Adv03_Narrative031": "亚里沙终于再次展露笑容。<br>\n梅露露也跟着笑了起来。"
}
}
