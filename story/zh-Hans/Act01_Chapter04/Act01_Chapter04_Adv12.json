    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "反正搞不好凶手就是她。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv12_Coco001"]}},
