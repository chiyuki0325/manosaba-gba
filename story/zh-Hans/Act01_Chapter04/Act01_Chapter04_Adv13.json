    {"op": "HideActors", "line": 184, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 185, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "出现在她眼前的——<br>\n是奈叶香的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative022"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "奈叶香……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema010"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "艾玛呆呆地看着处刑台上<br>\n已经死去的奈叶香。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative023"]}},
    {"op": "StopBgm", "line": 193, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "虽然脑袋还没跟上现实的情况，<br>\n但奈叶香说过的话在艾玛的脑海中一一闪过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative024"]}},
    {"op": "ResetText", "line": 201, "indent": 0, "params": {}},
