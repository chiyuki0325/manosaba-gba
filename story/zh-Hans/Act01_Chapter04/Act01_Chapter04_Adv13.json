    {"op": "PlayBgm", "line": 45, "indent": 0, "params": {"BgmPath": "Bgm_31_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 1.0}},
    {"op": "HideUI", "line": 46, "indent": 0, "params": {"UINames": ["ExecutionButton"], "AllowToggle": 0, "Duration": 0.6000000238418579}},
    {"op": "HideActors", "line": 47, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 48, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ProcessInput", "line": 50, "indent": 0, "params": {"InputEnabled": 1}},
    {"op": "ShowUI", "line": 51, "indent": 0, "params": {"UINames": ["ControlPanel", "AutoToggle", "WitchBookButtonUI"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "好啦，所有人都已经按下处刑按钮了！<br>\n现在开始执行对魔女的刑罚～！", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Warden001"]}},
    {"op": "ResetText", "line": 54, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 55, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 56, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "HideAllCharacters", "line": 57, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 58, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 60.0], "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 59, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "AnimateActorExtended", "line": 61, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 62, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "看守抱住了艾玛<br>\n因恐惧而摇摇欲坠的身体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative004"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "住、住手啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema004"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "艾玛的挣扎在看守面前十分无力。<br>\n看守拖着她往处刑台走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative005"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "艾玛看向在场的每一名少女，<br>\n但所有人都把头扭开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative006"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "不要……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema005"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "我看看，选哪个处刑台呢……<br>\n樱羽艾玛小姐，樱羽艾玛小姐……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Warden002"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "差点把这给忘了，<br>\n所以这次就选这个吧——嘿咻。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Warden003"]}},
    {"op": "PlaySfxModified", "line": 79, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 81, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "齿轮开始旋转，<br>\n中央的台座被缓缓替换。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative007"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "不管她怎样手脚并用地挣扎，就算发出恐惧的哀号，<br>\n大喊着我不想死，我不是魔女，<br>\n看守也依然紧紧地押住艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative008"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "（一切全完了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema006"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "扑通。心脏重重地跳动了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative009"]}},
    {"op": "StopBgm", "line": 91, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 98, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 99, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyTextPrinter", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "——这样真的就好了吗。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Yuki001"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "——你应该能做到才对。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Yuki002"]}},
    {"op": "HidePrinter", "line": 111, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 112, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyBackgroundExtended", "line": 113, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 114, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyTextPrinter", "line": 116, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PlayBgm", "line": 118, "indent": 0, "params": {"BgmPath": "Bgm_13_1_Loop", "IntroBgmPath": "Bgm_13_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "一个声音一直在艾玛耳边低语。<br>\n现在，她应该还听得见。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative010"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "那个声音不属于在场任何一个人，<br>\n却变得越来越响亮，一直在她耳边萦绕着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative011"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "对于艾玛来说，那是一个非常奇妙的感觉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative012"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "指尖跟脸上痒痒的，<br>\n仿佛一直埋藏在心底深处的黑暗<br>\n从身体内部成形然后碎裂，喷涌而出——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative013"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "艾玛一回神，看了看自己的手，<br>\n发现指甲已经变长变尖，指尖已经有了些许的变形。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative014"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "（魔女化……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema007"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "（怎么回事，怎么回事，我终于也要变成魔女……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema008"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "身体不停地颤抖，<br>\n艾玛感觉快要站不稳了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative015"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "她已经放弃了一切，<br>\n整个人快要被萦绕在耳边的低语所吞没。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative016"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "这时，处刑台缓缓升起，<br>\n出现在已然绝望的艾玛面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative017"]}},
    {"op": "ResetText", "line": 140, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 141, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 142, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "眼前只觉一片漆黑。<br>\n艾玛甚至闭上了眼睛，想要遮盖发生在眼前的一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative018"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "就在这时候，艾玛听到了声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative019"]}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "那是少女们的惨叫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative020"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "呀啊啊啊啊啊啊啊——", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Coco001"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "这到底是怎么回事！？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Margo001"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "啊、啊，啊啊啊啊啊……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Meruru002"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "（到底发生了什么事——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema009"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "感到疑惑的艾玛睁开双眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative021"]}},
    {"op": "HidePrinter", "line": 166, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 168, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0}},
