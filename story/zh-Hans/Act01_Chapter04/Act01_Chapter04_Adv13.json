    {"op": "ModifyCharacterExtended", "line": 211, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default", "SubId": "Middle"}},
    {"op": "PlayBgm", "line": 213, "indent": 0, "params": {"BgmPath": "Bgm_41_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "……樱羽艾玛，你人还真好。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "明白了。我的身后就交给你守护了。<br>\n但我希望你不要误会。这是交易。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Nanoka002"]}},
    {"op": "ModifyCharacterExtended", "line": 219, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "交易……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema011"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "我是在利用你。<br>\n所以要是发生什么意外你也要利用我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Nanoka003"]}},
    {"op": "HideAllCharacters", "line": 225, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 231, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 232, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 233, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "SpawnBlur", "line": 234, "indent": 0, "params": {"ActorId": "MainBackground-Middle", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 235, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "13_1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 236, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 237, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "奈叶香的好意，就跟自己流下的眼泪一样，十分地温暖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative025"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "（奈叶香被人杀死了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema012"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "（我不能在这个时候被处死……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema013"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "（我不会变成魔女！！<br>\n　这次我一定要找出真正的魔女！！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema014"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "艾玛狠狠盯住典狱长。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative026"]}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1,ArmR3,ArmL7", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "典狱长！<br>\n我申请举行魔女审判！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema015"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "有人杀死了奈叶香！<br>\n这是凶杀案！<br>\n我们必须对这起凶案进行审判！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema016"]}},
    {"op": "UpdateWitchBook", "line": 261, "indent": 0, "params": {"Id": "Nanoka", "Category": "Profile", "Version": 3}},
    {"op": "SetCustomVariable", "line": 267, "indent": 0, "params": {"Expression": "g_gameProgress = max(5, g_gameProgress)"}},
    {"op": "Gosub", "line": 268, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 270, "indent": 0, "params": {"Path": "Act01_Chapter05/Act01_Chapter05_Adv01", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv13_Narrative001": "在投票中被选为【魔女】的，<br>\n是艾玛。",
  "0104Adv13_Narrative002": "艾玛能听到一阵扑通扑通的响声，<br>\n那是心脏激烈跳动的声音。",
  "0104Adv13_Ema001": "（怎么回事，怎么会变成这样，我……杀了亚里沙……？）",
  "0104Adv13_Ema002": "（我会，被处刑……？）",
  "0104Adv13_Meruru001": "艾玛小姐，呜呜……",
  "0104Adv13_Ema003": "（怎么办，怎么办，怎么办……！）",
  "0104Adv13_Narrative003": "艾玛顿时觉得天旋地转，视野里的一切逐渐扭曲。<br>\n一切来得太突然，<br>\n她吓得双脚颤抖个不停。",
  "0104Adv13_Warden001": "好啦，所有人都已经按下处刑按钮了！<br>\n现在开始执行对魔女的刑罚～！",
  "0104Adv13_Narrative004": "看守抱住了艾玛<br>\n因恐惧而摇摇欲坠的身体。",
  "0104Adv13_Ema004": "住、住手啊……",
  "0104Adv13_Narrative005": "艾玛的挣扎在看守面前十分无力。<br>\n看守拖着她往处刑台走去。",
  "0104Adv13_Narrative006": "艾玛看向在场的每一名少女，<br>\n但所有人都把头扭开了。",
  "0104Adv13_Ema005": "不要……",
  "0104Adv13_Warden002": "我看看，选哪个处刑台呢……<br>\n樱羽艾玛小姐，樱羽艾玛小姐……",
  "0104Adv13_Warden003": "差点把这给忘了，<br>\n所以这次就选这个吧——嘿咻。",
  "0104Adv13_Narrative007": "齿轮开始旋转，<br>\n中央的台座被缓缓替换。",
  "0104Adv13_Narrative008": "不管她怎样手脚并用地挣扎，就算发出恐惧的哀号，<br>\n大喊着我不想死，我不是魔女，<br>\n看守也依然紧紧地押住艾玛。",
  "0104Adv13_Ema006": "（一切全完了）",
  "0104Adv13_Narrative009": "扑通。心脏重重地跳动了一下。",
  "0104Adv13_Yuki001": "——这样真的就好了吗。",
  "0104Adv13_Yuki002": "——你应该能做到才对。",
  "0104Adv13_Narrative010": "一个声音一直在艾玛耳边低语。<br>\n现在，她应该还听得见。",
  "0104Adv13_Narrative011": "那个声音不属于在场任何一个人，<br>\n却变得越来越响亮，一直在她耳边萦绕着。",
  "0104Adv13_Narrative012": "对于艾玛来说，那是一个非常奇妙的感觉。",
  "0104Adv13_Narrative013": "指尖跟脸上痒痒的，<br>\n仿佛一直埋藏在心底深处的黑暗<br>\n从身体内部成形然后碎裂，喷涌而出——",
  "0104Adv13_Narrative014": "艾玛一回神，看了看自己的手，<br>\n发现指甲已经变长变尖，指尖已经有了些许的变形。",
  "0104Adv13_Ema007": "（魔女化……）",
  "0104Adv13_Ema008": "（怎么回事，怎么回事，我终于也要变成魔女……）",
  "0104Adv13_Narrative015": "身体不停地颤抖，<br>\n艾玛感觉快要站不稳了。",
  "0104Adv13_Narrative016": "她已经放弃了一切，<br>\n整个人快要被萦绕在耳边的低语所吞没。",
  "0104Adv13_Narrative017": "这时，处刑台缓缓升起，<br>\n出现在已然绝望的艾玛面前。",
  "0104Adv13_Narrative018": "眼前只觉一片漆黑。<br>\n艾玛甚至闭上了眼睛，想要遮盖发生在眼前的一切。",
  "0104Adv13_Narrative019": "就在这时候，艾玛听到了声音。",
  "0104Adv13_Narrative020": "那是少女们的惨叫。",
  "0104Adv13_Coco001": "呀啊啊啊啊啊啊啊——",
  "0104Adv13_Margo001": "这到底是怎么回事！？",
  "0104Adv13_Meruru002": "啊、啊，啊啊啊啊啊……",
  "0104Adv13_Ema009": "（到底发生了什么事——）",
  "0104Adv13_Narrative021": "感到疑惑的艾玛睁开双眼。",
  "0104Adv13_Narrative022": "出现在她眼前的——<br>\n是奈叶香的尸体。",
  "0104Adv13_Ema010": "奈叶香……？",
  "0104Adv13_Narrative023": "艾玛呆呆地看着处刑台上<br>\n已经死去的奈叶香。",
  "0104Adv13_Narrative024": "虽然脑袋还没跟上现实的情况，<br>\n但奈叶香说过的话在艾玛的脑海中一一闪过。",
  "0104Adv13_Nanoka001": "……樱羽艾玛，你人还真好。",
  "0104Adv13_Nanoka002": "明白了。我的身后就交给你守护了。<br>\n但我希望你不要误会。这是交易。",
  "0104Adv13_Ema011": "交易……？",
  "0104Adv13_Nanoka003": "我是在利用你。<br>\n所以要是发生什么意外你也要利用我。",
  "0104Adv13_Narrative025": "奈叶香的好意，就跟自己流下的眼泪一样，十分地温暖。",
  "0104Adv13_Ema012": "（奈叶香被人杀死了）",
  "0104Adv13_Ema013": "（我不能在这个时候被处死……！）",
  "0104Adv13_Ema014": "（我不会变成魔女！！<br>\n　这次我一定要找出真正的魔女！！）",
  "0104Adv13_Narrative026": "艾玛狠狠盯住典狱长。",
  "0104Adv13_Ema015": "典狱长！<br>\n我申请举行魔女审判！！",
  "0104Adv13_Ema016": "有人杀死了奈叶香！<br>\n这是凶杀案！<br>\n我们必须对这起凶案进行审判！"
}
}
