    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "ModifyCharacterExtended", "line": 14, "indent": 0, "params": {"Rotation": [0.0, 0.0, -5.0], "Scale": [1.600000023841858], "Lazy": 0, "ScenePosition": [50.0, 55.0], "IdAndAppearance": "Ema.Fearful1,ArmR3,ArmL7"}},
    {"op": "Wait", "line": 15, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "在投票中被选为【魔女】的，<br>\n是艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative001"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "艾玛能听到一阵扑通扑通的响声，<br>\n那是心脏激烈跳动的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative002"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "（怎么回事，怎么会变成这样，我……杀了亚里沙……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema001"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "（我会，被处刑……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema002"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "艾玛小姐，呜呜……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Meruru001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "（怎么办，怎么办，怎么办……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Ema003"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "艾玛顿时觉得天旋地转，视野里的一切逐渐扭曲。<br>\n一切来得太突然，<br>\n她吓得双脚颤抖个不停。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv13_Narrative003"]}},
    {"op": "ProcessInput", "line": 33, "indent": 0, "params": {"InputEnabled": 0}},
    {"op": "StopBgm", "line": 34, "indent": 0, "params": {}},
    {"op": "HidePrinter", "line": 35, "indent": 0, "params": {}},
    {"op": "HideUI", "line": 36, "indent": 0, "params": {"UINames": ["ControlPanel", "AutoToggle", "WitchBookButtonUI"], "AllowToggle": 0}},
    {"op": "ShowUI", "line": 37, "indent": 0, "params": {"UINames": ["ExecutionButton"]}},
