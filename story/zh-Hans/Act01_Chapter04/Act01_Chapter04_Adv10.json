  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter04/Act01_Chapter04_Adv10",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-4-10", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "就在艾玛走在审判庭前的过道时，<br>\n她遇到了同样在这附近徘徊的玛格。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛你也在搜查啊。<br>\n感觉你真是越来越熟练了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo001"]}},
    {"op": "HideAllCharacters", "line": 22, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 23, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "我可不想熟练做这种事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema001"]}},
    {"op": "HideAllCharacters", "line": 27, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR7,ArmL5"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "是啊……不管看到过几次，每次都觉得很受打击呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "这次最先发现尸体的人是我……<br>\n当时我也没能冷静下来大叫了一声。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（第一目击者是玛格啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR6,ArmL1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "今天早上，我看到审判庭的门开了，就往里面看了一眼。<br>\n当时我真的没想太多。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo004"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "只不过当时审判庭里没有电椅，我也没看到亚里沙。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo005"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "欸，是吗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema003"]}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR6,ArmL1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "是的……<br>\n能自由进出审判庭的机会不是少之又少嘛，<br>\n所以我就想着吃完早餐再进去调查看看。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo006"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR7,ArmL5"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "没想到等我再进去时，<br>\n就发现亚里沙这个惨状……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo007"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "嗯……真不敢相信会出这种事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema004"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "艾玛昨晚才跟亚里沙说过话。<br>\n一想到她当时的模样，艾玛无力地低下了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative002"]}},
    {"op": "PlaySfxModified", "line": 66, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "耳边传来一阵翅膀拍动的声音，<br>\n艾玛一个激灵抬起了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "樱羽艾玛小姐，宝生玛格小姐。<br>\n请问你们有看到黑部奈叶香小姐吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden001"]}},
    {"op": "HideAllCharacters", "line": 74, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "我已经好几天没看到她了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo008"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "……我也是。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema005"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "艾玛感到一阵心虚，并说了谎话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative004"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "几个小时前她才跟奈叶香见过面。<br>\n但她总不能在这个时候说，<br>\n奈叶香去了调查监牢的秘密。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "我去其他地方调查一下。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Margo009"]}},
    {"op": "HideActors", "line": 90, "indent": 0, "params": {"ActorIds": ["Margo"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "玛格离开了现场。<br>\n她看起来憔悴了不少，走路也是软弱无力的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative006"]}},
    {"op": "HideAllCharacters", "line": 94, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "哎呀哎呀……真让人头疼……<br>\n得在审判前找到她才行……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden002"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "（典狱长是真的到处在找<br>\n　奈叶香……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema006"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "啊，典狱长，等一下！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema007"]}},
    {"op": "HideAllCharacters", "line": 106, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "玛格离开后，<br>\n典狱长也拍了拍翅膀想飞走，<br>\n于是艾玛匆忙开口把它喊住。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "有什么事吗？麻烦你长话短说……<br>\n我可是很忙的。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden003"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "希望你能跟我讲一下<br>\n亚里沙所坐的电椅是怎么回事。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema008"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "哦，我昨天不是说过嘛。<br>\n电椅发生了一些故障，<br>\n所以我计划在今天下午做一次检修。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden004"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "所以我才会把电椅升了上来。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden005"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "（那就是说，<br>\n　昨天电椅就已经放在审判庭里了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema009"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "是不是只要按一下椅背上的按钮<br>\n就会通电？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema010"]}},
    {"op": "HideAllCharacters", "line": 133, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "没错，<br>\n但是要按一定的步骤操作它才会启动。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden006"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "首先要按下【拘束】按钮把囚犯拘束在电椅上。<br>\n如果没有把人绑好在椅子上，<br>\n就算按了启动按钮也不会通电。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden007"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "还有就是，就算把人绑好了，<br>\n也需要【密码】才可以启动。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden008"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "这步骤还挺复杂的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema011"]}},
    {"op": "SpawnExtended", "line": 148, "indent": 0, "params": {"Path": "Clue", "Params": ["4-2"]}},
    {"op": "UpdateWitchBook", "line": 149, "indent": 0, "params": {"Id": "4-2", "Category": "Clue", "Version": 2}},
    {"op": "Wait", "line": 150, "indent": 0, "params": {"WaitMode": "i1.5"}},
    {"op": "DestroySpawnedExtended", "line": 151, "indent": 0, "params": {"Path": "Clue", "Wait": 1, "LogWarning": 1}},
    {"op": "HideAllCharacters", "line": 153, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "好了吗？我真的很忙……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden009"]}},
    {"op": "HideAllCharacters", "line": 158, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "等、等一下。还有一个问题！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "麻烦你跟我说说处刑台的构造。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema013"]}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 168, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "就跟你们所见的一样哦。<br>\n处刑台由底座和处刑装置组成，<br>\n是可以交替更换的构造。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden010"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "底座升降是通过我手里的控制器，<br>\n或者用地下的【控制面板】来操纵。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden011"]}},
    {"op": "SpawnExtended", "line": 177, "indent": 0, "params": {"Path": "Clue", "Params": ["4-7"]}},
    {"op": "UpdateWitchBook", "line": 178, "indent": 0, "params": {"Id": "4-7", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 179, "indent": 0, "params": {"WaitMode": "i1.5"}},
    {"op": "DestroySpawnedExtended", "line": 180, "indent": 0, "params": {"Path": "Clue", "Wait": 1, "LogWarning": 1}},
    {"op": "HideAllCharacters", "line": 182, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "魔女在处刑台上受刑后……<br>\n下降到地下的处刑台会移动到哪里？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema014"]}},
    {"op": "HideAllCharacters", "line": 187, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "……哎，这个嘛，告诉你也无妨。<br>\n地下有一间【冷冻室】，<br>\n而受刑后的所有魔女都会在那里冷冻保存起来。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden012"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "（地下的冷冻室……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema015"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "因为魔女是不死的，<br>\n所以我们会用这种方式来保存。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden013"]}},
    {"op": "SpawnExtended", "line": 199, "indent": 0, "params": {"Path": "Clue", "Params": ["4-6"]}},
    {"op": "UpdateWitchBook", "line": 200, "indent": 0, "params": {"Id": "4-6", "Category": "Clue", "Version": 1}},
    {"op": "Wait", "line": 201, "indent": 0, "params": {"WaitMode": "i1.5"}},
    {"op": "DestroySpawnedExtended", "line": 202, "indent": 0, "params": {"Path": "Clue", "Wait": 1, "LogWarning": 1}},
    {"op": "HideAllCharacters", "line": 204, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "……说起来，<br>\n玛格刚才说她之前看到处刑台<br>\n是下降下去了的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema016"]}},
    {"op": "HideAllCharacters", "line": 209, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "是啊，应该是这样没错。<br>\n我这里有操作历史记录。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden014"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "记录显示，处刑台在昨晚9点左右曾移动过几次……<br>\n然后是今早9点才升上来的。<br>\n在那之前应该一直都在地下。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden015"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "我这边可没有做过这种安排……<br>\n到底是谁给升上来的呢。<br>\n哎呀呀，真叫人头疼。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Warden016"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "（处刑台的升降记录……<br>\n　看来玛格刚说的<br>\n　都是真话）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema017"]}},
