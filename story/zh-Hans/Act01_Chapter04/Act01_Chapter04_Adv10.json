    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Ema018"]}},
    {"op": "PlaySfxModified", "line": 232, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "趁着艾玛沉思不语，<br>\n典狱长直接就飞走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv10_Narrative008"]}},
