    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "——在她走进审判庭时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "啊啊，艾玛也来了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Margo001"]}},
    {"op": "HideAllCharacters", "line": 20, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmL2"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "又出一桩麻烦事……<br>\n拜托，能不能放过我啊。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Coco001"]}},
    {"op": "HideAllCharacters", "line": 25, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlayBgm", "line": 27, "indent": 0, "params": {"BgmPath": "Bgm_3_1_Loop", "IntroBgmPath": "Bgm_3_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "艾玛一眼就看到了可可口中的“麻烦事”。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "在审判庭的正中央，<br>\n在那最引人注目的处刑台上，有一具尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative003"]}},
    {"op": "HidePrinter", "line": 33, "indent": 0, "params": {}},
