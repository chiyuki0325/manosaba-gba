    {"op": "AnimateActorExtended", "line": 37, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "ScenePositionX": "60", "EasingTypeName": "EaseOutQuad", "Duration": "1.5"}},
    {"op": "Wait", "line": 38, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "ModifyBackgroundExtended", "line": 40, "indent": 0, "params": {"Id": "Stills", "Scale": [3.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [45.0, -5.0], "AppearanceAndTransition": "300_1", "SubId": "Middle"}},
