    {"op": "AnimateActorExtended", "line": 48, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "Scale": "1.15", "EasingTypeName": "EaseOutQuad", "Duration": "2.4"}},
    {"op": "SpawnBlur", "line": 49, "indent": 0, "params": {"ActorId": "Stills", "Intensity": 0.0, "FadeDuration": 1.7999999523162842}},
    {"op": "HideActors", "line": 50, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 51, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "那是一名被捆绑在处刑台电椅上的少女。<br>\n任谁一看就知道，她已经没有生命迹象。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative004"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "——她就是紫藤亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative005"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "为什么亚里沙会……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Ema001"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "梅露露来得比其他人稍晚一些。她在看到亚里沙的尸体后<br>\n也无力地哭泣起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative006"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "亚里沙小姐……呜呜，为什么，为什么……<br>\n啊啊啊啊……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Meruru001"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "梅露露的哭叫声<br>\n回荡在整个审判庭中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative007"]}},
    {"op": "HideActors", "line": 65, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "把众人叫到审判庭来的典狱长，此刻却不知所踪，<br>\n又过了一会才来到审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 70, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "人都到齐了吗？<br>\n黑部奈叶香小姐还是老样子，不见人影啊。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Warden001"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "好啦，如各位所见，<br>\n由于发生了凶杀案，<br>\n接下来将举行魔女审判。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Warden002"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "反正现在没剩几个人了，<br>\n大家也不用想太多，好吗。<br>\n审判就定在正午开始吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Warden003"]}},
    {"op": "HideAllCharacters", "line": 80, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1,ArmL2"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "你这家伙就没打算给时间我们去调查吗！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Coco002"]}},
    {"op": "HideAllCharacters", "line": 85, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "哎呀，我是希望快点结束这段不愉快的时间。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Warden004"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "请各位务必从在场的囚犯之中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑……<br>\n还有就是老规矩，如果无法锁定凶手，所有人都要接受处刑。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Warden005"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "现在原本是禁止外出时间，<br>\n但搜查期间允许自由出入。<br>\n那么，请各位努力找出凶手吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Warden006"]}},
    {"op": "PlaySfxModified", "line": 95, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "典狱长还是老样子，<br>\n自顾自把话说完就飞走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "……要找出，杀死亚里沙的凶手……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Ema002"]}},
    {"op": "HideAllCharacters", "line": 105, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "艾玛看了看在场所剩无几的少女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative010"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "（玛格、可可、梅露露，<br>\n　然后还有不在场的奈叶香……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Ema003"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "（人也实在太少了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Ema004"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "直到现在梅露露依然泣不成声，一时半会应该没法行动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative011"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "玛格和可可摆出“跟你们没什么好商量的”的态度<br>\n快步走出了审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative012"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "明明才找到线索，或许有办法揭开监牢秘密了，<br>\n没想到转眼就发生了凶案。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative013"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "艾玛觉得力不从心，<br>\n只想闭上眼睛，捂住耳朵，对一切不闻不问。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Narrative014"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "（可是……可是，既然有人杀死了亚里沙……<br>\n　我就要找出真相才行……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv07_Ema005"]}},
    {"op": "UpdateWitchBook", "line": 123, "indent": 0, "params": {"Id": "Alisa", "Category": "Profile", "Version": 3}},
    {"op": "SetCustomVariable", "line": 125, "indent": 0, "params": {"Expression": "chosenAreaFlag = 0"}},
    {"op": "Gosub", "line": 126, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 128, "indent": 0, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Adv08", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv07_Narrative001": "——在她走进审判庭时。",
  "0104Adv07_Margo001": "啊啊，艾玛也来了。",
  "0104Adv07_Coco001": "又出一桩麻烦事……<br>\n拜托，能不能放过我啊。",
  "0104Adv07_Narrative002": "艾玛一眼就看到了可可口中的“麻烦事”。",
  "0104Adv07_Narrative003": "在审判庭的正中央，<br>\n在那最引人注目的处刑台上，有一具尸体。",
  "0104Adv07_Narrative004": "那是一名被捆绑在处刑台电椅上的少女。<br>\n任谁一看就知道，她已经没有生命迹象。",
  "0104Adv07_Narrative005": "——她就是紫藤亚里沙。",
  "0104Adv07_Ema001": "为什么亚里沙会……",
  "0104Adv07_Narrative006": "梅露露来得比其他人稍晚一些。她在看到亚里沙的尸体后<br>\n也无力地哭泣起来。",
  "0104Adv07_Meruru001": "亚里沙小姐……呜呜，为什么，为什么……<br>\n啊啊啊啊……",
  "0104Adv07_Narrative007": "梅露露的哭叫声<br>\n回荡在整个审判庭中。",
  "0104Adv07_Narrative008": "把众人叫到审判庭来的典狱长，此刻却不知所踪，<br>\n又过了一会才来到审判庭。",
  "0104Adv07_Warden001": "人都到齐了吗？<br>\n黑部奈叶香小姐还是老样子，不见人影啊。",
  "0104Adv07_Warden002": "好啦，如各位所见，<br>\n由于发生了凶杀案，<br>\n接下来将举行魔女审判。",
  "0104Adv07_Warden003": "反正现在没剩几个人了，<br>\n大家也不用想太多，好吗。<br>\n审判就定在正午开始吧。",
  "0104Adv07_Coco002": "你这家伙就没打算给时间我们去调查吗！",
  "0104Adv07_Warden004": "哎呀，我是希望快点结束这段不愉快的时间。",
  "0104Adv07_Warden005": "请各位务必从在场的囚犯之中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑……<br>\n还有就是老规矩，如果无法锁定凶手，所有人都要接受处刑。",
  "0104Adv07_Warden006": "现在原本是禁止外出时间，<br>\n但搜查期间允许自由出入。<br>\n那么，请各位努力找出凶手吧。",
  "0104Adv07_Narrative009": "典狱长还是老样子，<br>\n自顾自把话说完就飞走了。",
  "0104Adv07_Ema002": "……要找出，杀死亚里沙的凶手……",
  "0104Adv07_Narrative010": "艾玛看了看在场所剩无几的少女。",
  "0104Adv07_Ema003": "（玛格、可可、梅露露，<br>\n　然后还有不在场的奈叶香……）",
  "0104Adv07_Ema004": "（人也实在太少了……）",
  "0104Adv07_Narrative011": "直到现在梅露露依然泣不成声，一时半会应该没法行动。",
  "0104Adv07_Narrative012": "玛格和可可摆出“跟你们没什么好商量的”的态度<br>\n快步走出了审判庭。",
  "0104Adv07_Narrative013": "明明才找到线索，或许有办法揭开监牢秘密了，<br>\n没想到转眼就发生了凶案。",
  "0104Adv07_Narrative014": "艾玛觉得力不从心，<br>\n只想闭上眼睛，捂住耳朵，对一切不闻不问。",
  "0104Adv07_Ema005": "（可是……可是，既然有人杀死了亚里沙……<br>\n　我就要找出真相才行……！）"
}
}
