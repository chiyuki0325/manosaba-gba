{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter04/Act01_Chapter04_Adv04",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-4-4", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlayBgm", "line": 13, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "刚刚差点被亚里沙杀死的艾玛<br>\n来到食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative001"]}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "发生那种事以后不可能还有食欲，但可能“要遵守规定”<br>\n这一点已经在艾玛心里扎根，她还是来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative002"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "稀奇的是，<br>\n此时可可和玛格就在食堂内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative003"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "她们应该一直都是有意识地错开时间来吃饭，<br>\n而今天因为艾玛来晚了，<br>\n于是阴差阳错在同一时段来到了食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative004"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "当艾玛尴尬地在餐桌前坐下时，<br>\n随后而来的梅露露也出现了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "我刚才看到了亚里沙小姐。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru001"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "啊，嗯、嗯，我也……看到了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema001"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "想起几乎要完全化作异形的亚里沙的模样，<br>\n艾玛难受得低下了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "亚里沙小姐，看起来非常，非常难受……<br>\n日子一天天过去，她的心神消耗越来越重。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "我们……就什么都帮不了她吗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "我跟她聊了几句，<br>\n她的状态应该稳定了不少。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru003"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "她还跟我约定，说自己不会变成魔女。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "真、真的吗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema003"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "——哼。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco001"]}},
    {"op": "HideAllCharacters", "line": 58, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "虽然挑了一个跟她们相隔挺远的位置坐下，<br>\n但看来可可两人一直留意她们的对话。<br>\n可可仿佛在落井下石似的嗤笑道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "你蠢不蠢？<br>\n这种随口说说的约定你也信？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco002"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "我可不敢信。她那副样子，看着就绝对会变成魔女。<br>\n说不定她已经准备乘机偷袭杀人哦～？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco003"]}},
    {"op": "HideAllCharacters", "line": 68, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "亚里沙才不是那种人……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema004"]}},
    {"op": "HideAllCharacters", "line": 73, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1,ArmL3"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "哎哟～还在信什么手拉手好朋友吗？<br>\n恶心！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmL2"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "反正到最后所有人都会想着谁死了都行就自己不想死，<br>\n为了活命就只能先下手把对方杀死，<br>\n然后互相厮杀。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco005"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "到那时我们心地善良的艾玛亲<br>\n会乖乖地任人宰杀是吗？<br>\n嘴里还要说什么这都是为了朋友～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco006"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Smile1,ArmR6,ArmL2"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "要是这样的话，<br>\n那人家也要跟艾玛亲做朋友～！求你了嘛～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco007"]}},
    {"op": "HideAllCharacters", "line": 88, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "嬉皮笑脸地说完这些讨喜话后，<br>\n可可重重地敲了敲桌面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 93, "indent": 0, "params": {"SfxPath": "Sfx_32", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "这个犹如一团恶意的巨大声响，<br>\n吓得艾玛和梅露露打了个哆嗦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1,ArmR2,ArmL3"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "简直令人作呕！！<br>\n所有人都是敌人！！你们怎么还没注意到这一点！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco008"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "……不、不对哦，我们，不是敌人。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema005"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "和睦相处肯定是最好的。<br>\n这样肯定就能找到一条活路……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema006"]}},
    {"op": "HideAllCharacters", "line": 108, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1,ArmR2,ArmL2"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "什么活路啊？<br>\n我们的结局不就只有要么死要么变魔女吗！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco009"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1,ArmR10,ArmL8"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "我不想死！<br>\n不想死！不想死！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco010"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "你们给我去死行不行！！<br>\n除了我以外其他人全给我消失啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco011"]}},
    {"op": "HideAllCharacters", "line": 119, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "可可，你先冷静一下。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Margo001"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "玛格站了起来，<br>\n向怒火中烧的可可走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative010"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "可可正抱着头不停地颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Fearful1,ArmR10,ArmL8"}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "说不定她会来杀我……<br>\n我说了她很多坏话，<br>\n还故意惹怒她……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco012"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "说不定她心里恨我，要来杀死我……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco013"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "好怕……！好害怕，我好害怕，谁来救救我！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Coco014"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "是啊，得早点想想怎样自卫才好。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Margo002"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "（连玛格也……不对，<br>\n　玛格她从一开始就不相信任何人）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema007"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "可可因恐惧而陷入恐慌状态，<br>\n玛格一边摩挲她的后背一边把她扶了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative012"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "我们走吧。现在还是一个人待着会好些。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Margo003"]}},
    {"op": "HideAllCharacters", "line": 147, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "玛格斜眼朝艾玛和梅露露那边<br>\n看了看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative013"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "不单单是亚里沙，<br>\n没有人知道谁会在什么时候动手杀人。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Margo004"]}},
    {"op": "HideAllCharacters", "line": 155, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "玛格和可可离开了食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative014"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "（我们跟玛格还有可可已经<br>\n　无法互相理解了吗……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema008"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "一直以来，<br>\n艾玛都觉得自己和玛格还有可可之间有一条无法跨越的沟壑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "……艾玛小姐！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru005"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "这里……就交给我来处理，好吗。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru006"]}},
    {"op": "ModifyCharacterExtended", "line": 170, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "欸……？<br>\n梅、梅露露……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema009"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "梅露露眼里渗出点点泪花。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "这样……一点都不好！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru007"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "所以……玛格小姐跟可可小姐，<br>\n然后还有亚里沙小姐跟奈叶香小姐……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru008"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "就算只是一点点也好，<br>\n我也想试着把大家的心维系起来。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru009"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "你、你想怎么办？<br>\n梅露露……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "我觉得她们俩的心灵正承受着摧残。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru010"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "所以我要先让玛格小姐和可可小姐<br>\n内心平静下来才行……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru011"]}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "既然决定了我就要马上准备才行……！<br>\n详细情况我以后再告诉你！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Meruru012"]}},
    {"op": "HideActors", "line": 198, "indent": 0, "params": {"ActorIds": ["Meruru"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "说完，梅露露小跑着，<br>\n跟在玛格和可可的后头离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative017"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "……梅露露是在尽自己所能<br>\n做力所能及的事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema011"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "我呢……我又能做到什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Ema012"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "没有人能为这个问题作出回答。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv04_Narrative018"]}},
    {"op": "Gosub", "line": 208, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 210, "indent": 0, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Adv05", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv04_Narrative001": "刚刚差点被亚里沙杀死的艾玛<br>\n来到食堂。",
  "0104Adv04_Narrative002": "发生那种事以后不可能还有食欲，但可能“要遵守规定”<br>\n这一点已经在艾玛心里扎根，她还是来了。",
  "0104Adv04_Narrative003": "稀奇的是，<br>\n此时可可和玛格就在食堂内。",
  "0104Adv04_Narrative004": "她们应该一直都是有意识地错开时间来吃饭，<br>\n而今天因为艾玛来晚了，<br>\n于是阴差阳错在同一时段来到了食堂。",
  "0104Adv04_Narrative005": "当艾玛尴尬地在餐桌前坐下时，<br>\n随后而来的梅露露也出现了。",
  "0104Adv04_Meruru001": "我刚才看到了亚里沙小姐。",
  "0104Adv04_Ema001": "啊，嗯、嗯，我也……看到了。",
  "0104Adv04_Narrative006": "想起几乎要完全化作异形的亚里沙的模样，<br>\n艾玛难受得低下了头。",
  "0104Adv04_Meruru002": "亚里沙小姐，看起来非常，非常难受……<br>\n日子一天天过去，她的心神消耗越来越重。",
  "0104Adv04_Ema002": "我们……就什么都帮不了她吗……",
  "0104Adv04_Meruru003": "我跟她聊了几句，<br>\n她的状态应该稳定了不少。",
  "0104Adv04_Meruru004": "她还跟我约定，说自己不会变成魔女。",
  "0104Adv04_Ema003": "真、真的吗！？",
  "0104Adv04_Coco001": "——哼。",
  "0104Adv04_Narrative007": "虽然挑了一个跟她们相隔挺远的位置坐下，<br>\n但看来可可两人一直留意她们的对话。<br>\n可可仿佛在落井下石似的嗤笑道。",
  "0104Adv04_Coco002": "你蠢不蠢？<br>\n这种随口说说的约定你也信？",
  "0104Adv04_Coco003": "我可不敢信。她那副样子，看着就绝对会变成魔女。<br>\n说不定她已经准备乘机偷袭杀人哦～？",
  "0104Adv04_Ema004": "亚里沙才不是那种人……！",
  "0104Adv04_Coco004": "哎哟～还在信什么手拉手好朋友吗？<br>\n恶心！！",
  "0104Adv04_Coco005": "反正到最后所有人都会想着谁死了都行就自己不想死，<br>\n为了活命就只能先下手把对方杀死，<br>\n然后互相厮杀。",
  "0104Adv04_Coco006": "到那时我们心地善良的艾玛亲<br>\n会乖乖地任人宰杀是吗？<br>\n嘴里还要说什么这都是为了朋友～",
  "0104Adv04_Coco007": "要是这样的话，<br>\n那人家也要跟艾玛亲做朋友～！求你了嘛～！",
  "0104Adv04_Narrative008": "嬉皮笑脸地说完这些讨喜话后，<br>\n可可重重地敲了敲桌面。",
  "0104Adv04_Narrative009": "这个犹如一团恶意的巨大声响，<br>\n吓得艾玛和梅露露打了个哆嗦。",
  "0104Adv04_Coco008": "简直令人作呕！！<br>\n所有人都是敌人！！你们怎么还没注意到这一点！！",
  "0104Adv04_Ema005": "……不、不对哦，我们，不是敌人。",
  "0104Adv04_Ema006": "和睦相处肯定是最好的。<br>\n这样肯定就能找到一条活路……",
  "0104Adv04_Coco009": "什么活路啊？<br>\n我们的结局不就只有要么死要么变魔女吗！",
  "0104Adv04_Coco010": "我不想死！<br>\n不想死！不想死！",
  "0104Adv04_Coco011": "你们给我去死行不行！！<br>\n除了我以外其他人全给我消失啊！！",
  "0104Adv04_Margo001": "可可，你先冷静一下。",
  "0104Adv04_Narrative010": "玛格站了起来，<br>\n向怒火中烧的可可走去。",
  "0104Adv04_Narrative011": "可可正抱着头不停地颤抖。",
  "0104Adv04_Coco012": "说不定她会来杀我……<br>\n我说了她很多坏话，<br>\n还故意惹怒她……",
  "0104Adv04_Coco013": "说不定她心里恨我，要来杀死我……",
  "0104Adv04_Coco014": "好怕……！好害怕，我好害怕，谁来救救我！！",
  "0104Adv04_Margo002": "是啊，得早点想想怎样自卫才好。",
  "0104Adv04_Ema007": "（连玛格也……不对，<br>\n　玛格她从一开始就不相信任何人）",
  "0104Adv04_Narrative012": "可可因恐惧而陷入恐慌状态，<br>\n玛格一边摩挲她的后背一边把她扶了起来。",
  "0104Adv04_Margo003": "我们走吧。现在还是一个人待着会好些。",
  "0104Adv04_Narrative013": "玛格斜眼朝艾玛和梅露露那边<br>\n看了看。",
  "0104Adv04_Margo004": "不单单是亚里沙，<br>\n没有人知道谁会在什么时候动手杀人。",
  "0104Adv04_Narrative014": "玛格和可可离开了食堂。",
  "0104Adv04_Ema008": "（我们跟玛格还有可可已经<br>\n　无法互相理解了吗……）",
  "0104Adv04_Narrative015": "一直以来，<br>\n艾玛都觉得自己和玛格还有可可之间有一条无法跨越的沟壑。",
  "0104Adv04_Meruru005": "……艾玛小姐！",
  "0104Adv04_Meruru006": "这里……就交给我来处理，好吗。",
  "0104Adv04_Ema009": "欸……？<br>\n梅、梅露露……？",
  "0104Adv04_Narrative016": "梅露露眼里渗出点点泪花。",
  "0104Adv04_Meruru007": "这样……一点都不好！",
  "0104Adv04_Meruru008": "所以……玛格小姐跟可可小姐，<br>\n然后还有亚里沙小姐跟奈叶香小姐……",
  "0104Adv04_Meruru009": "就算只是一点点也好，<br>\n我也想试着把大家的心维系起来。",
  "0104Adv04_Ema010": "你、你想怎么办？<br>\n梅露露……",
  "0104Adv04_Meruru010": "我觉得她们俩的心灵正承受着摧残。",
  "0104Adv04_Meruru011": "所以我要先让玛格小姐和可可小姐<br>\n内心平静下来才行……",
  "0104Adv04_Meruru012": "既然决定了我就要马上准备才行……！<br>\n详细情况我以后再告诉你！",
  "0104Adv04_Narrative017": "说完，梅露露小跑着，<br>\n跟在玛格和可可的后头离开了。",
  "0104Adv04_Ema011": "……梅露露是在尽自己所能<br>\n做力所能及的事……",
  "0104Adv04_Ema012": "我呢……我又能做到什么……？",
  "0104Adv04_Narrative018": "没有人能为这个问题作出回答。"
}
}
