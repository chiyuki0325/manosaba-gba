{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter04/Act01_Chapter04_Adv02",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-4-2", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "17_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "艾玛朝着湖的方向跑了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 18, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "真的在下雪……<br>\n为什么，只有这里……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema001"]}},
    {"op": "HideAllCharacters", "line": 22, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛站在湖边，看着纷飞的雪花从天而降，<br>\n化为泡影逐渐消失。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "雪应该没有下很久，<br>\n可湖面却结冰了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "其他地方并未下雪，<br>\n仿佛唯独这片湖泊附近的季节与四周完全不同。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmL2"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "跟花田里的彩虹一样吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa001"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "肯定是有人在这里留下了魔法的痕迹，<br>\n然后因为某个契机触发了这个奇怪的现象。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 36, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "——亚里沙！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema002"]}},
    {"op": "HideAllCharacters", "line": 41, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "在不知不觉间，艾玛猛然发现亚里沙站在自己身旁。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmL2"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "樱羽也来看雪了啊。<br>\n我也是老远就看到这里下雪了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa003"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "我经常都会来这里。<br>\n这个地方能让我感到平静。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa004"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "确实经常见你来这里。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmL2"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "是啊，虽然现在结冰了……<br>\n但我希望能尽量待在水边。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa005"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "这跟你的魔法有关系……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema004"]}},
    {"op": "HideAllCharacters", "line": 62, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "看到亚里沙弯腰坐在地上，<br>\n艾玛也在她的旁边坐下，战战兢兢地问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "嗯。我很害怕自己。<br>\n我无法原谅自己。<br>\n我啊，最讨厌自己了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa006"]}},
    {"op": "StopBgm", "line": 68, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "亚里沙眺望着远方，<br>\n开始一点一滴说起自己的过往。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "这肯定就是，她的禁忌——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative008"]}},
    {"op": "ResetText", "line": 78, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 79, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 80, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlayBgm", "line": 82, "indent": 0, "params": {"BgmPath": "Bgm_1_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyTextPrinter", "line": 84, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "我自认为我家算是家境宽裕，<br>\n性格温和的父母向我倾注了足够多的爱，<br>\n对我宠爱有加。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "父母尽心把我养育成一个乖孩子，<br>\n在这种不值一提的压抑下，<br>\n我的心里萌生了一点点想要捣蛋的想法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "他们从来没有责骂过我。<br>\n所以我想要尝尝挨骂的滋味。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "就只是因为这么一个理由。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "擅自调换物品的摆放位置。<br>\n顶撞父母。<br>\n把父母一直很宝贝的东西弄坏。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "但我的父母总是很和蔼，<br>\n从来不会很严厉地呵斥我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "为什么？<br>\n为什么他们都不骂我？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative015"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "难不成他们根本不爱我？<br>\n难不成他们对我完全没有兴趣？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative016"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "这种杂乱烦闷的感情逐渐扭曲，<br>\n我的所作所为也渐渐激化。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative017"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "我离家出走。<br>\n我去偷东西。<br>\n我沉溺于药物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative018"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "可是父母依然没有生气。<br>\n他们肯定我，劝解我，接受我做过的一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative019"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "我穿了一个又一个耳洞。<br>\n我换了发型和衣服，把自己弄得像个不良少女。<br>\n我施展暴力像吃饭一样稀松平常。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative020"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "心里甚至向往着，<br>\n希望能在哪一天受到他们的斥责。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative021"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "要离谱到什么程度他们才会骂我？<br>\n才会惩罚我？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative022"]}},
    {"op": "ModifyBackgroundExtended", "line": 115, "indent": 0, "params": {"Id": "Stills", "Scale": [2.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [100.0, 30.0], "AppearanceAndTransition": "260_1"}},
    {"op": "ModifyBackgroundExtended", "line": 116, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 117, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "不知道从什么时候开始，我不借助外物也能生起火来，<br>\n于是我用这个能力，把我家点着了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative023"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "我就眼睁睁地看着这座从小生活长大的家<br>\n慢慢烧毁崩塌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative024"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "——我能听到一阵阵惨叫。<br>\n那是父母喊来的人被火焰吞没时因恐惧而发出的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative025"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "我做了坏事。<br>\n我终于，做出了坏事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative026"]}},
    {"op": "ModifyBackgroundExtended", "line": 128, "indent": 0, "params": {"Id": "Stills", "Scale": [2.5], "Duration": 0.800000011920929, "Lazy": 0, "ScenePosition": [60.0, 80.0], "AppearanceAndTransition": "260_1", "SubId": "Middle"}},
    {"op": "Wait", "line": 129, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "AnimateActorExtended", "line": 130, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionY": "20", "Scale": "2.5", "EasingTypeName": "Linear", "Duration": "5"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "我拉过身旁的药箱，拿出大量的药物吞进嘴里，<br>\n在迷蒙的痛快感中，<br>\n沉醉于犯下罪孽的意识。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative027"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "我犯下了无法弥补的过错。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative028"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "这样他们就会来骂我。<br>\n从今以后，我不再是乖孩子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative029"]}},
    {"op": "ModifyBackgroundExtended", "line": 139, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.5, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "260_1", "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 140, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 141, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "从火海中被救出来后，父母紧紧抱住了我。<br>\n他们露出了一个悲痛欲绝的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative030"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "来，你们快骂我。我怀着这种心思抬起了头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative031"]}},
    {"op": "ModifyBackgroundExtended", "line": 147, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "HideActors", "line": 148, "indent": 0, "params": {"ActorIds": ["Stills", "Stills-Middle", "Stills-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "——这是意外，是事故。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative032"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "这是他们的第一句话。<br>\n单单这一句话就足以让我绝望。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative033"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "——亚里沙不可能做这种事的。<br>\n——我们只是运气不好而已。<br>\n——亚里沙一点错也没有。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative034"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "这些话在我耳里全都是诅咒。<br>\n没有人愿意直面我的罪孽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative035"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "每次能得到的全是原谅、宽恕、放过——<br>\n所以我才无法原谅自己。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative036"]}},
    {"op": "ModifyBackgroundExtended", "line": 165, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 166, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "StopBgm", "line": 167, "indent": 0, "params": {}},
    {"op": "HidePrinter", "line": 169, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 171, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "亚里沙深深地吐了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative037"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "亚里沙……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema005"]}},
    {"op": "PlayBgm", "line": 179, "indent": 0, "params": {"BgmPath": "Bgm_24_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 181, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 182, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "还没被抓到这里来的时候，我就离家出走了。<br>\n我一直没有回家。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa007"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "我已经回不了家了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa008"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "至于我爸妈，我只希望他们能把我忘了，<br>\n幸福地过日子就好。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa009"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "反正我会被关在这里，<br>\n直到变成魔女，然后死去吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa010"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "（怎么会这样，果然到最后我会孤零零一个人……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema006"]}},
    {"op": "HideAllCharacters", "line": 196, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "在下雪的湖边呆太久，<br>\n艾玛感觉全身都冷透了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative038"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "她抱着身体直打寒颤。<br>\n就在下一瞬间，身旁突然冒出一股暖意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative039"]}},
    {"op": "PlaySfxModified", "line": 203, "indent": 0, "params": {"SfxPath": "Sfx_30", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 206, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,ArmL11,Angle01/Option_ArmL+"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "啊，谢谢你，亚里沙……真暖和。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema007"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "发现原来是亚里沙为了自己在指尖点起火焰后，<br>\n艾玛露出了一个笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative040"]}},
    {"op": "ModifyCharacterExtended", "line": 212, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,ArmL11,Angle01/Option_ArmL+"}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "我能做的就这么点事。<br>\n……啊，可是最近我能让火焰的温度升得相当高哦。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa011"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "——高得可以融化任何东西。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa012"]}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "你的意思是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema008"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "是我的魔女化程度在加深，所以魔法变得更强了吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa013"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "轻轻的一句嘟哝，<br>\n语气却那么地死气沉沉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative041"]}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Surprised1,ArmL11,Angle01/Option_ArmL+"}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "唔，忍不住了——", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa014"]}},
    {"op": "HideAllCharacters", "line": 230, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "亚里沙突然弯下身，<br>\n捂住胸口痛苦地呻吟起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative042"]}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "亚里沙！？<br>\n你还好吗，亚里沙！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema009"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "艾玛靠近亚里沙，伸手想要触碰亚里沙的肩膀。<br>\n就在她触碰到对方之前，一只手伸了过来……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative043"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "（欸——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema010"]}},
    {"op": "HideAllCharacters", "line": 246, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 248, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 249, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 250, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ChangeActorMaskability", "line": 252, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle", "Alisa-Front"], "Enable": 0}},
    {"op": "ModifyBackgroundExtended", "line": 253, "indent": 0, "params": {"Rotation": [0.0, 0.0, -8.0], "Scale": [2.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [25.0, 5.0], "AppearanceAndTransition": "17_2", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 254, "indent": 0, "params": {"Rotation": [0.0, 0.0, -8.0], "Scale": [1.399999976158142], "Duration": 0.0, "Lazy": 0, "ScenePosition": [63.0, 40.0], "IdAndAppearance": "Ema.Pensive1,ArmR6,ArmL6", "SubId": "Middle"}},
    {"op": "SpawnBlur", "line": 255, "indent": 0, "params": {"ActorId": "Ema-Middle", "Intensity": 0.10000000149011612, "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Rotation": [0.0, 0.0, -8.0], "Scale": [1.600000023841858], "TintColor": "#000000cc", "Duration": 0.0, "Lazy": 0, "ScenePosition": [45.0, 50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL7", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 257, "indent": 0, "params": {"ActorId": "Alisa-Front", "Intensity": 0.30000001192092896, "FadeDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 258, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 259, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "那只手猛地掐住艾玛的脖子后用力一推，<br>\n把她紧紧地抵在身后的树干上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative044"]}},
    {"op": "PlaySfxModified", "line": 264, "indent": 0, "params": {"SfxPath": "Sfx_153", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "呜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema011"]}},
    {"op": "ResetText", "line": 270, "indent": 0, "params": {}},
    {"op": "QuickSave", "line": 271, "indent": 0, "params": {"SlotNumber": 13, "Wait": 0}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "你一靠过来我就觉得心里很慌乱。总感觉你很可怕。<br>\n你是魔女对不对？对吧，对吧！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa015"]}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "亚里、沙，我不是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema012"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "既然是魔女那就该杀对吧！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa016"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "脖子上的手不带一丝犹豫地收紧，<br>\n艾玛已经双脚离地。她感到一阵窒息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative045"]}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Fearful1,ArmR6,ArmL6", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "（继续这样下去，她会、杀死我……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema013"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "被用力掐住脖子的艾玛她——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative046"]}},
    {"op": "AddChoice", "line": 287, "indent": 0, "params": {"ChoiceSummary": "作出了抵抗", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0104Adv02_Choice001"]}},
    {"op": "GotoModified", "line": 288, "indent": 1, "params": {"Path": ".Choice1-4-1"}},
    {"op": "AddChoice", "line": 290, "indent": 0, "params": {"ChoiceSummary": "任她处置了", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0104Adv02_Choice002"]}},
    {"op": "GotoModified", "line": 291, "indent": 1, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Bad01", "ResetState": ["-"]}},
    {"op": "StopForChoice", "line": 293, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice1-4-1", "line": 295, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 297, "indent": 0, "params": {"Number": 13}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "快……住手……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema014"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "艾玛挣扎了一下，想要挣脱亚里沙的钳制。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative047"]}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa017"]}},
    {"op": "HideAllCharacters", "line": 307, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 308, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 309, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 310, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideActors", "line": 312, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Lazy": 0}},
    {"op": "SpawnBlur", "line": 313, "indent": 0, "params": {"ActorId": "Alisa-Front", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "SpawnBlur", "line": 314, "indent": 0, "params": {"ActorId": "Ema-Middle", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 315, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "17_2"}},
    {"op": "ModifyBackgroundExtended", "line": 316, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 317, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 319, "indent": 0, "params": {"Text": "看来亚里沙在最后一刻控制住了自己，<br>\n她放开了艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative048"]}},
    {"op": "PrintTextModified", "line": 321, "indent": 0, "params": {"Text": "艾玛当即跪坐在地上。<br>\n与此同时，亚里沙也蹲下身来发出一声呻吟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative049"]}},
    {"op": "ModifyCharacterExtended", "line": 323, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 325, "indent": 0, "params": {"Text": "咳，咳咳……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema015"]}},
    {"op": "HideAllCharacters", "line": 327, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 328, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "——快走！<br>\n趁我现在还留着点理性！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa018"]}},
    {"op": "HideAllCharacters", "line": 332, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 333, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "我怎么能跑，亚里——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema016"]}},
    {"op": "HideAllCharacters", "line": 337, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 338, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "不要让我杀人！<br>\n快走……！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Alisa019"]}},
    {"op": "HideAllCharacters", "line": 342, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 343, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Ema017"]}},
    {"op": "HideAllCharacters", "line": 347, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "感觉眼泪下一瞬间就要夺眶而出，<br>\n但艾玛依然转过身，背对着亚里沙独自一人往回跑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv02_Narrative050"]}},
    {"op": "PlaySfxModified", "line": 352, "indent": 0, "params": {"SfxPath": "Sfx_173", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Gosub", "line": 354, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 356, "indent": 0, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Adv03", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv02_Narrative001": "艾玛朝着湖的方向跑了起来。",
  "0104Adv02_Ema001": "真的在下雪……<br>\n为什么，只有这里……",
  "0104Adv02_Narrative002": "艾玛站在湖边，看着纷飞的雪花从天而降，<br>\n化为泡影逐渐消失。",
  "0104Adv02_Narrative003": "雪应该没有下很久，<br>\n可湖面却结冰了。",
  "0104Adv02_Narrative004": "其他地方并未下雪，<br>\n仿佛唯独这片湖泊附近的季节与四周完全不同。",
  "0104Adv02_Alisa001": "跟花田里的彩虹一样吧。",
  "0104Adv02_Alisa002": "肯定是有人在这里留下了魔法的痕迹，<br>\n然后因为某个契机触发了这个奇怪的现象。",
  "0104Adv02_Ema002": "——亚里沙！",
  "0104Adv02_Narrative005": "在不知不觉间，艾玛猛然发现亚里沙站在自己身旁。",
  "0104Adv02_Alisa003": "樱羽也来看雪了啊。<br>\n我也是老远就看到这里下雪了。",
  "0104Adv02_Alisa004": "我经常都会来这里。<br>\n这个地方能让我感到平静。",
  "0104Adv02_Ema003": "确实经常见你来这里。",
  "0104Adv02_Alisa005": "是啊，虽然现在结冰了……<br>\n但我希望能尽量待在水边。",
  "0104Adv02_Ema004": "这跟你的魔法有关系……？",
  "0104Adv02_Narrative006": "看到亚里沙弯腰坐在地上，<br>\n艾玛也在她的旁边坐下，战战兢兢地问道。",
  "0104Adv02_Alisa006": "嗯。我很害怕自己。<br>\n我无法原谅自己。<br>\n我啊，最讨厌自己了。",
  "0104Adv02_Narrative007": "亚里沙眺望着远方，<br>\n开始一点一滴说起自己的过往。",
  "0104Adv02_Narrative008": "这肯定就是，她的禁忌——",
  "0104Adv02_Narrative009": "我自认为我家算是家境宽裕，<br>\n性格温和的父母向我倾注了足够多的爱，<br>\n对我宠爱有加。",
  "0104Adv02_Narrative010": "父母尽心把我养育成一个乖孩子，<br>\n在这种不值一提的压抑下，<br>\n我的心里萌生了一点点想要捣蛋的想法。",
  "0104Adv02_Narrative011": "他们从来没有责骂过我。<br>\n所以我想要尝尝挨骂的滋味。",
  "0104Adv02_Narrative012": "就只是因为这么一个理由。",
  "0104Adv02_Narrative013": "擅自调换物品的摆放位置。<br>\n顶撞父母。<br>\n把父母一直很宝贝的东西弄坏。",
  "0104Adv02_Narrative014": "但我的父母总是很和蔼，<br>\n从来不会很严厉地呵斥我。",
  "0104Adv02_Narrative015": "为什么？<br>\n为什么他们都不骂我？",
  "0104Adv02_Narrative016": "难不成他们根本不爱我？<br>\n难不成他们对我完全没有兴趣？",
  "0104Adv02_Narrative017": "这种杂乱烦闷的感情逐渐扭曲，<br>\n我的所作所为也渐渐激化。",
  "0104Adv02_Narrative018": "我离家出走。<br>\n我去偷东西。<br>\n我沉溺于药物。",
  "0104Adv02_Narrative019": "可是父母依然没有生气。<br>\n他们肯定我，劝解我，接受我做过的一切。",
  "0104Adv02_Narrative020": "我穿了一个又一个耳洞。<br>\n我换了发型和衣服，把自己弄得像个不良少女。<br>\n我施展暴力像吃饭一样稀松平常。",
  "0104Adv02_Narrative021": "心里甚至向往着，<br>\n希望能在哪一天受到他们的斥责。",
  "0104Adv02_Narrative022": "要离谱到什么程度他们才会骂我？<br>\n才会惩罚我？",
  "0104Adv02_Narrative023": "不知道从什么时候开始，我不借助外物也能生起火来，<br>\n于是我用这个能力，把我家点着了。",
  "0104Adv02_Narrative024": "我就眼睁睁地看着这座从小生活长大的家<br>\n慢慢烧毁崩塌。",
  "0104Adv02_Narrative025": "——我能听到一阵阵惨叫。<br>\n那是父母喊来的人被火焰吞没时因恐惧而发出的声音。",
  "0104Adv02_Narrative026": "我做了坏事。<br>\n我终于，做出了坏事。",
  "0104Adv02_Narrative027": "我拉过身旁的药箱，拿出大量的药物吞进嘴里，<br>\n在迷蒙的痛快感中，<br>\n沉醉于犯下罪孽的意识。",
  "0104Adv02_Narrative028": "我犯下了无法弥补的过错。",
  "0104Adv02_Narrative029": "这样他们就会来骂我。<br>\n从今以后，我不再是乖孩子。",
  "0104Adv02_Narrative030": "从火海中被救出来后，父母紧紧抱住了我。<br>\n他们露出了一个悲痛欲绝的表情。",
  "0104Adv02_Narrative031": "来，你们快骂我。我怀着这种心思抬起了头。",
  "0104Adv02_Narrative032": "——这是意外，是事故。",
  "0104Adv02_Narrative033": "这是他们的第一句话。<br>\n单单这一句话就足以让我绝望。",
  "0104Adv02_Narrative034": "——亚里沙不可能做这种事的。<br>\n——我们只是运气不好而已。<br>\n——亚里沙一点错也没有。",
  "0104Adv02_Narrative035": "这些话在我耳里全都是诅咒。<br>\n没有人愿意直面我的罪孽。",
  "0104Adv02_Narrative036": "每次能得到的全是原谅、宽恕、放过——<br>\n所以我才无法原谅自己。",
  "0104Adv02_Narrative037": "亚里沙深深地吐了一口气。",
  "0104Adv02_Ema005": "亚里沙……",
  "0104Adv02_Alisa007": "还没被抓到这里来的时候，我就离家出走了。<br>\n我一直没有回家。",
  "0104Adv02_Alisa008": "我已经回不了家了。",
  "0104Adv02_Alisa009": "至于我爸妈，我只希望他们能把我忘了，<br>\n幸福地过日子就好。",
  "0104Adv02_Alisa010": "反正我会被关在这里，<br>\n直到变成魔女，然后死去吧。",
  "0104Adv02_Ema006": "（怎么会这样，果然到最后我会孤零零一个人……）",
  "0104Adv02_Narrative038": "在下雪的湖边呆太久，<br>\n艾玛感觉全身都冷透了。",
  "0104Adv02_Narrative039": "她抱着身体直打寒颤。<br>\n就在下一瞬间，身旁突然冒出一股暖意。",
  "0104Adv02_Ema007": "啊，谢谢你，亚里沙……真暖和。",
  "0104Adv02_Narrative040": "发现原来是亚里沙为了自己在指尖点起火焰后，<br>\n艾玛露出了一个笑。",
  "0104Adv02_Alisa011": "我能做的就这么点事。<br>\n……啊，可是最近我能让火焰的温度升得相当高哦。",
  "0104Adv02_Alisa012": "——高得可以融化任何东西。",
  "0104Adv02_Ema008": "你的意思是……",
  "0104Adv02_Alisa013": "是我的魔女化程度在加深，所以魔法变得更强了吧。",
  "0104Adv02_Narrative041": "轻轻的一句嘟哝，<br>\n语气却那么地死气沉沉。",
  "0104Adv02_Alisa014": "唔，忍不住了——",
  "0104Adv02_Narrative042": "亚里沙突然弯下身，<br>\n捂住胸口痛苦地呻吟起来。",
  "0104Adv02_Ema009": "亚里沙！？<br>\n你还好吗，亚里沙！？",
  "0104Adv02_Narrative043": "艾玛靠近亚里沙，伸手想要触碰亚里沙的肩膀。<br>\n就在她触碰到对方之前，一只手伸了过来……",
  "0104Adv02_Ema010": "（欸——）",
  "0104Adv02_Narrative044": "那只手猛地掐住艾玛的脖子后用力一推，<br>\n把她紧紧地抵在身后的树干上。",
  "0104Adv02_Ema011": "呜……",
  "0104Adv02_Alisa015": "你一靠过来我就觉得心里很慌乱。总感觉你很可怕。<br>\n你是魔女对不对？对吧，对吧！",
  "0104Adv02_Ema012": "亚里、沙，我不是……",
  "0104Adv02_Alisa016": "既然是魔女那就该杀对吧！",
  "0104Adv02_Narrative045": "脖子上的手不带一丝犹豫地收紧，<br>\n艾玛已经双脚离地。她感到一阵窒息。",
  "0104Adv02_Ema013": "（继续这样下去，她会、杀死我……）",
  "0104Adv02_Narrative046": "被用力掐住脖子的艾玛她——",
  "0104Adv02_Choice001": "作出了抵抗",
  "0104Adv02_Choice002": "任她处置了",
  "0104Adv02_Ema014": "快……住手……！",
  "0104Adv02_Narrative047": "艾玛挣扎了一下，想要挣脱亚里沙的钳制。",
  "0104Adv02_Alisa017": "……",
  "0104Adv02_Narrative048": "看来亚里沙在最后一刻控制住了自己，<br>\n她放开了艾玛。",
  "0104Adv02_Narrative049": "艾玛当即跪坐在地上。<br>\n与此同时，亚里沙也蹲下身来发出一声呻吟。",
  "0104Adv02_Ema015": "咳，咳咳……",
  "0104Adv02_Alisa018": "——快走！<br>\n趁我现在还留着点理性！",
  "0104Adv02_Ema016": "我怎么能跑，亚里——",
  "0104Adv02_Alisa019": "不要让我杀人！<br>\n快走……！",
  "0104Adv02_Ema017": "……",
  "0104Adv02_Narrative050": "感觉眼泪下一瞬间就要夺眶而出，<br>\n但艾玛依然转过身，背对着亚里沙独自一人往回跑。"
}
}
