    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "结果艾玛几乎没吃什么东西，<br>\n便回到了地下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative001"]}},
    {"op": "ResetText", "line": 18, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 20, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 22, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 23, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 24, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "艾玛脚步虚浮地踏进一间牢房。<br>\n那不是她的牢房，是汉娜的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（汉娜……雪莉……<br>\n　我好想你们……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "其实艾玛经常都会到汉娜的牢房里来。<br>\n虽然，可可在房里的时候她会有意识回避。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative003"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "看着排成一列的那些娃娃，艾玛眼睛都湿了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative004"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "她觉得，无论过多久，<br>\n这个伤痕都不可能完全愈合。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative005"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "艾玛抱起那个以自己为原型制作的娃娃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative006"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "因为曾经被火烤过一次，<br>\n艾玛想着要是一个不小心线头都会散掉，<br>\n所以一直都是轻拿轻放。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative007"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "但今天的她实在太过寂寞，不小心用力一抱——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative008"]}},
    {"op": "PlaySfxModified", "line": 43, "indent": 0, "params": {"SfxPath": "Sfx_66", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "然后，她注意到了一道声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative009"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "（刚才的声音是……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema002"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "娃娃的身体里发出一道<br>\n类似搓揉纸片的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative010"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "艾玛看着娃娃，<br>\n小心翼翼地用手指戳进线头松开的缺口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative011"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "她从塞满棉花的娃娃的身体里，<br>\n摸到一张叠成小小一块的纸片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "！这是……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema003"]}},
    {"op": "HideAllCharacters", "line": 59, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "艾玛把娃娃放回原处，<br>\n然后匆忙摊开了折起来的纸片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative013"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "纸上写着些笔迹潦草的文字。<br>\n那是雪莉写给艾玛的留言。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative014"]}},
    {"op": "StopBgm", "line": 65, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema004"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "看完纸上的留言后，<br>\n艾玛立刻转身飞奔起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative015"]}},
    {"op": "ResetText", "line": 73, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 74, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 75, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 77, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 78, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 79, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 85, "indent": 0, "params": {"BgmPath": "Bgm_40_1_Loop", "IntroBgmPath": "Bgm_40_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "当艾玛看到这封信的时候，<br>\n我大概已经死了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry001"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "这些话是我在杀死汉娜以后<br>\n匆忙写下来的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry002"]}},
    {"op": "ResetText", "line": 95, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 96, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 97, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 99, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "4_1"}},
    {"op": "ModifyBackgroundExtended", "line": 100, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 101, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "我会全力以赴，争取在审判中存活下来，<br>\n但我同时也觉得，自己应该赢不过艾玛。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry003"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "所以呢，就请你把这些话当作是我的遗言吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry004"]}},
    {"op": "ResetText", "line": 111, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 112, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 113, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 115, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "19_2"}},
    {"op": "ModifyBackgroundExtended", "line": 116, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 117, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "请你去调查一下【水精之室】。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry005"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "我在搬动屋子的时候，<br>\n发现那里的地基都是固定住的，完全搬不动。<br>\n我就想到，只有那里跟其他房间有明显的不同。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry006"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "因为时间不多，所以我也没有仔细调查过那里到底有什么，<br>\n你去找一找，说不定能找到些重大的线索。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry007"]}},
    {"op": "ResetText", "line": 131, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 133, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 135, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "22_2"}},
    {"op": "ModifyBackgroundExtended", "line": 136, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 137, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "要问那里到底有什么，其实我也不知道怎么回答你才好。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry008"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "但我相信，艾玛你一定能够<br>\n找出真相！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry009"]}},
    {"op": "ResetText", "line": 147, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 148, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 149, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 151, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "23_6"}},
    {"op": "ModifyBackgroundExtended", "line": 152, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 153, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "请你代替我，<br>\n揭开隐藏在这座诡秘监牢里的真相！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry010"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "希望你能答应我！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Sherry011"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "哈啊、哈啊、哈啊、哈啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema005"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "艾玛用尽全力飞奔，<br>\n来到了【水精之室】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative016"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "她喘着粗气，<br>\n环视了房间一周。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative017"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "（应、应该能在这找到些新发现才对，肯定能找到！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema006"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "艾玛一边擦着眼里不断掉落的泪水，<br>\n一边不顾一切地在房间内到处翻找。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative018"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "（这是雪莉托付给我的情报，<br>\n　我要找出来，这次我一定要找出来！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema007"]}},
    {"op": "ResetText", "line": 179, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 180, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 181, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 183, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "23_8"}},
    {"op": "ModifyBackgroundExtended", "line": 184, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 185, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "艾玛翻遍了每个角落，结果——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "真的，找到了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema008"]}},
    {"op": "HideAllCharacters", "line": 193, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "【在水精之室】内，<br>\n她发现地板某处有那么一丝丝的缝隙，<br>\n于是便把地板撬起——然后找到了秘密楼梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative020"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "（这里到底是……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema009"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "艾玛愣愣地低头看着那扇明显有意隐藏起来的，<br>\n通往地下的门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative021"]}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "（进去吧……不管怎样都要先调查看看再说！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema010"]}},
    {"op": "StopBgm", "line": 203, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "艾玛吞了吞口水，<br>\n战战兢兢地走下了门后的楼梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative022"]}},
    {"op": "ResetText", "line": 207, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 208, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 209, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 211, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "31_1"}},
    {"op": "ModifyBackgroundExtended", "line": 212, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 213, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 215, "indent": 0, "params": {"BgmPath": "Bgm_25_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "楼梯下是一个夹层。<br>\n那是一个电梯前厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 219, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "电梯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema011"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "（说不定跟外面的世界是相通的！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema012"]}},
    {"op": "HideAllCharacters", "line": 225, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 227, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "31_2"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "艾玛怀着一丝的希望，<br>\n迫不及待地走进了电梯。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative024"]}},
    {"op": "PlaySfxModified", "line": 231, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 233, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "31_1"}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "电梯内只有上升和下降两个按钮。<br>\n艾玛不假思索地按下了下降按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative025"]}},
    {"op": "PlaySfxModified", "line": 238, "indent": 0, "params": {"SfxPath": "Ambi_5_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "电梯徐徐下降，<br>\n艾玛的心跳也随之加速。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative026"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "（下了电梯后一定，一定就是……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema013"]}},
    {"op": "StopSfx", "line": 244, "indent": 0, "params": {}},
    {"op": "Wait", "line": 245, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PlaySfxModified", "line": 248, "indent": 0, "params": {"SfxPath": "Sfx_68", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 250, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 251, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 252, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "艾玛才走了没多远，<br>\n就被一扇门挡住了脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative027"]}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "途中并没有任何岔路，<br>\n看来通道是直通这个房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative028"]}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "（这是什么房间……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema014"]}},
    {"op": "ResetText", "line": 260, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 261, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 263, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "25_1"}},
    {"op": "ModifyBackgroundExtended", "line": 264, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 265, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "艾玛开门一看，<br>\n房间里简直就像一家研究所。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 269, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "欸……！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema015"]}},
    {"op": "HideAllCharacters", "line": 273, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "这完全出乎艾玛的意料，<br>\n她忍不住发出一声惊叫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative030"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "而且就在她踏进房间的那一刻，<br>\n周围的温度一下子就降了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative031"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "看来隔壁房间的温度相当低，<br>\n把这个房间的室温也连带着拉低了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative032"]}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "艾玛嘴里冒着白烟，在房间内瑟瑟发抖。<br>\n她感觉站在原地不动的话，<br>\n不消一会就会冻成冰棍。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative033"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "（这到底是什么房间……<br>\n　感觉像是什么研究所）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema016"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "（不、不管了，先调查看看吧！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema017"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "她急急忙忙地四处看，<br>\n然后找到了一份随意放置在架子上的文件。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative034"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "艾玛拿起来一打开，<br>\n发现里面夹着一份囚犯名册。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative035"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "但上面罗列的姓名艾玛并不熟悉，<br>\n她想，这应该是记录了过往<br>\n收监到此处的囚犯少女的名册。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative036"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "其中的一个名字让艾玛吃了一惊。<br>\n那个名字上面还特意画了一个红圈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative037"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "——黑部奈叶香。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative038"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "奈叶香……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema018"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "艾玛翻到下一页，<br>\n上面记录的是奈叶香的正面照和个人信息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative039"]}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "名册里的内容几乎都是用在这座监牢里看到的神秘语言所书写。<br>\n尽管看不懂，但艾玛推测，<br>\n这是有关奈叶香的调查报告。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative040"]}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "纸面上好多地方都用艾玛能看懂的语言<br>\n写了潦草的旁注。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative041"]}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "——【重点监视对象】【越狱？】【危险】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative042"]}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "扑通扑通，艾玛的心剧烈地跳动着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative043"]}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "（奈叶香，究竟是什么人……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema019"]}},
    {"op": "PrintTextModified", "line": 315, "indent": 0, "params": {"Text": "就在下一瞬间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative044"]}},
    {"op": "PlaySfxModified", "line": 318, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "艾玛背后的门传来一个令人惊惧的响声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative045"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema020"]}},
    {"op": "HideAllCharacters", "line": 326, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "艾玛仓促地一回头，发现门已经关上了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative046"]}},
    {"op": "PrintTextModified", "line": 330, "indent": 0, "params": {"Text": "她惊恐地四处张望，<br>\n发现深处有另一扇关得紧紧的门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative047"]}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "艾玛这才意识到，<br>\n自己是被关起来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative048"]}},
    {"op": "ModifyCharacterExtended", "line": 334, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "欸，怎么办，欸欸！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema021"]}},
    {"op": "HideAllCharacters", "line": 338, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "完全找不到头绪打开眼前那扇上锁的门，<br>\n艾玛十分慌张。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative049"]}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "房间内冰冷的温度让她无法<br>\n正常思考。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative050"]}},
    {"op": "PrintTextModified", "line": 344, "indent": 0, "params": {"Text": "体温在短时间内急速下降，冷得艾玛一身鸡皮疙瘩。<br>\n接着手指也开始感到麻痹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative051"]}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "（这样下去可能会冷死……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema022"]}},
    {"op": "PrintTextModified", "line": 348, "indent": 0, "params": {"Text": "脑海中浮现的想法令艾玛吓得脸色发青。<br>\n接着，她向一个看似控制面板的仪器跑去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative052"]}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "这个控制面板有点类似于餐馆里的触摸屏，<br>\n能够从固定用的底座上取下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative053"]}},
    {"op": "PrintTextModified", "line": 352, "indent": 0, "params": {"Text": "面板上是一个个<br>\n不知道有什么用处的按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative054"]}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "惊慌失措的艾玛<br>\n劈里啪啦地逐一按下<br>\n控制面板上的按钮。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative055"]}},
    {"op": "PlaySfxModified", "line": 357, "indent": 0, "params": {"SfxPath": "Sfx_4", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 359, "indent": 0, "params": {"Text": "在她胡乱按了好几个按钮以后，<br>\n终于响起门锁打开的声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative056"]}},
    {"op": "ModifyCharacterExtended", "line": 361, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 363, "indent": 0, "params": {"Text": "太好了……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema023"]}},
    {"op": "HideAllCharacters", "line": 365, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 367, "indent": 0, "params": {"Text": "艾玛松了一口气，<br>\n二话不说马上朝着门外走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative057"]}},
    {"op": "PlaySfxModified", "line": 370, "indent": 0, "params": {"SfxPath": "Sfx_104", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "就在她把门打开的时候，<br>\n身后传来了“砰”的一声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative058"]}},
    {"op": "ModifyCharacterExtended", "line": 374, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "啊……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema024"]}},
    {"op": "HideAllCharacters", "line": 378, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 380, "indent": 0, "params": {"Text": "艾玛回过头来，<br>\n发现控制面板已经掉在地上摔成了两半。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative059"]}},
    {"op": "PrintTextModified", "line": 382, "indent": 0, "params": {"Text": "（怎、怎么办……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema025"]}},
    {"op": "PrintTextModified", "line": 384, "indent": 0, "params": {"Text": "看着门外的通道和掉在地上的控制面板，有那么一瞬间，<br>\n艾玛感到茫然不知所措。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative060"]}},
    {"op": "ModifyCharacterExtended", "line": 386, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "对……对不起！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema026"]}},
    {"op": "StopBgm", "line": 390, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 391, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 393, "indent": 0, "params": {"Text": "她对着空气道了歉，然后转身离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative061"]}},
    {"op": "ResetText", "line": 395, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 396, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 397, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 399, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "22_2"}},
    {"op": "ModifyBackgroundExtended", "line": 400, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 401, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "走出招待所以后，<br>\n艾玛深深地呼出了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative062"]}},
    {"op": "PlayBgm", "line": 405, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 407, "indent": 0, "params": {"Text": "（总算逃出来了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema027"]}},
    {"op": "PrintTextModified", "line": 409, "indent": 0, "params": {"Text": "（也快到就寝时间了，先回监牢吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema028"]}},
    {"op": "PrintTextModified", "line": 411, "indent": 0, "params": {"Text": "艾玛现在依然觉得很混乱。<br>\n她边走边整理思绪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative063"]}},
    {"op": "PrintTextModified", "line": 413, "indent": 0, "params": {"Text": "（那个地下设施到底是用来做什么的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema029"]}},
    {"op": "PrintTextModified", "line": 415, "indent": 0, "params": {"Text": "（从位置上来看……就在监牢的正下方）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema030"]}},
    {"op": "PrintTextModified", "line": 417, "indent": 0, "params": {"Text": "（另一个让我在意的是——那份文件）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema031"]}},
    {"op": "PrintTextModified", "line": 419, "indent": 0, "params": {"Text": "囚犯名册，还有黑部奈叶香的调查报告。<br>\n这到底意味着什么，当下的艾玛根本无法预测。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative064"]}},
    {"op": "PrintTextModified", "line": 421, "indent": 0, "params": {"Text": "她唯一能想到的，<br>\n就是奈叶香跟其他关在这里的囚犯有着明显的不同。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative065"]}},
    {"op": "ModifyCharacterExtended", "line": 423, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 425, "indent": 0, "params": {"Text": "（全都是些想不明白的事情，<br>\n　但应该还能再去那个地下设施看看）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema032"]}},
    {"op": "PrintTextModified", "line": 427, "indent": 0, "params": {"Text": "以防万一，<br>\n艾玛将【水精之室】恢复了原状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative066"]}},
    {"op": "ModifyCharacterExtended", "line": 429, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 431, "indent": 0, "params": {"Text": "（明天再去看看吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Ema033"]}},
    {"op": "HideAllCharacters", "line": 433, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 435, "indent": 0, "params": {"Text": "定下了当前目标后，艾玛稍稍恢复了一些活力，<br>\n沿着回监牢的路上飞奔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative067"]}},
    {"op": "PrintTextModified", "line": 437, "indent": 0, "params": {"Text": "——此时，一名少女正站在树荫之下，<br>\n窥视着艾玛的一举一动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Narrative068"]}},
    {"op": "ModifyCharacterExtended", "line": 439, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 441, "indent": 0, "params": {"Text": "…………", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv05_Nanoka001"]}},
    {"op": "Gosub", "line": 443, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 445, "indent": 0, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Adv06", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv05_Narrative001": "结果艾玛几乎没吃什么东西，<br>\n便回到了地下。",
  "0104Adv05_Narrative002": "艾玛脚步虚浮地踏进一间牢房。<br>\n那不是她的牢房，是汉娜的牢房。",
  "0104Adv05_Ema001": "（汉娜……雪莉……<br>\n　我好想你们……）",
  "0104Adv05_Narrative003": "其实艾玛经常都会到汉娜的牢房里来。<br>\n虽然，可可在房里的时候她会有意识回避。",
  "0104Adv05_Narrative004": "看着排成一列的那些娃娃，艾玛眼睛都湿了。",
  "0104Adv05_Narrative005": "她觉得，无论过多久，<br>\n这个伤痕都不可能完全愈合。",
  "0104Adv05_Narrative006": "艾玛抱起那个以自己为原型制作的娃娃。",
  "0104Adv05_Narrative007": "因为曾经被火烤过一次，<br>\n艾玛想着要是一个不小心线头都会散掉，<br>\n所以一直都是轻拿轻放。",
  "0104Adv05_Narrative008": "但今天的她实在太过寂寞，不小心用力一抱——",
  "0104Adv05_Narrative009": "然后，她注意到了一道声音。",
  "0104Adv05_Ema002": "（刚才的声音是……）",
  "0104Adv05_Narrative010": "娃娃的身体里发出一道<br>\n类似搓揉纸片的声音。",
  "0104Adv05_Narrative011": "艾玛看着娃娃，<br>\n小心翼翼地用手指戳进线头松开的缺口。",
  "0104Adv05_Narrative012": "她从塞满棉花的娃娃的身体里，<br>\n摸到一张叠成小小一块的纸片。",
  "0104Adv05_Ema003": "！这是……！",
  "0104Adv05_Narrative013": "艾玛把娃娃放回原处，<br>\n然后匆忙摊开了折起来的纸片。",
  "0104Adv05_Narrative014": "纸上写着些笔迹潦草的文字。<br>\n那是雪莉写给艾玛的留言。",
  "0104Adv05_Ema004": "……！",
  "0104Adv05_Narrative015": "看完纸上的留言后，<br>\n艾玛立刻转身飞奔起来。",
  "0104Adv05_Sherry001": "当艾玛看到这封信的时候，<br>\n我大概已经死了。",
  "0104Adv05_Sherry002": "这些话是我在杀死汉娜以后<br>\n匆忙写下来的。",
  "0104Adv05_Sherry003": "我会全力以赴，争取在审判中存活下来，<br>\n但我同时也觉得，自己应该赢不过艾玛。",
  "0104Adv05_Sherry004": "所以呢，就请你把这些话当作是我的遗言吧。",
  "0104Adv05_Sherry005": "请你去调查一下【水精之室】。",
  "0104Adv05_Sherry006": "我在搬动屋子的时候，<br>\n发现那里的地基都是固定住的，完全搬不动。<br>\n我就想到，只有那里跟其他房间有明显的不同。",
  "0104Adv05_Sherry007": "因为时间不多，所以我也没有仔细调查过那里到底有什么，<br>\n你去找一找，说不定能找到些重大的线索。",
  "0104Adv05_Sherry008": "要问那里到底有什么，其实我也不知道怎么回答你才好。",
  "0104Adv05_Sherry009": "但我相信，艾玛你一定能够<br>\n找出真相！",
  "0104Adv05_Sherry010": "请你代替我，<br>\n揭开隐藏在这座诡秘监牢里的真相！",
  "0104Adv05_Sherry011": "希望你能答应我！",
  "0104Adv05_Ema005": "哈啊、哈啊、哈啊、哈啊……",
  "0104Adv05_Narrative016": "艾玛用尽全力飞奔，<br>\n来到了【水精之室】。",
  "0104Adv05_Narrative017": "她喘着粗气，<br>\n环视了房间一周。",
  "0104Adv05_Ema006": "（应、应该能在这找到些新发现才对，肯定能找到！）",
  "0104Adv05_Narrative018": "艾玛一边擦着眼里不断掉落的泪水，<br>\n一边不顾一切地在房间内到处翻找。",
  "0104Adv05_Ema007": "（这是雪莉托付给我的情报，<br>\n　我要找出来，这次我一定要找出来！）",
  "0104Adv05_Narrative019": "艾玛翻遍了每个角落，结果——",
  "0104Adv05_Ema008": "真的，找到了……",
  "0104Adv05_Narrative020": "【在水精之室】内，<br>\n她发现地板某处有那么一丝丝的缝隙，<br>\n于是便把地板撬起——然后找到了秘密楼梯。",
  "0104Adv05_Ema009": "（这里到底是……？）",
  "0104Adv05_Narrative021": "艾玛愣愣地低头看着那扇明显有意隐藏起来的，<br>\n通往地下的门。",
  "0104Adv05_Ema010": "（进去吧……不管怎样都要先调查看看再说！）",
  "0104Adv05_Narrative022": "艾玛吞了吞口水，<br>\n战战兢兢地走下了门后的楼梯。",
  "0104Adv05_Narrative023": "楼梯下是一个夹层。<br>\n那是一个电梯前厅。",
  "0104Adv05_Ema011": "电梯……",
  "0104Adv05_Ema012": "（说不定跟外面的世界是相通的！）",
  "0104Adv05_Narrative024": "艾玛怀着一丝的希望，<br>\n迫不及待地走进了电梯。",
  "0104Adv05_Narrative025": "电梯内只有上升和下降两个按钮。<br>\n艾玛不假思索地按下了下降按钮。",
  "0104Adv05_Narrative026": "电梯徐徐下降，<br>\n艾玛的心跳也随之加速。",
  "0104Adv05_Ema013": "（下了电梯后一定，一定就是……！）",
  "0104Adv05_Narrative027": "艾玛才走了没多远，<br>\n就被一扇门挡住了脚步。",
  "0104Adv05_Narrative028": "途中并没有任何岔路，<br>\n看来通道是直通这个房间。",
  "0104Adv05_Ema014": "（这是什么房间……）",
  "0104Adv05_Narrative029": "艾玛开门一看，<br>\n房间里简直就像一家研究所。",
  "0104Adv05_Ema015": "欸……！？",
  "0104Adv05_Narrative030": "这完全出乎艾玛的意料，<br>\n她忍不住发出一声惊叫。",
  "0104Adv05_Narrative031": "而且就在她踏进房间的那一刻，<br>\n周围的温度一下子就降了下来。",
  "0104Adv05_Narrative032": "看来隔壁房间的温度相当低，<br>\n把这个房间的室温也连带着拉低了。",
  "0104Adv05_Narrative033": "艾玛嘴里冒着白烟，在房间内瑟瑟发抖。<br>\n她感觉站在原地不动的话，<br>\n不消一会就会冻成冰棍。",
  "0104Adv05_Ema016": "（这到底是什么房间……<br>\n　感觉像是什么研究所）",
  "0104Adv05_Ema017": "（不、不管了，先调查看看吧！）",
  "0104Adv05_Narrative034": "她急急忙忙地四处看，<br>\n然后找到了一份随意放置在架子上的文件。",
  "0104Adv05_Narrative035": "艾玛拿起来一打开，<br>\n发现里面夹着一份囚犯名册。",
  "0104Adv05_Narrative036": "但上面罗列的姓名艾玛并不熟悉，<br>\n她想，这应该是记录了过往<br>\n收监到此处的囚犯少女的名册。",
  "0104Adv05_Narrative037": "其中的一个名字让艾玛吃了一惊。<br>\n那个名字上面还特意画了一个红圈。",
  "0104Adv05_Narrative038": "——黑部奈叶香。",
  "0104Adv05_Ema018": "奈叶香……？",
  "0104Adv05_Narrative039": "艾玛翻到下一页，<br>\n上面记录的是奈叶香的正面照和个人信息。",
  "0104Adv05_Narrative040": "名册里的内容几乎都是用在这座监牢里看到的神秘语言所书写。<br>\n尽管看不懂，但艾玛推测，<br>\n这是有关奈叶香的调查报告。",
  "0104Adv05_Narrative041": "纸面上好多地方都用艾玛能看懂的语言<br>\n写了潦草的旁注。",
  "0104Adv05_Narrative042": "——【重点监视对象】【越狱？】【危险】。",
  "0104Adv05_Narrative043": "扑通扑通，艾玛的心剧烈地跳动着。",
  "0104Adv05_Ema019": "（奈叶香，究竟是什么人……？）",
  "0104Adv05_Narrative044": "就在下一瞬间。",
  "0104Adv05_Narrative045": "艾玛背后的门传来一个令人惊惧的响声。",
  "0104Adv05_Ema020": "！？",
  "0104Adv05_Narrative046": "艾玛仓促地一回头，发现门已经关上了。",
  "0104Adv05_Narrative047": "她惊恐地四处张望，<br>\n发现深处有另一扇关得紧紧的门。",
  "0104Adv05_Narrative048": "艾玛这才意识到，<br>\n自己是被关起来了。",
  "0104Adv05_Ema021": "欸，怎么办，欸欸！？",
  "0104Adv05_Narrative049": "完全找不到头绪打开眼前那扇上锁的门，<br>\n艾玛十分慌张。",
  "0104Adv05_Narrative050": "房间内冰冷的温度让她无法<br>\n正常思考。",
  "0104Adv05_Narrative051": "体温在短时间内急速下降，冷得艾玛一身鸡皮疙瘩。<br>\n接着手指也开始感到麻痹。",
  "0104Adv05_Ema022": "（这样下去可能会冷死……）",
  "0104Adv05_Narrative052": "脑海中浮现的想法令艾玛吓得脸色发青。<br>\n接着，她向一个看似控制面板的仪器跑去。",
  "0104Adv05_Narrative053": "这个控制面板有点类似于餐馆里的触摸屏，<br>\n能够从固定用的底座上取下。",
  "0104Adv05_Narrative054": "面板上是一个个<br>\n不知道有什么用处的按钮。",
  "0104Adv05_Narrative055": "惊慌失措的艾玛<br>\n劈里啪啦地逐一按下<br>\n控制面板上的按钮。",
  "0104Adv05_Narrative056": "在她胡乱按了好几个按钮以后，<br>\n终于响起门锁打开的声音。",
  "0104Adv05_Ema023": "太好了……！",
  "0104Adv05_Narrative057": "艾玛松了一口气，<br>\n二话不说马上朝着门外走去。",
  "0104Adv05_Narrative058": "就在她把门打开的时候，<br>\n身后传来了“砰”的一声。",
  "0104Adv05_Ema024": "啊……！",
  "0104Adv05_Narrative059": "艾玛回过头来，<br>\n发现控制面板已经掉在地上摔成了两半。",
  "0104Adv05_Ema025": "（怎、怎么办……！）",
  "0104Adv05_Narrative060": "看着门外的通道和掉在地上的控制面板，有那么一瞬间，<br>\n艾玛感到茫然不知所措。",
  "0104Adv05_Ema026": "对……对不起！！",
  "0104Adv05_Narrative061": "她对着空气道了歉，然后转身离开了。",
  "0104Adv05_Narrative062": "走出招待所以后，<br>\n艾玛深深地呼出了一口气。",
  "0104Adv05_Ema027": "（总算逃出来了……）",
  "0104Adv05_Ema028": "（也快到就寝时间了，先回监牢吧）",
  "0104Adv05_Narrative063": "艾玛现在依然觉得很混乱。<br>\n她边走边整理思绪。",
  "0104Adv05_Ema029": "（那个地下设施到底是用来做什么的）",
  "0104Adv05_Ema030": "（从位置上来看……就在监牢的正下方）",
  "0104Adv05_Ema031": "（另一个让我在意的是——那份文件）",
  "0104Adv05_Narrative064": "囚犯名册，还有黑部奈叶香的调查报告。<br>\n这到底意味着什么，当下的艾玛根本无法预测。",
  "0104Adv05_Narrative065": "她唯一能想到的，<br>\n就是奈叶香跟其他关在这里的囚犯有着明显的不同。",
  "0104Adv05_Ema032": "（全都是些想不明白的事情，<br>\n　但应该还能再去那个地下设施看看）",
  "0104Adv05_Narrative066": "以防万一，<br>\n艾玛将【水精之室】恢复了原状。",
  "0104Adv05_Ema033": "（明天再去看看吧）",
  "0104Adv05_Narrative067": "定下了当前目标后，艾玛稍稍恢复了一些活力，<br>\n沿着回监牢的路上飞奔。",
  "0104Adv05_Narrative068": "——此时，一名少女正站在树荫之下，<br>\n窥视着艾玛的一举一动。",
  "0104Adv05_Nanoka001": "…………"
}
}
