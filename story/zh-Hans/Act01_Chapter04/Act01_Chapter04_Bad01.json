    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "（啊啊，但只要任由她处置……<br>\n　我就不会再变得孤单了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Ema001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "艾玛卸下全身的力气，<br>\n乖乖地接受亚里沙对她施加的暴力。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "你没有反抗，是因为明白自己不会死吗？<br>\n快说，是不是这样！？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Ema002"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "随着亚里沙手上的力气加重，<br>\n艾玛显得十分难受，嘴巴一张一合地颤动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "就算痛苦难受，艾玛也绝对不会挣扎。<br>\n她甚至——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Pensive"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "你……为什么在笑。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa002"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "看到亚里沙稍稍露怯的神情，<br>\n艾玛轻轻触碰了她的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative004"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "这……不是……<br>\n亚里、沙……的错……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Ema004"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "……哈？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa003"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "是我……自己、做的、选择……<br>\n谢……谢、你……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Ema005"]}},
    {"op": "StopBgm", "line": 52, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Pensive"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "你这……什么意思。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa004"]}},
    {"op": "PlayBgm", "line": 58, "indent": 0, "params": {"BgmPath": "Bgm_12_1_Loop", "IntroBgmPath": "Bgm_12_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 64, "indent": 0, "params": {"Duration": 0.30000001192092896, "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.30000001192092896, "Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "CreatureAlisa.1-4"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "为什么……<br>\n为什么为什么为什么为什么为什么为什么！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa005"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "亚里沙越发用力，<br>\n把艾玛的颈椎骨掐得咯吱咯吱响。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "……呜、咳……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Ema006"]}},
    {"op": "PlaySfxModified", "line": 76, "indent": 0, "params": {"SfxPath": "Sfx_108", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "随着一声骨折的声音，<br>\n艾玛整个身体瘫软下来，完全失去了动静。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureAlisa.1-5"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "死，了……？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa006"]}},
    {"op": "PlaySfxModified", "line": 85, "indent": 0, "params": {"SfxPath": "Sfx_19", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureAlisa.0-5"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "亚里沙松开手后，<br>\n艾玛直接跌倒在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "CreatureAlisa.0-3"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "哈哈，啊哈哈……<br>\n啊哈哈哈哈哈哈！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa007"]}},
    {"op": "PlaySfxModified", "line": 96, "indent": 0, "params": {"SfxPath": "Sfx_30", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "发出一阵疯癫的狂笑后，<br>\n亚里沙在自己的手心点起火苗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative008"]}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "小小的火苗徐徐增大，<br>\n亚里沙把这团火球凑近艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative009"]}},
    {"op": "ModifyBackgroundExtended", "line": 104, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "火焰蔓延到艾玛的衣服上越烧越旺，<br>\n不消一会便将艾玛的尸骸完全吞没。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative010"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "看着熊熊燃烧的火焰，亚里沙带着无神的双眸笑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative011"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "烧吧，都给我烧起来！<br>\n给我烧得更猛烈！给我把一切都烧成灰烬！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa008"]}},
    {"op": "PlaySfxModified", "line": 113, "indent": 0, "params": {"SfxPath": "Sfx_30", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "有如回应亚里沙的号叫一般，<br>\n她周围的树木也开始烧了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative012"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "火势是如此的凶猛，<br>\n瞬间就把地面的积雪全部融化，<br>\n四周顿时变成一片火海。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative013"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "呵呵，哈哈哈……<br>\n这样就能挨骂了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa009"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "就能让他们骂我，让他们爱我！<br>\n啊哈哈，哈哈哈哈哈！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa010"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "狂笑不已的亚里沙。<br>\n这阵笑声却突然戛然而止。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative014"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "可是，如果他们不骂我呢……？<br>\n做到这个地步还是会原谅我呢……？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa011"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "不行，不能这样……<br>\n那我就……我就要当一个更加更加坏的女孩。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa012"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "我要……杀更多的人才行。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa013"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "亚里沙嘟哝着，望向了监牢——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative015"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "啊啊，是啊……我就知道。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa014"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "只要所有人都死了……<br>\n就没有人能够原谅我。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa015"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "我早就该这么做……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa016"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "只要把一切都烧毁……呵呵，<br>\n哈哈哈哈哈！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Alisa017"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "任由汹涌的火海泛滥，<br>\n亚里沙带着一脸的愉悦走向监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Bad01_Narrative016"]}},
    {"op": "ProcessBadEnd", "line": 147, "indent": 0, "params": {"Number": 13}}
  ],
  "translations": {
  "0104Bad01_Ema001": "（啊啊，但只要任由她处置……<br>\n　我就不会再变得孤单了）",
  "0104Bad01_Narrative001": "艾玛卸下全身的力气，<br>\n乖乖地接受亚里沙对她施加的暴力。",
  "0104Bad01_Alisa001": "你没有反抗，是因为明白自己不会死吗？<br>\n快说，是不是这样！？",
  "0104Bad01_Ema002": "……",
  "0104Bad01_Narrative002": "随着亚里沙手上的力气加重，<br>\n艾玛显得十分难受，嘴巴一张一合地颤动。",
  "0104Bad01_Narrative003": "就算痛苦难受，艾玛也绝对不会挣扎。<br>\n她甚至——",
  "0104Bad01_Ema003": "……",
  "0104Bad01_Alisa002": "你……为什么在笑。",
  "0104Bad01_Narrative004": "看到亚里沙稍稍露怯的神情，<br>\n艾玛轻轻触碰了她的手。",
  "0104Bad01_Ema004": "这……不是……<br>\n亚里、沙……的错……",
  "0104Bad01_Alisa003": "……哈？",
  "0104Bad01_Ema005": "是我……自己、做的、选择……<br>\n谢……谢、你……",
  "0104Bad01_Alisa004": "你这……什么意思。",
  "0104Bad01_Alisa005": "为什么……<br>\n为什么为什么为什么为什么为什么为什么！！",
  "0104Bad01_Narrative005": "亚里沙越发用力，<br>\n把艾玛的颈椎骨掐得咯吱咯吱响。",
  "0104Bad01_Ema006": "……呜、咳……",
  "0104Bad01_Narrative006": "随着一声骨折的声音，<br>\n艾玛整个身体瘫软下来，完全失去了动静。",
  "0104Bad01_Alisa006": "死，了……？",
  "0104Bad01_Narrative007": "亚里沙松开手后，<br>\n艾玛直接跌倒在地上。",
  "0104Bad01_Alisa007": "哈哈，啊哈哈……<br>\n啊哈哈哈哈哈哈！",
  "0104Bad01_Narrative008": "发出一阵疯癫的狂笑后，<br>\n亚里沙在自己的手心点起火苗。",
  "0104Bad01_Narrative009": "小小的火苗徐徐增大，<br>\n亚里沙把这团火球凑近艾玛。",
  "0104Bad01_Narrative010": "火焰蔓延到艾玛的衣服上越烧越旺，<br>\n不消一会便将艾玛的尸骸完全吞没。",
  "0104Bad01_Narrative011": "看着熊熊燃烧的火焰，亚里沙带着无神的双眸笑了。",
  "0104Bad01_Alisa008": "烧吧，都给我烧起来！<br>\n给我烧得更猛烈！给我把一切都烧成灰烬！！",
  "0104Bad01_Narrative012": "有如回应亚里沙的号叫一般，<br>\n她周围的树木也开始烧了起来。",
  "0104Bad01_Narrative013": "火势是如此的凶猛，<br>\n瞬间就把地面的积雪全部融化，<br>\n四周顿时变成一片火海。",
  "0104Bad01_Alisa009": "呵呵，哈哈哈……<br>\n这样就能挨骂了。",
  "0104Bad01_Alisa010": "就能让他们骂我，让他们爱我！<br>\n啊哈哈，哈哈哈哈哈！",
  "0104Bad01_Narrative014": "狂笑不已的亚里沙。<br>\n这阵笑声却突然戛然而止。",
  "0104Bad01_Alisa011": "可是，如果他们不骂我呢……？<br>\n做到这个地步还是会原谅我呢……？",
  "0104Bad01_Alisa012": "不行，不能这样……<br>\n那我就……我就要当一个更加更加坏的女孩。",
  "0104Bad01_Alisa013": "我要……杀更多的人才行。",
  "0104Bad01_Narrative015": "亚里沙嘟哝着，望向了监牢——",
  "0104Bad01_Alisa014": "啊啊，是啊……我就知道。",
  "0104Bad01_Alisa015": "只要所有人都死了……<br>\n就没有人能够原谅我。",
  "0104Bad01_Alisa016": "我早就该这么做……",
  "0104Bad01_Alisa017": "只要把一切都烧毁……呵呵，<br>\n哈哈哈哈哈！",
  "0104Bad01_Narrative016": "任由汹涌的火海泛滥，<br>\n亚里沙带着一脸的愉悦走向监牢。"
}
}
