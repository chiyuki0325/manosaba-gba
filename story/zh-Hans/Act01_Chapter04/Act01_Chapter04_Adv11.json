    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "你有事？我睡得不好，<br>\n现在心情爆差的。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Coco001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "现在没那个心思跟你愉快地聊天。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Coco002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "（亚里沙才刚死，<br>\n　我也不可能开开心心地跟人聊天啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Ema002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "心情真的糟透了……<br>\n本来还想着睡个回笼觉，但没过多久审判就要开始。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Coco003"]}},
    {"op": "HideAllCharacters", "line": 33, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "我想问，<br>\n关于亚里沙被杀案，<br>\n可可你有没有发现什么特别的事情……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Ema003"]}},
    {"op": "HideAllCharacters", "line": 38, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR1,ArmL2"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "嗯……没有吧……这事情要我说啊，<br>\n还真松了一口气。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Coco004"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "一看就知道，她魔女化程度加深得很快，<br>\n我还以为自己会被她杀死……等下。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Coco005"]}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "事先声明，我可不会因为这样就把她给杀了！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Coco006"]}},
    {"op": "HideAllCharacters", "line": 51, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "嗯、嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Ema004"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR7,ArmL6"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "啊～好困～好乏～<br>\n我真的每晚都睡不着……<br>\n小梅给我的药完全没有效好不好。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Coco007"]}},
