    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "啊，可可……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv11_Ema001"]}},
