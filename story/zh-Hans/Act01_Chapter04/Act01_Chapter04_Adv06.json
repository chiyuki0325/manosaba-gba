{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter04/Act01_Chapter04_Adv06",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-4-6", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "22_4"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "第二天早上，艾玛再次来到招待所。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "（好……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛大步流星地走向【水精之室】，<br>\n打算再次调查地下的设施。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative002"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "这时，有人出现在她面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "等一等。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka001"]}},
    {"op": "HideAllCharacters", "line": 28, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "奈叶香挡住艾玛的去路。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "奈叶香！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "你这是想去哪里？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "奈叶香面无表情地问道。<br>\n艾玛无法从她的态度猜测出她的想法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative005"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "艾玛脸上闪过一丝不安的神色，但她马上恢复了平静。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "呃……我想去【水精之室】。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema003"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "去那里干什么？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "我想调查一下里面。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema004"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "昨晚你在【水精之室】待了很久。<br>\n那房间也没多大，<br>\n有什么需要花这么多时间去查？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka004"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "昨天你也一直看着我啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema005"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "谁叫你慌慌张张地往那里冲。<br>\n肯定需要关注一下对吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka005"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "【水精之室】里有什么？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka006"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema006"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "艾玛不知道该怎样回答。<br>\n昨晚看到的囚犯名册在脑海里一闪而过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative007"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "（奈叶香到底是什么人……我能相信她吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema007"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "但这个疑惑也在瞬间烟消云散。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative008"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "过去自己就是因为猜忌怀疑，<br>\n无法彻底相信对方，而酿成了恶果。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative009"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（奈叶香是同伴，我相信她）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "……我在水精之室里发现了一个暗室。<br>\n而这个暗室联通着位于地下的神秘设施……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema009"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "！真的吗？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka007"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "嗯、嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema010"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "我也想一起去。<br>\n……只是觉得，既然那房间是藏起来的，<br>\n那么那里应该是个对监牢来说不便公开的地方。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka008"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "我们两个人一起去说不定会有危险，<br>\n随时都有可能被那些猫头鹰发现。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka009"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "有可能……<br>\n那我在外面把风好了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema011"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "我来告诉你怎样到暗室去。<br>\n啊，地下设施里面很冷，像冷冻库似的，<br>\n你要小心。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema012"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "奈叶香带着一丝始料不及的表情<br>\n紧盯着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative010"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "……你这么相信我，真的好吗。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka010"]}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Smile1,ArmR3"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "你是我们的同伴嘛。<br>\n既然我们处境相同，就该互相帮助才对。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema013"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "听到艾玛笑着说出这句话，<br>\n奈叶香的表情一下子缓和了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative011"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "……樱羽艾玛，你人还真好。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka011"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "明白了。我的身后就交给你守护了。<br>\n但我希望你不要误会。这是交易。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka012"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "交易……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema014"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我是在利用你。<br>\n所以要是发生什么意外你也要利用我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka013"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "别说什么利用不利用的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema015"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka014"]}},
    {"op": "HideAllCharacters", "line": 115, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "不等艾玛说完，奈叶香就快步走了起来。<br>\n艾玛追上了她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "……说好了，<br>\n我会相信奈叶香到底。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema016"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "既然你相信我，肯把身后交给我来守护……<br>\n那我也会相信奈叶香。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema017"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "你说的交易……就是这么回事对吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema018"]}},
    {"op": "HideAllCharacters", "line": 127, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "……呼。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka015"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "奈叶香轻轻地吐了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative013"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "如果是跟你们一起的话……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka016"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "保持着背对艾玛的姿势，奈叶香喃喃说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "欸？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema019"]}},
    {"op": "HideAllCharacters", "line": 141, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "……没什么，快走吧。<br>\n这附近的瘴气很浓重。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka017"]}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "因为，在很久很久以前，魔女在这一带受到了人类残酷的对待。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka018"]}},
    {"op": "HideAllCharacters", "line": 148, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "你说的魔女是指……<br>\n以前曾经居住在这座监牢里的魔女……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema020"]}},
    {"op": "HideAllCharacters", "line": 153, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "没错。只要触碰到怀有强烈念想和感情的物品时，<br>\n我就能看到一点……<br>\n在很久很久以前，一群魔女在这座监牢大宅生活的片段。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka019"]}},
    {"op": "StopBgm", "line": 158, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "那段惨痛的历史……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka020"]}},
    {"op": "HideAllCharacters", "line": 162, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "——奈叶香向艾玛诉说起<br>\n自己凭借幻视的魔法得来的信息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative015"]}},
    {"op": "ResetText", "line": 166, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 167, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 168, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlayBgm", "line": 170, "indent": 0, "params": {"BgmPath": "Bgm_36_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "当时以大魔女为集体中心，<br>\n一群魔女在这座岛上和睦平静地生活。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka021"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "但最后被另一个种族……<br>\n被我们【人类】发现了这座岛屿。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka022"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "魔女希望能跟人类和平相处……<br>\n可人类并不这样想。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka023"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "人类一直提防魔女，<br>\n还打算除去这个跟自己不一样的种族。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka024"]}},
    {"op": "PrintTextModified", "line": 180, "indent": 0, "params": {"Text": "然后——大魔女的抵抗最终徒劳无功，<br>\n这座岛屿被人类侵占了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka025"]}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "他们肯定是利用了<br>\n魔女想要和平相处的心来使诈吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka026"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "后来，人类一直对魔女做了很多非常，<br>\n非常残忍的事情……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka027"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "我没有同情她们。这可跟我们没关系。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka028"]}},
    {"op": "StopBgm", "line": 188, "indent": 0, "params": {}},
    {"op": "ResetText", "line": 190, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 191, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 192, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 194, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "22_4"}},
    {"op": "ModifyBackgroundExtended", "line": 195, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 196, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "嘴上这么说，但奈叶香的表情却看着有些许难过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative016"]}},
    {"op": "UpdateWitchBook", "line": 203, "indent": 0, "params": {"Id": "12", "Category": "Note", "Version": 1}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "——跟奈叶香大致说明了一下如何到达地下的隐藏设施后，<br>\n艾玛独自回到了原来的地方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative017"]}},
    {"op": "PlayBgm", "line": 216, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 218, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 219, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 220, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 222, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#b0a080", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "22_4"}},
    {"op": "ModifyBackgroundExtended", "line": 223, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 224, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"TintColor": "#b0a080", "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "现在是8点……<br>\n如果过了两个小时我还没回来，<br>\n你就忘了今晚跟我来过这里的事吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka029"]}},
    {"op": "HideAllCharacters", "line": 231, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"TintColor": "#b0a080", "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "欸……！？<br>\n你别说这种话……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema021"]}},
    {"op": "HideAllCharacters", "line": 236, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"TintColor": "#b0a080", "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "……没事的。<br>\n我一定会找出幕后黑手的证据，<br>\n然后回到这里来。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Nanoka030"]}},
    {"op": "HideAllCharacters", "line": 241, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 247, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 248, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 249, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 251, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "22_4"}},
    {"op": "ModifyBackgroundExtended", "line": 252, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 253, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "从艾玛站在这里把风开始，<br>\n已经过了相当长的一段时间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative018"]}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "到目前为止，她还没遇到过<br>\n典狱长或者看守，以及监视的猫头鹰。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative019"]}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "（已经10点了吗……<br>\n　差不多到时间了，<br>\n　奈叶香她还好吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema022"]}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "（我是不是也应该下去看看<br>\n　比较好）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema023"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "艾玛心里忐忑得很。她在附近不停地来回走动，<br>\n最后取出了手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative020"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "（我又搞砸了……<br>\n　早知道就先跟奈叶香交换一下联系方式）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema024"]}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "看着手机，艾玛才终于发现自己犯了粗心的毛病。<br>\n她轻轻叹了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative021"]}},
    {"op": "PlaySfxModified", "line": 270, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "就在这时，手机发出一个提示音，<br>\n吓得艾玛手一抖，差点没把手机摔地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative022"]}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "好不容易拿稳手机后，艾玛点开了信息。<br>\n那是典狱长发来的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative023"]}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "『唉……这都第几次了呢。<br>\n　又发生了一起令人痛心的凶杀案』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative024"]}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "『请大家立刻到审判庭集合』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative025"]}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "『我觉得让大家亲自过来看看会更直接些……』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative026"]}},
    {"op": "PrintTextModified", "line": 282, "indent": 0, "params": {"Text": "艾玛顿时觉得后背一阵冰冷，<br>\n目光呆滞地望着手机屏幕。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative027"]}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "凶杀案，怎么、会这样……到底，是谁……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Ema025"]}},
    {"op": "PrintTextModified", "line": 286, "indent": 0, "params": {"Text": "仍存活的少女们的身影<br>\n逐一在艾玛的脑海里闪过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative028"]}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "然后，她回过头看了看【水精之室】。<br>\n目前没有任何奈叶香准备出来的迹象。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative029"]}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "艾玛站在原地犹豫了一阵子。<br>\n她现在应该在这继续等待奈叶香呢？<br>\n还是应该去审判庭呢？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative030"]}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "可是，既然有人遇害了，<br>\n艾玛和在世的少女们就有必要知道，目前究竟是什么情况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative031"]}},
    {"op": "PrintTextModified", "line": 294, "indent": 0, "params": {"Text": "最后，她决定赶紧返回监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0104Adv06_Narrative032"]}},
    {"op": "Gosub", "line": 296, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 298, "indent": 0, "params": {"Path": "Act01_Chapter04/Act01_Chapter04_Adv07", "SoftReset": 1}}
  ],
  "translations": {
  "0104Adv06_Narrative001": "第二天早上，艾玛再次来到招待所。",
  "0104Adv06_Ema001": "（好……！）",
  "0104Adv06_Narrative002": "艾玛大步流星地走向【水精之室】，<br>\n打算再次调查地下的设施。",
  "0104Adv06_Narrative003": "这时，有人出现在她面前。",
  "0104Adv06_Nanoka001": "等一等。",
  "0104Adv06_Narrative004": "奈叶香挡住艾玛的去路。",
  "0104Adv06_Ema002": "奈叶香！？",
  "0104Adv06_Nanoka002": "你这是想去哪里？",
  "0104Adv06_Narrative005": "奈叶香面无表情地问道。<br>\n艾玛无法从她的态度猜测出她的想法。",
  "0104Adv06_Narrative006": "艾玛脸上闪过一丝不安的神色，但她马上恢复了平静。",
  "0104Adv06_Ema003": "呃……我想去【水精之室】。",
  "0104Adv06_Nanoka003": "去那里干什么？",
  "0104Adv06_Ema004": "我想调查一下里面。",
  "0104Adv06_Nanoka004": "昨晚你在【水精之室】待了很久。<br>\n那房间也没多大，<br>\n有什么需要花这么多时间去查？",
  "0104Adv06_Ema005": "昨天你也一直看着我啊……",
  "0104Adv06_Nanoka005": "谁叫你慌慌张张地往那里冲。<br>\n肯定需要关注一下对吧。",
  "0104Adv06_Nanoka006": "【水精之室】里有什么？",
  "0104Adv06_Ema006": "……",
  "0104Adv06_Narrative007": "艾玛不知道该怎样回答。<br>\n昨晚看到的囚犯名册在脑海里一闪而过。",
  "0104Adv06_Ema007": "（奈叶香到底是什么人……我能相信她吗……？）",
  "0104Adv06_Narrative008": "但这个疑惑也在瞬间烟消云散。",
  "0104Adv06_Narrative009": "过去自己就是因为猜忌怀疑，<br>\n无法彻底相信对方，而酿成了恶果。",
  "0104Adv06_Ema008": "（奈叶香是同伴，我相信她）",
  "0104Adv06_Ema009": "……我在水精之室里发现了一个暗室。<br>\n而这个暗室联通着位于地下的神秘设施……",
  "0104Adv06_Nanoka007": "！真的吗？",
  "0104Adv06_Ema010": "嗯、嗯。",
  "0104Adv06_Nanoka008": "我也想一起去。<br>\n……只是觉得，既然那房间是藏起来的，<br>\n那么那里应该是个对监牢来说不便公开的地方。",
  "0104Adv06_Nanoka009": "我们两个人一起去说不定会有危险，<br>\n随时都有可能被那些猫头鹰发现。",
  "0104Adv06_Ema011": "有可能……<br>\n那我在外面把风好了。",
  "0104Adv06_Ema012": "我来告诉你怎样到暗室去。<br>\n啊，地下设施里面很冷，像冷冻库似的，<br>\n你要小心。",
  "0104Adv06_Narrative010": "奈叶香带着一丝始料不及的表情<br>\n紧盯着艾玛。",
  "0104Adv06_Nanoka010": "……你这么相信我，真的好吗。",
  "0104Adv06_Ema013": "你是我们的同伴嘛。<br>\n既然我们处境相同，就该互相帮助才对。",
  "0104Adv06_Narrative011": "听到艾玛笑着说出这句话，<br>\n奈叶香的表情一下子缓和了起来。",
  "0104Adv06_Nanoka011": "……樱羽艾玛，你人还真好。",
  "0104Adv06_Nanoka012": "明白了。我的身后就交给你守护了。<br>\n但我希望你不要误会。这是交易。",
  "0104Adv06_Ema014": "交易……？",
  "0104Adv06_Nanoka013": "我是在利用你。<br>\n所以要是发生什么意外你也要利用我。",
  "0104Adv06_Ema015": "别说什么利用不利用的……",
  "0104Adv06_Nanoka014": "……",
  "0104Adv06_Narrative012": "不等艾玛说完，奈叶香就快步走了起来。<br>\n艾玛追上了她。",
  "0104Adv06_Ema016": "……说好了，<br>\n我会相信奈叶香到底。",
  "0104Adv06_Ema017": "既然你相信我，肯把身后交给我来守护……<br>\n那我也会相信奈叶香。",
  "0104Adv06_Ema018": "你说的交易……就是这么回事对吧！",
  "0104Adv06_Nanoka015": "……呼。",
  "0104Adv06_Narrative013": "奈叶香轻轻地吐了一口气。",
  "0104Adv06_Nanoka016": "如果是跟你们一起的话……",
  "0104Adv06_Narrative014": "保持着背对艾玛的姿势，奈叶香喃喃说道。",
  "0104Adv06_Ema019": "欸？",
  "0104Adv06_Nanoka017": "……没什么，快走吧。<br>\n这附近的瘴气很浓重。",
  "0104Adv06_Nanoka018": "因为，在很久很久以前，魔女在这一带受到了人类残酷的对待。",
  "0104Adv06_Ema020": "你说的魔女是指……<br>\n以前曾经居住在这座监牢里的魔女……？",
  "0104Adv06_Nanoka019": "没错。只要触碰到怀有强烈念想和感情的物品时，<br>\n我就能看到一点……<br>\n在很久很久以前，一群魔女在这座监牢大宅生活的片段。",
  "0104Adv06_Nanoka020": "那段惨痛的历史……",
  "0104Adv06_Narrative015": "——奈叶香向艾玛诉说起<br>\n自己凭借幻视的魔法得来的信息。",
  "0104Adv06_Nanoka021": "当时以大魔女为集体中心，<br>\n一群魔女在这座岛上和睦平静地生活。",
  "0104Adv06_Nanoka022": "但最后被另一个种族……<br>\n被我们【人类】发现了这座岛屿。",
  "0104Adv06_Nanoka023": "魔女希望能跟人类和平相处……<br>\n可人类并不这样想。",
  "0104Adv06_Nanoka024": "人类一直提防魔女，<br>\n还打算除去这个跟自己不一样的种族。",
  "0104Adv06_Nanoka025": "然后——大魔女的抵抗最终徒劳无功，<br>\n这座岛屿被人类侵占了。",
  "0104Adv06_Nanoka026": "他们肯定是利用了<br>\n魔女想要和平相处的心来使诈吧。",
  "0104Adv06_Nanoka027": "后来，人类一直对魔女做了很多非常，<br>\n非常残忍的事情……",
  "0104Adv06_Nanoka028": "我没有同情她们。这可跟我们没关系。",
  "0104Adv06_Narrative016": "嘴上这么说，但奈叶香的表情却看着有些许难过。",
  "0104Adv06_Narrative017": "——跟奈叶香大致说明了一下如何到达地下的隐藏设施后，<br>\n艾玛独自回到了原来的地方。",
  "0104Adv06_Nanoka029": "现在是8点……<br>\n如果过了两个小时我还没回来，<br>\n你就忘了今晚跟我来过这里的事吧。",
  "0104Adv06_Ema021": "欸……！？<br>\n你别说这种话……！",
  "0104Adv06_Nanoka030": "……没事的。<br>\n我一定会找出幕后黑手的证据，<br>\n然后回到这里来。",
  "0104Adv06_Narrative018": "从艾玛站在这里把风开始，<br>\n已经过了相当长的一段时间。",
  "0104Adv06_Narrative019": "到目前为止，她还没遇到过<br>\n典狱长或者看守，以及监视的猫头鹰。",
  "0104Adv06_Ema022": "（已经10点了吗……<br>\n　差不多到时间了，<br>\n　奈叶香她还好吗……？）",
  "0104Adv06_Ema023": "（我是不是也应该下去看看<br>\n　比较好）",
  "0104Adv06_Narrative020": "艾玛心里忐忑得很。她在附近不停地来回走动，<br>\n最后取出了手机。",
  "0104Adv06_Ema024": "（我又搞砸了……<br>\n　早知道就先跟奈叶香交换一下联系方式）",
  "0104Adv06_Narrative021": "看着手机，艾玛才终于发现自己犯了粗心的毛病。<br>\n她轻轻叹了一口气。",
  "0104Adv06_Narrative022": "就在这时，手机发出一个提示音，<br>\n吓得艾玛手一抖，差点没把手机摔地上。",
  "0104Adv06_Narrative023": "好不容易拿稳手机后，艾玛点开了信息。<br>\n那是典狱长发来的。",
  "0104Adv06_Narrative024": "『唉……这都第几次了呢。<br>\n　又发生了一起令人痛心的凶杀案』",
  "0104Adv06_Narrative025": "『请大家立刻到审判庭集合』",
  "0104Adv06_Narrative026": "『我觉得让大家亲自过来看看会更直接些……』",
  "0104Adv06_Narrative027": "艾玛顿时觉得后背一阵冰冷，<br>\n目光呆滞地望着手机屏幕。",
  "0104Adv06_Ema025": "凶杀案，怎么、会这样……到底，是谁……",
  "0104Adv06_Narrative028": "仍存活的少女们的身影<br>\n逐一在艾玛的脑海里闪过。",
  "0104Adv06_Narrative029": "然后，她回过头看了看【水精之室】。<br>\n目前没有任何奈叶香准备出来的迹象。",
  "0104Adv06_Narrative030": "艾玛站在原地犹豫了一阵子。<br>\n她现在应该在这继续等待奈叶香呢？<br>\n还是应该去审判庭呢？",
  "0104Adv06_Narrative031": "可是，既然有人遇害了，<br>\n艾玛和在世的少女们就有必要知道，目前究竟是什么情况。",
  "0104Adv06_Narrative032": "最后，她决定赶紧返回监牢。"
}
}
