    {"op": "label", "name": "Scene1-3-15", "line": 4, "indent": 0},
    {"op": "PlayBgm", "line": 10, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 12, "indent": 0, "params": {"Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 80.0], "AppearanceAndTransition": "33_1"}},
    {"op": "Wait", "line": 13, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.7999999523162842, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 16, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 18, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionY": "20", "Duration": "20"}},
    {"op": "Wait", "line": 19, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "艾玛、汉娜、雪莉，还有梅露露，<br>\n她们四个不得不<br>\n给监牢作一次大规模的扫除。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative001"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "然而，雪莉的这场“暴动”，<br>\n却给少女们意外带来了转机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "墙壁上被打出了一个缺口，<br>\n而看守和典狱长似乎<br>\n都没有发现这件事。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative003"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "看守们例行检查时，<br>\n也只是透过窗口粗略观察囚犯是否身在牢房内。<br>\n这意味着，夜晚或许有可能悄悄溜出去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative004"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "雪莉很快进行了试验：<br>\n用床上的毯子堆出人形，并在夜间外出。<br>\n这个尝试竟然成功了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative005"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "虽然需要承担几分风险，<br>\n但能够获得更多自由活动的时间。<br>\n少女们都或多或少从这个意外收获中得了好处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative006"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "然后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative007"]}},
    {"op": "ModifyBackgroundExtended", "line": 35, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "19_2", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR16", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "大家～！往这边来！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 43, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Surprised1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "雪莉，小声点！<br>\n要是被发现就完蛋了～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna001"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "晚、晚上的气氛好吓人……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Meruru001"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "嗯，不过夜间偷溜出来<br>\n还挺让人兴奋的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema001"]}},
    {"op": "HideAllCharacters", "line": 54, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "艾玛她们从牢房中悄悄溜出，<br>\n开始了夜间的秘密探索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative008"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "雪莉在前方带路，少女们借着朦胧的月光，<br>\n小心翼翼地走在石砖铺就的小径上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative009"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "监牢周围难得没有监视猫头鹰盘旋。<br>\n夜色格外静谧。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative010"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "（虽然有些冒险，但说不定能去那个地方看看……<br>\n　只要有足够的时间，一定能发现些什么）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "艾玛，这边！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 68, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "啊，好、好的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema003"]}},
    {"op": "HideAllCharacters", "line": 73, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "沉浸在思绪中的艾玛被雪莉唤回现实，<br>\n连忙跑向同伴们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "雪莉，<br>\n不是说了要小声一点吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna002"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Sherry.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "知道啦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry003"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "不过你看，它们大概觉得有围墙就万无一失，<br>\n根本没人来巡逻呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Ema.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "也就是说，除非能越过那道围墙，<br>\n否则我们永远逃不出去吧……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "要是能翻过那道墙的话……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 99, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "汉娜痛苦地低语，随后用力摇头，仿佛要甩开这不切实际的念头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "话说回来，雪莉，<br>\n你到底要带我们去哪里？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 107, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "不知不觉间，<br>\n一行人已经来到了监牢的后方。<br>\n艾玛记得自己在探索时曾多次来过这片区域。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative013"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "（这附近应该有一扇打不开的门……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema005"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "正如艾玛所想，<br>\n雪莉在一扇厚重的铁门前停下了脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative014"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "这扇门虽然属于监牢建筑的一部分，<br>\n却无法从内部进入。<br>\n也就是说，只能从外面打开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "嘿嘿嘿。<br>\n我说过发现了不得了的东西吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 121, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "雪莉得意地说着，<br>\n轻而易举地推开了铁门。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative016"]}},
    {"op": "PlaySfxModified", "line": 126, "indent": 0, "params": {"SfxPath": "Sfx_62", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 128, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 129, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 130, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "24_1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 133, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 134, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "——映入眼帘的是一个宽敞的仓库。<br>\n混凝土地面上整齐排列着各式的置物架。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative017"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "上面密密麻麻堆满了各种物资、<br>\n材料和纸箱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "竟然还有这种地方！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna005"]}},
    {"op": "HideAllCharacters", "line": 144, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "好多物资啊……<br>\n但是，为什么门会开着呢？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema006"]}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "大概只有在我们被禁止外出的时间段，<br>\n门才会开着吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry006"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "这里储存着囚犯的生活用品和食物，<br>\n推测看守会在夜间搬运。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 156, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "那、<br>\n那岂不是随时可能有看守过来……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna006"]}},
    {"op": "HideAllCharacters", "line": 161, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "到时候再说！<br>\n这里这么大，完全可以躲起来！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 166, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "快、快看，这里有好多罐头……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Meruru002"]}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "顺着梅露露的声音望去，<br>\n只见那边堆满了食品罐头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative019"]}},
    {"op": "HideAllCharacters", "line": 173, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "终于可以摆脱那些难吃的食物了……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "呃，汉娜……<br>\n这些好像都是那种可怕食物的罐头哦？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "噫噫噫！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna008"]}},
    {"op": "HideAllCharacters", "line": 187, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "汉娜不死心地<br>\n开始寻找其他种类的罐头。<br>\n梅露露也显得有些兴奋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Smile", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "如果能找到面粉和白糖的话，<br>\n就可以做点心和面包了……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Meruru003"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "一定要找到啊，梅露露！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Hanna009"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "好的……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Meruru004"]}},
    {"op": "HideAllCharacters", "line": 200, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "艾玛正在仔细观察各种物资，<br>\n这时雪莉靠了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "为了把我们关在这座岛上，<br>\n它们竟储备了这么多东西。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry009"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "我本以为既然有招待所，<br>\n应该会定期有人从岛外来访。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry010"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "但储备既然这么充足，<br>\n看来会有外界访客的可能性很低啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "是啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema008"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "我还想着如果有直升机来，<br>\n说不定能劫机逃走呢……<br>\n真可惜。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry012"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "嗯，虽然发现仓库是个重大突破……<br>\n但似乎还是找不到逃脱的办法呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema009"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "汉娜和梅露露正沉浸在寻找食材的兴奋中，<br>\n似乎还没有意识到这一点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 223, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "（不能这么消极啊）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema010"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "我们也来找找看有什么好东西吧！<br>\n说不定能发现可以用来越狱的工具！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "说得对！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Sherry013"]}},
    {"op": "HideAllCharacters", "line": 233, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HidePrinter", "line": 234, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 235, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0}},
    {"op": "SpawnExtended", "line": 236, "indent": 0, "params": {"Path": "MaskingRectangle", "Params": ["1000", "30", "true", "0.3", "#000000"], "ScenePosition": [20.0, 60.0], "Rotation": [0.0, 0.0, 0.0], "SubId": "Front"}},
    {"op": "ModifyBackgroundExtended", "line": 237, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.75], "Lazy": 0, "ScenePosition": [28.0, 36.0], "AppearanceAndTransition": "24_1", "SubId": "Front"}},
    {"op": "SpawnBlur", "line": 238, "indent": 0, "params": {"ActorId": "MainBackground-Front", "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [40.0, 20.0], "IdAndAppearance": "Nanoka.Default", "SubId": "Front"}},
    {"op": "ChangeActorMaskability", "line": 240, "indent": 0, "params": {"ActorIds": ["MainBackground-Front", "Nanoka-Front"], "Enable": 1}},
    {"op": "AnimateActorExtended", "line": 241, "indent": 0, "params": {"ActorIds": ["MainBackground-Front"], "Loop": 0, "ScenePositionX": "25", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "AnimateActorExtended", "line": 242, "indent": 0, "params": {"ActorIds": ["Nanoka-Front"], "Loop": 0, "ScenePositionX": "35", "EasingTypeName": "EaseOutQuad", "Duration": "0.4"}},
    {"op": "Wait", "line": 243, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "——在层层货架的阴影中，<br>\n一位少女正默默注视着喧闹的艾玛她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Narrative023"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "…………", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv15_Nanoka001"]}},
    {"op": "Gosub", "line": 249, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 251, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv16", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv15_Narrative001": "艾玛、汉娜、雪莉，还有梅露露，<br>\n她们四个不得不<br>\n给监牢作一次大规模的扫除。",
  "0103Adv15_Narrative002": "然而，雪莉的这场“暴动”，<br>\n却给少女们意外带来了转机。",
  "0103Adv15_Narrative003": "墙壁上被打出了一个缺口，<br>\n而看守和典狱长似乎<br>\n都没有发现这件事。",
  "0103Adv15_Narrative004": "看守们例行检查时，<br>\n也只是透过窗口粗略观察囚犯是否身在牢房内。<br>\n这意味着，夜晚或许有可能悄悄溜出去。",
  "0103Adv15_Narrative005": "雪莉很快进行了试验：<br>\n用床上的毯子堆出人形，并在夜间外出。<br>\n这个尝试竟然成功了。",
  "0103Adv15_Narrative006": "虽然需要承担几分风险，<br>\n但能够获得更多自由活动的时间。<br>\n少女们都或多或少从这个意外收获中得了好处。",
  "0103Adv15_Narrative007": "然后——",
  "0103Adv15_Sherry001": "大家～！往这边来！",
  "0103Adv15_Hanna001": "雪莉，小声点！<br>\n要是被发现就完蛋了～！",
  "0103Adv15_Meruru001": "晚、晚上的气氛好吓人……",
  "0103Adv15_Ema001": "嗯，不过夜间偷溜出来<br>\n还挺让人兴奋的。",
  "0103Adv15_Narrative008": "艾玛她们从牢房中悄悄溜出，<br>\n开始了夜间的秘密探索。",
  "0103Adv15_Narrative009": "雪莉在前方带路，少女们借着朦胧的月光，<br>\n小心翼翼地走在石砖铺就的小径上。",
  "0103Adv15_Narrative010": "监牢周围难得没有监视猫头鹰盘旋。<br>\n夜色格外静谧。<br>",
  "0103Adv15_Ema002": "（虽然有些冒险，但说不定能去那个地方看看……<br>\n　只要有足够的时间，一定能发现些什么）",
  "0103Adv15_Sherry002": "艾玛，这边！",
  "0103Adv15_Ema003": "啊，好、好的！",
  "0103Adv15_Narrative011": "沉浸在思绪中的艾玛被雪莉唤回现实，<br>\n连忙跑向同伴们。",
  "0103Adv15_Hanna002": "雪莉，<br>\n不是说了要小声一点吗！？",
  "0103Adv15_Sherry003": "知道啦。",
  "0103Adv15_Sherry004": "不过你看，它们大概觉得有围墙就万无一失，<br>\n根本没人来巡逻呢。",
  "0103Adv15_Ema004": "也就是说，除非能越过那道围墙，<br>\n否则我们永远逃不出去吧……",
  "0103Adv15_Hanna003": "要是能翻过那道墙的话……",
  "0103Adv15_Narrative012": "汉娜痛苦地低语，随后用力摇头，仿佛要甩开这不切实际的念头。",
  "0103Adv15_Hanna004": "话说回来，雪莉，<br>\n你到底要带我们去哪里？",
  "0103Adv15_Narrative013": "不知不觉间，<br>\n一行人已经来到了监牢的后方。<br>\n艾玛记得自己在探索时曾多次来过这片区域。",
  "0103Adv15_Ema005": "（这附近应该有一扇打不开的门……）",
  "0103Adv15_Narrative014": "正如艾玛所想，<br>\n雪莉在一扇厚重的铁门前停下了脚步。",
  "0103Adv15_Narrative015": "这扇门虽然属于监牢建筑的一部分，<br>\n却无法从内部进入。<br>\n也就是说，只能从外面打开。",
  "0103Adv15_Sherry005": "嘿嘿嘿。<br>\n我说过发现了不得了的东西吧？",
  "0103Adv15_Narrative016": "雪莉得意地说着，<br>\n轻而易举地推开了铁门。",
  "0103Adv15_Narrative017": "——映入眼帘的是一个宽敞的仓库。<br>\n混凝土地面上整齐排列着各式的置物架。<br>",
  "0103Adv15_Narrative018": "上面密密麻麻堆满了各种物资、<br>\n材料和纸箱。",
  "0103Adv15_Hanna005": "竟然还有这种地方！？",
  "0103Adv15_Ema006": "好多物资啊……<br>\n但是，为什么门会开着呢？",
  "0103Adv15_Sherry006": "大概只有在我们被禁止外出的时间段，<br>\n门才会开着吧。",
  "0103Adv15_Sherry007": "这里储存着囚犯的生活用品和食物，<br>\n推测看守会在夜间搬运。",
  "0103Adv15_Hanna006": "那、<br>\n那岂不是随时可能有看守过来……？",
  "0103Adv15_Sherry008": "到时候再说！<br>\n这里这么大，完全可以躲起来！",
  "0103Adv15_Meruru002": "快、快看，这里有好多罐头……！",
  "0103Adv15_Narrative019": "顺着梅露露的声音望去，<br>\n只见那边堆满了食品罐头。",
  "0103Adv15_Hanna007": "终于可以摆脱那些难吃的食物了……！",
  "0103Adv15_Ema007": "呃，汉娜……<br>\n这些好像都是那种可怕食物的罐头哦？",
  "0103Adv15_Hanna008": "噫噫噫！",
  "0103Adv15_Narrative020": "汉娜不死心地<br>\n开始寻找其他种类的罐头。<br>\n梅露露也显得有些兴奋。",
  "0103Adv15_Meruru003": "如果能找到面粉和白糖的话，<br>\n就可以做点心和面包了……！",
  "0103Adv15_Hanna009": "一定要找到啊，梅露露！",
  "0103Adv15_Meruru004": "好的……！",
  "0103Adv15_Narrative021": "艾玛正在仔细观察各种物资，<br>\n这时雪莉靠了过来。",
  "0103Adv15_Sherry009": "为了把我们关在这座岛上，<br>\n它们竟储备了这么多东西。",
  "0103Adv15_Sherry010": "我本以为既然有招待所，<br>\n应该会定期有人从岛外来访。",
  "0103Adv15_Sherry011": "但储备既然这么充足，<br>\n看来会有外界访客的可能性很低啊。",
  "0103Adv15_Ema008": "是啊……",
  "0103Adv15_Sherry012": "我还想着如果有直升机来，<br>\n说不定能劫机逃走呢……<br>\n真可惜。",
  "0103Adv15_Ema009": "嗯，虽然发现仓库是个重大突破……<br>\n但似乎还是找不到逃脱的办法呢……",
  "0103Adv15_Narrative022": "汉娜和梅露露正沉浸在寻找食材的兴奋中，<br>\n似乎还没有意识到这一点。",
  "0103Adv15_Ema010": "（不能这么消极啊）",
  "0103Adv15_Ema011": "我们也来找找看有什么好东西吧！<br>\n说不定能发现可以用来越狱的工具！",
  "0103Adv15_Sherry013": "说得对！",
  "0103Adv15_Narrative023": "——在层层货架的阴影中，<br>\n一位少女正默默注视着喧闹的艾玛她们。",
  "0103Adv15_Nanoka001": "…………"
}
}
