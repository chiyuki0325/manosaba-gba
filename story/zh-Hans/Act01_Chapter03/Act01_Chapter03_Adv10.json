    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "走进娱乐室，<br>\n能看见可可坐在沙发上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Smile1,ArmR11"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "哈哈哈哈哈！！<br>\n什么啊！？太有趣了！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1,ArmR11"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "真的假的？详细说说嘛～<br>\n没事没事，我有的是时间。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Smile1,ArmR11"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "……嗯，嗯，然后呢？<br>\n……原来是这样啊！！哈哈哈哈哈！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "可可没有注意到艾玛的到来，<br>\n正在和某人对话——手里拿着手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative002"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "（欸……！？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema001"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "艾玛呆立在原地，<br>\n注视着把手机贴在耳边说话的可可。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Surprised1,ArmR11"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "可可感受到视线，这才注意到艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Surprised1,ArmR6"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "啊。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco004"]}},
    {"op": "PlaySfxModified", "line": 49, "indent": 0, "params": {"SfxPath": "Sfx_60", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "慌乱中可可把手机掉在了地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "可可，你到底在和谁说话！？<br>\n你的手机能和外界联系吗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmR1,ArmL2"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "艾玛急切地追问，<br>\n但可可却尴尬地移开了视线。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative006"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "……笨蛋。怎么可能啊。<br>\n要是能和外面联系，我早就叫人来救我们了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco005"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "也、也对……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema003"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（咦？那刚才……是她在自言自语，<br>\n　幻想着和谁通话吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema004"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "从可可身上散发的气氛，令人无法继续追问下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmL1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "话说，你能不能别和我说话？<br>\n我们不是已经决定不再一起行动了吗。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco006"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "但、但是可可，<br>\n如果不和别人说话的话，状态会变得很糟糕的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Angry1,ArmR13,ArmL10"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "吵死了！吵死了吵死了吵死了！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco007"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "我讨厌你！<br>\n我只愿意和我推说话！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco008"]}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "其他的都不需要！！滚开！！<br>\n消失！！这一切都只是噩梦！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco009"]}},
    {"op": "HideAllCharacters", "line": 85, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "可可蜷缩着捂住耳朵，大声喊道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmR13,ArmL10"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "啊……有来电。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco010"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "明明没有任何铃声。<br>\n可可用失焦的眼神捡起掉在地上的手机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Pensive1,ArmR11,ArmL5"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "啊～是我哦～？很精神很精神～<br>\n你那边怎么样？嗯，嗯，这样啊～", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Coco011"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "面对如此令人心痛的场面，艾玛一时语塞。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 101, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "（可可……<br>\n　已经分不清幻想和现实了啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema006"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "可可的背影，正在拒绝着监牢的现实。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative011"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（但是，这里不是噩梦，<br>\n　而是现实啊……可可）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "——可可，<br>\n今天大家决定在后院野餐。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema008"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "如果可以的话，希望你能来。<br>\n我们会等你的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Ema009"]}},
    {"op": "HideAllCharacters", "line": 115, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "艾玛对着拒绝交流的可可的背影，<br>\n诚恳地说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative012"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "可可没有回头。<br>\n她仍在继续和那个并不存在的人对话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv10_Narrative013"]}},
    {"op": "Gosub", "line": 126, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 128, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv06", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv10_Narrative001": "走进娱乐室，<br>\n能看见可可坐在沙发上。",
  "0103Adv10_Coco001": "哈哈哈哈哈！！<br>\n什么啊！？太有趣了！！",
  "0103Adv10_Coco002": "真的假的？详细说说嘛～<br>\n没事没事，我有的是时间。",
  "0103Adv10_Coco003": "……嗯，嗯，然后呢？<br>\n……原来是这样啊！！哈哈哈哈哈！！",
  "0103Adv10_Narrative002": "可可没有注意到艾玛的到来，<br>\n正在和某人对话——手里拿着手机。",
  "0103Adv10_Ema001": "（欸……！？）",
  "0103Adv10_Narrative003": "艾玛呆立在原地，<br>\n注视着把手机贴在耳边说话的可可。",
  "0103Adv10_Narrative004": "可可感受到视线，这才注意到艾玛。",
  "0103Adv10_Coco004": "啊。",
  "0103Adv10_Narrative005": "慌乱中可可把手机掉在了地上。",
  "0103Adv10_Ema002": "可可，你到底在和谁说话！？<br>\n你的手机能和外界联系吗！？",
  "0103Adv10_Narrative006": "艾玛急切地追问，<br>\n但可可却尴尬地移开了视线。",
  "0103Adv10_Coco005": "……笨蛋。怎么可能啊。<br>\n要是能和外面联系，我早就叫人来救我们了。",
  "0103Adv10_Ema003": "也、也对……",
  "0103Adv10_Ema004": "（咦？那刚才……是她在自言自语，<br>\n　幻想着和谁通话吗……？）",
  "0103Adv10_Narrative007": "从可可身上散发的气氛，令人无法继续追问下去。",
  "0103Adv10_Coco006": "话说，你能不能别和我说话？<br>\n我们不是已经决定不再一起行动了吗。",
  "0103Adv10_Ema005": "但、但是可可，<br>\n如果不和别人说话的话，状态会变得很糟糕的……",
  "0103Adv10_Coco007": "吵死了！吵死了吵死了吵死了！",
  "0103Adv10_Coco008": "我讨厌你！<br>\n我只愿意和我推说话！！",
  "0103Adv10_Coco009": "其他的都不需要！！滚开！！<br>\n消失！！这一切都只是噩梦！！",
  "0103Adv10_Narrative008": "可可蜷缩着捂住耳朵，大声喊道。",
  "0103Adv10_Coco010": "啊……有来电。",
  "0103Adv10_Narrative009": "明明没有任何铃声。<br>\n可可用失焦的眼神捡起掉在地上的手机。",
  "0103Adv10_Coco011": "啊～是我哦～？很精神很精神～<br>\n你那边怎么样？嗯，嗯，这样啊～",
  "0103Adv10_Narrative010": "面对如此令人心痛的场面，艾玛一时语塞。",
  "0103Adv10_Ema006": "（可可……<br>\n　已经分不清幻想和现实了啊……）",
  "0103Adv10_Narrative011": "可可的背影，正在拒绝着监牢的现实。",
  "0103Adv10_Ema007": "（但是，这里不是噩梦，<br>\n　而是现实啊……可可）",
  "0103Adv10_Ema008": "——可可，<br>\n今天大家决定在后院野餐。",
  "0103Adv10_Ema009": "如果可以的话，希望你能来。<br>\n我们会等你的……",
  "0103Adv10_Narrative012": "艾玛对着拒绝交流的可可的背影，<br>\n诚恳地说道。",
  "0103Adv10_Narrative013": "可可没有回头。<br>\n她仍在继续和那个并不存在的人对话。"
}
}
