    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor"}},
    {"op": "PlaySfxModified", "line": 13, "indent": 0, "params": {"SfxPath": "Sfx_57", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "（奇怪……这是什么地方来着……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema001"]}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "艾玛独自走在走廊上。<br>\n这是一条似曾相识的学校走廊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "意识到这一点的瞬间，<br>\n希望涌上了心头，<br>\n她的表情顿时明朗起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "（魔女也好，审判也好，还有那些凶杀案，<br>\n　全都只是一场噩梦！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema002"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "（我根本没有被囚禁，<br>\n　而是在学校里！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema003"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "（对了，得快点，<br>\n　不然要迟到了——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema004"]}},
    {"op": "PlaySfxModified", "line": 28, "indent": 0, "params": {"SfxPath": "Sfx_58", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 30, "indent": 0, "params": {}},
    {"op": "Wait", "line": 31, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlayBgm", "line": 34, "indent": 0, "params": {"BgmPath": "Ambi_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 36, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "刚要跑起来，<br>\n突然传来的嘲笑声让艾玛的身体瞬间僵住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema005"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "嘲笑声从教室里传来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative004"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（不能看教室。<br>\n　不能再做旁观者了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema006"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "（不能看里面的人！<br>\n　不能听那个声音！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema007"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（必须移开视线，<br>\n　必须捂住耳朵）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema008"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "（否则我的心，会崩溃——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema009"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "尽管内心在拼命示警，<br>\n艾玛却仿佛被某种力量操控着，<br>\n还是往里面看去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative005"]}},
    {"op": "StopBgm", "line": 58, "indent": 0, "params": {}},
    {"op": "HidePrinter", "line": 59, "indent": 0, "params": {}},
    {"op": "ModifyTextPrinter", "line": 60, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Wait", "line": 61, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "——啊啊，艾玛。我一直在等你哦。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "——这里的每个人都好丑陋啊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "——光是活着就让人觉得肮脏呢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative008"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "——不如大家都去死好了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "说着，她故意夸张地咧开嘴角，<br>\n露出一个扭曲的笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "艾玛的脸庞，还有她的双眸，都被绝望浸染。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative011"]}},
    {"op": "HidePrinter", "line": 78, "indent": 0, "params": {}},
    {"op": "Wait", "line": 79, "indent": 0, "params": {"WaitMode": "1.2"}},
