    {"op": "ModifyBackgroundExtended", "line": 81, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 82, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlaySfxModified", "line": 83, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyTextPrinter", "line": 84, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
