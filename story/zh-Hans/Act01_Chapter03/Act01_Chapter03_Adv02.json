    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "——！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema010"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "呼，呼，呼，呼……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema011"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "艾玛猛地坐起身，急促地喘息着。<br>\n全身冒着冷汗，心脏剧烈跳动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "是、是梦吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema012"]}},
    {"op": "PlayBgm", "line": 96, "indent": 0, "params": {"BgmPath": "Bgm_17_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 98, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "艾玛梦中的情景很快就变得模糊，<br>\n消散在遗忘的彼方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "确认自己身在监牢的牢房内后，<br>\n她反而松了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "然而就在平复呼吸的过程中，<br>\n她察觉到一阵强烈的寒意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative015"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "（怎么回事……好难受……<br>\n　全身都在疼……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema013"]}},
    {"op": "PlaySfxModified", "line": 108, "indent": 0, "params": {"SfxPath": "Sfx_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "连坐着都很吃力，<br>\n艾玛只好重新躺回床上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative016"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "（是不是生病了……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema014"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "她用床边的手机确认时间。<br>\n现在已经到早晨了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative017"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "（对了，今天要去野餐……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR5"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "艾玛早上好～！<br>\n今天天气也很好呢！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "去吃早餐吧……<br>\n咦，艾玛？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "艾、艾玛小姐，看起来好像不太舒服……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Meruru001"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "雪莉、汉娜、梅露露三人走进牢房，<br>\n立刻注意到艾玛的异常。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative018"]}},
    {"op": "HideAllCharacters", "line": 132, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "梅露露连忙跑到床边，<br>\n将手贴在艾玛的额头上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative019"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "（凉凉的好舒服……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema016"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "发烧了……！糟、糟糕了……！<br>\n得赶快去医务室……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Meruru002"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "……没什么大不了的。<br>\n睡一觉应该就好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema017"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "但是对不起，野餐可能要延期了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema018"]}},
    {"op": "HideAllCharacters", "line": 146, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "别在意这种事啦～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR10"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "就是就是！等艾玛好起来再举办吧！<br>\n现在请好好休息！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 156, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "我、我去准备一些东西……<br>\n药品啊，水啊，毛巾什么的……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 161, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "（明明好不容易策划好的……真的对不起大家……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Ema019"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "怀着对三人的歉意，<br>\n艾玛的意识渐渐陷入了朦胧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv02_Narrative020"]}},
    {"op": "Gosub", "line": 167, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
