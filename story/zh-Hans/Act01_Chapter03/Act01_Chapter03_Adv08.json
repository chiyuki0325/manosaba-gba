    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "艾玛走进会客厅时，<br>\n发现亚里沙正坐在沙发上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "虽然本打算去找大家，<br>\n但看到亚里沙的身影，艾玛不由得犹豫了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative002"]}},
    {"op": "HideAllCharacters", "line": 26, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（该、该怎么办……要打招呼吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "因为刚才在医务室发生的事，<br>\n艾玛的脚步变得迟疑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,ArmL2"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "……是樱羽啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa001"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "就在艾玛踌躇不前时，<br>\n亚里沙先开口了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,ArmL2"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "刚才那个……抱歉。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa002"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "我本来不想那么凶的。<br>\n只是，实在是太烦躁了……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa003"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "亚里沙吞吞吐吐地说着，<br>\n这种反常的态度让艾玛感到惊讶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative005"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "（亚里沙并不是坏孩子……<br>\n　这一点我早就知道了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "别在意。那个，你的身体状况怎么样？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,ArmL2"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "冰上告诉你药的事了吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa004"]}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "……嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,ArmL2"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "冰上太过保护，说得太夸张了。<br>\n就算多吃一点，也不会对身体有什么影响。<br>\n我已经习惯了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa005"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "是这样吗……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,ArmL1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "别误会，那不是什么违禁药物。<br>\n只是吃药能让我安心。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa006"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "被关在这种地方……<br>\n怎么可能保持理智。所以……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa007"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "是啊，我能理解你的不安。<br>\n但是，如果对身体有害的话就不好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "那、那个！今天我们要去野餐。<br>\n亚里沙要一起来吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema007"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "比起一个人胡思乱想，<br>\n和大家一起玩会更开心哦！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,ArmL2"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "……我考虑一下。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa008"]}},
    {"op": "HideAllCharacters", "line": 88, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "虽然亚里沙看起来很疲惫，<br>\n但对艾玛的态度明显温和了许多。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative006"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "（想和亚里沙变得更亲近。<br>\n　如果大家都能好好相处的话——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema009"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "（就再也不会发生凶杀案了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "我先过去了，<br>\n如果你愿意的话就来吧！我们等你！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Ema011"]}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "艾玛鼓起勇气说完，<br>\n便离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative007"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "——亚里沙被留在原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative008"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "她深深地叹了口气后，<br>\n仰望着天花板。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,ArmR7,ArmL2"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "……差不多该行动了吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa009"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "已经到极限了。<br>\n我已经——", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv08_Alisa010"]}},
