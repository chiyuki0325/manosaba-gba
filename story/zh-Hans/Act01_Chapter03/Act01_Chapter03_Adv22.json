    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛走进招待所之中<br>\n处于最外侧的【地精之室】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv22_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "由于火灾并未波及这里，<br>\n房间仍保持着原样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv22_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "在里面，<br>\n艾玛遇到了躺在床上的可可。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv22_Narrative003"]}},
