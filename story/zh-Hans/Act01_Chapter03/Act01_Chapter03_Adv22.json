    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "（时间不多了，去调查其他地方吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv22_Ema008"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "离开房间时，<br>\n艾玛回头看了可可一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv22_Narrative008"]}},
