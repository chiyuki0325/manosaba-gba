    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "可可，你在这里做什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv22_Ema001"]}},
