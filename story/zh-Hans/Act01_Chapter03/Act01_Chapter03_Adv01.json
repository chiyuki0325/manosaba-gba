  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook"}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-3-1", "line": 8, "indent": 0},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_9_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 16, "indent": 0, "params": {"Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 60.0], "AppearanceAndTransition": "5_2"}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.7999999523162842, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "WaitForNextFrame", "line": 20, "indent": 0, "params": {}},
    {"op": "AnimateActorExtended", "line": 22, "indent": 0, "params": {"ActorIds": ["MainBackground"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "——审判结束的第二天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "艾玛在早餐后的放风时间里，<br>\n将少女们召集到了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "存活的成员还剩：<br>\n艾玛、雪莉、汉娜、梅露露、玛格、可可、亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative003"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "再加上失踪的奈叶香，一共八人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative004"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "（被囚禁在这里还不到一个月……<br>\n　人数却在不断减少……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema001"]}},
    {"op": "HidePrinter", "line": 35, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 36, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_2", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "艾玛，你有什么事要说呢？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "啊，嗯。<br>\n我想讨论一下越狱的事。其实呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema002"]}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "艾玛正要从口袋里取出，昨晚在娱乐室的收纳柜里发现的<br>\n老旧的监牢设计图。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "哈～艾玛亲还是不长记性呢～<br>\n整天在吵什么“越狱越狱～！”，差点把命都搭进去了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Coco001"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "如果是为了这事才叫大家来，我可要退出了！<br>\n什么手牵手齐越狱的话题，我是一点兴趣都没有。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Coco002"]}},
    {"op": "HideAllCharacters", "line": 57, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "艾玛被泼了冷水，手上的动作也停住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "但、但是可可，你听我说……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema003"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "每次都给人无限期待，<br>\n结果却全是一团糟。<br>\n别再把我牵扯进去了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Coco003"]}},
    {"op": "HideAllCharacters", "line": 70, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "可可径直朝出口走去。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "等、等一下啊，可可！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema004"]}},
    {"op": "HideAllCharacters", "line": 78, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 79, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1,ArmR2,ArmL2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "你还不明白吗？<br>\n我就是不想和你一起行动。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Coco004"]}},
    {"op": "HideAllCharacters", "line": 83, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema005"]}},
    {"op": "HideAllCharacters", "line": 90, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Normal1,ArmR2,ArmL2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "啊，抱歉啊。这不是只针对你，<br>\n我只是已经不再相信任何人了。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Coco005"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "谁会在什么情况下起杀意都说不准，<br>\n独来独往才是最安全的。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Coco006"]}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "不会那样的……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema006"]}},
    {"op": "HideAllCharacters", "line": 102, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "艾玛挽留声显得软弱无力。<br>\n这时可可已经离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative008"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "当艾玛垂头丧气时，<br>\n玛格站到了她面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "很抱歉，但我也赞同可可的观点。<br>\n我认为最好避免过多的亲近。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo001"]}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "连玛格也……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema007"]}},
    {"op": "HideAllCharacters", "line": 117, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "关系越是亲密，就越容易滋生嫌隙，<br>\n不会有好结果的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo002"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "如果对他人的一丝违和感不断发酵，<br>\n最终演变成杀意的话——", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo003"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "我们还是保持距离比较好。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo004"]}},
    {"op": "HideAllCharacters", "line": 126, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR10,ArmL11", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "……这是说，<br>\n大家都应该单独行动比较好吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "就是这样呢。<br>\n——喂，艾玛，你总该认清事实了吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo005"]}},
    {"op": "HideAllCharacters", "line": 136, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "欸，认清什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema008"]}},
    {"op": "HideAllCharacters", "line": 141, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "我们之间根本没有什么感情。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo006"]}},
    {"op": "HideAllCharacters", "line": 146, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "——！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema009"]}},
    {"op": "HideAllCharacters", "line": 153, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "艾玛你也已经开始<br>\n不信任我了吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo007"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "如果对我没有好处，我是不会伸出援手的。<br>\n抱歉啦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Margo008"]}},
    {"op": "HideAllCharacters", "line": 160, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "虽然脸上挂着温柔的微笑，<br>\n但玛格的话语却无比残酷。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative010"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "艾玛的喉咙只能发出含糊的应声，<br>\n说不出任何反驳的话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative011"]}},
    {"op": "HideAllCharacters", "line": 166, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "（我们之间没有感情……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema010"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "（感情，<br>\n　只是我一厢情愿的幻想吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema011"]}},
    {"op": "HideAllCharacters", "line": 172, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmL2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "二阶堂、城崎、莲见、佐伯、夏目……<br>\n已经死了五个人了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Alisa001"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "……这教训还不够吗。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 179, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "连亚里沙也说出了冷漠的话。<br>\n玛格和亚里沙相继离开了房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative012"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "现场只剩下<br>\n雪莉、汉娜和梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema012"]}},
    {"op": "HideAllCharacters", "line": 189, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR2,ArmL4", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "…………", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 194, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 199, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "…………", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 204, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "谁都没有开口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative014"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "（该怎么办……必须说点什么……<br>\n　但是，我不知道该说什么好啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema013"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "（其他人可能也和可可、玛格<br>\n　想的一样）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema014"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "（觉得不该相信任何人，<br>\n　应该单打独斗……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema015"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "（孤身一人好可怕……好害怕……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema016"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "——就在这时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative015"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "雪莉轻轻握住了艾玛的手。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR11,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "艾玛，我们一起来吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry003"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "雪莉……？做、做什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema017"]}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR11,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "组建好朋友小组啊！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry004"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "雪莉挺起胸膛，满怀热情地宣布道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative017"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "被人批判一大通，你不会觉得不甘心吗！<br>\n明明我们都已经成为好朋友了，不是吗！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry005"]}},
    {"op": "ModifyCharacterExtended", "line": 235, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "嗯、嗯。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema018"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "那就让她们见识见识！！<br>\n我们绝对不会分开！！要永远做好朋友！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry006"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "看着笑容满面的雪莉，<br>\n艾玛的眼眶渐渐湿润。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative018"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "雪莉……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema019"]}},
    {"op": "HideAllCharacters", "line": 245, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "汉娜叉着腰，<br>\n深深地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR10,ArmL1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "真是的……不懂看气氛的人在这种时候，<br>\n反而让人觉得松了一口气呢……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna003"]}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "毕竟能毫不在意地<br>\n说出这么肉麻的话呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Pensive1,ArmR19,ArmL14", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "说肉麻也太过分了～！<br>\n我只是说出了心里话而已！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry007"]}},
    {"op": "ModifyCharacterExtended", "line": 260, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Flushed1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "我、<br>\n我可是在夸你啊……！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna005"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "完全感觉不到是在夸我！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 266, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1,ArmR3,ArmL3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "要夸人就该说“雪莉好可爱最喜欢了”，<br>\n“真了不起真厉害简直天才”之类的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry009"]}},
    {"op": "ModifyCharacterExtended", "line": 270, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "谁会说那种话啊！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna006"]}},
    {"op": "HideAllCharacters", "line": 274, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "梅露露看着开始争吵的两人，<br>\n一脸担忧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 278, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 280, "indent": 0, "params": {"Text": "那、那个，不是说要展示我们关系好吗……<br>\n吵、吵架是不好的……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Meruru002"]}},
    {"op": "HideAllCharacters", "line": 282, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 284, "indent": 0, "params": {"Text": "梅露露细弱的声音<br>\n似乎没有传到正在争执的两人耳中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 286, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "梅露露，她们两个这样反而说明关系很好哦。<br>\n说不定还能借此发泄压力呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema020"]}},
    {"op": "HideAllCharacters", "line": 290, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "是、是这样吗……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 295, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "（发泄压力……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema021"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "看着吵闹的两人，艾玛突然抬起头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 301, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "那、那个，大家听我说！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema022"]}},
    {"op": "HideAllCharacters", "line": 305, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "雪莉和汉娜终于停止了争吵，<br>\n看向艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 309, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "我还是觉得独自行动不是正确的选择。<br>\n和别人在一起才会更开心。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema023"]}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "一个人胡思乱想的话压力会越来越大，<br>\n这样其实不好。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema024"]}},
    {"op": "HideAllCharacters", "line": 315, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 316, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "说得对。<br>\n压力太大的话，可是会变成魔女的。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna007"]}},
    {"op": "HideAllCharacters", "line": 320, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 321, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR8,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 323, "indent": 0, "params": {"Text": "嗯。所以，让我们多做些开心的事吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema025"]}},
    {"op": "HideAllCharacters", "line": 325, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 326, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "开心的事，是指……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Meruru004"]}},
    {"op": "HideAllCharacters", "line": 330, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 331, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL7", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "如果这座监牢想让我们变成魔女，<br>\n那我们就不能如它所愿。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema026"]}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "虽然我还是想计划越狱……<br>\n但是适当放松也很重要。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema027"]}},
    {"op": "ModifyCharacterExtended", "line": 337, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile1,ArmR8,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "大家一起尽情玩乐吧！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema028"]}},
    {"op": "HideAllCharacters", "line": 341, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 342, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8,ArmL8", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 344, "indent": 0, "params": {"Text": "哦～好主意～！<br>\n还能向其他人展示我们关系有多好！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry010"]}},
    {"op": "HideAllCharacters", "line": 346, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 347, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "也、也是，这想法不错。<br>\n虽然我并不是特别想和你们组成什么好朋友小组啦。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna008"]}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "我们就按我们自己的方式来吧。<br>", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna009"]}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "不过……玩什么好呢？<br>\n艾玛应该有什么好主意吧？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Hanna010"]}},
    {"op": "HideAllCharacters", "line": 355, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "欸……那个……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema029"]}},
    {"op": "HideAllCharacters", "line": 360, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "艾玛一时语塞。<br>\n内心隐约升起一丝恐惧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative024"]}},
    {"op": "PrintTextModified", "line": 364, "indent": 0, "params": {"Text": "如果说出来冷场了怎么办，<br>\n如果让她们反感了怎么办。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative025"]}},
    {"op": "PrintTextModified", "line": 366, "indent": 0, "params": {"Text": "——不想被讨厌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative026"]}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "这样的内心呐喊清晰可闻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative027"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "对、对不起……想不出来……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema030"]}},
    {"op": "HideAllCharacters", "line": 374, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "艾玛最终低下头道歉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative028"]}},
    {"op": "PrintTextModified", "line": 378, "indent": 0, "params": {"Text": "这时梅露露怯生生地，难得地举起了手。<br>\n她应该是在担心陷入了尴尬的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 380, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 382, "indent": 0, "params": {"Text": "那、那、那个，<br>\n我们来办野餐，怎么样？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Meruru005"]}},
    {"op": "PrintTextModified", "line": 384, "indent": 0, "params": {"Text": "监牢外面很宽敞……<br>\n感觉大家能体验到出游的氛围。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Meruru006"]}},
    {"op": "HideAllCharacters", "line": 386, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 387, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8,ArmL8", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 389, "indent": 0, "params": {"Text": "哦！就这么办吧！<br>\n大家一起去野餐！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry011"]}},
    {"op": "HideAllCharacters", "line": 391, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 392, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 394, "indent": 0, "params": {"Text": "我、我来准备便当……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Meruru007"]}},
    {"op": "HideAllCharacters", "line": 396, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 397, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR10,ArmL1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 399, "indent": 0, "params": {"Text": "好朋友野餐大作战开始啦！<br>\n好开心～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Sherry012"]}},
    {"op": "HideAllCharacters", "line": 401, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 402, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL7", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 404, "indent": 0, "params": {"Text": "（大家一起野餐啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema031"]}},
    {"op": "PrintTextModified", "line": 406, "indent": 0, "params": {"Text": "艾玛将手放在胸前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative030"]}},
    {"op": "PrintTextModified", "line": 408, "indent": 0, "params": {"Text": "（最渴望这些时光的，<br>\n　大概是我吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema032"]}},
    {"op": "PrintTextModified", "line": 410, "indent": 0, "params": {"Text": "（只要能想像着快乐的时光，就还能继续坚持下去）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema033"]}},
    {"op": "ModifyCharacterExtended", "line": 412, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 414, "indent": 0, "params": {"Text": "（啊，说起来……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema034"]}},
    {"op": "HideAllCharacters", "line": 416, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 418, "indent": 0, "params": {"Text": "那张纸仍放在口袋里，<br>\n艾玛错过了拿出来的时机。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Narrative031"]}},
    {"op": "PrintTextModified", "line": 420, "indent": 0, "params": {"Text": "（这个……暂时就只留在我心里吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema035"]}},
    {"op": "PrintTextModified", "line": 422, "indent": 0, "params": {"Text": "（不能让大家抱有期待然后又牵扯进危险……<br>\n　等我更有把握再告诉大家吧）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv01_Ema036"]}},
    {"op": "Gosub", "line": 424, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 426, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv02", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv01_Narrative001": "——审判结束的第二天。",
  "0103Adv01_Narrative002": "艾玛在早餐后的放风时间里，<br>\n将少女们召集到了会客厅。",
  "0103Adv01_Narrative003": "存活的成员还剩：<br>\n艾玛、雪莉、汉娜、梅露露、玛格、可可、亚里沙。",
  "0103Adv01_Narrative004": "再加上失踪的奈叶香，一共八人。",
  "0103Adv01_Ema001": "（被囚禁在这里还不到一个月……<br>\n　人数却在不断减少……）",
  "0103Adv01_Hanna001": "艾玛，你有什么事要说呢？",
  "0103Adv01_Ema002": "啊，嗯。<br>\n我想讨论一下越狱的事。其实呢……",
  "0103Adv01_Narrative005": "艾玛正要从口袋里取出，昨晚在娱乐室的收纳柜里发现的<br>\n老旧的监牢设计图。",
  "0103Adv01_Coco001": "哈～艾玛亲还是不长记性呢～<br>\n整天在吵什么“越狱越狱～！”，差点把命都搭进去了。",
  "0103Adv01_Coco002": "如果是为了这事才叫大家来，我可要退出了！<br>\n什么手牵手齐越狱的话题，我是一点兴趣都没有。",
  "0103Adv01_Narrative006": "艾玛被泼了冷水，手上的动作也停住了。",
  "0103Adv01_Ema003": "但、但是可可，你听我说……",
  "0103Adv01_Coco003": "每次都给人无限期待，<br>\n结果却全是一团糟。<br>\n别再把我牵扯进去了。",
  "0103Adv01_Narrative007": "可可径直朝出口走去。<br>",
  "0103Adv01_Ema004": "等、等一下啊，可可！",
  "0103Adv01_Coco004": "你还不明白吗？<br>\n我就是不想和你一起行动。",
  "0103Adv01_Ema005": "……",
  "0103Adv01_Coco005": "啊，抱歉啊。这不是只针对你，<br>\n我只是已经不再相信任何人了。",
  "0103Adv01_Coco006": "谁会在什么情况下起杀意都说不准，<br>\n独来独往才是最安全的。",
  "0103Adv01_Ema006": "不会那样的……",
  "0103Adv01_Narrative008": "艾玛挽留声显得软弱无力。<br>\n这时可可已经离开了会客厅。",
  "0103Adv01_Narrative009": "当艾玛垂头丧气时，<br>\n玛格站到了她面前。",
  "0103Adv01_Margo001": "很抱歉，但我也赞同可可的观点。<br>\n我认为最好避免过多的亲近。",
  "0103Adv01_Ema007": "连玛格也……",
  "0103Adv01_Margo002": "关系越是亲密，就越容易滋生嫌隙，<br>\n不会有好结果的。",
  "0103Adv01_Margo003": "如果对他人的一丝违和感不断发酵，<br>\n最终演变成杀意的话——",
  "0103Adv01_Margo004": "我们还是保持距离比较好。",
  "0103Adv01_Sherry001": "……这是说，<br>\n大家都应该单独行动比较好吗？",
  "0103Adv01_Margo005": "就是这样呢。<br>\n——喂，艾玛，你总该认清事实了吧？",
  "0103Adv01_Ema008": "欸，认清什么……？",
  "0103Adv01_Margo006": "我们之间根本没有什么感情。",
  "0103Adv01_Ema009": "——！",
  "0103Adv01_Margo007": "艾玛你也已经开始<br>\n不信任我了吧？",
  "0103Adv01_Margo008": "如果对我没有好处，我是不会伸出援手的。<br>\n抱歉啦。",
  "0103Adv01_Narrative010": "虽然脸上挂着温柔的微笑，<br>\n但玛格的话语却无比残酷。",
  "0103Adv01_Narrative011": "艾玛的喉咙只能发出含糊的应声，<br>\n说不出任何反驳的话。",
  "0103Adv01_Ema010": "（我们之间没有感情……？）",
  "0103Adv01_Ema011": "（感情，<br>\n　只是我一厢情愿的幻想吗……？）",
  "0103Adv01_Alisa001": "二阶堂、城崎、莲见、佐伯、夏目……<br>\n已经死了五个人了。",
  "0103Adv01_Alisa002": "……这教训还不够吗。",
  "0103Adv01_Narrative012": "连亚里沙也说出了冷漠的话。<br>\n玛格和亚里沙相继离开了房间。",
  "0103Adv01_Narrative013": "现场只剩下<br>\n雪莉、汉娜和梅露露。",
  "0103Adv01_Ema012": "…………",
  "0103Adv01_Sherry002": "…………",
  "0103Adv01_Hanna002": "…………",
  "0103Adv01_Meruru001": "…………",
  "0103Adv01_Narrative014": "谁都没有开口。",
  "0103Adv01_Ema013": "（该怎么办……必须说点什么……<br>\n　但是，我不知道该说什么好啊……）",
  "0103Adv01_Ema014": "（其他人可能也和可可、玛格<br>\n　想的一样）",
  "0103Adv01_Ema015": "（觉得不该相信任何人，<br>\n　应该单打独斗……）",
  "0103Adv01_Ema016": "（孤身一人好可怕……好害怕……！）",
  "0103Adv01_Narrative015": "——就在这时。",
  "0103Adv01_Narrative016": "雪莉轻轻握住了艾玛的手。<br>",
  "0103Adv01_Sherry003": "艾玛，我们一起来吧！",
  "0103Adv01_Ema017": "雪莉……？做、做什么？",
  "0103Adv01_Sherry004": "组建好朋友小组啊！",
  "0103Adv01_Narrative017": "雪莉挺起胸膛，满怀热情地宣布道。",
  "0103Adv01_Sherry005": "被人批判一大通，你不会觉得不甘心吗！<br>\n明明我们都已经成为好朋友了，不是吗！？",
  "0103Adv01_Ema018": "嗯、嗯。",
  "0103Adv01_Sherry006": "那就让她们见识见识！！<br>\n我们绝对不会分开！！要永远做好朋友！！",
  "0103Adv01_Narrative018": "看着笑容满面的雪莉，<br>\n艾玛的眼眶渐渐湿润。",
  "0103Adv01_Ema019": "雪莉……",
  "0103Adv01_Narrative019": "汉娜叉着腰，<br>\n深深地叹了口气。",
  "0103Adv01_Hanna003": "真是的……不懂看气氛的人在这种时候，<br>\n反而让人觉得松了一口气呢……",
  "0103Adv01_Hanna004": "毕竟能毫不在意地<br>\n说出这么肉麻的话呢。",
  "0103Adv01_Sherry007": "说肉麻也太过分了～！<br>\n我只是说出了心里话而已！",
  "0103Adv01_Hanna005": "我、<br>\n我可是在夸你啊……！？",
  "0103Adv01_Sherry008": "完全感觉不到是在夸我！",
  "0103Adv01_Sherry009": "要夸人就该说“雪莉好可爱最喜欢了”，<br>\n“真了不起真厉害简直天才”之类的！",
  "0103Adv01_Hanna006": "谁会说那种话啊！！",
  "0103Adv01_Narrative020": "梅露露看着开始争吵的两人，<br>\n一脸担忧。",
  "0103Adv01_Meruru002": "那、那个，不是说要展示我们关系好吗……<br>\n吵、吵架是不好的……",
  "0103Adv01_Narrative021": "梅露露细弱的声音<br>\n似乎没有传到正在争执的两人耳中。",
  "0103Adv01_Ema020": "梅露露，她们两个这样反而说明关系很好哦。<br>\n说不定还能借此发泄压力呢。",
  "0103Adv01_Meruru003": "是、是这样吗……",
  "0103Adv01_Ema021": "（发泄压力……）",
  "0103Adv01_Narrative022": "看着吵闹的两人，艾玛突然抬起头。",
  "0103Adv01_Ema022": "那、那个，大家听我说！",
  "0103Adv01_Narrative023": "雪莉和汉娜终于停止了争吵，<br>\n看向艾玛。",
  "0103Adv01_Ema023": "我还是觉得独自行动不是正确的选择。<br>\n和别人在一起才会更开心。",
  "0103Adv01_Ema024": "一个人胡思乱想的话压力会越来越大，<br>\n这样其实不好。",
  "0103Adv01_Hanna007": "说得对。<br>\n压力太大的话，可是会变成魔女的。",
  "0103Adv01_Ema025": "嗯。所以，让我们多做些开心的事吧。",
  "0103Adv01_Meruru004": "开心的事，是指……？",
  "0103Adv01_Ema026": "如果这座监牢想让我们变成魔女，<br>\n那我们就不能如它所愿。",
  "0103Adv01_Ema027": "虽然我还是想计划越狱……<br>\n但是适当放松也很重要。",
  "0103Adv01_Ema028": "大家一起尽情玩乐吧！",
  "0103Adv01_Sherry010": "哦～好主意～！<br>\n还能向其他人展示我们关系有多好！",
  "0103Adv01_Hanna008": "也、也是，这想法不错。<br>\n虽然我并不是特别想和你们组成什么好朋友小组啦。",
  "0103Adv01_Hanna009": "我们就按我们自己的方式来吧。<br>",
  "0103Adv01_Hanna010": "不过……玩什么好呢？<br>\n艾玛应该有什么好主意吧？",
  "0103Adv01_Ema029": "欸……那个……",
  "0103Adv01_Narrative024": "艾玛一时语塞。<br>\n内心隐约升起一丝恐惧。",
  "0103Adv01_Narrative025": "如果说出来冷场了怎么办，<br>\n如果让她们反感了怎么办。",
  "0103Adv01_Narrative026": "——不想被讨厌。",
  "0103Adv01_Narrative027": "这样的内心呐喊清晰可闻。",
  "0103Adv01_Ema030": "对、对不起……想不出来……",
  "0103Adv01_Narrative028": "艾玛最终低下头道歉。",
  "0103Adv01_Narrative029": "这时梅露露怯生生地，难得地举起了手。<br>\n她应该是在担心陷入了尴尬的艾玛。",
  "0103Adv01_Meruru005": "那、那、那个，<br>\n我们来办野餐，怎么样？",
  "0103Adv01_Meruru006": "监牢外面很宽敞……<br>\n感觉大家能体验到出游的氛围。",
  "0103Adv01_Sherry011": "哦！就这么办吧！<br>\n大家一起去野餐！",
  "0103Adv01_Meruru007": "我、我来准备便当……！",
  "0103Adv01_Sherry012": "好朋友野餐大作战开始啦！<br>\n好开心～！",
  "0103Adv01_Ema031": "（大家一起野餐啊……）",
  "0103Adv01_Narrative030": "艾玛将手放在胸前。",
  "0103Adv01_Ema032": "（最渴望这些时光的，<br>\n　大概是我吧）",
  "0103Adv01_Ema033": "（只要能想像着快乐的时光，就还能继续坚持下去）",
  "0103Adv01_Ema034": "（啊，说起来……）",
  "0103Adv01_Narrative031": "那张纸仍放在口袋里，<br>\n艾玛错过了拿出来的时机。",
  "0103Adv01_Ema035": "（这个……暂时就只留在我心里吧）",
  "0103Adv01_Ema036": "（不能让大家抱有期待然后又牵扯进危险……<br>\n　等我更有把握再告诉大家吧）"
}
}
