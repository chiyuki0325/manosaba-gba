    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（有一座典狱长的雕像……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv21_Ema002"]}},
