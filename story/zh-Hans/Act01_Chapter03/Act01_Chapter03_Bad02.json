  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act01_Chapter03/Act01_Chapter03_Bad02",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-3-b2", "line": 8, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "40_1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 15, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_18_1_Loop", "IntroBgmPath": "Bgm_18_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "不要～！我不放～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "雪莉紧紧抱住汉娜，<br>\n贴得更紧了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "呀，怎么这样抱过来……<br>\n喘不过气了！你抱太紧了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "哇哇！请别晃得这么厉害。<br>\n好可怕啊～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "这不是我在晃……<br>\n是你太重了……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna002"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "汉娜独自支撑着雪莉的手臂<br>\n正在微微颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "想要返回，却发现不知不觉间<br>\n已经离艾玛和梅露露所在的地方很远了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "我们就这样，找个合适的地方<br>\n降落吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "我已经……撑不住了……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna003"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "欸？哇啊……！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry004"]}},
    {"op": "StopBgm", "line": 40, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 42, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PlaySfxModified", "line": 45, "indent": 0, "params": {"SfxPath": "Sfx_23", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "突然，汉娜的魔法解除了，<br>\n两人掉进了下面的灌木丛中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative004"]}},
    {"op": "ResetText", "line": 49, "indent": 0, "params": {}},
    {"op": "HideActors", "line": 51, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 52, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "16_1"}},
    {"op": "ModifyBackgroundExtended", "line": 53, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 54, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 56, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "幸运的是，由于飞行高度不高，<br>\n似乎没有受什么严重的伤。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "雪莉愉快的笑声在蓝天下回荡。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "啊哈哈！真有趣～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry005"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "觉得有趣的……呼、呼……<br>\n只有你一个人……呼、呼……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna004"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "汉娜躺在地上急促地喘着气，<br>\n不满地瞪着雪莉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Default", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "汉娜，看来你一时半会站不起来呢～<br>\n我们在这里休息一会吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry006"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "你……可以先回去的！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna005"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "那怎么行呢～<br>\n毕竟是我提议要骑扫帚的呀。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 81, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "雪莉躺在汉娜身边，<br>\n深深地吸了一口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative008"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "哈～……这里真是个舒服的地方呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry008"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "嗯……确实不错呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna006"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "多亏了汉娜，<br>\n我们才能找到这么好的地方。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry009"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "我、我可不是……自己想来的……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna007"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "好啦好啦，别在意这些小事嘛！<br>\n毕竟现在心情这么好！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry010"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "……确实，感觉还不错呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna008"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "雪莉和汉娜享受着宁静的时光，<br>\n仿佛忘了身处监牢之中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "这时，雪莉突然像是想到了什么，<br>\n开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "我们就这样两个人<br>\n有多远跑多远怎么样？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry011"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "你在说什么呀？<br>\n那怎么行呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna009"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "为什么不行呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry012"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "为什么……就算逃跑，<br>\n很快就会被看守抓住的吧。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna010"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "那就逃到它们抓不到的地方去啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry013"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "逃到，抓不到的地方……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna011"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "世界可是非～常广阔的。<br>\n说不定真的有那样的地方哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry014"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "听到雪莉的话，汉娜睁大了眼睛。<br>\n眼中闪烁着惊讶和一丝期待。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "如果是汉娜和我的话，也许真的可以。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry015"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "雪莉轻轻地触碰了汉娜的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative012"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "……你真的，这么认为吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna012"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "凡事都要试试看才知道嘛。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry016"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "面对温柔微笑的雪莉，<br>\n汉娜的眼神更加动摇了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "说不定，其实有办法逃出这里，<br>\n只是大家都不知道而已。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry017"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "也许我们甚至不用成为魔女。<br>\n……我想去寻找那样的未来。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry018"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "是啊。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna013"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "汉娜露出一个<br>\n仿佛随时都会哭出来的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "只有你一个人的话我会担心的……<br>\n我也跟你一起去。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna014"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "好！<br>\n一起获得自由吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry019"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "不管那是多么渺茫的希望，<br>\n她们也无法不去追寻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative015"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "这个环境已经将两人逼到了绝境，<br>\n让她们疲惫不堪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative016"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "啊，但是……那两个人……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna015"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "似乎明白汉娜指的是艾玛和梅露露，<br>\n雪莉露出了更加温柔的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative017"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "等我们获得自由，<br>\n找到安身之处后，就来接她们吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry020"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "不只是艾玛和梅露露，<br>\n还要接上所有幸存下来的人！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry021"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "然后，我们大家一起去野餐。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry022"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "每个人带上装满自己喜欢的食物的便当，<br>\n去温暖又阳光明媚的地方。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Sherry023"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "……这主意真不错呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna016"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "那，走吧。<br>\n我们一起……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Hanna017"]}},
    {"op": "HideAllCharacters", "line": 159, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "雪莉和汉娜站了起来，牵起彼此的手，<br>\n相信梦想终会成真。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative018"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "此时，一滴泪水从汉娜的脸颊滑落，<br>\n被柔和的风带走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative019"]}},
    {"op": "ModifyBackgroundExtended", "line": 165, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "过了一会——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative020"]}},
    {"op": "ResetText", "line": 169, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 171, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "ModifyBackgroundExtended", "line": 172, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 173, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "雪莉～！汉娜～！<br>\n你们在哪里啊～？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Ema001"]}},
    {"op": "HideAllCharacters", "line": 179, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "我们很担心你们。请回答一下～", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 184, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "艾玛和梅露露来寻找<br>\n雪莉和汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "完全找不到她们……<br>\n如果我能飞的话，就不会这样了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Meruru002"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "这不是梅露露的错！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Ema002"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "说不定，她们从扫帚上下来后<br>\n躲在哪里了吧？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Ema003"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "你想啊，雪莉感觉就<br>\n很喜欢玩这种游戏。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "躲起来……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Meruru003"]}},
    {"op": "ModifyCharacterExtended", "line": 203, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "对啊，所以我们再多找找吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "好的！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Meruru004"]}},
    {"op": "ModifyBackgroundExtended", "line": 211, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "然而，无论她们怎么寻找，<br>\n都再也没有找到雪莉和汉娜——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative022"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "从此以后，艾玛她们<br>\n再也没有见到过这两个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Bad02_Narrative023"]}},
    {"op": "ProcessBadEnd", "line": 221, "indent": 0, "params": {"Number": 12}}
  ],
  "translations": {
  "0103Bad02_Sherry001": "不要～！我不放～！",
  "0103Bad02_Narrative001": "雪莉紧紧抱住汉娜，<br>\n贴得更紧了。",
  "0103Bad02_Hanna001": "呀，怎么这样抱过来……<br>\n喘不过气了！你抱太紧了！",
  "0103Bad02_Sherry002": "哇哇！请别晃得这么厉害。<br>\n好可怕啊～",
  "0103Bad02_Hanna002": "这不是我在晃……<br>\n是你太重了……",
  "0103Bad02_Narrative002": "汉娜独自支撑着雪莉的手臂<br>\n正在微微颤抖。",
  "0103Bad02_Narrative003": "想要返回，却发现不知不觉间<br>\n已经离艾玛和梅露露所在的地方很远了。",
  "0103Bad02_Sherry003": "我们就这样，找个合适的地方<br>\n降落吧！",
  "0103Bad02_Hanna003": "我已经……撑不住了……！",
  "0103Bad02_Sherry004": "欸？哇啊……！",
  "0103Bad02_Narrative004": "突然，汉娜的魔法解除了，<br>\n两人掉进了下面的灌木丛中。",
  "0103Bad02_Narrative005": "幸运的是，由于飞行高度不高，<br>\n似乎没有受什么严重的伤。",
  "0103Bad02_Narrative006": "雪莉愉快的笑声在蓝天下回荡。",
  "0103Bad02_Sherry005": "啊哈哈！真有趣～！",
  "0103Bad02_Hanna004": "觉得有趣的……呼、呼……<br>\n只有你一个人……呼、呼……",
  "0103Bad02_Narrative007": "汉娜躺在地上急促地喘着气，<br>\n不满地瞪着雪莉。",
  "0103Bad02_Sherry006": "汉娜，看来你一时半会站不起来呢～<br>\n我们在这里休息一会吧。",
  "0103Bad02_Hanna005": "你……可以先回去的！",
  "0103Bad02_Sherry007": "那怎么行呢～<br>\n毕竟是我提议要骑扫帚的呀。",
  "0103Bad02_Narrative008": "雪莉躺在汉娜身边，<br>\n深深地吸了一口气。",
  "0103Bad02_Sherry008": "哈～……这里真是个舒服的地方呢。",
  "0103Bad02_Hanna006": "嗯……确实不错呢。",
  "0103Bad02_Sherry009": "多亏了汉娜，<br>\n我们才能找到这么好的地方。",
  "0103Bad02_Hanna007": "我、我可不是……自己想来的……",
  "0103Bad02_Sherry010": "好啦好啦，别在意这些小事嘛！<br>\n毕竟现在心情这么好！",
  "0103Bad02_Hanna008": "……确实，感觉还不错呢。",
  "0103Bad02_Narrative009": "雪莉和汉娜享受着宁静的时光，<br>\n仿佛忘了身处监牢之中。",
  "0103Bad02_Narrative010": "这时，雪莉突然像是想到了什么，<br>\n开口说道。",
  "0103Bad02_Sherry011": "我们就这样两个人<br>\n有多远跑多远怎么样？",
  "0103Bad02_Hanna009": "你在说什么呀？<br>\n那怎么行呢。",
  "0103Bad02_Sherry012": "为什么不行呢？",
  "0103Bad02_Hanna010": "为什么……就算逃跑，<br>\n很快就会被看守抓住的吧。",
  "0103Bad02_Sherry013": "那就逃到它们抓不到的地方去啊。",
  "0103Bad02_Hanna011": "逃到，抓不到的地方……",
  "0103Bad02_Sherry014": "世界可是非～常广阔的。<br>\n说不定真的有那样的地方哦？",
  "0103Bad02_Narrative011": "听到雪莉的话，汉娜睁大了眼睛。<br>\n眼中闪烁着惊讶和一丝期待。",
  "0103Bad02_Sherry015": "如果是汉娜和我的话，也许真的可以。",
  "0103Bad02_Narrative012": "雪莉轻轻地触碰了汉娜的手。",
  "0103Bad02_Hanna012": "……你真的，这么认为吗？",
  "0103Bad02_Sherry016": "凡事都要试试看才知道嘛。",
  "0103Bad02_Narrative013": "面对温柔微笑的雪莉，<br>\n汉娜的眼神更加动摇了。",
  "0103Bad02_Sherry017": "说不定，其实有办法逃出这里，<br>\n只是大家都不知道而已。",
  "0103Bad02_Sherry018": "也许我们甚至不用成为魔女。<br>\n……我想去寻找那样的未来。",
  "0103Bad02_Hanna013": "是啊。",
  "0103Bad02_Narrative014": "汉娜露出一个<br>\n仿佛随时都会哭出来的微笑。",
  "0103Bad02_Hanna014": "只有你一个人的话我会担心的……<br>\n我也跟你一起去。",
  "0103Bad02_Sherry019": "好！<br>\n一起获得自由吧！",
  "0103Bad02_Narrative015": "不管那是多么渺茫的希望，<br>\n她们也无法不去追寻。",
  "0103Bad02_Narrative016": "这个环境已经将两人逼到了绝境，<br>\n让她们疲惫不堪。",
  "0103Bad02_Hanna015": "啊，但是……那两个人……",
  "0103Bad02_Narrative017": "似乎明白汉娜指的是艾玛和梅露露，<br>\n雪莉露出了更加温柔的微笑。",
  "0103Bad02_Sherry020": "等我们获得自由，<br>\n找到安身之处后，就来接她们吧。",
  "0103Bad02_Sherry021": "不只是艾玛和梅露露，<br>\n还要接上所有幸存下来的人！",
  "0103Bad02_Sherry022": "然后，我们大家一起去野餐。",
  "0103Bad02_Sherry023": "每个人带上装满自己喜欢的食物的便当，<br>\n去温暖又阳光明媚的地方。",
  "0103Bad02_Hanna016": "……这主意真不错呢。",
  "0103Bad02_Hanna017": "那，走吧。<br>\n我们一起……",
  "0103Bad02_Narrative018": "雪莉和汉娜站了起来，牵起彼此的手，<br>\n相信梦想终会成真。",
  "0103Bad02_Narrative019": "此时，一滴泪水从汉娜的脸颊滑落，<br>\n被柔和的风带走了。",
  "0103Bad02_Narrative020": "过了一会——",
  "0103Bad02_Ema001": "雪莉～！汉娜～！<br>\n你们在哪里啊～？",
  "0103Bad02_Meruru001": "我们很担心你们。请回答一下～",
  "0103Bad02_Narrative021": "艾玛和梅露露来寻找<br>\n雪莉和汉娜。",
  "0103Bad02_Meruru002": "完全找不到她们……<br>\n如果我能飞的话，就不会这样了……",
  "0103Bad02_Ema002": "这不是梅露露的错！",
  "0103Bad02_Ema003": "说不定，她们从扫帚上下来后<br>\n躲在哪里了吧？",
  "0103Bad02_Ema004": "你想啊，雪莉感觉就<br>\n很喜欢玩这种游戏。",
  "0103Bad02_Meruru003": "躲起来……？",
  "0103Bad02_Ema005": "对啊，所以我们再多找找吧。",
  "0103Bad02_Meruru004": "好的！",
  "0103Bad02_Narrative022": "然而，无论她们怎么寻找，<br>\n都再也没有找到雪莉和汉娜——",
  "0103Bad02_Narrative023": "从此以后，艾玛她们<br>\n再也没有见到过这两个人。"
}
}
