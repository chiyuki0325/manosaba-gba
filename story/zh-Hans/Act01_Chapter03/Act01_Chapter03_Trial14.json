  "path": "Act01_Chapter03/Act01_Chapter03_Trial14",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "Version": 4}},
    {"op": "SetCustomVariable", "line": 2, "indent": 0, "params": {"Expression": "isReenact = true"}},
    {"op": "ModifyTextPrinter", "line": 3, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Gosub", "line": 4, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Judge3-14-1", "line": 11, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 14, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 22, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S01", "Wait": 0}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "那是昨天晚上发生的事。<br>\n雪莉杀死了汉娜。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "精心策划的杀人计划，才刚刚开始。<br>\n没错！一切都在计划之中。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry002"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "雪莉之前看到监牢的设计图时，<br>\n就想到了调换招待所的诡计。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry003"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "然后，她听说玛格<br>\n要进行魔法实验，<br>\n于是便决定实施计划。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry004"]}},
    {"op": "ResetText", "line": 35, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 36, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 37, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 43, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S02", "Wait": 0}},
    {"op": "Wait", "line": 44, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "首先，雪莉把汉娜<br>\n叫到招待所，<br>\n用绳子勒死了她。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry005"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "之后雪莉伪装出自杀现场，<br>\n把汉娜的尸体吊了起来。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry006"]}},
    {"op": "ResetText", "line": 50, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 51, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S02", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 52, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 55, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S01", "Wait": 0}},
    {"op": "Wait", "line": 56, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "为了配合魔法实验的氛围，<br>\n她在周围还准备了上吊同样的人偶。<br>\n误导的效果还挺不错吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry007"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "然后在玛格她们开始实验时，<br>\n雪莉悄悄溜了出去。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry008"]}},
    {"op": "ResetText", "line": 62, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 63, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 64, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 68, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S03", "Wait": 0}},
    {"op": "Wait", "line": 69, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "之后，她去找奈叶香了。<br>\n这是为了给自己准备一个保险，万一受怀疑也有办法开脱。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry009"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "雪莉在黑暗中袭击了奈叶香。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry010"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "奈叶香进行了反击，<br>\n但正如雪莉所料，子弹大幅偏离了目标。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry011"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "雪莉早就知道了。<br>\n奈叶香是个温柔的人，<br>\n不可能真的向同伴开枪。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry012"]}},
    {"op": "ResetText", "line": 79, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 80, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S03", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 81, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 86, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S04", "Wait": 0}},
    {"op": "Wait", "line": 87, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "之后雪莉<br>\n进行了两个房间的调换。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry013"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "招待所的建筑是临时建设的，<br>\n基础也不牢固，这些她都事先确认过了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry014"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "但是因为周围太黑了，她把建筑物放在石砖地面上时，<br>\n似乎不小心压坏了一些红色的花。唉～<br>", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry015"]}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "调换完成后，只需要交换门牌就大功告成了。<br>\n因为移动时的晃动，<br>\n房间里变得有点凌乱呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry016"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "对雪莉来说，<br>\n用于魔法实验的亚里沙的<br>\n人偶还留在那里，这也是个意外。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry017"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "用完之后要记得收拾干净哦。<br>\n不然，制造密室的凶手会很头疼的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry018"]}},
    {"op": "ResetText", "line": 101, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 102, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S04", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 103, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 108, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S05", "Wait": 0}},
    {"op": "Wait", "line": 109, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "之后，雪莉设置了一个<br>\n延时点火的火焰机关。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry019"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "使用蜡烛和浸油的绳子，<br>\n等蜡烛变小后<br>\n就会自动引燃。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry020"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "但是如果烧得太厉害全部烧光就不好了，<br>\n所以还是适当调整了一下燃烧的程度。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry021"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "如果在完全烧尽之前没有被发现，<br>\n精心设计的密室诡计就白费了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry022"]}},
    {"op": "ResetText", "line": 119, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 120, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S05", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 121, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 125, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S06", "Wait": 0}},
    {"op": "Wait", "line": 126, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "然后她等了一会，等到天亮后，<br>\n用箭刺伤了自己的脚。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry023"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "虽然非常痛，<br>\n但雪莉毫不犹豫。<br>\n因为力气比较大，一下子就刺穿了呢！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry024"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "雪莉假装子弹打到了腿，<br>\n让梅露露进行了检查。<br>\n这样就完成了无法行动的不在场证明！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry025"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "就这样，雪莉成功地<br>\n上演了一出戏剧性的汉娜凶杀案！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry026"]}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "……皆大欢喜，皆大欢喜。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Trial14_Sherry027"]}},
    {"op": "ResetText", "line": 138, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 139, "indent": 0, "params": {"Path": "Reenact_Ch01_E03_S06", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 140, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "SetCustomVariable", "line": 142, "indent": 0, "params": {"Expression": "isReenact = false"}},
    {"op": "Gosub", "line": 143, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 145, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv27", "SoftReset": 1}}
  ],
  "translations": {
  "0103Trial14_Sherry001": "那是昨天晚上发生的事。<br>\n雪莉杀死了汉娜。",
  "0103Trial14_Sherry002": "精心策划的杀人计划，才刚刚开始。<br>\n没错！一切都在计划之中。",
  "0103Trial14_Sherry003": "雪莉之前看到监牢的设计图时，<br>\n就想到了调换招待所的诡计。",
  "0103Trial14_Sherry004": "然后，她听说玛格<br>\n要进行魔法实验，<br>\n于是便决定实施计划。",
  "0103Trial14_Sherry005": "首先，雪莉把汉娜<br>\n叫到招待所，<br>\n用绳子勒死了她。",
  "0103Trial14_Sherry006": "之后雪莉伪装出自杀现场，<br>\n把汉娜的尸体吊了起来。",
  "0103Trial14_Sherry007": "为了配合魔法实验的氛围，<br>\n她在周围还准备了上吊同样的人偶。<br>\n误导的效果还挺不错吧？",
  "0103Trial14_Sherry008": "然后在玛格她们开始实验时，<br>\n雪莉悄悄溜了出去。",
  "0103Trial14_Sherry009": "之后，她去找奈叶香了。<br>\n这是为了给自己准备一个保险，万一受怀疑也有办法开脱。",
  "0103Trial14_Sherry010": "雪莉在黑暗中袭击了奈叶香。",
  "0103Trial14_Sherry011": "奈叶香进行了反击，<br>\n但正如雪莉所料，子弹大幅偏离了目标。",
  "0103Trial14_Sherry012": "雪莉早就知道了。<br>\n奈叶香是个温柔的人，<br>\n不可能真的向同伴开枪。",
  "0103Trial14_Sherry013": "之后雪莉<br>\n进行了两个房间的调换。",
  "0103Trial14_Sherry014": "招待所的建筑是临时建设的，<br>\n基础也不牢固，这些她都事先确认过了。",
  "0103Trial14_Sherry015": "但是因为周围太黑了，她把建筑物放在石砖地面上时，<br>\n似乎不小心压坏了一些红色的花。唉～<br>",
  "0103Trial14_Sherry016": "调换完成后，只需要交换门牌就大功告成了。<br>\n因为移动时的晃动，<br>\n房间里变得有点凌乱呢。",
  "0103Trial14_Sherry017": "对雪莉来说，<br>\n用于魔法实验的亚里沙的<br>\n人偶还留在那里，这也是个意外。",
  "0103Trial14_Sherry018": "用完之后要记得收拾干净哦。<br>\n不然，制造密室的凶手会很头疼的。",
  "0103Trial14_Sherry019": "之后，雪莉设置了一个<br>\n延时点火的火焰机关。",
  "0103Trial14_Sherry020": "使用蜡烛和浸油的绳子，<br>\n等蜡烛变小后<br>\n就会自动引燃。",
  "0103Trial14_Sherry021": "但是如果烧得太厉害全部烧光就不好了，<br>\n所以还是适当调整了一下燃烧的程度。",
  "0103Trial14_Sherry022": "如果在完全烧尽之前没有被发现，<br>\n精心设计的密室诡计就白费了！",
  "0103Trial14_Sherry023": "然后她等了一会，等到天亮后，<br>\n用箭刺伤了自己的脚。",
  "0103Trial14_Sherry024": "虽然非常痛，<br>\n但雪莉毫不犹豫。<br>\n因为力气比较大，一下子就刺穿了呢！",
  "0103Trial14_Sherry025": "雪莉假装子弹打到了腿，<br>\n让梅露露进行了检查。<br>\n这样就完成了无法行动的不在场证明！",
  "0103Trial14_Sherry026": "就这样，雪莉成功地<br>\n上演了一出戏剧性的汉娜凶杀案！",
  "0103Trial14_Sherry027": "……皆大欢喜，皆大欢喜。"
}
}
