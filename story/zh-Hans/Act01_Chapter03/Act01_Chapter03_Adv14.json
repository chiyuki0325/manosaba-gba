  "path": "Act01_Chapter03/Act01_Chapter03_Adv14",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-3-14", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlaySfxModified", "line": 15, "indent": 0, "params": {"SfxPath": "Sfx_61", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 16, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlaySfxModified", "line": 17, "indent": 0, "params": {"SfxPath": "Sfx_61", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "——轰隆轰隆。<br>\n此时响起一阵巨大声响，足以震动整座监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative001"]}},
    {"op": "PlayBgm", "line": 21, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "嗯……怎么了……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "艾玛微微睁开眼睛。<br>\n她正躺在已经熟悉的地下牢房的床上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative002"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "地震……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "艾、艾玛！<br>\n出、出大事了～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 33, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "汉娜冲进了<br>\n艾玛的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "啊，汉娜早上好……<br>\n这声音是什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema003"]}},
    {"op": "HideAllCharacters", "line": 41, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "是雪莉！<br>\n雪莉在闹事～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 46, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "欸！？<br>\n为、为什么！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema004"]}},
    {"op": "HideAllCharacters", "line": 51, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "艾玛一下子清醒了过来，<br>\n慌忙下了床。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "那个猩猩女！<br>\n我就知道她迟早会失控！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna003"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "闹事能解决什么啊，<br>\n根本不可能嘛！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna004"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "居然想要破坏监牢，<br>\n说不定会被看守杀掉的！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna005"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "哪里像个头脑派侦探啊～！<br>\n脑子里根本全都是肌肉～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna006"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "汉娜似乎也陷入了恐慌，<br>\n眼睛转来转去，慌乱不已。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative005"]}},
    {"op": "HideAllCharacters", "line": 67, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "汉娜，冷静点……<br>\n总之，我们得去阻止她！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema005"]}},
    {"op": "StopBgm", "line": 72, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 73, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "艾玛和汉娜<br>\n跌跌撞撞地冲出牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative006"]}},
    {"op": "ResetText", "line": 77, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 78, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 79, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 81, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "12_1"}},
    {"op": "ModifyBackgroundExtended", "line": 82, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 83, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PlayBgm", "line": 85, "indent": 0, "params": {"BgmPath": "Bgm_26_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "宅邸内的过道上，窗户破碎，<br>\n墙壁被打穿，一片狼藉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative007"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "目前的巨响是从图书室方向传来的。<br>\n艾玛和汉娜冲了进去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative008"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "深处的书架像多米诺骨牌一样倒下，<br>\n宛如地震后的景象。<br>\n书本散落一地，一片混乱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR8"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "啊，艾玛、汉娜，<br>\n早上好啊。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "雪莉仿佛什么事都没发生似的，<br>\n笑眯眯地打招呼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "你、你到底在想什么！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna007"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "是啊雪莉，<br>\n把监牢大宅弄得一团糟，<br>\n你到底想干什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema006"]}},
    {"op": "HideAllCharacters", "line": 108, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR13"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "雪莉得意地竖起食指。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative011"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "你想，不是经常有那种情况吗，<br>\n移动书架就会出现暗室的开关。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR17"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "我就在想会不会有这种东西，<br>\n所以在找找看。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 120, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "就算这样，<br>\n这么闹也会被看守抓去惩罚室的！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna008"]}},
    {"op": "HideAllCharacters", "line": 125, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "规定里没说不能破坏监牢内部，<br>\n所以没问题哦。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 130, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 131, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "那是因为<br>\n只有你这种人才能做出这种破坏行为吧。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna009"]}},
    {"op": "HideAllCharacters", "line": 135, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "（……不过，看守确实没来。<br>\n　平时的话应该立刻就会赶到的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema007"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "（或许只要没违反规定，<br>\n　做任何事都是受允许的……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema008"]}},
    {"op": "HideAllCharacters", "line": 141, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "就算是这样，也有可能会被惩罚的。<br>\n我觉得还是不该这样做……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema009"]}},
    {"op": "PlaySfxModified", "line": 147, "indent": 0, "params": {"SfxPath": "Sfx_177", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 149, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "雪莉完全不听劝，<br>\n继续她的破坏行动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative012"]}},
    {"op": "HideAllCharacters", "line": 153, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "你就不能安分一点吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna010"]}},
    {"op": "HideAllCharacters", "line": 158, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR8"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "不想再安分了。<br>\n大家似乎都已经到极限了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 163, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "呃……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema010"]}},
    {"op": "HideAllCharacters", "line": 168, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR8"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "汉娜和艾玛<br>\n也感觉到了那种氛围吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry006"]}},
    {"op": "HideAllCharacters", "line": 173, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "艾玛沉默了。<br>\n雪莉说的话，她有头绪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative013"]}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "（像着了魔似地<br>\n　一直在看书的玛格……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema011"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "（逃避现实，<br>\n　沉浸在妄想世界里的可可……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema012"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "（而且最主要的是——梅露露,<br>\n　她竟然会哭成那样）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema013"]}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "（雪莉说得对，<br>\n　大家都已经快到极限了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR8"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "我想要反抗，<br>\n不想什么都做不了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 189, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 190, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "可是闹事也是……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna011"]}},
    {"op": "HideAllCharacters", "line": 194, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 195, "indent": 0, "params": {"SfxPath": "Sfx_177", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "雪莉充耳不闻，<br>\n只管继续破坏图书室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative014"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "汉娜和艾玛目前<br>\n只能旁观着这一切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "我也……讨厌这样……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna012"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "但是，做这种事情，<br>\n什么都改变不了啊……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna013"]}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "站在一旁的汉娜握紧拳头，颤抖着。<br>\n眼角泛着泪光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative016"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "你这个笨蛋。<br>\n真是个笨蛋……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna014"]}},
    {"op": "HideAllCharacters", "line": 211, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 212, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Angry1,ArmR10"}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "怎么把天才说成是笨蛋呢～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 216, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "肌肉笨蛋，不识空气的臭女人。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna015"]}},
    {"op": "HideAllCharacters", "line": 221, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR10"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "偶尔也夸夸我嘛！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry009"]}},
    {"op": "HideAllCharacters", "line": 226, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 227, "indent": 0, "params": {"SfxPath": "Sfx_177", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "即使破坏书架，<br>\n也找不到能逃脱的线索。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative017"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "（太令人心痛了，雪莉……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema015"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "（雪莉也是被压力击垮了吗……<br>\n　不，这么说的话）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema016"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "（可可、玛格、梅露露、<br>\n　亚里沙、汉娜也是）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema017"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "（连我也是——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema018"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "（可能会变成魔女——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema019"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "意识到这个显而易见的事实时，<br>\n艾玛感觉脚下一阵晃动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative018"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "——太过分了！", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Margo001"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "突然，一声悲痛的叫喊在图书室内响起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Surprised1"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "玛格察觉到骚动赶来了。<br>\n她慌忙跑向散落的书本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative020"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "艾玛她们都愣住了。<br>\n她们第一次看到玛格如此慌张。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 253, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "玛格把书本都收拢到身边，<br>\n深深地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Surprised1"}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "这里的书写着非常重要的内容。<br>\n希望你们能好好珍惜。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 261, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Smile1,ArmR7,ArmL5"}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "啊太好了，书没事……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Margo003"]}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "玛格似乎找到了想要的书，<br>\n小心翼翼地抱在胸前松了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 271, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR7,ArmL5"}},
    {"op": "PrintTextModified", "line": 273, "indent": 0, "params": {"Text": "本想着大家可能会想看，我才放在这里的。<br>\n看来我还是应该把它放在自己身边。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Margo004"]}},
    {"op": "HideAllCharacters", "line": 275, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 276, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 278, "indent": 0, "params": {"Text": "……那是之前给我们看的那本书吧？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry010"]}},
    {"op": "HideAllCharacters", "line": 280, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1,ArmR7,ArmL5"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "是的，这是非常重要的书。<br>\n我打算用这本书上记载的内容进行实验，<br>\n不，是举行仪式。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Margo005"]}},
    {"op": "HideAllCharacters", "line": 285, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 286, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Surprised1,ArmR10"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "仪式！？要做什么！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Sherry011"]}},
    {"op": "HideAllCharacters", "line": 290, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 291, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR7,ArmL5"}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "……我不想告诉你们。<br>\n失陪了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Margo006"]}},
    {"op": "HideAllCharacters", "line": 295, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "玛格冷冷地说完就离开了。<br>\n艾玛和汉娜面面相觑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 299, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "她是不是觉得我们也是搞乱图书室的帮凶……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Ema020"]}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "太糟糕了！我明明什么都没做！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna016"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "雪莉你到底要给我们添多少麻烦啊！？<br>\n快来收拾！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Hanna017"]}},
    {"op": "HideAllCharacters", "line": 308, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "汉娜一边抱怨一边开始捡拾书本。<br>\n艾玛也加入了整理工作。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv14_Narrative025"]}},
    {"op": "Gosub", "line": 312, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 314, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv15", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv14_Narrative001": "——轰隆轰隆。<br>\n此时响起一阵巨大声响，足以震动整座监牢。",
  "0103Adv14_Ema001": "嗯……怎么了……？",
  "0103Adv14_Narrative002": "艾玛微微睁开眼睛。<br>\n她正躺在已经熟悉的地下牢房的床上。",
  "0103Adv14_Ema002": "地震……？",
  "0103Adv14_Hanna001": "艾、艾玛！<br>\n出、出大事了～！",
  "0103Adv14_Narrative003": "汉娜冲进了<br>\n艾玛的牢房。",
  "0103Adv14_Ema003": "啊，汉娜早上好……<br>\n这声音是什么……？",
  "0103Adv14_Hanna002": "是雪莉！<br>\n雪莉在闹事～！",
  "0103Adv14_Ema004": "欸！？<br>\n为、为什么！？",
  "0103Adv14_Narrative004": "艾玛一下子清醒了过来，<br>\n慌忙下了床。",
  "0103Adv14_Hanna003": "那个猩猩女！<br>\n我就知道她迟早会失控！",
  "0103Adv14_Hanna004": "闹事能解决什么啊，<br>\n根本不可能嘛！",
  "0103Adv14_Hanna005": "居然想要破坏监牢，<br>\n说不定会被看守杀掉的！",
  "0103Adv14_Hanna006": "哪里像个头脑派侦探啊～！<br>\n脑子里根本全都是肌肉～！",
  "0103Adv14_Narrative005": "汉娜似乎也陷入了恐慌，<br>\n眼睛转来转去，慌乱不已。",
  "0103Adv14_Ema005": "汉娜，冷静点……<br>\n总之，我们得去阻止她！",
  "0103Adv14_Narrative006": "艾玛和汉娜<br>\n跌跌撞撞地冲出牢房。",
  "0103Adv14_Narrative007": "宅邸内的过道上，窗户破碎，<br>\n墙壁被打穿，一片狼藉。",
  "0103Adv14_Narrative008": "目前的巨响是从图书室方向传来的。<br>\n艾玛和汉娜冲了进去。",
  "0103Adv14_Narrative009": "深处的书架像多米诺骨牌一样倒下，<br>\n宛如地震后的景象。<br>\n书本散落一地，一片混乱。",
  "0103Adv14_Sherry001": "啊，艾玛、汉娜，<br>\n早上好啊。",
  "0103Adv14_Narrative010": "雪莉仿佛什么事都没发生似的，<br>\n笑眯眯地打招呼。",
  "0103Adv14_Hanna007": "你、你到底在想什么！",
  "0103Adv14_Ema006": "是啊雪莉，<br>\n把监牢大宅弄得一团糟，<br>\n你到底想干什么？",
  "0103Adv14_Narrative011": "雪莉得意地竖起食指。<br>",
  "0103Adv14_Sherry002": "你想，不是经常有那种情况吗，<br>\n移动书架就会出现暗室的开关。",
  "0103Adv14_Sherry003": "我就在想会不会有这种东西，<br>\n所以在找找看。",
  "0103Adv14_Hanna008": "就算这样，<br>\n这么闹也会被看守抓去惩罚室的！",
  "0103Adv14_Sherry004": "规定里没说不能破坏监牢内部，<br>\n所以没问题哦。",
  "0103Adv14_Hanna009": "那是因为<br>\n只有你这种人才能做出这种破坏行为吧。",
  "0103Adv14_Ema007": "（……不过，看守确实没来。<br>\n　平时的话应该立刻就会赶到的）",
  "0103Adv14_Ema008": "（或许只要没违反规定，<br>\n　做任何事都是受允许的……）",
  "0103Adv14_Ema009": "就算是这样，也有可能会被惩罚的。<br>\n我觉得还是不该这样做……",
  "0103Adv14_Narrative012": "雪莉完全不听劝，<br>\n继续她的破坏行动。",
  "0103Adv14_Hanna010": "你就不能安分一点吗！？",
  "0103Adv14_Sherry005": "不想再安分了。<br>\n大家似乎都已经到极限了。",
  "0103Adv14_Ema010": "呃……",
  "0103Adv14_Sherry006": "汉娜和艾玛<br>\n也感觉到了那种氛围吧？",
  "0103Adv14_Narrative013": "艾玛沉默了。<br>\n雪莉说的话，她有头绪。",
  "0103Adv14_Ema011": "（像着了魔似地<br>\n　一直在看书的玛格……）",
  "0103Adv14_Ema012": "（逃避现实，<br>\n　沉浸在妄想世界里的可可……）",
  "0103Adv14_Ema013": "（而且最主要的是——梅露露,<br>\n　她竟然会哭成那样）",
  "0103Adv14_Ema014": "（雪莉说得对，<br>\n　大家都已经快到极限了）",
  "0103Adv14_Sherry007": "我想要反抗，<br>\n不想什么都做不了。",
  "0103Adv14_Hanna011": "可是闹事也是……",
  "0103Adv14_Narrative014": "雪莉充耳不闻，<br>\n只管继续破坏图书室。",
  "0103Adv14_Narrative015": "汉娜和艾玛目前<br>\n只能旁观着这一切。",
  "0103Adv14_Hanna012": "我也……讨厌这样……",
  "0103Adv14_Hanna013": "但是，做这种事情，<br>\n什么都改变不了啊……",
  "0103Adv14_Narrative016": "站在一旁的汉娜握紧拳头，颤抖着。<br>\n眼角泛着泪光。",
  "0103Adv14_Hanna014": "你这个笨蛋。<br>\n真是个笨蛋……",
  "0103Adv14_Sherry008": "怎么把天才说成是笨蛋呢～！",
  "0103Adv14_Hanna015": "肌肉笨蛋，不识空气的臭女人。",
  "0103Adv14_Sherry009": "偶尔也夸夸我嘛！",
  "0103Adv14_Narrative017": "即使破坏书架，<br>\n也找不到能逃脱的线索。",
  "0103Adv14_Ema015": "（太令人心痛了，雪莉……）",
  "0103Adv14_Ema016": "（雪莉也是被压力击垮了吗……<br>\n　不，这么说的话）",
  "0103Adv14_Ema017": "（可可、玛格、梅露露、<br>\n　亚里沙、汉娜也是）",
  "0103Adv14_Ema018": "（连我也是——）",
  "0103Adv14_Ema019": "（可能会变成魔女——）",
  "0103Adv14_Narrative018": "意识到这个显而易见的事实时，<br>\n艾玛感觉脚下一阵晃动。",
  "0103Adv14_Margo001": "——太过分了！",
  "0103Adv14_Narrative019": "突然，一声悲痛的叫喊在图书室内响起。",
  "0103Adv14_Narrative020": "玛格察觉到骚动赶来了。<br>\n她慌忙跑向散落的书本。",
  "0103Adv14_Narrative021": "艾玛她们都愣住了。<br>\n她们第一次看到玛格如此慌张。",
  "0103Adv14_Narrative022": "玛格把书本都收拢到身边，<br>\n深深地叹了口气。",
  "0103Adv14_Margo002": "这里的书写着非常重要的内容。<br>\n希望你们能好好珍惜。",
  "0103Adv14_Margo003": "啊太好了，书没事……",
  "0103Adv14_Narrative023": "玛格似乎找到了想要的书，<br>\n小心翼翼地抱在胸前松了口气。",
  "0103Adv14_Margo004": "本想着大家可能会想看，我才放在这里的。<br>\n看来我还是应该把它放在自己身边。",
  "0103Adv14_Sherry010": "……那是之前给我们看的那本书吧？",
  "0103Adv14_Margo005": "是的，这是非常重要的书。<br>\n我打算用这本书上记载的内容进行实验，<br>\n不，是举行仪式。",
  "0103Adv14_Sherry011": "仪式！？要做什么！？",
  "0103Adv14_Margo006": "……我不想告诉你们。<br>\n失陪了。",
  "0103Adv14_Narrative024": "玛格冷冷地说完就离开了。<br>\n艾玛和汉娜面面相觑。",
  "0103Adv14_Ema020": "她是不是觉得我们也是搞乱图书室的帮凶……？",
  "0103Adv14_Hanna016": "太糟糕了！我明明什么都没做！",
  "0103Adv14_Hanna017": "雪莉你到底要给我们添多少麻烦啊！？<br>\n快来收拾！",
  "0103Adv14_Narrative025": "汉娜一边抱怨一边开始捡拾书本。<br>\n艾玛也加入了整理工作。"
}
}
