    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "（这里应该没有人了吧……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Ema001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "为了避免漏找，<br>\n艾玛一间间地检查着地下过道两侧的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "这时——她在汉娜和可可的牢房那边，<br>\n发现汉娜还在里面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "汉娜背对着门口坐在地上，<br>\n专注地做着什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 30, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "汉娜……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Ema002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna002"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "轻声呼唤时，<br>\n汉娜的肩膀夸张地抖了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative004"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "哎，哎呀艾玛！<br>\n吓了我一跳～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna003"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "汉娜慌忙地<br>\n把手中的东西藏到毯子下面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "（那是什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Ema003"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "什么都没有！<br>\n请、请不要在意！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 50, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "似乎注意到艾玛疑惑的眼神，<br>\n汉娜慌慌张张地从牢房里出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "嗯……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Ema004"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "因为对方有所隐瞒，<br>\n艾玛露出了有些失落的表情。<br>\n看到这个反应，汉娜更加慌乱了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "真、真的不是什么大不了的事！<br>\n也不是在做什么危险的事！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna005"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "那个……我是在给艾玛做礼物，<br>\n希望能让你开心起来。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna006"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "因为艾玛你最近一直卧床，<br>\n我就想给你做些东西，当作是慰问品……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna007"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "汉娜移开视线，<br>\n有些不好意思地说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "礼物……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "不用大惊小怪的啦！？<br>\n不是什么很了不起的东西！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna008"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "汉娜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Ema006"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "艾玛感动得眼眶湿润。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Flushed1"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "真的不是什么特别的东西，<br>\n请不要太当回事！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna009"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "我先过去了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Hanna010"]}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1,ArmR3,ArmL7"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "嗯、嗯。那一会见。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv09_Ema007"]}},
