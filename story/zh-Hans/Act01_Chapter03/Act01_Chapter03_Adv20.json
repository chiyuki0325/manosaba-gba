    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛走进了招待所中最靠前的，<br>\n也就是发生了火灾的那一间——<br>\n【火精之室】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "玛格已经先到一步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "啊，艾玛，你也来了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo001"]}},
    {"op": "HideAllCharacters", "line": 28, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "现场的火势早已扑灭，<br>\n室内仍飘荡着焦糊的气味。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative003"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "看样子，内部结构基本完好，没遭受太大的损害。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative004"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "家具虽然覆盖着黑色的烟灰，<br>\n却依然保持着原有的形状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative005"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "在狭小的室内，<br>\n那个无法逃避的景象映入眼帘。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative006"]}},
    {"op": "ModifyBackgroundExtended", "line": 38, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "290_2"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "汉娜的遗体仍被绳索<br>\n悬挂在天花板的横梁上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative007"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "汉娜……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema001"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "艾玛咬紧牙关，强迫自己冷静下来，<br>\n开始用手机拍摄现场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative008"]}},
