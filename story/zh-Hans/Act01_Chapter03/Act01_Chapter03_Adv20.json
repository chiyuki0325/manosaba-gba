    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "正在拍摄现场时，<br>\n玛格走到艾玛身边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "艾玛，火灾中好像只有这个<br>\n掉下来了，我就交给你了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo003"]}},
    {"op": "HideAllCharacters", "line": 104, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "玛格递过来的，<br>\n是一个做成艾玛模样的人偶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative015"]}},
