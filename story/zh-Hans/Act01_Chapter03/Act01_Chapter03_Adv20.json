    {"op": "Wait", "line": 66, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "烟雾散去后，<br>\n一切都变得清晰可见。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative009"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "横梁上悬挂着汉娜的尸体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative010"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "在她的身旁，还悬挂着许多<br>\n以囚犯少女们为原型<br>\n制作的人偶，簇拥着她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative011"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "这该不会是，<br>\n汉娜一直在手工制作的人偶……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema002"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "是啊。她为每个人都做了。<br>\n虽然她不太坦率，<br>\n但真的很关心同伴呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo002"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "即使咬着嘴唇，<br>\n艾玛的眼泪还是快要夺眶而出。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative012"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（不能哭！我已经下定决心要查明<br>\n　汉娜死亡的真相！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema003"]}},
    {"op": "HideActors", "line": 82, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "艾玛强迫自己冷静下来，<br>\n环视房间四周。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative013"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "（房间里一片狼藉……<br>\n　这里到底发生了什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema004"]}},
