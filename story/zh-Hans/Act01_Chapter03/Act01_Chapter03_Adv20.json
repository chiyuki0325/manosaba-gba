    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "（汉娜说过，<br>\n　她在准备礼物）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema005"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "（一定就是这个——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema006"]}},
    {"op": "HideAllCharacters", "line": 121, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "手工缝制的，<br>\n以艾玛为原型的人偶传来温暖的触感。<br>\n接过人偶的艾玛双手颤抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "奇怪了……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo004"]}},
    {"op": "HideAllCharacters", "line": 129, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "听到这句低语，<br>\n艾玛转头望去。<br>\n玛格正困惑地歪着头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "……怎么了？发现什么可疑的地方了吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema007"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "不，虽然调查了现场还什么都不清楚，<br>\n但是……其实我昨晚来过这里。<br>", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo005"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "欸！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema008"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "因为说出来可能会显得很可疑，<br>\n所以不太想说……<br>\n但我在这里举行了魔法仪式。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo006"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "仪式？<br>\n是之前说的那本魔女的书上记载的……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema009"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR2"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "是的。而且这个房间在就寝时间前，<br>\n应该被看守锁上了才对。<br>\n然后当我们因火灾赶来的时候……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo007"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "……门是锁着的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema010"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "（又来了。又是密室杀人……！<br>\n　为什么总是这样……！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "汉娜的尸体状况，<br>\n现场悬挂的人偶，<br>\n火灾、密室……全都充满谜团呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Margo008"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "是啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv20_Ema012"]}},
    {"op": "HideAllCharacters", "line": 166, "indent": 0, "params": {"Lazy": 0}},
