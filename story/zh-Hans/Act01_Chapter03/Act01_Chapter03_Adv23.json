    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "铺着石砖的路面上，<br>\n沾着一些不自然的颜料。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative011"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "之前来招待所附近的时候，<br>\n应该不存在这些痕迹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative012"]}},
    {"op": "ModifyCamera", "line": 119, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.8999999761581421, "Lazy": 0}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "为了以防万一，艾玛对这些颜料拍了照，<br>\n结束了这里的调查。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative013"]}},
