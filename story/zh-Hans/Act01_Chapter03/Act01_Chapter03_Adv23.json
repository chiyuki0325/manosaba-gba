    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "监牢近处的招待所区域——<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "最靠近监牢的【火精之室】已经不再燃烧。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "在火势扑灭时，幸好还未造成太大损害，<br>\n建筑本身并未倒塌。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative003"]}},
    {"op": "PlaySfxModified", "line": 27, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 32, "indent": 0, "params": {"Path": "Clue", "Params": ["3-9"]}},
    {"op": "UpdateWitchBook", "line": 33, "indent": 0, "params": {"Id": "3-9", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 34, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "艾玛用自己的手机拍摄了建筑的外观。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative004"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "（为什么火灾会在【火精之室】发生呢……？）<br>", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema001"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "（是有人纵火……？<br>\n　还是某种魔法触发了……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema002"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "正当艾玛陷入沉思时，<br>\n她听到有脚步声靠近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative005"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "抬头一看，<br>\n亚里沙站在她面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off,ArmL2"}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "樱羽，你没事吧……？<br>\n那个，你的手，烫伤了吧……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Alisa001"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "……啊，完全忘记了。<br>\n这种程度，根本不算什么……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema003"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "（和汉娜的痛苦相比……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema004"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "艾玛摇摇头不让自己想太多，<br>\n转而看向正在调查的亚里沙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1,ArmL1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "这附近有烧过的痕迹。<br>\n火源应该就在这里。<br>\n可能是有人从外面纵火。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "真的……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema005"]}},
    {"op": "PlaySfxModified", "line": 66, "indent": 0, "params": {"SfxPath": "Sfx_28", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 71, "indent": 0, "params": {"Path": "Clue", "Params": ["3-2"]}},
    {"op": "UpdateWitchBook", "line": 72, "indent": 0, "params": {"Id": "3-2", "Category": "Clue", "Version": 1}},
    {"op": "DestroySpawnedExtended", "line": 73, "indent": 0, "params": {"Path": "Clue", "LogWarning": 1}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "在【火精之室】建筑物旁边——<br>\n亚里沙指着的地方<br>\n留有某种可燃物燃烧过的痕迹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "……结果还是有人纵火吗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Pensive1,ArmL2"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "谁知道呢。不过，<br>\n如果是在远野被吊起来的情况下纵火的话，<br>\n那凶手真是太恶劣了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Alisa003"]}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "是想连同远野的尸体一起烧掉吧。<br>\n这已经不是人能做出来的事了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Alisa004"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "（不过，我认为这应该还是人下手的）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema007"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "（而那个人正是【魔女】——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema008"]}},
    {"op": "HideActors", "line": 91, "indent": 0, "params": {"ActorIds": ["Alisa"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "说完这些话的亚里沙离开了。<br>\n她应该是去调查其他地方了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative009"]}},
    {"op": "HideActors", "line": 95, "indent": 0, "params": {"ActorIds": ["Ema"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "艾玛打算稍微再调查一下这附近，<br>\n于是环顾了四周。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Narrative010"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "（这是什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv23_Ema009"]}},
