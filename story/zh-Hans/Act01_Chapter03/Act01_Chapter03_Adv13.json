    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "16_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 16, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1,ArmR3,ArmL9"}},
    {"op": "ModifyCharacterExtended", "line": 17, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "啊～太棒了～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry001"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "呼、呼、呼……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna001"]}},
    {"op": "HidePrinter", "line": 23, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "虽然汉娜和雪莉飞得很远，<br>\n但最后还是走路回来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative001"]}},
    {"op": "HideAllCharacters", "line": 27, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "汉娜，辛苦了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema001"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "我、我这就给你倒茶。<br>\n虽然已经凉了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 35, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "凉的就好……<br>\n雪莉可真会指导人锻炼身体啊，哼。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 40, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "四个人再次坐在餐布上，<br>\n气氛变得悠闲起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative002"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（要是这样的时光能一直持续下去就好了……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "话说，艾玛。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "雪莉发起了对话，<br>\n艾玛慢悠悠地看向了她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 54, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "什么事？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema003"]}},
    {"op": "HideAllCharacters", "line": 58, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "你和二阶堂希罗<br>\n是什么关系呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry003"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "看起来很不一般呢？<br>\n有什么过节吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 65, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "呃……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema004"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "艾玛的表情瞬间变得僵硬。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 72, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "等等，雪莉！<br>\n有你这样问的吗……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna003"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "我们对彼此的事情还几乎一无所知，<br>\n特别是被关在这里之前的事。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry005"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "既然是朋友，<br>\n想要更多地了解对方不是很正常吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "这倒是……没错，但是……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 87, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "（被关在这里之前的事……<br>\n　我的确还不是很了解大家）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema005"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "（我也想多些了解大家，<br>\n　也希望大家多了解我）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "——我从小就认识希罗了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema007"]}},
    {"op": "HideAllCharacters", "line": 97, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "嗯，这个我听说过。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 102, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "我们曾经是朋友，<br>\n但不知为什么，我被她讨厌了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema008"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "虽然是我的错，但我对那段时期的记忆<br>\n记得不太清楚。<br>\n所以不太明白原因。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema009"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我只记得，<br>\n我惹怒了身为班级中心人物的希罗，<br>\n然后就被大家孤立了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema010"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "……总感觉，<br>\n被大家霸凌了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema011"]}},
    {"op": "HideAllCharacters", "line": 113, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Pensive1,ArmR10,ArmL11"}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "这是怎么回事！？<br>\n太过分了……！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna005"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "艾玛小姐……竟然经历了这么痛苦的事……呜呜……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru002"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "也就是说，<br>\n是希罗鼓动的吧？<br>\n变成了霸凌者和受霸凌者的关系……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "也许是这样吧，但那只是关系变糟了而已……<br>\n即使现在，希罗在我心目中依然很特别。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema012"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "没想到会在这里再会，<br>\n然后出了那样的事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema013"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "直到现在，<br>\n艾玛的口袋里还揣着希罗掉落的钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative005"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "艾玛轻轻握紧那支钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative006"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "（现在有雪莉、汉娜、<br>\n　还有梅露露在我身边）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "谢谢大家愿意听我说。<br>\n感觉轻松了一些。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema015"]}},
    {"op": "HideAllCharacters", "line": 143, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Pensive1,ArmR10,ArmL1"}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "人际关系总是很复杂呢……<br>\n我也有过被大家无视的经历。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry009"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "你这种性格，确实有这种经历也不奇怪。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna006"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "为什么对我和艾玛的态度差这么多！？<br>\n我可要哭了哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "那么，汉娜呢？<br>\n在被关在这里之前<br>\n过着怎样的生活呢？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "欸？我、我吗……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna007"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "似乎没想到会被问到，<br>\n汉娜的举止变得慌乱起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative007"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "我是……那个……看就知道了吧！？<br>\n我、我是有钱人家的大小姐！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna008"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "被当成掌上明珠宠爱着！<br>\n每天过着奢侈的生活！真怀念以前的生活啊！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna009"]}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "嗯～感觉很可疑呢……<br>\n吃相和举止都很像平民……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry012"]}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "我的事就不用说了吧！？<br>\n雪莉你是怎样的？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna010"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR7"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "我吗？<br>\n哎呀呀，汉娜想了解我吗？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry013"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "这么感兴趣我很伤脑筋呢～<br>\n如果这么想知道的话，我就告诉你吧～？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry014"]}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "明明是你先问的！<br>\n别总是这样挑衅啊！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna011"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile1,ArmR12"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "好吧，我来说说！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry015"]}},
    {"op": "ModifyCharacterExtended", "line": 189, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "我……嗯……小学和初中<br>\n都是很普通的孩子呢……！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry016"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "要说的话，就是迷上了悬疑小说，<br>\n变成了悬疑宅而已……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry017"]}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "这种事一看就知道了……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna012"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "抱歉内容比想像中无聊～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry018"]}},
    {"op": "HideAllCharacters", "line": 201, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 202, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "就算无聊也没关系的，<br>\n雪莉……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema016"]}},
    {"op": "HideAllCharacters", "line": 206, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "啊，不过有一件事。<br>\n我是孤儿，在福利机构长大的。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry019"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "所以和养父母没有血缘关系。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry020"]}},
    {"op": "HideAllCharacters", "line": 213, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "雪莉轻描淡写地说出这番话，<br>\n让艾玛她们都说不出话来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "突、突然扔下这样的重磅炸弹……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna013"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "因为关系算不上特别好，<br>\n我想我的家人应该不会担心我。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry021"]}},
    {"op": "HideAllCharacters", "line": 224, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 225, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "……不、不会的！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru003"]}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "梅露露罕见地提高了声音。<br>\n她浑身颤抖，似乎随时都要哭出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative009"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "（梅露露……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema017"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "即使没有血缘关系，<br>\n家人也是重要的存在……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru004"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "雪莉小姐的家人，<br>\n一定很担心雪莉小姐……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru005"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "每天都在想念着雪莉小姐，<br>\n心都要碎了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru006"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "或许是再也无法忍受，<br>\n梅露露不禁泪如雨下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 241, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Cry"}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "我……想见家人。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru007"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "我已经受够这里了……<br>\n我好想见她，好想见啊……呜呜呜～", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Meruru008"]}},
    {"op": "HideAllCharacters", "line": 249, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "梅露露，别哭了……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Hanna014"]}},
    {"op": "HideAllCharacters", "line": 254, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 255, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 257, "indent": 0, "params": {"Text": "梅露露……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Ema018"]}},
    {"op": "HideAllCharacters", "line": 259, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "梅露露平时虽然胆小，<br>\n但从未在他人面前展示内心的脆弱。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative011"]}},
    {"op": "PrintTextModified", "line": 263, "indent": 0, "params": {"Text": "然而此刻，<br>\n她却抽泣着，倾吐出内心的情感。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative012"]}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "心如刀割。<br>\n所有少女都怀着同样的心情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative013"]}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "——想见家人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 269, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR10"}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "……放风时间快结束了。<br>\n我们回去吧。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Sherry022"]}},
    {"op": "HideAllCharacters", "line": 273, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "气氛变得沉重，<br>\n艾玛她们开始准备返回监牢。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv13_Narrative015"]}},
    {"op": "UpdateWitchBook", "line": 277, "indent": 0, "params": {"Id": "Sherry", "Category": "Profile", "Version": 3}},
    {"op": "Gosub", "line": 279, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 281, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv14", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv13_Sherry001": "啊～太棒了～",
  "0103Adv13_Hanna001": "呼、呼、呼……",
  "0103Adv13_Narrative001": "虽然汉娜和雪莉飞得很远，<br>\n但最后还是走路回来了。",
  "0103Adv13_Ema001": "汉娜，辛苦了……",
  "0103Adv13_Meruru001": "我、我这就给你倒茶。<br>\n虽然已经凉了……",
  "0103Adv13_Hanna002": "凉的就好……<br>\n雪莉可真会指导人锻炼身体啊，哼。",
  "0103Adv13_Narrative002": "四个人再次坐在餐布上，<br>\n气氛变得悠闲起来。",
  "0103Adv13_Ema002": "（要是这样的时光能一直持续下去就好了……）",
  "0103Adv13_Sherry002": "话说，艾玛。",
  "0103Adv13_Narrative003": "雪莉发起了对话，<br>\n艾玛慢悠悠地看向了她。",
  "0103Adv13_Ema003": "什么事？",
  "0103Adv13_Sherry003": "你和二阶堂希罗<br>\n是什么关系呢？",
  "0103Adv13_Sherry004": "看起来很不一般呢？<br>\n有什么过节吗？",
  "0103Adv13_Ema004": "呃……",
  "0103Adv13_Narrative004": "艾玛的表情瞬间变得僵硬。",
  "0103Adv13_Hanna003": "等等，雪莉！<br>\n有你这样问的吗……！",
  "0103Adv13_Sherry005": "我们对彼此的事情还几乎一无所知，<br>\n特别是被关在这里之前的事。",
  "0103Adv13_Sherry006": "既然是朋友，<br>\n想要更多地了解对方不是很正常吗？",
  "0103Adv13_Hanna004": "这倒是……没错，但是……",
  "0103Adv13_Ema005": "（被关在这里之前的事……<br>\n　我的确还不是很了解大家）",
  "0103Adv13_Ema006": "（我也想多些了解大家，<br>\n　也希望大家多了解我）",
  "0103Adv13_Ema007": "——我从小就认识希罗了。",
  "0103Adv13_Sherry007": "嗯，这个我听说过。",
  "0103Adv13_Ema008": "我们曾经是朋友，<br>\n但不知为什么，我被她讨厌了……",
  "0103Adv13_Ema009": "虽然是我的错，但我对那段时期的记忆<br>\n记得不太清楚。<br>\n所以不太明白原因。",
  "0103Adv13_Ema010": "我只记得，<br>\n我惹怒了身为班级中心人物的希罗，<br>\n然后就被大家孤立了。",
  "0103Adv13_Ema011": "……总感觉，<br>\n被大家霸凌了。",
  "0103Adv13_Hanna005": "这是怎么回事！？<br>\n太过分了……！",
  "0103Adv13_Meruru002": "艾玛小姐……竟然经历了这么痛苦的事……呜呜……",
  "0103Adv13_Sherry008": "也就是说，<br>\n是希罗鼓动的吧？<br>\n变成了霸凌者和受霸凌者的关系……？",
  "0103Adv13_Ema012": "也许是这样吧，但那只是关系变糟了而已……<br>\n即使现在，希罗在我心目中依然很特别。",
  "0103Adv13_Ema013": "没想到会在这里再会，<br>\n然后出了那样的事……",
  "0103Adv13_Narrative005": "直到现在，<br>\n艾玛的口袋里还揣着希罗掉落的钢笔。",
  "0103Adv13_Narrative006": "艾玛轻轻握紧那支钢笔。",
  "0103Adv13_Ema014": "（现在有雪莉、汉娜、<br>\n　还有梅露露在我身边）",
  "0103Adv13_Ema015": "谢谢大家愿意听我说。<br>\n感觉轻松了一些。",
  "0103Adv13_Sherry009": "人际关系总是很复杂呢……<br>\n我也有过被大家无视的经历。",
  "0103Adv13_Hanna006": "你这种性格，确实有这种经历也不奇怪。",
  "0103Adv13_Sherry010": "为什么对我和艾玛的态度差这么多！？<br>\n我可要哭了哦？",
  "0103Adv13_Sherry011": "那么，汉娜呢？<br>\n在被关在这里之前<br>\n过着怎样的生活呢？",
  "0103Adv13_Hanna007": "欸？我、我吗……？",
  "0103Adv13_Narrative007": "似乎没想到会被问到，<br>\n汉娜的举止变得慌乱起来。",
  "0103Adv13_Hanna008": "我是……那个……看就知道了吧！？<br>\n我、我是有钱人家的大小姐！",
  "0103Adv13_Hanna009": "被当成掌上明珠宠爱着！<br>\n每天过着奢侈的生活！真怀念以前的生活啊！",
  "0103Adv13_Sherry012": "嗯～感觉很可疑呢……<br>\n吃相和举止都很像平民……",
  "0103Adv13_Hanna010": "我的事就不用说了吧！？<br>\n雪莉你是怎样的？",
  "0103Adv13_Sherry013": "我吗？<br>\n哎呀呀，汉娜想了解我吗？",
  "0103Adv13_Sherry014": "这么感兴趣我很伤脑筋呢～<br>\n如果这么想知道的话，我就告诉你吧～？",
  "0103Adv13_Hanna011": "明明是你先问的！<br>\n别总是这样挑衅啊！",
  "0103Adv13_Sherry015": "好吧，我来说说！",
  "0103Adv13_Sherry016": "我……嗯……小学和初中<br>\n都是很普通的孩子呢……！",
  "0103Adv13_Sherry017": "要说的话，就是迷上了悬疑小说，<br>\n变成了悬疑宅而已……",
  "0103Adv13_Hanna012": "这种事一看就知道了……",
  "0103Adv13_Sherry018": "抱歉内容比想像中无聊～！",
  "0103Adv13_Ema016": "就算无聊也没关系的，<br>\n雪莉……",
  "0103Adv13_Sherry019": "啊，不过有一件事。<br>\n我是孤儿，在福利机构长大的。",
  "0103Adv13_Sherry020": "所以和养父母没有血缘关系。",
  "0103Adv13_Narrative008": "雪莉轻描淡写地说出这番话，<br>\n让艾玛她们都说不出话来。",
  "0103Adv13_Hanna013": "突、突然扔下这样的重磅炸弹……",
  "0103Adv13_Sherry021": "因为关系算不上特别好，<br>\n我想我的家人应该不会担心我。",
  "0103Adv13_Meruru003": "……不、不会的！",
  "0103Adv13_Narrative009": "梅露露罕见地提高了声音。<br>\n她浑身颤抖，似乎随时都要哭出来。",
  "0103Adv13_Ema017": "（梅露露……？）",
  "0103Adv13_Meruru004": "即使没有血缘关系，<br>\n家人也是重要的存在……",
  "0103Adv13_Meruru005": "雪莉小姐的家人，<br>\n一定很担心雪莉小姐……",
  "0103Adv13_Meruru006": "每天都在想念着雪莉小姐，<br>\n心都要碎了。",
  "0103Adv13_Narrative010": "或许是再也无法忍受，<br>\n梅露露不禁泪如雨下。",
  "0103Adv13_Meruru007": "我……想见家人。",
  "0103Adv13_Meruru008": "我已经受够这里了……<br>\n我好想见她，好想见啊……呜呜呜～",
  "0103Adv13_Hanna014": "梅露露，别哭了……",
  "0103Adv13_Ema018": "梅露露……",
  "0103Adv13_Narrative011": "梅露露平时虽然胆小，<br>\n但从未在他人面前展示内心的脆弱。<br>",
  "0103Adv13_Narrative012": "然而此刻，<br>\n她却抽泣着，倾吐出内心的情感。",
  "0103Adv13_Narrative013": "心如刀割。<br>\n所有少女都怀着同样的心情。",
  "0103Adv13_Narrative014": "——想见家人。",
  "0103Adv13_Sherry022": "……放风时间快结束了。<br>\n我们回去吧。",
  "0103Adv13_Narrative015": "气氛变得沉重，<br>\n艾玛她们开始准备返回监牢。"
}
}
