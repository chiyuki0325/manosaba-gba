  "language": "zh-Hans",
  "path": "Act01_Chapter03/Act01_Chapter03_Adv11",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-3-11", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "12_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "艾玛仔细搜寻图书室，<br>\n果然如她所料，找到了玛格。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative001"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "玛格躲在一个阴暗的角落里，<br>\n默默地看着书。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative002"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "……哎呀，艾玛。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo001"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "玛格，那本书是……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "之前给你看过的吧？<br>\n是关于魔女和魔法的图解书。<br>\n最近我已经能读懂不少了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo002"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "欸！？真的吗！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "是啊，只要找到规律，<br>\n其实并不难。艾玛要不要也试试看？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo003"]}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "呃……我对学习这种事，<br>\n不太擅长……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Smile1"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "呵呵，看起来确实是这样呢。<br>\n不过艾玛，我觉得你其实很聪明。<br>\n感觉你是在故意装作不行的样子。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo004"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "哪有……你太高看我了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 58, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "先、先不说这个了，<br>\n书里有写什么重要的内容吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "这个嘛……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo005"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "玛格爱惜地抚摸着书的书脊。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Smile1,ArmR4"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "虽然不知道对我们来说是否是救赎，<br>\n但我发现书中写着某个仪式。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo006"]}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "仪式……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR6"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "是的。不过我还在解读中，<br>\n等多了解一些再告诉你吧。<br>", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo007"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "……还有就是，这座宅邸的某处似乎藏着<br>\n【杀死魔女的药】。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo008"]}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "欸，杀死魔女的药……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 86, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR5"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "是的。药物名称是【<ruby=\"Tredecim\">特雷德基姆</ruby>】，<br>\n这似乎是拉丁语中表示【13】的词。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo009"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "这种药进入体内后，似乎会因副作用<br>\n在死后出现身体反应。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo010"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "不过这些信息我还在解读中，<br>\n等了解更多细节再告诉你。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo011"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "仔细观察玛格，<br>\n能发现她眼下有着明显的黑眼圈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative004"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "（看来玛格也撑不住了啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema008"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1,ArmR7"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "来，艾玛你看。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo012"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "玛格突然摘下手套，<br>\n伸出她那纤细而漂亮的手。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR7"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "……？手怎么了吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema009"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "指甲很长吧？<br>\n这还是昨天刚剪的呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo013"]}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Surprised1,ArmR3"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "欸……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema010"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "看到玛格的指尖，艾玛说不出话来。<br>\n这长度看着，确实不像是昨天才修剪过的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1,ArmR5"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "你应该很清楚看守……<br>\n也就是那些残骸是什么样子的吧？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo014"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "看来魔女化加深时，<br>\n指甲生长也会加快呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo015"]}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "玛格，你能感觉到魔女化有加深吗？<br>\n有……有杀人的冲动吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema011"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "当艾玛不由自主地后退时，<br>\n玛格微笑着摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Smile1,ArmR1,ArmL4"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "呵呵，别害怕，我不会做什么的。<br>\n我还没到那个程度，<br>\n没有杀人的冲动。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo016"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "这样啊……太好了。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "不过，魔女化确实已经开始了。<br>\n我还发现了一些好处。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo017"]}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "好处？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema013"]}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "魔法的效力变强了。<br>\n想必魔女化越深入，<br>\n就能使用越强大的魔法吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo018"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "就像这本书上图解说明的那样。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo019"]}},
    {"op": "ModifyCharacterExtended", "line": 151, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "（魔法变强或许是好事。<br>\n　但是……如果变成残骸失去了自我那就完蛋了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "你还记得<br>\n蕾雅和安安的处刑吗？", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo020"]}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "……怎么可能忘记。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema015"]}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "她们都是因为受到杀意驱使而犯下杀人罪，<br>\n以魔女的身份被处决。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative008"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "——然后，变成了【残骸】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative009"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "（她们时常会出现在噩梦中……<br>\n　这也在折磨着我们……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema016"]}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR2,ArmL1"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "不知道以后在哪个阶段，我们的身体会完全魔女化，<br>\n转变成不死的肉体呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo021"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "她们没有因处刑而死，<br>\n说明她们已经成为魔女了吧。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo022"]}},
    {"op": "PrintTextModified", "line": 175, "indent": 0, "params": {"Text": "但外表却没有变化，<br>\n会不会是个人差异呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo023"]}},
    {"op": "ModifyCharacterExtended", "line": 177, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1,ArmR2"}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "有的人外表会稍微带有异形的特征，<br>\n有的则保持原貌成为魔女了……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo024"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "如果能从外表判断就好了，<br>\n这样就能轻易隔离魔女了。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo025"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "隔离也太过分了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema017"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "哎呀，我觉得这很合理哦？<br>\n比如说我，在这个阶段就应该被隔离。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo026"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "把有可能成为魔女的人关起来的话，<br>\n就不会发生凶杀案了。<br>\n从一开始就该这么做。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo027"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "艾玛皱眉摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "做不到……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema018"]}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Normal1"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "你真是温柔呢。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo028"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "但这种温柔有时也是种残酷。<br>\n你迟早会后悔的。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo029"]}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Determined2,ArmR3"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "我不会后悔的！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema019"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "我一定会<br>\n和大家一起逃出这座监牢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema020"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "再也不会让任何人死去。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema021"]}},
    {"op": "ModifyCharacterExtended", "line": 213, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "…………", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo030"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "玛格用空洞的眼神，<br>\n面无表情地注视着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative011"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "艾玛说出口的漂亮话<br>\n似乎完全无法触动玛格的内心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative012"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "（即便如此……即便如此，<br>\n　我也想要救玛格啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema022"]}},
    {"op": "ModifyCharacterExtended", "line": 223, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR1"}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "……玛格，<br>\n今天大家准备去野餐。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema023"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "如果可以的话，希望你也能来。<br>\n我想和大家一起开心地相处。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema024"]}},
    {"op": "ModifyCharacterExtended", "line": 229, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "……哦。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo031"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "玛格淡淡地说着，<br>\n漠不关心地将视线移回书本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative013"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "我觉得我还是不去比较好。<br>\n说不定会对谁产生杀意。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Margo032"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "……但是，但是，我们会等你的。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema025"]}},
    {"op": "HideAllCharacters", "line": 241, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "艾玛转身离开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative014"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "（我们之间是有感情的。<br>\n　有感情的话，就不会发生凶杀案）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema026"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "（——我想要这样相信）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Ema027"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "艾玛紧握拳头，<br>\n坚定地望着前方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv11_Narrative015"]}},
    {"op": "UpdateWitchBook", "line": 252, "indent": 0, "params": {"Id": "6", "Category": "Note", "Version": 2}},
    {"op": "Gosub", "line": 259, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 261, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv06", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv11_Narrative001": "艾玛仔细搜寻图书室，<br>\n果然如她所料，找到了玛格。",
  "0103Adv11_Narrative002": "玛格躲在一个阴暗的角落里，<br>\n默默地看着书。<br>",
  "0103Adv11_Margo001": "……哎呀，艾玛。",
  "0103Adv11_Ema001": "玛格，那本书是……",
  "0103Adv11_Margo002": "之前给你看过的吧？<br>\n是关于魔女和魔法的图解书。<br>\n最近我已经能读懂不少了。",
  "0103Adv11_Ema002": "欸！？真的吗！？",
  "0103Adv11_Margo003": "是啊，只要找到规律，<br>\n其实并不难。艾玛要不要也试试看？",
  "0103Adv11_Ema003": "呃……我对学习这种事，<br>\n不太擅长……",
  "0103Adv11_Margo004": "呵呵，看起来确实是这样呢。<br>\n不过艾玛，我觉得你其实很聪明。<br>\n感觉你是在故意装作不行的样子。",
  "0103Adv11_Ema004": "哪有……你太高看我了。",
  "0103Adv11_Ema005": "先、先不说这个了，<br>\n书里有写什么重要的内容吗？",
  "0103Adv11_Margo005": "这个嘛……",
  "0103Adv11_Narrative003": "玛格爱惜地抚摸着书的书脊。<br>",
  "0103Adv11_Margo006": "虽然不知道对我们来说是否是救赎，<br>\n但我发现书中写着某个仪式。",
  "0103Adv11_Ema006": "仪式……？",
  "0103Adv11_Margo007": "是的。不过我还在解读中，<br>\n等多了解一些再告诉你吧。<br>",
  "0103Adv11_Margo008": "……还有就是，这座宅邸的某处似乎藏着<br>\n【杀死魔女的药】。",
  "0103Adv11_Ema007": "欸，杀死魔女的药……？",
  "0103Adv11_Margo009": "是的。药物名称是【<ruby=\"Tredecim\">特雷德基姆</ruby>】，<br>\n这似乎是拉丁语中表示【13】的词。",
  "0103Adv11_Margo010": "这种药进入体内后，似乎会因副作用<br>\n在死后出现身体反应。",
  "0103Adv11_Margo011": "不过这些信息我还在解读中，<br>\n等了解更多细节再告诉你。",
  "0103Adv11_Narrative004": "仔细观察玛格，<br>\n能发现她眼下有着明显的黑眼圈。",
  "0103Adv11_Ema008": "（看来玛格也撑不住了啊……）",
  "0103Adv11_Margo012": "来，艾玛你看。",
  "0103Adv11_Narrative005": "玛格突然摘下手套，<br>\n伸出她那纤细而漂亮的手。<br>",
  "0103Adv11_Ema009": "……？手怎么了吗？",
  "0103Adv11_Margo013": "指甲很长吧？<br>\n这还是昨天刚剪的呢。",
  "0103Adv11_Ema010": "欸……",
  "0103Adv11_Narrative006": "看到玛格的指尖，艾玛说不出话来。<br>\n这长度看着，确实不像是昨天才修剪过的。",
  "0103Adv11_Margo014": "你应该很清楚看守……<br>\n也就是那些残骸是什么样子的吧？",
  "0103Adv11_Margo015": "看来魔女化加深时，<br>\n指甲生长也会加快呢。",
  "0103Adv11_Ema011": "玛格，你能感觉到魔女化有加深吗？<br>\n有……有杀人的冲动吗？",
  "0103Adv11_Narrative007": "当艾玛不由自主地后退时，<br>\n玛格微笑着摇了摇头。",
  "0103Adv11_Margo016": "呵呵，别害怕，我不会做什么的。<br>\n我还没到那个程度，<br>\n没有杀人的冲动。",
  "0103Adv11_Ema012": "这样啊……太好了。",
  "0103Adv11_Margo017": "不过，魔女化确实已经开始了。<br>\n我还发现了一些好处。",
  "0103Adv11_Ema013": "好处？",
  "0103Adv11_Margo018": "魔法的效力变强了。<br>\n想必魔女化越深入，<br>\n就能使用越强大的魔法吧。",
  "0103Adv11_Margo019": "就像这本书上图解说明的那样。",
  "0103Adv11_Ema014": "（魔法变强或许是好事。<br>\n　但是……如果变成残骸失去了自我那就完蛋了）",
  "0103Adv11_Margo020": "你还记得<br>\n蕾雅和安安的处刑吗？",
  "0103Adv11_Ema015": "……怎么可能忘记。",
  "0103Adv11_Narrative008": "她们都是因为受到杀意驱使而犯下杀人罪，<br>\n以魔女的身份被处决。",
  "0103Adv11_Narrative009": "——然后，变成了【残骸】。",
  "0103Adv11_Ema016": "（她们时常会出现在噩梦中……<br>\n　这也在折磨着我们……）",
  "0103Adv11_Margo021": "不知道以后在哪个阶段，我们的身体会完全魔女化，<br>\n转变成不死的肉体呢。",
  "0103Adv11_Margo022": "她们没有因处刑而死，<br>\n说明她们已经成为魔女了吧。",
  "0103Adv11_Margo023": "但外表却没有变化，<br>\n会不会是个人差异呢。",
  "0103Adv11_Margo024": "有的人外表会稍微带有异形的特征，<br>\n有的则保持原貌成为魔女了……",
  "0103Adv11_Margo025": "如果能从外表判断就好了，<br>\n这样就能轻易隔离魔女了。",
  "0103Adv11_Ema017": "隔离也太过分了……",
  "0103Adv11_Margo026": "哎呀，我觉得这很合理哦？<br>\n比如说我，在这个阶段就应该被隔离。",
  "0103Adv11_Margo027": "把有可能成为魔女的人关起来的话，<br>\n就不会发生凶杀案了。<br>\n从一开始就该这么做。",
  "0103Adv11_Narrative010": "艾玛皱眉摇头。",
  "0103Adv11_Ema018": "做不到……",
  "0103Adv11_Margo028": "你真是温柔呢。",
  "0103Adv11_Margo029": "但这种温柔有时也是种残酷。<br>\n你迟早会后悔的。",
  "0103Adv11_Ema019": "我不会后悔的！",
  "0103Adv11_Ema020": "我一定会<br>\n和大家一起逃出这座监牢。",
  "0103Adv11_Ema021": "再也不会让任何人死去。",
  "0103Adv11_Margo030": "…………",
  "0103Adv11_Narrative011": "玛格用空洞的眼神，<br>\n面无表情地注视着艾玛。",
  "0103Adv11_Narrative012": "艾玛说出口的漂亮话<br>\n似乎完全无法触动玛格的内心。",
  "0103Adv11_Ema022": "（即便如此……即便如此，<br>\n　我也想要救玛格啊……）",
  "0103Adv11_Ema023": "……玛格，<br>\n今天大家准备去野餐。",
  "0103Adv11_Ema024": "如果可以的话，希望你也能来。<br>\n我想和大家一起开心地相处。",
  "0103Adv11_Margo031": "……哦。",
  "0103Adv11_Narrative013": "玛格淡淡地说着，<br>\n漠不关心地将视线移回书本。",
  "0103Adv11_Margo032": "我觉得我还是不去比较好。<br>\n说不定会对谁产生杀意。",
  "0103Adv11_Ema025": "……但是，但是，我们会等你的。",
  "0103Adv11_Narrative014": "艾玛转身离开。",
  "0103Adv11_Ema026": "（我们之间是有感情的。<br>\n　有感情的话，就不会发生凶杀案）",
  "0103Adv11_Ema027": "（——我想要这样相信）",
  "0103Adv11_Narrative015": "艾玛紧握拳头，<br>\n坚定地望着前方。"
}
}
