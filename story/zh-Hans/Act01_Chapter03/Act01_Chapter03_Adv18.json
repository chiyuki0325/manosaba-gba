    {"op": "PlayBgm", "line": 19, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "收到典狱长的通知后，<br>\n少女们被召集到会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative001"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "听到汉娜死亡的消息，<br>\n梅露露大哭起来，不断地抽噎。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "雪莉躺在沙发上，<br>\n一脸茫然。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative003"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "亚里沙蜷缩在墙角，显得十分消沉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative004"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "可可目光呆滞，似乎在和谁对话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative005"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "玛格低着头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative006"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "（……说起来……<br>\n　奈叶香去哪里了呢）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Ema001"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "艾玛恍惚间想着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 38, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 40, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "5_2"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "这时，随着天花板边上传来一阵翅膀拍动的声音，<br>\n典狱长现身了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "唉，又来了……又是凶杀案……<br>\n而且还是大清早……真希望能考虑下时间啊……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Warden001"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "那么……<br>\n【魔女审判】就定在正午举行吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Warden002"]}},
    {"op": "HideAllCharacters", "line": 50, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "为什么总是随便定时间啊！？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Coco001"]}},
    {"op": "HideAllCharacters", "line": 55, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 56, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "这可是经过深思熟虑的。<br>\n为了让大家尽可能被逼入绝境……不不，<br>\n是为了让大家明天也能愉快地生活。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Warden003"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "不愉快的事情还是赶快解决比较好，<br>\n对吧？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Warden004"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "请各位务必从在场的囚犯之中锁定杀人凶手的身份。<br>\n选中的人将以【魔女】的身份被处以死刑……<br>\n还有就是老规矩，如果无法锁定凶手，所有人都要接受处刑。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Warden005"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "啊，顺带一提，【火精之室】的灭火工作<br>\n已经出动全体监视猫头鹰去完成了。<br>\n真是费了不少功夫……", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Warden006"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "请各位好好搜查，<br>\n尽力找出凶手吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Warden007"]}},
    {"op": "PlaySfxModified", "line": 69, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "它刚才是不是说“尽力”？<br>\n怎么感觉越来越随便了？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Coco002"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "不知道这座监牢存在多久了，<br>\n也许连它都厌倦了<br>\n这种凶杀案和魔女审判的流程吧……", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Margo001"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "但对我们来说，<br>\n这可不是能随便了事的事情。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Margo002"]}},
    {"op": "HideAllCharacters", "line": 83, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "艾玛她们好一阵子都留在了原地，<br>\n一动不动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative009"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "（说什么搜查……我根本就做不到……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Ema002"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "此时，<br>\n玛格最先行动，打破了现状。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Margo.Pensive1"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "既然是凶杀案，<br>\n就必须找出凶手。<br>\n否则，所有人都会死。", "AuthorId": "Margo", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Margo003"]}},
    {"op": "HideAllCharacters", "line": 95, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "玛格轻声说完，<br>\n离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative011"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "接着，可可和亚里沙也慢慢地走了出去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative012"]}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "雪莉也从沙发上下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 103, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "雪莉小姐，你现在的状态不适合活动……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 107, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "我可是名侦探哦？<br>\n怎么可能坐视不管……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Sherry001"]}},
    {"op": "HideAllCharacters", "line": 112, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "可能是因为没站稳，<br>\n雪莉的身体摇晃了一下。<br>\n梅露露急忙扶住她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "请你好好休息……！<br>\n要是雪莉小姐也出什么事的话……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Meruru002"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "不要。就算要爬着我也要调查……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 123, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR3"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "梅露露，<br>\n带雪莉去医务室吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Ema003"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "艾玛！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 135, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2,ArmR3"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "如果这真的是凶杀案的话……不，<br>\n就算不是，我也必须查明<br>\n汉娜死亡的真相。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Ema004"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "这是为了汉娜。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Ema005"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "艾玛平静地说完，<br>\n头也不回地离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv18_Narrative015"]}},
