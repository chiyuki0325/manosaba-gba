    {"op": "Wait", "line": 113, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 115, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "1_1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 116, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlayBgm", "line": 118, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "艾玛，<br>\n要一起去用餐吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna001"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "第二天早晨，汉娜来到牢房，<br>\n看到正在迷迷糊糊躺着的艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative018"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "啊，嗯……咦……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema008"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "（动不了了……<br>\n　浑身都好痛……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema009"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "汉娜俯身查看艾玛的脸，<br>\n随后将手放在她的额头上，<br>\n露出震惊的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "艾玛，你……！<br>\n天啊，发着这么高的烧！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna002"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "果然你的病还没有好……！<br>\n明明都叫你不要勉强自己了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna003"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "没什么大不了的，我没事……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema010"]}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "……怎么可能没事！？<br>\n而且你的手……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 146, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "汉娜颤抖着<br>\n握住艾玛的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "手上全是伤啊！<br>\n你到底在做什么！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna005"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "呃，我每天晚上都在挖土……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "一个个都这么傻……！<br>\n我身边怎么都是些笨蛋啊！<br>", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna006"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "啊哈哈……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema012"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "被汉娜责骂，艾玛无力地笑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "你要坚持住啊，<br>\n艾玛！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna007"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "我这就去叫雪莉和梅露露来！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Hanna008"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我……真的没事啦……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema013"]}},
    {"op": "HideAllCharacters", "line": 172, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "话音未落，<br>\n汉娜的身影已经消失了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative022"]}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "朦胧的意识不受控制，<br>\n渐渐又溶解在黑暗当中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative023"]}},
    {"op": "Gosub", "line": 178, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
