    {"op": "ModifyBackgroundExtended", "line": 21, "indent": 0, "params": {"Scale": [2.5], "Duration": 2.0, "Lazy": 0, "ScenePosition": [0.0, 100.0], "AppearanceAndTransition": "19_2", "SubId": "Middle"}},
    {"op": "Wait", "line": 22, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "她不愿浪费一分一秒的睡眠时间，<br>\n执着地挖掘着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative002"]}},
    {"op": "PlaySfxModified", "line": 26, "indent": 0, "params": {"SfxPath": "Sfx_59", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Ema.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "呼、呼、呼……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema001"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "擦去不断流淌的汗水，<br>\n艾玛继续挖掘。<br>\n长时间的作业让她的双手早已麻木。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "几天前的身体不适现今仍未痊愈，<br>\n她全身无力，低烧不断。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative004"]}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "每当入睡，同样的噩梦总会纠缠着她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative005"]}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "梦中的艾玛站在学校里，<br>\n透过教室窗户看到的景象几乎要击溃她的心灵。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative006"]}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "（这到底是怎么回事……<br>\n　难道说，我也在逐渐魔女化……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema002"]}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（好害怕睡觉……<br>\n　不想再做那个梦……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema003"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "为了逃避噩梦，<br>\n艾玛开始避免夜间入睡，全身心投入到挖掘工作中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative007"]}},
    {"op": "PlaySfxModified", "line": 49, "indent": 0, "params": {"SfxPath": "Sfx_59", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Ema.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "呼、呼、呼……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema004"]}},
    {"op": "HideAllCharacters", "line": 55, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "或许是因为睡眠不足，<br>\n艾玛的双眼显得空洞无神。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative008"]}},
    {"op": "StopSfx", "line": 59, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "——就在这时，铲子终于碰到了什么东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Ema.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "啊……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema005"]}},
    {"op": "HideAllCharacters", "line": 67, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "虽然夜色中看不太清楚，<br>\n但似乎是个盒子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative010"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "发现这个明显是经人埋藏的物品后，<br>\n艾玛的眼神重新焕发出光彩。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "（终于找到了……！<br>\n　这一定是通往外界的线索）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema006"]}},
    {"op": "HideAllCharacters", "line": 77, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "艾玛忘我地用手刨着土，<br>\n迫切地想要取出埋在地下的盒子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative012"]}},
    {"op": "PlaySfxModified", "line": 82, "indent": 0, "params": {"SfxPath": "Sfx_101", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "当她带着微笑打开盒子时——<br>\n里面只有一封信。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative013"]}},
    {"op": "UpdateWitchBook", "line": 89, "indent": 0, "params": {"Id": "10", "Category": "Note", "Version": 1}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "是之前被关在这里的囚犯少女留下的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative014"]}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "读完信的内容，<br>\n艾玛顿时失去了所有力气，跪倒在地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Ema.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "怎、怎么会……我所做的一切……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Ema007"]}},
    {"op": "StopBgm", "line": 99, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 100, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "——这座监牢根本没有逃脱的方法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative016"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "前人得出的这个残酷结论，<br>\n将艾玛推入了绝望的深渊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative017"]}},
    {"op": "UpdateWitchBook", "line": 109, "indent": 0, "params": {"Id": "11", "Category": "Note", "Version": 1}},
    {"op": "HidePrinter", "line": 111, "indent": 0, "params": {}},
