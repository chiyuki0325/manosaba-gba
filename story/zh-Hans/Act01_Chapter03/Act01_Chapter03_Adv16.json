    {"op": "PrintTextModified", "line": 14, "indent": 0, "params": {"Text": "自从发现可以在夜间活动后，<br>\n艾玛每晚都带着铲子<br>\n来到地图上标记的地点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv16_Narrative001"]}},
