    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "（一定会有什么通往自由的线索，<br>\n　之前的囚犯应该会留下来的——！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv03_Ema003"]}},
