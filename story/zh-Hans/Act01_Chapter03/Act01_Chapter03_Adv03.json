    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "小心翼翼地用指头摸了摸，<br>\n触碰到了一个坚硬而粗糙的物体。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv03_Narrative007"]}},
