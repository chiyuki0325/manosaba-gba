    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Sherry001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "啊，你看，<br>\n因为乱动所以恶化了……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Meruru001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "雪莉小姐，你的伤口很深，<br>\n现在根本不能活动……<br>\n我这就给你开镇静剂。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Normal1,ArmR3,ArmL4"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "……不，镇静剂就不用了。<br>\n吃了可能会想睡觉，<br>\n我现在得保持头脑清醒。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Sherry002"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "而且，距离审判的时间也不多了。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "你现在的状态根本不适合参加审判……<br>", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 51, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "雪莉，你好好休息吧。<br>\n我不会强迫你吃药……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Ema002"]}},
    {"op": "HideAllCharacters", "line": 56, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Pensive1,ArmR3,ArmL4"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "谢谢你，艾玛。<br>\n我真没用……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "搜查交给我就好。<br>\n我能在这里也调查一下吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Ema003"]}},
    {"op": "HideAllCharacters", "line": 66, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "好的，没问题。不过艾玛你也要注意，<br>\n不要太勉强自己。<br>\n毕竟你才刚病愈……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Meruru004"]}},
    {"op": "HideAllCharacters", "line": 71, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "尽管艾玛是出于关心雪莉才来的医务室，<br>\n不过姑且还是调查了一番。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Narrative003"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "（在我悠闲地睡觉的时候，<br>\n　汉娜她却……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Ema004"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "出于对自己的愤怒，<br>\n艾玛瞪着自己刚才睡过的床。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Narrative004"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "这时，<br>\n她发现床上掉着那张旧设计图。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Narrative005"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "那大概是<br>\n在艾玛睡觉时从口袋里掉出来的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Narrative006"]}},
