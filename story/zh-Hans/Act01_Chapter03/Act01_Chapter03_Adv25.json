    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（雪莉她没事吧……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Ema001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "艾玛来到医务室，<br>\n看到了在场的梅露露和雪莉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Narrative001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "梅露露正在查看雪莉的腿部状况。<br>\n缠绕的绷带上渗出了血迹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv25_Narrative002"]}},
