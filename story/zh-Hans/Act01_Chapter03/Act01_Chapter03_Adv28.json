    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "那个……我是在给艾玛做礼物，<br>\n希望能让你开心起来。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Hanna001"]}},
