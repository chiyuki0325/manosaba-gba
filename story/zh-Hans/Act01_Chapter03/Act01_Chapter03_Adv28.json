    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "那天晚上，<br>\n艾玛脚步虚浮地来到汉娜的牢房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative001"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "同屋的可可不在，<br>\n取而代之的是梅露露。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "……艾玛小姐，你也来了。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 25, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "梅露露在汉娜的床上，<br>\n摆放着几个少女的人偶。<br>\n这些应该都是她取下来的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative003"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "那些人偶都是汉娜亲手制作的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative004"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "梅露露的人偶。<br>\n雪莉的人偶。<br>\n汉娜的人偶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative005"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "艾玛将属于自己的人偶，轻轻放在了它们的旁边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative006"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "艾玛紧紧按住胸口，<br>\n感受着那温暖而微弱的光芒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative007"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "那是如此微小，<br>\n仿佛随时会消逝的希望之光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative008"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "那是汉娜和雪莉留下的遗物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative009"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "（我们，确实是朋友啊——）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Ema001"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "她想起之前和汉娜的一段对话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv28_Narrative010"]}},
