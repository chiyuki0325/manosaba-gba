    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "但、但是这把扫帚，<br>\n你要用来做什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Ema005"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "（难道是我孤陋寡闻，<br>\n　野餐还需要带扫帚吗……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Ema006"]}},
