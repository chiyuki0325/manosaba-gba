    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "毕竟总要有人<br>\n负责做饭、打扫和补充衣物呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Ema004"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "应该是在我们禁止外出的时间做这些事吧。<br>\n真是勤劳呢～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Sherry008"]}},
