    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "…………", "AuthorId": "Jailer", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Jailer001"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "看守一如既往地站在那里一动不动，<br>\n让人分不清是死是活。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Narrative006"]}},
