    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "看着雪莉闪闪发亮的眼神，<br>\n艾玛一脸困惑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Narrative007"]}},
