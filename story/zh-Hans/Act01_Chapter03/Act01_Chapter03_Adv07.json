    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "就知道是这件事～！<br>\n我也正这么想呢，你看！我找到了这个哦～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 36, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "雪莉得意洋洋地举起一把扫帚。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Narrative002"]}},
