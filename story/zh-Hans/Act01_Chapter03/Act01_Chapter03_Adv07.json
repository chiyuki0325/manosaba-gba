    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛走到玄关大厅时，<br>\n看到了雪莉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Narrative001"]}},
