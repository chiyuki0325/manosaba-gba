    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "欸，这是什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Ema002"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "扫帚啊！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Sherry003"]}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "这个我看得出来啦。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 49, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Pensive1,ArmR10,ArmL11"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "之前找的时候都没有那种特别有<br>\n“扫帚感”的，感觉很不满足……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR17,ArmL1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "所以我一直在找，<br>\n就是要找那种标准的扫帚！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Sherry005"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "清洁工具间里倒是没有，<br>\n但是！在玄关前发现了这个！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR6"}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "说着，<br>\n雪莉神秘兮兮地凑到艾玛耳边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Narrative003"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "她的目光，<br>\n投向了站在门口的看守。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Narrative004"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "那个看守，看起来蛮吓人的，<br>\n却会认真打扫呢……！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Sherry007"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "听到雪莉的悄悄话，<br>\n艾玛也不由得看向看守。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv07_Narrative005"]}},
