    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "（这是，弹痕……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv24_Ema007"]}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "艾玛想起刚才奈叶香拿枪指着她的事。<br>\n那时奈叶香并没有开枪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv24_Narrative013"]}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "（这是什么时候留下的呢……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv24_Ema008"]}},
