  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene1-3-12", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "16_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "目前来到花田的有<br>\n艾玛、雪莉、汉娜和梅露露四个人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "（尽管每个人我都邀了……<br>\n　不过到头来还是只有我们四个人……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "（虽然有些难受……<br>\n　但是，今天就让我们放下一切，好好享受吧！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema002"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "广阔的后院里绿草如茵，花团锦簇，<br>\n远处是一片蔚蓝的天空。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "汉娜和梅露露<br>\n已经开始在餐布上摆放食物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 26, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 27, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "这里视野真好～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "虽然总是有彩虹出现很诡异，<br>\n但在这种时候反而让人觉得开心呢。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna001"]}},
    {"op": "PlaySfxModified", "line": 35, "indent": 0, "params": {"SfxPath": "Sfx_31", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "大家请喝点热茶吧。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Meruru001"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "哇，谢谢梅露露！<br>\n能喝到热茶真开心！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema003"]}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "艾玛你不是身体不舒服吗，<br>\n如果觉得难受一定要说哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry002"]}},
    {"op": "HideAllCharacters", "line": 52, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "谢谢你，雪莉。<br>\n我已经没事了。应该是太累了吧。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema004"]}},
    {"op": "HideAllCharacters", "line": 57, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 58, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 60, "indent": 0, "params": {"Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "ScenePosition": [75.0, 60.0], "AppearanceAndTransition": "16_1", "SubId": "Middle"}},
    {"op": "Wait", "line": 61, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "AnimateActorExtended", "line": 63, "indent": 0, "params": {"ActorIds": ["MainBackground-Middle"], "Loop": 0, "ScenePositionX": "25", "Duration": "20"}},
    {"op": "Wait", "line": 64, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "大家一起享用着梅露露特制的三明治、<br>\n点心和热茶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative004"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "微风轻拂树叶，<br>\n沐浴在盛开的花香中，令人感觉格外惬意。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative005"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "（只是换个地方，<br>\n　就能让心情变得这么平静……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema005"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "（看来我们的确需要转换心情。<br>\n　以后也要多策划一些活动）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema006"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "（比如卡拉OK啊，游戏大会什么的……<br>\n　大家一起来玩的话，一定很开心）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema007"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "少女们一边吃着点心，<br>\n一边采摘花朵，欢声笑语着。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative006"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "她们难得地<br>\n度过了悠闲的时光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative007"]}},
    {"op": "ModifyBackgroundExtended", "line": 80, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "16_1", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "艾玛，你笑得真好看。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 86, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "是、是吗？可能因为好久没这样了，<br>\n不知不觉就很开心。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema008"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "和朋友待在一起，聊天说笑……<br>\n真的，好久没有这样了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema009"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "曾经与朋友欢笑的场景，<br>\n如雾般在脑海中浮现。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative008"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "伴随着莫名的心痛，<br>\n艾玛迅速甩开了这个画面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "对、对不起擅自说我们是朋友！<br>\n虽、虽说可能和朋友有点不一样！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema010"]}},
    {"op": "HideAllCharacters", "line": 103, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Flushed1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "是朋友没错哦。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 108, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "汉娜直截了当地说完，<br>\n害羞地扭过头去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "汉娜……谢谢你……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema011"]}},
    {"op": "HideAllCharacters", "line": 116, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "就是就是！我们已经是朋友了！<br>\n我们之后也要一直在一起，所以我们是“挚友”！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry004"]}},
    {"op": "HideAllCharacters", "line": 121, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "呃，这个词好像不是这样解释的啦。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna003"]}},
    {"op": "HideAllCharacters", "line": 126, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "好了，时间差不多了……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry005"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "在大家吃得差不多的时候，<br>\n雪莉站了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 135, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "哎呀，要回去了吗？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna004"]}},
    {"op": "HideAllCharacters", "line": 139, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "才不是呢。现在才是重头戏！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR11,ArmL10", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "锵锵！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry007"]}},
    {"op": "HideAllCharacters", "line": 148, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "雪莉不知从哪里拿出一把扫帚举了起来。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative012"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "（啊！是刚才拿着的扫帚！<br>\n　……到底要用来做什么呢？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "要用扫帚做什么？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna005"]}},
    {"op": "HideAllCharacters", "line": 158, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "汉娜似乎和艾玛有着同样的疑问，<br>\n向雪莉发问。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8,ArmL4", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "呵呵呵～你问得好！<br>\n我想让汉娜用它飞一飞！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry008"]}},
    {"op": "HideAllCharacters", "line": 166, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "什么……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna006"]}},
    {"op": "HideAllCharacters", "line": 171, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "啊啊！原来如此！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema013"]}},
    {"op": "HideAllCharacters", "line": 176, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "雪莉拿着扫帚向汉娜逼近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR8,ArmL4", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 181, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "说到魔女不就是骑扫帚飞行吗！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry009"]}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "我们不就是<br>\n打小看着骑扫帚飞行的魔女长大的吗！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR8,ArmL4", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "自从典狱长说到魔女，<br>\n我就一直想看这个！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "你在刚被抓来时的那种危险情况下<br>\n居然在想这种事！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR8,ArmL4", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "这把扫帚<br>\n可是承载着全人类的梦想！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry012"]}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "你在故意说得夸张想让我上当吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna008"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR11,ArmL10", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "汉娜快试试看嘛！<br>\n求你了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry013"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "雪莉把扫帚递到汉娜面前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Surprised1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "你、你不也是预备魔女吗！？<br>\n怎么你不自己来！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna009"]}},
    {"op": "ModifyCharacterExtended", "line": 211, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Normal1,ArmR11,ArmL10", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "我是名侦探，可飞不起来！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry014"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "而汉娜却能飞！<br>\n这是独一无二的特技！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry015"]}},
    {"op": "ModifyCharacterExtended", "line": 217, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Angry1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "别说是独一无二！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna010"]}},
    {"op": "ModifyCharacterExtended", "line": 221, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Sherry.Smile1,ArmR11,ArmL10", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "如果可以的话，让我在后面坐着吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry016"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "雪莉眼睛闪闪发亮，<br>\n露出了孩童般的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Pensive1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "唔、唔……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna011"]}},
    {"op": "HideAllCharacters", "line": 231, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "汉娜两眼湿湿地<br>\n向艾玛和梅露露投去求助的眼神。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative017"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "（对不起汉娜……<br>\n　这股气势恐怕谁也拦不住……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema014"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "如、如果有什么我能帮上忙的就好了……<br>\n但是对不起～～", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Meruru002"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "我实在是没办法飞行……<br>\n我该怎么办才好……啊哇哇哇……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Meruru003"]}},
    {"op": "HideAllCharacters", "line": 243, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "看到梅露露快要哭出来的样子，<br>\n汉娜无奈地叹了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "……知道了！<br>\n试试就试试吧！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna012"]}},
    {"op": "HideAllCharacters", "line": 251, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "汉娜一把抢过雪莉手中的扫帚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 255, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1,ArmR8,ArmL8", "SubId": "Middle"}},
    {"op": "EmoteJumpDouble", "line": 256, "indent": 0, "params": {"ActorIds": ["Sherry-Middle"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "太好了～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry017"]}},
    {"op": "HideAllCharacters", "line": 260, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "雪莉高兴得跳了起来。<br>\n艾玛也忍不住笑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative020"]}},
    {"op": "PrintTextModified", "line": 264, "indent": 0, "params": {"Text": "（汉娜其实挺好说话的呢……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Ema015"]}},
    {"op": "StopBgm", "line": 266, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "然后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative021"]}},
    {"op": "HidePrinter", "line": 270, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 271, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 272, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 274, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "40_1", "SubId": "Middle"}},
    {"op": "ModifyBackgroundExtended", "line": 275, "indent": 0, "params": {"TintColor": "#000000", "Duration": 0.800000011920929, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlayBgm", "line": 277, "indent": 0, "params": {"BgmPath": "Bgm_18_1_Loop", "IntroBgmPath": "Bgm_18_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "唔……好、好重……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna013"]}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "应雪莉的愿望，<br>\n汉娜正骑着扫帚飞行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative022"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "准确地说并不是骑着扫帚飞行，<br>\n而是手持扫帚飘浮在空中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative023"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "而且后面还载着雪莉，<br>\n所以只能摇摇晃晃地低空飞行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative024"]}},
    {"op": "AnimateActorExtended", "line": 287, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "40", "ScenePositionY": "30", "Scale": "2", "EasingTypeName": "Linear", "Duration": "5"}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "哇～！感觉自己变成魔女了～！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry018"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "不可以变成魔女啊！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna014"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "好～开～心～！！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry019"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "我可一点都不开心哇！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna015"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "汉娜一脸辛苦地<br>\n勉强维持着飞行的姿态。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative025"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "为了实现雪莉的愿望，<br>\n她涨红着脸，拼命不让自己掉下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative026"]}},
    {"op": "QuickSave", "line": 301, "indent": 0, "params": {"SlotNumber": 12, "Wait": 0}},
    {"op": "AnimateActorExtended", "line": 302, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "80", "ScenePositionY": "50", "Scale": "1.6", "EasingTypeName": "Linear", "Duration": "5"}},
    {"op": "PrintTextModified", "line": 304, "indent": 0, "params": {"Text": "就这样飞过围墙吧！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry020"]}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "你傻了吗！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna016"]}},
    {"op": "PrintTextModified", "line": 308, "indent": 0, "params": {"Text": "要是能飞过围墙的话，<br>\n我肯定会把你和扫帚都丢下去！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna017"]}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "欸～<br>\n不能用扫帚之力想想办法吗～？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry021"]}},
    {"op": "AnimateActorExtended", "line": 312, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "50", "ScenePositionY": "50", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "EasingTypeName": "Linear", "Duration": "5"}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "这只是清洁用的扫帚又不是魔法扫帚！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna018"]}},
    {"op": "PrintTextModified", "line": 316, "indent": 0, "params": {"Text": "真想把你丢下去啊～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna019"]}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "请不要丢下我～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry022"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "别贴这么近啦～！好热～！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna020"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "雪莉她——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative027"]}},
    {"op": "AddChoice", "line": 324, "indent": 0, "params": {"ChoiceSummary": "贴得更紧了", "Lock": 0, "ButtonPath": "ChoiceButtons/Adv/Bad", "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0103Adv12_Choice001"]}},
    {"op": "GotoModified", "line": 325, "indent": 1, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Bad02", "ResetState": ["-"]}},
    {"op": "AddChoice", "line": 327, "indent": 0, "params": {"ChoiceSummary": "稍微拉开了距离", "Lock": 0, "AutoPlay": 1, "ShowHandler": 1}, "text_ids": {"ChoiceSummary": ["0103Adv12_Choice002"]}},
    {"op": "GotoModified", "line": 328, "indent": 1, "params": {"Path": ".Choice1-3-2"}},
    {"op": "StopForChoice", "line": 330, "indent": 0, "params": {"Clear": 0}},
    {"op": "label", "name": "Choice1-3-2", "line": 332, "indent": 0},
    {"op": "RecordCorrectChoice", "line": 334, "indent": 0, "params": {"Number": 12}},
    {"op": "AnimateActorExtended", "line": 336, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "40", "ScenePositionY": "30", "Scale": "2", "EasingTypeName": "Linear", "Duration": "5"}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "哇哦，要好好保持平衡哦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Sherry023"]}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "你还好意思说！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Hanna021"]}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "雪莉和汉娜一边嬉闹着，<br>\n一边在蓝天中飞翔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative028"]}},
    {"op": "AnimateActorExtended", "line": 344, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "-20", "ScenePositionY": "90", "Scale": "2.5", "EasingTypeName": "Linear", "Duration": "5"}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "两人摇摇晃晃地飞向远方，<br>\n渐渐听不见她们的对话了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative029"]}},
    {"op": "PrintTextModified", "line": 348, "indent": 0, "params": {"Text": "梅露露和艾玛看着她们，<br>\n不禁露出了笑容。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv12_Narrative030"]}},
    {"op": "Gosub", "line": 350, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 352, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv13", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv12_Narrative001": "目前来到花田的有<br>\n艾玛、雪莉、汉娜和梅露露四个人。",
  "0103Adv12_Ema001": "（尽管每个人我都邀了……<br>\n　不过到头来还是只有我们四个人……）",
  "0103Adv12_Ema002": "（虽然有些难受……<br>\n　但是，今天就让我们放下一切，好好享受吧！）",
  "0103Adv12_Narrative002": "广阔的后院里绿草如茵，花团锦簇，<br>\n远处是一片蔚蓝的天空。",
  "0103Adv12_Narrative003": "汉娜和梅露露<br>\n已经开始在餐布上摆放食物。",
  "0103Adv12_Sherry001": "这里视野真好～！",
  "0103Adv12_Hanna001": "虽然总是有彩虹出现很诡异，<br>\n但在这种时候反而让人觉得开心呢。",
  "0103Adv12_Meruru001": "大家请喝点热茶吧。",
  "0103Adv12_Ema003": "哇，谢谢梅露露！<br>\n能喝到热茶真开心！",
  "0103Adv12_Sherry002": "艾玛你不是身体不舒服吗，<br>\n如果觉得难受一定要说哦！",
  "0103Adv12_Ema004": "谢谢你，雪莉。<br>\n我已经没事了。应该是太累了吧。",
  "0103Adv12_Narrative004": "大家一起享用着梅露露特制的三明治、<br>\n点心和热茶。",
  "0103Adv12_Narrative005": "微风轻拂树叶，<br>\n沐浴在盛开的花香中，令人感觉格外惬意。",
  "0103Adv12_Ema005": "（只是换个地方，<br>\n　就能让心情变得这么平静……）",
  "0103Adv12_Ema006": "（看来我们的确需要转换心情。<br>\n　以后也要多策划一些活动）",
  "0103Adv12_Ema007": "（比如卡拉OK啊，游戏大会什么的……<br>\n　大家一起来玩的话，一定很开心）",
  "0103Adv12_Narrative006": "少女们一边吃着点心，<br>\n一边采摘花朵，欢声笑语着。",
  "0103Adv12_Narrative007": "她们难得地<br>\n度过了悠闲的时光。",
  "0103Adv12_Sherry003": "艾玛，你笑得真好看。",
  "0103Adv12_Ema008": "是、是吗？可能因为好久没这样了，<br>\n不知不觉就很开心。",
  "0103Adv12_Ema009": "和朋友待在一起，聊天说笑……<br>\n真的，好久没有这样了……",
  "0103Adv12_Narrative008": "曾经与朋友欢笑的场景，<br>\n如雾般在脑海中浮现。",
  "0103Adv12_Narrative009": "伴随着莫名的心痛，<br>\n艾玛迅速甩开了这个画面。",
  "0103Adv12_Ema010": "对、对不起擅自说我们是朋友！<br>\n虽、虽说可能和朋友有点不一样！",
  "0103Adv12_Hanna002": "是朋友没错哦。",
  "0103Adv12_Narrative010": "汉娜直截了当地说完，<br>\n害羞地扭过头去。",
  "0103Adv12_Ema011": "汉娜……谢谢你……",
  "0103Adv12_Sherry004": "就是就是！我们已经是朋友了！<br>\n我们之后也要一直在一起，所以我们是“挚友”！",
  "0103Adv12_Hanna003": "呃，这个词好像不是这样解释的啦。",
  "0103Adv12_Sherry005": "好了，时间差不多了……",
  "0103Adv12_Narrative011": "在大家吃得差不多的时候，<br>\n雪莉站了起来。",
  "0103Adv12_Hanna004": "哎呀，要回去了吗？",
  "0103Adv12_Sherry006": "才不是呢。现在才是重头戏！",
  "0103Adv12_Sherry007": "锵锵！",
  "0103Adv12_Narrative012": "雪莉不知从哪里拿出一把扫帚举了起来。<br>",
  "0103Adv12_Ema012": "（啊！是刚才拿着的扫帚！<br>\n　……到底要用来做什么呢？）",
  "0103Adv12_Hanna005": "要用扫帚做什么？",
  "0103Adv12_Narrative013": "汉娜似乎和艾玛有着同样的疑问，<br>\n向雪莉发问。",
  "0103Adv12_Sherry008": "呵呵呵～你问得好！<br>\n我想让汉娜用它飞一飞！",
  "0103Adv12_Hanna006": "什么……",
  "0103Adv12_Ema013": "啊啊！原来如此！",
  "0103Adv12_Narrative014": "雪莉拿着扫帚向汉娜逼近。",
  "0103Adv12_Sherry009": "说到魔女不就是骑扫帚飞行吗！？",
  "0103Adv12_Sherry010": "我们不就是<br>\n打小看着骑扫帚飞行的魔女长大的吗！？",
  "0103Adv12_Sherry011": "自从典狱长说到魔女，<br>\n我就一直想看这个！",
  "0103Adv12_Hanna007": "你在刚被抓来时的那种危险情况下<br>\n居然在想这种事！？",
  "0103Adv12_Sherry012": "这把扫帚<br>\n可是承载着全人类的梦想！",
  "0103Adv12_Hanna008": "你在故意说得夸张想让我上当吧！？",
  "0103Adv12_Sherry013": "汉娜快试试看嘛！<br>\n求你了！",
  "0103Adv12_Narrative015": "雪莉把扫帚递到汉娜面前。",
  "0103Adv12_Hanna009": "你、你不也是预备魔女吗！？<br>\n怎么你不自己来！？",
  "0103Adv12_Sherry014": "我是名侦探，可飞不起来！",
  "0103Adv12_Sherry015": "而汉娜却能飞！<br>\n这是独一无二的特技！",
  "0103Adv12_Hanna010": "别说是独一无二！",
  "0103Adv12_Sherry016": "如果可以的话，让我在后面坐着吧！",
  "0103Adv12_Narrative016": "雪莉眼睛闪闪发亮，<br>\n露出了孩童般的表情。",
  "0103Adv12_Hanna011": "唔、唔……",
  "0103Adv12_Narrative017": "汉娜两眼湿湿地<br>\n向艾玛和梅露露投去求助的眼神。",
  "0103Adv12_Ema014": "（对不起汉娜……<br>\n　这股气势恐怕谁也拦不住……）",
  "0103Adv12_Meruru002": "如、如果有什么我能帮上忙的就好了……<br>\n但是对不起～～",
  "0103Adv12_Meruru003": "我实在是没办法飞行……<br>\n我该怎么办才好……啊哇哇哇……",
  "0103Adv12_Narrative018": "看到梅露露快要哭出来的样子，<br>\n汉娜无奈地叹了口气。",
  "0103Adv12_Hanna012": "……知道了！<br>\n试试就试试吧！",
  "0103Adv12_Narrative019": "汉娜一把抢过雪莉手中的扫帚。",
  "0103Adv12_Sherry017": "太好了～！",
  "0103Adv12_Narrative020": "雪莉高兴得跳了起来。<br>\n艾玛也忍不住笑了。",
  "0103Adv12_Ema015": "（汉娜其实挺好说话的呢……）",
  "0103Adv12_Narrative021": "然后——",
  "0103Adv12_Hanna013": "唔……好、好重……",
  "0103Adv12_Narrative022": "应雪莉的愿望，<br>\n汉娜正骑着扫帚飞行。",
  "0103Adv12_Narrative023": "准确地说并不是骑着扫帚飞行，<br>\n而是手持扫帚飘浮在空中。",
  "0103Adv12_Narrative024": "而且后面还载着雪莉，<br>\n所以只能摇摇晃晃地低空飞行。",
  "0103Adv12_Sherry018": "哇～！感觉自己变成魔女了～！",
  "0103Adv12_Hanna014": "不可以变成魔女啊！",
  "0103Adv12_Sherry019": "好～开～心～！！",
  "0103Adv12_Hanna015": "我可一点都不开心哇！？",
  "0103Adv12_Narrative025": "汉娜一脸辛苦地<br>\n勉强维持着飞行的姿态。",
  "0103Adv12_Narrative026": "为了实现雪莉的愿望，<br>\n她涨红着脸，拼命不让自己掉下来。",
  "0103Adv12_Sherry020": "就这样飞过围墙吧！",
  "0103Adv12_Hanna016": "你傻了吗！？",
  "0103Adv12_Hanna017": "要是能飞过围墙的话，<br>\n我肯定会把你和扫帚都丢下去！",
  "0103Adv12_Sherry021": "欸～<br>\n不能用扫帚之力想想办法吗～？",
  "0103Adv12_Hanna018": "这只是清洁用的扫帚又不是魔法扫帚！",
  "0103Adv12_Hanna019": "真想把你丢下去啊～！",
  "0103Adv12_Sherry022": "请不要丢下我～",
  "0103Adv12_Hanna020": "别贴这么近啦～！好热～！",
  "0103Adv12_Narrative027": "雪莉她——",
  "0103Adv12_Choice001": "贴得更紧了",
  "0103Adv12_Choice002": "稍微拉开了距离",
  "0103Adv12_Sherry023": "哇哦，要好好保持平衡哦！",
  "0103Adv12_Hanna021": "你还好意思说！？",
  "0103Adv12_Narrative028": "雪莉和汉娜一边嬉闹着，<br>\n一边在蓝天中飞翔。",
  "0103Adv12_Narrative029": "两人摇摇晃晃地飞向远方，<br>\n渐渐听不见她们的对话了。",
  "0103Adv12_Narrative030": "梅露露和艾玛看着她们，<br>\n不禁露出了笑容。"
}
}
