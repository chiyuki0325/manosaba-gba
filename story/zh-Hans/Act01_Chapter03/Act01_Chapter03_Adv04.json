    {"op": "label", "name": "Scene1-3-4", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "那天早晨，艾玛难得地感觉精神焕发。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "（好像退烧了……！<br>\n　身体比平时轻松多了）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "艾玛立刻给雪莉、汉娜和梅露露<br>\n发送消息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative002"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "『我病已经好了！』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative003"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "『今天终于可以去野餐了！』", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative004"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "三人很快就回复了同意，<br>\n艾玛带着笑容走向过道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative005"]}},
    {"op": "ResetText", "line": 28, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 29, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 30, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 32, "indent": 0, "params": {"Rotation": [0.0, 0.0, 0.0], "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "2_1"}},
    {"op": "ModifyBackgroundExtended", "line": 33, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 34, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Smile"}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "啊，艾玛小姐。早上好。<br>\n太好了，你终于康复了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru001"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "梅露露早上好！<br>\n让大家这么担心真是对不起。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema002"]}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "你这是要去吃早餐吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema003"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "啊，不是的。既然决定要野餐了，<br>\n我正要去医务室准备便当……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru002"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "欸？能在医务室做便当吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema004"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "我还以为是<br>\n要把食堂的那个装进篮子里呢。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "那个……监牢外面长着很多野草和香草……<br>\n我已经采集了一些。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru003"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "如果去森林那边，还能找到蘑菇和野果。<br>\n不过采蘑菇的时候要特别小心……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru004"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "欸……！之前我都不知道……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema006"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Default"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "我觉得<br>\n如果总是吃食堂的东西会很单调。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru005"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "我希望能让大家露出哪怕一点笑容。<br>\n这是我唯一能做到的事了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru006"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "梅露露真是温柔啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema007"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Flushed"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "听到艾玛的夸奖，梅露露害羞地脸红了，<br>\n但很快又露出忧虑的神色。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Meruru.Pensive"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "奈叶香小姐应该也是靠这些食物<br>\n维持生活吧……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru007"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "我很担心<br>\n她会不会挨饿……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru008"]}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "（是啊……奈叶香还是下落不明……<br>\n　为什么一直找不到她呢？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema008"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "一直在外面生活，一定很辛苦吧……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru009"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "我们也得继续寻找奈叶香。<br>\n要是她已经成功越狱就好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema009"]}},
    {"op": "StopBgm", "line": 91, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 92, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "艾玛和梅露露一边交谈，<br>\n一边朝医务室走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative007"]}},
    {"op": "ResetText", "line": 96, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 97, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 98, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 100, "indent": 0, "params": {"Scale": [1.7999999523162842], "Duration": 0.0, "Lazy": 0, "ScenePosition": [90.0, 70.0], "AppearanceAndTransition": "7_2"}},
    {"op": "ModifyBackgroundExtended", "line": 102, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 103, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Scale": [1.2000000476837158], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "走进医务室时——里面已经有人在了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative008"]}},
    {"op": "PlayBgm", "line": 109, "indent": 0, "params": {"BgmPath": "Bgm_35_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "亚里沙正蹲在药品柜前翻找着什么，<br>\n各种药瓶散落在她的脚边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Scale": [1.2000000476837158], "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Surprised"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Alisa001"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "发现艾玛和梅露露进来，<br>\n亚里沙浑身僵硬，一脸尴尬。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 121, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 122, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "7_2", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "亚里沙……你这是在做什么……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema010"]}},
    {"op": "HideAllCharacters", "line": 128, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Alisa.Angry1,Option-ArmL-Off,ArmL2", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "关你什么事！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Alisa002"]}},
    {"op": "HideAllCharacters", "line": 133, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "虽然态度强硬，<br>\n但亚里沙还是大步朝梅露露走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative011"]}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off,ArmL2", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "冰上——那个东西在哪里？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Alisa003"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "（那个东西……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema011"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "……不、不能给你……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru010"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "啊啊？！你是想违抗我吗！！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Alisa004"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Alisa.Angry1,ArmL7", "SubId": "Front"}},
    {"op": "AnimateActorExtended", "line": 153, "indent": 0, "params": {"ActorIds": ["Alisa-Front"], "Loop": 0, "ScenePositionX": "55"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "亚里沙抓住梅露露的衣领威胁道。<br>\n她的样子看起来异常急切。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 158, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Alisa.Angry1,ArmL7", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 159, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Angry1,ArmR1,ArmL13", "SubId": "Front"}},
    {"op": "ModifyCharacterExtended", "line": 160, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "虽、虽然不知道发生了什么，<br>\n但请不要使用暴力！！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema012"]}},
    {"op": "ModifyCharacterExtended", "line": 164, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Alisa.Angry1,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "啧……", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Alisa005"]}},
    {"op": "HideActors", "line": 168, "indent": 0, "params": {"ActorIds": ["Alisa-Front"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "亚里沙猛地松开梅露露，<br>\n快步逃离了医务室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 172, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "咳咳……咳咳咳……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru011"]}},
    {"op": "ModifyCharacterExtended", "line": 176, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Pensive1,ArmR3,ArmL1", "SubId": "Front"}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "梅露露，你没事吧！？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema013"]}},
    {"op": "HideAllCharacters", "line": 180, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "艾玛轻抚着跪倒在地上的梅露露的背。<br>\n梅露露的眉头紧锁，露出悲伤的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3", "SubId": "Middle"}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "梅露露，那个……<br>\n亚里沙是不是和你起了什么冲突……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema014"]}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "梅露露犹豫了一会，<br>\n终于缓缓开口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative015"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "……刚被关进来的时候，<br>\n亚里沙小姐说她睡不着觉。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru012"]}},
    {"op": "ModifyCharacterExtended", "line": 193, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "因为药品柜里有镇定剂和安眠药，<br>\n我就给了她一些……<br>\n但是亚里沙小姐似乎有过量服药的情况……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru013"]}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "过量用药……这样很危险呢……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema015"]}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "是、是的。她很快就把药吃完了，<br>\n然后不断索要更多……<br>\n这样对身体会造成很大伤害。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru014"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "我真是太轻率了……！<br>\n看到亚里沙小姐那么痛苦，我就……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru015"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "梅露露的脸因悲伤而扭曲，似乎随时都要哭出来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 207, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "我无法辩解……<br>\n我就是个帮凶……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru016"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "别、别那么自责！<br>\n梅露露只是出于关心亚里沙，<br>\n而且亚里沙现在不是还好好的吗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema016"]}},
    {"op": "PrintTextModified", "line": 213, "indent": 0, "params": {"Text": "是的……目前还没有出现不良反应……<br>\n但是，以后会怎样谁也说不准……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru017"]}},
    {"op": "HideAllCharacters", "line": 215, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "梅露露摇摇晃晃地站起身，<br>\n走向病床。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative017"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "从床单的缝隙中，<br>\n小心翼翼地取出一瓶药。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative018"]}},
    {"op": "SpawnExtended", "line": 222, "indent": 0, "params": {"Path": "Clue", "Params": ["4-3"]}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "这就是亚里沙小姐一直在找的安眠药。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru018"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "因为效果特别好，<br>\n所以变成了亚里沙小姐最依赖的东西。", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru019"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Pensive", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "所以我把这个药藏了起来，<br>\n告诉她暂时不能再给她这种药了……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru020"]}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "我本来没打算一直藏着的，<br>\n准备过段时间再给她……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru021"]}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "（原来是这样……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema017"]}},
    {"op": "HideAllCharacters", "line": 238, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 239, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1,ArmR1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "……梅露露，我们来准备野餐的便当吧！<br>\n需要我帮什么忙吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema018"]}},
    {"op": "HideAllCharacters", "line": 243, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "看到梅露露一副自责的样子，<br>\n艾玛试图用开朗的语气给她打气。<br>\n梅露露这才终于露出一丝微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 247, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Smile", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "说得对呢……今天是野餐日呢。<br>\n让我们做一个能让大家开心的便当吧……！", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru022"]}},
    {"op": "HideAllCharacters", "line": 251, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "嗯！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema019"]}},
    {"op": "HideAllCharacters", "line": 256, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 257, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Meruru.Default", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 259, "indent": 0, "params": {"Text": "我去准备食材，<br>\n那个……", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru023"]}},
    {"op": "PrintTextModified", "line": 261, "indent": 0, "params": {"Text": "艾玛小姐，<br>\n你能帮忙整理一下这些药品吗……？", "AuthorId": "Meruru", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Meruru024"]}},
    {"op": "HideAllCharacters", "line": 263, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 264, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1", "SubId": "Middle"}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "当然可以！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema020"]}},
    {"op": "HideAllCharacters", "line": 268, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "艾玛开始捡起散落在药品柜前的药瓶。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative020"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "（虽然之前没仔细看过这里，<br>\n　但真是有好多药啊……）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Ema021"]}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "虽然有些药品的用途显而易见，<br>\n但也有许多药品的用途完全不明。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv04_Narrative021"]}},
    {"op": "Gosub", "line": 276, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 278, "indent": 0, "params": {"Path": "Act01_Chapter03/Act01_Chapter03_Adv05", "SoftReset": 1}}
  ],
  "translations": {
  "0103Adv04_Narrative001": "那天早晨，艾玛难得地感觉精神焕发。",
  "0103Adv04_Ema001": "（好像退烧了……！<br>\n　身体比平时轻松多了）",
  "0103Adv04_Narrative002": "艾玛立刻给雪莉、汉娜和梅露露<br>\n发送消息。",
  "0103Adv04_Narrative003": "『我病已经好了！』",
  "0103Adv04_Narrative004": "『今天终于可以去野餐了！』",
  "0103Adv04_Narrative005": "三人很快就回复了同意，<br>\n艾玛带着笑容走向过道。",
  "0103Adv04_Meruru001": "啊，艾玛小姐。早上好。<br>\n太好了，你终于康复了……",
  "0103Adv04_Ema002": "梅露露早上好！<br>\n让大家这么担心真是对不起。",
  "0103Adv04_Ema003": "你这是要去吃早餐吗？",
  "0103Adv04_Meruru002": "啊，不是的。既然决定要野餐了，<br>\n我正要去医务室准备便当……",
  "0103Adv04_Ema004": "欸？能在医务室做便当吗？",
  "0103Adv04_Ema005": "我还以为是<br>\n要把食堂的那个装进篮子里呢。",
  "0103Adv04_Meruru003": "那个……监牢外面长着很多野草和香草……<br>\n我已经采集了一些。",
  "0103Adv04_Meruru004": "如果去森林那边，还能找到蘑菇和野果。<br>\n不过采蘑菇的时候要特别小心……",
  "0103Adv04_Ema006": "欸……！之前我都不知道……！",
  "0103Adv04_Meruru005": "我觉得<br>\n如果总是吃食堂的东西会很单调。",
  "0103Adv04_Meruru006": "我希望能让大家露出哪怕一点笑容。<br>\n这是我唯一能做到的事了……",
  "0103Adv04_Ema007": "梅露露真是温柔啊……",
  "0103Adv04_Narrative006": "听到艾玛的夸奖，梅露露害羞地脸红了，<br>\n但很快又露出忧虑的神色。",
  "0103Adv04_Meruru007": "奈叶香小姐应该也是靠这些食物<br>\n维持生活吧……",
  "0103Adv04_Meruru008": "我很担心<br>\n她会不会挨饿……",
  "0103Adv04_Ema008": "（是啊……奈叶香还是下落不明……<br>\n　为什么一直找不到她呢？）",
  "0103Adv04_Meruru009": "一直在外面生活，一定很辛苦吧……",
  "0103Adv04_Ema009": "我们也得继续寻找奈叶香。<br>\n要是她已经成功越狱就好了……",
  "0103Adv04_Narrative007": "艾玛和梅露露一边交谈，<br>\n一边朝医务室走去。",
  "0103Adv04_Narrative008": "走进医务室时——里面已经有人在了。",
  "0103Adv04_Narrative009": "亚里沙正蹲在药品柜前翻找着什么，<br>\n各种药瓶散落在她的脚边。",
  "0103Adv04_Alisa001": "！",
  "0103Adv04_Narrative010": "发现艾玛和梅露露进来，<br>\n亚里沙浑身僵硬，一脸尴尬。",
  "0103Adv04_Ema010": "亚里沙……你这是在做什么……？",
  "0103Adv04_Alisa002": "关你什么事！！",
  "0103Adv04_Narrative011": "虽然态度强硬，<br>\n但亚里沙还是大步朝梅露露走去。",
  "0103Adv04_Alisa003": "冰上——那个东西在哪里？",
  "0103Adv04_Ema011": "（那个东西……？）",
  "0103Adv04_Meruru010": "……不、不能给你……",
  "0103Adv04_Alisa004": "啊啊？！你是想违抗我吗！！",
  "0103Adv04_Narrative012": "亚里沙抓住梅露露的衣领威胁道。<br>\n她的样子看起来异常急切。",
  "0103Adv04_Ema012": "虽、虽然不知道发生了什么，<br>\n但请不要使用暴力！！",
  "0103Adv04_Alisa005": "啧……",
  "0103Adv04_Narrative013": "亚里沙猛地松开梅露露，<br>\n快步逃离了医务室。",
  "0103Adv04_Meruru011": "咳咳……咳咳咳……",
  "0103Adv04_Ema013": "梅露露，你没事吧！？",
  "0103Adv04_Narrative014": "艾玛轻抚着跪倒在地上的梅露露的背。<br>\n梅露露的眉头紧锁，露出悲伤的表情。",
  "0103Adv04_Ema014": "梅露露，那个……<br>\n亚里沙是不是和你起了什么冲突……？",
  "0103Adv04_Narrative015": "梅露露犹豫了一会，<br>\n终于缓缓开口。",
  "0103Adv04_Meruru012": "……刚被关进来的时候，<br>\n亚里沙小姐说她睡不着觉。",
  "0103Adv04_Meruru013": "因为药品柜里有镇定剂和安眠药，<br>\n我就给了她一些……<br>\n但是亚里沙小姐似乎有过量服药的情况……",
  "0103Adv04_Ema015": "过量用药……这样很危险呢……",
  "0103Adv04_Meruru014": "是、是的。她很快就把药吃完了，<br>\n然后不断索要更多……<br>\n这样对身体会造成很大伤害。",
  "0103Adv04_Meruru015": "我真是太轻率了……！<br>\n看到亚里沙小姐那么痛苦，我就……",
  "0103Adv04_Narrative016": "梅露露的脸因悲伤而扭曲，似乎随时都要哭出来。",
  "0103Adv04_Meruru016": "我无法辩解……<br>\n我就是个帮凶……",
  "0103Adv04_Ema016": "别、别那么自责！<br>\n梅露露只是出于关心亚里沙，<br>\n而且亚里沙现在不是还好好的吗。",
  "0103Adv04_Meruru017": "是的……目前还没有出现不良反应……<br>\n但是，以后会怎样谁也说不准……",
  "0103Adv04_Narrative017": "梅露露摇摇晃晃地站起身，<br>\n走向病床。",
  "0103Adv04_Narrative018": "从床单的缝隙中，<br>\n小心翼翼地取出一瓶药。",
  "0103Adv04_Meruru018": "这就是亚里沙小姐一直在找的安眠药。",
  "0103Adv04_Meruru019": "因为效果特别好，<br>\n所以变成了亚里沙小姐最依赖的东西。",
  "0103Adv04_Meruru020": "所以我把这个药藏了起来，<br>\n告诉她暂时不能再给她这种药了……",
  "0103Adv04_Meruru021": "我本来没打算一直藏着的，<br>\n准备过段时间再给她……",
  "0103Adv04_Ema017": "（原来是这样……）",
  "0103Adv04_Ema018": "……梅露露，我们来准备野餐的便当吧！<br>\n需要我帮什么忙吗？",
  "0103Adv04_Narrative019": "看到梅露露一副自责的样子，<br>\n艾玛试图用开朗的语气给她打气。<br>\n梅露露这才终于露出一丝微笑。",
  "0103Adv04_Meruru022": "说得对呢……今天是野餐日呢。<br>\n让我们做一个能让大家开心的便当吧……！",
  "0103Adv04_Ema019": "嗯！",
  "0103Adv04_Meruru023": "我去准备食材，<br>\n那个……",
  "0103Adv04_Meruru024": "艾玛小姐，<br>\n你能帮忙整理一下这些药品吗……？",
  "0103Adv04_Ema020": "当然可以！",
  "0103Adv04_Narrative020": "艾玛开始捡起散落在药品柜前的药瓶。",
  "0103Adv04_Ema021": "（虽然之前没仔细看过这里，<br>\n　但真是有好多药啊……）",
  "0103Adv04_Narrative021": "虽然有些药品的用途显而易见，<br>\n但也有许多药品的用途完全不明。"
}
}
