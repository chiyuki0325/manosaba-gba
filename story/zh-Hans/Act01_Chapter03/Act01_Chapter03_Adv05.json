    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "在梅露露准备便当的时候，<br>\n艾玛决定去叫雪莉和汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv05_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "（今天是放松的日子，换个心情好好享受吧！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv05_Ema001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "可没走几步，<br>\n刚才见到的亚里沙的样子就浮现在脑海中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv05_Narrative002"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "（好久没见到亚里沙了呢。<br>\n　不知道玛格和可可她们在做什么……？）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv05_Ema002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Determined2"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "……好！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv05_Ema003"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "艾玛抬起头，眼神中闪烁着坚定的光芒。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv05_Narrative003"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（不只是叫上雪莉和汉娜，<br>\n　要把大家都邀请来！）", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0103Adv05_Ema004"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
