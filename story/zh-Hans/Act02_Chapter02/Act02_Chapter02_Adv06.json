  "language": "zh-Hans",
  "path": "Act02_Chapter02/Act02_Chapter02_Adv06",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-2-6", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "29_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 20, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "啊，希罗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Ema001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "来到被诺亚用作画室的房间，<br>\n碰上了艾玛和汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "……你们在这里做什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 29, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Normal1,ArmR3"}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "我们也打算参加蕾雅的舞台剧制作。<br>", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Ema002"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "于是，汉娜就负责当服装师了。<br>", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Ema003"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "真叫人头疼哇。<br>\n本小姐怎么就要负责做舞台服了……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "尽管她嘴上抱怨，<br>\n手里却在熟练地做着针线活。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative002"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "（干活很麻利。看来她很擅长裁缝工作）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hiro002"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "为什么选择来这里干活？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "因为这里挺宽敞的，比较方便做事。<br>\n我们也需要足够的空间<br>\n去摆放材料和制作好的舞台服。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna002"]}},
    {"op": "HideAllCharacters", "line": 47, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "我环视整个房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative003"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "不知什么时候，房里多了几个油漆桶。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative004"]}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "桶里满满都是色彩缤纷的油漆。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative005"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "大概是诺亚从某处找来，并存放在这里的吧。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative006"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "虽然整个房间有点脏脏的，<br>\n但里面有一张大桌子，空间也够宽敞。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative007"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "（的确，这个房间应该很适合干活）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema"}},
    {"op": "ModifyCharacterExtended", "line": 62, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "剧目已经定好是《小飞侠》了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna003"]}},
    {"op": "ModifyCharacterExtended", "line": 66, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Smile1"}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "艾玛负责饰演温蒂哦！<br>\n我会做一套精美的舞台服，<br>\n请好好期待吧！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna004"]}},
    {"op": "ModifyCharacterExtended", "line": 70, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "好、好的，谢谢。<br>\n其实我也不知道，现在还在做这种事真的好吗……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Ema004"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "（这家伙忸怩作态的样子真让人来气……<br>\n　再聊下去只会让我压力越来越大）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 76, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "我远离那两人，<br>\n再次仔细调查房间里的情况。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative008"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "画室里只能透进微弱的光，<br>\n而且每次来都是乱糟糟的样子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative009"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "石膏像上有着细小的裂纹，<br>\n工作桌上密布着各种工具刻下的痕迹。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative010"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "还摆放着许多没有画完的油画，<br>\n但并不是诺亚的手笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative011"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "（看来有必要彻底打扫一次）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hiro006"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "不过，地上散乱的画纸上的内容变了。<br>\n看来，至少还是会定期扔进垃圾桶的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative012"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "从阳台俯瞰中庭，<br>\n正下方就是高耸的尖锐铁栅栏。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative013"]}},
    {"op": "PlaySfxModified", "line": 93, "indent": 0, "params": {"SfxPath": "Sfx_126", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "艾玛，汉娜！<br>\n让你们久等啦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 97, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Normal1,ArmR11"}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "随着一阵吵闹的脚步声，<br>\n雪莉跑进了画室，我也回过头来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "EmoteJump", "line": 102, "indent": 0, "params": {"ActorIds": ["Sherry"], "Loop": 0, "Speed": 1.0}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "给，收着吧！我已经把所有能找到的绿色布料<br>\n全都拿过来了！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry002"]}},
    {"op": "PlaySfxModified", "line": 107, "indent": 0, "params": {"SfxPath": "Sfx_41", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "雪莉把怀里满满一摞绿色布料<br>\n放在工作桌上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 111, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "你好厉害啊。居然能找到这么多，<br>\n都是在哪里找到的？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Sherry.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "我把各个房间里的<br>\n窗帘和桌布什么的全都扯下来了！<br>", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "你这是在干什么！？<br>\n未免也太离谱了吧！<br>\n而且，根本用不到这么多呀！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna005"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "见汉娜大发脾气，<br>\n雪莉便把窗帘摊开给她看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "你有没有在网红影片里<br>\n看过这种东西！？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry004"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "什么意思……？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna006"]}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "绿幕呀！<br>\n用来抠掉背景合成影片的那个东西！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry005"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "啊～……在天气预报里见到过。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna007"]}},
    {"op": "ModifyCharacterExtended", "line": 142, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "说不定我们不光要演舞台剧，<br>\n还会拍电影什么的呢。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry006"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "可是，你就为了这个把窗帘和桌布都扯下来，<br>\n真令人不敢置信……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna008"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "汉娜盯着窗帘撕破的地方紧蹙眉头。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "再不爱惜东西，可是会遭报应的。<br>\n我们现在已经每天都在浪费东西了。", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna009"]}},
    {"op": "ModifyCharacterExtended", "line": 156, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 157, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "听到汉娜的话，艾玛和雪莉都十分不解。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 161, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 163, "indent": 0, "params": {"Text": "就是我们穿的衣服呀！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna010"]}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "在监牢里，外衣自不必说，<br>\n就连换洗内衣裤都是监牢提供的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative019"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "根据规定，当天穿过的衣服和内衣<br>\n都必须丢进淋浴房的垃圾滑槽里。<br>\n我也一直遵守这个规定，每天都会丢弃。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative020"]}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "每天都丢掉衣服，实在是太浪费了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna011"]}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "之前我问了典狱长，<br>\n听说那个垃圾滑槽，好像是通向地下的焚烧炉来着。<br>", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry007"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "居然都烧掉了！？<br>\n明明洗一洗还能继续穿呢！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna012"]}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Smile1"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "也就是说，它们对【魔女】已经忌讳到了要烧掉衣服的程度吧～", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry008"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "我们哪里有那么脏哇～！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna013"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "变成【魔女】以后可就不好说了哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry009"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Pensive1"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "说不定还会散发出一些<br>\n不明致病细菌什么的……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry010"]}},
    {"op": "ModifyCharacterExtended", "line": 195, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 197, "indent": 0, "params": {"Text": "那……那就到时候再说嘛！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna014"]}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "至少我们现在还不是魔女……<br>\n这样实在是太浪费了……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna015"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "不想浪费的话，不丢掉大概也行吧。<br>\n感觉它们也没有检查得那么仔细。", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry011"]}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "……你说得对。<br>\n以后我就自己洗衣服了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna016"]}},
    {"op": "PrintTextModified", "line": 209, "indent": 0, "params": {"Text": "可是，要是违规行为被发现了，<br>\n搞不好会受处分哦？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Sherry012"]}},
    {"op": "PrintTextModified", "line": 211, "indent": 0, "params": {"Text": "唔唔……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hanna017"]}},
    {"op": "HideAllCharacters", "line": 213, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "（这两个人真的好吵……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Hiro007"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "再加上艾玛也在场，怎么也集中不了精神。<br>\n我只好放弃调查，离开了画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv06_Narrative021"]}},
    {"op": "Gosub", "line": 224, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 226, "indent": 0, "params": {"Path": "Act02_Chapter02/Act02_Chapter02_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0202Adv06_Ema001": "啊，希罗……",
  "0202Adv06_Narrative001": "来到被诺亚用作画室的房间，<br>\n碰上了艾玛和汉娜。",
  "0202Adv06_Hiro001": "……你们在这里做什么？",
  "0202Adv06_Ema002": "我们也打算参加蕾雅的舞台剧制作。<br>",
  "0202Adv06_Ema003": "于是，汉娜就负责当服装师了。<br>",
  "0202Adv06_Hanna001": "真叫人头疼哇。<br>\n本小姐怎么就要负责做舞台服了……",
  "0202Adv06_Narrative002": "尽管她嘴上抱怨，<br>\n手里却在熟练地做着针线活。",
  "0202Adv06_Hiro002": "（干活很麻利。看来她很擅长裁缝工作）",
  "0202Adv06_Hiro003": "为什么选择来这里干活？",
  "0202Adv06_Hanna002": "因为这里挺宽敞的，比较方便做事。<br>\n我们也需要足够的空间<br>\n去摆放材料和制作好的舞台服。",
  "0202Adv06_Narrative003": "我环视整个房间。",
  "0202Adv06_Narrative004": "不知什么时候，房里多了几个油漆桶。<br>",
  "0202Adv06_Narrative005": "桶里满满都是色彩缤纷的油漆。<br>",
  "0202Adv06_Narrative006": "大概是诺亚从某处找来，并存放在这里的吧。<br>",
  "0202Adv06_Narrative007": "虽然整个房间有点脏脏的，<br>\n但里面有一张大桌子，空间也够宽敞。",
  "0202Adv06_Hiro004": "（的确，这个房间应该很适合干活）",
  "0202Adv06_Hanna003": "剧目已经定好是《小飞侠》了。",
  "0202Adv06_Hanna004": "艾玛负责饰演温蒂哦！<br>\n我会做一套精美的舞台服，<br>\n请好好期待吧！",
  "0202Adv06_Ema004": "好、好的，谢谢。<br>\n其实我也不知道，现在还在做这种事真的好吗……",
  "0202Adv06_Hiro005": "（这家伙忸怩作态的样子真让人来气……<br>\n　再聊下去只会让我压力越来越大）",
  "0202Adv06_Narrative008": "我远离那两人，<br>\n再次仔细调查房间里的情况。",
  "0202Adv06_Narrative009": "画室里只能透进微弱的光，<br>\n而且每次来都是乱糟糟的样子。",
  "0202Adv06_Narrative010": "石膏像上有着细小的裂纹，<br>\n工作桌上密布着各种工具刻下的痕迹。",
  "0202Adv06_Narrative011": "还摆放着许多没有画完的油画，<br>\n但并不是诺亚的手笔。",
  "0202Adv06_Hiro006": "（看来有必要彻底打扫一次）",
  "0202Adv06_Narrative012": "不过，地上散乱的画纸上的内容变了。<br>\n看来，至少还是会定期扔进垃圾桶的。",
  "0202Adv06_Narrative013": "从阳台俯瞰中庭，<br>\n正下方就是高耸的尖锐铁栅栏。",
  "0202Adv06_Sherry001": "艾玛，汉娜！<br>\n让你们久等啦！",
  "0202Adv06_Narrative014": "随着一阵吵闹的脚步声，<br>\n雪莉跑进了画室，我也回过头来。",
  "0202Adv06_Sherry002": "给，收着吧！我已经把所有能找到的绿色布料<br>\n全都拿过来了！",
  "0202Adv06_Narrative015": "雪莉把怀里满满一摞绿色布料<br>\n放在工作桌上。",
  "0202Adv06_Ema005": "你好厉害啊。居然能找到这么多，<br>\n都是在哪里找到的？",
  "0202Adv06_Sherry003": "我把各个房间里的<br>\n窗帘和桌布什么的全都扯下来了！<br>",
  "0202Adv06_Hanna005": "你这是在干什么！？<br>\n未免也太离谱了吧！<br>\n而且，根本用不到这么多呀！",
  "0202Adv06_Narrative016": "见汉娜大发脾气，<br>\n雪莉便把窗帘摊开给她看。",
  "0202Adv06_Sherry004": "你有没有在网红影片里<br>\n看过这种东西！？",
  "0202Adv06_Hanna006": "什么意思……？",
  "0202Adv06_Sherry005": "绿幕呀！<br>\n用来抠掉背景合成影片的那个东西！",
  "0202Adv06_Hanna007": "啊～……在天气预报里见到过。",
  "0202Adv06_Sherry006": "说不定我们不光要演舞台剧，<br>\n还会拍电影什么的呢。",
  "0202Adv06_Hanna008": "可是，你就为了这个把窗帘和桌布都扯下来，<br>\n真令人不敢置信……",
  "0202Adv06_Narrative017": "汉娜盯着窗帘撕破的地方紧蹙眉头。<br>",
  "0202Adv06_Hanna009": "再不爱惜东西，可是会遭报应的。<br>\n我们现在已经每天都在浪费东西了。",
  "0202Adv06_Narrative018": "听到汉娜的话，艾玛和雪莉都十分不解。",
  "0202Adv06_Hanna010": "就是我们穿的衣服呀！",
  "0202Adv06_Narrative019": "在监牢里，外衣自不必说，<br>\n就连换洗内衣裤都是监牢提供的。",
  "0202Adv06_Narrative020": "根据规定，当天穿过的衣服和内衣<br>\n都必须丢进淋浴房的垃圾滑槽里。<br>\n我也一直遵守这个规定，每天都会丢弃。",
  "0202Adv06_Hanna011": "每天都丢掉衣服，实在是太浪费了！",
  "0202Adv06_Sherry007": "之前我问了典狱长，<br>\n听说那个垃圾滑槽，好像是通向地下的焚烧炉来着。<br>",
  "0202Adv06_Hanna012": "居然都烧掉了！？<br>\n明明洗一洗还能继续穿呢！",
  "0202Adv06_Sherry008": "也就是说，它们对【魔女】已经忌讳到了要烧掉衣服的程度吧～",
  "0202Adv06_Hanna013": "我们哪里有那么脏哇～！！",
  "0202Adv06_Sherry009": "变成【魔女】以后可就不好说了哦？",
  "0202Adv06_Sherry010": "说不定还会散发出一些<br>\n不明致病细菌什么的……",
  "0202Adv06_Hanna014": "那……那就到时候再说嘛！",
  "0202Adv06_Hanna015": "至少我们现在还不是魔女……<br>\n这样实在是太浪费了……",
  "0202Adv06_Sherry011": "不想浪费的话，不丢掉大概也行吧。<br>\n感觉它们也没有检查得那么仔细。",
  "0202Adv06_Hanna016": "……你说得对。<br>\n以后我就自己洗衣服了！",
  "0202Adv06_Sherry012": "可是，要是违规行为被发现了，<br>\n搞不好会受处分哦？",
  "0202Adv06_Hanna017": "唔唔……",
  "0202Adv06_Hiro007": "（这两个人真的好吵……）",
  "0202Adv06_Narrative021": "再加上艾玛也在场，怎么也集中不了精神。<br>\n我只好放弃调查，离开了画室。"
}
}
