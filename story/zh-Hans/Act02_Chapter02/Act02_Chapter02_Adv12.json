    {"op": "Wait", "line": 103, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "然后稍稍拧松盖子上的螺丝。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 107, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "（这样就好。接下来只要等待约定的时间到来。<br>\n　……不对，还有一个隐患）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro015"]}},
    {"op": "HideAllCharacters", "line": 111, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 112, "indent": 0, "params": {"TintColor": "#000000", "Lazy": 0, "AppearanceAndTransition": "30_2"}},
    {"op": "Wait", "line": 113, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Scale": [1.2000000476837158], "TintColor": "#B09060", "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "那就是可可。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative015"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "（她有时候会来隔音比较好的淋浴房<br>\n　做直播……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro016"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "如果到了我和艾玛约定的时间，<br>\n可可正好想来淋浴房直播了，我该怎么办？", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative016"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "当我想到这个计划的时候，就已经留意到了这个问题。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative017"]}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "我拟了几个解决方案，<br>\n比如给可可提供一个更好的直播场地，等等。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative018"]}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "但是，小动作做得太多的话，<br>\n很可能导致自己之后被人怀疑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative019"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "最后我还是没想出什么具体对策，<br>\n就这样到了计划当天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative020"]}},
    {"op": "HideAllCharacters", "line": 130, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 131, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 132, "indent": 0, "params": {"TintColor": "#FFFFFF", "Lazy": 0, "AppearanceAndTransition": "30_2"}},
    {"op": "Wait", "line": 133, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "（其实不止可可一个隐患）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro017"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "其他少女也可能来到淋浴房。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1,ArmR1"}},
