    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "PlayBgm", "line": 13, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 15, "indent": 0, "params": {"Text": "早餐时间后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative001"]}},
    {"op": "PrintTextModified", "line": 17, "indent": 0, "params": {"Text": "为了做好谋杀艾玛的准备工作，<br>\n我悄悄来到淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative002"]}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "淋浴房的墙壁上，<br>\n还是一如既往画着一幅巨大的壁画。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed,ArmR2"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "【气球】吗……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro001"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "虽然也可以问问诺亚本人，<br>\n但她估计并不在意这些名头吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative004"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "（能感受到<br>\n　她真的只是纯粹地喜欢画画）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "（对于她来说，只要可以画画，<br>\n　似乎身在何处都无关紧要。即使是在这座监牢）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "我再次仔细端详诺亚的画，<br>\n不禁笑了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative005"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "（既然她在这里能够毫无压力地生活下去，<br>\n　应该就不需要担心她堕为魔女了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1,ArmR1"}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "沉浸在思绪中，<br>\n忽然，我猛地回过神来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "（现在要做的事和诺亚无关吧！<br>\n　怎么能不把精力集中在头等大事上）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 45, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "我重新打起精神，继续推进准备工作。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative007"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "要做的事很简单。<br>\n只需事先在垃圾滑槽上动动手脚。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative008"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "要把艾玛之死伪装成意外，<br>\n需要制造相应的证据。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed,ArmR2"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "（所以……垃圾滑槽的盖子<br>\n　要做成【年久失修导致损坏】的样子）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro006"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "（不幸的是，艾玛没有注意到这件事，<br>\n　走近后一时失去平衡，掉下去了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro007"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "（她因为头部遭受猛烈的撞击而晕了过去，<br>\n　然后又不幸撞上焚烧炉启动的时间……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro008"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "（就这样，艾玛被烧死在那里）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro009"]}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "（……这就是我的剧本）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro010"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "必须在发现命案之前，就对滑槽下手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative010"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "因为若是艾玛失踪后<br>\n被人看到我动手脚的场面，<br>\n就会加深自己的嫌疑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative011"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "如果事先动手脚的话，<br>\n万一被人目击，也能设法为自己开脱。<br>\n最差的情况不过是计划中止。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Narrative012"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（我杀死艾玛后，<br>\n　只要等到有人找到【艾玛死亡是事故的证据】，<br>\n　再配合证据发表我的推理就好）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro011"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "（结论是【因为垃圾滑槽故障，<br>\n　艾玛不幸地失去了生命】）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro012"]}},
    {"op": "ModifyCharacterExtended", "line": 75, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "（总会有狡辩的余地。<br>\n　毕竟……没有任何证据能证明是他杀）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv12_Hiro013"]}},
    {"op": "ResetText", "line": 79, "indent": 0, "params": {}},
