  "language": "zh-Hans",
  "path": "Act02_Chapter02/Act02_Chapter02_Bad01",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-2-b1", "line": 8, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 18, "indent": 0, "params": {"Scale": [2.0], "Duration": 0.0, "Lazy": 0, "ScenePosition": [100.0], "AppearanceAndTransition": "30_2"}},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 20, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_22_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "我决定仔细调查下垃圾滑槽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（事前检查一定要做好。<br>\n　谁也不知道会出什么意外）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "我小心翼翼地掀开沉重的铁盖，<br>\n注意不破坏设好的陷阱。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative002"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "往里面一看，冰冷的风便透过管道吹了上来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative003"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "（……里面太黑了，看不清啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "为了看得清楚些，我又把身子往前探了探<br>\n——就在这时。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative004"]}},
    {"op": "StopBgm", "line": 36, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 39, "indent": 0, "params": {"SfxPath": "Sfx_76", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "哇！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro003"]}},
    {"op": "ResetText", "line": 43, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 44, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyCamera", "line": 45, "indent": 0, "params": {"Offset": [-8.0, -1.0], "Zoom": 0.800000011920929, "Duration": 0.20000000298023224, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 46, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.4000000059604645, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 47, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "（完了……——！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro004"]}},
    {"op": "PlayBgm", "line": 53, "indent": 0, "params": {"BgmPath": "Bgm_12_1_Loop", "IntroBgmPath": "Bgm_12_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "不知是谁猛地推了我一把，<br>\n我顿时失去平衡掉进了狭窄的管道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative005"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "我在伸手不见五指的黑暗中急速坠落，<br>\n心跳瞬间飙升。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative006"]}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "（可恶，快停下——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro005"]}},
    {"op": "ResetText", "line": 63, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 64, "indent": 0, "params": {"FadeOutDuration": 1.0}},
    {"op": "ModifyCamera", "line": 65, "indent": 0, "params": {"Offset": [0.0], "Zoom": 0.0, "Lazy": 0}},
    {"op": "Wait", "line": 66, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "狂风的尖啸在我耳边盘旋，<br>\n我的意识在途中戛然而止——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative007"]}},
    {"op": "ResetText", "line": 74, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 76, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 79, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#77FFFF", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "21_1"}},
    {"op": "SpawnBlur", "line": 80, "indent": 0, "params": {"ActorId": "MainBackground", "FadeDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 83, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 84, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlaySfxModified", "line": 87, "indent": 0, "params": {"SfxPath": "Sfx_121", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "……我慢慢地从昏迷中醒来，<br>\n刚一清醒便猛然起身。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative008"]}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "环顾周围——只见自己身在惩罚室当中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative009"]}},
    {"op": "PlayBgm", "line": 93, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Pensive"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "怎、怎么回事……？这里是，惩罚室……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro006"]}},
    {"op": "HideAllCharacters", "line": 99, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "（我是掉下去摔死了吗……？<br>\n　不对，那我应该在牢房的床上醒来）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro007"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "从那么长的管道里摔下来，<br>\n我的身上却没留下任何伤痛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative010"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "而且，那条管道明明通向焚烧炉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative011"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（到底发生了什么事……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro008"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我迷茫地左右看了看惩罚室，<br>\n异样的感觉愈发明显。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative012"]}},
    {"op": "SpawnBlur", "line": 111, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 1.0}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "墙壁是扭曲的，不对，<br>\n就连这里的空气、整个世界都是扭曲的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative013"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "（可能是我的魔法影响了整个监牢，<br>\n　导致这里出现了奇异的现象吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro009"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "（看来只能先调查一下了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro010"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "正当我走向门口的时候，<br>\n房门却被谁猛地打开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative014"]}},
    {"op": "PlaySfxModified", "line": 122, "indent": 0, "params": {"SfxPath": "Sfx_75", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 124, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Surprised"}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 131, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 137, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "JailerB.1"}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "门背后的是——异形的怪物。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative015"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "（是残骸！？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro012"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "那个怪物一看到我，<br>\n也惊得绷紧了身子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative016"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "我们就这样警惕地互相瞪了几秒钟——<br>\n突然，它先手挥起武器。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative017"]}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "■■■■■■", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Unknown001"]}},
    {"op": "HideAllCharacters", "line": 152, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 153, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "什么！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro013"]}},
    {"op": "HideAllCharacters", "line": 157, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 158, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "JailerB.1"}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "它不知在叫唤什么，<br>\n气势汹汹地朝我冲了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative018"]}},
    {"op": "PlaySfxModified", "line": 163, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "斧头裹挟着毫不留情的杀气猛地劈下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative019"]}},
    {"op": "PrintTextModified", "line": 167, "indent": 0, "params": {"Text": "呃！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro014"]}},
    {"op": "HideAllCharacters", "line": 169, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "我身子一转，急忙躲开。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative020"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "我没法与它抗衡。<br>\n于是我慌忙跑去门口。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative021"]}},
    {"op": "ModifyBackgroundExtended", "line": 175, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FF77FF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "3_2"}},
    {"op": "PlaySfxModified", "line": 179, "indent": 0, "params": {"SfxPath": "Sfx_51", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 181, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 183, "indent": 0, "params": {"Text": "我不知道它到底是个什么怪物，<br>\n但我能感受到它身上浓重的杀气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 185, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "JailerB.1"}},
    {"op": "PrintTextModified", "line": 187, "indent": 0, "params": {"Text": "在匆忙逃跑的途中，我瞥了一眼身后。<br>\n那残骸还在紧追不舍。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative023"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "■■■■■！", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Unknown002"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "（它究竟在说什么！？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro015"]}},
    {"op": "HideAllCharacters", "line": 196, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "刚才的一回头让我没注意看前方，<br>\n脚不知道绊到了什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Surprised"}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "啊……！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro016"]}},
    {"op": "PlaySfxModified", "line": 207, "indent": 0, "params": {"SfxPath": "Sfx_6", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 209, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [0.0, 20.0], "IdAndAppearance": "Hiro"}},
    {"op": "HideAllCharacters", "line": 210, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "脚步一滑，我被绊倒在地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative025"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "唔……呃——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "JailerB.1"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "还没来得及思考，<br>\n残骸就已追到眼前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative026"]}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "等——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro018"]}},
    {"op": "PlaySfxModified", "line": 225, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ResetText", "line": 227, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 228, "indent": 0, "params": {"TintColor": "#660000FF", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 229, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "HideAllCharacters", "line": 231, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "粉身碎骨的冲击席卷全身。<br>\n还未感到疼痛，<br>\n【死亡】已呼啸而至。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative027"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "（我、要死……了吗……为什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro019"]}},
    {"op": "ResetText", "line": 237, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 238, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 239, "indent": 0, "params": {"WaitMode": "0.8"}},
    {"op": "ModifyBackgroundExtended", "line": 241, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFF77", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "6_1"}},
    {"op": "ModifyBackgroundExtended", "line": 244, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 245, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "……欸？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro020"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "刚一醒来，就发现自己身处食堂。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative028"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "为什么！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro021"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "这里和刚才的惩罚室一样，到处都是扭曲的模样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative029"]}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "（【死亡回溯】没有发动吗？<br>\n　不，不对——我的伤都痊愈了。<br>\n　那能力应该发动了才对）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro022"]}},
    {"op": "HideAllCharacters", "line": 261, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 263, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "JailerB.1"}},
    {"op": "PrintTextModified", "line": 265, "indent": 0, "params": {"Text": "与此同时，<br>\n我看到刚才遇到的残骸也在这里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative030"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "■■■■■！", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Unknown003"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "它举起武器，朝我冲了过来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative031"]}},
    {"op": "HideAllCharacters", "line": 274, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 276, "indent": 0, "params": {"Text": "住——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro023"]}},
    {"op": "ResetText", "line": 278, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 281, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 282, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 285, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 287, "indent": 0, "params": {"TintColor": "#660000FF", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 288, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 290, "indent": 0, "params": {"Text": "毫不留情的一击<br>\n砍飞了我的头颅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative032"]}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "（为什么——会被它杀死）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro024"]}},
    {"op": "ModifyBackgroundExtended", "line": 294, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 295, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "……之后又是无穷无尽的轮回。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative033"]}},
    {"op": "ResetText", "line": 299, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 301, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#33FFFF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 304, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 305, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "住手，我——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro025"]}},
    {"op": "ResetText", "line": 309, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 312, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 313, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 316, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 318, "indent": 0, "params": {"TintColor": "#660000FF", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 319, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 320, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 321, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 323, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FF33FF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "11_1"}},
    {"op": "ModifyBackgroundExtended", "line": 326, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 327, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 329, "indent": 0, "params": {"Text": "别过来——！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro026"]}},
    {"op": "PrintTextModified", "line": 331, "indent": 0, "params": {"Text": "噫……不要啊啊啊啊！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro027"]}},
    {"op": "ResetText", "line": 333, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 336, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 338, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 341, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 343, "indent": 0, "params": {"TintColor": "#660000FF", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 344, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 346, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 347, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "逃走。<br>\n被杀。<br>\n醒来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative034"]}},
    {"op": "PrintTextModified", "line": 351, "indent": 0, "params": {"Text": "躲藏。<br>\n被杀。<br>\n醒来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative035"]}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "逃走。<br>\n被杀。<br>\n醒来……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative036"]}},
    {"op": "PrintTextModified", "line": 355, "indent": 0, "params": {"Text": "一遍又一遍的重蹈覆辙。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative037"]}},
    {"op": "ResetText", "line": 357, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 360, "indent": 0, "params": {"SfxPath": "Sfx_12", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 362, "indent": 0, "params": {"TintColor": "#660000FF", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 363, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyBackgroundExtended", "line": 365, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFF33", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 368, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 369, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 373, "indent": 0, "params": {"Text": "啊……啊啊……别过来，别过来……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro028"]}},
    {"op": "PrintTextModified", "line": 375, "indent": 0, "params": {"Text": "已经数不清<br>\n是第几次被斩首了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative038"]}},
    {"op": "PrintTextModified", "line": 377, "indent": 0, "params": {"Text": "我蹲在墙角根，身子不住地发抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative039"]}},
    {"op": "PlaySfxModified", "line": 380, "indent": 0, "params": {"SfxPath": "Sfx_5", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 381, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 383, "indent": 0, "params": {"Text": "我能感受到残骸就在铁栅栏的背后<br>\n四处搜寻我的身影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative040"]}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "■是■■的。你■■误■。你■错误■", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Unknown004"]}},
    {"op": "PrintTextModified", "line": 390, "indent": 0, "params": {"Text": "——忽然间，我恍然大悟。<br>\n在一遍遍的叫喊与追杀中，<br>\n我终于听懂了它的话。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative041"]}},
    {"op": "PrintTextModified", "line": 392, "indent": 0, "params": {"Text": "（它是说……你是错误的？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro029"]}},
    {"op": "PrintTextModified", "line": 397, "indent": 0, "params": {"Text": "你是■误的。■是错误的。你是错■的。", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Unknown005"]}},
    {"op": "PrintTextModified", "line": 399, "indent": 0, "params": {"Text": "逃跑的途中，我一直在思考。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative042"]}},
    {"op": "PrintTextModified", "line": 401, "indent": 0, "params": {"Text": "为什么这个怪物<br>\n如此执着于纠缠我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative043"]}},
    {"op": "PrintTextModified", "line": 403, "indent": 0, "params": {"Text": "（——因为，这只残骸就是我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro030"]}},
    {"op": "PrintTextModified", "line": 405, "indent": 0, "params": {"Text": "（大概是在坠落的途中，我的魔法跟异常产生了互动，<br>\n　让我闯入了另一条世界线……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro031"]}},
    {"op": "PrintTextModified", "line": 407, "indent": 0, "params": {"Text": "（在这个世界里，<br>\n　我变成了游走在监牢里的残骸——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro032"]}},
    {"op": "PrintTextModified", "line": 409, "indent": 0, "params": {"Text": "（对那个【我】而言，<br>\n　我确实是不该存在的错误）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro033"]}},
    {"op": "PrintTextModified", "line": 411, "indent": 0, "params": {"Text": "不——我才不是错误的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro034"]}},
    {"op": "HideAllCharacters", "line": 413, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 415, "indent": 0, "params": {"Text": "我低声喃喃道。<br>\n精疲力尽的身体终于重振旗鼓。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative044"]}},
    {"op": "ModifyBackgroundExtended", "line": 417, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#6666FF", "Lazy": 0, "AppearanceAndTransition": "2_1"}},
    {"op": "PrintTextModified", "line": 420, "indent": 0, "params": {"Text": "一来到过道，残骸就发现了我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative045"]}},
    {"op": "ModifyCharacterExtended", "line": 424, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "JailerB.1"}},
    {"op": "PrintTextModified", "line": 426, "indent": 0, "params": {"Text": "你是错误的！", "AuthorId": "Unknown", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Unknown006"]}},
    {"op": "PrintTextModified", "line": 428, "indent": 0, "params": {"Text": "错误的是你！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro035"]}},
    {"op": "PrintTextModified", "line": 430, "indent": 0, "params": {"Text": "我要驱除一切错误！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro036"]}},
    {"op": "PrintTextModified", "line": 432, "indent": 0, "params": {"Text": "我要纠正你，重新掌控正确的世界！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro037"]}},
    {"op": "HideAllCharacters", "line": 434, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 436, "indent": 0, "params": {"Text": "我拿起食堂顺来的小刀，<br>\n猛地刺向那具残骸。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative046"]}},
    {"op": "PrintTextModified", "line": 438, "indent": 0, "params": {"Text": "啊啊啊啊啊！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Hiro038"]}},
    {"op": "ModifyBackgroundExtended", "line": 440, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 441, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 443, "indent": 0, "params": {"Text": "争斗没有结束。<br>\n也永远不会结束。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative047"]}},
    {"op": "PrintTextModified", "line": 445, "indent": 0, "params": {"Text": "无论我被杀死多少次，<br>\n无论我打倒残骸多少次——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative048"]}},
    {"op": "PrintTextModified", "line": 447, "indent": 0, "params": {"Text": "我们都只会重复【死亡回溯】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative049"]}},
    {"op": "PrintTextModified", "line": 449, "indent": 0, "params": {"Text": "明明我已经对答案心知肚明，<br>\n却也只能接受这个结果。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative050"]}},
    {"op": "PrintTextModified", "line": 451, "indent": 0, "params": {"Text": "我们的争斗永远没有终结的那天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative051"]}},
    {"op": "PrintTextModified", "line": 453, "indent": 0, "params": {"Text": "只是为了争夺彼此的【正确】，<br>\n坠入深不见底的孤独。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad01_Narrative052"]}},
    {"op": "ProcessBadEnd", "line": 459, "indent": 0, "params": {"Number": 18}}
  ],
  "translations": {
  "0202Bad01_Narrative001": "我决定仔细调查下垃圾滑槽。",
  "0202Bad01_Hiro001": "（事前检查一定要做好。<br>\n　谁也不知道会出什么意外）",
  "0202Bad01_Narrative002": "我小心翼翼地掀开沉重的铁盖，<br>\n注意不破坏设好的陷阱。",
  "0202Bad01_Narrative003": "往里面一看，冰冷的风便透过管道吹了上来。",
  "0202Bad01_Hiro002": "（……里面太黑了，看不清啊）",
  "0202Bad01_Narrative004": "为了看得清楚些，我又把身子往前探了探<br>\n——就在这时。",
  "0202Bad01_Hiro003": "哇！？",
  "0202Bad01_Hiro004": "（完了……——！）",
  "0202Bad01_Narrative005": "不知是谁猛地推了我一把，<br>\n我顿时失去平衡掉进了狭窄的管道。",
  "0202Bad01_Narrative006": "我在伸手不见五指的黑暗中急速坠落，<br>\n心跳瞬间飙升。",
  "0202Bad01_Hiro005": "（可恶，快停下——）",
  "0202Bad01_Narrative007": "狂风的尖啸在我耳边盘旋，<br>\n我的意识在途中戛然而止——",
  "0202Bad01_Narrative008": "……我慢慢地从昏迷中醒来，<br>\n刚一清醒便猛然起身。",
  "0202Bad01_Narrative009": "环顾周围——只见自己身在惩罚室当中。",
  "0202Bad01_Hiro006": "怎、怎么回事……？这里是，惩罚室……？",
  "0202Bad01_Hiro007": "（我是掉下去摔死了吗……？<br>\n　不对，那我应该在牢房的床上醒来）",
  "0202Bad01_Narrative010": "从那么长的管道里摔下来，<br>\n我的身上却没留下任何伤痛。",
  "0202Bad01_Narrative011": "而且，那条管道明明通向焚烧炉。",
  "0202Bad01_Hiro008": "（到底发生了什么事……？）",
  "0202Bad01_Narrative012": "我迷茫地左右看了看惩罚室，<br>\n异样的感觉愈发明显。",
  "0202Bad01_Narrative013": "墙壁是扭曲的，不对，<br>\n就连这里的空气、整个世界都是扭曲的。",
  "0202Bad01_Hiro009": "（可能是我的魔法影响了整个监牢，<br>\n　导致这里出现了奇异的现象吧）",
  "0202Bad01_Hiro010": "（看来只能先调查一下了）",
  "0202Bad01_Narrative014": "正当我走向门口的时候，<br>\n房门却被谁猛地打开了。",
  "0202Bad01_Hiro011": "！？",
  "0202Bad01_Narrative015": "门背后的是——异形的怪物。",
  "0202Bad01_Hiro012": "（是残骸！？）",
  "0202Bad01_Narrative016": "那个怪物一看到我，<br>\n也惊得绷紧了身子。",
  "0202Bad01_Narrative017": "我们就这样警惕地互相瞪了几秒钟——<br>\n突然，它先手挥起武器。",
  "0202Bad01_Unknown001": "■■■■■■",
  "0202Bad01_Hiro013": "什么！？",
  "0202Bad01_Narrative018": "它不知在叫唤什么，<br>\n气势汹汹地朝我冲了过来。",
  "0202Bad01_Narrative019": "斧头裹挟着毫不留情的杀气猛地劈下。",
  "0202Bad01_Hiro014": "呃！",
  "0202Bad01_Narrative020": "我身子一转，急忙躲开。",
  "0202Bad01_Narrative021": "我没法与它抗衡。<br>\n于是我慌忙跑去门口。",
  "0202Bad01_Narrative022": "我不知道它到底是个什么怪物，<br>\n但我能感受到它身上浓重的杀气。",
  "0202Bad01_Narrative023": "在匆忙逃跑的途中，我瞥了一眼身后。<br>\n那残骸还在紧追不舍。",
  "0202Bad01_Unknown002": "■■■■■！",
  "0202Bad01_Hiro015": "（它究竟在说什么！？）",
  "0202Bad01_Narrative024": "刚才的一回头让我没注意看前方，<br>\n脚不知道绊到了什么。",
  "0202Bad01_Hiro016": "啊……！？",
  "0202Bad01_Narrative025": "脚步一滑，我被绊倒在地。",
  "0202Bad01_Hiro017": "唔……呃——",
  "0202Bad01_Narrative026": "还没来得及思考，<br>\n残骸就已追到眼前。",
  "0202Bad01_Hiro018": "等——",
  "0202Bad01_Narrative027": "粉身碎骨的冲击席卷全身。<br>\n还未感到疼痛，<br>\n【死亡】已呼啸而至。",
  "0202Bad01_Hiro019": "（我、要死……了吗……为什么……？）",
  "0202Bad01_Hiro020": "……欸？",
  "0202Bad01_Narrative028": "刚一醒来，就发现自己身处食堂。",
  "0202Bad01_Hiro021": "为什么！？",
  "0202Bad01_Narrative029": "这里和刚才的惩罚室一样，到处都是扭曲的模样。",
  "0202Bad01_Hiro022": "（【死亡回溯】没有发动吗？<br>\n　不，不对——我的伤都痊愈了。<br>\n　那能力应该发动了才对）",
  "0202Bad01_Narrative030": "与此同时，<br>\n我看到刚才遇到的残骸也在这里。",
  "0202Bad01_Unknown003": "■■■■■！",
  "0202Bad01_Narrative031": "它举起武器，朝我冲了过来。",
  "0202Bad01_Hiro023": "住——",
  "0202Bad01_Narrative032": "毫不留情的一击<br>\n砍飞了我的头颅。",
  "0202Bad01_Hiro024": "（为什么——会被它杀死）",
  "0202Bad01_Narrative033": "……之后又是无穷无尽的轮回。",
  "0202Bad01_Hiro025": "住手，我——",
  "0202Bad01_Hiro026": "别过来——！！",
  "0202Bad01_Hiro027": "噫……不要啊啊啊啊！！",
  "0202Bad01_Narrative034": "逃走。<br>\n被杀。<br>\n醒来。",
  "0202Bad01_Narrative035": "躲藏。<br>\n被杀。<br>\n醒来。",
  "0202Bad01_Narrative036": "逃走。<br>\n被杀。<br>\n醒来……",
  "0202Bad01_Narrative037": "一遍又一遍的重蹈覆辙。",
  "0202Bad01_Hiro028": "啊……啊啊……别过来，别过来……",
  "0202Bad01_Narrative038": "已经数不清<br>\n是第几次被斩首了。",
  "0202Bad01_Narrative039": "我蹲在墙角根，身子不住地发抖。",
  "0202Bad01_Narrative040": "我能感受到残骸就在铁栅栏的背后<br>\n四处搜寻我的身影。",
  "0202Bad01_Unknown004": "■是■■的。你■■误■。你■错误■",
  "0202Bad01_Narrative041": "——忽然间，我恍然大悟。<br>\n在一遍遍的叫喊与追杀中，<br>\n我终于听懂了它的话。",
  "0202Bad01_Hiro029": "（它是说……你是错误的？）",
  "0202Bad01_Unknown005": "你是■误的。■是错误的。你是错■的。",
  "0202Bad01_Narrative042": "逃跑的途中，我一直在思考。",
  "0202Bad01_Narrative043": "为什么这个怪物<br>\n如此执着于纠缠我。",
  "0202Bad01_Hiro030": "（——因为，这只残骸就是我）",
  "0202Bad01_Hiro031": "（大概是在坠落的途中，我的魔法跟异常产生了互动，<br>\n　让我闯入了另一条世界线……）",
  "0202Bad01_Hiro032": "（在这个世界里，<br>\n　我变成了游走在监牢里的残骸——）",
  "0202Bad01_Hiro033": "（对那个【我】而言，<br>\n　我确实是不该存在的错误）",
  "0202Bad01_Hiro034": "不——我才不是错误的。",
  "0202Bad01_Narrative044": "我低声喃喃道。<br>\n精疲力尽的身体终于重振旗鼓。",
  "0202Bad01_Narrative045": "一来到过道，残骸就发现了我。",
  "0202Bad01_Unknown006": "你是错误的！",
  "0202Bad01_Hiro035": "错误的是你！",
  "0202Bad01_Hiro036": "我要驱除一切错误！！",
  "0202Bad01_Hiro037": "我要纠正你，重新掌控正确的世界！！",
  "0202Bad01_Narrative046": "我拿起食堂顺来的小刀，<br>\n猛地刺向那具残骸。",
  "0202Bad01_Hiro038": "啊啊啊啊啊！！",
  "0202Bad01_Narrative047": "争斗没有结束。<br>\n也永远不会结束。",
  "0202Bad01_Narrative048": "无论我被杀死多少次，<br>\n无论我打倒残骸多少次——",
  "0202Bad01_Narrative049": "我们都只会重复【死亡回溯】。",
  "0202Bad01_Narrative050": "明明我已经对答案心知肚明，<br>\n却也只能接受这个结果。",
  "0202Bad01_Narrative051": "我们的争斗永远没有终结的那天。",
  "0202Bad01_Narrative052": "只是为了争夺彼此的【正确】，<br>\n坠入深不见底的孤独。"
}
}
