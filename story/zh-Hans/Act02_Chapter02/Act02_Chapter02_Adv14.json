    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "10_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "Wait", "line": 14, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlaySfxModified", "line": 16, "indent": 0, "params": {"SfxPath": "Sfx_129", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 17, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "我正带着一脸不高兴的诺亚前往二楼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative001"]}},
    {"op": "PlaySfxModified", "line": 22, "indent": 0, "params": {"SfxPath": "Sfx_29", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlayBgm", "line": 24, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "刚上到楼梯尽头，<br>\n手机突然响了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative002"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "（已经过了和艾玛约定的时间……<br>\n　是她在催我……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "我拿起手机瞟了一眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative003"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "屏幕上显示着<br>\n【可可正在直播！】几个字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative004"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "我叹了口气，收起手机，<br>\n与此同时，一个开朗的声音响起。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 36, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "咦？<br>\n希罗你怎么了？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria001"]}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "……是诺亚。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 44, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 45, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 47, "indent": 0, "params": {"Text": "嗯——？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria002"]}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "米莉亚仔细盯着诺亚气鼓鼓的脸蛋。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "……哈哈我懂了。<br>\n是不是被希罗教训了呀。<br>\n诺亚干了什么坏事吧～？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria003"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "诺亚才没干坏事呢。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah001"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "这样啊～。也是哦～。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 59, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 61, "indent": 0, "params": {"Text": "那诺亚你到底做了什么呀？<br>", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria005"]}},
    {"op": "ModifyCharacterExtended", "line": 63, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "…………画画。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah002"]}},
    {"op": "ModifyCharacterExtended", "line": 67, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "……她在墙壁上涂鸦。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "啊～原来是这样。<br>\n然后被希罗发现了是吧。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria006"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "这可不好呀～诺亚。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria007"]}},
    {"op": "ModifyCharacterExtended", "line": 80, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "……诺亚会被惩罚？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah003"]}},
    {"op": "ModifyCharacterExtended", "line": 84, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "嗯，是啊。<br>\n可能会狠狠惩罚你哦。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria008"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "什么……！？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 92, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "……你们把我当做什么人了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "开玩笑啦开玩笑！<br>\n希罗才不会做那种事。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria009"]}},
    {"op": "ModifyCharacterExtended", "line": 100, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "……不过她可能会口头教育你一下。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria010"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "唔～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "嗯～……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria011"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "米莉亚抱起胳膊，<br>\n稍作思考后开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "……那诺亚要不要和大叔我一起看电影呀？<br>", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria012"]}},
    {"op": "ModifyCharacterExtended", "line": 118, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "……电影？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah006"]}},
    {"op": "ModifyCharacterExtended", "line": 122, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "嗯。<br>\n是个在街头墙壁上涂鸦的<br>\n街头艺术家的故事。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria013"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "……感觉很无聊。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah007"]}},
    {"op": "ModifyCharacterExtended", "line": 130, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "那你想被希罗教训？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria014"]}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "……我要看电影。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Noah008"]}},
    {"op": "ModifyCharacterExtended", "line": 138, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "好嘞，那我们就去看电影吧。<br>\n大叔我会给你解说的。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Miria015"]}},
    {"op": "HideAllCharacters", "line": 142, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "米莉亚说完便牵起诺亚的手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "然后朝我眨了眨眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative009"]}},
    {"op": "HideAllCharacters", "line": 150, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "（……太感谢了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro005"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "终于把诺亚塞给米莉亚，我松了口气。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative010"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "（再不去汇合<br>\n　艾玛搞不好就要回去了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro006"]}},
    {"op": "PlaySfxModified", "line": 159, "indent": 0, "params": {"SfxPath": "Sfx_29", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 160, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "刚准备下楼梯，<br>\n手机铃声又开始震动并响了起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative011"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "（……又来了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro007"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "我不耐烦地停下脚步，<br>\n打开手机一看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative012"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "果不其然还是可可的名字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative013"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我决定无视，正打算把手机收起来，<br>\n这时我突然想到。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative014"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "（……她该不会在淋浴房直播吧……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro008"]}},
    {"op": "PrintTextModified", "line": 174, "indent": 0, "params": {"Text": "一阵不祥的预感袭上心头，<br>\n谨慎起见我点开了直播页面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative015"]}},
    {"op": "ResetText", "line": 176, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 178, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 180, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 181, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 182, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyTextPrinter", "line": 184, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Stream", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 185, "indent": 0, "params": {"Scale": [2.0], "TintColor": "#555555", "Duration": 0.0, "Lazy": 0, "ScenePosition": [72.0, 64.0], "AppearanceAndTransition": "30_2"}},
    {"op": "SpawnBlur", "line": 186, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 0.5, "FadeDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 40.0], "IdAndAppearance": "Coco.Fearful1"}},
    {"op": "Wait", "line": 188, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 189, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 190, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "…………", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco001"]}},
    {"op": "PlayBgm", "line": 196, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "（怎么回事？好像不太对劲）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro009"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "屏幕上可可的表情<br>\n让我感觉有几分怪异。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative016"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "她的视线正在快速地到处游走。<br>\n又像是焦急，又像是在恐惧着什么东西。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative017"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "…………", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco002"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "明明已经开始直播了，<br>\n可可却一言不发。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative018"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "啊，糟糕……！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 212, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "Wait", "line": 213, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "大家好啊，我是可可碳～！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco004"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "过了一会，<br>\n可可开始说话救场。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative019"]}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "呃，今天……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco005"]}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Fearful1"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "那个……啥来着……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco006"]}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "对、对了！闲聊！<br>\n今天来开闲聊台吧～……！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco007"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "（……这举止明显很可疑）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro010"]}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "不仅如此，不祥的预感应验了。<br>\n可可身后是那幅熟悉的画。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative020"]}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "（淋浴房……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro011"]}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "现在可可就在淋浴房直播。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative021"]}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "啧……又有人来碍事……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro012"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "（现在淋浴房里有艾玛和可可两个人）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro013"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "（如果现在过去，毫无疑问会被人看到<br>\n　我和艾玛在一起的场面……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro014"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "（这样肯定会被怀疑……<br>\n　虽然很不甘心，但这次只能放弃实施……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 246, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "……啊！！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco008"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "可可惊讶的声音，<br>\n让我正准备关闭直播的手不由得停了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative022"]}},
    {"op": "ModifyCharacterExtended", "line": 252, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Fearful1"}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "喂，听得到吗～！<br>\n……欸？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco009"]}},
    {"op": "PrintTextModified", "line": 256, "indent": 0, "params": {"Text": "可可向屏幕另一端观众问话的声音<br>\n突然停住了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative023"]}},
    {"op": "ModifyCharacterExtended", "line": 258, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "不是……等", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Coco010"]}},
    {"op": "StopBgm", "line": 262, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 265, "indent": 0, "params": {"SfxPath": "Sfx_38", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 267, "indent": 0, "params": {"TintColor": "#550000FF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "什么！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro016"]}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "伴随着类似枪响的声音，<br>\n黑红的飞沫弄脏了整个画面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative024"]}},
    {"op": "ModifyBackgroundExtended", "line": 273, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "HideAllCharacters", "line": 274, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 275, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "10_1"}},
    {"op": "SpawnBlur", "line": 276, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 0.0, "FadeDuration": 0.0}},
    {"op": "ModifyTextPrinter", "line": 277, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "紧接着，<br>\n直播就中断了，画面一片漆黑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative025"]}},
    {"op": "ModifyBackgroundExtended", "line": 281, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 282, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PlayBgm", "line": 283, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "虽说是手机屏幕上的画面，<br>\n但这冲击性的场面还是让我的心跳急剧加速。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative026"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "拿着手机的手也开始发抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative027"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "（枪声……？<br>\n　发生什么事了……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro017"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "（……不对，想都不用想）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro018"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "在画面的另一端，<br>\n可可被什么人枪击了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative028"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "（在淋浴房……发生了凶杀案……<br>\n　那凶手就是……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro019"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "她的面庞愈发清晰地浮现在我的脑海中。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative029"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "……艾玛！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro020"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "我大喊她的名字，<br>\n奔向淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative030"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "——然而。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative031"]}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Surprised"}},
    {"op": "PlaySfxModified", "line": 308, "indent": 0, "params": {"SfxPath": "Sfx_27", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "SpawnShake", "line": 310, "indent": 0, "params": {"ActorId": "Camera"}},
    {"op": "PrintTextModified", "line": 312, "indent": 0, "params": {"Text": "呀啊啊！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hanna001"]}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "呃唔！？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro021"]}},
    {"op": "HideAllCharacters", "line": 316, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "下楼的时候我突然撞到了人，<br>\n虽然没摔下楼，<br>\n但也被撞得一屁股坐到了地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative032"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0, 30.0], "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "到底在搞什么呀！！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hanna002"]}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "看向声音的方向，<br>\n原来我撞到的人是汉娜。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative033"]}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "在往下几级台阶处，汉娜也跟我一样，一屁股跌坐在了地上。<br>\n她身旁是散落一地的衣服。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative034"]}},
    {"op": "ModifyCharacterExtended", "line": 330, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Angry1"}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "我看下雨了，赶紧把衣服收进来……<br>\n这下又得重洗了！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hanna003"]}},
    {"op": "PrintTextModified", "line": 334, "indent": 0, "params": {"Text": "（下雨……？我都没注意到。<br>\n　看来这些衣服是她洗过的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro023"]}},
    {"op": "HideAllCharacters", "line": 336, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 338, "indent": 0, "params": {"Text": "我站起身，<br>\n把那些几乎干掉的衣服拿开，<br>\n从汉娜身边走过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative035"]}},
    {"op": "PrintTextModified", "line": 340, "indent": 0, "params": {"Text": "……不好意思，我有急事先走了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hiro024"]}},
    {"op": "ModifyCharacterExtended", "line": 342, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Angry"}},
    {"op": "PrintTextModified", "line": 344, "indent": 0, "params": {"Text": "等等！<br>\n是你先撞上我的，<br>\n你倒是帮帮忙啊！", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hanna004"]}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "她从身后抓住我的手，<br>\n可我现在真的无暇在意这些。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative036"]}},
    {"op": "HideAllCharacters", "line": 348, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 351, "indent": 0, "params": {"SfxPath": "Sfx_18", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "我心里有些歉意，<br>\n但还是果断地甩开了汉娜的手。<br>\n然后立即奔跑起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative037"]}},
    {"op": "ResetText", "line": 355, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 356, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000FF", "Duration": 0.6000000238418579, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 357, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "PrintTextModified", "line": 359, "indent": 0, "params": {"Text": "真是的……！<br>\n又是突降暴雨又是交通事故，我也太倒霉了吧！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Hanna005"]}},
    {"op": "PlaySfxModified", "line": 362, "indent": 0, "params": {"SfxPath": "Sfx_130", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 365, "indent": 0, "params": {"Text": "我没理会背后传来的牢骚，<br>\n急忙赶往淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv14_Narrative038"]}},
    {"op": "Gosub", "line": 367, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 369, "indent": 0, "params": {"Path": "Act02_Chapter02/Act02_Chapter02_Adv15", "SoftReset": 1}}
  ],
  "translations": {
  "0202Adv14_Narrative001": "我正带着一脸不高兴的诺亚前往二楼。",
  "0202Adv14_Narrative002": "刚上到楼梯尽头，<br>\n手机突然响了起来。",
  "0202Adv14_Hiro001": "（已经过了和艾玛约定的时间……<br>\n　是她在催我……？）",
  "0202Adv14_Narrative003": "我拿起手机瞟了一眼。",
  "0202Adv14_Narrative004": "屏幕上显示着<br>\n【可可正在直播！】几个字。",
  "0202Adv14_Narrative005": "我叹了口气，收起手机，<br>\n与此同时，一个开朗的声音响起。",
  "0202Adv14_Miria001": "咦？<br>\n希罗你怎么了？",
  "0202Adv14_Hiro002": "……是诺亚。",
  "0202Adv14_Miria002": "嗯——？",
  "0202Adv14_Narrative006": "米莉亚仔细盯着诺亚气鼓鼓的脸蛋。",
  "0202Adv14_Miria003": "……哈哈我懂了。<br>\n是不是被希罗教训了呀。<br>\n诺亚干了什么坏事吧～？",
  "0202Adv14_Noah001": "诺亚才没干坏事呢。",
  "0202Adv14_Miria004": "这样啊～。也是哦～。",
  "0202Adv14_Miria005": "那诺亚你到底做了什么呀？<br>",
  "0202Adv14_Noah002": "…………画画。",
  "0202Adv14_Hiro003": "……她在墙壁上涂鸦。",
  "0202Adv14_Miria006": "啊～原来是这样。<br>\n然后被希罗发现了是吧。",
  "0202Adv14_Miria007": "这可不好呀～诺亚。",
  "0202Adv14_Noah003": "……诺亚会被惩罚？",
  "0202Adv14_Miria008": "嗯，是啊。<br>\n可能会狠狠惩罚你哦。",
  "0202Adv14_Noah004": "什么……！？",
  "0202Adv14_Hiro004": "……你们把我当做什么人了。",
  "0202Adv14_Miria009": "开玩笑啦开玩笑！<br>\n希罗才不会做那种事。",
  "0202Adv14_Miria010": "……不过她可能会口头教育你一下。",
  "0202Adv14_Noah005": "唔～",
  "0202Adv14_Miria011": "嗯～……",
  "0202Adv14_Narrative007": "米莉亚抱起胳膊，<br>\n稍作思考后开口说道。",
  "0202Adv14_Miria012": "……那诺亚要不要和大叔我一起看电影呀？<br>",
  "0202Adv14_Noah006": "……电影？",
  "0202Adv14_Miria013": "嗯。<br>\n是个在街头墙壁上涂鸦的<br>\n街头艺术家的故事。",
  "0202Adv14_Noah007": "……感觉很无聊。",
  "0202Adv14_Miria014": "那你想被希罗教训？",
  "0202Adv14_Noah008": "……我要看电影。",
  "0202Adv14_Miria015": "好嘞，那我们就去看电影吧。<br>\n大叔我会给你解说的。",
  "0202Adv14_Narrative008": "米莉亚说完便牵起诺亚的手。",
  "0202Adv14_Narrative009": "然后朝我眨了眨眼。",
  "0202Adv14_Hiro005": "（……太感谢了）",
  "0202Adv14_Narrative010": "终于把诺亚塞给米莉亚，我松了口气。",
  "0202Adv14_Hiro006": "（再不去汇合<br>\n　艾玛搞不好就要回去了）",
  "0202Adv14_Narrative011": "刚准备下楼梯，<br>\n手机铃声又开始震动并响了起来。",
  "0202Adv14_Hiro007": "（……又来了）",
  "0202Adv14_Narrative012": "我不耐烦地停下脚步，<br>\n打开手机一看。",
  "0202Adv14_Narrative013": "果不其然还是可可的名字。",
  "0202Adv14_Narrative014": "我决定无视，正打算把手机收起来，<br>\n这时我突然想到。",
  "0202Adv14_Hiro008": "（……她该不会在淋浴房直播吧……？）",
  "0202Adv14_Narrative015": "一阵不祥的预感袭上心头，<br>\n谨慎起见我点开了直播页面。",
  "0202Adv14_Coco001": "…………",
  "0202Adv14_Hiro009": "（怎么回事？好像不太对劲）",
  "0202Adv14_Narrative016": "屏幕上可可的表情<br>\n让我感觉有几分怪异。",
  "0202Adv14_Narrative017": "她的视线正在快速地到处游走。<br>\n又像是焦急，又像是在恐惧着什么东西。",
  "0202Adv14_Coco002": "…………",
  "0202Adv14_Narrative018": "明明已经开始直播了，<br>\n可可却一言不发。",
  "0202Adv14_Coco003": "啊，糟糕……！",
  "0202Adv14_Coco004": "大家好啊，我是可可碳～！",
  "0202Adv14_Narrative019": "过了一会，<br>\n可可开始说话救场。",
  "0202Adv14_Coco005": "呃，今天……",
  "0202Adv14_Coco006": "那个……啥来着……",
  "0202Adv14_Coco007": "对、对了！闲聊！<br>\n今天来开闲聊台吧～……！",
  "0202Adv14_Hiro010": "（……这举止明显很可疑）",
  "0202Adv14_Narrative020": "不仅如此，不祥的预感应验了。<br>\n可可身后是那幅熟悉的画。",
  "0202Adv14_Hiro011": "（淋浴房……！）",
  "0202Adv14_Narrative021": "现在可可就在淋浴房直播。",
  "0202Adv14_Hiro012": "啧……又有人来碍事……！",
  "0202Adv14_Hiro013": "（现在淋浴房里有艾玛和可可两个人）",
  "0202Adv14_Hiro014": "（如果现在过去，毫无疑问会被人看到<br>\n　我和艾玛在一起的场面……）",
  "0202Adv14_Hiro015": "（这样肯定会被怀疑……<br>\n　虽然很不甘心，但这次只能放弃实施……）",
  "0202Adv14_Coco008": "……啊！！",
  "0202Adv14_Narrative022": "可可惊讶的声音，<br>\n让我正准备关闭直播的手不由得停了下来。",
  "0202Adv14_Coco009": "喂，听得到吗～！<br>\n……欸？",
  "0202Adv14_Narrative023": "可可向屏幕另一端观众问话的声音<br>\n突然停住了。",
  "0202Adv14_Coco010": "不是……等",
  "0202Adv14_Hiro016": "什么！？",
  "0202Adv14_Narrative024": "伴随着类似枪响的声音，<br>\n黑红的飞沫弄脏了整个画面。",
  "0202Adv14_Narrative025": "紧接着，<br>\n直播就中断了，画面一片漆黑。",
  "0202Adv14_Narrative026": "虽说是手机屏幕上的画面，<br>\n但这冲击性的场面还是让我的心跳急剧加速。",
  "0202Adv14_Narrative027": "拿着手机的手也开始发抖。",
  "0202Adv14_Hiro017": "（枪声……？<br>\n　发生什么事了……？）",
  "0202Adv14_Hiro018": "（……不对，想都不用想）",
  "0202Adv14_Narrative028": "在画面的另一端，<br>\n可可被什么人枪击了。",
  "0202Adv14_Hiro019": "（在淋浴房……发生了凶杀案……<br>\n　那凶手就是……）",
  "0202Adv14_Narrative029": "她的面庞愈发清晰地浮现在我的脑海中。",
  "0202Adv14_Hiro020": "……艾玛！",
  "0202Adv14_Narrative030": "我大喊她的名字，<br>\n奔向淋浴房。",
  "0202Adv14_Narrative031": "——然而。",
  "0202Adv14_Hanna001": "呀啊啊！？",
  "0202Adv14_Hiro021": "呃唔！？",
  "0202Adv14_Narrative032": "下楼的时候我突然撞到了人，<br>\n虽然没摔下楼，<br>\n但也被撞得一屁股坐到了地上。",
  "0202Adv14_Hiro022": "……！",
  "0202Adv14_Hanna002": "到底在搞什么呀！！",
  "0202Adv14_Narrative033": "看向声音的方向，<br>\n原来我撞到的人是汉娜。",
  "0202Adv14_Narrative034": "在往下几级台阶处，汉娜也跟我一样，一屁股跌坐在了地上。<br>\n她身旁是散落一地的衣服。",
  "0202Adv14_Hanna003": "我看下雨了，赶紧把衣服收进来……<br>\n这下又得重洗了！",
  "0202Adv14_Hiro023": "（下雨……？我都没注意到。<br>\n　看来这些衣服是她洗过的）",
  "0202Adv14_Narrative035": "我站起身，<br>\n把那些几乎干掉的衣服拿开，<br>\n从汉娜身边走过。",
  "0202Adv14_Hiro024": "……不好意思，我有急事先走了。",
  "0202Adv14_Hanna004": "等等！<br>\n是你先撞上我的，<br>\n你倒是帮帮忙啊！",
  "0202Adv14_Narrative036": "她从身后抓住我的手，<br>\n可我现在真的无暇在意这些。",
  "0202Adv14_Narrative037": "我心里有些歉意，<br>\n但还是果断地甩开了汉娜的手。<br>\n然后立即奔跑起来。",
  "0202Adv14_Hanna005": "真是的……！<br>\n又是突降暴雨又是交通事故，我也太倒霉了吧！？",
  "0202Adv14_Narrative038": "我没理会背后传来的牢骚，<br>\n急忙赶往淋浴房。"
}
}
