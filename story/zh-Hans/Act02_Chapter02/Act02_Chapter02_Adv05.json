    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 26, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "来到娱乐室，<br>\n米莉亚和安安正在放电影。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative001"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "她们都看得聚精会神，<br>\n没有注意到我进来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative002"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "（……小飞侠啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro001"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "我瞥了一眼银幕上的老电影，<br>\n便开始环顾室内。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative003"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "（如果要在这里杀死艾玛的话……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro002"]}},
    {"op": "HideAllCharacters", "line": 41, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 42, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyCamera", "line": 43, "indent": 0, "params": {"Offset": [0.0, 3.0], "Zoom": 0.5, "EasingTypeName": "SmoothStep", "Lazy": 0}},
    {"op": "Wait", "line": 44, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "一抬头，大吊灯映入眼帘。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative004"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（用这个大吊灯比较合适吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro003"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "动一动手脚，让它砸到艾玛的头上——<br>\n也许就能伪装成事故。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative005"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "（问题是，我能完美伪装得<br>\n　不留下蛛丝马迹吗……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro004"]}},
    {"op": "PlaySfxModified", "line": 55, "indent": 0, "params": {"SfxPath": "Sfx_9", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 56, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCamera", "line": 57, "indent": 0, "params": {"Offset": [0.0], "Zoom": 0.0, "EasingTypeName": "SmoothStep", "Duration": 0.5, "Lazy": 0}},
    {"op": "Wait", "line": 58, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "——嘿，呀～", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria001"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "一声略显滑稽的喊声传来，<br>\n我不由得回头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 64, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Normal1,ArmR10"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "一看，<br>\n原来是米莉亚正在银幕前挥动台球杆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative007"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "（这是在干什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro005"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "哒～……大概就像这样？<br>\n那个，安安，你觉得怎么样？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria002"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "看来米莉亚是在模仿银幕里<br>\n挥剑的海盗。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 74, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_05,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "『下盘不稳，气势不足。<br>\n　你这样是无法胜任铁钩船长一角的』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_AnAn001"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Surprised1"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "什么！？嗯……<br>\n大叔我本来还挺有自信的呢……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria003"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "『只能说，要上台表演<br>\n　练习之路道阻且长』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_AnAn002"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "（原来如此，她们在研究舞台剧的事啊）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro006"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "你们在舞台剧组都负责什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Surprised1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "啊，是希罗呀。<br>\n其实大叔我被提拔为铁钩船长了。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria004"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "『吾辈负责剧本』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_AnAn003"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "和耷拉着脑袋的米莉亚相反，<br>\n安安得意洋洋地举起了素描本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "剧目已经定为《小飞侠》了，<br>\n我们刚在开研讨会呢。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria005"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "这样啊。祝你们成功。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro008"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "嗯，大叔我会努力的……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria006"]}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "安安你那边怎样了。<br>\n剧本写得还顺利吗？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria007"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "『草案已经完稿』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_AnAn004"]}},
    {"op": "ModifyCharacterExtended", "line": 117, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Surprised1"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "哎，这就写完了？好厉害……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria008"]}},
    {"op": "ModifyCharacterExtended", "line": 121, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Flushed1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "…………", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_AnAn005"]}},
    {"op": "ModifyCharacterExtended", "line": 125, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "大叔我也会帮忙的，我们一起努力吧。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria009"]}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Smile1"}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "虽然超过这部电影的水平是不可能的啦……<br>\n但还是希望我们能创作出优秀的舞台剧来。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria010"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "安安重重地点了点头。<br>\n看来对于舞台剧一事，她们两人都很积极。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative010"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "（……这么看，蕾雅的提议也不坏）<br>", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro009"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "（有了目标以后，大家似乎都恢复了活力）<br>", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 139, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "说到小飞侠的名场面就是空中飘浮，<br>\n我们能用吊威亚之类的方法复现出来吗？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria011"]}},
    {"op": "ModifyCharacterExtended", "line": 143, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_05,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "『如果能真的飞到空中就精彩了』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_AnAn006"]}},
    {"op": "ModifyCharacterExtended", "line": 147, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "嗯……汉娜的魔法<br>\n不知道能不能让其他人也飘浮起来呢。", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Miria012"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "（还是别再继续打扰她们了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Hiro011"]}},
    {"op": "HideAllCharacters", "line": 153, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "趁着两人正热火朝天地讨论，<br>\n我转身离开了娱乐室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv05_Narrative011"]}},
    {"op": "Gosub", "line": 162, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 164, "indent": 0, "params": {"Path": "Act02_Chapter02/Act02_Chapter02_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0202Adv05_Narrative001": "来到娱乐室，<br>\n米莉亚和安安正在放电影。",
  "0202Adv05_Narrative002": "她们都看得聚精会神，<br>\n没有注意到我进来了。",
  "0202Adv05_Hiro001": "（……小飞侠啊）",
  "0202Adv05_Narrative003": "我瞥了一眼银幕上的老电影，<br>\n便开始环顾室内。",
  "0202Adv05_Hiro002": "（如果要在这里杀死艾玛的话……）",
  "0202Adv05_Narrative004": "一抬头，大吊灯映入眼帘。",
  "0202Adv05_Hiro003": "（用这个大吊灯比较合适吧）",
  "0202Adv05_Narrative005": "动一动手脚，让它砸到艾玛的头上——<br>\n也许就能伪装成事故。",
  "0202Adv05_Hiro004": "（问题是，我能完美伪装得<br>\n　不留下蛛丝马迹吗……）",
  "0202Adv05_Miria001": "——嘿，呀～",
  "0202Adv05_Narrative006": "一声略显滑稽的喊声传来，<br>\n我不由得回头。",
  "0202Adv05_Narrative007": "一看，<br>\n原来是米莉亚正在银幕前挥动台球杆。",
  "0202Adv05_Hiro005": "（这是在干什么……？）",
  "0202Adv05_Miria002": "哒～……大概就像这样？<br>\n那个，安安，你觉得怎么样？",
  "0202Adv05_Narrative008": "看来米莉亚是在模仿银幕里<br>\n挥剑的海盗。",
  "0202Adv05_AnAn001": "『下盘不稳，气势不足。<br>\n　你这样是无法胜任铁钩船长一角的』",
  "0202Adv05_Miria003": "什么！？嗯……<br>\n大叔我本来还挺有自信的呢……",
  "0202Adv05_AnAn002": "『只能说，要上台表演<br>\n　练习之路道阻且长』",
  "0202Adv05_Hiro006": "（原来如此，她们在研究舞台剧的事啊）",
  "0202Adv05_Hiro007": "你们在舞台剧组都负责什么？",
  "0202Adv05_Miria004": "啊，是希罗呀。<br>\n其实大叔我被提拔为铁钩船长了。",
  "0202Adv05_AnAn003": "『吾辈负责剧本』",
  "0202Adv05_Narrative009": "和耷拉着脑袋的米莉亚相反，<br>\n安安得意洋洋地举起了素描本。",
  "0202Adv05_Miria005": "剧目已经定为《小飞侠》了，<br>\n我们刚在开研讨会呢。",
  "0202Adv05_Hiro008": "这样啊。祝你们成功。",
  "0202Adv05_Miria006": "嗯，大叔我会努力的……",
  "0202Adv05_Miria007": "安安你那边怎样了。<br>\n剧本写得还顺利吗？",
  "0202Adv05_AnAn004": "『草案已经完稿』",
  "0202Adv05_Miria008": "哎，这就写完了？好厉害……",
  "0202Adv05_AnAn005": "…………",
  "0202Adv05_Miria009": "大叔我也会帮忙的，我们一起努力吧。",
  "0202Adv05_Miria010": "虽然超过这部电影的水平是不可能的啦……<br>\n但还是希望我们能创作出优秀的舞台剧来。",
  "0202Adv05_Narrative010": "安安重重地点了点头。<br>\n看来对于舞台剧一事，她们两人都很积极。",
  "0202Adv05_Hiro009": "（……这么看，蕾雅的提议也不坏）<br>",
  "0202Adv05_Hiro010": "（有了目标以后，大家似乎都恢复了活力）<br>",
  "0202Adv05_Miria011": "说到小飞侠的名场面就是空中飘浮，<br>\n我们能用吊威亚之类的方法复现出来吗？",
  "0202Adv05_AnAn006": "『如果能真的飞到空中就精彩了』",
  "0202Adv05_Miria012": "嗯……汉娜的魔法<br>\n不知道能不能让其他人也飘浮起来呢。",
  "0202Adv05_Hiro011": "（还是别再继续打扰她们了）",
  "0202Adv05_Narrative011": "趁着两人正热火朝天地讨论，<br>\n我转身离开了娱乐室。"
}
}
