    {"op": "label", "name": "Scene2-2-15", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_2"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlaySfxModified", "line": 15, "indent": 0, "params": {"SfxPath": "Sfx_126", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 17, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "一跑进淋浴房——<br>\n就看到艾玛呆呆地站在原地。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 21, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "艾玛！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "……希罗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema001"]}},
    {"op": "PlaySfxModified", "line": 30, "indent": 0, "params": {"SfxPath": "Sfx_144", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "淋浴房的门在我身后关上了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative002"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "冰冷的氛围笼罩着我和艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative003"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "……可可在哪？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 40, "indent": 0, "params": {"Text": "……你在说什么？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema002"]}},
    {"op": "HideAllCharacters", "line": 42, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "我从她的脸上看不出任何感情，<br>\n便快速扫视了一圈淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative004"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "可可不在。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative005"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "（怎么回事！？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro003"]}},
    {"op": "ResetText", "line": 50, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 51, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "TintColor": "#000000", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 52, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 56, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#8888BB", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "PlaySfxModified", "line": 57, "indent": 0, "params": {"SfxPath": "Sfx_144", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 58, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "ModifyBackgroundExtended", "line": 60, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 61, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "我感到大脑一片混乱，<br>\n急忙走出淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative006"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "但我不知该去哪，<br>\n只能先边走边思考。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative007"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（这不对。可可去哪了？<br>\n　她刚才不是在淋浴房直播吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro004"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "（很明显她被枪击了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro005"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "（那尸体究竟去哪里了……！<br>\n　如果被搬到了别处……那难道是）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro006"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "（……焚烧炉吗！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro007"]}},
    {"op": "ResetText", "line": 75, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 76, "indent": 0, "params": {"SfxPath": "Sfx_126", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 77, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 78, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "想到的一瞬间，<br>\n我立马冲了过去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative008"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "（焚烧炉在地下……！<br>\n　现在应该还来得及……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro008"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "距离15时焚烧炉自动启动<br>\n还有一点时间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative009"]}},
    {"op": "ModifyBackgroundExtended", "line": 86, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "ResetText", "line": 88, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 89, "indent": 0, "params": {"DissolveTexturePath": "VerticalBlindGradually", "Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "Transparent.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 90, "indent": 0, "params": {"WaitMode": "0.9"}},
    {"op": "StopBgm", "line": 91, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "就在我冲进<br>\n会客厅的那一刻。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 96, "indent": 0, "params": {"SfxPath": "Sfx_131", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "——！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro009"]}},
    {"op": "HideAllCharacters", "line": 102, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "一阵无比巨大的轰鸣声响起，<br>\n惊得我停下了脚步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative011"]}},
    {"op": "PlayBgm", "line": 107, "indent": 0, "params": {"BgmPath": "Ambi_8_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我这才想起，汉娜先前说过。<br>\n现在在下雨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative012"]}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "我实在是太着急了，<br>\n直到现在才注意到嘈杂的雨声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Normal1,Angle01/Option_Arms-"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "刚才那个声音好大啊……！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Leia001"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "是不是有雷劈在附近了。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_AnAn001"]}},
    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "会客厅里是蕾雅和安安。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative014"]}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "说起来，<br>\n刚才在去淋浴房的路上也看到了她们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 124, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "下一秒。<br>\n就在这激烈的雨声与雷声交织的间隙——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative016"]}},
    {"op": "StopBgm", "line": 128, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "噫……啊啊啊……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema003"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "传来一声抽搐着的凄惨尖叫。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative017"]}},
    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "（这声音，是艾玛……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro010"]}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "我转身看向走廊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative018"]}},
    {"op": "PrintTextModified", "line": 141, "indent": 0, "params": {"Text": "走廊有扇通往中庭的门。<br>\n而门是开着的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative019"]}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "但我刚刚经过那里时，<br>\n门应该是关着的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative020"]}},
    {"op": "PrintTextModified", "line": 145, "indent": 0, "params": {"Text": "（……是艾玛开的吗？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro011"]}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "刚才的雷击和嘈杂的雨声，<br>\n都仿佛是一种凶兆。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative021"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "自打看了可可的直播，<br>\n我的心跳就一直吵得不行。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative022"]}},
    {"op": "ResetText", "line": 151, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 152, "indent": 0, "params": {"Duration": 0.8999999761581421, "Lazy": 0, "AppearanceAndTransition": "SolidColor", "SubId": "Overlay"}},
    {"op": "Wait", "line": 153, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "像是被一股力量吸引过去似的，<br>\n我独自迈着摇摇晃晃的步子走向中庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative023"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "然后——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative024"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "那倾盆大雨似乎只是阵雨。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative025"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "在下着小雨的中庭——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative026"]}},
    {"op": "HidePrinter", "line": 163, "indent": 0, "params": {}},
    {"op": "PlayBgm", "line": 164, "indent": 0, "params": {"BgmPath": "Bgm_16_1_Loop", "IntroBgmPath": "Bgm_16_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 166, "indent": 0, "params": {"Id": "Stills", "Scale": [2.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [-5.0, -10.0], "AppearanceAndTransition": "330_1"}},
    {"op": "AnimateActorExtended", "line": 167, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "ScenePositionX": "15", "EasingTypeName": "EaseOutQuad", "Duration": "1.5"}},
    {"op": "ModifyBackgroundExtended", "line": 168, "indent": 0, "params": {"Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 169, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "AnimateActorExtended", "line": 171, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 172, "indent": 0, "params": {"Id": "Stills", "Scale": [3.0], "Duration": 0.6000000238418579, "Lazy": 0, "ScenePosition": [95.0, 75.0], "AppearanceAndTransition": "330_1", "SubId": "Middle"}},
    {"op": "AnimateActorExtended", "line": 173, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0, "ScenePositionX": "80", "EasingTypeName": "EaseOutQuad", "Duration": "1.5"}},
    {"op": "Wait", "line": 174, "indent": 0, "params": {"WaitMode": "2.4"}},
    {"op": "AnimateActorExtended", "line": 176, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Loop": 0}},
    {"op": "ModifyBackgroundExtended", "line": 177, "indent": 0, "params": {"Id": "Stills", "Rotation": [0.0, 0.0, 0.0], "Scale": [1.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "330_1"}},
    {"op": "SpawnBlur", "line": 178, "indent": 0, "params": {"ActorId": "Stills", "FadeDuration": 0.0}},
    {"op": "AnimateActorExtended", "line": 179, "indent": 0, "params": {"ActorIds": ["Stills"], "Loop": 0, "Scale": "1.15", "EasingTypeName": "EaseOutQuad", "Duration": "2.4"}},
    {"op": "SpawnBlur", "line": 180, "indent": 0, "params": {"ActorId": "Stills", "Intensity": 0.0, "FadeDuration": 1.7999999523162842}},
    {"op": "HideActors", "line": 181, "indent": 0, "params": {"ActorIds": ["Stills-Middle"], "Duration": 0.6000000238418579, "Lazy": 0}},
    {"op": "Wait", "line": 182, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "毒舌直播主少女泽渡可可，<br>\n正仰面倒在地上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative027"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "她双眼瞪得巨大，<br>\n脸上写满惊恐。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative028"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "尽管拥有【千里眼】魔法，<br>\n这双眼却再也看不到任何东西了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative029"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "可可已经完全停止了生命活动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative030"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "成群聚集在她头部飞舞的赤蝶，<br>\n似乎昭示着她是被射穿额头而当场死亡的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative031"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "可可……！！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro012"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "我急忙想跑过去，<br>\n却突然发现。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative032"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "艾玛正站在可可的尸体前。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative033"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "她视线涣散，眼里毫无感情，<br>\n俯视着可可。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative034"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "——手里还拿着把枪。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative035"]}},
    {"op": "ResetText", "line": 204, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 206, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#8888BB", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "HideActors", "line": 208, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "Wait", "line": 210, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "是你……向可可开枪的吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "听见我的问话，<br>\n艾玛仿佛才回过神来，回头看向我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative036"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "希罗？<br>\n……不是的，我怎么会——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "那这把手枪是怎么回事？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro014"]}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "这是……我看掉在地上就捡了起来。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema005"]}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "艾玛的辩解<br>\n让我心生怀疑，便眯起眼睛问她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative037"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "真的是这样吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro015"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "……什么意思？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema006"]}},
    {"op": "HideAllCharacters", "line": 236, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 237, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 238, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 239, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 240, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 242, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#808040", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 244, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 245, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "我感觉心情极差，<br>\n正准备离开房间。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative038"]}},
    {"op": "ModifyCharacterExtended", "line": 249, "indent": 0, "params": {"TintColor": "#808040", "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "…………", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema007"]}},
    {"op": "PrintTextModified", "line": 253, "indent": 0, "params": {"Text": "我用余光瞥见艾玛似乎发现了什么东西，<br>\n一下子藏到怀里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative039"]}},
    {"op": "PrintTextModified", "line": 255, "indent": 0, "params": {"Text": "（她藏了什么……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro016"]}},
    {"op": "HideAllCharacters", "line": 257, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ResetText", "line": 258, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 259, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 260, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 261, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyBackgroundExtended", "line": 263, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#8888BB", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "ModifyBackgroundExtended", "line": 265, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 266, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "ModifyCharacterExtended", "line": 272, "indent": 0, "params": {"TintColor": "#FFFFFF", "Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Ema.Fearful1"}},
    {"op": "ModifyCharacterExtended", "line": 273, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 275, "indent": 0, "params": {"Text": "在整理玛格遗物的时候，<br>\n你是不是偷偷藏了什么东西？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro017"]}},
    {"op": "PrintTextModified", "line": 277, "indent": 0, "params": {"Text": "……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema008"]}},
    {"op": "PrintTextModified", "line": 279, "indent": 0, "params": {"Text": "到底是什么？<br>\n该不会是手枪吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 281, "indent": 0, "params": {"TintColor": "#FFFFFF", "Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Ema.Pensive1"}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "那是——", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema009"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "你就是用这把枪杀死了可可，<br>\n把她从垃圾滑槽<br>\n扔进了焚烧炉吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro019"]}},
    {"op": "PrintTextModified", "line": 287, "indent": 0, "params": {"Text": "我没给她反驳的余地，<br>\n连珠炮似的逼问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative040"]}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema010"]}},
    {"op": "PrintTextModified", "line": 291, "indent": 0, "params": {"Text": "艾玛的眼神动摇了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative041"]}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "本以为她要哭出来了——<br>\n……没想到艾玛正用阴暗的眼神瞪着我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative042"]}},
    {"op": "ModifyCharacterExtended", "line": 295, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Angry1"}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "你说够了吗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema011"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "希罗，<br>\n你就那么想诬我为凶手……？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema012"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "这和我怎么想没关系。<br>\n而是所有的情况都在指明，你就是凶手。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro020"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "……我问你，希罗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema013"]}},
    {"op": "PrintTextModified", "line": 305, "indent": 0, "params": {"Text": "你把我叫到淋浴房，是陷阱？<br>\n这一切都是你为了诬陷我设下的局……？<br>", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema014"]}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "不知为何，我感到有股看不见摸不着的凉意<br>\n顺着背爬了上来，让我为之一抖。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative043"]}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "（我就知道，艾玛的本性果然——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro021"]}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "凶手难道不是希罗你吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema015"]}},
    {"op": "ResetText", "line": 313, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 314, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 317, "indent": 0, "params": {"SfxPath": "Sfx_71", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 319, "indent": 0, "params": {"WaitMode": "3"}},
    {"op": "ModifyCharacterExtended", "line": 320, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [40.0, 0.0, 1.0], "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "啊，艾玛，希罗！<br>\n你们在这啊！<br>\n我刚才好像看到了超级可怕的——", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 324, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 326, "indent": 0, "params": {"Text": "呼哧，呼哧，为什么要把我也拖过来……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hanna001"]}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "雪莉和汉娜也来到了中庭。<br>\n看起来是雪莉硬拉汉娜过来的。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative044"]}},
    {"op": "ModifyCharacterExtended", "line": 330, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Surprised1"}},
    {"op": "ModifyCharacterExtended", "line": 331, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Surprised1"}},
    {"op": "PrintTextModified", "line": 333, "indent": 0, "params": {"Text": "随后，她们立即注意到了眼前的场面。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative045"]}},
    {"op": "PrintTextModified", "line": 335, "indent": 0, "params": {"Text": "这是……", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 337, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hanna.Fearful1"}},
    {"op": "PrintTextModified", "line": 339, "indent": 0, "params": {"Text": "呀啊啊啊啊啊！？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hanna002"]}},
    {"op": "PrintTextModified", "line": 341, "indent": 0, "params": {"Text": "一看到可可的尸体汉娜就大声尖叫起来，<br>\n情不自禁地抓住雪莉。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative046"]}},
    {"op": "ModifyCharacterExtended", "line": 343, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
    {"op": "PrintTextModified", "line": 345, "indent": 0, "params": {"Text": "艾玛，那个手枪是……？", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Sherry003"]}},
    {"op": "HideAllCharacters", "line": 347, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 349, "indent": 0, "params": {"Text": "眼尖的雪莉立即询问起艾玛手里的手枪。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative047"]}},
    {"op": "ModifyCharacterExtended", "line": 351, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 353, "indent": 0, "params": {"Text": "不、不是的！<br>\n我只是把掉在地上的枪捡了起来！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema016"]}},
    {"op": "ModifyCharacterExtended", "line": 355, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 357, "indent": 0, "params": {"Text": "谁知道呢？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro022"]}},
    {"op": "ModifyCharacterExtended", "line": 359, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Angry1"}},
    {"op": "PrintTextModified", "line": 361, "indent": 0, "params": {"Text": "……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Ema017"]}},
    {"op": "PlaySfxModified", "line": 364, "indent": 0, "params": {"SfxPath": "Sfx_14", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 366, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "HideAllCharacters", "line": 367, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 369, "indent": 0, "params": {"Text": "就在此时，手机提示音响了起来。<br>\n大概是典狱长发来的通知吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative048"]}},
    {"op": "ModifyCharacterExtended", "line": 371, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 373, "indent": 0, "params": {"Text": "劝你还是在投票开始前，<br>\n想个更有说服力的借口吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro023"]}},
    {"op": "PrintTextModified", "line": 375, "indent": 0, "params": {"Text": "真相会在审判中揭晓。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Hiro024"]}},
    {"op": "ResetText", "line": 377, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 378, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 379, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 380, "indent": 0, "params": {"SfxPath": "Sfx_71", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 381, "indent": 0, "params": {"Scale": [1.0], "Duration": 0.5, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "Wait", "line": 382, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 383, "indent": 0, "params": {"Scale": [1.0], "Duration": 0.5, "Lazy": 0, "ScenePosition": [75.0], "IdAndAppearance": "AnAn.Surprised1,Angle01/Option_Arms-"}},
    {"op": "Wait", "line": 384, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 385, "indent": 0, "params": {"Scale": [1.0], "Duration": 0.5, "Lazy": 0, "ScenePosition": [25.0], "IdAndAppearance": "Nanoka.Surprised1"}},
    {"op": "Wait", "line": 386, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 388, "indent": 0, "params": {"Text": "其他少女也接二连三地被中庭的骚动吸引过来。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative049"]}},
    {"op": "HideAllCharacters", "line": 390, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 392, "indent": 0, "params": {"Text": "而我转身离开了中庭。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv15_Narrative050"]}},
    {"op": "UpdateWitchBook", "line": 394, "indent": 0, "params": {"Id": "Coco", "Category": "Profile", "Version": 6}},
    {"op": "Gosub", "line": 396, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 398, "indent": 0, "params": {"Path": "Act02_Chapter02/Act02_Chapter02_Adv16", "SoftReset": 1}}
  ],
  "translations": {
  "0202Adv15_Narrative001": "一跑进淋浴房——<br>\n就看到艾玛呆呆地站在原地。",
  "0202Adv15_Hiro001": "艾玛！",
  "0202Adv15_Ema001": "……希罗。",
  "0202Adv15_Narrative002": "淋浴房的门在我身后关上了。",
  "0202Adv15_Narrative003": "冰冷的氛围笼罩着我和艾玛。",
  "0202Adv15_Hiro002": "……可可在哪？",
  "0202Adv15_Ema002": "……你在说什么？",
  "0202Adv15_Narrative004": "我从她的脸上看不出任何感情，<br>\n便快速扫视了一圈淋浴房。",
  "0202Adv15_Narrative005": "可可不在。",
  "0202Adv15_Hiro003": "（怎么回事！？）",
  "0202Adv15_Narrative006": "我感到大脑一片混乱，<br>\n急忙走出淋浴房。",
  "0202Adv15_Narrative007": "但我不知该去哪，<br>\n只能先边走边思考。",
  "0202Adv15_Hiro004": "（这不对。可可去哪了？<br>\n　她刚才不是在淋浴房直播吗）",
  "0202Adv15_Hiro005": "（很明显她被枪击了）",
  "0202Adv15_Hiro006": "（那尸体究竟去哪里了……！<br>\n　如果被搬到了别处……那难道是）",
  "0202Adv15_Hiro007": "（……焚烧炉吗！）",
  "0202Adv15_Narrative008": "想到的一瞬间，<br>\n我立马冲了过去。",
  "0202Adv15_Hiro008": "（焚烧炉在地下……！<br>\n　现在应该还来得及……！）",
  "0202Adv15_Narrative009": "距离15时焚烧炉自动启动<br>\n还有一点时间。",
  "0202Adv15_Narrative010": "就在我冲进<br>\n会客厅的那一刻。",
  "0202Adv15_Hiro009": "——！",
  "0202Adv15_Narrative011": "一阵无比巨大的轰鸣声响起，<br>\n惊得我停下了脚步。",
  "0202Adv15_Narrative012": "我这才想起，汉娜先前说过。<br>\n现在在下雨。",
  "0202Adv15_Narrative013": "我实在是太着急了，<br>\n直到现在才注意到嘈杂的雨声。",
  "0202Adv15_Leia001": "刚才那个声音好大啊……！",
  "0202Adv15_AnAn001": "是不是有雷劈在附近了。",
  "0202Adv15_Narrative014": "会客厅里是蕾雅和安安。",
  "0202Adv15_Narrative015": "说起来，<br>\n刚才在去淋浴房的路上也看到了她们。",
  "0202Adv15_Narrative016": "下一秒。<br>\n就在这激烈的雨声与雷声交织的间隙——",
  "0202Adv15_Ema003": "噫……啊啊啊……！",
  "0202Adv15_Narrative017": "传来一声抽搐着的凄惨尖叫。",
  "0202Adv15_Hiro010": "（这声音，是艾玛……？）",
  "0202Adv15_Narrative018": "我转身看向走廊。",
  "0202Adv15_Narrative019": "走廊有扇通往中庭的门。<br>\n而门是开着的。",
  "0202Adv15_Narrative020": "但我刚刚经过那里时，<br>\n门应该是关着的。",
  "0202Adv15_Hiro011": "（……是艾玛开的吗？）",
  "0202Adv15_Narrative021": "刚才的雷击和嘈杂的雨声，<br>\n都仿佛是一种凶兆。",
  "0202Adv15_Narrative022": "自打看了可可的直播，<br>\n我的心跳就一直吵得不行。",
  "0202Adv15_Narrative023": "像是被一股力量吸引过去似的，<br>\n我独自迈着摇摇晃晃的步子走向中庭。",
  "0202Adv15_Narrative024": "然后——",
  "0202Adv15_Narrative025": "那倾盆大雨似乎只是阵雨。",
  "0202Adv15_Narrative026": "在下着小雨的中庭——",
  "0202Adv15_Narrative027": "毒舌直播主少女泽渡可可，<br>\n正仰面倒在地上。",
  "0202Adv15_Narrative028": "她双眼瞪得巨大，<br>\n脸上写满惊恐。",
  "0202Adv15_Narrative029": "尽管拥有【千里眼】魔法，<br>\n这双眼却再也看不到任何东西了。",
  "0202Adv15_Narrative030": "可可已经完全停止了生命活动。",
  "0202Adv15_Narrative031": "成群聚集在她头部飞舞的赤蝶，<br>\n似乎昭示着她是被射穿额头而当场死亡的。",
  "0202Adv15_Hiro012": "可可……！！",
  "0202Adv15_Narrative032": "我急忙想跑过去，<br>\n却突然发现。",
  "0202Adv15_Narrative033": "艾玛正站在可可的尸体前。",
  "0202Adv15_Narrative034": "她视线涣散，眼里毫无感情，<br>\n俯视着可可。",
  "0202Adv15_Narrative035": "——手里还拿着把枪。",
  "0202Adv15_Hiro013": "是你……向可可开枪的吗？",
  "0202Adv15_Narrative036": "听见我的问话，<br>\n艾玛仿佛才回过神来，回头看向我。",
  "0202Adv15_Ema004": "希罗？<br>\n……不是的，我怎么会——",
  "0202Adv15_Hiro014": "那这把手枪是怎么回事？",
  "0202Adv15_Ema005": "这是……我看掉在地上就捡了起来。",
  "0202Adv15_Narrative037": "艾玛的辩解<br>\n让我心生怀疑，便眯起眼睛问她。",
  "0202Adv15_Hiro015": "真的是这样吗。",
  "0202Adv15_Ema006": "……什么意思？",
  "0202Adv15_Narrative038": "我感觉心情极差，<br>\n正准备离开房间。",
  "0202Adv15_Ema007": "…………",
  "0202Adv15_Narrative039": "我用余光瞥见艾玛似乎发现了什么东西，<br>\n一下子藏到怀里。",
  "0202Adv15_Hiro016": "（她藏了什么……？）",
  "0202Adv15_Hiro017": "在整理玛格遗物的时候，<br>\n你是不是偷偷藏了什么东西？",
  "0202Adv15_Ema008": "……！",
  "0202Adv15_Hiro018": "到底是什么？<br>\n该不会是手枪吧？",
  "0202Adv15_Ema009": "那是——",
  "0202Adv15_Hiro019": "你就是用这把枪杀死了可可，<br>\n把她从垃圾滑槽<br>\n扔进了焚烧炉吧？",
  "0202Adv15_Narrative040": "我没给她反驳的余地，<br>\n连珠炮似的逼问道。",
  "0202Adv15_Ema010": "……",
  "0202Adv15_Narrative041": "艾玛的眼神动摇了一下。",
  "0202Adv15_Narrative042": "本以为她要哭出来了——<br>\n……没想到艾玛正用阴暗的眼神瞪着我。",
  "0202Adv15_Ema011": "你说够了吗。",
  "0202Adv15_Ema012": "希罗，<br>\n你就那么想诬我为凶手……？",
  "0202Adv15_Hiro020": "这和我怎么想没关系。<br>\n而是所有的情况都在指明，你就是凶手。",
  "0202Adv15_Ema013": "……我问你，希罗。",
  "0202Adv15_Ema014": "你把我叫到淋浴房，是陷阱？<br>\n这一切都是你为了诬陷我设下的局……？<br>",
  "0202Adv15_Narrative043": "不知为何，我感到有股看不见摸不着的凉意<br>\n顺着背爬了上来，让我为之一抖。",
  "0202Adv15_Hiro021": "（我就知道，艾玛的本性果然——）",
  "0202Adv15_Ema015": "凶手难道不是希罗你吗？",
  "0202Adv15_Sherry001": "啊，艾玛，希罗！<br>\n你们在这啊！<br>\n我刚才好像看到了超级可怕的——",
  "0202Adv15_Hanna001": "呼哧，呼哧，为什么要把我也拖过来……",
  "0202Adv15_Narrative044": "雪莉和汉娜也来到了中庭。<br>\n看起来是雪莉硬拉汉娜过来的。<br>",
  "0202Adv15_Narrative045": "随后，她们立即注意到了眼前的场面。<br>",
  "0202Adv15_Sherry002": "这是……",
  "0202Adv15_Hanna002": "呀啊啊啊啊啊！？",
  "0202Adv15_Narrative046": "一看到可可的尸体汉娜就大声尖叫起来，<br>\n情不自禁地抓住雪莉。<br>",
  "0202Adv15_Sherry003": "艾玛，那个手枪是……？",
  "0202Adv15_Narrative047": "眼尖的雪莉立即询问起艾玛手里的手枪。<br>",
  "0202Adv15_Ema016": "不、不是的！<br>\n我只是把掉在地上的枪捡了起来！",
  "0202Adv15_Hiro022": "谁知道呢？",
  "0202Adv15_Ema017": "……",
  "0202Adv15_Narrative048": "就在此时，手机提示音响了起来。<br>\n大概是典狱长发来的通知吧。",
  "0202Adv15_Hiro023": "劝你还是在投票开始前，<br>\n想个更有说服力的借口吧。",
  "0202Adv15_Hiro024": "真相会在审判中揭晓。",
  "0202Adv15_Narrative049": "其他少女也接二连三地被中庭的骚动吸引过来。<br>",
  "0202Adv15_Narrative050": "而我转身离开了中庭。<br>"
}
}
