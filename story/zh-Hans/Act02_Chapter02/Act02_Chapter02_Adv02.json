    {"op": "Wait", "line": 259, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "ModifyBackgroundExtended", "line": 260, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "Wait", "line": 262, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyBackgroundExtended", "line": 263, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 264, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlayBgm", "line": 265, "indent": 0, "params": {"BgmPath": "Bgm_20_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 267, "indent": 0, "params": {"Text": "——监狱生活第二轮，第十一天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative026"]}},
    {"op": "PrintTextModified", "line": 269, "indent": 0, "params": {"Text": "——我要杀死魔女。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative027"]}},
    {"op": "PrintTextModified", "line": 271, "indent": 0, "params": {"Text": "——杀。杀。杀。杀。<br>\n杀杀杀杀杀杀杀杀杀杀", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative028"]}},
    {"op": "Gosub", "line": 273, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 275, "indent": 0, "params": {"Path": "Act02_Chapter02/Act02_Chapter02_Adv03", "SoftReset": 1}}
  ],
  "translations": {
  "0202Adv02_Narrative001": "我吃完早餐，<br>\n应蕾雅邀请来到了会客厅。",
  "0202Adv02_Narrative002": "进来以后，发现所有人都已经到齐了。",
  "0202Adv02_Hiro001": "（这倒是有点出乎意料……<br>\n　不，也许有些人只是想法和我一样）",
  "0202Adv02_Coco001": "说吧，你要商量什么事？",
  "0202Adv02_Miria001": "你是想到了什么<br>\n逃出这里的办法吗？",
  "0202Adv02_Leia001": "啊，不是的，抱歉让你们误会了。<br>\n关于逃出去的方法，我还没有什么主意。",
  "0202Adv02_Coco002": "搞什么嘛，真让人失望！",
  "0202Adv02_Narrative003": "面对可可的骂声，<br>\n蕾雅为难地笑了笑。",
  "0202Adv02_Nanoka001": "那你到底要商量什么？",
  "0202Adv02_Leia002": "我想和大家一起商量，<br>\n怎么才能让命案不再继续发生。",
  "0202Adv02_Hiro002": "……那你有什么好主意吗？",
  "0202Adv02_Narrative004": "对于正在谋划杀害艾玛的我来说，<br>\n这个话题可不能错过。",
  "0202Adv02_Leia003": "是的，希望大家能听我说。",
  "0202Adv02_Narrative005": "在一众少女的注视下，<br>\n蕾雅摆出演讲般的架势开口说道。",
  "0202Adv02_Narrative006": "只要不发生杀人案件，就不会举行魔女审判。",
  "0202Adv02_Narrative007": "这样一来至少就不会有人惨遭杀害，<br>\n也不会有人被残忍处决。",
  "0202Adv02_Leia004": "正如我先前说的，<br>\n为此我们一定要团结一心。",
  "0202Adv02_Leia005": "也就是说，我们必须深化交流，<br>\n让彼此更加熟稔起来。",
  "0202Adv02_Ema001": "嗯……就是说<br>\n大家要搞好关系吗？",
  "0202Adv02_Leia006": "嗯，没错，只要大家搞好关系，对彼此有了情感，<br>\n发生杀人案的概率就会降低。",
  "0202Adv02_Leia007": "虽然过于亲密<br>\n也可能会招来摩擦和矛盾，<br>\n但至少——",
  "0202Adv02_Leia008": "就不太容易因一时冲动而杀人了。<br>",
  "0202Adv02_Coco003": "什么啊恶心死了！你脑袋被门夹了吗？<br>\n在这种情况下谁有心情陪你玩朋友过家家！",
  "0202Adv02_Leia009": "你怎么说都可以。<br>\n我知道大家很难认同，也知道这不是一件易事，<br>\n但我依然要提出这个方案。",
  "0202Adv02_Narrative008": "蕾雅并没有因为可可的批评而退缩，继续说道。",
  "0202Adv02_Leia010": "这样总比什么都不做更有意义，<br>\n大家不觉得吗？",
  "0202Adv02_Coco004": "比起这些有的没的，还是努力想办法逃出去<br>\n更有用啦！",
  "0202Adv02_Leia011": "当然，摸索逃走的办法也很重要。<br>\n但我们都被囚禁在这里，能做的事实在有限。",
  "0202Adv02_Miria002": "嗯，感觉能调查的地方<br>\n都已经调查个遍了……",
  "0202Adv02_Leia012": "正是如此。所以我觉得<br>\n也该从其他方向入手，探索生存之道。",
  "0202Adv02_Narrative009": "看起来除了某几个人以外，<br>\n大部分人对蕾雅的话还是认同的。",
  "0202Adv02_Hiro003": "（寻找活下去的道路是正确的。<br>\n　只不过……）",
  "0202Adv02_Narrative010": "我悄悄看向艾玛。<br>\n接着依次环顾会客厅里的所有人。",
  "0202Adv02_Hiro004": "（现在的我，已经下定决心要杀艾玛了。<br>\n　那么，我就不能同意让大家更加亲近的提议）<br>",
  "0202Adv02_Hanna001": "你说要让大家搞好关系，<br>\n那具体要做些什么呢？",
  "0202Adv02_Leia013": "哈哈哈，汉娜！<br>\n真是个好问题！",
  "0202Adv02_Narrative011": "像是对这个问题盼望已久似的，<br>\n蕾雅两眼放光。",
  "0202Adv02_Leia014": "要加深我们的友情，<br>\n就需要大家朝着共同的目标同甘共苦、携手前行。",
  "0202Adv02_Narrative012": "蕾雅用戏剧般的肢体语言向众人宣言。<br>",
  "0202Adv02_Leia015": "让我们来携手创作舞台剧吧！<br>\n大家团结一心，共演一幕好戏！",
  "0202Adv02_Narrative013": "……瞬间，房间里鸦雀无声。",
  "0202Adv02_Narrative014": "正当我们都被尴尬得愣在原地时，<br>\n有个不看气氛的人却鼓起掌来。",
  "0202Adv02_Sherry001": "太棒了！真是个无与伦比的好主意！<br>\n大家共同朝着一个目标努力……<br>\n我们的感情一定会更深的！",
  "0202Adv02_Hanna002": "舞台剧……是演给谁看的？<br>\n该不会给典狱长和看守看吧？",
  "0202Adv02_Narrative015": "与兴致勃勃的雪莉截然相反，<br>\n汉娜有些无语地质问道。",
  "0202Adv02_Narrative016": "囚犯在台上演戏，<br>\n典狱长和看守在台下看戏——",
  "0202Adv02_Narrative017": "这场面想想就觉得滑稽。",
  "0202Adv02_Narrative018": "不过，雪莉的积极性带动了其他人，<br>\n让大家开始你一言我一语地说出自己的看法。",
  "0202Adv02_Noah001": "演戏啊～感觉好好玩！<br>\n可以呀，诺亚也来帮忙！",
  "0202Adv02_AnAn001": "『可以考虑』",
  "0202Adv02_Nanoka002": "……随你们便吧。<br>\n但我不会参加。<br>\n我有自己必须要做的事。",
  "0202Adv02_Alisa001": "……懒得理你们。",
  "0202Adv02_Coco005": "我也算了……话说，还演戏呢。<br>\n现在可不是搞这种事的时候吧。",
  "0202Adv02_Narrative019": "奈叶香、亚里沙和可可三人<br>\n兴致缺缺地离开了会客厅。",
  "0202Adv02_Leia016": "很遗憾，不过这也没办法。<br>\n……希罗，你怎么想？",
  "0202Adv02_Hiro005": "我也不参加了吧。<br>\n没什么心情和你们嬉戏打闹。",
  "0202Adv02_Narrative020": "在上一起案件的先行投票中，<br>\n我才刚被当成凶手。",
  "0202Adv02_Narrative021": "蕾雅大概也是对此深感内疚，<br>\n像是带着几分愧疚似的皱起眉。",
  "0202Adv02_Leia017": "……这样啊，那真的很可惜。",
  "0202Adv02_Narrative022": "说句实话，<br>\n对被当做凶手一事我已经不再生气了。",
  "0202Adv02_Narrative023": "在那种情况下，就算是我站在她们的立场上，<br>\n我也会这么投票的。",
  "0202Adv02_Narrative024": "她们的判断是正确的。",
  "0202Adv02_Hiro006": "（可是，<br>\n　我现在已经不能再和你们做朋友了）",
  "0202Adv02_Narrative025": "见蕾雅的神色如此悲伤，我心怀着几分焦躁与不安<br>\n离开了会客厅。",
  "0202Adv02_Narrative026": "——监狱生活第二轮，第十一天。",
  "0202Adv02_Narrative027": "——我要杀死魔女。",
  "0202Adv02_Narrative028": "——杀。杀。杀。杀。<br>\n杀杀杀杀杀杀杀杀杀杀"
}
}
