  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter02/Act02_Chapter02_Adv02",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "ModifyBackgroundExtended", "line": 4, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "label", "name": "Scene2-2-2", "line": 6, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 12, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 14, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 16, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "我吃完早餐，<br>\n应蕾雅邀请来到了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "进来以后，发现所有人都已经到齐了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative002"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "（这倒是有点出乎意料……<br>\n　不，也许有些人只是想法和我一样）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "说吧，你要商量什么事？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Coco001"]}},
    {"op": "ModifyCharacterExtended", "line": 28, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Miria.Normal1"}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "你是想到了什么<br>\n逃出这里的办法吗？", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Miria001"]}},
    {"op": "HideAllCharacters", "line": 32, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "啊，不是的，抱歉让你们误会了。<br>\n关于逃出去的方法，我还没有什么主意。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia001"]}},
    {"op": "HideAllCharacters", "line": 37, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 38, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 39, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia"}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "搞什么嘛，真让人失望！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Coco002"]}},
    {"op": "ModifyCharacterExtended", "line": 43, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "面对可可的骂声，<br>\n蕾雅为难地笑了笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative003"]}},
    {"op": "HideActors", "line": 47, "indent": 0, "params": {"ActorIds": ["Coco"], "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 48, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Nanoka"}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "那你到底要商量什么？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "我想和大家一起商量，<br>\n怎么才能让命案不再继续发生。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia002"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "……那你有什么好主意吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hiro002"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "对于正在谋划杀害艾玛的我来说，<br>\n这个话题可不能错过。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative004"]}},
    {"op": "HideAllCharacters", "line": 60, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "是的，希望大家能听我说。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia003"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "在一众少女的注视下，<br>\n蕾雅摆出演讲般的架势开口说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative005"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "只要不发生杀人案件，就不会举行魔女审判。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "这样一来至少就不会有人惨遭杀害，<br>\n也不会有人被残忍处决。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative007"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "正如我先前说的，<br>\n为此我们一定要团结一心。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia004"]}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "也就是说，我们必须深化交流，<br>\n让彼此更加熟稔起来。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia005"]}},
    {"op": "HideAllCharacters", "line": 75, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Surprised1"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "嗯……就是说<br>\n大家要搞好关系吗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Ema001"]}},
    {"op": "HideAllCharacters", "line": 80, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "嗯，没错，只要大家搞好关系，对彼此有了情感，<br>\n发生杀人案的概率就会降低。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 85, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "虽然过于亲密<br>\n也可能会招来摩擦和矛盾，<br>\n但至少——", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia007"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "就不太容易因一时冲动而杀人了。<br>", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia008"]}},
    {"op": "HideAllCharacters", "line": 93, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "什么啊恶心死了！你脑袋被门夹了吗？<br>\n在这种情况下谁有心情陪你玩朋友过家家！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Coco003"]}},
    {"op": "HideAllCharacters", "line": 98, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia"}},
    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "你怎么说都可以。<br>\n我知道大家很难认同，也知道这不是一件易事，<br>\n但我依然要提出这个方案。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia009"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "蕾雅并没有因为可可的批评而退缩，继续说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "这样总比什么都不做更有意义，<br>\n大家不觉得吗？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia010"]}},
    {"op": "HideAllCharacters", "line": 109, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco"}},
    {"op": "ModifyCharacterExtended", "line": 111, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "比起这些有的没的，还是努力想办法逃出去<br>\n更有用啦！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Coco004"]}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "当然，摸索逃走的办法也很重要。<br>\n但我们都被囚禁在这里，能做的事实在有限。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia011"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Miria.Pensive1"}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "嗯，感觉能调查的地方<br>\n都已经调查个遍了……", "AuthorId": "Miria", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Miria002"]}},
    {"op": "ModifyCharacterExtended", "line": 123, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "正是如此。所以我觉得<br>\n也该从其他方向入手，探索生存之道。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia012"]}},
    {"op": "HideAllCharacters", "line": 127, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "看起来除了某几个人以外，<br>\n大部分人对蕾雅的话还是认同的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "（寻找活下去的道路是正确的。<br>\n　只不过……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hiro003"]}},
    {"op": "ModifyCharacterExtended", "line": 133, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "我悄悄看向艾玛。<br>\n接着依次环顾会客厅里的所有人。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 137, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 139, "indent": 0, "params": {"Text": "（现在的我，已经下定决心要杀艾玛了。<br>\n　那么，我就不能同意让大家更加亲近的提议）<br>", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 141, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hanna.Normal1"}},
    {"op": "PrintTextModified", "line": 143, "indent": 0, "params": {"Text": "你说要让大家搞好关系，<br>\n那具体要做些什么呢？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 145, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 147, "indent": 0, "params": {"Text": "哈哈哈，汉娜！<br>\n真是个好问题！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia013"]}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "像是对这个问题盼望已久似的，<br>\n蕾雅两眼放光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative011"]}},
    {"op": "HideAllCharacters", "line": 151, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 152, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "要加深我们的友情，<br>\n就需要大家朝着共同的目标同甘共苦、携手前行。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia014"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "蕾雅用戏剧般的肢体语言向众人宣言。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 158, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR2,ArmL3"}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "让我们来携手创作舞台剧吧！<br>\n大家团结一心，共演一幕好戏！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia015"]}},
    {"op": "StopBgm", "line": 162, "indent": 0, "params": {}},
    {"op": "HidePrinter", "line": 163, "indent": 0, "params": {}},
    {"op": "Wait", "line": 164, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "……瞬间，房间里鸦雀无声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative013"]}},
    {"op": "PlaySfxModified", "line": 169, "indent": 0, "params": {"SfxPath": "Sfx_125", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 170, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "正当我们都被尴尬得愣在原地时，<br>\n有个不看气氛的人却鼓起掌来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative014"]}},
    {"op": "HideAllCharacters", "line": 174, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 175, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlayBgm", "line": 177, "indent": 0, "params": {"BgmPath": "Bgm_5_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Sherry.Smile"}},
    {"op": "Wait", "line": 180, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "太棒了！真是个无与伦比的好主意！<br>\n大家共同朝着一个目标努力……<br>\n我们的感情一定会更深的！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Sherry001"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hanna.Pensive1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "舞台剧……是演给谁看的？<br>\n该不会给典狱长和看守看吧？", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hanna002"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "与兴致勃勃的雪莉截然相反，<br>\n汉娜有些无语地质问道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 190, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "囚犯在台上演戏，<br>\n典狱长和看守在台下看戏——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative016"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "这场面想想就觉得滑稽。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative017"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "不过，雪莉的积极性带动了其他人，<br>\n让大家开始你一言我一语地说出自己的看法。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative018"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 199, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Normal1,Arms2,Angle01/Option_Arms>Option_Arms01_05,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 201, "indent": 0, "params": {"Text": "演戏啊～感觉好好玩！<br>\n可以呀，诺亚也来帮忙！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Noah001"]}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "『可以考虑』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_AnAn001"]}},
    {"op": "HideAllCharacters", "line": 205, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 206, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Nanoka.Default"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "……随你们便吧。<br>\n但我不会参加。<br>\n我有自己必须要做的事。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Nanoka002"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [20.0], "IdAndAppearance": "Alisa.Pensive1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "……懒得理你们。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "我也算了……话说，还演戏呢。<br>\n现在可不是搞这种事的时候吧。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Coco005"]}},
    {"op": "HideAllCharacters", "line": 218, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "奈叶香、亚里沙和可可三人<br>\n兴致缺缺地离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "很遗憾，不过这也没办法。<br>\n……希罗，你怎么想？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia016"]}},
    {"op": "HideAllCharacters", "line": 226, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 227, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "我也不参加了吧。<br>\n没什么心情和你们嬉戏打闹。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 231, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "在上一起案件的先行投票中，<br>\n我才刚被当成凶手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative020"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "蕾雅大概也是对此深感内疚，<br>\n像是带着几分愧疚似的皱起眉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 237, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "……这样啊，那真的很可惜。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Leia017"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "说句实话，<br>\n对被当做凶手一事我已经不再生气了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative022"]}},
    {"op": "PrintTextModified", "line": 243, "indent": 0, "params": {"Text": "在那种情况下，就算是我站在她们的立场上，<br>\n我也会这么投票的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative023"]}},
    {"op": "PrintTextModified", "line": 245, "indent": 0, "params": {"Text": "她们的判断是正确的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative024"]}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "（可是，<br>\n　我现在已经不能再和你们做朋友了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Hiro006"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "见蕾雅的神色如此悲伤，我心怀着几分焦躁与不安<br>\n离开了会客厅。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv02_Narrative025"]}},
    {"op": "StopBgm", "line": 251, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 252, "indent": 0, "params": {"Lazy": 0}},
