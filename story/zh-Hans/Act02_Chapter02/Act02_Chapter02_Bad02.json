  "path": "Act02_Chapter02/Act02_Chapter02_Bad02",
  "events": [
    {"op": "BeginIf", "line": 1, "indent": 0, "params": {"Expression": "isDebugDirectJump"}},
    {"op": "Gosub", "line": 2, "indent": 1, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-2-b2", "line": 12, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 18, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "9_1"}},
    {"op": "ModifyBackgroundExtended", "line": 19, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 20, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 22, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 25, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "我得想办法把她赶走。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative001"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "刚才，我听到有人说要来洗澡。<br>\n要是你在这画画的话，人家就没办法洗澡了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro001"]}},
    {"op": "ModifyCharacterExtended", "line": 31, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "况且，这里本来就是不让画画的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Angry1"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "唔～真小气。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Noah001"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "诺亚有些闹别扭似的鼓起脸颊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative002"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 43, "indent": 0, "params": {"Text": "如果你实在想画的话，<br>\n也要等别人洗完澡再来画。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro003"]}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "明明有专门用来画画的地方，<br>\n就不要到这里来给人添麻烦了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "……唔～好吧。<br>\n那我去画室里画了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Noah002"]}},
    {"op": "HideActors", "line": 51, "indent": 0, "params": {"ActorIds": ["Noah"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "诺亚气鼓鼓的很是不高兴，<br>\n但还是转身回了自己的画室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "StopBgm", "line": 56, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "（很好，这下就没人碍事了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 60, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "我仔细确认过周围没人以后，<br>\n走进淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative004"]}},
    {"op": "ModifyBackgroundExtended", "line": 64, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "30_2"}},
    {"op": "PlayBgm", "line": 65, "indent": 0, "params": {"BgmPath": "Bgm_27_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "（接下来，只要等艾玛过来……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro006"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "我边祈祷别再有人闯进来边等了一会，<br>\n到了约好的时间，艾玛准时来了淋浴房。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 71, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Normal1"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "啊，希罗……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema001"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "艾玛，你来了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 77, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Ema.Smile1"}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "嗯，我们约好了嘛！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema002"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "（啊，真叫人作呕）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 83, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "一看到她这张傻乎乎的脸，<br>\n我就气得快要七窍生烟。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative006"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "（我得赶紧消灭掉<br>\n　她这样不正确的存在）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro009"]}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "我努力按捺住熊熊燃烧的怒火，<br>\n按照计划好的那样，装作换衣服的样子<br>\n握紧在画室找到的工具。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative007"]}},
    {"op": "ResetText", "line": 91, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 92, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 93, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 94, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCamera", "line": 95, "indent": 0, "params": {"Offset": [0.0, 2.0], "Zoom": 0.5, "Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 96, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "然后，走到正在换衣服的艾玛身后。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative008"]}},
    {"op": "ModifyBackgroundExtended", "line": 100, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 101, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "（啊，终于到这时候了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro010"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "……不知怎的，<br>\n我回想起了以前的时光。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema003"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "（终于——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro011"]}},
    {"op": "PrintTextModified", "line": 109, "indent": 0, "params": {"Text": "我们以前……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema004"]}},
    {"op": "ResetText", "line": 111, "indent": 0, "params": {}},
    {"op": "Wait", "line": 112, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "……希罗？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema005"]}},
    {"op": "ModifyCharacterExtended", "line": 116, "indent": 0, "params": {"Duration": 1.0, "Lazy": 0, "IdAndAppearance": "Hiro.Smile1"}},
    {"op": "Wait", "line": 117, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "——能杀死你了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro012"]}},
    {"op": "StopBgm", "line": 121, "indent": 0, "params": {}},
    {"op": "PlaySfxModified", "line": 124, "indent": 0, "params": {"SfxPath": "Sfx_167", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 126, "indent": 0, "params": {"TintColor": "#660000FF", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 127, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCamera", "line": 128, "indent": 0, "params": {"Offset": [0.0], "Zoom": 0.0, "Lazy": 0}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "呜啊……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema006"]}},
    {"op": "PlayBgm", "line": 132, "indent": 0, "params": {"BgmPath": "Bgm_27_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "HideAllCharacters", "line": 133, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 134, "indent": 0, "params": {"Scale": [2.5], "Duration": 0.0, "Lazy": 0, "ScenePosition": [125.0], "AppearanceAndTransition": "30_2"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "艾玛当即倒下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative009"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "（——我杀死她了！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro013"]}},
    {"op": "PrintTextModified", "line": 140, "indent": 0, "params": {"Text": "太好了。<br>\n我终于杀死艾玛了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative010"]}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "有多久没体会到如此痛快的感觉了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative011"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "我按捺住冲上心头的喜悦之情，<br>\n抓着艾玛的肩膀把她抱起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative012"]}},
    {"op": "ModifyBackgroundExtended", "line": 146, "indent": 0, "params": {"TintColor": "#FF000044", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 147, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 149, "indent": 0, "params": {"Text": "丢着不管的话，<br>\n她的尸体迟早会被找到。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative013"]}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "我得把艾玛丢进垃圾滑槽里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative014"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "本以为尸体会很沉，<br>\n没想到我可以轻轻松松抬起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative015"]}},
    {"op": "PrintTextModified", "line": 155, "indent": 0, "params": {"Text": "心底荡漾着欢欣与喜悦，<br>\n仿佛不再是原来的那个我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative016"]}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "这是怎么回事——<br>\n算了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro014"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "尽管我感到有一丝异样，但现在可顾不上那么多了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative017"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "我把艾玛的尸体塞进垃圾滑槽里。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative018"]}},
    {"op": "PlaySfxModified", "line": 164, "indent": 0, "params": {"SfxPath": "Sfx_168", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 166, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 0.20000000298023224, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "就这样，她的尸体顺着滑槽掉了下去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative019"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "我一边用淋浴头冲洗血迹，一边等待。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative020"]}},
    {"op": "ModifyBackgroundExtended", "line": 172, "indent": 0, "params": {"TintColor": "#00000044", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "SpawnBlur", "line": 173, "indent": 0, "params": {"ActorId": "MainBackground"}},
    {"op": "Wait", "line": 174, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "下方是焚烧炉。<br>\n下午3点启动。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative021"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "（快了，时间快到了……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro015"]}},
    {"op": "StopBgm", "line": 180, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "正当我万分焦急地盯着手机上的时钟时，<br>\n却忽然听见滑槽底下传来了声音。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative022"]}},
    {"op": "PlayBgm", "line": 184, "indent": 0, "params": {"BgmPath": "Bgm_27_3", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "呜、呜呜……<br>\n希罗，希罗，救救我……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema007"]}},
    {"op": "PrintTextModified", "line": 191, "indent": 0, "params": {"Text": "（艾玛的声音……！？<br>\n　她没死吗……！？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro016"]}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "怎么会这样。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative023"]}},
    {"op": "PrintTextModified", "line": 195, "indent": 0, "params": {"Text": "我又看了眼时钟。<br>\n焚烧炉的启动时间正一分一秒地逼近。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative024"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "求求你！求求你了……！<br>\n救我出去！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema008"]}},
    {"op": "PrintTextModified", "line": 205, "indent": 0, "params": {"Text": "对不起！是我错了……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema009"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "小雪是我害死的！<br>\n对不起，希罗！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema010"]}},
    {"op": "PrintTextModified", "line": 215, "indent": 0, "params": {"Text": "都是我的错！求你救救我吧……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema011"]}},
    {"op": "PrintTextModified", "line": 217, "indent": 0, "params": {"Text": "（……你总算醒悟了吗）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro017"]}},
    {"op": "PrintTextModified", "line": 219, "indent": 0, "params": {"Text": "不正确的存在必须要烧得一干二净。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative025"]}},
    {"op": "PrintTextModified", "line": 221, "indent": 0, "params": {"Text": "你说得没错，艾玛。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro018"]}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "你这个有罪之人就带着悔恨去死吧。<br>\n……你会死在这里的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro019"]}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "什么……！<br>\n对不起，希罗……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema012"]}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "烦死了……去死！去死！去死！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro020"]}},
    {"op": "StopBgm", "line": 232, "indent": 0, "params": {}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "对不起！对不起！！<br>\n对不起……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema013"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "……啊，到时间了。<br>\n不正确的存在终于要从这个世上消失了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro021"]}},
    {"op": "PlayBgm", "line": 242, "indent": 0, "params": {"BgmPath": "Ambi_6_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 247, "indent": 0, "params": {"Text": "啊啊啊啊啊啊啊啊啊啊啊！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Ema014"]}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "呵呵，哈哈哈哈。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro022"]}},
    {"op": "PrintTextModified", "line": 251, "indent": 0, "params": {"Text": "垃圾滑槽里传来的濒死惨叫<br>\n淹没了我的笑声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative026"]}},
    {"op": "ResetText", "line": 253, "indent": 0, "params": {}},
    {"op": "StopBgm", "line": 254, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 256, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 257, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "SpawnBlur", "line": 258, "indent": 0, "params": {"ActorId": "MainBackground", "Intensity": 0.0}},
    {"op": "PrintTextModified", "line": 260, "indent": 0, "params": {"Text": "————", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative027"]}},
    {"op": "ResetText", "line": 262, "indent": 0, "params": {}},
    {"op": "Wait", "line": 263, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "ModifyBackgroundExtended", "line": 265, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0, 50.0], "AppearanceAndTransition": "13_1"}},
    {"op": "ModifyCharacterExtended", "line": 267, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "ModifyBackgroundExtended", "line": 268, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.10000000149011612, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "好了！那么，<br>\n现在开始执行对魔女的刑罚～", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Warden001"]}},
    {"op": "ResetText", "line": 272, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 273, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 276, "indent": 0, "params": {"SfxPath": "Sfx_36", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 277, "indent": 0, "params": {"BgmPath": "Bgm_44_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 279, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 281, "indent": 0, "params": {"Text": "这是……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro023"]}},
    {"op": "PrintTextModified", "line": 283, "indent": 0, "params": {"Text": "我能清楚地看见，<br>\n那些观望处刑现场的少女脸上的表情。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative028"]}},
    {"op": "PrintTextModified", "line": 285, "indent": 0, "params": {"Text": "所有人都极度厌恶地看着我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative029"]}},
    {"op": "ModifyCharacterExtended", "line": 287, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Angry1"}},
    {"op": "PrintTextModified", "line": 289, "indent": 0, "params": {"Text": "……为什么你要杀了艾玛亲！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Coco001"]}},
    {"op": "HideAllCharacters", "line": 291, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 293, "indent": 0, "params": {"Text": "（……没错）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro024"]}},
    {"op": "PrintTextModified", "line": 295, "indent": 0, "params": {"Text": "（审判的结果是……我杀害艾玛的罪行败露，<br>\n　得到了最高票数）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro025"]}},
    {"op": "PrintTextModified", "line": 297, "indent": 0, "params": {"Text": "（在我击中她的那一瞬间……她就死了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro026"]}},
    {"op": "PrintTextModified", "line": 299, "indent": 0, "params": {"Text": "（原来我最后听见的那些忏悔和惨叫……<br>\n　只是我的幻觉）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro027"]}},
    {"op": "PrintTextModified", "line": 301, "indent": 0, "params": {"Text": "（……然而，无论那些东西是真是假）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro028"]}},
    {"op": "PrintTextModified", "line": 303, "indent": 0, "params": {"Text": "（事实就是……我杀害了艾玛）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro029"]}},
    {"op": "ModifyCharacterExtended", "line": 305, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Smile1"}},
    {"op": "PrintTextModified", "line": 307, "indent": 0, "params": {"Text": "我感到心里无比的畅快。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative030"]}},
    {"op": "PrintTextModified", "line": 309, "indent": 0, "params": {"Text": "（我的确杀死了艾玛，这是无可辩驳的事实。<br>\n　犯罪者本就该受到正义的制裁）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro030"]}},
    {"op": "PrintTextModified", "line": 311, "indent": 0, "params": {"Text": "（即便我杀死的是<br>\n　不正确的存在）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro031"]}},
    {"op": "PrintTextModified", "line": 313, "indent": 0, "params": {"Text": "而且，我还有【下次机会】。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative031"]}},
    {"op": "ModifyBackgroundExtended", "line": 315, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 316, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "所以，下一次。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Narrative032"]}},
    {"op": "PrintTextModified", "line": 320, "indent": 0, "params": {"Text": "（我一定会做得更好）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro032"]}},
    {"op": "PrintTextModified", "line": 322, "indent": 0, "params": {"Text": "（无论重来多少次，我都会杀死艾玛）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Bad02_Hiro033"]}},
    {"op": "ResetText", "line": 324, "indent": 0, "params": {}},
