    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "在先行投票中，<br>\n希罗小姐和艾玛小姐受到的怀疑票数相同……<br>\n事情到底会怎么发展呢。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv18_Warden002"]}},
