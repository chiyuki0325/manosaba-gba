  "translations": {
  "0202Adv18_Narrative001": "夜幕降临，钟声宣告魔女审判即将开始。",
  "0202Adv18_Hiro001": "（到时间了——）",
  "0202Adv18_Narrative002": "在看守的押送下，<br>\n我和艾玛被带到审判庭。",
  "0202Adv18_Narrative003": "其他少女都已经各就各位，<br>\n站在各自的证人席上。",
  "0202Adv18_Warden001": "那么，所有人都到齐了吧。",
  "0202Adv18_Narrative004": "看到艾玛和我都就位以后，<br>\n典狱长开口发言。",
  "0202Adv18_Warden002": "在先行投票中，<br>\n希罗小姐和艾玛小姐受到的怀疑票数相同……<br>\n事情到底会怎么发展呢。",
  "0202Adv18_Hiro002": "…………",
  "0202Adv18_Ema001": "…………",
  "0202Adv18_Narrative005": "我们的眼里只剩下对彼此的怀疑，<br>\n再容不下其他任何人。",
  "0202Adv18_Hiro003": "（终于到揭露你本性的时候了。<br>\n　做好准备吧）",
  "0202Adv18_Hiro004": "（艾玛——我定要将你这魔女送上处刑台！）",
  "0202Adv18_Warden003": "那么，魔女审判现在开庭！"
}
