    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "在看守的押送下，<br>\n我和艾玛被带到审判庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv18_Narrative002"]}},
