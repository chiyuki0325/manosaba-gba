    {"op": "PrintTextModified", "line": 53, "indent": 0, "params": {"Text": "是刚才希罗离开审判庭的时候掉的东西。<br>", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah003"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "本来想去送给她的，可是诺亚忘记了。<br>\n得赶紧给她才行。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah004"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "『有必要那么着急吗？』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn004"]}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "诺亚露出了些许落寞的微笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Narrative003"]}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Pensive1"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "不行，要赶快还给她。<br>\n毕竟，谁也不知道<br>\n什么时候就会死掉。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Surprised1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn005"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Cry1"}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "诺亚的眼里渗出泪花。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Narrative004"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "可可也死掉了。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah006"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "她夸了诺亚的画好多次呢，<br>\n还很高兴地过来看诺亚的画……<br>\n甚至用在自己的直播里……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah007"]}},
    {"op": "PrintTextModified", "line": 81, "indent": 0, "params": {"Text": "可是她却走了，好难过啊。<br>\n我说，大家最后都会死掉吗……<br>\n诺亚不要那样……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah008"]}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Surprised1"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn006"]}},
    {"op": "ModifyCharacterExtended", "line": 87, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "见诺亚抽泣的样子，<br>\n安安为难地来回踱步。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 91, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1,Arms2,Angle01/Option_Arms>Option_Arms01_03,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 93, "indent": 0, "params": {"Text": "『冷静点。<br>\n　吾辈相信，不可能所有人都死掉的』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn007"]}},
    {"op": "ModifyCharacterExtended", "line": 95, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Cry1"}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "嗯……可是。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah009"]}},
    {"op": "PrintTextModified", "line": 99, "indent": 0, "params": {"Text": "安安看诺亚还是哭个不停，<br>\n便拿出一张画。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 101, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Cry1"}},
    {"op": "ModifyCharacterExtended", "line": 102, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 104, "indent": 0, "params": {"Text": "……这张画，怎么了？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah010"]}},
    {"op": "ModifyCharacterExtended", "line": 106, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile1,Arms2,Angle01/Option_Arms>Option_Arms01_03,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "『是吾辈在焚烧炉里捡到的』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn008"]}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "『只有这张画和其他的不一样，看起来格外耀眼』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn009"]}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "『这张画，是你画的吗？』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn010"]}},
    {"op": "ModifyCharacterExtended", "line": 114, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "……嗯。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah011"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "……为什么。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn011"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1,Arms2,Angle01/Option_Arms>Option_Arms01_01,Angle01/Option_ArmR/Option_ArmR01_01-"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "『为什么要扔掉？』", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn012"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Flushed1"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "……因为画得很差嘛。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah012"]}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1,ArmR1,ArmL1,ArmR1-Option-All,Angle01/Option_Arms-,ArmR1-Option-All"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "诺亚难为情地挠了挠脸颊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 132, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Pensive1"}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "一点都、不差……！", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn013"]}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "……吾辈，喜欢这幅画。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn014"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Surprised1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "真的？", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah013"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "……谢谢你，安安！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah014"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "AnAn.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 149, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 151, "indent": 0, "params": {"Text": "诺亚紧紧抱住安安。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Narrative008"]}},
    {"op": "PrintTextModified", "line": 153, "indent": 0, "params": {"Text": "诺亚这才好不容易止住了哭泣。<br>\n安安便放心地微微一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 155, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "AnAn.Smile1"}},
    {"op": "PrintTextModified", "line": 157, "indent": 0, "params": {"Text": "……你还是笑起来更好看。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn015"]}},
    {"op": "PrintTextModified", "line": 159, "indent": 0, "params": {"Text": "和吾辈一起，体验更多快乐的事吧。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn016"]}},
    {"op": "PrintTextModified", "line": 161, "indent": 0, "params": {"Text": "吾辈会带给诺亚很多很多笑容的。", "AuthorId": "AnAn", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_AnAn017"]}},
    {"op": "ModifyCharacterExtended", "line": 163, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 165, "indent": 0, "params": {"Text": "嗯！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah015"]}},
    {"op": "Gosub", "line": 167, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
