    {"op": "PrintTextModified", "line": 38, "indent": 0, "params": {"Text": "对不起哦。<br>\n但诺亚想起了一件很重要的事。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv20_Noah002"]}},
