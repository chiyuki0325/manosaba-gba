    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "诺亚无精打采地鼓起脸颊。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv13_Narrative008"]}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "不是因为小气。<br>\n我们不是一起找到了画画的地方吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv13_Hiro007"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "唔～话是这么说啦……", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv13_Noah006"]}},
