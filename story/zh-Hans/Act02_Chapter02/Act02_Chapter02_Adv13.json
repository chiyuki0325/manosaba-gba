    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "（虽然我也想让她随心所欲地画，<br>\n　可是现在不能这么说）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv13_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 119, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
