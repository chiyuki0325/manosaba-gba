    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "她欲言又止，最后闭上了嘴。<br>\n可能还是对我有点顾忌吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv13_Narrative009"]}},
