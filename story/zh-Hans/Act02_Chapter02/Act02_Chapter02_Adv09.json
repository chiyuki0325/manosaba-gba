  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-2-9", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "17_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_28_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我在森林简单探索了一番，直到来到湖畔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative001"]}},
    {"op": "ModifyCharacterExtended", "line": 22, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "（把她沉到湖底也是可行的吧。<br>\n　……能毁尸灭迹就最好不过了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro001"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "我眺望着湖面，思索如何杀死艾玛。<br>\n就在这时——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative002"]}},
    {"op": "PlaySfxModified", "line": 29, "indent": 0, "params": {"SfxPath": "Sfx_55", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 30, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 32, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Surprised1"}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro002"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "附近的树丛沙沙作响，我立马警惕地绷紧身子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 38, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 39, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Duration": 0.30000001192092896, "Lazy": 0, "ScenePosition": [70.0, 20.0], "IdAndAppearance": "Nanoka"}},
    {"op": "Wait", "line": 41, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Duration": 0.5, "Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Nanoka"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "下一秒，<br>\n从树丛里探出身子的是——奈叶香。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 46, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "又是你啊。<br>\n难道说你的爱好就是从树丛里冒出来？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro003"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "我可没有那种癖好。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 52, "indent": 0, "params": {"Text": "那么，你是又想触碰我了吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro004"]}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "奈叶香的魔法是【幻视】。<br>\n据说碰到谁就能看见对方过去的画面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative005"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "……不。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "奈叶香缓缓摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative006"]}},
    {"op": "PrintTextModified", "line": 60, "indent": 0, "params": {"Text": "只是碰巧遇见你罢了。<br>\n我刚才在找东西，然后……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 62, "indent": 0, "params": {"Text": "哦，我记得你说过<br>\n自己的发带不见了。找到了吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro005"]}},
    {"op": "PrintTextModified", "line": 64, "indent": 0, "params": {"Text": "她上来就说是亚里沙偷的，<br>\n结果两人差点打起来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative007"]}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "奈叶香沮丧地摇了摇头。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 68, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Pensive1"}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "……没有。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "这发带有那么重要吗？<br>\n被关进来以后，我们自己的所有东西<br>\n应该全都被拿走了吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro006"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "话刚落音，<br>\n我忽然想起自己口袋里的钢笔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 76, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Pensive1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "（难道奈叶香<br>\n　也和我一样，带着【某种物件】……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro007"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "发带我在监牢里找回来了。<br>\n……因为我知道它掉在哪里了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka005"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "原来如此。和你手上那把枪的来路一样，<br>\n这也是你通过幻视得知的信息吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro008"]}},
    {"op": "HideAllCharacters", "line": 84, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 85, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCamera", "line": 86, "indent": 0, "params": {"Offset": [-4.0, -2.0], "Zoom": 0.4000000059604645, "Lazy": 0}},
    {"op": "Wait", "line": 87, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 89, "indent": 0, "params": {"Text": "她点了点头，<br>\n于是我开始翻找近处的树丛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative010"]}},
    {"op": "PlaySfxModified", "line": 92, "indent": 0, "params": {"SfxPath": "Sfx_55", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 93, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 95, "indent": 0, "params": {"Text": "你，这是在……？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka006"]}},
    {"op": "PrintTextModified", "line": 97, "indent": 0, "params": {"Text": "你不是在找东西吗？<br>\n那我得帮你找到。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro009"]}},
    {"op": "PlaySfxModified", "line": 100, "indent": 0, "params": {"SfxPath": "Sfx_55", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 101, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 103, "indent": 0, "params": {"Text": "……你不问原因吗？", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka007"]}},
    {"op": "PrintTextModified", "line": 105, "indent": 0, "params": {"Text": "你不想说的话，我也不会多过问。<br>\n毕竟我也有不愿提起的过去。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro010"]}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "……哦。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka008"]}},
    {"op": "ResetText", "line": 113, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 114, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 115, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 116, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "HideAllCharacters", "line": 117, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyCamera", "line": 118, "indent": 0, "params": {"Offset": [0.0, 0.0], "Zoom": 0.0, "Lazy": 0}},
    {"op": "Wait", "line": 119, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyBackgroundExtended", "line": 120, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 121, "indent": 0, "params": {"WaitMode": "1.2"}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "我们在周围<br>\n四处找了一会……", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative011"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "但最后还是没找到发带。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative012"]}},
    {"op": "ModifyCharacterExtended", "line": 127, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Nanoka"}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "我本来想着，<br>\n可能在调查这附近的时候落在这里了……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka009"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "但我也不知道究竟是在哪里弄丢的，<br>\n算了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka010"]}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed,ArmR2"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "……是吗。<br>\n那以后我会多留意<br>\n监牢里有没有类似东西的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro011"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "……谢谢。<br>\n二阶堂希罗，其实你人挺好的。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka011"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1,ArmR1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "什么叫做“其实”啊。<br>\n我不是一向都行得正坐得直吗？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro012"]}},
    {"op": "PrintTextModified", "line": 144, "indent": 0, "params": {"Text": "虽然我并不是在开玩笑，<br>\n但奈叶香却轻轻地笑了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 146, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Nanoka.Smile1"}},
    {"op": "PrintTextModified", "line": 148, "indent": 0, "params": {"Text": "看你总是一脸冷峻地想事情，<br>\n总感觉你是不是有些不好的企图。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka012"]}},
    {"op": "ModifyCharacterExtended", "line": 150, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "（这倒是没说错……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro013"]}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "自从来到这里，我的烦恼越来越多。<br>\n每天都烦躁得不行。哪怕能摄取点糖分也好。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro014"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "糖分……嗯。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka013"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "……我啊，其实很喜欢做点心。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka014"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "她这冷不丁的回答，让我不知该作何反应。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 162, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Nanoka.Smile1,ArmL9"}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "不介意的话，下次我做给你吃吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka015"]}},
    {"op": "ModifyCharacterExtended", "line": 166, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "这做不到吧。<br>\n连食材都没有，要怎么做？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro015"]}},
    {"op": "PrintTextModified", "line": 170, "indent": 0, "params": {"Text": "食材的话，我能筹措得到。<br>\n我知道不少秘密通路，就交给我吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka016"]}},
    {"op": "PrintTextModified", "line": 172, "indent": 0, "params": {"Text": "奈叶香微微一笑。<br>\n看来她还挺信任我的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 174, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "（明明我想要疏远大家，<br>\n　可是事不如意啊……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro016"]}},
    {"op": "PrintTextModified", "line": 178, "indent": 0, "params": {"Text": "秘密小道吗……<br>\n比起点心，我倒是更关心这个。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0, 50.0], "IdAndAppearance": "Nanoka.Smile1,ArmL1"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "那可不是什么值得期待的地方。<br>\n而且，去那里还会违反规定……啊。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka017"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "奈叶香突然停住话头，盯着我的头顶看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative016"]}},
    {"op": "ModifyCharacterExtended", "line": 186, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Default"}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "怎么了？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro018"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "你的头顶。<br>\n有片叶子沾在头发上了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka018"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "是吗，因为刚才在树丛里到处找东西吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 194, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [55.0], "IdAndAppearance": "Nanoka.Normal1,ArmR2,ArmL4"}},
    {"op": "Wait", "line": 195, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 196, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [60.0], "IdAndAppearance": "Nanoka"}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "她正准备伸手，<br>\n却突然像转变心意似的停了下来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 200, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "……不继续吗？<br>\n刚才可是触碰我的好时机。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro020"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "（虽然我并不打算让她有机会触碰我）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro021"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "现在的我，一直在考虑如何杀害艾玛，<br>\n那就决不能让她【幻视】到。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative018"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "我自己捏住叶子，用手指轻轻弹开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative019"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Nanoka.Normal1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "……我改主意了。<br>\n不会再幻视你。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka019"]}},
    {"op": "PrintTextModified", "line": 214, "indent": 0, "params": {"Text": "二阶堂希罗。<br>\n如果是你，也许……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka020"]}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "奈叶香欲言又止。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative020"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "然而，最终她还是把话吞了下去，没有再往下说。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative021"]}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "……我该走了。<br>\n典狱长马上就要来了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Nanoka021"]}},
    {"op": "HideAllCharacters", "line": 222, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 225, "indent": 0, "params": {"SfxPath": "Sfx_55", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 227, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 229, "indent": 0, "params": {"Text": "话音刚落，<br>\n她就消失在了树丛深处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative022"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "紧接着——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative023"]}},
    {"op": "PlaySfxModified", "line": 234, "indent": 0, "params": {"SfxPath": "Sfx_8", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 236, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 238, "indent": 0, "params": {"Text": "正如奈叶香所言，典狱长确实来了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative024"]}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "是你啊，希罗小姐。<br>\n你有在这附近看到奈叶香小姐吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Warden001"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "不，我没看见。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro022"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "这样啊。哎呀呀，这可头疼了。<br>\n奈叶香小姐违反了规定，<br>\n已逃出监牢好几天了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Warden002"]}},
    {"op": "PrintTextModified", "line": 246, "indent": 0, "params": {"Text": "我一直找不到她……好不容易追过去，<br>\n她又一眨眼就消失了。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Warden003"]}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "如果你看到她，可以告诉我一声吗？", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Warden004"]}},
    {"op": "PrintTextModified", "line": 250, "indent": 0, "params": {"Text": "你尽管找就是。<br>\n这事和我无关吧。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Hiro023"]}},
    {"op": "HideAllCharacters", "line": 252, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 254, "indent": 0, "params": {"Text": "没有必要告诉典狱长。<br>\n我丢下这句话就离开了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv09_Narrative025"]}},
    {"op": "Gosub", "line": 261, "indent": 0, "params": {"Path": "System/System_Subroutine.EndAdv"}},
    {"op": "GotoModified", "line": 263, "indent": 0, "params": {"Path": "Act02_Chapter02/Act02_Chapter02_Adv04", "SoftReset": 1}}
  ],
  "translations": {
  "0202Adv09_Narrative001": "我在森林简单探索了一番，直到来到湖畔。",
  "0202Adv09_Hiro001": "（把她沉到湖底也是可行的吧。<br>\n　……能毁尸灭迹就最好不过了）",
  "0202Adv09_Narrative002": "我眺望着湖面，思索如何杀死艾玛。<br>\n就在这时——",
  "0202Adv09_Hiro002": "！",
  "0202Adv09_Narrative003": "附近的树丛沙沙作响，我立马警惕地绷紧身子。",
  "0202Adv09_Narrative004": "下一秒，<br>\n从树丛里探出身子的是——奈叶香。",
  "0202Adv09_Hiro003": "又是你啊。<br>\n难道说你的爱好就是从树丛里冒出来？",
  "0202Adv09_Nanoka001": "我可没有那种癖好。",
  "0202Adv09_Hiro004": "那么，你是又想触碰我了吗？",
  "0202Adv09_Narrative005": "奈叶香的魔法是【幻视】。<br>\n据说碰到谁就能看见对方过去的画面。",
  "0202Adv09_Nanoka002": "……不。",
  "0202Adv09_Narrative006": "奈叶香缓缓摇头。",
  "0202Adv09_Nanoka003": "只是碰巧遇见你罢了。<br>\n我刚才在找东西，然后……",
  "0202Adv09_Hiro005": "哦，我记得你说过<br>\n自己的发带不见了。找到了吗？",
  "0202Adv09_Narrative007": "她上来就说是亚里沙偷的，<br>\n结果两人差点打起来。",
  "0202Adv09_Narrative008": "奈叶香沮丧地摇了摇头。",
  "0202Adv09_Nanoka004": "……没有。",
  "0202Adv09_Hiro006": "这发带有那么重要吗？<br>\n被关进来以后，我们自己的所有东西<br>\n应该全都被拿走了吧。",
  "0202Adv09_Narrative009": "话刚落音，<br>\n我忽然想起自己口袋里的钢笔。",
  "0202Adv09_Hiro007": "（难道奈叶香<br>\n　也和我一样，带着【某种物件】……？）",
  "0202Adv09_Nanoka005": "发带我在监牢里找回来了。<br>\n……因为我知道它掉在哪里了。",
  "0202Adv09_Hiro008": "原来如此。和你手上那把枪的来路一样，<br>\n这也是你通过幻视得知的信息吧。",
  "0202Adv09_Narrative010": "她点了点头，<br>\n于是我开始翻找近处的树丛。",
  "0202Adv09_Nanoka006": "你，这是在……？",
  "0202Adv09_Hiro009": "你不是在找东西吗？<br>\n那我得帮你找到。",
  "0202Adv09_Nanoka007": "……你不问原因吗？",
  "0202Adv09_Hiro010": "你不想说的话，我也不会多过问。<br>\n毕竟我也有不愿提起的过去。",
  "0202Adv09_Nanoka008": "……哦。",
  "0202Adv09_Narrative011": "我们在周围<br>\n四处找了一会……",
  "0202Adv09_Narrative012": "但最后还是没找到发带。",
  "0202Adv09_Nanoka009": "我本来想着，<br>\n可能在调查这附近的时候落在这里了……",
  "0202Adv09_Nanoka010": "但我也不知道究竟是在哪里弄丢的，<br>\n算了。",
  "0202Adv09_Hiro011": "……是吗。<br>\n那以后我会多留意<br>\n监牢里有没有类似东西的。",
  "0202Adv09_Nanoka011": "……谢谢。<br>\n二阶堂希罗，其实你人挺好的。",
  "0202Adv09_Hiro012": "什么叫做“其实”啊。<br>\n我不是一向都行得正坐得直吗？",
  "0202Adv09_Narrative013": "虽然我并不是在开玩笑，<br>\n但奈叶香却轻轻地笑了。",
  "0202Adv09_Nanoka012": "看你总是一脸冷峻地想事情，<br>\n总感觉你是不是有些不好的企图。",
  "0202Adv09_Hiro013": "（这倒是没说错……）",
  "0202Adv09_Hiro014": "自从来到这里，我的烦恼越来越多。<br>\n每天都烦躁得不行。哪怕能摄取点糖分也好。",
  "0202Adv09_Nanoka013": "糖分……嗯。",
  "0202Adv09_Nanoka014": "……我啊，其实很喜欢做点心。",
  "0202Adv09_Narrative014": "她这冷不丁的回答，让我不知该作何反应。",
  "0202Adv09_Nanoka015": "不介意的话，下次我做给你吃吧。",
  "0202Adv09_Hiro015": "这做不到吧。<br>\n连食材都没有，要怎么做？",
  "0202Adv09_Nanoka016": "食材的话，我能筹措得到。<br>\n我知道不少秘密通路，就交给我吧。",
  "0202Adv09_Narrative015": "奈叶香微微一笑。<br>\n看来她还挺信任我的。",
  "0202Adv09_Hiro016": "（明明我想要疏远大家，<br>\n　可是事不如意啊……）",
  "0202Adv09_Hiro017": "秘密小道吗……<br>\n比起点心，我倒是更关心这个。",
  "0202Adv09_Nanoka017": "那可不是什么值得期待的地方。<br>\n而且，去那里还会违反规定……啊。",
  "0202Adv09_Narrative016": "奈叶香突然停住话头，盯着我的头顶看。",
  "0202Adv09_Hiro018": "怎么了？",
  "0202Adv09_Nanoka018": "你的头顶。<br>\n有片叶子沾在头发上了。",
  "0202Adv09_Hiro019": "是吗，因为刚才在树丛里到处找东西吧。",
  "0202Adv09_Narrative017": "她正准备伸手，<br>\n却突然像转变心意似的停了下来。",
  "0202Adv09_Hiro020": "……不继续吗？<br>\n刚才可是触碰我的好时机。",
  "0202Adv09_Hiro021": "（虽然我并不打算让她有机会触碰我）",
  "0202Adv09_Narrative018": "现在的我，一直在考虑如何杀害艾玛，<br>\n那就决不能让她【幻视】到。",
  "0202Adv09_Narrative019": "我自己捏住叶子，用手指轻轻弹开了。",
  "0202Adv09_Nanoka019": "……我改主意了。<br>\n不会再幻视你。",
  "0202Adv09_Nanoka020": "二阶堂希罗。<br>\n如果是你，也许……",
  "0202Adv09_Narrative020": "奈叶香欲言又止。",
  "0202Adv09_Narrative021": "然而，最终她还是把话吞了下去，没有再往下说。",
  "0202Adv09_Nanoka021": "……我该走了。<br>\n典狱长马上就要来了。",
  "0202Adv09_Narrative022": "话音刚落，<br>\n她就消失在了树丛深处。",
  "0202Adv09_Narrative023": "紧接着——",
  "0202Adv09_Narrative024": "正如奈叶香所言，典狱长确实来了。",
  "0202Adv09_Warden001": "是你啊，希罗小姐。<br>\n你有在这附近看到奈叶香小姐吗？",
  "0202Adv09_Hiro022": "不，我没看见。",
  "0202Adv09_Warden002": "这样啊。哎呀呀，这可头疼了。<br>\n奈叶香小姐违反了规定，<br>\n已逃出监牢好几天了。",
  "0202Adv09_Warden003": "我一直找不到她……好不容易追过去，<br>\n她又一眨眼就消失了。",
  "0202Adv09_Warden004": "如果你看到她，可以告诉我一声吗？",
  "0202Adv09_Hiro023": "你尽管找就是。<br>\n这事和我无关吧。",
  "0202Adv09_Narrative025": "没有必要告诉典狱长。<br>\n我丢下这句话就离开了。"
}
}
