    {"op": "ModifyCharacterExtended", "line": 392, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL6,Eyes2_Angry_Open2,Mouth2_Determined_Open1"}},
