    {"op": "PrintTextModified", "line": 386, "indent": 0, "params": {"Text": "那么……<br>\n站在我的角度，我只能说<br>\n你是凶手的可能性也很高。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Ema005"]}},
