    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "（……看样子亚里沙在怀疑奈叶香）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro001"]}},
