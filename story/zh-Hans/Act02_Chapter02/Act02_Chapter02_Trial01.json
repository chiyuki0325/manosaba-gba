    {"op": "ModifyCharacterExtended", "line": 218, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL4,Eyes2_Normal_Open3,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 219, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 220, "indent": 0, "params": {"Text": "不，谜题还未完全解开。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 222, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL4,Eyes2_Normal_Open3,Mouth2_Determined_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 223, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 224, "indent": 0, "params": {"Text": "现阶段还有许多事情<br>\n未经验证。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro010"]}},
    {"op": "ModifyCharacterExtended", "line": 226, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR6,ArmL3,Eyes1_Angry_Open1,Mouth1_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 227, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 228, "indent": 0, "params": {"Text": "比如可可的死亡地点……还有她的直播等等，<br>\n现在就得出结论未免太早吧？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 230, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 231, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 232, "indent": 0, "params": {"Text": "那些小事都无所谓！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa009"]}},
    {"op": "ModifyCharacterExtended", "line": 234, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 235, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "最要紧的是赶紧搞完这破烂审判……！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa010"]}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hanna.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Surprised_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 239, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hanna", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "那、那倒也是……", "AuthorId": "Hanna", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hanna001"]}},
    {"op": "ModifyCharacterExtended", "line": 242, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 243, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "想扮侦探的话，待会随你怎么扮。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa011"]}},
    {"op": "ModifyCharacterExtended", "line": 246, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR15,ArmL4,Angle01/Facial/Eyes>Eyes_Wink_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 247, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 248, "indent": 0, "params": {"Text": "好！那我就照做啦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Sherry003"]}},
    {"op": "ModifyCharacterExtended", "line": 250, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR4,ArmL6,Angle01/Facial/Eyes>Eyes_Angry_Open03"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 251, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 252, "indent": 0, "params": {"Text": "我在跟二阶堂说！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa012"]}},
    {"op": "Damage", "line": 254, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 256, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 257, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 258, "indent": 0, "params": {"Text": "（得根据更加直接的证据进行推理<br>\n　才能讨论下去……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro012"]}},
    {"op": "ModifyCharacterExtended", "line": 260, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 261, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 262, "indent": 0, "params": {"Text": "（……但凶器不一定是奈叶香的枪）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 264, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Determined_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 265, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 266, "indent": 0, "params": {"Text": "（回想一下案发现场的情况吧。<br>\n　应该还有其他能当凶器的东西才对）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro014"]}},
    {"op": "GotoModified", "line": 269, "indent": 0, "params": {"Path": ".Judge7-1-1"}},
