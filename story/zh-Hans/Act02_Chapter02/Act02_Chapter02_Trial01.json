    {"op": "ModifyCharacterExtended", "line": 286, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 287, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 288, "indent": 0, "params": {"Text": "……看来，<br>\n亚里沙你不知道啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 290, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Angry1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 291, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 292, "indent": 0, "params": {"Text": "……啊？<br>\n不知道什么？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa013"]}},
    {"op": "PlayBgm", "line": 294, "indent": 0, "params": {"BgmPath": "Bgm_45_2", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 296, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR6,ArmL3,Eyes1_Angry_Open1,Mouth1_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 297, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 298, "indent": 0, "params": {"Text": "那当然就是，【另一把枪】。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 300, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Surprised1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 301, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 302, "indent": 0, "params": {"Text": "还有另一把枪……？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa014"]}},
    {"op": "ModifyCharacterExtended", "line": 304, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 305, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 306, "indent": 0, "params": {"Text": "没错。<br>\n有把枪留在了现场。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 308, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL4,Eyes2_Normal_Open3,Mouth2_Smile_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 309, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 310, "indent": 0, "params": {"Text": "难道说……<br>\n发现人故意瞒着没告诉你们？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro018"]}},
    {"op": "ModifyCharacterExtended", "line": 312, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 313, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 314, "indent": 0, "params": {"Text": "——我没有。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 316, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Lifeless04,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Middle"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 317, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 318, "indent": 0, "params": {"Text": "我只是在案发现场捡到了一把手枪……<br>\n仅此而已。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Ema002"]}},
    {"op": "PlaySfxModified", "line": 320, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 322, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Surprised1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 323, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 324, "indent": 0, "params": {"Text": "……居然是手枪？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa015"]}},
    {"op": "ModifyCharacterExtended", "line": 326, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 327, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 328, "indent": 0, "params": {"Text": "那就是说，除了黑部的枪以外还有别的枪吗……！", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa016"]}},
    {"op": "ModifyCharacterExtended", "line": 330, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Open1,Mouth1_Determined_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 331, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 332, "indent": 0, "params": {"Text": "正是如此。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 334, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Open3,Mouth1_Determined_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 335, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 336, "indent": 0, "params": {"Text": "换句话说，虽然死因是枪杀，<br>\n但凶器不一定是奈叶香的枪。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro020"]}},
    {"op": "PlaySfxModified", "line": 338, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 340, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 341, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 342, "indent": 0, "params": {"Text": "……啧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa017"]}},
    {"op": "ModifyCharacterExtended", "line": 344, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 345, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 346, "indent": 0, "params": {"Text": "……行吧。是我搞错了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa018"]}},
    {"op": "ModifyCharacterExtended", "line": 348, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 349, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 350, "indent": 0, "params": {"Text": "就是说，这次还是逃不过啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa019"]}},
    {"op": "ModifyCharacterExtended", "line": 352, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 353, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 354, "indent": 0, "params": {"Text": "……又要开始这狗屁讨论了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa020"]}},
    {"op": "ModifyCharacterExtended", "line": 356, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 357, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 358, "indent": 0, "params": {"Text": "是啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 360, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Angry_Open2,Mouth1_Determined_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 361, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 362, "indent": 0, "params": {"Text": "不过你们大可以放心。<br>\n因为我已经知道这次的凶手是谁了。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro022"]}},
    {"op": "PlaySfxModified", "line": 364, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 366, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Default,ArmR12,ArmL16,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 367, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 368, "indent": 0, "params": {"Text": "……！", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 370, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 371, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 372, "indent": 0, "params": {"Text": "凶手就是现场拿着手枪的……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro023"]}},
    {"op": "ModifyCharacterExtended", "line": 374, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR6,ArmL3,Eyes2_Angry_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 375, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 376, "indent": 0, "params": {"Text": "艾玛。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro024"]}},
    {"op": "PlaySfxModified", "line": 378, "indent": 0, "params": {"SfxPath": "Sfx_Common_1", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 380, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Determined2,ArmR7,ArmL10,Angle01/Head02/Facial02/Mouth02>Mouth02_Angry_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 381, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Ema", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 382, "indent": 0, "params": {"Text": "……是吗，希罗。<br>\n这就是你的观点啊。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Ema004"]}},
    {"op": "ModifyCharacterExtended", "line": 384, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Determined2,ArmR3,ArmL10,Angle01/Head02/Facial02/Mouth02>Mouth02_Nervous_Open"}},
