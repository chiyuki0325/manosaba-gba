    {"op": "PrintTextModified", "line": 83, "indent": 0, "params": {"Text": "（试着指出其中的错误信息，<br>\n　反驳她先入为主的观点吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro003"]}},
