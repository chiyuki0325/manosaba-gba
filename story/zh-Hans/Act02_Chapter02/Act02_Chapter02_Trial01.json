    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（人一旦陷入思维定式，<br>\n　就会被禁锢在现有的思路里……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro002"]}},
