    {"op": "ModifyCharacterExtended", "line": 167, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 168, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 169, "indent": 0, "params": {"Text": "不，凶手不太可能是奈叶香。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro004"]}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 172, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "推定死亡时间和发现尸体的时间离得很近，<br>\n更应当怀疑尸体边上的人才对。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Serious_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 176, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "可是，就算不在现场她也能下手吧？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa005"]}},
    {"op": "ModifyCharacterExtended", "line": 179, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Serious_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 180, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "肯定有办法从远处射击的。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa006"]}},
    {"op": "ModifyCharacterExtended", "line": 183, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR13,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 184, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "对啊！比如说狙击！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Sherry002"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 188, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 189, "indent": 0, "params": {"Text": "这种绝招<br>\n只有天天扛着把大枪的黑部才能干得了吧。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa007"]}},
    {"op": "ModifyCharacterExtended", "line": 191, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL7,Angle01/Facial/Eyes>Eyes_Angry_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 192, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left"}},
    {"op": "PrintTextModified", "line": 193, "indent": 0, "params": {"Text": "你可别胡说八道敷衍人啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Alisa008"]}},
    {"op": "Damage", "line": 195, "indent": 0, "params": {}},
    {"op": "ModifyCharacterExtended", "line": 197, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 198, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 199, "indent": 0, "params": {"Text": "（得根据更加直接的证据进行推理<br>\n　才能讨论下去……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 201, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 202, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 203, "indent": 0, "params": {"Text": "（……但凶器不一定是奈叶香的枪）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Determined_Closed1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 206, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Hiro", "Composition": "Center"}},
    {"op": "PrintTextModified", "line": 207, "indent": 0, "params": {"Text": "（回想一下案发现场的情况吧。<br>\n　应该还有其他能当凶器的东西才对）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial01_Hiro008"]}},
