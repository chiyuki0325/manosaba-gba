    {"op": "PrintDebateText", "line": 31, "indent": 0, "params": {"Text": "凶手是黑部吧。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0202Trial01_Alisa001"]}},
    {"op": "ModifyCharacterExtended", "line": 33, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Angry_Open02"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 34, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 35, "indent": 0, "params": {"Text": "泽渡的头顶<br>\n都被枪给炸穿了。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0202Trial01_Alisa002"]}},
    {"op": "ModifyCharacterExtended", "line": 37, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open04"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 38, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 39, "indent": 0, "params": {"Text": "那，凶手就是<br>\n<link=\"Objection_02_02_01_01\">拿着枪的黑部了</link>。<br>\n没别的可能。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0202Trial01_Alisa003"]}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open01"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 42, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Alisa", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 43, "indent": 0, "params": {"Text": "你有什么要反驳的吗。", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0202Trial01_Alisa004"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR4,ArmL2,Eyes1_Uncomfortable_Open1,Mouth1_Angry_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 48, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 49, "indent": 0, "params": {"Text": "……没有。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0202Trial01_Nanoka001"]}},
    {"op": "ModifyCharacterExtended", "line": 51, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Nanoka.ArmR4,ArmL2,Eyes1_Uncomfortable_Open1,Mouth1_Surprised_Open1"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 52, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Nanoka", "Composition": "Right", "RollDirection": "Left", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 53, "indent": 0, "params": {"Text": "手里有枪的<br>\n的确<link=\"Objection_02_02_01_02\">只有我</link>一个。<br>\n这点我无法否定。", "RevealSpeed": 1.0, "ScenePosition": [30.0, 50.0], "Roll": -4.0}, "text_ids": {"Text": ["0202Trial01_Nanoka002"]}},
    {"op": "ModifyCharacterExtended", "line": 55, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Default,ArmR15,ArmL4,Angle01/Facial/Eyes>Eyes_Wink_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 56, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Sherry", "Composition": "Left", "RollDirection": "Right", "ZoomLevel": 3}},
    {"op": "PrintDebateText", "line": 57, "indent": 0, "params": {"Text": "<link=\"Objection_02_02_01_03\">谜题全都</link><br>\n解开了呢！<br>\n真不愧是亚里沙！", "RevealSpeed": 1.0, "ScenePosition": [70.0, 50.0], "Roll": 4.0}, "text_ids": {"Text": ["0202Trial01_Sherry001"]}},
