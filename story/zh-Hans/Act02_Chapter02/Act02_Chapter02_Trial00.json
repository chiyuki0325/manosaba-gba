    {"op": "Wait", "line": 110, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "……嗯，看来你<br>\n根本听不进别人的话。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia005"]}},
    {"op": "ModifyCharacterExtended", "line": 113, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Angry1"}},
