    {"op": "PrintTextModified", "line": 137, "indent": 0, "params": {"Text": "——这点没错吧？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia011"]}},
