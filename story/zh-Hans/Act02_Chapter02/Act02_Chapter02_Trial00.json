    {"op": "PrintTextModified", "line": 120, "indent": 0, "params": {"Text": "死者是泽渡可可。<br>\n尸体是在下雨时的中庭被发现的……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia007"]}},
