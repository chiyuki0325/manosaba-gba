    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "（第二次魔女审判……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Hiro001"]}},
    {"op": "PrintTextModified", "line": 35, "indent": 0, "params": {"Text": "（嫌疑人是我和艾玛两人）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Hiro002"]}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "（既然我不是凶手，<br>\n　那我就必须得举证艾玛的罪行，送她上处刑台）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Hiro003"]}},
    {"op": "PrintTextModified", "line": 39, "indent": 0, "params": {"Text": "（然而……我的手上目前还没有证据）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Hiro004"]}},
    {"op": "PrintTextModified", "line": 41, "indent": 0, "params": {"Text": "（看来得积极参与讨论，以套取情报了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Hiro005"]}},
