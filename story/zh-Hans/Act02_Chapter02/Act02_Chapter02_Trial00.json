    {"op": "Wait", "line": 65, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "……但你看上去<br>\n没你嘴上说得那么难过啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Alisa001"]}},
    {"op": "HidePerspectiveStageScreen", "line": 69, "indent": 0, "params": {"Index": 1, "Reset": 1}},
    {"op": "ModifyCharacterExtended", "line": 72, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR4,ArmL6,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "怎么会不难过。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia003"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "我们的伙伴被杀了，<br>\n我自然很心痛。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia004"]}},
    {"op": "ShowPerspectiveStageScreen", "line": 77, "indent": 0, "params": {"Index": 1}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "……谁知道呢。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Alisa002"]}},
    {"op": "PlaySfxModified", "line": 81, "indent": 0, "params": {"SfxPath": "Sfx_Common_2", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 83, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Sherry.Normal1"}},
