    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Default,ArmR5,ArmL7,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01"}},
