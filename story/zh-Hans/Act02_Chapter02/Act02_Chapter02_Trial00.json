    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "——新的被害人！<br>\n新的谜题！<br>\n新的嫌疑犯！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Sherry002"]}},
