    {"op": "GosubToModifyPerspectiveStageCamera", "line": 123, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 124, "indent": 0, "params": {"Text": "死因是枪杀。<br>\n额头中弹身亡。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia008"]}},
    {"op": "ModifyCharacterExtended", "line": 126, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Angry1,ArmR6,ArmL5"}},
    {"op": "GosubToModifyPerspectiveStageCamera", "line": 127, "indent": 0, "params": {"Index": 0, "LookCharacterId": "Leia", "Composition": "Right"}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "毫无疑问，当场死亡。<br>\n发现尸体时，应该离死亡时刻<br>\n没过多久。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia009"]}},
