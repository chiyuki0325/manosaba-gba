    {"op": "HidePerspectiveStageScreen", "line": 85, "indent": 0, "params": {"Index": 1, "Reset": 1}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "嗯嗯！蕾雅的心情<br>\n我可太懂啦！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Sherry001"]}},
