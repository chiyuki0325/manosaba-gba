    {"op": "PrintTextModified", "line": 101, "indent": 0, "params": {"Text": "真是激动人心啊！<br>\n我好爱悬疑！", "AuthorId": "Sherry", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Sherry003"]}},
