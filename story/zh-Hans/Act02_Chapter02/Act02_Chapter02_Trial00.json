    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "尸体的第一目击者是艾玛——", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia010"]}},
