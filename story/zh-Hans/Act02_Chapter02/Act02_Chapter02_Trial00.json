    {"op": "Wait", "line": 53, "indent": 0, "params": {"WaitMode": "0.2"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "唉。<br>\n居然又召开这种审判大会，真叫人遗憾啊……", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia001"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "没想到又发生了凶杀案。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial00_Leia002"]}},
