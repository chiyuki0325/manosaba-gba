    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "我用颤抖的声音抱怨道，咬紧嘴唇。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv21_Narrative009"]}},
