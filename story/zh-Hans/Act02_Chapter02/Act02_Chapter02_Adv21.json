    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "打算看看奈叶香被处刑前发给我的消息。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv21_Narrative003"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "我打开她发来的消息。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv21_Narrative004"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "里面好像还附带了一份录像。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv21_Narrative005"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "（奈叶香……你究竟想告诉我什么？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv21_Hiro002"]}},
