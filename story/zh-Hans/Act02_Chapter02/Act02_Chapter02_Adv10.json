    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "27_1"}},
    {"op": "ModifyBackgroundExtended", "line": 14, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 15, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 17, "indent": 0, "params": {"BgmPath": "Bgm_21_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 19, "indent": 0, "params": {"Text": "大致探索一番后，<br>\n我来到地下的焚烧炉室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative001"]}},
    {"op": "PrintTextModified", "line": 21, "indent": 0, "params": {"Text": "（我想到杀死艾玛的方法了）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro001"]}},
    {"op": "PrintTextModified", "line": 23, "indent": 0, "params": {"Text": "（只要尸体上不留下证据，<br>\n　应该就不会被判定为【凶杀案】）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro002"]}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "这样一来，就算要举行魔女审判，<br>\n我被人怀疑的可能性也很低。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative002"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "（为此，<br>\n　我要利用淋浴房的垃圾滑槽）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro003"]}},
    {"op": "ResetText", "line": 33, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 35, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 36, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 37, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyBackgroundExtended", "line": 39, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#b0a080", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "30_2"}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"TintColor": "#b0a080", "Duration": 0.0, "Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"TintColor": "#b0a080", "Duration": 0.0, "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "ModifyBackgroundExtended", "line": 43, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 44, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "这里隔音很好，可能是因为墙壁厚吧。<br>\n所以我想先试一次。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco001"]}},
    {"op": "ResetText", "line": 48, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 50, "indent": 0, "params": {"TintColor": "#000000FF", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 51, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyCharacterExtended", "line": 52, "indent": 0, "params": {"TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "HideAllCharacters", "line": 54, "indent": 0, "params": {"Lazy": 0}},
    {"op": "HideAllCharacters", "line": 55, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0}},
    {"op": "ModifyBackgroundExtended", "line": 57, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "TintColor": "#FFFFFF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "27_1"}},
    {"op": "ModifyBackgroundExtended", "line": 59, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 60, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PrintTextModified", "line": 66, "indent": 0, "params": {"Text": "（淋浴房隔音性能这么好，<br>\n　应该可以在那里避人耳目地执行计划）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro004"]}},
    {"op": "PrintTextModified", "line": 68, "indent": 0, "params": {"Text": "（计划很简单）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro005"]}},
    {"op": "PrintTextModified", "line": 70, "indent": 0, "params": {"Text": "（把艾玛叫出来杀了，<br>\n　再将她推下垃圾滑槽，<br>\n　之后焚烧炉就会把她的尸体烧个干净）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro006"]}},
    {"op": "PrintTextModified", "line": 72, "indent": 0, "params": {"Text": "我来到这里，正是为了调查焚烧炉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative003"]}},
    {"op": "PrintTextModified", "line": 74, "indent": 0, "params": {"Text": "于是我打开炉盖，看向里面。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative004"]}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "炉底积了一层黑灰，<br>\n若有若无的焦味飘进鼻腔。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative005"]}},
    {"op": "PrintTextModified", "line": 78, "indent": 0, "params": {"Text": "如此大型的焚烧炉，<br>\n一定能用高温将尸体彻底焚烧干净吧。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative006"]}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "（虽然有可能因为温度不够而烧不干净骨头……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro007"]}},
    {"op": "PrintTextModified", "line": 82, "indent": 0, "params": {"Text": "（但即便被人发现，<br>\n　也会被当做【事故】处理吧）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro008"]}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "（只要事先准备好<br>\n　能证明是【事故】的证据就可以）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro009"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "我打开魔女图鉴，再次确认规定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative007"]}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "地下的焚烧炉每周一15时启动。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative008"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "（……距离启动还有一点时间。<br>\n　在那之前要打磨好细节）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro010"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "正当我刚想合上盖子<br>\n准备走的时候。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "嗯……？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro011"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "炉子里有什么奇异的东西闪了一下。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative010"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "那东西沉在炉底，<br>\n乍一看只是个发黑的金属片。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative011"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "不知为何我有点好奇，把它取了出来。<br>\n擦一擦表面，上面刻有文字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative012"]}},
    {"op": "UpdateWitchBook", "line": 107, "indent": 0, "params": {"Id": "16", "Category": "Note", "Version": 1}},
    {"op": "ModifyCharacterExtended", "line": 109, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 111, "indent": 0, "params": {"Text": "这是……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro012"]}},
    {"op": "PrintTextModified", "line": 113, "indent": 0, "params": {"Text": "上面刻着我能看懂的文字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative013"]}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "大概是以前的囚犯努力想留下些记录，<br>\n才把它刻在金属上的。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative014"]}},
    {"op": "StopBgm", "line": 117, "indent": 0, "params": {"FadeOutDuration": 2.0}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "我刚打算仔细阅读——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative015"]}},
    {"op": "HideAllCharacters", "line": 121, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "咦，这不是希罗亲吗……<br>\n你在这干嘛呢？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco002"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "身后冷不防地传来可可的声音，<br>\n我吓了一跳，扭头看向她。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative016"]}},
    {"op": "PlayBgm", "line": 127, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 128, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 129, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Normal1"}},
    {"op": "Wait", "line": 130, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "……没什么。<br>\n这里也是我平时巡视的一环。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro013"]}},
    {"op": "ModifyCharacterExtended", "line": 134, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 136, "indent": 0, "params": {"Text": "（被人目击到我在焚烧炉室，<br>\n　会不会有麻烦——）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro014"]}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "我在脑海里做了片刻的模拟实验，<br>\n应该没什么问题。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative017"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "倒是你，来这里做什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro015"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "你不知道吗？我经常来这啦。<br>\n比如说想一个人静静的时候。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco003"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 150, "indent": 0, "params": {"Text": "更确切地说……是【我推】联系我的时候。<br>\n这里没人来，所以能专心跟他聊天。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco004"]}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "（什么意思……？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro016"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "啊啊啊不跟你啰嗦了！没时间啦！<br>\n不管我干嘛都给我当没看见啊！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco005"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "看样子可可很嫌我碍事，<br>\n但她似乎已经放弃赶我走了。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative018"]}},
    {"op": "StopBgm", "line": 162, "indent": 0, "params": {"FadeOutDuration": 2.0}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "她急匆匆地拿出自己的手机，<br>\n贴在耳边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative019"]}},
    {"op": "ResetText", "line": 166, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 167, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 168, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 169, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Coco.Surprised1"}},
    {"op": "Wait", "line": 170, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 171, "indent": 0, "params": {"Duration": 0.4000000059604645, "Lazy": 0, "IdAndAppearance": "Coco.Pensive1,ArmR11"}},
    {"op": "Wait", "line": 172, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 173, "indent": 0, "params": {"Duration": 0.4000000059604645, "Lazy": 0, "IdAndAppearance": "Coco.Flushed1,ArmR11"}},
    {"op": "Wait", "line": 174, "indent": 0, "params": {"WaitMode": "0.4"}},
    {"op": "PrintTextModified", "line": 176, "indent": 0, "params": {"Text": "啊～我挺好的呀？<br>\n没什么好担心的啦。<br>\n真是的每天唠唠叨叨的也不嫌烦……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco006"]}},
    {"op": "PlayBgm", "line": 178, "indent": 0, "params": {"BgmPath": "Bgm_40_1_Loop", "IntroBgmPath": "Bgm_40_1_Intro", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "ModifyCharacterExtended", "line": 180, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "不会啊，我很开心。<br>\n你一直都记着我嘛。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco007"]}},
    {"op": "ModifyCharacterExtended", "line": 184, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1"}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "会的，我一定会回去的。<br>\n哎呀，都说了不要再担心人家啦！", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco008"]}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "我更担心你啊爷爷！<br>\n整个人都虚弱了那么多……别那么难过啦……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco009"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Cry1"}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "我会带给你笑容的……等着我。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco010"]}},
    {"op": "ResetText", "line": 198, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 199, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 200, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "…………", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro017"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 205, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Coco.Pensive1,ArmR1"}},
    {"op": "Wait", "line": 206, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "可可放下手机，深深叹气。<br>\n然后她轻轻吸了下鼻子，带着一脸尴尬看向我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative020"]}},
    {"op": "ModifyCharacterExtended", "line": 210, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Pensive1"}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "……你应该大致猜到了吧。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco011"]}},
    {"op": "ModifyCharacterExtended", "line": 214, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 216, "indent": 0, "params": {"Text": "嗯。你的魔法是【千里眼】。<br>\n也就是说，你刚才是在跟某个<br>\n正在看你以前的影像或照片的人对话。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro018"]}},
    {"op": "PrintTextModified", "line": 218, "indent": 0, "params": {"Text": "也就是你的家人。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro019"]}},
    {"op": "ModifyCharacterExtended", "line": 220, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Angry1"}},
    {"op": "PrintTextModified", "line": 222, "indent": 0, "params": {"Text": "都说了，那是全世界最最重要的【我推】啊。<br>\n当然了，这也是因为他每天都<br>\n看着我的照片跟我说话……", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco012"]}},
    {"op": "ModifyCharacterExtended", "line": 224, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Smile1"}},
    {"op": "PrintTextModified", "line": 226, "indent": 0, "params": {"Text": "虽然他听不见我的声音，<br>\n但我就是想回应他嘛。", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco013"]}},
    {"op": "ModifyCharacterExtended", "line": 228, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Coco.Flushed1"}},
    {"op": "PrintTextModified", "line": 230, "indent": 0, "params": {"Text": "我知道这么干很傻，不准看不起我啊！？", "AuthorId": "Coco", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Coco014"]}},
    {"op": "ModifyCharacterExtended", "line": 232, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro"}},
    {"op": "PrintTextModified", "line": 234, "indent": 0, "params": {"Text": "我没有看不起你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro020"]}},
    {"op": "PrintTextModified", "line": 236, "indent": 0, "params": {"Text": "（反而对你刮目相看了才是。<br>\n　不过……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro021"]}},
    {"op": "ModifyCharacterExtended", "line": 238, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Pensive1"}},
    {"op": "PrintTextModified", "line": 240, "indent": 0, "params": {"Text": "（如果可可每天都在听这么重要的亲人的声音，<br>\n　那么，她的渴归之心肯定不是一般的强）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro022"]}},
    {"op": "PrintTextModified", "line": 242, "indent": 0, "params": {"Text": "（希望她最好不要想不开……）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Hiro023"]}},
    {"op": "PrintTextModified", "line": 244, "indent": 0, "params": {"Text": "但就算是这样，<br>\n我也没有余力对他人伸出援手。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative021"]}},
    {"op": "HideAllCharacters", "line": 246, "indent": 0, "params": {"Lazy": 0}},
    {"op": "StopBgm", "line": 247, "indent": 0, "params": {"FadeOutDuration": 3.0}},
    {"op": "PrintTextModified", "line": 249, "indent": 0, "params": {"Text": "见她想一个人静静地待一会，<br>\n我便离开了焚烧炉室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative022"]}},
    {"op": "UpdateWitchBook", "line": 251, "indent": 0, "params": {"Id": "Coco", "Category": "Profile", "Version": 5}},
    {"op": "ResetText", "line": 253, "indent": 0, "params": {}},
