    {"op": "Wait", "line": 256, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "ModifyBackgroundExtended", "line": 258, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "1_1"}},
    {"op": "ModifyBackgroundExtended", "line": 260, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 261, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "PlaySfxModified", "line": 264, "indent": 0, "params": {"SfxPath": "Sfx_111", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PlayBgm", "line": 266, "indent": 0, "params": {"BgmPath": "Bgm_6_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 268, "indent": 0, "params": {"Text": "——监狱生活第二轮，第十二天。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative023"]}},
    {"op": "PrintTextModified", "line": 270, "indent": 0, "params": {"Text": "——我不记得昨天有写过日记。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative024"]}},
    {"op": "PrintTextModified", "line": 272, "indent": 0, "params": {"Text": "——但是没关系。<br>\n我看起来没有魔女化的倾向，精神状态也十分稳定。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative025"]}},
    {"op": "PrintTextModified", "line": 274, "indent": 0, "params": {"Text": "——我不会堕为魔女。绝对不会。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv10_Narrative026"]}},
