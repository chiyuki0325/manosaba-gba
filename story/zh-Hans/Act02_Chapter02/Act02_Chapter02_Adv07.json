    {"op": "Wait", "line": 219, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "……", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro013"]}},
    {"op": "HideAllCharacters", "line": 225, "indent": 0, "params": {"Lazy": 0}},
