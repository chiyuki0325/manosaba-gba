{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter02/Act02_Chapter02_Adv07",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "IsDebugDirectJump": {"expression": "{isDebugDirectJump}"}}},
    {"op": "Gosub", "line": 2, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Scene2-2-7", "line": 4, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 10, "indent": 0, "params": {"Scale": {"expression": "{g_backgroundDefaultScale}"}, "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "28_1"}},
    {"op": "ModifyBackgroundExtended", "line": 11, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 12, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 18, "indent": 0, "params": {"BgmPath": "Bgm_11_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "我来到中庭。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "这是一方西洋风格的庭院，<br>\n看上去很适合开茶会。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative002"]}},
    {"op": "PrintTextModified", "line": 24, "indent": 0, "params": {"Text": "不过大概是因为长期无人打理，<br>\n到处长满了藤蔓。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative003"]}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "往上看，<br>\n可以看到二楼有多处用来通风的阳台。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative004"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "庭院中央有一处喷泉。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative005"]}},
    {"op": "PrintTextModified", "line": 30, "indent": 0, "params": {"Text": "（要是把艾玛按进喷泉里……<br>\n　不行，从好几个阳台都能看见这个地方，<br>\n　很有可能被人看到）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro001"]}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "实际上，中庭也确实有人。<br>\n蕾雅、诺亚和亚里沙就在稍远处。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 34, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Normal1"}},
    {"op": "ModifyCharacterExtended", "line": 35, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah.Normal1"}},
    {"op": "PrintTextModified", "line": 37, "indent": 0, "params": {"Text": "蕾雅和诺亚正在商量舞台剧的事。<br>\n而亚里沙——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative007"]}},
    {"op": "HideAllCharacters", "line": 39, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 40, "indent": 0, "params": {"Scale": [0.5], "Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Alisa.Normal1,Option-ArmL-Off"}},
    {"op": "PrintTextModified", "line": 42, "indent": 0, "params": {"Text": "她站在两棵紧挨着的树下面，正在摆弄着什么。<br>\n只见她手里拿着一根绳子。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative008"]}},
    {"op": "HideAllCharacters", "line": 44, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "……！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro002"]}},
    {"op": "ResetText", "line": 48, "indent": 0, "params": {}},
    {"op": "ModifyBackgroundExtended", "line": 50, "indent": 0, "params": {"Id": "Stills", "Scale": {"expression": "{g_backgroundDefaultScale}"}, "Lazy": 0, "AppearanceAndTransition": "150_2"}},
    {"op": "Wait", "line": 51, "indent": 0, "params": {"WaitMode": "1"}},
    {"op": "HideActors", "line": 52, "indent": 0, "params": {"ActorIds": ["Stills"], "Lazy": 0}},
    {"op": "PrintTextModified", "line": 54, "indent": 0, "params": {"Text": "一幕画面闪过脑海，瞬间心跳快得几乎扑出胸膛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative009"]}},
    {"op": "PrintTextModified", "line": 56, "indent": 0, "params": {"Text": "（冷静点。亚里沙并没有试图自杀）<br>", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro003"]}},
    {"op": "PrintTextModified", "line": 58, "indent": 0, "params": {"Text": "我做了个深呼吸，<br>\n这时，蕾雅和诺亚看到我，向这边走来。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 60, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia.Smile1"}},
    {"op": "ModifyCharacterExtended", "line": 61, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Noah"}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "你好啊希罗。<br>\n我想让你也看看这个。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia001"]}},
    {"op": "PrintTextModified", "line": 65, "indent": 0, "params": {"Text": "……看什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro004"]}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "蕾雅有些兴奋地<br>\n把素描本递给我看。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative011"]}},
    {"op": "PrintTextModified", "line": 69, "indent": 0, "params": {"Text": "这是舞台背景的草图。<br>\n是诺亚帮忙画的。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia002"]}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "说着，蕾雅一页页翻起素描本。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative012"]}},
    {"op": "PlaySfxModified", "line": 74, "indent": 0, "params": {"SfxPath": "Sfx_43", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 76, "indent": 0, "params": {"Text": "每一页都画着如梦似幻的风景，<br>\n让我不禁看入了迷。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative013"]}},
    {"op": "ModifyCharacterExtended", "line": 78, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 80, "indent": 0, "params": {"Text": "如何？画得很美吧？<br>\n诺亚简直是灵感之神！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia003"]}},
    {"op": "ModifyCharacterExtended", "line": 82, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Flushed1"}},
    {"op": "PrintTextModified", "line": 84, "indent": 0, "params": {"Text": "哎嘿嘿，说得我都不好意思了～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Noah001"]}},
    {"op": "PrintTextModified", "line": 86, "indent": 0, "params": {"Text": "……没错。每张画都很有艺术性。<br>\n原来你不止是喷漆画艺术家啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro005"]}},
    {"op": "ModifyCharacterExtended", "line": 88, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "只要是画画，诺亚都喜欢。<br>\n不过最喜欢的还是喷漆画。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Noah002"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "我试着跟诺亚搭话，看到她笑着回应，<br>\n我莫名感到一点安心。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative014"]}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "最近呀，<br>\n诺亚感觉自己操纵魔法越来越熟练了。<br>", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Noah003"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "魔法都能好好变成诺亚心里描绘的场景了呢。<br>\n一定是因为诺亚的画技提升了！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Noah004"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "诺亚骄傲地挺起胸膛，<br>\n蕾雅也开心地连连点头赞同。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative015"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "诺亚画出的背景，再配上我的演绎……<br>\n啊，我现在就开始期待站上舞台的那一刻了！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 108, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 110, "indent": 0, "params": {"Text": "嗯，诺亚也很期待～", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Noah005"]}},
    {"op": "ModifyCharacterExtended", "line": 112, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR9,ArmL3"}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "让我们一起创作出最精彩的舞台剧吧！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia005"]}},
    {"op": "PrintTextModified", "line": 116, "indent": 0, "params": {"Text": "蕾雅和诺亚相视一笑。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative016"]}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "……真是热情四溢啊。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 120, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR1,ArmL1"}},
    {"op": "PrintTextModified", "line": 122, "indent": 0, "params": {"Text": "因为我享受舞台啊。<br>\n既然要做，就要做到最好。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia006"]}},
    {"op": "ModifyCharacterExtended", "line": 124, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Normal1"}},
    {"op": "PrintTextModified", "line": 126, "indent": 0, "params": {"Text": "作为职业演员，我决不允许半吊子的心态。<br>\n我想创作出好作品。<br>\n想创作出能打动观众心灵的好作品。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia007"]}},
    {"op": "PrintTextModified", "line": 128, "indent": 0, "params": {"Text": "这句话听起来像是在强烈诉说着：<br>\n【打动你的心灵】同样是目标的一部分。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative017"]}},
    {"op": "PrintTextModified", "line": 130, "indent": 0, "params": {"Text": "（蕾雅作为职业演员的态度非常端正。<br>\n　我不能践踏她的心情）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro007"]}},
    {"op": "PrintTextModified", "line": 132, "indent": 0, "params": {"Text": "……我还有事要做。<br>\n所以没办法帮你们忙。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro008"]}},
    {"op": "PrintTextModified", "line": 134, "indent": 0, "params": {"Text": "但剧目上演那天，我会去看的。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro009"]}},
    {"op": "ModifyCharacterExtended", "line": 136, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 138, "indent": 0, "params": {"Text": "真的吗！？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia008"]}},
    {"op": "ModifyCharacterExtended", "line": 140, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 142, "indent": 0, "params": {"Text": "太好啦，蕾雅。", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Noah006"]}},
    {"op": "ModifyCharacterExtended", "line": 144, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 146, "indent": 0, "params": {"Text": "嗯，我越来越有干劲了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia009"]}},
    {"op": "ModifyCharacterExtended", "line": 148, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1,ArmR6,ArmL3"}},
    {"op": "PrintTextModified", "line": 152, "indent": 0, "params": {"Text": "“那就与我同行吧，前往那梦想诞生之地！<br>\n在那里，连时间都无法将我们束缚！”", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Leia010"]}},
    {"op": "ModifyCharacterExtended", "line": 154, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Noah.Smile1"}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "好厉害！<br>\n真的像变了个人一样！", "AuthorId": "Noah", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Noah007"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "蕾雅即兴来了一段台词，<br>\n让诺亚兴奋得满眼放光。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative018"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "我的嘴角也不禁划出一条弧度。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative019"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "或许我们不再像以前那般亲近，<br>\n但对于现在的我来说，她们依然——", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative020"]}},
    {"op": "ResetText", "line": 164, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 165, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PlaySfxModified", "line": 168, "indent": 0, "params": {"SfxPath": "Sfx_127", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "Wait", "line": 169, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 171, "indent": 0, "params": {"Text": "——", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro010"]}},
    {"op": "PrintTextModified", "line": 173, "indent": 0, "params": {"Text": "一阵绳子的吱呀声响传来，<br>\n让我的想像瞬间凝固。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative021"]}},
    {"op": "ModifyCharacterExtended", "line": 175, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [80.0], "IdAndAppearance": "Alisa"}},
    {"op": "PrintTextModified", "line": 177, "indent": 0, "params": {"Text": "亚里沙在不远处的树下，<br>\n正用绳子和布料制作些什么。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative022"]}},
    {"op": "PrintTextModified", "line": 179, "indent": 0, "params": {"Text": "她把绳子分别缠在两棵树上。<br>\n然后用钩子将摊开的布挂在绳子上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative023"]}},
    {"op": "PrintTextModified", "line": 181, "indent": 0, "params": {"Text": "好，差不多了。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Alisa001"]}},
    {"op": "HideAllCharacters", "line": 183, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 185, "indent": 0, "params": {"Text": "我离开诺亚她们，<br>\n朝亚里沙走去。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative024"]}},
    {"op": "ModifyCharacterExtended", "line": 187, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Hiro"}},
    {"op": "ModifyCharacterExtended", "line": 188, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Alisa.Normal1"}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "你在做什么？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro011"]}},
    {"op": "ModifyCharacterExtended", "line": 192, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Smile1"}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "这都看不出吗。<br>\n我在做吊床。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Alisa002"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "……为什么要做这个？", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Hiro012"]}},
    {"op": "ModifyCharacterExtended", "line": 198, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Surprised1"}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "哈？", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Alisa003"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "听见我的疑问，<br>\n她似乎有些不解地眨了眨眼。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative025"]}},
    {"op": "ModifyCharacterExtended", "line": 204, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Alisa.Pensive1"}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "当然是用来睡觉的啊。", "AuthorId": "Alisa", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Alisa004"]}},
    {"op": "HideAllCharacters", "line": 208, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "说完她就转过身，<br>\n像在拒绝和我继续交谈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative026"]}},
    {"op": "PrintTextModified", "line": 212, "indent": 0, "params": {"Text": "她检查过强度没有问题后，<br>\n便躺到吊床上。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv07_Narrative027"]}},
    {"op": "ResetText", "line": 214, "indent": 0, "params": {}},
