{
  "format": "manosaba.story",
  "version": 1,
  "language": "zh-Hans",
  "path": "Act02_Chapter02/Act02_Chapter02_Trial13",
  "events": [
    {"op": "GosubResetWitchBook", "line": 1, "indent": 0, "params": {"Path": "System/System_ResetWitchBook", "Version": 5}},
    {"op": "SetCustomVariable", "line": 2, "indent": 0, "params": {"Expression": "isReenact = true"}},
    {"op": "ModifyTextPrinter", "line": 3, "indent": 0, "params": {"Duration": 0.0, "Lazy": 0, "IdAndAppearance": "Normal.Simple", "MakeDefault": 1, "HideOther": 1}},
    {"op": "Gosub", "line": 4, "indent": 0, "params": {"Path": "System/System_Subroutine.BeginAdv"}},
    {"op": "label", "name": "Judge7-13-1", "line": 11, "indent": 0},
    {"op": "ModifyBackgroundExtended", "line": 13, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 14, "indent": 0, "params": {"WaitMode": "1.8"}},
    {"op": "PlayBgm", "line": 17, "indent": 0, "params": {"BgmPath": "Bgm_19_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "SpawnExtended", "line": 22, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S01", "Wait": 0}},
    {"op": "Wait", "line": 23, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 25, "indent": 0, "params": {"Text": "再怎么狡辩<br>\n也改变不了事实。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka001"]}},
    {"op": "PrintTextModified", "line": 27, "indent": 0, "params": {"Text": "是我，杀了泽渡可可。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka002"]}},
    {"op": "PrintTextModified", "line": 29, "indent": 0, "params": {"Text": "一切都是我的所作所为……<br>\n是我种下的恶果。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka003"]}},
    {"op": "PrintTextModified", "line": 31, "indent": 0, "params": {"Text": "若要说是谁有错……<br>\n别无他人。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka004"]}},
    {"op": "PrintTextModified", "line": 33, "indent": 0, "params": {"Text": "只有我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka005"]}},
    {"op": "ResetText", "line": 35, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 36, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S01", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 37, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 41, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S02", "Wait": 0}},
    {"op": "Wait", "line": 42, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 44, "indent": 0, "params": {"Text": "……为了阻止泽渡可可的计划，<br>\n我把她喊到淋浴房。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka006"]}},
    {"op": "PrintTextModified", "line": 46, "indent": 0, "params": {"Text": "但她完全听不进我说的话。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka007"]}},
    {"op": "PrintTextModified", "line": 48, "indent": 0, "params": {"Text": "因为她也有不能让步的理由……<br>\n所以没谈拢。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka008"]}},
    {"op": "PrintTextModified", "line": 50, "indent": 0, "params": {"Text": "最后她实在不耐烦了，便想要离开那里。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka009"]}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "于是……我抓住她的肩膀<br>\n想拦住她。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka010"]}},
    {"op": "PrintTextModified", "line": 57, "indent": 0, "params": {"Text": "可她却立马激动起来……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka011"]}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "然后一把推开了我。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka012"]}},
    {"op": "ResetText", "line": 63, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 64, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S02", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 65, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 70, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S03", "Wait": 0}},
    {"op": "Wait", "line": 71, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 73, "indent": 0, "params": {"Text": "而我的身后……<br>\n是垃圾滑槽。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka013"]}},
    {"op": "PrintTextModified", "line": 75, "indent": 0, "params": {"Text": "滑槽的盖子好像本来就快坏了……<br>\n被我猛地一撞，盖子掀开了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka014"]}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "然后，我支撑不住自己的身体<br>\n头朝下掉了下去……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka015"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "当时，我失去了意识。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka016"]}},
    {"op": "ResetText", "line": 82, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 83, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S03", "Wait": 0, "LogWarning": 1}},
    {"op": "ModifyBackgroundExtended", "line": 84, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 85, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 86, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 88, "indent": 0, "params": {"Text": "我不知道自己<br>\n昏迷了多久。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka017"]}},
    {"op": "PrintTextModified", "line": 90, "indent": 0, "params": {"Text": "只是等醒来以后，<br>\n我发现自己在焚烧炉里。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka018"]}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "在没有一丝光亮的漆黑当中……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka019"]}},
    {"op": "PrintTextModified", "line": 94, "indent": 0, "params": {"Text": "这突如其来的事件……让我陷入一片混乱。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka020"]}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "我只记得自己被撞了下去，<br>\n再不出去肯定会被烧死。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka021"]}},
    {"op": "PrintTextModified", "line": 98, "indent": 0, "params": {"Text": "就在这时……<br>\n我听见了声音。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka022"]}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "是泽渡可可的声音。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka023"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "于是我从里侧轻轻打开焚烧炉的盖子，<br>\n外面的光便照了进来。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka024"]}},
    {"op": "ModifyBackgroundExtended", "line": 104, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 105, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "SpawnExtended", "line": 112, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S04", "Wait": 0}},
    {"op": "Wait", "line": 113, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 115, "indent": 0, "params": {"Text": "那束光……<br>\n在炉子遍地的垃圾中<br>\n照亮了我手边的一样东西。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka025"]}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "那个东西呢。<br>\n……就是手枪。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka026"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "真是巧得可怕。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka027"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "为了不引起泽渡可可的警惕，<br>\n我把平时带在身边的枪收起来了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka028"]}},
    {"op": "PrintTextModified", "line": 123, "indent": 0, "params": {"Text": "但在看到那把枪的瞬间，我觉得这一定是命中注定。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka029"]}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "……只要有它，我就能保护自己的生命。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka030"]}},
    {"op": "PrintTextModified", "line": 127, "indent": 0, "params": {"Text": "只要有它……我就能阻止泽渡可可的计划。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka031"]}},
    {"op": "PrintTextModified", "line": 129, "indent": 0, "params": {"Text": "……于是。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka032"]}},
    {"op": "PrintTextModified", "line": 131, "indent": 0, "params": {"Text": "我", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka033"]}},
    {"op": "PrintTextModified", "line": 133, "indent": 0, "params": {"Text": "捡起了", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka034"]}},
    {"op": "PrintTextModified", "line": 135, "indent": 0, "params": {"Text": "那把手枪", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka035"]}},
    {"op": "ResetText", "line": 137, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 138, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S04", "Wait": 0, "LogWarning": 1}},
    {"op": "ModifyBackgroundExtended", "line": 139, "indent": 0, "params": {"TintColor": "#00000000", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 140, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 1.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 141, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PlaySfxModified", "line": 144, "indent": 0, "params": {"SfxPath": "Sfx_38", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "ModifyBackgroundExtended", "line": 147, "indent": 0, "params": {"TintColor": "#FFFFFFFF", "Duration": 0.0, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "ModifyBackgroundExtended", "line": 148, "indent": 0, "params": {"TintColor": "#000000ff", "Duration": 0.5, "Lazy": 0, "AppearanceAndTransition": "SolidColor.Custom", "SubId": "Overlay"}},
    {"op": "Wait", "line": 149, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "Wait", "line": 152, "indent": 0, "params": {"WaitMode": "2"}},
    {"op": "PrintTextModified", "line": 154, "indent": 0, "params": {"Text": "……然后，泽渡可可死了。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka036"]}},
    {"op": "PrintTextModified", "line": 156, "indent": 0, "params": {"Text": "面对她的遗骸，<br>\n我再次真正认识到<br>\n自己杀了人。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka037"]}},
    {"op": "PrintTextModified", "line": 158, "indent": 0, "params": {"Text": "……我犯下了无法挽回的过错。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka038"]}},
    {"op": "PrintTextModified", "line": 160, "indent": 0, "params": {"Text": "我想——<br>\n我大概就是在那时变成了魔女吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka039"]}},
    {"op": "PrintTextModified", "line": 162, "indent": 0, "params": {"Text": "我隐隐感到已经没有了退路。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka040"]}},
    {"op": "PrintTextModified", "line": 164, "indent": 0, "params": {"Text": "我的幻视魔法开始失控，<br>\n读取了周围所有物体的过去。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka041"]}},
    {"op": "PrintTextModified", "line": 166, "indent": 0, "params": {"Text": "这里的所有人……甚至这座监牢的过去，<br>\n所有信息都顺着地面、顺着墙壁<br>\n纷涌至我的脑海。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka042"]}},
    {"op": "PrintTextModified", "line": 168, "indent": 0, "params": {"Text": "名为幻视的各种信息……<br>\n塞满了我整个大脑。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka043"]}},
    {"op": "ModifyBackgroundExtended", "line": 170, "indent": 0, "params": {"TintColor": "#000000", "Duration": 1.2000000476837158, "Lazy": 0, "AppearanceAndTransition": "Transparent", "SubId": "Overlay"}},
    {"op": "Wait", "line": 171, "indent": 0, "params": {"WaitMode": "0.6"}},
    {"op": "ResetText", "line": 178, "indent": 0, "params": {}},
    {"op": "SpawnExtended", "line": 179, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S05", "Wait": 0}},
    {"op": "Wait", "line": 180, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 182, "indent": 0, "params": {"Text": "……回过神来时，我已经抓住了焚烧炉里的绳子。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka044"]}},
    {"op": "PrintTextModified", "line": 184, "indent": 0, "params": {"Text": "那是我之前准备的，<br>\n用来摆脱典狱长追捕的路线。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka045"]}},
    {"op": "PrintTextModified", "line": 186, "indent": 0, "params": {"Text": "我把周围丢弃的衣服<br>\n绑在一起。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka046"]}},
    {"op": "PrintTextModified", "line": 188, "indent": 0, "params": {"Text": "然后再把衣服捆在一起，<br>\n做成搬运泽渡可可尸体的临时担架。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka047"]}},
    {"op": "PrintTextModified", "line": 190, "indent": 0, "params": {"Text": "——因为根据【幻视】的内容，我预料到<br>\n如果把尸体放在这里，在焚烧炉启动前就会被人发现。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka048"]}},
    {"op": "PrintTextModified", "line": 192, "indent": 0, "params": {"Text": "……我顺着绳子<br>\n匆忙爬到了二楼诺亚的画室。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka049"]}},
    {"op": "PrintTextModified", "line": 194, "indent": 0, "params": {"Text": "接着把泽渡可可拉了上去，<br>\n跟枪一起从画室丢到中庭。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka050"]}},
    {"op": "PrintTextModified", "line": 196, "indent": 0, "params": {"Text": "一切都是为了优先生存……<br>\n我的身体几乎是不由自主地在动。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka051"]}},
    {"op": "PrintTextModified", "line": 198, "indent": 0, "params": {"Text": "我没有余力思考别的事。<br>\n——不，是不想思考。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka052"]}},
    {"op": "PrintTextModified", "line": 200, "indent": 0, "params": {"Text": "因为那样的话，<br>\n我会抑制不住内心的绝望。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka053"]}},
    {"op": "PrintTextModified", "line": 202, "indent": 0, "params": {"Text": "之后，我避开所有人<br>\n晚一步到达尸体发现现场……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka054"]}},
    {"op": "PrintTextModified", "line": 204, "indent": 0, "params": {"Text": "然后默默地观望事情发展。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka055"]}},
    {"op": "PrintTextModified", "line": 206, "indent": 0, "params": {"Text": "我所做的就只有这些。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka056"]}},
    {"op": "PrintTextModified", "line": 208, "indent": 0, "params": {"Text": "射杀泽渡可可，将尸体搬到二楼，最后抛到中庭。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka057"]}},
    {"op": "PrintTextModified", "line": 210, "indent": 0, "params": {"Text": "就这样——我变成了魔女。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka058"]}},
    {"op": "ResetText", "line": 212, "indent": 0, "params": {}},
    {"op": "DestroySpawnedExtended", "line": 213, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S05", "Wait": 0, "LogWarning": 1}},
    {"op": "Wait", "line": 214, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "SpawnExtended", "line": 220, "indent": 0, "params": {"Path": "Reenact_Ch02_E02_S06", "Wait": 0}},
    {"op": "Wait", "line": 221, "indent": 0, "params": {"WaitMode": "1.5"}},
    {"op": "PrintTextModified", "line": 223, "indent": 0, "params": {"Text": "……现在想想，我来这里<br>\n一定是因为渴望被处刑吧。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka059"]}},
    {"op": "PrintTextModified", "line": 225, "indent": 0, "params": {"Text": "这里是我的绞刑台……<br>\n是坦白罪行的忏悔室。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka060"]}},
    {"op": "PrintTextModified", "line": 227, "indent": 0, "params": {"Text": "因为……泽渡可可她……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka061"]}},
    {"op": "PrintTextModified", "line": 231, "indent": 0, "params": {"Text": "直到中枪前的那一刻……<br>\n还在担心我的安危……", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka062"]}},
    {"op": "PrintTextModified", "line": 233, "indent": 0, "params": {"Text": "她很担心我摔下来以后怎么样，便过来看望我……<br>\n随后被我一枪击中。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka063"]}},
    {"op": "PrintTextModified", "line": 235, "indent": 0, "params": {"Text": "【幻视】……告诉了我这些。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka064"]}},
    {"op": "PrintTextModified", "line": 237, "indent": 0, "params": {"Text": "她真是个……傻孩子。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka065"]}},
    {"op": "PrintTextModified", "line": 239, "indent": 0, "params": {"Text": "所以……我不会乞求原谅。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka066"]}},
    {"op": "PrintTextModified", "line": 241, "indent": 0, "params": {"Text": "我是……应受制裁之人。", "AuthorId": "Nanoka", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Trial13_Nanoka067"]}},
    {"op": "ResetText", "line": 243, "indent": 0, "params": {}},
