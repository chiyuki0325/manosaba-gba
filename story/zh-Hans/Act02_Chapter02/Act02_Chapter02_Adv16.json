    {"op": "Wait", "line": 82, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "PlaySfxModified", "line": 85, "indent": 0, "params": {"SfxPath": "Sfx_34", "Volume": 1.0, "Loop": 0, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "会客厅的大屏幕亮起同时，<br>\n响起了滑稽的庆祝号角声。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Narrative010"]}},
    {"op": "ModifyCharacterExtended", "line": 89, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [30.0, 30.0], "IdAndAppearance": "Ema.Angry1"}},
    {"op": "ModifyCharacterExtended", "line": 90, "indent": 0, "params": {"Scale": [1.5], "Lazy": 0, "ScenePosition": [70.0, 30.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 92, "indent": 0, "params": {"Text": "而后，画面上出现的是……<br>\n我和艾玛两人的名字。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Narrative011"]}},
    {"op": "HideAllCharacters", "line": 94, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 95, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyTextPrinter", "line": 96, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Normal.Default", "MakeDefault": 1, "HideOther": 1}},
    {"op": "ModifyBackgroundExtended", "line": 97, "indent": 0, "params": {"TintColor": "#FFFFFF", "Lazy": 0, "AppearanceAndTransition": "5_1"}},
    {"op": "Wait", "line": 98, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "ModifyCharacterExtended", "line": 99, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "Wait", "line": 100, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "哎呀，这可麻烦了。<br>\n希罗小姐和艾玛小姐票数相同，并列第一呢。<br>\n那么，先将你们二位关起来吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Warden004"]}},
    {"op": "HideAllCharacters", "line": 104, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 105, "indent": 0, "params": {"Scale": [1.0], "Lazy": 0, "ScenePosition": [50.0, 50.0], "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 107, "indent": 0, "params": {"Text": "我们都要被关起来……？<br>\n这我不能接受。我不是凶手！", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Hiro005"]}},
    {"op": "HideAllCharacters", "line": 109, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Warden.1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "可就算你这么说……规定就是规定。<br>\n如果你接受不了，就在审判中自证清白吧。", "AuthorId": "Warden", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Warden005"]}},
    {"op": "HideAllCharacters", "line": 114, "indent": 0, "params": {"Lazy": 0}},
    {"op": "ModifyCharacterExtended", "line": 115, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Jailer.1"}},
    {"op": "PrintTextModified", "line": 117, "indent": 0, "params": {"Text": "…………", "AuthorId": "Jailer", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Jailer001"]}},
    {"op": "PrintTextModified", "line": 119, "indent": 0, "params": {"Text": "看守的手不由分说地<br>\n抓住我和艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Narrative012"]}},
    {"op": "PrintTextModified", "line": 121, "indent": 0, "params": {"Text": "我无法抵抗它巨大的力气，再加上被它堵住嘴巴，<br>\n只能一个劲地瞪着艾玛。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Narrative013"]}},
    {"op": "HideAllCharacters", "line": 123, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 125, "indent": 0, "params": {"Text": "而艾玛也是同样瞪着我。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv16_Narrative014"]}},
