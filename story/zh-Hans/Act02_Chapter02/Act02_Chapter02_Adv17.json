    {"op": "PlayBgm", "line": 14, "indent": 0, "params": {"BgmPath": "Bgm_23_1", "Volume": 1.0, "Loop": 1, "FadeInDuration": 0.0}},
    {"op": "PrintTextModified", "line": 16, "indent": 0, "params": {"Text": "我和艾玛被看守关进了惩罚室。<br>", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative001"]}},
    {"op": "PrintTextModified", "line": 18, "indent": 0, "params": {"Text": "蕾雅也许是因为担心，<br>\n立刻来到了我们所在的地方。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative002"]}},
    {"op": "PrintTextModified", "line": 20, "indent": 0, "params": {"Text": "（该死的……又来了。<br>\n　为什么连我都要被怀疑！？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro001"]}},
    {"op": "PrintTextModified", "line": 22, "indent": 0, "params": {"Text": "（有问题的是艾玛。<br>\n　我明明是正确的，是正义的……！）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro002"]}},
    {"op": "ModifyCharacterExtended", "line": 24, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [50.0], "IdAndAppearance": "Leia.Pensive1"}},
    {"op": "PrintTextModified", "line": 26, "indent": 0, "params": {"Text": "二位，对不起。<br>\n要辛苦你们忍耐到审判了。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Leia001"]}},
    {"op": "PrintTextModified", "line": 28, "indent": 0, "params": {"Text": "蕾雅歉疚地皱着眉，<br>\n似乎是觉得很对不住我们。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative003"]}},
    {"op": "HideAllCharacters", "line": 30, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 32, "indent": 0, "params": {"Text": "（说真的我气得不行。<br>\n　……但只靠愤怒，是无法解决眼下问题的）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro003"]}},
    {"op": "PrintTextModified", "line": 34, "indent": 0, "params": {"Text": "（冷静点。好好思考。<br>\n　到底怎么做才能从审判中突围？）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro004"]}},
    {"op": "PrintTextModified", "line": 36, "indent": 0, "params": {"Text": "（……首先，必须掌握一些证据）", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro005"]}},
    {"op": "ResetText", "line": 38, "indent": 0, "params": {}},
    {"op": "HideAllCharacters", "line": 39, "indent": 0, "params": {"Lazy": 0}},
    {"op": "Wait", "line": 40, "indent": 0, "params": {"WaitMode": "0.5"}},
    {"op": "ModifyCharacterExtended", "line": 41, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "ModifyCharacterExtended", "line": 42, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Leia"}},
    {"op": "Wait", "line": 43, "indent": 0, "params": {"WaitMode": "0.3"}},
    {"op": "PrintTextModified", "line": 45, "indent": 0, "params": {"Text": "……蕾雅，我想麻烦你帮个忙。<br>\n可以告诉我现在几点吗。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro006"]}},
    {"op": "ModifyCharacterExtended", "line": 47, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 49, "indent": 0, "params": {"Text": "当然可以。不用客气。<br>\n现在是……14时45分。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Leia002"]}},
    {"op": "PrintTextModified", "line": 51, "indent": 0, "params": {"Text": "蕾雅看着自己的手机回答道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative004"]}},
    {"op": "ModifyCharacterExtended", "line": 53, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 55, "indent": 0, "params": {"Text": "太好了，还来得及。<br>\n另外，我还有件事想拜托你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro007"]}},
    {"op": "ModifyCharacterExtended", "line": 57, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Smile1"}},
    {"op": "PrintTextModified", "line": 59, "indent": 0, "params": {"Text": "只要是我力所能及之事，<br>\n我都愿意帮忙。", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Leia003"]}},
    {"op": "HideAllCharacters", "line": 61, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 63, "indent": 0, "params": {"Text": "我瞥了眼近在身旁的艾玛，<br>\n示意蕾雅靠近我一点。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative005"]}},
    {"op": "ModifyCharacterExtended", "line": 65, "indent": 0, "params": {"Scale": [2.0], "Lazy": 0, "ScenePosition": [50.0, 0.0], "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "PrintTextModified", "line": 67, "indent": 0, "params": {"Text": "蕾雅察觉到我的意图便靠了过来，<br>\n我凑到她的耳边。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative006"]}},
    {"op": "ModifyCharacterExtended", "line": 69, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Flushed1"}},
    {"op": "PrintTextModified", "line": 71, "indent": 0, "params": {"Text": "呃，希罗……？", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Leia004"]}},
    {"op": "ModifyCharacterExtended", "line": 73, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Surprised1"}},
    {"op": "PrintTextModified", "line": 77, "indent": 0, "params": {"Text": "去调查地下的焚烧炉。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro008"]}},
    {"op": "PrintTextModified", "line": 79, "indent": 0, "params": {"Text": "我悄悄对她说道。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative007"]}},
    {"op": "ModifyCharacterExtended", "line": 81, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Leia.Angry1"}},
    {"op": "PrintTextModified", "line": 85, "indent": 0, "params": {"Text": "15时焚烧炉就要启动了。<br>\n快，抓紧去。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro009"]}},
    {"op": "PrintTextModified", "line": 87, "indent": 0, "params": {"Text": "……知道了，交给我吧！", "AuthorId": "Leia", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Leia005"]}},
    {"op": "HideAllCharacters", "line": 89, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 91, "indent": 0, "params": {"Text": "蕾雅用力点点头，<br>\n离开了惩罚室。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative008"]}},
    {"op": "ModifyCharacterExtended", "line": 93, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [30.0], "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "ModifyCharacterExtended", "line": 94, "indent": 0, "params": {"Lazy": 0, "ScenePosition": [70.0], "IdAndAppearance": "Hiro.Normal1"}},
    {"op": "PrintTextModified", "line": 96, "indent": 0, "params": {"Text": "你和蕾雅说什么了？", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Ema001"]}},
    {"op": "ModifyCharacterExtended", "line": 98, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Normal1,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Closed"}},
    {"op": "PrintTextModified", "line": 100, "indent": 0, "params": {"Text": "我没有义务回答你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro010"]}},
    {"op": "PrintTextModified", "line": 102, "indent": 0, "params": {"Text": "听到我的回答，艾玛垂下眼帘。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative009"]}},
    {"op": "ModifyCharacterExtended", "line": 104, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Ema.Pensive1,ArmR3"}},
    {"op": "PrintTextModified", "line": 106, "indent": 0, "params": {"Text": "……今天早上的希罗，全都是伪装出来的吗。", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Ema002"]}},
    {"op": "PrintTextModified", "line": 108, "indent": 0, "params": {"Text": "你跟我说了早安，态度也很温柔……<br>\n我还高兴地以为，<br>\n我们又能像以前那样要好了……", "AuthorId": "Ema", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Ema003"]}},
    {"op": "ModifyCharacterExtended", "line": 110, "indent": 0, "params": {"Lazy": 0, "IdAndAppearance": "Hiro.Angry1"}},
    {"op": "PrintTextModified", "line": 112, "indent": 0, "params": {"Text": "……不知道你误会了什么。<br>\n听好了，我，讨厌你。", "AuthorId": "Hiro", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Hiro011"]}},
    {"op": "PrintTextModified", "line": 114, "indent": 0, "params": {"Text": "——讨厌到恨不得杀死你。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative010"]}},
    {"op": "HideAllCharacters", "line": 116, "indent": 0, "params": {"Lazy": 0}},
    {"op": "PrintTextModified", "line": 118, "indent": 0, "params": {"Text": "自那以后，我和艾玛再无交谈。", "RevealSpeed": 1.0, "WaitForInput": 1, "Wait": 1}, "text_ids": {"Text": ["0202Adv17_Narrative011"]}},
