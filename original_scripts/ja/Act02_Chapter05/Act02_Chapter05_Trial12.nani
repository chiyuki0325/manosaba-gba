@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Leia
@char CreatureLeia.0-8 { Position:{leiaPositionX},{characterPositionY},{leiaPositionZ} Rotation:,{leiaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Noah
@char CreatureNoah.0-3 { Position:{noahPositionX},{characterPositionY},{noahPositionZ} Rotation:,{noahRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Margo
@char CreatureMargo.0-4 { Position:{margoPositionX},{characterPositionY},{margoPositionZ} Rotation:,{margoRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-12: 💬 【黒部ナノカ】
# ==============================================================================
# ＠ト書き▼議論10-12【黒部ナノカ】
# 議論開始カットイン
# BGM変更：HirO（Voなし）
@bgm Bgm_37_1_Loop

# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Nanoka.ArmR1,ArmL9,Eyes1_Flushed_Open1,Mouth1_Angry_Closed2,Sweat1_1 { time:0 }
@stageCamera 0 { Rotation:0,{ (10 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (9.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge10-12-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Nanoka.ArmR1,ArmL1,Eyes1_Normal_Open2,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 私はここに来てから、<br>この島の過去の光景を<br>少しだけ幻視した……。

@char Nanoka.ArmR1,ArmL1,Eyes1_Normal_Open2,Mouth1_Normal_Closed1
@gosubModifyCamera 0
@printDebate そこで見えた光景の<br>意味がなんなのか、<br>正確にはわかって<br>いなかったけれど……。

@char Nanoka.ArmR3,ArmL1,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate あなたの話を踏まえれば、<br>それが大魔女の力だった<br>ということがわかるわ。

@char Nanoka.ArmR3,ArmL1,Eyes1_Normal_Closed1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "大魔女の力は強力で、<br>あなたでは<br>到底<link=\"Objection_02_05_12_01\">敵わない</link>……。"

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Closed1,Mouth1_Smile_Open1
@gosubModifyCamera 0
@printDebate ……当然よね。<br>私たちの魔法は<br>彼女によって<br>与えられたものだもの。

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Pensive_Open1,Mouth1_Smile_Closed1
@gosubModifyCamera 0
@printDebate "コピーがオリジナルに<br><link=\"Objection_02_05_12_02\">勝てない</link>のは、<br>当たり前の事実よ。"

@char Nanoka.ArmR6,ArmL8,Eyes1_Flushed_Open1,Mouth1_Normal_Open1,Sweat1_1
@gosubModifyCamera 0
@printDebate それをどうにかするのが、<br>私の役目だ。

@char Nanoka.ArmR6,ArmL8,Eyes1_Flushed_Open1,Mouth1_Normal_Open1,Sweat1_1
@gosubModifyCamera 0
@printDebate ……いい加減にして。

@char Nanoka.ArmR6,ArmL8,Eyes1_Flushed_Open1,Mouth1_Normal_Open1,Sweat1_1
@gosubModifyCamera 0
@printDebate 大した戦力にも<br>ならないあなたが、<br>大魔女と戦って<br>勝てるわけないでしょう。

@char Nanoka.ArmR6,ArmL8,Eyes1_Angry_Closed1,Mouth1_Normal_Open1,Sweat1_1
@gosubModifyCamera 0
@printDebate "戦いにもなりはしない。<br>ただ<link=\"Objection_02_05_12_03\">無駄に殺される</link>だけ。"

@char Nanoka.ArmR6,ArmL3,Eyes1_Uncomfortable_Open1,Mouth1_Normal_Closed1,Sweat1_1
@gosubModifyCamera 0
@printDebate 私は大魔女に勝つため、<br>十分な準備を整える……。

@char Nanoka.ArmR6,ArmL3,Eyes1_Normal_Open3,Mouth1_Normal_Open1,Sweat1_1
@gosubModifyCamera 0
@printDebate "……あなたの<link=\"Objection_02_05_12_04\">博打</link>に<br>私を巻き込まないで<br>ちょうだい。"


# ==============================================================================
# 10-12議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.12
@gosubModifyCamera 0
@Wait 0.2

@print （魔女化してしまった私にはもう<br>　そんな時間はない） { author:Hiro speed:1 waitInput:true Wait:true }

@print （それにこの機会を逃せば、<br>　１３人の魔女を集めることも<br>　難しくなるだろう） { author:Hiro speed:1 waitInput:true Wait:true }

@print （……たとえナノカを傷付けたとしても、<br>　私は……前へと進む！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-12-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_12_01

@Skip false
@pauseTrial true

@choice 外に協力を仰ぐ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-12-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

