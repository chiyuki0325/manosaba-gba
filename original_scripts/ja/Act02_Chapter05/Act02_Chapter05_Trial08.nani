# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_08_01

@Skip false
@pauseTrial true

@choice 魔女化こそが証拠
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-8-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

