# ==============================================================================
# MARK: 10-14: 💬 【沢渡ココ】
# ==============================================================================
# ＠ト書き▼議論10-14【沢渡ココ】

@set judge_10_14_3Falg=false
# 議論開始カットイン
# BGM変更：HirO（Voなし）
@bgm Bgm_37_1_Loop

# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Coco.Default,ArmR13,ArmL10,Angle01/Facial/Eyes>Eyes_Cry_Open,Angle01/Facial/Mouth>Mouth_Cry_Open { time:0 }
@stageCamera 0 { Rotation:0,{ (5 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (4.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge10-14-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Cry_Open,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate こうして<br>わけわかんない場所に<br>連れて来られてさぁ！

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Middle
@gosubModifyCamera 0
@printDebate それでその、<br>【大魔女】？<br>……とかいうのと、<br>戦えっての！？

@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Angry_Open01
@gosubModifyCamera 0
@printDebate "そんなこと<br>いきなり言われても<br>無理だっての！<br>どうやって<br><link=\"Objection_02_05_14_01\">戦え</link>ってのさ！"

@if judge_10_14_3Falg=false
	@goto .Judge10-14-1Skip

@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Angry_Open01
@gosubModifyCamera 0
@printDebate "あてぃしただの学生で、<br>配信ぐらいしか<link=\"Objection_02_05_14_03\">できない</link>し！"

# Judge10-14-1Skip

@char Coco.Default,ArmR13,ArmL10,Angle01/Facial/Eyes>Eyes_Cry_Closed,Angle01/Facial/Mouth>Mouth_Angry_Closed
@gosubModifyCamera 0
@printDebate "それに現実を見ろとか<br>簡単に言うけど、<br><link=\"Objection_02_05_14_02\">現実</link>なんて……<br>ロクなもんじゃないだろ！"

@char Coco.Default,ArmR13,ArmL10,Angle01/Facial/Eyes>Eyes_Cry_Closed,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate あてぃしは推しを<br>見ることができりゃ<br>それでいいんだよ！

@char Coco.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Comical_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate 人の趣味にまで<br>とやかく<br>言ってくんじゃねー！！


