#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.2 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

@print （べつに彼女の趣味を否定しているわけではないが……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@print （そういえばそんな話……<br>　いつかにココ本人から聞いたような気がするな） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@print （彼女の身に起こったこと……<br>　それがその心の闇に繋がっているかもしれない） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-14-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_14_01

@Skip false
@pauseTrial true

@choice 戦わなくていい
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-14-4

@choice 逃げていい
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-14-5

@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_14_02

@Skip false
@pauseTrial true

@choice 何があったのか教えて
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-14-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_14_03

@Skip false
@pauseTrial true

# IF 10-14-3通過済のとき、選択肢を追加する。
@choice 隠れていればいい
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-14-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

