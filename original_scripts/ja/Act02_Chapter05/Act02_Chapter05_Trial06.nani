@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Leia
@char CreatureLeia.0-8 { Position:{leiaPositionX},{characterPositionY},{leiaPositionZ} Rotation:,{leiaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-6: 💬 ノアのかくしごと
# ==============================================================================
# ＠ト書き▼議論10-6ノアのかくしごと
# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge10-6-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Noah.Default,ArmR4,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate の、のあは何も<br>隠してないよっ……！<br>全然、なんにも……<br>まったく！

@char CreatureHiro.10
@gosubModifyCamera 0
@printDebate ……まず、君の正体は<br>正体不明の<br>ストリート・アーティスト、<br>【バルーン】だ。

# ＠備考◆驚き

@char Noah.Default,ArmR6,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ひゃあっ！？

@char Coco.Default,ArmR8,ArmL7,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate マ、マジ！？<br>あの……！？

# @備考◆焦り

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そ、それは……<br>その、その……。

@char CreatureHiro.11
@gosubModifyCamera 0
@printDebate ……そして<br>世間に評価されたその絵は<br>魔法で描かれたものだ。

@char Noah.Fearful1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ううー！？

@char CreatureHiro.18
@gosubModifyCamera 0
@printDebate 君が描いた絵とは言えない……<br>違うかな。

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そ、それは……。

@char Noah.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "ち、違うよ！？<br>のあ、<br><link=\"Objection_02_05_06_01\">お絵描き大好き</link>だもん！！"

# ＠備考◆不信をあらわに

@char Noah.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open_1,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ヒロちゃん……<br>なんでそんなこと言うの……！

# ==============================================================================
# 10-6議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.2
@gosubModifyCamera 0
@Wait 0.2

@print （ノアはああ見えて、なかなかに役者だ） { author:Hiro speed:1 waitInput:true Wait:true }

@print （だが……それは覚悟を決めた殺人を済ませた後の話） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@print （冷静になっていない今のうちに、<br>　その感情を揺さぶって心を打ち崩すんだ……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-6-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_06_01

@Skip false
@pauseTrial true

@choice ノアは絵を描けない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-6-3

@choice ノアは絵を描くのが好きだ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-6-2

@choice ノアは絵を描いたことがない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-6-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

