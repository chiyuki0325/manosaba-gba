@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Leia
@char CreatureLeia.0-8 { Position:{leiaPositionX},{characterPositionY},{leiaPositionZ} Rotation:,{leiaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Noah
@char CreatureNoah.0-3 { Position:{noahPositionX},{characterPositionY},{noahPositionZ} Rotation:,{noahRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-9: 💬 【宝生マーゴ】
# ==============================================================================
# ＠ト書き▼議論10-9【宝生マーゴ】
# 議論開始カットイン
# BGM変更：HirO（Voなし）
@bgm Bgm_37_1_Loop

# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open { time:0 }
@stageCamera 0 { Rotation:0,{ (9 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (8.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge10-9-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char CreatureHiro.18
@gosubModifyCamera 0
@printDebate 私は今朝目覚める前まで、<br>この牢屋敷で<br>君たちと生活をしていた……。

@char CreatureHiro.18
@gosubModifyCamera 0
@printDebate 今と同じように<br>連れて来られた虜囚としてね。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Normal_Closed
@gosubModifyCamera 0
@printDebate それで私が<br>殺人事件を起こした……<br>あなたは<br>そう主張していたわね。

@char CreatureHiro.19
@gosubModifyCamera 0
@printDebate ……そうだ。

@char CreatureHiro.20
@gosubModifyCamera 0
@printDebate 私が体験した中では、<br>４つの事件が起こり……<br>そして５人が死んだ。

@char CreatureHiro.20
@gosubModifyCamera 0
@printDebate その中で……<br>殺人を起こしてしまった<br>１人が君、マーゴだ。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate ……被害者については、<br>配慮として<br>隠しているのかしら？

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Closed,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate 今の自分とは関係ない<br>別の世界の<br>自分であったとしても、<br>私に殺されたなんて知ったら<br>身構えちゃうものね♡

@char CreatureHiro.5
@gosubModifyCamera 0
@printDebate ……察してくれて助かるよ。

@char CreatureHiro.10
@gosubModifyCamera 0
@printDebate 私たち魔女候補の少女は、<br>次第にその思考が凶暴化して<br>排他的になっていく……。

@char Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate け、喧嘩が<br>絶えなかったりとか……<br>したの……？

@char CreatureHiro.8
@gosubModifyCamera 0
@printDebate 表立って荒れるならいい方だ。

@char CreatureHiro.8
@gosubModifyCamera 0
@printDebate だいたいは人が死んで<br>手遅れになってから、<br>それに気付く。

@char CreatureHiro.10
@gosubModifyCamera 0
@printDebate 本人が自覚する暇すら<br>与えられず……<br>私たちは<br>他者を殺害するための刃を<br>磨いてしまう。

@char CreatureHiro.12
@gosubModifyCamera 0
@printDebate ……だが、<br>それではいけないんだ。

@char CreatureHiro.7
@gosubModifyCamera 0
@printDebate 我々は全員が生きたまま<br>魔女にならなくてはならない。<br>そうでなくては、<br>生き残れない。

@char CreatureHiro.7
@gosubModifyCamera 0
@printDebate だから私に協力して欲しい。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Closed
@gosubModifyCamera 0
@printDebate ……手放しに<br>信用できる話じゃないわね。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate もしあなたの言うことが<br>正しいのなら、<br>あなた自身は<br>どうだったのかしら？

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "誰もが殺人衝動を<br>抱くのであれば、<br>あなたも人を<br><link=\"Objection_02_05_09_01\">殺したくなった</link>と<br>いうことでしょう？"

@char CreatureHiro.5
@gosubModifyCamera 0
@printDebate ……私は、<br>殺すには至らなかった。

@char CreatureHiro.19
@gosubModifyCamera 0
@printDebate そして最後は、<br>自らの手で命を断ったんだ。

@char CreatureHiro.18
@gosubModifyCamera 0
@printDebate ……生きているみんなと<br>再び会うために……！

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate 自殺……ね。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate あなたの話では私たちは<br>殺し合っていたのよね？

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "なら、恨みこそすれ<br><link=\"Objection_02_05_09_02\">信頼</link>関係なんて<br>微塵もなかったはず……。"

@char Margo.Default,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate なのに<br>【みんな仲良く<br>ここを出ましょう】<br>……なんて<br>子供じみた主張をするの？

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Angry_Closed
@gosubModifyCamera 0
@printDebate ……信用できないわ。<br>あなたの言葉は<br>理屈が通っていないもの。


