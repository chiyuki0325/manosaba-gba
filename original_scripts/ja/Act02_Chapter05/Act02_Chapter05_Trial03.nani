@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-3: 💬 レイアの戦う理由
# ==============================================================================
# ＠ト書き▼議論10-3レイアの戦う理由
# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge10-3-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Leia.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate そもそも魔女だのなんだの、<br>いったいなんの話を<br>しているんだ！

@char Hanna.Surprised1,ArmR3,ArmL1
@gosubModifyCamera 0
@printDebate ……で、でも<br>魔法を使える人は<br>存在しますわ？<br>わたくしだって<br>そうですし……。

@char Leia.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Middle,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そ、それは<br>私もそうだが……！

@char Leia.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate ……とはいえ、<br>この牢屋敷からの脱出などは<br>ヒロくんの一方的な主張だ！

@char Leia.Default,ArmR10,ArmL8,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate "ヒロくんが<br><link=\"Objection_02_05_03_01\">真の黒幕</link>の可能性だって<br>あるんじゃないか！？"

@char Ema.Default,ArmR6,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate ……ヒ、ヒロちゃんは……。

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate ヒロちゃんはそんなこと、<br>しないと思う……！

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate たとえもし<br>そうだったとしても……<br>それをする<br>正しい理由が<br>あるんだと思う……。

@char CreatureHiro.25
@gosubModifyCamera 0
@printDebate （エマ……）

@char Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Fearful_Open
@gosubModifyCamera 0
@printDebate 【正しい理由】だって……？

@char Leia.Default,ArmR9,ArmL8,Angle01/Facial/Eyes>Eyes_Pensive_Closed,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate "私だってそうだとも！<br>私にはみんなを救うという<br><link=\"Objection_02_05_03_02\">目的</link>がある！"

@char Leia.Default,ArmR9,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Open01,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate "ここにいるみんなを<br><link=\"Objection_02_05_03_03\">守れるのは</link><br>私だけだ……！"

@char Leia.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Closed
@gosubModifyCamera 0
@printDebate 私ならみんなを守れる！<br>信じてくれ！


# ==============================================================================
# 10-3議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.1
@gosubModifyCamera 0
@Wait 0.2

@print （……相変わらず、レイアの行動原理はブレないな） { author:Hiro speed:1 waitInput:true Wait:true }

@print （だが彼女の人となりは十分にわかっている） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （……その裏に潜むものも） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@print （彼女の嘘を暴くとしよう） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-3-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_03_01

@Skip false
@pauseTrial true

@choice 団結を邪魔してはいけない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-3-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_03_02

@Skip false
@pauseTrial true

@choice 目立ちたいだけだ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-3-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_03_03

@Skip false
@pauseTrial true

@choice 守る気などない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-3-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

