# ==============================================================================
# MARK: 10-20: 💬 アリサの裁き
# ==============================================================================
# ＠ト書き▼議論10-20アリサの裁き

@set "isPlayed_10_20_3 = false"

# 議論開始カットイン
# BGM：Guil-me N'o sinruits-Vocal無-
@bgm Bgm_8_1

@courtFire true

# Judge10-20-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char CreatureAlisa.0-4
@gosubModifyCamera 0
@printDebate おめえらだって<br>わかってんだろうがよ……。

@char CreatureAlisa.0-4
@gosubModifyCamera 0
@printDebate "ウチらは魔女だ。<br><link=\"Objection_02_05_20_01\">呪われた子</link>だ。"

@char CreatureAlisa.0-4
@gosubModifyCamera 0
@printDebate "誰かを<link=\"Objection_02_05_20_02\">殺すための力</link>を<br>持って生まれてきて、<br>実際に誰かを<br>殺すことでしか<br>生きていけねー存在<br>なんだよ。"

@char CreatureAlisa.0-1
@gosubModifyCamera 0
@printDebate そんなん、<br>今取り戻した記憶を見りゃ<br>わかるだろ！？

@char CreatureAlisa.2-4
@gosubModifyCamera 0
@printDebate ……ならそんなもんは<br>存在しちゃいけねーんだ。

@char CreatureAlisa.2-4
@gosubModifyCamera 0
@printDebate "みんな跡形もなく<br>消し炭にして……<br><link=\"Objection_02_05_20_03\">終わらせちまえばいい</link>。"

@char CreatureAlisa.2-4
@gosubModifyCamera 0
@printDebate ウチなら、<br>それができる……。

@char CreatureAlisa.1-8
@gosubModifyCamera 0
@printDebate "だから……<br><link=\"Objection_02_05_20_04\">大人しく</link>死んどけよぉ！"


# ==============================================================================
# 10-20議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.22
@gosubModifyCamera 0
@Wait 0.2

@print （……ダメだ！<br>　この熱気……近付くことすらできない） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.22
@print （このままでは大魔女を呼び出すまでもなく、全滅だ……！） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.22
@print （なんとかアリサを落ち着かせなければ……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-20-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_20_01

@Skip false
@pauseTrial true

# 10-20-3通過後
@choice 悪いのは大魔女だ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-20-5

@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_20_02

@Skip false
@pauseTrial true

# MARK: 10-20-3: ❌ 通過後
@choice 正しく力を使える
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-20-6

@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

