@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.2
@gosubModifyCamera 0
@Wait 0.2

@print （すでに十分、ココの精神は摩耗している……<br>　魔女化は近いか） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （だが防衛機制は心を守るための働きだ） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@print （無理やりにでも<br>　逃避行動をやめさせれば<br>　ココの魔女化は近付くだろう……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@print （何か……そんな方法はなかったかな） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-13-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_13_01

@Skip false
@pauseTrial true

@choice ないものはない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-13-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_13_02

@Skip false
@pauseTrial true

@choice 現実を見るんだ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-13-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_13_03

@Skip false
@pauseTrial true

@choice 泣いても解決しない！
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-13-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

