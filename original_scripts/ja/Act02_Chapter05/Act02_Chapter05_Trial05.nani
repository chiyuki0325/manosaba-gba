@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-5: 💬 【蓮見レイア】
# ==============================================================================
# ＠ト書き▼議論10-5【蓮見レイア】
# 議論開始カットイン
# BGM変更：HirO（Voなし）
@bgm Bgm_37_1_Loop

# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Leia.Default,ArmR8,ArmL4,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Angry_Closed,Angle01/Facial/Sweat>Sweat01 { time:0 }
@stageCamera 0 { Rotation:0,{ (3 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (2.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge10-5-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char CreatureHiro.9
@gosubModifyCamera 0
@printDebate 君は人に見られる為に<br>活動を続けていた……。

@char CreatureHiro.8
@gosubModifyCamera 0
@printDebate どんな手段を使ってでも、<br>常に自分が一番でないと<br>気が済まなかったんだ。

@char Leia.Default,ArmR9,ArmL4,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Yell_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ち、違う！<br>私は、そんなこと……！

@char CreatureHiro.10
@gosubModifyCamera 0
@printDebate 何が違うのかな。

@char CreatureHiro.11
@gosubModifyCamera 0
@printDebate それとも君は、<br>魔法の使用を否定するのかい？

@char Leia.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Downcast_Open,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そ、それは……。

@char Leia.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ……でも、<br>べつに不正をしていた<br>わけじゃない！

@char Leia.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate オーディションや人と競う場で<br>自分を有利に<br>していたわけじゃないし……。

# ＠備考◆自信なさげに

@char Leia.Default,ArmR1,ArmL3,Angle01/Facial/Eyes>Eyes_Downcast_Open,Angle01/Facial/Mouth>Mouth_Angry_Closed,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "ただ……<br><link=\"Objection_02_05_05_01\">本番の舞台</link>の<br>クオリティを上げる為に……<br>使っていただけで……。"

@char Leia.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate け、決して<br>誰かを蹴落とす為に<br>使ったわけじゃない！

@char Leia.Default,ArmR9,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Yell_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "私は舞台を<br><link=\"Objection_02_05_05_02\">見てくれた人たち</link>の為に……<br>そして共に演じる仲間の為に<br>魔法を使ったんだ！"

@char Leia.Default,ArmR9,ArmL4,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "信じてくれ……！<br>私は今も、昔も、<br><link=\"Objection_02_05_05_03\">これから</link>も……<br>そんな卑怯な<br>真似なんてしない！"


