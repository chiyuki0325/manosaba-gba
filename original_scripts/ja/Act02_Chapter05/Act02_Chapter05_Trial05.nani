#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_05_01

@Skip false
@pauseTrial true

@choice 本番以外でも使用していた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-5-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

