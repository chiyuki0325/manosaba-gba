@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー初期化処理
@hide Hiro
@char CreatureHiro.1 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-1: 💬 魔女化について
# ==============================================================================
# ＠ト書き▼議論10-1 魔女化について
# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge10-1-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Meruru.Head1,ArmR1_1,Eyes1_Normal_Open1,Mouth1_Angry_Open2
@gosubModifyCamera 0
@printDebate ま、魔女化とは……<br>大魔女様に付与された<br>【魔女因子】が<br>覚醒することです。

@char Meruru.Head1,ArmR8_1,ArmL8,Eyes1_Normal_Open3,Mouth1_Angry_Open2
@gosubModifyCamera 0
@printDebate 魔女因子を持って<br>生まれた少女は<br>体質が合えば<br>魔法が使えるようになります。

@gosubModifyCamera 0
@printDebate "そして少女の<br><link=\"Objection_02_05_01_01\">精神が魔女化</link>することで、<br><link=\"Objection_02_05_01_02\">肉体もまた魔女と化す</link><br>のです。"

@char Meruru.Head1,ArmR5_1,ArmL8,Eyes1_Pensive_Open2
@gosubModifyCamera 0
@printDebate その行き着く先は<br>【なれはて】……。

@gosubModifyCamera 0
@printDebate 【なれはて】とは、<br>魔女因子が魂を食い尽くした<br>魔女の抜け殻のようなものです。

@char Meruru.Head1,ArmR5_1,ArmL8,Eyes1_Smile_Closed1,Mouth1_Flushed_Closed1
@gosubModifyCamera 0
@printDebate 魔法も使えない、<br>ただのお人形……。

@char Meruru.Head1,ArmR1_1,ArmL1,Eyes1_Normal_Open1,Mouth1_Angry_Open2
@gosubModifyCamera 0
@printDebate 魔女因子が魂を喰らい尽くすと<br>魔女化して定着した<br>一部の因子を残して<br>その肉体を離れます。

@char Meruru.Head1,Mouth1_Smile_Closed1
@gosubModifyCamera 0
@printDebate そして離れた魔女因子は<br>輪廻転生のように<br>新たな少女へと<br>移っていくんです。

@char Meruru.Head2,ArmR5_2,ArmL5,Eyes2_Downcast_Open1,Mouth2_Smile_Closed1
@gosubModifyCamera 0
@printDebate ……で、でも私は……<br>そんな魔女化してできた<br>魔女とは<br>違う存在で――。

@char Meruru.Head2,ArmR1_2,Eyes2_Downcast_Open1,Mouth2_Smile_Closed1
@gosubModifyCamera 0
@printDebate "――最後に残った<br><link=\"Objection_02_05_01_03\">【原初の魔女】</link>なんです。"

@char CreatureHiro.17
@gosubModifyCamera 0
@printDebate 【原初の魔女】……？

@char Meruru.Head1,ArmR8_1,ArmL8,Eyes1_Normal_Open2,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate この島にはその昔、<br>大魔女さまと共に<br>【原初の魔女】たる<br>大勢の魔女が住んでいました。

@char Meruru.Head1,ArmR8_1,ArmL8,Eyes1_Normal_Open3,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate "【原初の魔女】とは、<br>元からこの島に<br><link=\"Objection_02_05_01_04\">住んでいた者</link>たち……。"

@char Meruru.Head1,ArmR8_1,ArmL8,Eyes1_Smile_Closed1,Mouth1_Smile_Closed1
@gosubModifyCamera 0
@printDebate "魔法を操る、<br><link=\"Objection_02_05_01_05\">上位の存在</link>なんです……。"

# ==============================================================================
# 10-1議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.17
@gosubModifyCamera 0
@Wait 0.2

@print （……まるで神話のような話だ。<br>　固有名詞ばかりで理解に労する部分もあるが……） { author:Hiro speed:1 waitInput:true Wait:true }

@print （これまで私が見聞きした情報と合わせれば、<br>　彼女が言っていることは真実だ） { author:Hiro speed:1 waitInput:true Wait:true }

@print （……一部を除けば、だが） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （突きつけてみよう。<br>　彼女の語る言葉と私の持つ情報の相違点を……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-1-1

