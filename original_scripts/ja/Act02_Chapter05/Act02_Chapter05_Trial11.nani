@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Leia
@char CreatureLeia.0-8 { Position:{leiaPositionX},{characterPositionY},{leiaPositionZ} Rotation:,{leiaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Noah
@char CreatureNoah.0-3 { Position:{noahPositionX},{characterPositionY},{noahPositionZ} Rotation:,{noahRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Margo
@char CreatureMargo.0-4 { Position:{margoPositionX},{characterPositionY},{margoPositionZ} Rotation:,{margoRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-11: 💬 彼女を救う方法
# ==============================================================================
# ＠ト書き▼議論10-11彼女を救う方法
# 議論開始カットイン
@bgm Bgm_7_1

# Judge10-11-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char CreatureHiro.6
@gosubModifyCamera 0
@printDebate 絶望して諦めてしまえば、<br>その瞬間<br>全ての可能性は潰える。

@char CreatureHiro.6
@gosubModifyCamera 0
@printDebate だが、<br>わずかな可能性であっても<br>それに向かって進む限り、<br>希望は潰えない……！

@char CreatureHiro.5
@gosubModifyCamera 0
@printDebate 諦めるのは、<br>すべてが無理であると<br>わかってからでも<br>遅くはない……。

@char CreatureHiro.7
@gosubModifyCamera 0
@printDebate それが【正しい道】だ！

@char Nanoka.ArmR6,ArmL10,Eyes1_Flushed_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate ……なら、<br>その具体的な方法を<br>教えてちょうだい。

@char Nanoka.ArmR6,ArmL10,Eyes1_Flushed_Open1,Mouth1_Angry_Closed2
@gosubModifyCamera 0
@printDebate あなたは魔女因子を<br>取り除くというけれど……。

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Flushed_Open1,Mouth1_Angry_Closed2
@gosubModifyCamera 0
@printDebate そんなこと、<br>本当にできるのかしら。

@char CreatureHiro.6
@gosubModifyCamera 0
@printDebate ……メルルの話では、<br>大魔女はその身を<br>魔女因子に変えた。

@char CreatureHiro.6
@gosubModifyCamera 0
@printDebate なら、<br>大魔女を再び<br>この世に顕現させれば<br>その構成要素だった魔女因子が<br>還元されるはずだ。

@char CreatureHiro.7
@gosubModifyCamera 0
@printDebate その結果、<br>君の姉が【なれはて】から<br>元に戻る可能性だってある……！

@char Nanoka.ArmR3,ArmL8,Eyes1_Normal_Closed1,Mouth1_Pensive_Closed1
@gosubModifyCamera 0
@printDebate 【魔女化させた少女を集めて、<br>大魔女を復活させる】……。

@char Nanoka.ArmR6,ArmL10,Eyes1_Normal_Open3,Mouth1_Pensive_Closed1
@gosubModifyCamera 0
@printDebate ……まるで邪教の儀式ね。

@char Nanoka.ArmR6,ArmL10,Eyes1_Normal_Open3,Mouth1_Smile_Open1
@gosubModifyCamera 0
@printDebate "……Ｂ級ホラーでも<br>見ないような、<br><link=\"Objection_02_05_11_01\">ありがち</link>なストーリーだわ。"

@char Nanoka.ArmR1,ArmL1,Eyes1_Normal_Open3,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate "あなたもその大魔女とやらに<br><link=\"Objection_02_05_11_02\">操られている</link>だけ<br>じゃないの？"

@char CreatureHiro.5
@gosubModifyCamera 0
@printDebate ……たしかに、<br>大魔女は<br>人類への復讐を<br>目論んでいる。

@char CreatureHiro.6
@gosubModifyCamera 0
@printDebate それでも、<br>私たちが救われるには<br>この道しかないんだ……！

@char Nanoka.ArmR1,ArmL10,Eyes1_Angry_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate "大魔女を復活させて、<br><link=\"Objection_02_05_11_03\">お願い</link>でもするのかしら？"

@char Nanoka.ArmR1,ArmL10,Eyes1_Pensive_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate あなたの示す道は……<br>タチの悪い幻覚だわ。


# ==============================================================================
# 10-11議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.17
@gosubModifyCamera 0
@Wait 0.2

@print （ナノカは疑り深い……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@print （だが彼女も、<br>　このままでは希望がないことに<br>　気付いているはずだ……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （……ナノカを説得する） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （そのための、正しい道……<br>　みんなが救われる方法を考えるんだ……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-11-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_11_01

@Skip false
@pauseTrial true

@choice だからこそ信憑性がある
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-11-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_11_02

@Skip false
@pauseTrial true

@choice 自分の意志だ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-11-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_11_03

@Skip false
@pauseTrial true

@choice 大魔女を倒す
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-11-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

# ==============================================================================
# MARK: 10-11: ❌ 議論ミス選択肢
# ==============================================================================
# MARK: 10-11-3: ❌ 反論・だからこそ信憑性がある

# Judge10-11-3

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial false { timer:false }
@Gosub System/System_Subroutine.EndDebate-Last

@char CreatureHiro.6
@gosubModifyCamera 0
@print だからこそ<br>信憑性があるんだ。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.6
@gosubModifyCamera 0
@print 語り継がれる物語には、原型がある……。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.5
@gosubModifyCamera 0
@print なら【ありがち】で広く親しまれる類型の物語の形は、<br>それだけ事実に沿っているということじゃないかな。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.5
@gosubModifyCamera 0
@print 試してみる価値はある。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open5,Mouth1_Smile_Open1
@gosubModifyCamera 0
@print ……仮に、儀式が成功したとして。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open5,Mouth1_Smile_Open1
@gosubModifyCamera 0
@print ありがちな展開が続くとしたら、<br>私たちは生贄にでもされて<br>死んでしまうんじゃないかしら。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open5,Mouth1_Smile_Open1
@gosubModifyCamera 0
@print ……希望と楽観は違うわ。 { author:Nanoka speed:1 waitInput:true Wait:true }

@Damage 

@char CreatureHiro.17
@gosubModifyCamera 0
@print （希望を示すことはできなかったか） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@gosubModifyCamera 0
@print （まずはナノカを説得し、<br>　心を開いてもらうんだ） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （そのために示す希望……<br>　それは彼女の目的とも合致する、あれしかない！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-11-1

# MARK: 10-11-4: ❌ 反論・自分の意志だ

# Judge10-11-4

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial false { timer:false }
@Gosub System/System_Subroutine.EndDebate-Last

@char CreatureHiro.18
@gosubModifyCamera 0
@print ……全て自分で決めたことだ。<br>みんなを救い出すために。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.18
@gosubModifyCamera 0
@print 操られているわけがない。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR2,ArmL9,Eyes1_Normal_Open2,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@print ……私たちには<br>大魔女の因子が宿っているんでしょう？ { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR2,ArmL9,Eyes1_Normal_Open4,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@print だとすれば……<br>どこまでが自分の意志か、なんて判断し切れないわ。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR2,ArmL9,Eyes1_Angry_Open1,Mouth1_Flushed_Closed1
@gosubModifyCamera 0
@print 大魔女が戯れに<br>私たちを泳がせているだけかもしれない。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR2,ArmL9,Eyes1_Angry_Open1,Mouth1_Flushed_Closed1
@gosubModifyCamera 0
@print あなたの意志を利用して<br>復活を企てている可能性もある。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR2,ArmL10,Eyes1_Angry_Open1,Mouth1_Flushed_Closed1
@gosubModifyCamera 0
@print あなたの正気は、<br>いったい誰が保証してくれるのかしらね。 { author:Nanoka speed:1 waitInput:true Wait:true }

@Damage 

@char CreatureHiro.17
@gosubModifyCamera 0
@print （……【我思う、ゆえに我あり】なんて言葉は、<br>　気休めにもならないか） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@gosubModifyCamera 0
@print （まずはナノカを説得し、<br>　心を開いてもらうんだ） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （そのために示す希望……<br>　それは彼女の目的とも合致する、あれしかない！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-11-1

# ==============================================================================
# MARK: 10-11-2: ⭕ 反論・大魔女を倒す
# ==============================================================================

# Judge10-11-2

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial false { timer:false }
@HideUI DebateUI
@ShowUI ControlPanel

@StopBgm 
@gosubCutIn CreatureHiro
@Gosub System/System_Subroutine.EndDebate-Last

# カットイン

# BGM変更：鐘楼の音
@bgm Bgm_39_2
@char CreatureHiro.2
@gosubModifyCamera 0
@print 大魔女は……私が倒す。 { author:Hiro speed:1 waitInput:true Wait:true }

# SE・気になる音
@sfx Sfx_Common_1

@char Nanoka.ArmR6,ArmL8,Eyes1_Confused_Open1,Mouth1_Cry_Closed1,Sweat1_1
@gosubModifyCamera 0
@print ……！ { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR6,ArmL8,Eyes1_Confused_Open1,Mouth1_Cry_Closed1,Sweat1_1
@gosubModifyCamera 0
@print 何を言うかと思えば……。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR1,ArmL3,Eyes1_Normal_Open4,Mouth1_Pensive_Closed1
@gosubModifyCamera 0
@print あなたの魔法は【死に戻り】<br>……だったわね。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR1,ArmL3,Eyes1_Normal_Open5,Mouth1_Normal_Open1
@gosubModifyCamera 0
@print それでどうやって大魔女を倒すというの？ { author:Nanoka speed:1 waitInput:true Wait:true }

@char CreatureHiro.1
@gosubModifyCamera 0
@print ……わからない。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@gosubModifyCamera 0
@print だが……知は力だ。<br>私は死を乗り越え、情報を集める事ができる……。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@gosubModifyCamera 0
@print 【本来知ることができない情報を得る】のは、<br>君の魔法と同じだ。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.9
@gosubModifyCamera 0
@print なら、君だってわかるだろう。<br>それが戦いにおいて、どれだけ有利なことかを。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR1,ArmL3,Eyes1_Uncomfortable_Open1,Mouth1_Flushed_Closed1
@gosubModifyCamera 0
@print …………。 { author:Nanoka speed:1 waitInput:true Wait:true }

@char CreatureHiro.8
@gosubModifyCamera 0
@print 私は必ず大魔女を倒す。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.9
@gosubModifyCamera 0
@print そして君の姉を救ってみせる。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.9
@gosubModifyCamera 0
@print 私は決して諦めない。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.7
@gosubModifyCamera 0
@print だから君も……私を信じて欲しい。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Nanoka.ArmR2,ArmL2,Eyes1_Uncomfortable_Open1,Mouth1_Flushed_Closed1
@gosubModifyCamera 0
@print …………。 { author:Nanoka speed:1 waitInput:true Wait:true }

# SE・気になる音
@sfx Sfx_Common_1

@StopBgm 

