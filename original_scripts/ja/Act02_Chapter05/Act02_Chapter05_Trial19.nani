# ＠ト書き▼議論10-19【佐伯ミリア】
# 議論開始カットイン
# BGM変更：HirO（Voなし）
@bgm Bgm_37_1_Loop
# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Cry_Open02,Angle01/Facial/Mouth>Mouth_Angry_Closed01 { time:0 }
@stageCamera 0 { Rotation:0,{ (6 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (5.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge10-19-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

# ＠備考◆年相応の少女っぽい演技に若干寄せたい
@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Cry_Open02,Angle01/Facial/Mouth>Mouth_Angry_Closed01
@gosubModifyCamera 0
@printDebate ちょっとだけ法律のこと<br>勉強したのも、<br>自分のこと<br>おじさんって呼ぶのも……。

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Cry_Open02,Angle01/Facial/Mouth>Mouth_Angry_Closed01
@gosubModifyCamera 0
@printDebate 全部【先生】を<br>真似してるだけなんだ……！

# ＠備考◆やや錯乱ぎみに

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Determined_Close
@gosubModifyCamera 0
@printDebate "元々の【私】には<br><link=\"Objection_02_05_19_01\">何もなく</link>て……！<br>いつも周りに合わせて<br>へらへら笑って、<br>やり過ごしているだけで……！"

@char Miria.Default,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Angry_Closed01
@gosubModifyCamera 0
@printDebate だからおじさんに<br>そんな難しいこと<br>聞かれたって……<br>わかんないよ！

@char Miria.Default,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Cry_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate なのにみんな、<br>みんな、<br>みんな……！

# ＠備考◆SNSイジメを思い出してる

@char Miria.Default,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Cry_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate 勝手に派閥とか<br>敵味方とか作って、<br>陰険で陰惨で陰湿で……！

@char Miria.Default,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Cry_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate "そんな<link=\"Objection_02_05_19_02\">悪趣味なこと</link>に<br>巻きこまないでよ！"

@char Miria.Default,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Cry_Open01,Angle01/Facial/Mouth>Mouth_Angry_Closed01
@gosubModifyCamera 0
@printDebate おじさんは……<br>どこにでもいる<br>ただの学生なんだよ……！？

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Determined_Close
@gosubModifyCamera 0
@printDebate "おじさんのことなんて、<br><link=\"Objection_02_05_19_03\">無視</link>してくれれば<br>いいのに……！"

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Cry_Open02,Angle01/Facial/Mouth>Mouth_Angry_Closed01
@gosubModifyCamera 0
@printDebate "なんで……<br><link=\"Objection_02_05_19_04\">放っといてくれない</link><br>のさ……！"


