@gosubResetBook System/System_ResetWitchBook
@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit

# 議論パート2章5話

@badId 10

# Judge10-1-0
@char Alisa.Angry1,Option-ArmL-Off
@char Margo.Default,ArmR6
@hide Hiro
@char CreatureHiro.17 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@stageCamera 0 { time:0 }
@stageCamera 1 { Rotation:-2,{ (7.7 / courtStandCount * 360) },-2 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:-1,{ (12.2 / courtStandCount * 360) } time:40 }
@back Transparent { time:0.9 }
@Wait 0.6

@ProcessInput true

# BGM変更：鐘楼の鐘
@bgm Bgm_39_2

@char CreatureHiro.17
@print （……魔女裁判の開始だ） { author:Hiro speed:1 waitInput:true Wait:true }

@print （黒幕であるメルルが殺されても、<br>　牢屋敷への監禁は終わらなかった。<br>　そして――） { author:Hiro speed:1 waitInput:true Wait:true }

# ==============================================================================
# ◎回想シーン（流用） ●シーン2‐3‐1
# ==============================================================================
# 配信フレームIN
@ResetText 
@bgm Bgm_39_2 { Volume:0.4 }
@back SolidColor.Custom { time:0 }
@back SolidColor.Custom { time:0.5 }
@Wait 0.5
@hideStageScreen 1
@printer Normal.Stream
@back 24_1 { Scale:{g_backgroundDefaultScale} time:0 }
@char Nanoka.ArmR2,ArmL3,Eyes1_Pensive_Open1,Mouth1_Angry_Open1 { time:0 }
@back SolidColor.Custom { time:0.5 }
@Wait 0.5
# ＠備考◆配信中
@print 私たちは本来、完全に魔女化する前に<br>国の管轄で殺処分されることが決まっていたの。 { author:Nanoka speed:1 waitInput:true Wait:true }

# ＠備考◆配信中

@char Nanoka.ArmR4,ArmL2
@print 皮肉なことに、<br>私たちは氷上メルルが大魔女を見つけたいという目的で、<br>かろうじて生かされていたのよ。 { author:Nanoka speed:1 waitInput:true Wait:true }

@ResetText 
@back SolidColor.Custom { time:0.5 }
@Wait 0.5
@hide MainBackground-Flashback,Nanoka-Flashback { time:0 }
@char CreatureHiro.17
@gosubModifyCamera 0
@printer Normal.Default
@back SolidColor.Custom { time:0.5 }
@Wait 0.5
@bgm Bgm_39_2
# ==============================================================================
# 回想ここまで
# ==============================================================================

@print （以前のナノカの話からすると、<br>　メルルのやり方で、<br>　大魔女にたどり着くこともない――） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@gosubModifyCamera 0
@print （よって私がメルルの代わりに、<br>　大魔女を呼び出す……！） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （それによって何が起こるか未知数な部分はある……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （だが全ての元凶である大魔女をどうにかすれば、<br>　私たち魔女候補の持つ魔女因子を<br>　取り除くことができるかもしれない） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （そうすれば私たちは魔女になることはなくなり、<br>　少女が監禁される理由はなくなる） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@gosubModifyCamera 0
@print （ここにいる彼女たちを救えるのは<br>　――私だけだ！） { author:Hiro speed:1 waitInput:true Wait:true }

# SE・気になる音
@sfx Sfx_Common_1

@char Coco.Default,ArmR10,ArmL8,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@print ……つーかこんなとこ集められてもさ。<br>あてぃしら何したらいいわけ？ { author:Coco speed:1 waitInput:true Wait:true }

# SE・軽い衝撃音
@sfx Sfx_Common_4

@char Leia.Default,ArmR10,ArmL3,Angle01/Facial/Eyes>Eyes_Angry_Open01,Angle01/Facial/Mouth>Mouth_Yell_Open02
@gosubModifyCamera 0
@print その通りだ！<br>私たちに何をさせるつもりだっ！ { author:Leia speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （……大魔女を呼び出す為には<br>　ここにいる全員の魔女化が必要だ） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （魔女化は過度のストレスをかけることで<br>　引き起こるもの……） { author:Hiro speed:1 waitInput:true Wait:true }

# SE・気になる音
@sfx Sfx_Common_1

@char CreatureHiro.2
@gosubModifyCamera 0
@print （しかし……<br>　多大なストレスをかけさせる為に、<br>　暴力に訴えたりしても反発を招くだけだろう） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （何か使えそうな情報はなかったか……<br>　思い出してみよう） { author:Hiro speed:1 waitInput:true Wait:true }

