@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-2: 💬 【氷上メルル】
# ==============================================================================
# ＠ト書き▼議論10-2氷上メルル
# 議論開始カットイン
# 気任せの蝶［チェロ有り］
@bgm Bgm_45_2

# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Meruru.Normal2,ArmR1_2,ArmL3,Eyes2_Angry_Open1,Mouth2_Angry_Closed1 { time:0 }
@stageCamera 0 { Rotation:0,{ (12 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (11.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5


# Judge10-2-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Meruru.Head1,ArmR5_1,ArmL8,Eyes1_Uncomfortable_Open1,Mouth1_Fearful_Open1
@gosubModifyCamera 0
@printDebate たしかに私は……<br>元々は人間でした……。

@char Meruru.Head1,ArmR3_1,ArmL3,Eyes1_Pensive_Open1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate でも私はこの島で暮らして、<br>大魔女様に<br>認められたんです……！

@char Meruru.Head1,ArmR5_1,ArmL8,Eyes1_Cry_Closed2,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 大魔女様は<br>そんな私の身を案じて、<br>自分で身を守れるように<br>魔法を与えて<br>くださったんです……。

# ＠備考◆喜び

@char Meruru.Head1,ArmR5_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Smile_Closed1
@gosubModifyCamera 0
@printDebate "そして私は魔女となって、<br><link=\"Objection_02_05_02_01\">大魔女様の家族</link>と<br>なりました！"

@char Meruru.Head1,ArmR8_1,ArmL8,Eyes1_Downcast_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate ……そのあと大魔女様は、<br>世界に呪いをバラまいたんです。

@char Meruru.Head1,ArmR1_1,ArmL1,Eyes1_Downcast_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate "人間たち同士で<br>永遠に争うように……<br>自身の魔女としての因子を<br><link=\"Objection_02_05_02_02\">植え付け</link>ました。"

@char Meruru.Head1,ArmR1_1,ArmL1,Eyes1_Cry_Closed2,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate とっても……可哀想です。<br>私も１人残されてしまって……<br>寂しかったです……。

@char Meruru.Normal1
@gosubModifyCamera 0
@printDebate でも大魔女様は<br>自身が消える直前に、<br>私に言い残しました……<br>【自身の存在を魔女因子に変える】<br>って……。

@char Meruru.Head1,ArmR1_1,ArmL1,Eyes1_Cry_Closed2,Mouth1_Angry_Open2
@gosubModifyCamera 0
@printDebate "だから私は……<br>大魔女様は魔女因子となって<br>人々の中に<br><link=\"Objection_02_05_02_03\">お隠れになった</link>……。<br>そう考え、<br>今も探し続けているんです。"

# ==============================================================================
# 10-2議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.17
@gosubModifyCamera 0
@Wait 0.2

@print （メルルの話は嘘をついているようには見えない） { author:Hiro speed:1 waitInput:true Wait:true }

@print （しかし……彼女が見聞きしたことが真実とは限らない） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （他のみんなが事の成り行きを静観している今のうちに……<br>　突きつけよう、真実を！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-2-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_02_01

@Skip false
@pauseTrial true

@choice 君は実験体だった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-2-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_02_02

@Skip false
@pauseTrial true

@choice 君もその犠牲者だ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-2-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_02_03

@Skip false
@pauseTrial true

@choice 大魔女は死んだ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-2-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

