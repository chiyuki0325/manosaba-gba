# ==============================================================================
# MARK: 10-17: 💬 【夏目アンアン】
# ==============================================================================
# ＠ト書き▼議論10-17【夏目アンアン】
# 議論開始カットイン
# BGM変更：HirO（Voなし）
@bgm Bgm_37_1_Loop
# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char AnAn.Fearful1,ArmR5,ArmL7,Angle01/Head/Facial/Sweat>Sweat01,Angle01/Option_Arms-,ArmR-Option-Off { time:0 }
@stageCamera 0 { Rotation:0,{ (11 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (10.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge10-17-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char AnAn.Default,ArmR2,ArmL3,Angle01/Head/Facial/Eyes>Eyes_Cry_Open02,Angle01/Head/Facial/Mouth>Mouth_Normal_Closed
@gosubModifyCamera 0
@printDebate わがはいは<br>静かに暮らしたいだけだ！

@char AnAn.Default,ArmR2,ArmL3,Angle01/Head/Facial/Eyes>Eyes_Cry_Open02,Angle01/Head/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate "大衆どもに<br><link=\"Objection_02_05_17_01\">理解</link>される必要も、<br>理解する必要もない！"

@char AnAn.Default,ArmR5,ArmL3,Angle01/Head/Facial/Eyes>Eyes_Cry_Open01,Angle01/Head/Facial/Mouth>Mouth_Cry_Closed
@gosubModifyCamera 0
@printDebate わがはいには<br>仲間も、<br>幸福も、<br>ぬくもりも……<br>何もいらない！

@char AnAn.Default,ArmR5,ArmL5,Angle01/Head/Facial/Eyes>Eyes_Cry_Open01,Angle01/Head/Facial/Mouth>Mouth_Cry_Closed
@gosubModifyCamera 0
@printDebate "そんなものに<link=\"Objection_02_05_17_02\">価値</link>はない！<br>求めていないんだ！"

@char AnAn.Default,ArmR5,ArmL5,Angle01/Head/Facial/Eyes>Eyes_Cry_Open01,Angle01/Head/Facial/Mouth>Mouth_Angry_Closed01
@gosubModifyCamera 0
@printDebate "わがはいが真に欲するは<br>深遠なる孤独と<link=\"Objection_02_05_17_03\">静寂</link>……！"

@char AnAn.Default,ArmR7,ArmL10,Angle01/Head/Facial/Eyes>Eyes_Cry_Open02,Angle01/Head/Facial/Mouth>Mouth_Fearful_Open
@gosubModifyCamera 0
@printDebate よって貴様に協力はしない！

@char AnAn.Default,ArmR7,ArmL10,Angle01/Head/Facial/Eyes>Eyes_Cry_Open02,Angle01/Head/Facial/Mouth>Mouth_Yell_Open
@gosubModifyCamera 0
@printDebate わがはいに干渉するな！

