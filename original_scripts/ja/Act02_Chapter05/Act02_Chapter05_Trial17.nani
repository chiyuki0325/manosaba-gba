#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@gosubModifyCamera 0
@Wait 0.2

@char CreatureHiro.2
@print （アンアンを魔女化させるためには、<br>　心の闇を暴かなくてはならない） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （だが彼女の発言……<br>　言葉通りに受け取っていいものか） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@print （人は触れられたくない傷を隠すものだ……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@print （彼女が偽証している言葉を暴くんだ！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-17-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_17_01

@Skip false
@pauseTrial true

@choice 理解を求めている
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-17-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_17_02

@Skip false
@pauseTrial true

@choice 価値はある
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-17-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_17_03

@Skip false
@pauseTrial true

@choice 快適な環境も必要
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-17-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

