@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Leia
@char CreatureLeia.0-8 { Position:{leiaPositionX},{characterPositionY},{leiaPositionZ} Rotation:,{leiaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Noah
@char CreatureNoah.0-3 { Position:{noahPositionX},{characterPositionY},{noahPositionZ} Rotation:,{noahRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Margo
@char CreatureMargo.0-4 { Position:{margoPositionX},{characterPositionY},{margoPositionZ} Rotation:,{margoRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Nanoka
@char CreatureNanoka.0-1 { Position:{nanokaPositionX},{characterPositionY},{nanokaPositionZ} Rotation:,{nanokaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Coco
@char CreatureCoco.2-3 { Position:{cocoPositionX},{characterPositionY},{cocoPositionZ} Rotation:,{cocoRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide AnAn
@char CreatureAnAn.0-3 { Position:{ananPositionX},{characterPositionY},{ananPositionZ} Rotation:,{ananRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Miria

@hide Alisa { time:0 }
@char CreatureAlisa.0-7 { Position:{alisaPositionX},{characterPositionY},{alisaPositionZ} Rotation:,{alisaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Hanna { time:0 }

@hide Sherry
@char CreatureSherry.1-6 { Position:{sherryPositionX},{characterPositionY},{sherryPositionZ} Rotation:,{sherryRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-27: 💬 ヒロの真実
# ==============================================================================
# ＠ト書き▼議論10-27ヒロの真実
# 議論開始カットイン
# BGM変更なし：HirO
@bgm Bgm_37_1_Loop

# Judge10-27-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open
@gosubModifyCamera 0
@printDebate ヒロちゃんとボクは……<br>幼馴染だった。

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Closed
@gosubModifyCamera 0
@printDebate それは中学に入ってからも<br>変わらなかった……。

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Closed
@gosubModifyCamera 0
@printDebate "いつも<link=\"Objection_02_05_27_01\">２人</link>で<br>一緒にいて……。"

@char Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open
@gosubModifyCamera 0
@printDebate "けど、<br>ヒロちゃんは<br>留学で<link=\"Objection_02_05_27_02\">いなく</link><br>なっちゃって……。"

@char Ema.Default,ArmR12,ArmL6,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open
@gosubModifyCamera 0
@printDebate ボクは１人きりになった。

@char Ema.Default,ArmR12,ArmL6,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Neutral_Closed
@gosubModifyCamera 0
@printDebate だから……<br>苦しかったんだ。

@char Ema.Default,ArmR12,ArmL6,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Closed
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_05_27_03\">辛かった</link>んだよ、<br>ヒロちゃん……。"


# ==============================================================================
# 10-27議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@gosubModifyCamera 0
@Wait 0.2

# 目を閉じている

@char CreatureHiro.2
@print （……………） { author:Hiro speed:1 waitInput:true Wait:true }

# 目を開く

@char CreatureHiro.2
@print （……断ち切ろう。<br>　この呪いを） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-27-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_27_01

@Skip false
@pauseTrial true

@choice ３人いた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-27-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_27_02

@Skip false
@pauseTrial true

@choice 私は戻ってきた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-27-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_27_03

@Skip false
@pauseTrial true

@choice すまなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-27-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

# ==============================================================================
# MARK: 10-27: ❌ ミス選択肢
# ==============================================================================
# MARK: 10-27-3: ❌ 反論・私は戻ってきた

# Judge10-27-3

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial false { timer:false }
@Gosub System/System_Subroutine.EndDebate-Last

@char CreatureHiro.12
@gosubModifyCamera 0
@print だが私は留学から帰ってきた。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.12
@gosubModifyCamera 0
@print ……君はそれを覚えていないのか。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open
@gosubModifyCamera 0
@print もちろん、覚えてるよ。 { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Flushed_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Neutral_Closed
@gosubModifyCamera 0
@print ……そのあと、ヒロちゃんはボクに冷たくなった……。 { author:Ema speed:1 waitInput:true Wait:true }

@char CreatureHiro.12
@gosubModifyCamera 0
@print ……そうだ。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.12
@gosubModifyCamera 0
@print （間違いはない） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-27-1

# MARK: 10-27-4: ❌ 同意・すまなかった

# Judge10-27-4

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial false { timer:false }
@Gosub System/System_Subroutine.EndDebate-Last

@char CreatureHiro.12
@gosubModifyCamera 0
@print 辛かったろうな、エマ。 { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.12
@gosubModifyCamera 0
@print すまなかった。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Closed
@gosubModifyCamera 0
@print ……ううん。 { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Closed
@gosubModifyCamera 0
@print こうしてわかってくれたなら……いいよ。 { author:Ema speed:1 waitInput:true Wait:true }

@char CreatureHiro.12
@gosubModifyCamera 0
@print （……謝る機会ができたのは、よかったな……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@gosubModifyCamera 0
@print （だが……真実は突きつけなくてはいけない） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-27-1
# ==============================================================================
