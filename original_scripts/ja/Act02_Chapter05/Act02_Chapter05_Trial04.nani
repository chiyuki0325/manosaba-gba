@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.23
@gosubModifyCamera 0
@Wait 0.2

@print （……建設的な議論をされると<br>　困る立ち場になってしまうとは） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （だが、優先すべきは彼女たちの魔女化だ） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （彼女の主張を否定して、<br>　議論の主導権を握らないと……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-4-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_04_01

@Skip false
@pauseTrial true

@choice 踏み台にしてきた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-4-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

