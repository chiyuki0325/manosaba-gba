@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-4: 💬 レイアの舞台
# ==============================================================================
# ＠ト書き▼議論10-4レイアの舞台
# 議論開始カットイン
# 気任せの蝶［チェロ有り］
@bgm Bgm_7_1

# Judge10-4-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char CreatureHiro.18
@gosubModifyCamera 0
@printDebate 君が他人を守る？<br>冗談だろう？

@char CreatureHiro.18
@gosubModifyCamera 0
@printDebate これまで自分を<br>世間にアピールすることに<br>執心してきた君が？

@char CreatureHiro.16
@gosubModifyCamera 0
@printDebate いったい君は<br>これまでその承認欲求で<br>何人のライバルを<br>蹴落としてきたのかな。

@char Leia.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "け、<link=\"Objection_02_05_04_01\">蹴落として</link>なんて<br>いない！"

@char CreatureHiro.16
@gosubModifyCamera 0
@printDebate 本当だろうか？<br>君は芸能人だし、<br>その立ち振る舞いを見ても<br>裕福な家で育ったのが<br>見てとれる……。

@char CreatureHiro.20
@gosubModifyCamera 0
@printDebate たとえ自身が<br>手を下していなかったとしても、<br>君に潰された人間は<br>多いんじゃないかな。

@char Leia.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate だ、だからって、<br>それとこれとは別問題だ！

@char Leia.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "だいたい……<br>それぐらいで諦めるなら、<br>その人物は<br><link=\"Objection_02_05_04_02\">それまでだった</link>と<br>いうことでもある……！"

@char Leia.Default,ArmR9,ArmL8,Angle01/Facial/Eyes>Eyes_Pensive_Closed,Angle01/Facial/Mouth>Mouth_Smile_Middle,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "私は<link=\"Objection_02_05_04_03\">正々堂々</link>と努力して、<br>舞台に立っていた！"

@char Leia.Default,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open02
@gosubModifyCamera 0
@printDebate 君が言っていることは<br>根も葉もない誹謗中傷だ！

@char Leia.Default,ArmR3,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate そんなことより……<br>建設的なことを<br>話し合うべきじゃないかな！

@char Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Fearful_Open
@gosubModifyCamera 0
@printDebate みんなでこれから<br>どうしたらいいのか……<br>この牢屋敷をどうやって<br>脱出するのか……！

@char Leia.Default,ArmR2,ArmL3,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate "希望はある！<br>みんな私に<br><link=\"Objection_02_05_04_04\">ついてきてくれ</link>たまえ！"


# ==============================================================================
# 10-4議論後独白
