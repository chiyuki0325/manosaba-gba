# ==============================================================================
# MARK: 10-26: 💬 エマの真実
# ==============================================================================
# ＠ト書き▼議論10-26エマの真実
# 議論開始カットイン

# BGM変更：HirO（Voなし）
@bgm Bgm_37_1_Loop

# Judge10-26-1

# 基本ダメージなし進行

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char CreatureHiro.2
@gosubModifyCamera 0
@printDebate ……君の過去を、<br>教えてくれ。

@char Ema.Default,ArmR6,ArmL6,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Neutral_Closed
@gosubModifyCamera 0
@printDebate うん……。

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open
@gosubModifyCamera 0
@printDebate ボクは……<br>学校でいじめられていた。

@char Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open
@gosubModifyCamera 0
@printDebate どうして<br>そんなことを<br>されていたのか……<br>どうして<br>嫌われていたのか……。

@char Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Closed
@gosubModifyCamera 0
@printDebate "そんなの……<br><link=\"Objection_02_05_26_01\">わからなかった</link>。"

@char Ema.Default,ArmR3,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Closed
@gosubModifyCamera 0
@printDebate だから……<br>思ったんだ。

@char Ema.Default,ArmR2-1,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open
@gosubModifyCamera 0
@printDebate "――みんな、<br><link=\"Objection_02_05_26_02\">死ねばいいのに</link>。"

@char Ema.Default,ArmR2-1,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Neutral_Closed
@gosubModifyCamera 0
@printDebate "みんなを……<br><link=\"Objection_02_05_26_03\">恨んでいた</link>。"


# ==============================================================================
# 10-26議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.12
@gosubModifyCamera 0
@Wait 0.2

@print （……エマ） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.12
@print （どうして……） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-26-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_26_01

@Skip false
@pauseTrial true

@choice 君は知っている
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-26-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_26_02

@Skip false
@pauseTrial true

@choice そんなことを思ってはいけない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-26-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

