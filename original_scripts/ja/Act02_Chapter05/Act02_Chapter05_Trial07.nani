@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Leia
@char CreatureLeia.0-8 { Position:{leiaPositionX},{characterPositionY},{leiaPositionZ} Rotation:,{leiaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-7: 💬 【城ケ崎ノア】
# ==============================================================================
# ＠ト書き▼議論10-7【城ケ崎ノア】
# 議論開始カットイン
# BGM変更：HirO（Voなし）

@bgm Bgm_37_1_Loop

# ボス演出
@ResetText 
@char CreatureHiro.2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Noah.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Angry_Open,Angle01/Facial/Sweat>Sweat01 { time:0 }
@stageCamera 0 { Rotation:0,{ (7 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (6.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge10-7-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate な、なんでのあが<br>絵を描かなきゃ<br>いけないの……！

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そんなの、<br>のあの勝手だよ……！

@char CreatureHiro.10
@gosubModifyCamera 0
@printDebate 君が絵を描くのが<br>好きだと言ったから、<br>私はそれを肯定しただけ<br>なんだけどな。

@char CreatureHiro.11
@gosubModifyCamera 0
@printDebate 君にとって、<br>絵を描くことは<br>苦痛なのかい？

@char Noah.Default,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open_1,Angle01/Facial/Mouth>Mouth_Cry_Closed,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そ、そんなことは……<br>ないけど……。

@char CreatureHiro.11
@gosubModifyCamera 0
@printDebate なら見せてくれても<br>いいじゃないか。

@char Noah.Default,ArmR6,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate だ、だめ……！<br>これは……<br>その……！

@char Noah.Default,ArmR6,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "だれにも……<br><link=\"Objection_02_05_07_01\">見せちゃダメ</link>だから……。"

@char Noah.Default,ArmR4,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "他の人に教えちゃダメって……<br><link=\"Objection_02_05_07_02\">約束</link>なの……！"

@char Noah.Default,ArmR6,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "だから、<br>ヒロちゃんには<br><link=\"Objection_02_05_07_03\">見せられない</link>のっ！"


# ==============================================================================
# 10-7議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.2
@gosubModifyCamera 0
@Wait 0.2

@print （ノアは嘘をついている） { author:Hiro speed:1 waitInput:true Wait:true }

@print （……だが、子どものつくような嘘だ。<br>　取り合う必要もない） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@print （取り繕われ、防御を整えられる前に……<br>　意識外からの一撃を食らわせるんだ！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-7-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_07_01

@Skip false
@pauseTrial true

@choice すでに見たことがある
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-7-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_05_07_02

@Skip false
@pauseTrial true

@choice そんな約束はない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-7-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_05_07_03

@Skip false
@pauseTrial true

@choice 見せたくないだけだ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-7-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

