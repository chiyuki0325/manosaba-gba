@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter05/Act02_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# クリーチャー化初期化
@hide Hiro
@char CreatureHiro.2 { Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Meruru
@char CreatureMeruru.3-5 { Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Leia
@char CreatureLeia.0-8 { Position:{leiaPositionX},{characterPositionY},{leiaPositionZ} Rotation:,{leiaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Noah
@char CreatureNoah.0-3 { Position:{noahPositionX},{characterPositionY},{noahPositionZ} Rotation:,{noahRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@hide Margo
@char CreatureMargo.0-4 { Position:{margoPositionX},{characterPositionY},{margoPositionZ} Rotation:,{margoRotationY} Scale:{characterScale},{characterScale},1 time:0 }

# ==============================================================================
# MARK: 10-10: 💬 ナノカの追求
# ==============================================================================
# ＠ト書き▼議論10-10ナノカの追求
# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge10-10-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open2,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate 単刀直入に聞くわ。

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open2,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate この事件の<br>【黒幕】である大魔女……<br>あなたに殺せるの？

@char CreatureHiro.5
@gosubModifyCamera 0
@printDebate ……私が持っているのは<br>死ぬ前に<br>見聞きした情報だけで、<br>全ての情報を<br>知っているわけではない。

@char CreatureHiro.6
@gosubModifyCamera 0
@printDebate だから確実な情報は……<br>ない。

@char Nanoka.ArmR1,ArmL10,Eyes1_Angry_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate ……論外ね。

@char Nanoka.ArmR1,ArmL10,Eyes1_Angry_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate "……なら、私はべつに<br>あなたに協力する<br><link=\"Objection_02_05_10_01\">理由</link>がないわ。"

@char Nanoka.ArmR2,ArmL1,Eyes1_Normal_Open3,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate あなたの邪魔をするつもりも<br>ないけれど……。

@char Nanoka.ArmR2,ArmL1,Eyes1_Normal_Open3,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate ……でも、<br>私の邪魔をするなら<br>容赦はしない。


# ==============================================================================
# 10-10議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.17
@gosubModifyCamera 0
@Wait 0.2

@print （ナノカは警戒心が強い） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.17
@print （まずは警戒を解かなくては、<br>　話すら聞いてもらえないか……） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-10-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_10_01

@Skip false
@pauseTrial true

@choice 家に帰れる
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-10-3

@choice みんなから魔女因子を取り除く
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-10-4

@choice 君の家族も救える
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-10-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

