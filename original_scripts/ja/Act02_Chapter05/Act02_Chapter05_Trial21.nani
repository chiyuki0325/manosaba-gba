#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char CreatureHiro.1
@gosubModifyCamera 0
@Wait 0.2

@print （私たちを巻き込んでの無理心中か……） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.2
@print （悪いがそれに付き合うことはできない） { author:Hiro speed:1 waitInput:true Wait:true }

@char CreatureHiro.3
@print （失うわけにはいかないんだ。<br>　私たちの命も……そして、君の命も！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge10-21-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_05_21_01

@Skip false
@pauseTrial true

@choice 誰も罪を犯していない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge10-21-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

