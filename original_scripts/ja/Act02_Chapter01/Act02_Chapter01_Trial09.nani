# 反論1
# ------------------------------------------------------------------------------

# Objection_02_01_09_01

@Skip false
@pauseTrial true

@choice メルルの靴を使った
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-9-3

@choice メルルの足跡の上を通った
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-9-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
