#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_01_03_01

@Skip false
@pauseTrial true

@choice 即死だった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-3-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

