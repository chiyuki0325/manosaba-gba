@ProcessInput true

# Judge6-1-0

# BGM変更：Kei-Plne Co-Jundic
@bgm Bgm_25_1

@char Leia.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01
@print それじゃあ始めようか。<br>メルルくんを殺した犯人……<br>魔女を決める裁判を！ { author:Leia speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@print （投票によって犯人が決められ、<br>　そして処刑される魔女裁判） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@print （……拘束されていた私にとってみれば、<br>　裁判など名ばかりで<br>　公平性なんてかけらもない……） { author:Hiro speed:1 waitInput:true Wait:true }

# SE・話の転換音
@sfx Sfx_Common_5

@ResetText 
@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Open { time:0 }
@stageCamera 0 { Rotation:0,{ (5 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 
@hideStageScreen 1
@stageCamera 0 { Rotation:0,{ (5.1 / courtStandCount * 360) },0 time:0.6 }
@Wait 0.2

@print つーか、何か話すことあるん？ { author:Coco speed:1 waitInput:true Wait:true }

@ResetText 
@char Miria.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Pensive_Closed { time:0 }
@stageCamera 1 { Rotation:0,{ (6 / courtStandCount * 360) },0 time:0 }
@showStageScreen 1
@WaitForNextFrame 
@stageCamera 1 { Rotation:0,{ (5.9 / courtStandCount * 360) },0 time:0.6 }
@Wait 0.2

@print ……というと。 { author:Miria speed:1 waitInput:true Wait:true }

