@gosubResetBook System/System_ResetWitchBook { IsDebugDirectJump:{isDebugDirectJump} }
@Gosub System/System_Subroutine.BeginAdv

@back Transparent { time:1.2 }

# Scene2-1-7

# ========================================
# ●シーン2‐1-7
# ========================================

# ========================================
# マップイベント用分岐
# ========================================

# ========================================
# 【ＭＡＰイベント】牢屋敷マップ
# 図書室＞シーン2‐1‐8
# 医務室＞シーン2‐1‐9
# 懲罰房＞シーン2‐1‐10
# 水精の間＞シーン2-1-11
# ？？？＞シーン2‐1‐12
# ※全てのＭＡＰイベントを選択したら終了。
# 選択済みの場所は消していってください。
# ========================================

@if "chosenAreaFlag == 31"
	@set "chosenAreaFlag = 0"
	@Gosub System/System_Subroutine.EndAdv
	@goto Act02_Chapter01/Act02_Chapter01_Adv18

@map Library,Infirmary,SolitaryConfinement,ChamberUndine,UnknownArea Library,Infirmary,SolitaryConfinement,ChamberUndine,UnknownArea

@if "chosenAreaId==\"Library\""
	@setFlag 0
	@Gosub System/System_Subroutine.EndAdv
	@goto Act02_Chapter01/Act02_Chapter01_Adv13

@if "chosenAreaId==\"Infirmary\""
	@setFlag 1
	@Gosub System/System_Subroutine.EndAdv
	@goto Act02_Chapter01/Act02_Chapter01_Adv14

@if "chosenAreaId==\"SolitaryConfinement\""
	@setFlag 2
	@Gosub System/System_Subroutine.EndAdv
	@goto Act02_Chapter01/Act02_Chapter01_Adv15

@if "chosenAreaId==\"ChamberUndine\""
	@setFlag 3
	@Gosub System/System_Subroutine.EndAdv
	@goto Act02_Chapter01/Act02_Chapter01_Adv16

@if "chosenAreaId==\"UnknownArea\""
	@setFlag 4
	@Gosub System/System_Subroutine.EndAdv
	@goto Act02_Chapter01/Act02_Chapter01_Adv17

@Stop
