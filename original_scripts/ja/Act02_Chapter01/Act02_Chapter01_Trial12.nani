@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter01/Act02_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 2100
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 6-12: 💬 ヒロの説得
# ==============================================================================
# ＠ト書き▼議論6-12 ヒロの説得
@set Skip6_12_3flag1=false
@set Skip6_12_4flag1=false
@set Skip6_12_5flag1=false

# BGM変更：Guil-me N'o sinruits-Vocal無-
@bgm Bgm_8_1

# ボス演出
@ResetText 
@char Hiro.Angry2,ArmR8,ArmL3,Eyes2_Angry_Open1,Mouth2_Smile_Open1 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open { time:0 }
@stageCamera 0 { Rotation:0,{ (9 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (8.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5


# Judge6-12-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Hiro.Normal2,ArmR6,ArmL6,Eyes2_Normal_Open3,Mouth2_Determined_Open1
@gosubModifyCamera 0
@printDebate マーゴは私に<br>罪をなすりつけるため、<br>多数の偽装工作を行った……<br>それは君たちにだってもう<br>十分にわかっているはずだ。

@char Hiro.Normal2,ArmR6,ArmL6,Eyes2_Normal_Open3,Mouth2_Determined_Open1
@gosubModifyCamera 0
@printDebate エマにかかってきた電話も、<br>私を陥れるための<br>陰謀だったんだ！

# IF 6-12-3未通過
@if Skip6_12_3flag1=true
	@goto .Judge_6-12-3_skip1

# @備考◆ルートA

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate "で、でも……本当に<br><link=\"Objection_02_01_12_01\">ボクと話した</link><br>メルルちゃんって<br>偽物のメルルちゃん<br>だったのかな……。<br>あの声……やっぱり<br>本物だったような……。"

@goto .Judge_6-12-3_skip2

# ELSE条件・6-7-3通過済み

# Judge_6-12-3_skip1
# ELSE 6-12-3通過済
# @備考◆ルートB

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate たしかにボクが話したのが<br>メルルちゃんだったっていう<br>証拠はない……！

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate ナノカちゃんや<br>レイアちゃんの証言とも<br>矛盾するし、<br>あれは偽物のメルルちゃんで<br>間違いないはずだよ！

# Judge_6-12-3_skip2

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open3,Mouth2_Surprised_Open1
@gosubModifyCamera 0
@printDebate 疑いのきっかけはレイアの聞いた<br>ガラスの割れた音だ。<br>死体発見の４０分前に<br>現場でした音……<br>それはメルルの<br>真の死亡時刻を<br>示していたんだよ。

# IF 6-12-4未通過
# @備考◆ルートA
@if Skip6_12_4flag1=true
	@goto .Judge_6-12-4_skip1

@char Leia.Default,ArmR5,ArmL7,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate "……しかし、あれは本当に<br>聞こえた音だったんだろうか。<br>私にしか聞こえなかった<br>かすかな音なんて……。<br>改めて考えると、<br>私の<link=\"Objection_02_01_12_02\">幻聴</link><br>だったんじゃ……。"

@goto .Judge_6-12-4_skip2

# ELSE 6-12-4通過済
# Judge_6-12-4_skip1
# @備考◆ルートB

@char Leia.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate ヒロくんの言う通りさ。<br>そのとき、<br>マーゴくんがメルルくんを<br>殺していた……<br>そうでなければ、<br>辻褄が合わない！

# ENDIF 分岐終了

# Judge_6-12-4_skip2

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Angry_Open1,Mouth2_Surprised_Open1
@gosubModifyCamera 0
@printDebate マーゴはさらに、<br>魔法でガラスの音を真似した。<br>……立体音響として<br>周囲に響かせ、<br>ナノカが音を聞いた方向を<br>誤認させるために。

# IF 6-12-5未通過
@if Skip6_12_5flag1=true
	@goto .Judge_6-12-5_skip1

# @備考◆ルートA
@char Nanoka.ArmR3,ArmL1,Eyes1_Uncomfortable_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate "……その可能性は<br>否定できないけれど、<br>でもわざわざ<br><link=\"Objection_02_01_12_03\">そんなことする意味</link>は<br>あるのかしら。"

@goto .Judge_6-12-5_skip2

# ELSE 6-12-5通過済
# Judge_6-12-5_skip1
# @備考◆ルートB

@char Nanoka.ArmR3,ArmL1,Eyes1_Uncomfortable_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate アリバイ作りのために<br>私を利用せざるを<br>得なかった……。<br>そういうことね。

# ENDIF 分岐終了

# Judge_6-12-5_skip2

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Angry_Open1,Mouth2_Surprised_Open1
@gosubModifyCamera 0
@printDebate ……こうして君は<br>メルルを殺したあと、<br>私に罪を<br>なすりつけようと<br>したんだ。

@char Hiro.Normal2,ArmR6,ArmL3,Eyes2_Angry_Open1,Mouth2_Surprised_Open1
@gosubModifyCamera 0
@printDebate 君が犯人だ……<br>宝生マーゴ！

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate ……ヒロちゃんの<br>言ってること、<br>本当かしらね？<br>ただの<br>言いがかりだと思うわ。

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate ヒロちゃんは<br>私を犯人だと決めつけて、<br>こんなに<br>糾弾しているけれど……。

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate これは、<br>魔女を見つけるための<br>魔女裁判なの。

# IF 6-12-3～5全通過
@if Skip6_12_3flag1=True&&Skip6_12_4flag1=True&&Skip6_12_5flag1=True
