@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter01/Act02_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 6-4: 💬 足跡について
# ==============================================================================
# ＠ト書き▼議論6-4 足跡について

# Judge6-4-1

# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Miria.Default,ArmR3,ArmL8,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate おじさんは<br>レイアちゃんに言われて、<br>現場に残された痕跡を<br>探してたんだよね。

@char Alisa.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01
@gosubModifyCamera 0
@printDebate たしかに<br>コキ使われてたな。

@char AnAn.Default,Angle01/Arms>Arms01,Angle01/Option_Arms>Option_Arms01_01,Angle01/Head/Facial/Eyes>Eyes_Pensive_Open,Angle01/Head/Facial/Mouth>Mouth_Normal_Closed
@gosubModifyCamera 0
@printDebate 『奴隷か？』

@char Leia.Smile1,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate 良い指示を与えた<br>まとめ役がいたと<br>いうことだね！

@char Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate それで、<br>調べた結果は<br>どうだったんだい？

@char Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02
@gosubModifyCamera 0
@printDebate "現場の床は<br>一面が白い塗料で<br>塗り尽くされていて……<br>そして、メルルちゃんと<br>ヒロちゃんの足跡以外は<br><link=\"Objection_02_01_04_01\">残されていなかった</link>んだ。"

@char Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02
@gosubModifyCamera 0
@printDebate "つまり部屋の中にいた<br>ヒロちゃん以外、<br>簡単に<br><link=\"Objection_02_01_04_02\">部屋に侵入</link>できた人は<br>いないんだよ。<br><link=\"Objection_02_01_04_03\">魔法</link>でも使ったわけじゃ<br>あるまいし……。"

@char Leia.Default,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate そう……<br>よってヒロくんこそが<br>この事件の<br>犯人だったと<br>いうことさ！


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,ArmR12,ArmL5,Eyes1_Normal_Closed1,Mouth1_Angry_Open1,Sweat1-1
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 6-4議論後独白
# ==============================================================================

@print （たしかに私が疑わしい状況だ） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Angry_Closed1,Sweat1-1
@print （しかし……真相はまだわからずとも、<br>　少なくとも１つ間違っている推理がある） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Angry_Closed1,Sweat1-1
@print （それを指摘して、議論を前に進めるとしよう） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge6-4-1
#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_01_04_01

@Skip false
@pauseTrial true

@choice 塗料は乾いていた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-4-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_01_04_02

@Skip false
@pauseTrial true

@choice 部屋の外で殺した
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-4-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

# Objection_02_01_04_03

@Skip false
@pauseTrial true

@choice 魔法なら侵入できた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-4-2

@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

