@goto .Judge6-10-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_01_10_01

@Skip false
@pauseTrial true

@choice 何をしていた？
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-10-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

