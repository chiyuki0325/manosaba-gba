@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter01/Act02_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 6-1: 💬 ヒロが犯人の理由
# ==============================================================================

# Judge6-1-1

# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Leia.Default,ArmR5,ArmL7,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate まずは<br>死体を発見した<br>状況について<br>確認してみようか。

@char Leia.Default,ArmR5,ArmL7,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate あの時、<br>私たちは奥の部屋で<br>話をしていてね。<br>そこには私を含めた<br>４人がいた。

@char Miria.Default,ArmR3,ArmL8,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate えと……<br>レイアちゃんと、<br>ココちゃんと、<br>ハンナちゃん……<br>それにおじさんの<br>４人だね。

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate そのとき、<br>私とナノカちゃんも<br>自分たちの部屋にいたわね。

@char Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate ……ええ、<br>間違いないわ。

@char Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 私たちは全員、<br>城ケ崎ノアと<br>夏目アンアンの<br>部屋の方から<br>ガラスが割れるような音を<br>聞いている……。

@char Margo.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate そうして駆けつけたら、<br>ヒロちゃんが倒れてたの♡

@char Hanna.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Open
@gosubModifyCamera 0
@printDebate こちらの部屋から見ても、<br>同じ状況ですわ……！

@char Hanna.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Smile_Open
@gosubModifyCamera 0
@printDebate "つまり、ヒロさんが<br>メルルさんを<br><link=\"Objection_02_01_01_01\">お殺しになって</link>、<br><link=\"Objection_02_01_01_02\">すぐに</link>私たちは<br>駆けつけたんですわ～～！"

@char Miria.Default,ArmR9,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02
@gosubModifyCamera 0
@printDebate "ヒロちゃんの他に<br>犯人がいたなら、<br>６人の<link=\"Objection_02_01_01_03\">誰かが見て</link>いそう<br>なんだけど……。"

@char Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate つまり<br>【ヒロくんしか<br>メルルくんを<br>殺せなかった】……。

@char Leia.Default,Arms,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate 状況はそれで正しいかな？

@char Leia.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate 私にはこれ以上<br>議論を続ける意味は<br>ないように見えるんだけど、<br>どうだろうか？


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,Arms3,Eyes1_Painful_Open1,Mouth1_Determined_Closed1
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 6-1議論後独白
# ==============================================================================

@print （……まったく馬鹿げた話だ。<br>　さっき自分たちが確認したことを忘れたのかな） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal2,ArmR6,ArmL4,Eyes2_Normal_Open3,Mouth2_Determined_Closed1
@print （あの言葉……<br>　さきほど言っていた内容と明確に矛盾している） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR6,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Closed1

@print （正しくない論理に正しくない話……<br>　正してみせよう、その全てを……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge6-1-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_01_01_01

@Skip false
@pauseTrial true

@choice メルルを殺していない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge6-1-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

