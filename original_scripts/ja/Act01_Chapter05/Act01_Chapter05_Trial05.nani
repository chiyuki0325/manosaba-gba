@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter05/Act01_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 5-5: 💬 エマの推理への反論
# ==============================================================================
# ＠ト書き▼議論5-5 エマの推理への反論
# BGM変更：AccUhEarts(Vocal無) 継続
@bgm Bgm_15_1

# Judge5-5-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Coco.Default,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Comical_Open,Angle01/Facial/Mouth>Mouth_Pensive_Middle,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ナノカの体を<br>小さく細切れにして、<br>覗き窓から入れたって……。

@char Coco.Default,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Comical_Open,Angle01/Facial/Mouth>Mouth_Angry_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そんな無茶、<br>通るかよ！

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Neutral_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "……それに、<br>そんなことしたら<br><link=\"Objection_01_05_05_01\">血</link>だって<br>残るんじゃないかしら？"

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate そ、それはそうだけど……！

@char Coco.Default,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ……か、仮に血を出さずに<br>切り刻めたとしても……。

@char Coco.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "ナノカの体には<br><link=\"Objection_01_05_05_02\">傷が残る</link>だろ！<br>ナノカの体は<br>無傷だったじゃん！"

@char Margo.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "それとも……<br>エマちゃんには<br>ナノカちゃんが<br><link=\"Objection_01_05_05_03\">傷を負わず</link><br>手足を外せた……<br>とでも言うのかしら？"


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 5-5議論後独白
# ==============================================================================

@print （ナノカちゃんが残した【傷】……。<br>　それは現場に残された銃弾とも矛盾している……） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@print （もしかして、ナノカちゃんが口の中を傷つけた理由……<br>　それって……ボクらに【傷】のことを<br>　伝えようとしたのだとしたら……？） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge5-5-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_05_05_01

@Skip false
@pauseTrial true

@choice 血は出なかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge5-5-5


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

