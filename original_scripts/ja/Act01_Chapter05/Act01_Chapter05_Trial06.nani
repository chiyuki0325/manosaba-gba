@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter05/Act01_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 5-6: 💬 メルルができない理由
# ==============================================================================

# Judge5-6-1

# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Meruru.Normal2
@gosubModifyCamera 0
@printDebate 私はそんな強い力は<br>持ってないので、<br>大きな傷を治すなんて<br>無理です……！

@char Meruru.Normal2,Eyes2_Cry_Closed3
@gosubModifyCamera 0
@printDebate それに、<br>死体の傷を治すなんて……！<br>そんなこと、<br>考えたことも<br>ありませんでした……。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ……そういえば<br>前にシェリーちゃんが<br>傷を負った時も<br>メルルちゃんは<br>治しきれてなかったわね。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 本当にメルルちゃんに<br>大きな傷を治す力が<br>あるのかしら？

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "つか、ナノカの体を<br>細切れにしたっていうけど……<br>それなら<link=\"Objection_01_05_06_01\">服</link>は<br>どうすんの？"

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate たしかにそれもそうね。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate エマちゃんの推理だと、<br>犯人はナノカちゃんを<br>撃ったことになる<br>みたいだけど……。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate "でもナノカちゃんの服に、<br>撃たれたような<link=\"Objection_01_05_06_02\">痕跡</link>は<br>残っていなかったわ？"

@char Coco.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate "エマっち、<br>それでもメルちゃんが<br><link=\"Objection_01_05_06_03\">ヤった</link>って<br>言ってんの？"

@char Meruru.Normal2,Eyes2_Uncomfortable_Open1
@gosubModifyCamera 0
@printDebate エマさんは<br>そう信じたいんで<br>しょうけど……。

@char Meruru.Normal2,Eyes2_Pensive_Open2,Mouth2_Surprised_Open2
@gosubModifyCamera 0
@printDebate "でも実際、<br>ナノカさんの傷が<br>治ったなんて<br><link=\"Objection_01_05_06_04\">証拠はありません</link><br>よね？"

@char Meruru.Normal2,Eyes2_Normal_Open2,Mouth2_Smile_Closed1
@gosubModifyCamera 0
@printDebate エマさん……。<br>私、あなたのこと……<br>信じてますから……！


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

