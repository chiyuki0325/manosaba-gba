@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter05/Act01_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 5-2: 💬 口の中の傷
# ==============================================================================
# ＠ト書き▼議論5-2 口の中の傷
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge5-2-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 正直、<br>こんな些細な傷が<br>重要とは<br>思えないんだけど……<br>エマちゃんの<br>気が済むまで<br>付き合ってあげるわ。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ナノカちゃんの<br>口の中の傷……<br>あれが重要だと言うなら、<br>あの傷はどうやって<br>つけられたのかしら？

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate たとえ口の中とは言え、<br>それを傷つけるような<br>刃物は<br>見つかっていないわ？<br>当然エマちゃんには<br>それが説明<br>できるのよね？

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate そ、それは……！

@char Meruru.Normal1,ArmR8_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate "もし何らかの<link=\"Objection_01_05_02_01\">凶器</link>が<br>あったのだとしたら、<br>犯人が<br>持ち帰ったので<br>しょうか……？"

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "身体検査でも<br>しましょうか？<br>そんなもの<br><link=\"Objection_01_05_02_02\">見つかってない</link>のだし。"

@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate "セキュリティーボックスの<br>斧とか、<br><link=\"Objection_01_05_02_03\">金庫の中の剣</link>なんかは<br>刃物だったけど、<br>あれは刃物部分が<br>デカ過ぎるから<br>関係ないよなぁ……。"

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate つまり<br>エマちゃんの推理は、<br>最初から<br>まったく成立していない<br>ということよ。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Determined2 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 5-2議論後独白
# ==============================================================================

@char Ema.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@print （ナノカちゃんの口の傷……<br>　まずはそれをつけた方法を探るんだ……！） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@print （些細な傷でも……<br>　そこからナノカちゃんの死の真相に<br>　たどり着いてみせる！） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Closed04,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@print （あの傷をつけられそうなもの……<br>　本当にどこにもなかったのかな……？） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge5-2-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_05_02_01

@Skip false
@pauseTrial true

@choice 犯人は爪を使った
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge5-2-3

@choice 犯人はナイフを持ち去った
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge5-2-5

@choice 犯人は拳銃を持ち去った
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge5-2-6


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_01_05_02_02

@Skip false
@pauseTrial true

@choice 見つかってない凶器が存在した
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge5-2-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
