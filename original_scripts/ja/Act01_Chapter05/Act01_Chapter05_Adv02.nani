@gosubResetBook System/System_ResetWitchBook { IsDebugDirectJump:{isDebugDirectJump} }
@Gosub System/System_Subroutine.BeginAdv

@back Transparent { time:1.2 }

# Scene1-5-2

# ========================================
# ●シーン1‐5-2
# ========================================

# ========================================
# マップイベント用分岐
# ========================================

# ========================================
# 【ＭＡＰイベント】牢屋敷マップ
# 殺人現場＞シーン1‐5‐3
# 秘密の地下施設＞1‐5‐4※ここで初めてマップが登場する
# ※全てのＭＡＰイベントを選択したら終了。
# 選択済みの場所は消していってください。
# ========================================

@if "chosenAreaFlag == 3"
	@set "chosenAreaFlag = 0"
	@Gosub System/System_Subroutine.EndAdv
	@goto Act01_Chapter05/Act01_Chapter05_Adv05

@map Courtroom,ChamberUndine Courtroom,ChamberUndine

@if "chosenAreaId==\"Courtroom\""
	@setFlag 0
	@Gosub System/System_Subroutine.EndAdv
	@goto Act01_Chapter05/Act01_Chapter05_Adv03

@if "chosenAreaId==\"ChamberUndine\""
	@setFlag 1
	@Gosub System/System_Subroutine.EndAdv
	@goto Act01_Chapter05/Act01_Chapter05_Adv04

@Stop
