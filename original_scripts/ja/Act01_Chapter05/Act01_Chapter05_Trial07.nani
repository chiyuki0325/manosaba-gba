@char Ema.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@print （……今はとにかく真実に向かって、<br>　前に進むんだ！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge5-7-1

