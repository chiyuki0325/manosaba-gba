@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter05/Act01_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 5-7: 💬 メルルの反論
# ==============================================================================
# ＠ト書き▼議論5-7 メルルの反論

# Judge5-7-1

# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Meruru.Angry2,Mouth2_Surprised_Open1
@gosubModifyCamera 0
@printDebate 私は何も<br>やっていません……！<br>エマさんの<br>突拍子もない推理……<br>もしかすると、<br>エマさんは誰かに<br>操られているのかも……！

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate そんなことないよ……！<br>ボクはひとつずつ<br>あったことを<br>検証して<br>積み重ねている<br>だけで……！

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Angry_Closed
@gosubModifyCamera 0
@printDebate ……でも、<br>たしかに<br>メルルちゃんの<br>言うことも<br>一理あると思うわ。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate 仮になんらかの方法で<br>ナノカちゃんが<br>地下施設の壁を<br>越えることができたり、<br>エマちゃんの情報が<br>真実だったとしても……。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate "直接メルルちゃんが<br>ナノカちゃんを<br>殺したと指し示す<br><link=\"Objection_01_05_07_01\">証拠</link>は……<br>ひとつもないんじゃ<br>ないかしら？"

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate "ナノカちゃんの口に<br>残されていた<link=\"Objection_01_05_07_02\">傷</link>も、<br><link=\"Objection_01_05_07_03\">銃弾</link>も、<br>メルルちゃんの<br><link=\"Objection_01_05_07_04\">犯行を示す証拠</link>とは<br>言い切れないと思うの。"

@char Coco.Default,ArmR1,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Middle
@gosubModifyCamera 0
@printDebate ……あてぃしは<br>エマっちの言う事も、<br>けっこう<br>説得力あると思う。

@char Meruru.Normal2,ArmR1_2,ArmL3,Eyes2_Surprised_Open1,Mouth2_Normal_Open1
@gosubModifyCamera 0
@printDebate そ、そんな……！<br>ココさんまで……！

@char Coco.Default,ArmR8,ArmL9,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Gross_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate いや……！<br>でも……！<br>完全に信じきれるか<br>っていうと……<br>エマっちの妄想って<br>考えた方が<br>しっくりくるっていうか……！

@char Coco.Default,ArmR8,ArmL9,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ……メルちゃんが<br>本当にそんなこと……<br>するのかなって……。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

@print （……ココちゃん、迷ってるみたいだ） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01
