@goto .Judge5-1-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_05_01_01

@Skip false
@pauseTrial true

@choice 傷はあった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge5-1-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

