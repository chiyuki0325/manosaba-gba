@char Ema.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@print （でもナノカちゃんは地下にいたはずだ……！<br>　地下では何か事件が起こったはず……！） { author:Ema speed:1 waitInput:true Wait:true }

