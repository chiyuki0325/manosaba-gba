@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter05/Act01_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 5-3: 💬 エマは嘘つきなのか
# ==============================================================================
# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

# Judge5-3-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "エマちゃんの証言は<br>成立しないわ。<br>処刑台には<br>侵入できる経路がない……<br>ある意味、<br>【<link=\"Objection_01_05_03_01\">密室</link>】だったの。"

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate "だから、<br>エマちゃんの<br>言ってることは<br>全部<link=\"Objection_01_05_03_02\">嘘</link>になるわね。"

@char Coco.Default,ArmR3,ArmL5,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate そもそもさっきから<br>エマっちが言ってる<br>違和感とかさぁ……。<br>死体にあった口の傷なんて<br>大した問題じゃ<br>ないっしょ？

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate ナノカも、<br>エマっちがアリサみたく<br>処刑台から地下に送って<br>凍死させたんじゃねーの。

@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "他に<link=\"Objection_01_05_03_03\">ツジツマ</link>が<br>あわないようなことも<br>ないんだし<br>やっぱエマっちが<br>犯人確定でよくない？"

@char Ema.Default,ArmR3,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate で、でも！<br>地下には<br>ナノカちゃんの銃が<br>あったし……！<br>ナノカちゃんは<br>あそこにいたはずだよ！

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "銃なんて<br><link=\"Objection_01_05_03_04\">殺したあとに置く</link><br>ことだって<br>できるじゃん？"

@char Coco.Default,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "……エマっちが<br><link=\"Objection_01_05_03_05\">見間違い</link>でもしてたなら<br>別だけどさ。"

@char Meruru.Normal2,ArmR1_2,ArmL3,Eyes2_Normal_Open1,Mouth2_Normal_Open1
@gosubModifyCamera 0
@printDebate エマさんが<br>嘘をつくなんて……<br>そんなこと……。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate どうかしらね？<br>罪を認めたくなくて<br>必死にも見えるわ。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ……ねぇ、エマちゃん。<br>この議論……<br>これ以上続ける必要は<br>あるのかしら。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

