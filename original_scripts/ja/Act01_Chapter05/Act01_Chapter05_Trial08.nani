@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter05/Act01_Chapter05_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 5-8: 💬 黒幕は誰か
# ==============================================================================

# Judge5-8-1

@bgm Bgm_15_1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Meruru.Normal1,ArmR5_1,ArmL4,Eyes1_Normal_Open2,Mouth1_Angry_Open2
@gosubModifyCamera 0
@printDebate "エマさん<br>信じてください……！<br>私にはナノカさんを<br><link=\"Objection_01_05_08_01\">殺す理由</link>は<br>ありません……！"

@char Meruru.Normal1,Eyes1_Pensive_Open2
@gosubModifyCamera 0
@printDebate "きっと……<br>エマさんの<br>勘違いです……！<br>私が<link=\"Objection_01_05_08_02\">犯人という証拠</link>は<br>ないですし……！"

@char Meruru.Normal1,Arms1_1,Eyes1_Normal_Open2,Mouth1_Smile_Closed1
@gosubModifyCamera 0
@printDebate "【<link=\"Objection_01_05_08_03\">黒幕</link>】なんて<br>いうのも……<br>ただの妄想かも……。"

@char Meruru.Normal1,ArmR4_1,ArmL4,Eyes1_Angry_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 私たちが仲間同士で<br>疑い合うなんて……<br>よくありません……！

@char Ema.Default,ArmR8,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate ……でもナノカちゃんを<br>殺した犯人は、<br>朝の時点で<br>地下にいたはずなんだ。

@char Ema.Default,ArmR8,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate だとしたら……<br>犯人は<br>この地下施設の<br>存在を<br>知っていた人物のはず。

@char Ema.Default,ArmR8,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate そしてその犯人は、<br>この牢屋敷を操ってきた<br>【黒幕】しかいないんだ！

@char Coco.Default,ArmR5,ArmL8,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate ……たしかに、<br>エマっちが犯人でも<br>メルちゃんが犯人でも<br>どっちかが<br>黒幕なんだろう<br>けどさ……。

@char Coco.Default,ArmR6,ArmL6,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Normal_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ……ねえ、<br>どっちが<br>黒幕だと思う……？<br>マーゴ……。

@char Margo.Default,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate さあ？<br>私もわからないわ。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ……でもどちらにせよ、<br>ナノカちゃんが<br>地下に行ったなら、<br>【魔法】を使った可能性が<br>高いと思うわね。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "ナノカちゃんの魔法は<br><link=\"Objection_01_05_08_04\">過去の幻視</link>……。<br>この地下施設で<br>発動すれば、<br>黒幕はすぐに<br>わかっちゃうもの。"

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate ……少なくとも、<br>犯人はそう思って<br>ナノカちゃんを<br>殺したんじゃないかしら？<br>真実を口外されないよう、<br>口封じしたのよ。

@char Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Comical_Closed,Angle01/Facial/Mouth>Mouth_Angry_Closed,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate うう……！<br>……どっちが殺したか<br>わかんないなら、<br>とりあえず<br>黒幕っぽい方を<br>処刑すればいんじゃね？

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "残念だけど……<br>そっちの方が<br>犯人を特定するより<br>難しいと思うわ。<br>【<link=\"Objection_01_05_08_05\">黒幕を示す証拠</link>】<br>なんてあったら<br>苦労しないもの。"

@char Coco.Default,ArmR7,ArmL6,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle
@gosubModifyCamera 0
@printDebate なあ……<br>黒幕ってさ、<br>【魔女】なんだよな？

@char Coco.Default,ArmR4,ArmL6,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Smile_Closed,Angle01/Facial/Sweat>Sweat01,Angle01/Facial/Pale>Pale01
@gosubModifyCamera 0
@printDebate "だったら……<br><link=\"Objection_01_05_08_06\">殺してみれば</link><br>わかるんじゃね？<br>殺して死なない方が<br>黒幕ってことだし……。"

@char Margo.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate ふふ……<br>【魔女裁判】らしいわね。

@char Margo.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate 私たちも<br>魔女化が進んできている<br>みたいね。<br>……そろそろ、<br>殺しても死なないかも<br>しれないわ。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

