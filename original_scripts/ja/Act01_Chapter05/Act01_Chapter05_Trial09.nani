# ＠ト書き▼議論5-9 メルルが黒幕の理由
@bgm Bgm_8_1
# ボス演出
@ResetText 
@char Meruru.Normal2,Eyes2_Fearful_Open1,Arms1_2,Mouth2_Angry_Closed1,Pale2_1 { time:0 }
@stageCamera 1 { Rotation:0,{ (12 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (11.9 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Ema.Default,ArmR3,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Closed { time:0 }
