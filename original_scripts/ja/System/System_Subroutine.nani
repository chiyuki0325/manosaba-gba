@Stop 

# ==============================================================================
# MARK: 📖 BeginAdv: ADV 開始
# ==============================================================================

# BeginAdv

@if isDebugDirectJump
	@set "hasWitchBook = true"

@set "isDebugDirectJump = false"
@ProcessInput true { set:Continue.true,Pause.true,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.true,ToggleUI.{allowToggleUI},ShowBacklog.true,Rollback.{allowRollback} }
@trialMode false
@ShowPrinter Normal
@ShowUI ControlPanel,AutoToggle

@if "hasWitchBook && !isReenact"
	@ShowUI WitchBookButtonUI

@back SolidColor { time:0 }
@WaitForNextFrame 

@if enableDebugSkip
	@Skip true

@Return 

# ==============================================================================
# MARK: 📖 EndAdv: ADV 終了
# ==============================================================================

# EndAdv

@ProcessInput true
@StopBgm 
@HideUI ControlPanel,AutoToggle,WitchBookButtonUI
@ResetText 
@back SolidColor { time:{g_fadeDurationAtScenarioTransition} }
@Wait "{g_fadeDurationAtScenarioTransition}"

@Return 

# ==============================================================================
# MARK: ⚖️ BeginTrial: 裁判開始
# ==============================================================================

# BeginTrial

@if isDebugDirectJump
	@set "hasWitchBook = true"

@set "isDebugDirectJump = false"
@ProcessInput false { set:Continue.true,Pause.true,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.true,ToggleUI.{allowToggleUI},ShowBacklog.true,Rollback.{allowRollback} }
@trialMode true
@ShowPrinter Normal
@ShowUI ControlPanel,AutoToggle,WitchBookButtonUI
@back SolidColor { time:0 }

@set "characterPositionY = stageOffsetY + 5"
@set "hiddenCharacterPositionY = characterPositionY - 100"
@set "characterScale = 0.25"
@set "characterDistance = 16"

@if "emaIdx >= 0"
	@set "emaPositionX = Sin(emaIdx * g_pi * 2 / {courtStandCount}) * characterDistance + stageOffsetX"
	@set "emaPositionZ = Cos(emaIdx * g_pi * 2 / {courtStandCount}) * characterDistance + stageOffsetZ"
	@set "emaRotationY = 360 / {courtStandCount} * emaIdx"
	@char Ema.Default { Position:{emaPositionX},{characterPositionY},{emaPositionZ} Rotation:,{emaRotationY} Scale:{characterScale},{characterScale},1 time:0 }

