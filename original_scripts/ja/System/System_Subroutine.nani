	@char Warden.1 { Position:{wardenPositionX},{characterPositionY},{wardenPositionZ} Rotation:,{wardenRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@if "jailerIdx >= 0"
	@set "jailerPositionX = Sin(jailerIdx * g_pi * 2 / {courtStandCount}) * characterDistance + stageOffsetX"
	@set "jailerPositionZ = Cos(jailerIdx * g_pi * 2 / {courtStandCount}) * characterDistance + stageOffsetZ"
	@set "jailerRotationY = 360 / {courtStandCount} * jailerIdx"
	@char Jailer.1 { Position:{jailerPositionX},{characterPositionY},{jailerPositionZ} Rotation:,{jailerRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@set "currentHp = maxHp"

@showStageScreen 0 { time:0 }
@showStageScreen 1 { time:0 }

@loadStage "{stageName}"

@WaitForNextFrame 

@if enableDebugSkip
	@Skip true

@Return 

# ==============================================================================
# MARK: ⚖️ EndTrial: 裁判終了
# ==============================================================================

# EndTrial

@ProcessInput true
@StopBgm 
@HideUI ControlPanel,AutoToggle,WitchBookButtonUI,DebateUI
@ResetText 
@back SolidColor { time:{g_fadeDurationAtScenarioTransition} }
@Wait "{g_fadeDurationAtScenarioTransition}"

@hideChars { time:0 }
@hideStageScreen 0 { time:0 }
@hideStageScreen 1 { time:0 }
@unloadStage 

@Return 

# ==============================================================================
# MARK: ⚖️ BeginDebate: 議論開始
# ==============================================================================

#
# MARK: BeginDebate-First: 議論開始処理・前半
# ------------------------------------------------------------------------------

# BeginDebate-First

@ResetText 
@HidePrinter 
@HideUI AutoToggle

@Return 

#
# MARK: BeginDebate-Effect: 議論開始エフェクト
# ------------------------------------------------------------------------------

# BeginDebate-Effect

@ProcessInput true
@HideUI WitchBookButtonUI
@spawn BeginDebateText
@despawn BeginDebateText

@Return 

#
# MARK: BeginDebate-Last: 議論開始処理・後半
# ------------------------------------------------------------------------------

# BeginDebate-Last

@Skip false
@ProcessInput true { set:Continue.{allowContinueDebate},Pause.false,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.false,ToggleUI.false,ShowBacklog.false,Rollback.{allowRollback} }
@ShowUI WitchBookButtonUI
@debate true

@Return 

# ==============================================================================
# MARK: ⚖️ EndDebate: 議論終了
# ==============================================================================

#
# MARK: EndDebate-First: 議論終了処理・前半
# ------------------------------------------------------------------------------

# EndDebate-First

@debate false
@ResetText Debate
@HidePrinter Debate

@Return 

#
# MARK: EndDebate-Effect: 議論終了エフェクト
# ------------------------------------------------------------------------------

# EndDebate-Effect

@ProcessInput true
@HideUI WitchBookButtonUI
@spawn EndDebateText
@despawn EndDebateText

@Return 

#
# MARK: EndDebate-CutIn: 議論終了・反論カットイン
# ------------------------------------------------------------------------------

# EndDebate-CutIn

@Skip false
@ProcessInput false
@HideUI WitchBookButtonUI

@if !enableDebugSkip
	@spawn "{objectionCutInSpawnPath}" { Params:{objectionCutInIndex} }
	@despawn "{objectionCutInSpawnPath}"

@Return 

#
# MARK: EndDebate-Last: 議論終了処理・後半
# ------------------------------------------------------------------------------

# EndDebate-Last

@Skip false
@ProcessInput true { set:Continue.true,Pause.true,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.true,ToggleUI.{allowToggleUI},ShowBacklog.true,Rollback.{allowRollback} }
@ShowUI AutoToggle,WitchBookButtonUI

@if enableDebugSkip
	@Skip true

@Return 

#
# MARK: AdditionalDebate-CutIn-2: 追加議論カットイン2
# ------------------------------------------------------------------------------

# AdditionalDebate-CutIn-2

@if !enableDebugSkip
	@Skip false
	@ProcessInput false
	@HideUI ControlPanel,AutoToggle,WitchBookButtonUI
	@spawn ObjectionCutIn_Ema
	@despawn ObjectionCutIn_Ema
	@ShowUI ControlPanel,AutoToggle,WitchBookButtonUI
	@ProcessInput true

@Return 

#
# タイムアップ
# ------------------------------------------------------------------------------

# TimeIsUp

@Skip false
@Gosub .EndDebate-First
@ProcessInput false
@StopBgm 
@clearChoice *
@HideUI ControlPanel,AutoToggle,WitchBookButtonUI,DebateUI
@spawn TimeIsUpText
@back SolidColor { time:0.9 }
@despawn TimeIsUpText

@goto "Common/CommonBad{commonBadEndId}"

