@stageCamera "{cameraIdx}" { Rotation:0,{cameraYaw},-5 time:0 }
@WaitForNextFrame 

@stageCamera "{cameraIdx}" { time:0.6 }
@splitStageScreen "{cameraIdx}"
@showStageScreen "{cameraIdx}"

@Return 

# 中央切断カットイン-Right
# SplitScreen-Right-Center

@set "cameraYaw = ({targetCharIdx} - 0.2) / {courtStandCount} * 360"
@stageCamera "{cameraIdx}" { Rotation:0,{cameraYaw},0 time:0 }
@WaitForNextFrame 

@stageCamera "{cameraIdx}" { time:0.6 }
@splitStageScreen "{cameraIdx}"
@showStageScreen "{cameraIdx}"

@Return
