# ==============================================================================
# MARK: 🎥 SplitScreen: ステージ画面分割
# SplitScreen-{Composition}-{Roll}
# ==============================================================================

# SplitScreen-Left-Right

@set "cameraYaw = ({targetCharIdx} + 0.25) / {courtStandCount} * 360"
@stageCamera "{cameraIdx}" { Rotation:-3,{cameraYaw},5 time:0 }
@WaitForNextFrame 

@stageCamera "{cameraIdx}" { time:0.6 }
@splitStageScreen "{cameraIdx}"
@showStageScreen "{cameraIdx}"

@Return 

# 左右反転Ver
# SplitScreen-Right-Left

@set "cameraYaw = ({targetCharIdx} - 0.25) / {courtStandCount} * 360"
@stageCamera "{cameraIdx}" { Rotation:-3,{cameraYaw},-5 time:0 }
@WaitForNextFrame 

@stageCamera "{cameraIdx}" { time:0.6 }
@splitStageScreen "{cameraIdx}"
@showStageScreen "{cameraIdx}"

@Return 

# 左カットイン
# SplitScreen-Left-Over

@set "cameraYaw = ({targetCharIdx} + 0.25) / {courtStandCount} * 360"
@stageCamera "{cameraIdx}" { Rotation:0,{cameraYaw},5 time:0 }
@WaitForNextFrame 

@stageCamera "{cameraIdx}" { time:0.6 }
@splitStageScreen "{cameraIdx}"
@showStageScreen "{cameraIdx}"

@Return 

# 右カットイン
