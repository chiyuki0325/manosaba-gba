	@set "yukiPositionZ = Cos(yukiIdx * g_pi * 2 / {courtStandCount}) * characterDistance + stageOffsetZ"
	@set "yukiRotationY = 360 / {courtStandCount} * yukiIdx"
	@char Yuki.2 { Position:{yukiPositionX},{characterPositionY},{yukiPositionZ} Rotation:,{yukiRotationY} Scale:{characterScale},{characterScale},1 time:0 }

@if "wardenIdx >= 0"
	@set "wardenPositionX = Sin(wardenIdx * g_pi * 2 / {courtStandCount}) * characterDistance + stageOffsetX"
