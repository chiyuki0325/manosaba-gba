@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter03/Act02_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 8-2: 💬 シェリーの推理
# ==============================================================================
# ＠ト書き▼議論シーン8-2 シェリーの推理
# 議論開始エフェクト
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge8-2-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Default,ArmR6,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "ミリアさんの<br><link=\"Objection_02_03_02_01\">撮った写真</link>には<br>２人の<link=\"Objection_02_03_02_02\">人影</link>が<br>写っています。"

@char Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate つまり現場には、<br>被害者である<br>アンアンさんに加えて<br>もう１人の人物が<br>存在したということ……。

@char Sherry.Default,ArmR10,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate ならば犯人しか<br>ありえません！

@char Sherry.Default,ArmR8,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 犯人はアンアンさんを<br>ベランダに誘い出し、<br>そして突き落としたんです！

@char Sherry.Default,ArmR13,ArmL8,Angle01/Facial/Eyes>Eyes_Surprised_Open03,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate "これは<br><link=\"Objection_02_03_02_03\">明確な殺人事件</link><br>ですよ！"

@char Sherry.Default,ArmR6,ArmL8,Angle01/Facial/Eyes>Eyes_Surprised_Open03,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate ……そう<br>言いたかったんですよね！<br>ミリアさん！

@char Miria.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate い、いや……<br>そこまで断定するわけじゃ<br>ないけど……！

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal2,Arms3,Mouth2_Determined_Closed1
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 8-2議論後独白
# ==============================================================================

@print （シェリーの推理は細部は間違っているが<br>　おおむね正しい……） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Pensive_Closed1
@print （しかし……<br>　全てが事実であるわけでもない） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Normal_Open3,Mouth1_Angry_Closed1
@print （ならばそこに、推理を打ち崩す鍵がある） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Determined_Closed1
@print （議論の着地点を考えて、誘導してみようか） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge8-2-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_03_02_01

@Skip false
@pauseTrial true

@choice 写真が加工されていた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge8-2-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_03_02_02

@Skip false
@pauseTrial true

@choice 別の影だった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge8-2-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_03_02_03

@Skip false
@pauseTrial true

@choice 事故だった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge8-2-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

