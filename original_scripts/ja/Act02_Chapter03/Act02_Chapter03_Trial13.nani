@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter03/Act02_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 8-13: 💬 ノアの告発
# ==============================================================================
# ＠ト書き▼議論シーン8-13 ノアの告発
# 議論開始エフェクト
# BGM変更：Guil-me N'o sinruits-Vocal有-
@bgm Bgm_8_1
# ボス演出
@ResetText 
@char Hiro.Normal2,ArmR6,ArmL3,Eyes2_Angry_Open2,Mouth2_Determined_Open2 { time:0 }
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Noah.Default,ArmR1,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Smile_Open02 { time:0 }
@stageCamera 0 { Rotation:0,{ (7 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (6.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge8-13-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open_1,Angle01/Facial/Mouth>Mouth_Confused_Open
@gosubModifyCamera 0
@printDebate "のあね、<br>図書室から出たときに<br>エマちゃんと<br>ヒロちゃんを<link=\"Objection_02_03_13_01\">見た</link>んだ。"

@char Noah.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Surprised_Open02,Angle01/Facial/Pale>Pale01
@gosubModifyCamera 0
@printDebate "ヒロちゃんがアンアンちゃんを<br>突き落としてるところ、<br><link=\"Objection_02_03_13_02\">ちょうど見ちゃった</link>の。"

@char Noah.Pensive1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open_1,Angle01/Facial/Mouth>Mouth_Surprised_Open01
@gosubModifyCamera 0
@printDebate でものあ、<br>怖くなって<br>逃げだしちゃった……。

@char Noah.Cry1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Confused_Open
@gosubModifyCamera 0
@printDebate こんなこと言ったら、<br>のあも殺されちゃうと<br>思ったから……<br>それからずっと<br>黙ってたんだ。

@char Ema.Default,ArmR7,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate で、でもノアちゃん！

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate 現場には<br>アンアンちゃんが<br>自作自演をしようとしてた<br>痕跡が残ってたんだ……！

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate ヒロちゃんが<br>アンアンちゃんを<br>殺していないのは、<br>客観的な事実だよ……！

@char Noah.Angry1,ArmR5,ArmL2
@gosubModifyCamera 0
@printDebate "そんなの、<br><link=\"Objection_02_03_13_03\">ヒロちゃんとエマちゃんが</link><br>あとから偽の証拠を作って<br>でっちあげたんじゃ<br>ないかな？"

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open02
@gosubModifyCamera 0
@printDebate "アンアンちゃんを<br>殺したあとで<br>中庭に細工をして、<br>そのあと<br><link=\"Objection_02_03_13_04\">偶然雨が降った</link>なら<br>成り立つよね？"

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate "エマちゃんとヒロちゃんは、<br><link=\"Objection_02_03_13_05\">共犯関係</link>なんだよ……。"

@char Noah.Default,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01
@gosubModifyCamera 0
@printDebate "だからのあに<br>殺人の罪を<link=\"Objection_02_03_13_06\">押し付けて</link>、<br>処刑しちゃおうと<br>してるんだね。"

# ＠備考◆冷たく

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
