@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter03/Act02_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 8-5: 💬 狙った場所に落とす方法
# ==============================================================================
# ＠ト書き▼議論シーン8-5 狙った場所に落とす方法
# 議論開始エフェクト
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge8-5-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Default,ArmR1,ArmL3,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 当然ですが、<br>スマホは液晶画面が光ります。<br>それにこの機種は<br>ライト機能もあります。

@char Sherry.Default,ArmR17,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 犯人はあらかじめ、<br>現場に光らせたスマホを<br>置いておいたんですよ。

@char Sherry.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Normal_Closed
@gosubModifyCamera 0
@printDebate 現場は犯行当時<br>暗かった……。

@char Sherry.Default,ArmR3,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "それなら、<br>スマホのほのかな光であっても<br><link=\"Objection_02_03_05_01\">目印</link>として<br>わかりやすかった<br>はずです！"

@char Sherry.Default,ArmR13,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "そこに目掛けて突き落とせば、<br>グッサリ串刺しにして<br><link=\"Objection_02_03_05_02\">殺せます</link>よね！"

@char Miria.Default,ArmR3,ArmL8,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "たしかに<br><link=\"Objection_02_03_05_03\">スマホぐらいの光</link><br>だったら、<br>おじさんも見逃してて<br>おかしくないかも……。"

@char Sherry.Default,ArmR11,ArmL10,Angle01/Facial/Eyes>Eyes_Smile_Closed02,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate どうですか、<br>この推理は！

@char Sherry.Default,ArmR13,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate このトリックを使えば、<br>アンアンさんを<br>鉄柵で殺害するのは<br>簡単なはずです！


# ==============================================================================
# 8-5議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Closed1
@gosubModifyCamera 0
@Wait 0.2

@print （シェリーは他殺だと信じている） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@print （しかし運が良いのか悪いのか、<br>　今の推理には説明しきれない矛盾が残っているな） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR4,ArmL2,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@print （その隙……利用させてもらおう） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge8-5-1
#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_03_05_01

@Skip false
@pauseTrial true

@choice 他に光があった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge8-5-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_03_05_02

@Skip false
@pauseTrial true

@choice 他殺ではなく自殺だった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge8-5-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_03_05_03

@Skip false
@pauseTrial true

@choice スマホの光は目立つ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge8-5-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

