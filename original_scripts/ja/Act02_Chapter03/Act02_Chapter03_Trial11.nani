@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter03/Act02_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 8-11: 💬 のあじゃないよ？
# ==============================================================================
# ＠ト書き▼議論シーン8-11 のあじゃないよ？
# 議論開始エフェクト
# BGM変更：Guil-me N'o sinruits-Vocal無-
@bgm Bgm_37_1_Loop

# Judge8-11-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate のあはそんなこと<br>してないよ？

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate のあが魔法で<br>できること、<br>お絵描きすること<br>ぐらいだもん。

@char Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_03_11_01\">お絵描きでもない</link>のに<br>魔法を使うなんて……<br>そんなことできるわけないよ。"

@char Hanna.Surprised1,ArmR3,ArmL1
@gosubModifyCamera 0
@printDebate た、たしかにノアさんが<br>絵を描く以外で<br>魔法を使っているのは<br>見たこと<br>ありませんわ……！

@char Noah.Default,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate それにのあ、<br>あのときずっと<br>図書室にいたしね。

@char Noah.Default,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate 中庭になんて<br>行ってないよ？

@char Ema.Pensive1,ArmR4,ArmL5
@gosubModifyCamera 0
@printDebate ……でもノアちゃん、<br>さっき雨が降ったのを<br>【見た】って言ってたよね。

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@gosubModifyCamera 0
@printDebate ボクも雨が<br>降っているのは見たけど、<br>雨が降ってるのを見たのは<br>中庭だ。

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@gosubModifyCamera 0
@printDebate 外にいたアリサちゃんは<br>雨なんて降ってなかったって<br>言ってる。

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@gosubModifyCamera 0
@printDebate 図書室にいたなら、<br>雨が降ったのを<br>どこから見たのかな。

@char Noah.Default,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate "そういえば、<br>あのときは<br>【見た】んじゃなくて<br><link=\"Objection_02_03_11_02\">【聞いた】</link>だけ<br>だったかな？"

@char Noah.Default,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_03_11_03\">本を読んでた</link>から、<br>静かで聞こえてきたんだと<br>思うよ。"


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

