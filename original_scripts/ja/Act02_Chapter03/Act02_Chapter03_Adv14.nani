@animate Hanna-Front
@Wait 0.4

@print 事情があったのなら、<br>きちんと話してほしいですわ！ { author:Hanna speed:1 waitInput:true Wait:true }

@animate MainBackground-Front,Hanna-Front
@hide Hanna-Front
@WaitForNextFrame 

@HidePrinter 
@spawn MaskingRectangle
@back 14_1
