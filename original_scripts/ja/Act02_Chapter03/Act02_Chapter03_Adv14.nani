@print おい、黙ってたらなんもわかんねーだろうが！ { author:Alisa speed:1 waitInput:true Wait:true }

@animate MainBackground-Front,Alisa-Front
@hide Alisa-Front
@WaitForNextFrame 

@HidePrinter 
@spawn MaskingRectangle
@back 14_1
@char Hanna
@mask MainBackground-Front,Hanna-Front
