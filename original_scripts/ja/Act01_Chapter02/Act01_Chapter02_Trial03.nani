# ADVシーン
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1,ArmR3,ArmL1
@gosubModifyCamera 0
@Wait 0.2

@print （運営が犯人……？<br>　たしかにボクたちの中に<br>　犯人がいないとは信じたいけど……！） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed

@print （そのためにも、ナノカちゃんの推理が<br>　間違ってないか検証してみよう……！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge2-3-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_02_03_01

@Skip false
@pauseTrial true

@choice 自殺だった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge2-3-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

