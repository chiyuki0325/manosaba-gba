@ResetText 
@char Ema.Pensive1,ArmR4,ArmL5
@gosubModifyCamera 0
@Wait 0.2

@print （ナノカちゃんが嘘を言っているようには見えないけど……） { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
