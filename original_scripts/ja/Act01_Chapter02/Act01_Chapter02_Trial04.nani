# 反論1
# ------------------------------------------------------------------------------

# Objection_01_02_04_01

@Skip false
@pauseTrial true

@choice ミリアはそこにいなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge2-4-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

