@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter02/Act01_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# 冒頭非表示処理
@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 4: 💬 ナノカの見たこと
# ==============================================================================
# ＠ト書き▼議論2-4 ナノカの見たこと
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge2-4-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Flushed_Open1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate ……私がこの鍵を<br>手に入れたのは、<br>懲罰房の中よ。

@char Nanoka.Eyes1_Uncomfortable_Open1
@gosubModifyCamera 0
@printDebate 私が今日<br>懲罰房に行ったのは<br>【２０時過ぎ】……。

@char Nanoka.Eyes1_Normal_Open4
@gosubModifyCamera 0
@printDebate 遠野ハンナたちが<br>去ったのを確認して、<br>入れ違いで<br>懲罰房へと入ったわ。

@char Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open
@gosubModifyCamera 0
@printDebate わたくしたちの事、<br>見てたんですの……！？

@char Nanoka.Eyes1_Uncomfortable_Open1
@gosubModifyCamera 0
@printDebate ええ。<br>何やら騒がしかったのも<br>あってね。

@char Nanoka.Eyes1_Normal_Open2
@gosubModifyCamera 0
@printDebate 私が懲罰房の扉を開けた時、<br>鍵はかかっていなかったわ。

@char Nanoka.Eyes1_Neutral_Open1
@gosubModifyCamera 0
@printDebate そうして私が<br>部屋に入ると……<br>すでに佐伯ミリアは<br>血まみれの死体に<br>なっていた。

@char Sherry.Default,ArmR2,ArmL2,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate じゃあナノカさんは<br>【２１時】に発見する<br>よりも前に死体を<br>発見していたって<br>事ですね！

@char Nanoka.Normal1,ArmR1,ArmL10,Eyes1_Normal_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate そういうことね。<br>私は中に入って、<br>血まみれの佐伯ミリアの<br>脈をとって<br>死亡を確認したわ。

@char Nanoka.Normal1,ArmR2,ArmL9,Eyes1_Normal_Open3,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate この【鍵】が<br>懲罰房の床に落ちているのを<br>見つけたのもその時。<br>扉の錠前に入れてみたら、<br>鍵をかけることができた……。

@char Meruru.Surprised,ArmR8_1,ArmL8,Eyes1_Pensive_Open2,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate じゃあ部屋に<br>鍵をかけたのは……。

@char Nanoka.Normal1,Eyes1_Normal_Open2,Mouth1_Surprised_Open1,ArmR2,
@gosubModifyCamera 0
@printDebate 私よ。

@char Alisa.Surprised1
@gosubModifyCamera 0
@printDebate なんでそんなこと……！

@char Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Normal_Closed1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate 鍵を持っているのは<br>ゴクチョーや看守<br>……運営のはず。<br>だったら私たちの中に<br>犯人はいない。

@char Nanoka.Normal1,ArmR1,ArmL10,Eyes1_Normal_Open1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate だから、<br>わかりやすくしただけよ。<br>私たちが<br>一致団結できるようにね。

@char Coco.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate ただの嘘つきじゃん！<br>……今のも<br>口から出任せかも<br>しんないし！

@char Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Uncomfortable_Open1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate ……どちらにせよ、<br>私が本当の<br>第一発見者な時点で<br>一番の容疑者である事は<br>免れないでしょうね。

@char Nanoka.Eyes1_Angry_Open1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "けど私が見たとき<br>すでに<br><link=\"Objection_01_02_04_01\">佐伯ミリア</link>は<br>死んでいた。<br>そして<br><link=\"Objection_01_02_04_02\">落ちていた鍵をかけた</link>の。<br>……<link=\"Objection_01_02_04_03\">何かおかしい</link>かしら？"

@char Coco.Angry1,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate 大ありだっての！<br>コイツ！<br>その、あの……！

# ＠備考◆罵倒しようと思ったけど感情的になってすぐ出てこなかった
@char Coco.Angry1,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Comical_Closed,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate ……嘘つき！！

# ＠備考◆申し訳なさそうに
@char Nanoka.Eyes1_Uncomfortable_Open1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate ……甘んじて<br>受け入れるわ。<br>ごめんなさい。


