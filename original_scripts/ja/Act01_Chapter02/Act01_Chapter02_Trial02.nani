@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter02/Act01_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# 冒頭非表示処理
@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 2: 💬 死体状況について
# ==============================================================================
# ＠ト書き▼議論2-2 死体状況について
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge2-2-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Normal1,ArmR3,ArmL12
@gosubModifyCamera 0
@printDebate あらためて、<br>被害者は佐伯ミリアさんです。<br>鍵のかかった懲罰房の中、<br>磔にされた状態で<br>発見されましたね。

@char Meruru.Default,ArmR8_1,ArmL8,Eyes1_Downcast_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate ミリアさんの遺体には、<br>複数の刺し傷が<br>ありました……。

# ＠備考◆後半、詰まるような震え声で
@char Meruru.Cry,ArmR8_1,ArmL8,Eyes1_Cry_Closed1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 少し調べてみましたが……<br>何度刺されたか<br>わからないぐらい<br>ぐちゃぐちゃで……。

@char Sherry.Smile1,ArmR3,ArmL12,Angle01/Facial/Eyes>Eyes_Smile_Closed02,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate メルルさんには<br>検死を手伝ってもらいました！<br>ご協力、感謝ですね！

@char Alisa.Fearful1,Option-ArmL-Off,ArmR7,ArmL6,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Sweat>Sweat02
@gosubModifyCamera 0
@printDebate ……笑って言う事じゃ<br>ねーだろ。

@char Sherry.Normal1,ArmR3,ArmL12,ArmR2,ArmL5,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "とにかく犯人は<br><link=\"Objection_01_02_02_01\">懲罰房</link>で拘束された<br><link=\"Objection_01_02_02_02\">ミリアさん</link>の<br><link=\"Objection_01_02_02_03\">お腹を滅多刺しにして殺害した</link><br>ということですね～！"

@char Margo.Normal1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open
@gosubModifyCamera 0
@printDebate ではその凶器は<br>なんだったのかしら？

@char Sherry.Normal1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open03
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_02_02_04\">胸に刺さっていたナイフ</link><br>ですね。<br>おそらく<br><link=\"Objection_01_02_02_05\">懲罰房の備品</link>でしょう！"

@char Margo.Normal1,ArmR2,ArmL5,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ……切れ味の鋭い刃物は、<br>切られた事にも<br>気付かないと言うわ。

@char Margo.Normal1,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate 逆に言えば、<br>今回みたいな<br>ボロボロの刃物を<br>使えば……。

@char Sherry.Smile1,ArmR3,ArmL12,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 痛みを与えられて、<br>効率的に拷問ができる……<br>というわけですね！

@char Margo.Smile1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate そういうこと♡

@char Alisa.Angry1,ArmR4,ArmL6,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate んな悪趣味な考察は<br>どうでもいいんだよ……！

