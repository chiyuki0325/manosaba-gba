@print "湖畔には、アリサが<ruby=\"たたず\">佇</ruby>んでいた。" { speed:1 waitInput:true Wait:true }

@char Ema.Normal1,ArmR3

@print アリサちゃん！<br>ちょうど良かった、探してたんだ！ { author:Ema speed:1 waitInput:true Wait:true }

