@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter02/Act01_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# 冒頭非表示処理
@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 1: 💬 死体発見の経緯
# ==============================================================================
# ＠ト書き▼議論2-1 死体発見の経緯
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge2-1-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Normal1,ArmR15,ArmL1
@gosubModifyCamera 0
@printDebate 事件の現場は<br>懲罰房ですね！<br>最初に発見したのは<br>誰でしょう？

@char Hanna.Normal1
@gosubModifyCamera 0
@printDebate 死体を発見したのは、<br>わたくしとココさんですわ！<br>【２１時】頃だったと<br>思いますわ！

@char Coco.Pensive1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate ……ちょっと<br>気になる事があって、<br>懲罰房に行ったんだよ。<br>そしたら途中で<br>お嬢と出会って……。

@char Alisa.Normal1,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate ……気になる事って<br>なんだよ？

# ＠備考◆ミリアの安否を気にしてた。慌てる様子で
@char Coco.Surprised1,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate それはその……。

@char Hanna.Normal1,ArmR2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Open
@gosubModifyCamera 0
@printDebate ラウンジに……<br>怪しい張り紙が<br>あったんですわ！

@char Hanna.Pensive1,ArmR2,ArmL2
@gosubModifyCamera 0
@printDebate それには<br>【懲罰房で拷問が行われる】……<br>みたいな事が書いてあって……！

@char Hanna.Angry1
@gosubModifyCamera 0
@printDebate きっとココさんも、<br>それが気になって<br>しまったんですわ！

@char Alisa.Pensive1,ArmR2,ArmL2
@gosubModifyCamera 0
@printDebate そんな悪趣味なもん<br>見に行ったのか……？

@char Coco.Surprised1,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ……べ、べつに<br>あてぃしが何しようが<br>勝手だろ……。

@char Hanna.Angry1,ArmR2,ArmL2
@gosubModifyCamera 0
@printDebate いくらミリアさんが<br>みんなの邪魔を<br>した人だからって、<br>拷問だなんて<br>許せませんわ！

@char Hanna.Normal1,ArmR2,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Open
@gosubModifyCamera 0
@printDebate "それでわたくし達は<br><link=\"Objection_01_02_01_01\">メモに書かれていた通り</link>、<br>懲罰房に行ったんですわ！"

@char Hanna.Angry1,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open01
@gosubModifyCamera 0
@printDebate "ココさんとはそのとき<br><link=\"Objection_01_02_01_02\">偶然</link>出会っただけで……！<br><link=\"Objection_01_02_01_03\">何もやましい事</link>は<br>ありませんわ～！"

@char Sherry.Normal1,ArmR1,ArmR6,ArmL4,Angle01/Facial/Eyes>Eyes_Wink_Open01
@gosubModifyCamera 0
@printDebate 死体の<br>第一発見者ですか……<br>怪しいですね！

@char Hanna.Surprised1,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open
@gosubModifyCamera 0
@printDebate 言いがかりですわー！？

@char Hanna.Normal1,ArmR2,ArmL2,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open
@gosubModifyCamera 0
@printDebate ともかくその後……<br>ココさんが懲罰房の扉の<br>覗き窓から中を<br>覗いたんですわ！

@char Coco.Fearful1,ArmR10,ArmL5,Angle01/Facial/Mouth>Mouth_Pensive_Middle,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "そしたら……<br>アイツが<br><link=\"Objection_01_02_01_04\">死んでた</link>んだよ！<br><link=\"Objection_01_02_01_05\">拘束</link>されて、<br>血まみれで……！"

@char Coco.Pensive1,ArmR10,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle
@gosubModifyCamera 0
@printDebate "……そのとき中には、<br><link=\"Objection_01_02_01_06\">誰もいなかった</link>。"

@char Sherry.Normal1
@gosubModifyCamera 0
@printDebate そうして<br>私とエマさんが<br>呼ばれたんですね！

@char Hanna.Surprised1
@gosubModifyCamera 0
@printDebate 緊急事態だと<br>思いましたし、<br>急いでみんなを<br>呼びに行ったんですわ～！

@char Sherry.Normal1,ArmR1,ArmL2
@gosubModifyCamera 0
@printDebate それで私が<br>駆けつけて……。

@char Sherry.Normal1,ArmR15,ArmL8,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 鍵がかかってたので<br>壊しちゃいましたね！<br>バコーン☆

@char Coco.Pensive1
@gosubModifyCamera 0
@printDebate ……怪力ゴリラ女……。

@char Sherry.Angry1,ArmR3,ArmL4
@gosubModifyCamera 0
@printDebate 役に立った時ぐらい<br>素直に褒めてくれたって<br>いいじゃないですか～！<br>ぷんぷんっ！

