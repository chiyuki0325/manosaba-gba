#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@gosubModifyCamera 0
