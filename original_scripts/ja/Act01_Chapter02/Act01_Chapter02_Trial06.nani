@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter02/Act01_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# 冒頭非表示処理
@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 6: 💬 マーゴの容疑
# ==============================================================================
# ＠ト書き▼議論2-6 マーゴの容疑3
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge2-6-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Default,ArmR13,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate ハンナさんたちが<br>聞いた声は勘違い……<br>つまり犯人は、<br>宝生マーゴさん！<br>あなたなんです！

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate なるほど、<br>それで？<br>どうして私<br>なのかしら？

@char Sherry.Default,ArmR17,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate あなたは<br>佐伯ミリアさんを殺した後、<br>そのまま部屋に<br>残っていたんです。

@char Sherry.Default,ArmR17,ArmL4,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate しかしまずいことに、<br>犯行直後に<br>ハンナさんとアンアンさんが<br>懲罰房に<br>やってきてしまった……。

@char Sherry.Default,ArmR13,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open01
@gosubModifyCamera 0
@printDebate 慌てたあなたは、<br>【魔法】を使ったんです！<br>あなたの魔法は――。

@char Margo.Default,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate ――【モノマネ】。<br>人の声色を<br>真似る事しかできない、<br>ロクな使い道のない<br>取るに足らない魔法よ。

# ＠備考◆マーゴが声真似をしている
# ＠佐伯ミリア
@char Margo.Default,ArmR6,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate それでおじさんの声を<br>真似したってわけだね！<br>『きゃああああ！』<br>……ってさ！

@char Alisa.Default,ArmR4,ArmL7,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate こいつ……！<br>死んだヤツ相手だからって<br>好き勝手しやがって……！

@char Margo.Default,ArmR6,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate あら、死んでいるからこそ<br>意味があるとも言えるわ？<br>……もう二度と<br>聞けない声なんだから。

@char Sherry.Default,ArmR3,ArmL4
@gosubModifyCamera 0
@printDebate とにかく……<br>他者の声色を扱えるの<br>はマーゴさんだけです。

@char Sherry.Default,ArmR13,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "他の人は、<br><link=\"Objection_01_02_06_01\">声真似</link>なんて<br>できません！<br>つまり<link=\"Objection_01_02_06_02\">マーゴ</link>さんが<br>犯人なんです！"

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate あら。<br>それなら<br>反論するけれど……。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 犯行現場には、<br>犯人が隠れる場所は<br>なかったんじゃ<br>ないかしら？

@char Sherry.Default,ArmR3,ArmL4
@gosubModifyCamera 0
@printDebate それはもちろん、<br>私たちがまだ<br>見つけていない方法が<br>あるんですよ！

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "それはどんな方法かしら？<br><link=\"Objection_01_02_06_03\">隠れられる場所</link>？<br>それとも<br><link=\"Objection_01_02_06_04\">テレポート</link>や、<br><link=\"Objection_01_02_06_05\">何かのトリック</link>を<br>使ったのかしら？"

@char Sherry.Default,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Flushed_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate それは今<br>考え中です！

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate ふふ、<br>面白い発想ね。

@char Margo.Smile1,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open
@gosubModifyCamera 0
@printDebate じゃあ反論してあげて？<br>エマちゃん。

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@gosubModifyCamera 0
@printDebate …………。

@char Ema.Default,ArmR4,ArmL3,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate えっ！？<br>ボク！？


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Surprised1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@Wait 0.2

