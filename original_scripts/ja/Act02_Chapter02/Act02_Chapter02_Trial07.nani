@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter02/Act02_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 7-7: 💬 ハンナの犯行
# ==============================================================================
# ＠ト書き▼議論シーン7-7 ハンナの犯行
# 議論開始エフェクト
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge7-7-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Default,ArmR17,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate ハンナさんは焼却炉で<br>ココさんを撃ち殺したあと、<br>死体を運び出したんです！

@char Sherry.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Closed04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "運良く<link=\"Objection_02_02_07_01\">誰にも見つからず</link><br>玄関から出たハンナさんは、<br>死体を担いで<br>中庭の上に<br>浮かんでいた……。"

@char Sherry.Default,ArmR4,ArmL5,Angle01/Facial/Eyes>Eyes_Surprised_Open01,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate "そしてヒロさんが<br>中庭の前を通りかかった<br>タイミングを見計らって、<br><link=\"Objection_02_02_07_02\">ドスン</link>！"

@char Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate エマさんが通る直前、<br>空からココさんの死体を<br>落下させました！

@char Sherry.Default,ArmR15,ArmL4,Angle01/Facial/Eyes>Eyes_Wink_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate そうして一瞬で<br>現れた死体を、<br>エマさんが<br>発見したんです！

@char Sherry.Default,ArmR8,ArmL8,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate そのあとはまた<br>玄関から戻って、<br>何食わぬ顔で<br>合流したんですよ。

@char Hanna.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate ま、待ちやがりなさいませ！

@char Hanna.Angry1
@gosubModifyCamera 0
@printDebate "それは……<br>なんか無理じゃ<br>ありませんこと！？<br>わたくしには<br><link=\"Objection_02_02_07_03\">絶対無理</link>ですわ～！"

# ＠備考◆煽るように

@char Sherry.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate え～？<br>そうですかね～？

@char Sherry.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Closed03,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "ハンナさんがずっと<br><link=\"Objection_02_02_07_05\">中庭の空</link>で死体を持って<br>待っていたのだとしたら、<br>全然<link=\"Objection_02_02_07_04\">成立する</link>と<br>思いますけどね！"

@char Hanna.Angry1,ArmR2,ArmL2,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate 濡れ衣ですわー！<br>きっと<br>こいつが犯人ですわー！


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

