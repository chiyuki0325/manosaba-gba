@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter02/Act02_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 7-4: 💬 エマが殺した方法
# ==============================================================================
# ＠ト書き▼議論シーン7-4 エマが殺した方法
# 議論開始エフェクト
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge7-4-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Determined_Open2
@gosubModifyCamera 0
@printDebate エマはシャワールームで<br>ココを射殺したあと、<br>それをダストシュートから<br>落としたんだ。

@char Hiro.Normal1,Arms3,Eyes1_Angry_Open2,Mouth1_Determined_Open1
@gosubModifyCamera 0
@printDebate それなら<br>私が駆けつけたときに<br>死体を発見できなかったことも<br>説明できるよ。

# カットイン

@char Ema.Default,ArmR3,ArmL4,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate それは成立しないよ<br>ヒロちゃん。

@char Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate だってココちゃんの死体は<br>中庭で見つかってるんだ。

@char Ema.Default,ArmR7,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate 焼却炉に死体を捨てたなら、<br>中庭で見つかるなんて<br>おかしいよ！

# ヒロカットイン

@char Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Determined_Open1
@gosubModifyCamera 0
@printDebate ロープを繋いでおいたなら<br>一時的に隠すことは可能だ。

@char Hiro.Normal1,ArmR2,ArmL4,Eyes1_Normal_Open3,Mouth1_Determined_Open1
@gosubModifyCamera 0
@printDebate 私をやり過ごしたあと、<br>エマはココの死体を<br>ロープで引き上げた……。

@char Hiro.Normal1,Arms3,Eyes1_Normal_Open3,Mouth1_Determined_Open1
@gosubModifyCamera 0
@printDebate そして中庭に死体を置いて、<br>発見したフリをしたんだ。

@char Hiro.Normal1,ArmR1,ArmL3,Eyes1_Angry_Open2,Mouth1_Determined_Open1
@gosubModifyCamera 0
@printDebate 直前に中庭の前を通った私を、<br>犯人に仕立て上げるためにね。

# エマカットイン

@char Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate ならヒロちゃんは<br>ボクがシャワールームで<br>殺したっていうの？

@char Ema.Default,,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Middle
@gosubModifyCamera 0
@printDebate "でもそんな<link=\"Objection_02_02_04_01\">痕跡</link><br>どこにもなかったよね。"

@char Ema.Determined2,ArmR7,ArmL7,Angle01/Head02/Facial02/Mouth02>Mouth02_Angry_Open
@gosubModifyCamera 0
@printDebate "それともヒロちゃんは<br>ボクが<link=\"Objection_02_02_04_02\">別の場所</link>で<br>ココちゃんを殺して<br>死体だけ<br><link=\"Objection_02_02_04_03\">持ってきた</link>とでも<br>言うのかな。"

# ヒロカットイン

@char Hiro.Normal1,ArmR4,ArmL2,Eyes1_Normal_Open5,Mouth1_Determined_Open1
@gosubModifyCamera 0
@printDebate 場所は<br>シャワールームだからね。<br>痕跡を洗い流すことぐらい<br>簡単なことだよ。

# エマカットイン

@char Ema.Default,ArmR7,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open
@gosubModifyCamera 0
@printDebate "だとしても<br>【<link=\"Objection_02_02_04_04\">痕跡を消した痕跡</link>】が<br>残るんじゃないかな。"

@char Ema.Determined2,ArmR7,ArmL7,Angle01/Head02/Facial02/Mouth02>Mouth02_Angry_Open
@gosubModifyCamera 0
@printDebate ヒロちゃんの反論は、<br>不十分だよ！


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

