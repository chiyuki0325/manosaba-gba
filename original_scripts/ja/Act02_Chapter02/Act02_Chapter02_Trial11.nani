@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter02/Act02_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 1800
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 7-11: 💬 ナノカの証明
# ==============================================================================
# ＠ト書き▼議論シーン7-11 ナノカの証明

# フラグ初期化
@set Skip7_11_5flag1=false
@set Skip7_11_6flag1=false

# 議論開始エフェクト
# BGM変更：Guil-me N'o sinruits-Vocal無-
@bgm Bgm_8_1
@ResetText 
@char Nanoka.ArmR5,ArmL1,Eyes1_Angry_Closed1,Mouth1_Angry_Closed2 { time:0 }
@stageCamera 1 { Rotation:0,{ (10 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (9.9 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Hiro.Normal2,ArmR6,ArmL3,Eyes2_Angry_Open2,Mouth2_Determined_Open2 { time:0 }
@stageCamera 0 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge7-11-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Nanoka.Normal1,Mouth1_Normal_Open1,ArmL5,Angle01/ArmR-,
@gosubModifyCamera 0
@printDebate 沢渡ココの死亡推定時刻……<br>つまりあの騒ぎの５分ほど前。

@char Nanoka.Normal1,Eyes1_Normal_Closed1
@gosubModifyCamera 0
@printDebate "私はそのとき<br><link=\"Objection_02_02_11_01\">ラウンジにいた</link>わ。"

@char Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open2,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "そこには<br>蓮見レイアと夏目アンアンが<br><link=\"Objection_02_02_11_02\">いた</link>の。"

@char Nanoka.ArmR1,ArmL10,Eyes1_Normal_Closed1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate "夏目アンアンと蓮見レイアは<br><link=\"Objection_02_02_11_03\">話に熱中していた</link>……<br>だから私に<br>気付かなかったのだと思う。"

# IF 未通過 なし
@if Skip7_11_5flag1=false
	@goto .Judge7-11-2

# ELSE 通過済み・追加

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open5,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate ふたりは城ケ崎ノアの<br>絵についての話をしていた。<br>【シャワールームに<br>描かれた絵に<br>神秘性を感じる】<br>……そう言っていたわ。

@char Leia.Default,ArmR5,ArmL7,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open
@gosubModifyCamera 0
@printDebate "一言一句間違いない。<br>たしかにナノカくんは<br><link=\"Objection_02_02_11_04\">そこにいた</link>みたいだね。"

# Judge7-11-2

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open5,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate そのあと私は医務室にいたの。

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Neutral_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate "沢渡ココの死体が<br>発見されたあと、<br><link=\"Objection_02_02_11_05\">騒ぎになった</link>のには<br>気付いていたけど……。"

@char Nanoka.Normal1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate "そこから<link=\"Objection_02_02_11_06\">少し遅れて</link><br>合流したわ。"

# IF 7-11-6未通過 なし
@if Skip7_11_6flag1=false
	@goto .Judge7-11-3

# ELSE

@char Nanoka.Normal1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "……その間、<br>医務室で使えるものがないか<br>調べていたの。<br><link=\"Objection_02_02_11_07\">静かなものだった</link>わね。"

# Judge7-11-3

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open4,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate べつに……<br>何もおかしなことは<br>ないでしょう？


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 7-11議論後独白
# ==============================================================================

@print （エマが犯人であれば、おかしなところはない） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@print （しかし……） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Closed1
@print （……なんにせよ、これ以上は証拠が見つかる可能性は低い） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@print （……仮にナノカが犯人の場合、<br>　能動的に【失言を引き出す】のも<br>　視野に入れなくてはいけないか） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge7-11-1

