@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter02/Act02_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 7-12: 💬 ミリアの弁護
# ==============================================================================
# ＠ト書き▼議論シーン7-12 ミリアの弁護
# 議論開始エフェクト
# BGM変更：HirO
@bgm Bgm_8_1
# ボス演出
@ResetText 
@char Nanoka.Default,ArmR4,ArmL2,Eyes1_Pensive_Open1,Mouth1_Flushed_Closed1 { time:0 }
@stageCamera 1 { Rotation:0,{ (10 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (10 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1

@ResetText 
@char Hiro.Normal2,ArmR6,ArmL3,Eyes2_Angry_Open2,Mouth2_Determined_Open2 { time:0 }
@stageCamera 0 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (7.9 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1

@ResetText 
@char Miria.Fearful1,ArmR5,ArmL5,Angle01/Facial/Mouth>Mouth_Angry_Closed01 { time:0 }
@stageCamera 1 { Rotation:0,{ (6 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (6.1 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1
@hideStageScreen 1

# Judge7-12-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Miria.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Normal_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ヒロちゃんは<br>シャワールームが<br>防音だって<br>言ってたけど……。

@char Miria.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そんなことないんじゃ<br>ないかな……！？

@char Miria.Default,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Surprised_Open02
@gosubModifyCamera 0
@printDebate "だってエマちゃんは<br>シャワールームの中で<br><link=\"Objection_02_02_12_01\">銃声</link>を聞いたんだよね？"

@char Miria.Default,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Surprised_Open02
@gosubModifyCamera 0
@printDebate "それじゃ、<br><link=\"Objection_02_02_12_02\">全然防音じゃない</link>よ……！"

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2
@gosubModifyCamera 0
@printDebate ……銃が撃たれた場所を<br>考えれば<br>その答えは明白だ。

@char Hiro.Normal2,ArmR3,ArmL4,Eyes2_Normal_Closed1,Mouth2_Angry_Open1
@gosubModifyCamera 0
@printDebate ココは焼却炉で殺された……。

@char Hiro.Normal2,Eyes2_Angry_Open2,Mouth2_Determined_Open2,ArmL3,ArmR6
@gosubModifyCamera 0
@printDebate つまり、<br>ダストシュートを通じて<br>音はシャワールームまで<br>反響していたんだ。

@char Miria.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Glare_Open04,Angle01/Facial/Mouth>Mouth_Angry_Closed01,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate そ、そんな……！

@char Miria.Default,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Surprised_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate で、でも……<br>ナノカちゃんは<br>レイアちゃんや<br>アンアンちゃんの言葉も<br>言い当ててたよね！？

@char Miria.Default,ArmR4,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Smile_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_02_12_03\">実際に聞いてる</link>んだから、<br>事件が起こったとき<br>ナノカちゃんは<br>ラウンジにいたんじゃ<br>ないかな！？"

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Cry_Open02,Angle01/Facial/Mouth>Mouth_Determined_Close,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate 正直ナノカちゃんが<br>犯人なのかどうかは<br>おじさんには<br>わからないけど……。

@char Miria.Default,ArmR10,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Surprised_Open02,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate でもやっぱり……<br>明確な証拠もないのに<br>疑うのは良くないよ！

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open3,Mouth2_Determined_Closed1,Sweat2-1
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 7-12議論後独白
# ==============================================================================

@print （たしかに証拠はない……） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Angry_Open1,Mouth2_Determined_Closed1,Sweat2-1
@print （けれど……だからといって<br>　ロープの存在を隠していたナノカが<br>　疑わしくないわけではない……！） { author:Hiro speed:1 waitInput:true Wait:true }

# 目が光るとか演出もあり
# ＠備考◆アンアンの魔法によって真実探求への意思が強化されてる

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Angry_Open1,Mouth2_Angry_Closed1,Sweat2-1
@print （【殺人を犯した人物を見つける】……！<br>　それこそが正しい道だ……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge7-12-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_02_12_01

@Skip false
@pauseTrial true

@choice 雷鳴の音だった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-12-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_02_12_02

@Skip false
@pauseTrial true

@choice 小さな声なら外には漏れない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-12-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_02_12_03

@Skip false
@pauseTrial true

@choice 予想できた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-12-5

@choice 盗聴していた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-12-6

@choice 魔法を使った
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-12-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

