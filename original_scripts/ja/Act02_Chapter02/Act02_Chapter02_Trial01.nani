@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter02/Act02_Chapter02_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 7-1: 💬 銃殺した犯人
# ==============================================================================
# ＠ト書き▼議論シーン7-1 銃殺した犯人
# 議論開始エフェクト
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge7-1-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open04
@gosubModifyCamera 0
@printDebate 犯人は黒部だろ。

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate 沢渡は脳天を<br>銃で吹っ飛ばされてんだ。

@char Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open04
@gosubModifyCamera 0
@printDebate "なら、犯人は<br><link=\"Objection_02_02_01_01\">銃を持ってる黒部</link><br>しかいねー。"

@char Alisa.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open01
@gosubModifyCamera 0
@printDebate 何か反論あるかよ。

# ＠備考◆さらっと流すように

@char Nanoka.ArmR4,ArmL2,Eyes1_Uncomfortable_Open1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate ……ないわね。

@char Nanoka.ArmR4,ArmL2,Eyes1_Uncomfortable_Open1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_02_01_02\">私だけ</link>が<br>銃を持っていたことは<br>否定できないわ。"

@char Sherry.Default,ArmR15,ArmL4,Angle01/Facial/Eyes>Eyes_Wink_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_02_01_03\">謎は全て</link><br>解けちゃいましたね！<br>さすがアリサさんです！"

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Closed1,Mouth1_Determined_Closed1
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# MARK: 7-1: 議論後独白
# ==============================================================================

@print （……どうやらアリサはナノカを疑っているらしい） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Closed1,Mouth1_Determined_Closed1
@print （人は一度思考がロックされてしまうと、<br>　既存の考えに囚われてしまいがちだ……） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR1,ArmL4,Eyes1_Angry_Open2,Mouth1_Determined_Closed1
@print （間違った情報を指摘して、<br>　彼女の先入観を否定してみるとしよう） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge7-1-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_02_01_01

@Skip false
@pauseTrial true

@choice ナノカは現場にいなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-1-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_02_01_02

@Skip false
@pauseTrial true

@choice 他にも銃があった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-1-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_02_01_03

@Skip false
@pauseTrial true

@choice 謎はまだある
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge7-1-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

# ==============================================================================
# MARK: 7-1: ❌ 議論ミス選択肢
# ==============================================================================
# MARK: 7-1-3: ❌ 反論・ナノカは現場にいなかった

# Judge7-1-3

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial false { timer:false }
@Gosub System/System_Subroutine.EndDebate-Last

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2
@gosubModifyCamera 0
@print いや、ナノカが犯人だとは考えにくい。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal2,ArmR1,ArmL4,Eyes2_Normal_Open1,Mouth2_Determined_Open2
@gosubModifyCamera 0
@print 死亡推定時刻が死体発見の直近なことから、<br>犯人は死体近くにいた人物から疑っていくべきだ。 { author:Hiro speed:1 waitInput:true Wait:true }

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@print でもよ、現場にいなくてもヤれんじゃねーのか？ { author:Alisa speed:1 waitInput:true Wait:true }

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@print 遠くから銃弾を撃ち込む方法だってあんだろ。 { author:Alisa speed:1 waitInput:true Wait:true }

@char Sherry.Default,ArmR13,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@print "ですね！ 狙撃とか！" { author:Sherry speed:1 waitInput:true Wait:true }

@char Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open02
@gosubModifyCamera 0
@print そんな芸当、<br>ドデカイ銃担いでる黒部ぐらいにしかできねーだろ。 { author:Alisa speed:1 waitInput:true Wait:true }

@char Alisa.Default,ArmR2,ArmL7,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@print いい加減なこと言ってんじゃねーぞ。 { author:Alisa speed:1 waitInput:true Wait:true }

@Damage 

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@gosubModifyCamera 0
@print （もっと直接的な証拠にもとづいた推理をしないと<br>　取り合ってはくれないか……） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@gosubModifyCamera 0
@print （……だが、凶器はナノカの銃とは限らない） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR1,ArmL4,Eyes1_Normal_Open1,Mouth1_Determined_Closed1
@gosubModifyCamera 0
@print （現場の状況を思い出そう。<br>　他にも凶器となりうるものはあったはずだ） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge7-1-1

