@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@gosubModifyCamera 0
@print （……だが、凶器はナノカの銃とは限らない） { author:Hiro speed:1 waitInput:true Wait:true }

