@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter04/Act01_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 4-6: 💬 アリサを殺したもの
# ==============================================================================
# ＠ト書き▼議論4-6 アリサを殺したもの

# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge4-6-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate アリサちゃんが<br>感電死したと思ったのは、<br>何も電気椅子に<br>座ってたからだけじゃないわ。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate ……ねえ、メルルちゃん。<br>あなたなら、<br>アリサちゃんの死体を見て<br>何が死因だと思うかしら？

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate そ、そうですね……。<br>詳しいことは<br>専門家でもないので<br>わかりませんけど……。

@char Meruru.Normal1,ArmR5_1,ArmL4,Eyes1_Normal_Open2,Mouth1_Angry_Open2
@gosubModifyCamera 0
@printDebate 外傷がないので……<br>体の中身の問題だとは<br>思います。<br>病死や窒息、<br>溺死や毒殺……。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ……そう、<br>つまりアリサちゃんは、<br>ある意味【病死】のようなもの<br>だったんじゃないかしら？

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 強い電気ショックは<br>止まった心臓を<br>動かす事もあるけれど……<br>逆に止めることだってあるわ。

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate ……電気椅子は<br>長時間高圧電流を流して<br>処刑する器具です……。

@char Meruru.Normal2,ArmR1_2,ArmL3,Eyes2_Normal_Open1,Mouth2_Angry_Open2
@gosubModifyCamera 0
@printDebate なので<br>ちゃんと処刑された場合は<br>もっと黒焦げの死体に<br>なっていそうですが……。

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate ……でも、短時間電流を<br>流されただけであれば、<br>外見上の変化がほとんどなく<br>死んでしまう事も<br>あるかもしれません……。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 【ショック死】という<br>言い方のほうが<br>わかりやすいかも<br>しれないわね。

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate ……どう？<br>エマちゃん。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "現場に他の<link=\"Objection_01_04_06_01\">凶器</link>が<br>存在しない以上、<br>アリサちゃんは<br>電気椅子によって<br><link=\"Objection_01_04_06_02\">感電死</link>したと<br>考えるのが自然……。"

@char Margo.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate ……そう思わないかしら。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Determined2 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

