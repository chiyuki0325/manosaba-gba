# 4-6議論後独白
# ==============================================================================

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@print （アリサちゃんが電気椅子で殺されたなら、<br>　それができるのはアリバイのないボクかナノカちゃんだけだ。<br>　だから電気椅子は使われてないはず……） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@print （そしてアリサちゃんを殺した【凶器】は<br>　ボクたち以外でも使えたはずだ……！） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@print （他の人も使えてアリサちゃんを殺せた、<br>　現場から消えた【凶器】……！<br>　それが何かわかれば……！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge4-6-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_04_06_01

@Skip false
@pauseTrial true

@choice 電気椅子は不具合があった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-6-3

@choice 他の凶器で殺された
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-6-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_01_04_06_02

@Skip false
@pauseTrial true

@choice 窒息死かも
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-6-4

@choice 溺死かも
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-6-5


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

