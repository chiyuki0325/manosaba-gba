@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter04/Act01_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 4-5: 💬 電気の印
# ==============================================================================
# ＠ト書き▼議論4-5 電気の印
# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge4-5-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate アリサちゃんの顔には<br>火傷のような痕が<br>ついていたわ。

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate 偶然にもそれは<br>美しい蝶のように<br>なっていたみたいだけど……。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "あの火傷の模様こそが<br><link=\"Objection_01_04_05_01\">電気を流された証拠</link>ね。<br>たしか電紋と呼ぶはずよ。"

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 水をかけられていたか、<br>かけられていないかに<br>関わらず……<br>アリサちゃんのあの傷は、<br>彼女が電気椅子で<br>処刑されたことを示しているわ。

@char Coco.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Middle
@gosubModifyCamera 0
@printDebate でも……<br>この蝶の形、<br>なんかノアの死体を<br>思い出すなぁ。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ……関係ないことは<br>黙ってくれるかしら、<br>ココちゃん。<br>今はナノカちゃんが犯人という<br>議論を進めるんだから。

@char Coco.Default,ArmR13,ArmL10,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate はぁ！？<br>感想言うぐらい<br>べつにいいじゃん！


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 4-5議論後独白
# ==============================================================================

@print （ココちゃんが怒られてる……。<br>　べつにマーゴちゃんとココちゃんが協力してたりは<br>　しないみたいだ） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@print （……アリサちゃんの頬の火傷痕はどうしてついたのかな。<br>　何か推測できそうなもの……<br>　見たことなかったっけ？） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge4-5-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_04_05_01

@Skip false
@pauseTrial true

@choice 電気以外でもつけられる
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-5-2

@choice 火傷ではない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-5-3

@choice 雷に打たれた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-5-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

