@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter04/Act01_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 4-4: 💬 死体に残された痕跡
# ==============================================================================
# ＠ト書き▼議論4-4 死体に残された痕跡
# 議論開始カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge4-4-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate アリサちゃんの死体は<br>水で濡れていたわ。

@char Margo.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "エマちゃんは<br>知ってるかしら？<br>電気椅子で処刑するときは、<br><link=\"Objection_01_04_04_01\">体を水で湿らせる</link>の。"

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate おそらく犯人は<br>眠ったアリサちゃんを<br>スムーズに殺すため、<br>濡らしたんでしょうね。<br>もし途中で目を覚ましでもしたら<br>面倒だもの。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 落ちていた【ガラスの破片】は<br>その為の<br>水を汲んできた容器か何かが<br>砕けたものなのかも<br>しれないわ。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "アリサちゃんは<br>電気椅子で処刑された……<br>そうでないと、<br><link=\"Objection_01_04_04_02\">水で濡れていた</link><br>説明がつかないの。"

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate そして電気椅子が<br>使われたとしたら、<br>犯人はナノカちゃんか<br>エマちゃんだけ……。<br>何か反論はあるかしら？

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 4-4議論後独白
# ==============================================================================

@print （電気椅子が使われたなら、<br>　たしかにボクかナノカちゃんしか<br>　犯行ができないのかもしれない……） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Pensive1,ArmR4,ArmL5
@print （……これまで見つけたものの中で、<br>　アリサちゃんの死体状況を説明できそうなものは<br>　なかったかな？） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@print （マーゴちゃんに、証拠品をつきつけるんだ！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge4-4-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_04_04_01

@Skip false
@pauseTrial true

@choice 電気処刑ではなぜ水をかけるの？
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-4-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_01_04_04_02

@Skip false
@pauseTrial true

@choice シャワーを浴びていた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-4-4

@choice 水をかけられていない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-4-3

@choice スプリンクラーが作動した
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-4-5


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

