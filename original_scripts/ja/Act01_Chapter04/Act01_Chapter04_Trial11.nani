@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter04/Act01_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 4-11: 💬 桜羽エマが犯人の理由
# ==============================================================================
# ＠ト書き▼議論4-11 桜羽エマが犯人の理由

@char Warden.1 { Position:,{characterPositionY} time:0 }

# 議論開始カットイン
# BGM変更：Ema-常-
@bgm Bgm_13_1_Loop

# Judge4-11-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

# ＠備考◆焦燥感・苦しい

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate アリサちゃんの<br>飲んだ睡眠薬は<br>過剰摂取しても<br>【即死しない】……。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate それであってるわよね、<br>メルルちゃん。

@char Meruru.Default
@gosubModifyCamera 0
@printDebate は、はい……。<br>さすがに劇毒ではないので、<br>即死するようなものでは<br>ありません……。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ……であれば、<br>アリサちゃんは<br>昨晩の時点では<br>すぐに死んでいなかった<br>はずよね。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate ……そして昨日の夜、<br>エマちゃんは地下で<br>処刑台を操作したのね？

@char Ema.Default,ArmR5,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Middle
@gosubModifyCamera 0
@printDebate ま、待って……！<br>そもそもボクが<br>押したボタンが<br>処刑台の操作ボタン<br>だったかは……！

@char Warden.1
@gosubModifyCamera 0
@printDebate 地下にあったパネルを<br>操作したのであれば、<br>間違いないでしょうねぇ。

@char Warden.1
@gosubModifyCamera 0
@printDebate 処刑台の昇降ボタンは<br>簡単に押せる位置に<br>ありますから。

@char Warden.1
@gosubModifyCamera 0
@printDebate それに昨夜、<br>処刑台の昇降は<br>一度しかありませんでした。<br>……履歴から<br>確認ができます。

@char Coco.Default,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Gross_Open,Angle01/Facial/Sweat>Sweat01,Angle01/Facial/Pale>Pale01
@gosubModifyCamera 0
@printDebate じゃ、じゃあ……<br>エマっちが操作したせいで<br>眠ってたアリサが<br>地下に<br>閉じ込められた<br>ってこと……！？

# ＠備考◆沈んだ表情・悔しげ

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Pensive_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Closed,Angle01/Facial/Pale>Pale01
@gosubModifyCamera 0
@printDebate もし……<br>そうなら……<br>アリサちゃんを<br>凍死させて殺した<br>犯人は……。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open,Angle01/Facial/Sweat>Sweat01
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_04_11_01\">桜羽エマちゃん</link><br>……あなたよ。"


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Fearful1,ArmR5,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 4-11 議論後独白
# ==============================================================================

@print （ち、違う……！<br>　ボクが殺したなんてそんなこと……！<br>　指摘……間違いを指摘しないと……！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge4-11-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_04_11_01

@Skip false
@pauseTrial true

@choice 殺してない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-11-2

@choice 殺意はなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-11-2

@choice 知らなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-11-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

