@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter04/Act01_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 4-1: 💬 アリサの殺された状況
# ==============================================================================
# ＠ト書き▼議論4-1 アリサの殺された状況
# カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge4-1-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 死体の状況を説明して、<br>メルルちゃん。

@char Meruru.Normal2,ArmR1_2,ArmL3,Eyes2_Normal_Open1,Mouth2_Angry_Open2
@gosubModifyCamera 0
@printDebate は、はい……！

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate アリサさんの死体は<br>電気椅子に座った状態で<br>発見されました。<br>体には火傷もあって……。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 高圧電流を流されたから、<br>体に火傷が<br>できたんでしょうね。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Closed,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate さて、<br>この電気椅子について……<br>詳細をゴクチョーから<br>聞いているわ。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 電気椅子を起動するには、<br>【パスコード】が<br>必要だったの。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 誰でも起動できないよう、<br>安全装置がついてたのね。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "当然、<br><link=\"Objection_01_04_01_01\">コード</link>を知らない<br>私たちには<br>電気椅子を<br><link=\"Objection_01_04_01_02\">使うことはできない</link>わ。"

@char Margo.Default,ArmR4,ArmL1,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate でも、<br>ナノカちゃんなら別。

@char Margo.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_04_01_03\">ナノカちゃん</link>の<br><link=\"Objection_01_04_01_04\">過去を幻視する魔法</link>なら<br>電気椅子のパスコードぐらい<br><link=\"Objection_01_04_01_05\">触れた</link>だけで<br>読み取れたはずよ。"

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate つまり……<br>ナノカちゃんこそが<br>アリサちゃんを<br>電気椅子で処刑した<br>犯人なのよ。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

