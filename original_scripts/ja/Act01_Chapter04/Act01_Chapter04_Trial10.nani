@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter04/Act01_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 4-10: 💬 アリサを殺したもの
# ==============================================================================
# ＠ト書き▼議論4-10 アリサを殺したもの

# 議論開始カットイン
# BGM変更：weRer N'o Hir
@bgm Bgm_43_1

@ResetText 
@char Warden.8
@stageCamera 1 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (7.9 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.8

@char Ema.Pensive1,ArmR3,ArmL7 { time:0 }
@stageCamera 0 { Rotation:0,{ (0 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (0.1 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 2.3

# Judge4-10-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Warden.2
@gosubModifyCamera 0
@printDebate 処刑台は<br>私がリモコンで操作するか、<br>もしくは地下の施設で<br>操作しない限りは<br>動かないはずなんです。

@char Warden.1
@gosubModifyCamera 0
@printDebate ですが実際に動いた記録が<br>残っています。

@char Warden.1
@gosubModifyCamera 0
@printDebate "昨晩から今朝にかけて……<br>これはいったい<br>どうして<br><link=\"Objection_01_04_10_01\">動いた</link>んでしょうね？"

# ＠備考◆投げやり

@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate 勘違いとかじゃねーの？<br>もしくは<br>お前が嘘ついてるか。

@char Warden.5
@gosubModifyCamera 0
@printDebate 私はあくまでも<br>この施設の管理者ですから。<br>嘘なんてついてませんよ。<br>……皆さんに言えないことは<br>ありますけどね。

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Determined2 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 4-10議論後独白
# ==============================================================================

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@print （ゴクチョーの言ってる【地下】って……<br>　あの隠し通路のことだよね？） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@print （でも……だとすると、昨日の晩に<br>　地下に入って何か操作した人物が<br>　いるってことで……） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Fearful_Open
@print （それって……もしかして） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge4-10-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_04_10_01

@Skip false
@pauseTrial true

@choice 誤作動した
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-10-3

@choice ゴクチョーが間違えた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-10-4

@choice 地下で操作した人物がいる
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-10-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

