@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter04/Act01_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 4-3: 💬 昨夜のアリバイ
# ==============================================================================
# ＠ト書き▼議論4-3 昨夜のアリバイ

# カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge4-3-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 昨晩の２１時前、<br>私たち３人には<br>アリバイがあるわ。<br>そうでしょう？<br>メルルちゃん、ココちゃん。

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate "は、はい……。<br>昨晩、<br>私はお２人を励まそうと<br>中庭で<link=\"Objection_01_04_03_01\">ティーパーティー</link>を<br>しようとして……。"

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate （昨日、<br>　メルルちゃんが言ってた<br>　ことだ……！<br>　ボクが夜に地下を<br>　探索してたときのことかも……！）

@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate その時、<br>アリサのヤツも見かけて<br>声かけたけど、<br>こなかったんだよね～。

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate たしか夜の２０時ぐらい<br>だったかな。<br>どっちにしろ、<br>２１時まではあてぃしら<br>ずっとアリバイあっから。

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate つまり……<br>私たちには<br>アリサちゃんを殺すなんて<br>不可能なの。

@char Margo.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate あの電気椅子で<br>処刑をするには<br>裁判所にいて<br>ボタンを押さなきゃ<br>ダメでしょ？

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "でも私たちに<br><link=\"Objection_01_04_03_02\">お茶会を抜け出した</link>者は<br>いないし、<br><link=\"Objection_01_04_03_03\">電気椅子</link>が<br>遠隔操作できるように<br>改造されたような<br>形跡もない……。"

@char Margo.Pensive1,ArmR5,ArmL1
@gosubModifyCamera 0
@printDebate "つまり、<br>やっぱりナノカちゃんにしか<br>電気椅子は<link=\"Objection_01_04_03_04\">使用</link>できないのよ。"

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate もしくは<br>同じくアリバイのない<br>エマちゃんね。<br>あなたたちにしか<br>できないの。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 4-3議論後独白
# ==============================================================================

@print （３人にアリバイがあるなら、たしかにボクとナノカちゃん<br>　どちらかにしか犯行ができなくなってしまうかも……） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@print （でも……これまで調べた情報にマーゴちゃんの話を<br>　否定できる材料がなかったかな……？） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@print （些細なことでも、不確定な情報でもいい……！<br>　探してみるんだ！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge4-3-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_04_03_01

@Skip false
@pauseTrial true

@choice ボクを誘わないのはおかしい
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-3-3

@choice ３人で口裏を合わせているだけ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge4-3-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

