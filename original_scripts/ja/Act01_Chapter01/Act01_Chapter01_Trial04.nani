@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 4: 💬 凶器について
# 3選択肢+証拠品突きつけチュートリアル
# ==============================================================================
# ＠ト書き▼議論シーン1-4 凶器について
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge1-4-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Normal1,ArmR15,ArmL1
@gosubModifyCamera 0
@printDebate ノアさんを殺した凶器について<br>もう一度詳しく<br>考えてみましょうか！

@char Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL2
@gosubModifyCamera 0
@printDebate ……なんか話し合う<br>必要あるのか？<br>さっき桜羽と宝生が<br>話してただろ……。<br>あの矢が城ケ崎を<br>殺した凶器だってな。

@char Hanna.Normal1
@gosubModifyCamera 0
@printDebate 部屋に転がってた矢……<br>ですわね？<br>これを胸に刺されて<br>ノアさんは<br>死んだんですわよね……？

@char Meruru.Normal1,ArmR1_1,ArmL14,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate だ、だとしたら<br>犯人はその矢を<br>どうやって<br>刺したんでしょうか……？

@char Meruru.Normal1,ArmR1_1,ArmL14,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate 部屋の中は<br>白一色で塗られていて、<br>そこには足跡も<br>ありませんでした。

@char Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL1
@gosubModifyCamera 0
@printDebate "そりゃ<br><link=\"Objection_01_01_04_01\">遠くから投げつけた</link>んじゃ<br>ねーのか。<br>犯人は<link=\"Objection_01_01_04_02\">ダーツの経験</link>でも<br>あったんだろ。"

@char Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL1
@gosubModifyCamera 0
@printDebate "矢を部屋の<br><link=\"Objection_01_01_04_03\">外から投げ込んだ</link>だけ……<br>単純でシンプルな答えだ。"

@char Coco.Pensive1
@gosubModifyCamera 0
@printDebate ……ダーツで人殺しとか、<br>それ本気で言ってる？<br>頭ヤンキー過ぎん？

@char Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL2
@gosubModifyCamera 0
@printDebate 仮の話だっての……！<br>とりあえず仮定として<br>進めてんだよ！<br>文句があるならお前が仕切れ！

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1,ArmR4,ArmL5,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# ADVシーン
# ==============================================================================

@print （矢を投げて人を殺すことが可能かはわからないけど……<br>　それはそれとして、何か違和感があるような） { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
@gosubSplitStageScreen 1

@char Meruru.Normal1,ArmR5_1,ArmL8,Eyes1_Pensive_Open2,Mouth1_Fearful_Open1
@print エマさん……。<br>やっぱり、皆さんが知っている事には<br>人によって差があるみたいですね。 { author:Meruru speed:1 waitInput:true Wait:true }

@ResetText 
@char Ema.Determined2 { time:0.2 }
@Wait 0.2

@print うん……！<br>アリサちゃんに説明して<br>話を聞いてもらおう……！ { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
@char Ema.Pensive1,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed { time:0.2 }
@Wait 0.2

@print （……ちょっとだけ怖いけど） { author:Ema speed:1 waitInput:true Wait:true }

@hideStageScreen 1

@goto .Judge1-4-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_01_04_01

@Skip false
@pauseTrial true

@choice 矢は刺さらなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge1-4-4

@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_01_01_04_02

@Skip false
@pauseTrial true

@choice 犯人はダーツの経験者ではない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge1-4-3

@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_01_01_04_03

@Skip false
@pauseTrial true

@choice 道具を使った
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge1-4-2

@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

