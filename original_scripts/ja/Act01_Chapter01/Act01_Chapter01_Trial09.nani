@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 9: 💬 ノアが殺害された方法
# ==============================================================================
# ＠ト書き▼議論シーン1-9 ノアが殺害された方法
# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

# Judge1-9-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Nanoka.Default
@gosubModifyCamera 0
@printDebate まず順番に<br>話を整理してみましょうか。<br>犯人が城ケ崎ノアの部屋を<br>訪れた所からよ。

@char Sherry.Normal1
@gosubModifyCamera 0
@printDebate "はい！<br>まず<link=\"Objection_01_01_09_01\">犯人が部屋を訪れた時</link>、<br>部屋は<link=\"Objection_01_01_09_02\">白い塗料</link>で<br>覆われていました。<br>それをしたのは<br><link=\"Objection_01_01_09_03\">ノアさん自身</link>ですよね。"

@char Leia.Smile1,ArmR3,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate "……そうして<link=\"Objection_01_01_09_04\">空を飛んだ犯人</link>は、<br>被害者に近付いて<br><link=\"Objection_01_01_09_05\">手に持った矢</link>を<br>突き立てたわけだ。<br><link=\"Objection_01_01_09_06\">シンプル</link>な解法だ。<br>非の打ち所もない。"

@char Hanna.Angry1,ArmR3,ArmL2
@gosubModifyCamera 0
@printDebate どうしても<br>わたくしを犯人扱い<br>したいようですわねっ！？<br>空中以外からも、<br>刺す方法はあったんじゃ<br>ないですこと！？

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate "その場合、犯人は<link=\"Objection_01_01_09_07\">ダーツの達人</link>か、<br>もしくは腕の<br><link=\"Objection_01_01_09_08\">リーチを伸ばせた</link>か……。<br>それとも<link=\"Objection_01_01_09_09\">そんな魔法</link>に<br>心当たりでもあるのかしら？<br>まあそんなこと、<br>ありえないとは思うけど……。"

# ＠備考◆冗談に笑うように
@char Miria.Smile1,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Smile_Open02
@gosubModifyCamera 0
@printDebate ああ～、<br>ゲームや漫画の中でなら<br>そんな人に心当たりは<br>あるけれど……。<br>さすがにねぇ。

