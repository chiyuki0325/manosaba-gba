@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 5: 💬 シェリーのボウガン
# ==============================================================================
# ＠ト書き▼議論シーン1-5 シェリーのボウガン

# Judge1-5-1

# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Normal1
@gosubModifyCamera 0
@printDebate "私がボウガンをお借りしたのは<br><link=\"Objection_01_01_05_01\">一昨日の晩</link>の事です。<br>その時には既に<br>矢が装填されていませんでした。"

@char Sherry.Smile1
@gosubModifyCamera 0
@printDebate 分解したパーツは<br>戻せなくなったので、<br>部屋の前のバケツに入れて<br>保管しておいたんです！

@char Miria.Surprised1,ArmR1,ArmL1
@gosubModifyCamera 0
@printDebate あの通路脇のバケツって、<br>ゴミ箱なんじゃ……？

@char Nanoka.Default
@gosubModifyCamera 0
@printDebate ……けれど一昨日、<br>矢だけが盗まれていたのは<br>私も確認しているわ。<br>彼女は本当の事を<br>言っていると思う……。

@char Alisa.Normal1,Option-ArmL-Off
@gosubModifyCamera 0
@printDebate けどその矢も、<br>橘が盗んだ可能性は<br>あるんじゃねーのか。<br>後からボウガンの本体の方も<br>欲しくなった……とかさ。

@char Coco.Smile1
@gosubModifyCamera 0
@printDebate "あ～、それありそ～。<br>矢を触ってるうちに<br>撃ってみたくなって、<br><link=\"Objection_01_01_05_02\">殺した</link>んじゃね？"

@char Sherry.Angry1,ArmR3,ArmL4
@gosubModifyCamera 0
@printDebate そんなバレバレな事<br>しませんよ！<br>ぷんぷん！

@char Coco.Pensive1
@gosubModifyCamera 0
@printDebate いや、ぷんぷんて。<br>漫画みたいな効果音、<br>自分の口で言う？<br>マジでキモ……。

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# ADVシーン
# ==============================================================================

@char Meruru.Normal2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Smile_Closed1 { time:0 }
@gosubSplitStageScreen 1

@print ……エマさんエマさん。<br>もしかしたらシェリーさんのお話……。 { author:Meruru speed:1 waitInput:true Wait:true }

@char Meruru.Normal2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Smile_Closed1
@print 私たち、証明できる【証拠品】を<br>見てないでしょうか……。 { author:Meruru speed:1 waitInput:true Wait:true }

@char Ema.Surprised1,ArmR13
@print そういえば……！ { author:Ema speed:1 waitInput:true Wait:true }

@hideStageScreen 1
@char Ema.Determined2,ArmR7

@print （たしかにメルルちゃんの言う通りかも……。<br>　もう一度魔女図鑑を確認してみよう……！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge1-5-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_01_05_01

@Skip false
@pauseTrial true

@choice 一昨日の晩より前のはず
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge1-5-3

@choice 一昨日の晩より後のはず
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge1-5-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_01_01_05_02

@Skip false
@pauseTrial true

@choice シェリーは殺せない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge1-5-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

