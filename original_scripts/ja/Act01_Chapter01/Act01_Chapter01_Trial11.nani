@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 11: 💬 レイアの主張
# ==============================================================================
# ＠ト書き▼議論シーン1-11 レイアの主張
# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

# Judge1-11-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Leia.Smile1,ArmR3,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate エマくんの推理には、<br>大きな穴がある。<br>……きっと私たちは<br>こんな所に囚われているせいで、<br>正常な判断ができなく<br>なっているんだよ。

@char Leia.Smile1,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Normal_Closed01,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate 私達が死体を見逃した事、<br>ノアくんが黙って殺された事……<br>その他の<br>さまざまなことだってそうさ。

@char Leia.Smile1,ArmR10,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate "エマくんの推理では<br><link=\"Objection_01_01_11_01\">説明がつかない</link>ことだらけだ。<br>不自然な事ばっかりじゃないか。"

@char Margo.Smile1
@gosubModifyCamera 0
@printDebate あら。<br>不自然と言っても、<br>この監獄には<br>【魔法】があるのよ？<br>何があっても<br>おかしくないんじゃ<br>ないかしら？

@char Leia.Angry1,ArmR3,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate 本当にそうだろうか。<br>私たちの魔法にだって、<br>一定のルールや法則は<br>あるはずだよ。

@char Leia.Smile1,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate "たとえば私の<br><link=\"Objection_01_01_11_02\">【魅了】の魔法</link>……。<br>みんなに<link=\"Objection_01_01_11_03\">恋心</link>を<br>抱かせてしまう、<br>罪な魔法だね。"

@char Leia.Pensive1,ArmR5,ArmL3,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate "けど、<link=\"Objection_01_01_11_04\">私の魔法</link>では<br>ノアくんを<link=\"Objection_01_01_11_05\">静かに殺したり、</link><br>死体を隠すことはできないんだよ。"

@char Leia.Smile1,ArmR2,ArmL3,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate 今は仲間内での疑い合いなんて、<br>している場合じゃないよ……。<br>みんな！<br>信じ合う心を取り戻そう！

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR6,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

