@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 1500
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 13: 💬 証拠はあるのか
# ==============================================================================
# ＠ト書き▼議論シーン1-13 証拠はあるのか
# BGM変更：AccUhEarts(Vocal有)
@bgm Bgm_15_1

# Judge1-13-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Angry_Open1,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate 事件の流れについて<br>おさらいしましょうか。

@char Nanoka.Normal1,ArmR1,ArmL10,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 犯行は２０時から<br>２１時の間に行われた。<br>そしてその間に<br>アリバイがないのは……。

@char Leia.Angry1,ArmR7,ArmL3,ArmR7,ArmL3,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate 私だけ……<br>ということだったね。

@char Leia.Smile1,ArmR3,ArmL3,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Normal_Closed01,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate ……でも私としては、<br>それは何かの行き違いや<br>見落としがあった<br>結果だと思っているけどね。

@char Alisa.Angry1,Option-ArmL-Off
@gosubModifyCamera 0
@printDebate お前が犯人だったら、<br>そういうしかねぇだろ。

@char Leia.Pensive1,ArmR5,ArmL3,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate でも私がやったというような<br>確たる証拠はないよね？<br>それで疑うのは<br>どうかと思うよ。

@char Coco.Pensive1,ArmR2,ArmL1
@gosubModifyCamera 0
@printDebate 証拠ね～？<br>でも今までもう<br>散々出尽くしたっしょ～！<br>こんな話し合い、<br>続ける意味ある～？

@char Miria.Pensive1,ArmR3,ArmL4
@gosubModifyCamera 0
@printDebate で、でももしかすると、<br>まだちゃんと<br>検討してない物が<br>あるかもしれないし……。

@char Sherry.Normal1,ArmR3,ArmL3
@gosubModifyCamera 0
@printDebate では物理的に<br>残っていた証拠を<br>もう一度<br>検討してみましょうか！

@char Sherry.Smile1,ArmR3,ArmL12
@gosubModifyCamera 0
@printDebate "たとえば……<br>ナノカさんのリボンとかは<br>どうでしょうね？<br>これは確実に<br><link=\"Objection_01_01_13_01\">犯人さんが使用した物</link>、<br>ですよね！"

@char Margo.Normal1,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate そのリボン、<br>血がついてたのよね？<br>誰のものなのかしら？

@char Hanna.Fearful1,ArmR3,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate そ、その血が実は<br>犯人のものだったり<br>するんじゃねーんですわ！？<br>ありがちな展開ですわー！

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate "もしそうだったとしても<br>私たちにそれを<br><link=\"Objection_01_01_13_02\">調べる方法</link>は<br>ありませんし、<br><link=\"Objection_01_01_13_03\">証拠</link>には<br>ならなそうです……。"

@char Miria.Normal1,ArmR3,ArmL8
@gosubModifyCamera 0
@printDebate "他には……<br>部屋に塗られた<link=\"Objection_01_01_13_04\">塗料</link>には<br>怪しい所はなかったかな？"

@char Miria.Normal1,ArmR3,ArmL8,Angle01/Facial/Eyes>Eyes_Glare_Open04
@gosubModifyCamera 0
@printDebate "あんなに大量に<br>塗られてたのにも<br><link=\"Objection_01_01_13_05\">意味がある</link>かもだし……。"

@char Sherry.Normal1,ArmR3,ArmL12
@gosubModifyCamera 0
@printDebate そういえば現場には<br>蝶の絵もありましたよね。

@char AnAn.Normal1,Angle01/Option_Arms-,ArmR-Option-Off,Angle01/Arms>Arms01,Angle01/Option_Arms>Option_Arms01_03,Angle01/Head/Facial/Eyes>Eyes_Angry_Open01,Angle01/Head/Facial/Mouth>Mouth_Normal_Closed
@gosubModifyCamera 0
@printDebate 『あれが犯人に<br>繋がる物じゃないことは<br>わがはいが保証する』

@char Margo.Normal1,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "じゃああの<link=\"Objection_01_01_13_06\">ホウキ</link>は<br>どうかしら？<br>現場の近くに<br>残されていたのよね？<br>何か<link=\"Objection_01_01_13_07\">痕跡が残って</link>たり<br>しないかしら？"

@char Sherry.Smile1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 実は何の変哲もない<br>ホウキに見えて、<br>魔法のホウキだったり<br>するんでしょうか！？

@char Coco.Smile1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate そうそう魔女だけに――。

@char Coco.Angry1,ArmR13,ArmL10,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Comical_Closed
@gosubModifyCamera 0
@printDebate ――ってうるせー！<br>んな都合のいいことあるかー！

@char AnAn.Pensive1,Angle01/Option_Arms-,ArmR-Option-Off,ArmR2,ArmL3,Angle01/Head/Facial/Eyes>Eyes_Uncomfortable_Open02,Angle01/Head/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate ……はぁ。

@char Alisa.Angry1,Option-ArmL-Off,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01
@gosubModifyCamera 0
@printDebate ……ていうか、<br>本当にこんな話して<br>意味あんのかよ。<br>もう十分話しただろ……！

@char Meruru.Normal1,ArmR8_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 意味は……<br>あると思います。<br>投票したあとで<br>【間違っていたら】<br>なんて……<br>後悔したくありませんから。

@char Alisa.Angry1,Option-ArmL-Off,ArmR4,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open02
@gosubModifyCamera 0
@printDebate ……チッ……。<br>わかった、<br>続けるよ……。

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

