@Wait 1.2

@hide MainBackground-Middle,AnAn-Middle { time:0 }
@back 2_1 { time:0 }
@char Ema.Pensive1,ArmR3 { time:0 }
@char Noah.Normal1,ArmL4 { time:0 }
