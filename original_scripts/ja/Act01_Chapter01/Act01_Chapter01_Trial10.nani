@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 10: 💬 レイアの反論
# ==============================================================================
# ＠ト書き▼議論シーン1-10 レイアの反論
# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

# Judge1-10-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Leia.Smile1,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate 私の剣を使えば<br>殺害可能だったと？<br>でもそれは他の人だろうと<br>成立するとは思わないかい？

@char Leia.Smile1,ArmR5,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Middle
@printDebate "たとえば<br><link=\"Objection_01_01_10_01\">ホウキをたくさん繋げた</link>ら<br>どうだい？<br>犯人は現場から<br>それを<link=\"Objection_01_01_10_02\">持ち去った</link>のかも<br>しれない。<br><link=\"Objection_01_01_10_03\">剣なんて使わなくても</link><br>可能なんだ。"

@char Alisa.Angry1,Option-ArmL-Off
@gosubModifyCamera 0
@printDebate そんなこと言い出したら<br>キリねーだろ。

@char Leia.Smile1,ArmR5,ArmL5
@gosubModifyCamera 0
@printDebate エマくんと同じく、<br>私は可能性を提示したまでさ。<br>……否定する根拠は<br>ないと思うけどね。

@char Hanna.Angry1
@gosubModifyCamera 0
@printDebate それはたしかに<br>そうかもしれませんけど……！<br>でもそもそもアリバイが――！

@char Leia.Normal1,Angle01/Facial/Eyes>Eyes_Smile_Open
@gosubModifyCamera 0
@printDebate ――アリバイがなかろうと、<br>【私には不可能】だと<br>説明してあげているんだよ。

@char Leia.Smile1,ArmR9,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate だいたい<br>エマくんが提示した推理も、<br>全て仮説に仮説を<br>積み重ねただけの<br>机上の空論じゃないか。

@char Leia.Angry1,ArmR5,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate "私が<br><link=\"Objection_01_01_10_04\">ありあわせの物</link>で<br>槍を作ったと？<br><link=\"Objection_01_01_10_05\">私が作った証拠</link><br>もなければ、<br>そもそも<br><link=\"Objection_01_01_10_06\">そんな物が存在した証拠</link><br>すらない……。"

@char Leia.Smile1,ArmR9,ArmL8,Angle01/Facial/Eyes>Eyes_Normal_Open02,Angle01/Facial/Mouth>Mouth_Smile_Middle
@gosubModifyCamera 0
@printDebate 証拠もなく<br>他人を疑うなんて……<br>そんなのは誰かに犯行を<br>なすりつけたい人間が<br>することなんじゃないのかな？

@char Leia.Smile1,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open01
@gosubModifyCamera 0
@printDebate ……もっと理性的に<br>なるべきだと思うよ、<br>みんな。

@char Hanna.Angry1,ArmR3,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open01,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate それあなたが<br>言うんですの！？<br>わたくしのこと<br>散々疑ったくせにー！

# ==============================================================================
# ADVシーン
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

@print （レイアちゃんが言っていることは正しい……。<br>　証拠がないなら、ボクの言ってる事は<br>　間違いなのかもしれない……） { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
@char Meruru.Normal2,ArmR9_2,ArmL9,Eyes2_Normal_Open1,Mouth2_Smile_Closed1
@gosubSplitStageScreen 1
@print エマさん……！<br>私はあなたのこと……信じてます！ { author:Meruru speed:1 waitInput:true Wait:true }

@char Ema.Surprised1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Middle
@print （メルルちゃん……！） { author:Ema speed:1 waitInput:true Wait:true }

@char Ema.Normal1,ArmR9,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Closed
@print "……うん！ 任せて！" { author:Ema speed:1 waitInput:true Wait:true }

@hideStageScreen 1

@goto .Judge1-10-1

