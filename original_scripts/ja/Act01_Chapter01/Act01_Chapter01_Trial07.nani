@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 7: 💬 ノアはいつ死んだ？
# ==============================================================================
# ＠ト書き▼議論シーン1-7 ノアはいつ死んだ？
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge1-7-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Coco.Normal1,ArmR2,ArmL2
@gosubModifyCamera 0
@printDebate あてぃしたちは寝る前に<br>ノアの部屋の前を通ってるわけ。<br>そこに死体があったら、<br>気付かないわけないじゃん？

@char Coco.Normal1,ArmR3,ArmL2
@gosubModifyCamera 0
@printDebate だからあの時さぁ、<br>ノアは<br>【生きてた】んじゃねーの？

@char Coco.Normal1,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Closed
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_01_07_01\">絵でも描いてた</link>とかさ。<br>そういや<link=\"Objection_01_01_07_02\">足音も聞こえた</link><br>気がするし！<br><link=\"Objection_01_01_07_03\">ピンピンしてた</link>はずだって！"

@char Miria.Normal1,ArmR3,ArmL4
@gosubModifyCamera 0
@printDebate そ、そうだったっけ……？<br>うーん……<br>言われてみれば、<br>そうかもしれないけど……。

@char Coco.Normal1,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Middle
@gosubModifyCamera 0
@printDebate だからノアが殺されたのは<br>その後！<br>【就寝時間から朝まで】の間<br>しかねーの！

@char Leia.Smile1,Arms
@gosubModifyCamera 0
@printDebate ……しかし就寝時間は<br>鍵がかけられるはずだよ。<br>外に出る事ができても、<br>入る事は<br>できないんじゃないかな？

@char Margo.Smile1,ArmR1,ArmL3
@gosubModifyCamera 0
@printDebate あら、<br>それなら就寝時間前に<br>ノアちゃんの部屋に<br>忍び込んでおけば<br>問題ないんじゃないかしら。

@char Coco.Smile1,ArmR1,ArmL1
@gosubModifyCamera 0
@printDebate それだ！<br>そしてそれができるのは、<br>就寝時間にルームメイトと<br>一緒にいなかったヤツだけ……！

@char Coco.Normal1,ArmR2,ArmL2
@gosubModifyCamera 0
@printDebate メルちゃんが<br>隣の部屋にいたのは<br>あてぃし見てるし……。

@char Coco.Smile1,ArmR2,ArmL4
@gosubModifyCamera 0
@printDebate "つまりノアを殺せるのは<br>就寝時間に<link=\"Objection_01_01_07_04\">アリバイがない</link>……<br><link=\"Objection_01_01_07_05\">医務室のアンアン</link>か、<br><link=\"Objection_01_01_07_06\">１人部屋のエマっち</link>の<br>どっちかなんだよ！"

@char Coco.Angry1,ArmR2,ArmL3,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate 違うってんなら……<br>証拠見せてよ、<br>証拠！！

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Surprised1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open03,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# ADVシーン
# ==============================================================================

@print （ココちゃんの言ってることが本当なら、<br>　たしかにボクかアンアンちゃんのどっちかが<br>　犯人になっちゃうかも……！） { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Normal_Open2,Mouth1_Normal_Open2
@gosubSplitStageScreen 1
@Wait 0.2

@print ……なんだかミリアさん、<br>少し自信なさげのように見えますね……。 { author:Meruru speed:1 waitInput:true Wait:true }

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Normal_Open2,Mouth1_Normal_Open2

@print もしかしたら……<br>そこに何か、ココさんの推理の穴があるのかも……。 { author:Meruru speed:1 waitInput:true Wait:true }

@hideStageScreen 1
@Wait 0.3

@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01

@print （ココちゃんの推理が間違ってる事を証明する<br>　証拠品……何かなかったかな？） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge1-7-1

