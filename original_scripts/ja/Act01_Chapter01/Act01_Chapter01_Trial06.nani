@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter01/Act01_Chapter01_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 6: 💬 ハンナが犯人の理由
# ==============================================================================
# ＠ト書き▼議論シーン1-6 ハンナが犯人の理由
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1
@badId 2

# Judge1-6-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Leia.Normal1,Angle01/Facial/Mouth>Mouth_Surprised_Open,Arms
@gosubModifyCamera 0
@printDebate 犯人はハンナくんしか<br>考えられないと思うよ。<br>そして、<br>それを指し示す証拠が<br>２つある……。

@spawn Clue

@char Leia.Normal1,ArmR3,ArmL5,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate １つ目は<br>先程証明された通り、<br>シェリーくんに盗まれ、<br>破壊されたボウガンだ。
@despawn Clue

@char Sherry.Normal1,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04
@gosubModifyCamera 0
@printDebate お借りしただけですし、<br>ちょっと分解した<br>だけですよ～！

@char Leia.Normal1,ArmR3,ArmL5,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate "……ともかく、<br>犯行があった<link=\"Objection_01_01_06_01\">タイミング</link>では<br>既にボウガンは<link=\"Objection_01_01_06_02\">破壊</link>されていた。<br>つまりボウガンを<br><link=\"Objection_01_01_06_03\">使う事はできなかった</link>……。"

@spawn Clue
@char Leia.Normal1,ArmR6,ArmL5,Angle01/Facial/Mouth>Mouth_Yell_Open01
@gosubModifyCamera 0
@printDebate よって、<br>犯人はノアくんに近付いて<br>【直接矢を突き立てた】と<br>考えるのが妥当だ。

@despawn Clue

@back 270_2
@char Leia.Angry1
@gosubModifyCamera 0
@printDebate そして２つ目の証拠は、<br>あの白一面に塗られた<br>部屋だ。

@char Leia.Normal1
@gosubModifyCamera 0
@printDebate " 一切の<link=\"Objection_01_01_06_04\">痕跡を残さず</link>に<br>部屋に侵入して<link=\"Objection_01_01_06_05\">被害者を刺す</link>……<br><link=\"Objection_01_01_06_06\">ハンナくん以外は飛べない</link>のだから、<br>そんなことは他の誰にも<br>不可能なのだよ。"

@hide Stills

@char Hanna.Cry1,ArmR2,ArmL2,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate 違いますぅ！<br>わたくし<br>何もやってねーですわ～！

@char Leia.Pensive1
@gosubModifyCamera 0
@printDebate じゃあやはり、<br>犯人が矢を外から投げたとでも？<br>誰が納得するんだい？<br>そんな話で……。

@char Leia.Angry1
@gosubModifyCamera 0
@printDebate 反論があるというなら……<br>まずは私の話が<br>間違っていることを<br>証明してからにしてもらおう！

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# ADVシーン
# ==============================================================================

@print （他の可能性がないわけじゃないけど、<br>　一番怪しいのはたしかにハンナちゃんなのかも……） { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubSplitStageScreen 1

@print ……レイアさんの言っている事は、<br>本当に正しいんでしょうか。 { author:Meruru speed:1 waitInput:true Wait:true }

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Pensive_Closed1

@print 何か……見落としていることがあるような。 { author:Meruru speed:1 waitInput:true Wait:true }

@hideStageScreen 1

@char Ema.Pensive1,ArmR4,ArmL5,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed
@print （メルルちゃんの違和感……<br>　いったいなんだろう。<br>　もう一度考えてみよう！） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge1-6-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_01_06_01

@Skip false
@pauseTrial true

@choice 犯行は破壊される前に起きた
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge1-6-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

