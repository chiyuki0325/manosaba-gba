@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter04/Act02_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 9-1: 💬 ヒロが疑われる理由
# ==============================================================================
# ＠ト書き▼議論シーン9-1 ヒロが疑われる理由
# 議論開始エフェクト
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge9-1-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate 結局、<br>二階堂の前に<br>エレベーターに乗ったのは<br>誰なんだよ。

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01
@gosubModifyCamera 0
@printDebate お、おじさんになるのかな？

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01
@gosubModifyCamera 0
@printDebate でもそのときは<br>死体なんてなかったよ！

@char Hanna.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Surprised_Open
@gosubModifyCamera 0
@printDebate 上の階では<br>わたくしとシェリーさんが<br>ミリアさんが出てくるのを<br>見ていましたわ……。

@char Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "でもエレベーターの中には<br>エマさんの死体なんて<br><link=\"Objection_02_04_01_01\">ありません</link>でしたけどねー。"

@char Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "エレベーターの中に<br><link=\"Objection_02_04_01_02\">隠れられるところ</link>も<br>ありませんでしたし……。"

@char Miria.Default,ArmR4,ArmL3,Angle01/Facial/Eyes>Eyes_Surprised_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01
@gosubModifyCamera 0
@printDebate "つ、つまりおじさんは<br><link=\"Objection_02_04_01_03\">何もしてない</link><br>ってことだよ！"

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate じゃあやっぱり、<br>犯人は二階堂でしかねーだろ。

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate エレベーターが<br>下に降りてから、<br>二階堂が桜羽を殺した。

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate "……もしくは<br><link=\"Objection_02_04_01_04\">あらかじめ殺していた</link><br>死体を持ってきて、<br>見つけたフリをしたんだろ。"

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate それしか<br>考えられねーじゃねーか。


# ==============================================================================
# 9-1議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,ArmR2,ArmL4,Eyes1_Normal_Open1,Mouth1_Pensive_Closed1
@gosubModifyCamera 0
@Wait 0.2

@print （何が起こったのかを明らかにするには、<br>　状況を整理する必要がある） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,ArmR2,ArmL4,Eyes1_Normal_Open1,Mouth1_Pensive_Closed1
@print （１つ１つ可能性を潰し……<br>　その先にある真実を見つけるんだ！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge9-1-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_04_01_01

@Skip false
@pauseTrial true

@choice ３人全員が見落とした
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge9-1-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_04_01_02

@Skip false
@pauseTrial true

@choice 隠れる場所はあった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge9-1-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_04_01_03

@Skip false
@pauseTrial true

@choice ミリアが隠した
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge9-1-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論4
# ------------------------------------------------------------------------------

# Objection_02_04_01_04

@Skip false
@pauseTrial true

@choice 殺すヒマなどない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge9-1-5


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

