@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter04/Act02_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 9-10: 💬 証拠
# ==============================================================================
# ＠ト書き▼議論シーン9-10
# 議論開始エフェクト
# BGM変更：Guil-me N'o sinruits-Vocal有-
@bgm Bgm_8_1
# ボス演出
@ResetText 
@char Hanna.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Closed,Angle01/Head01/Facial01/Pale01>Pale01_01 { time:0 }
@stageCamera 1 { Rotation:0,{ (1 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:0,{ (0.9 / courtStandCount * 360) },0 time:1 }
@showStageScreen 1
@Wait 1.5

@ResetText 
@char Hiro.Angry2,ArmR6,ArmL9,Eyes2_Angry_Open2,Mouth1_Angry_Open1 { time:0 }
@stageCamera 0 { Rotation:0,{ (8 / courtStandCount * 360) },0 time:0 }
@WaitForNextFrame 

@stageCamera 0 { Rotation:0,{ (8.1 / courtStandCount * 360) },0 time:1 }
@hideStageScreen 1
@Wait 1.5

# Judge9-10-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Pale01>Pale01_01,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate わたくしが犯人だなんて証拠、<br>１つもありませんわ！

@char Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Closed,Angle01/Head01/Facial01/Pale01>Pale01_01
@gosubModifyCamera 0
@printDebate わたくしを<br>犯人扱いするだなんて<br>認められません！

@char Hanna.Normal1,ArmR1,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Surprised_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate "わたくしには<br><link=\"Objection_02_04_10_01\">エマさんを殺す動機</link>すら<br>ないんですからっ！"

@char Hanna.Default,ArmR1,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate "全てあなたの<link=\"Objection_02_04_10_02\">妄想</link>だわ！"

@char Hiro.Normal1,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate それを言うのなら、<br>私だって同じだ。

@char Hiro.Normal1,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate 証拠も動機もないよ。

@char Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Closed,Angle01/Head01/Facial01/Mouth01>Mouth01_Smile_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate はんっ……！<br>それはどうだか。

@char Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Flushed_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Flushed_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@gosubModifyCamera 0
@printDebate "あなたとエマさんは<br><link=\"Objection_02_04_10_03\">知り合いだった</link>のでしょう。"

@char Hanna.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open02,Angle01/Head01/Facial01/Pale01>Pale01_01
@gosubModifyCamera 0
@printDebate それに<br>普段のあなたたちの言動が<br>見られていないとでも<br>思ってますの！？

@char Hanna.Default,ArmR3,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open02
@gosubModifyCamera 0
@printDebate "あなたはエマさんを<br>嫌っていたし、<br>エマさんもあなたを<br><link=\"Objection_02_04_10_04\">嫌っていた</link>……！"

@char Hanna.Default,ArmR2,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Open01,Angle01/Head01/Facial01/Pale01>Pale01_01
@gosubModifyCamera 0
@printDebate なら殺す動機なんて<br>十分でしょう！

@char Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Fearful_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Cry_Open
@gosubModifyCamera 0
@printDebate あらゆる面において、<br>わたくしよりもあなたの方が<br>犯人としてふさわしいわ！



