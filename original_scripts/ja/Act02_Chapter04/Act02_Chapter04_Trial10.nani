@ResetText 
@char Hiro.Pensive1,Arms3
@gosubModifyCamera 0
@Wait 0.2

@print （……耳が痛いな） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Pensive1,Arms3
