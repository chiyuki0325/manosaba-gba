# 議論パート2章4話（議論9）

# Judge9-1-0

@char Hiro.Normal1,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Open1 { time:0 }
@char Alisa.Angry1,Option-ArmL-Off

@stageCamera 0 { time:0 }
@stageCamera 1 { Rotation:-2,{ (7.7 / courtStandCount * 360) },-2 time:0 }
@WaitForNextFrame 

@stageCamera 1 { Rotation:-1,{ (13.2 / courtStandCount * 360) } time:40 }
@back Transparent { time:0.9 }
@Wait 0.6

@ProcessInput true

@badId 7

