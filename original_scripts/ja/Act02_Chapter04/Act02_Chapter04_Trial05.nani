@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter04/Act02_Chapter04_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@badId 7

# ==============================================================================
# MARK: 9-5: 💬 ヒロ以外犯行不能な理由
# ==============================================================================
# ＠ト書き▼議論シーン9-5 ヒロ以外犯行不能な理由
# 議論開始エフェクト
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge9-5-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate "二階堂の話によれば、<br>エレベーターの中には<br><link=\"Objection_02_04_05_01\">桜羽の死体</link>が入って<br>降りてきたってことだろ。"

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate んで、<br>エレベーターの上には<br>蓮見の死体があった。

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate ならその時点で<br>二階堂の話は<br>破綻してやがる。

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate "二階堂以外に、<br>犯人がエレベーターに<br><link=\"Objection_02_04_05_02\">乗ること</link>は<br>できなかったんだよ。"

@char Sherry.Default,ArmR17,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Middle
@gosubModifyCamera 0
@printDebate それに上の階には<br>３人が揃っていましたしね！

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate ウチが<br>エレベーターに入ろうにも、<br>誰かが見ることに<br>なるはずだ……。

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate "二階堂の証言でも、<br>誰かが乗れるような<br><link=\"Objection_02_04_05_03\">時間はなかった</link>んだろ？"

@char Alisa.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate "なら犯人はどこにもいねー。<br><link=\"Objection_02_04_05_04\">おめえ以外は</link>な。"


# ==============================================================================
# 9-5議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,Arms3,Eyes1_Normal_Closed1,Mouth1_Angry_Closed1
@gosubModifyCamera 0
@Wait 0.2

@print （死体発見の状況は、アリサの説明する通りだ） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@print （だが私は殺していない） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal1,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@print （なら犯人は誰で、どこにいたのか……） { author:Hiro speed:1 waitInput:true Wait:true }

@char Hiro.Normal2,ArmR6,ArmL9,Eyes2_Normal_Closed1,Mouth2_Angry_Closed1,Sweat2-1
@print （この謎を解くには、<br>　もう少し状況を整理する必要があるか……） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge9-5-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_04_05_01

@Skip false
@pauseTrial true

@choice エマは死んでなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge9-5-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

