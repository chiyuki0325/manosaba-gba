@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-1: 💬 死体の発見状況について
# ==============================================================================
# ＠ト書き▼議論3-1 死体の発見状況について
# カットイン

# Judge3-1-1

# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate 死体が発見されたのは<br>屋敷のはずれにある<br>ゲストハウスよ。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@gosubModifyCamera 0
@printDebate そのうちの１つの、<br>火精の間ね。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate 死体は部屋の中で<br>首を吊られた状態で<br>発見された……。<br>死因は間違いなく<br>【窒息死】よ。

@char Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open
@gosubModifyCamera 0
@printDebate 間違いなく……って、<br>そんな簡単に<br>断言していいのかよ。

@char Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate 私はお医者様や<br>検視官じゃないから<br>詳しくはわからないけど……。

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate でも、<br>首にはしっかりと<br>ロープの痕が<br>残っていたわ？

@char Margo.Default,ArmR6,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate 強い力で首が絞まった……<br>となれば<br>それが死因だと考えるのが<br>妥当な推理じゃないかしら？

@char Meruru.Normal1
@gosubModifyCamera 0
@printDebate ハンナさんの身に……<br>何が起こったのでしょうか。

@char Meruru.ArmR1_1,ArmL8,Eyes1_Pensive_Open2,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate "も、もしかしたら、<br>犯人なんていなくて……<br><link=\"Objection_01_03_01_01\">【事故】</link>だったりした<br>可能性はないでしょうか？"

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate んなわけねーだろ！<br>どうやったら<br>事故で首<br>吊れるんだよ！

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate あら、<br>小さな可能性でも<br>否定できないのであれば<br>検討すべきじゃないかしら？

@char Margo.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "たとえば……<br><link=\"Objection_01_03_01_02\">【自殺】</link>だった<br>可能性とかもね。"

@char Coco.Default,ArmR3,ArmL2,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Pensive_Open
@gosubModifyCamera 0
@printDebate つかこんな状況、<br>誰かが殺したに<br>決まってんだろ！？

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Angry_Open01
@gosubModifyCamera 0
@printDebate "他殺だよ<link=\"Objection_01_03_01_03\">【他殺】</link>！"

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1,ArmR3,ArmL6 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

