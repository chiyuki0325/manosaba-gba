@char Ema.Default,ArmR3,ArmL6
@print （ハンナちゃんのこと……<br>　もう一度詳しく思い返してみよう） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge3-1-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_03_01_01

@Skip false
@pauseTrial true

@choice 事故ではない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge3-1-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

