@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-9: 💬 昨夜起こった事
# ==============================================================================
# ＠ト書き▼議論3-9 昨夜起こった事
# カットイン
# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

# Judge3-9-1


@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate 昨夜、<br>マーゴちゃんたちが<br>出たあとで<br>ゲストハウスには<br>鍵がかけられた……。

@char Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate つまり、<br>部屋は３棟とも<br>密室状態だったってことで<br>いいんだよね？

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate ええ。<br>その通りよ。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "そのとき部屋の中は<br><link=\"Objection_01_03_09_01\">荒れていなかった</link>し、<br><link=\"Objection_01_03_09_02\">死体もなかった</link>はずよ。"

@char Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate そして夜に起こったのは<br>ナノカちゃんと<br>シェリーちゃんの<br>いざこざ……。<br>この時の破裂音は【１回】。<br>銃声だった。

@char Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate "……ええ。<br><link=\"Objection_01_03_09_03\">場所は倉庫</link>。<br>間違いないわ。"

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate そしてその後……<br>アリサちゃんは<br>【２時】頃にも音を聞いた。<br>この内容は<br>まだ明らかになってないよね。

@char Meruru.Normal2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Surprised_Open2
@gosubModifyCamera 0
@printDebate そしてそれは、<br>地震だとは<br>考えにくい……<br>議論の結果は<br>そうなったはずです。

@char Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate "もし地震なら<br>水精の間も揺れて<br><link=\"Objection_01_03_09_04\">家具が倒れていた</link><br>でしょうし……。<br>結局密室については<br>わからないまま<br>ですね……。"

@char Sherry.Normal1
@gosubModifyCamera 0
@printDebate "いっそ【密室ではなかった】<br>というのはどうでしょう？<br>そもそも<br><link=\"Objection_01_03_09_05\">鍵</link>はちゃんと<br>かけられていたんでしょうか？<br>……実は<link=\"Objection_01_03_09_06\">ピッキング</link>で<br>開けられたとかありません？"

@char Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate でもそもそも朝の時点で<br>鍵はかかっていたはずだよ。<br>仮に犯人が鍵を開けて<br>侵入できたとしても……<br>鍵をかけ直す<br>必要があったんだ。

@char Coco.Normal1,ArmR3,ArmL2
@gosubModifyCamera 0
@printDebate つか、それなら<br>部屋に細工されてた<br>可能性は？<br>もともとなんか<br>仕掛けがあったとかさー。

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate "見つかってない<br><link=\"Objection_01_03_09_07\">隠し通路</link>が<br>あるってのか？<br>でも中はさんざん<br>調べたんだ。<br>部屋自体は<link=\"Objection_01_03_09_08\">普通の部屋</link><br>だったんだし。"

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate "どうかしらね？<br><link=\"Objection_01_03_09_09\">昨夜の実験</link>で、<br>つながってはいけない<br>世界への道が<br>繋がってしまったのかも<br>しれないわ？"

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate ……ともかくそうして朝、<br>火事が起こって<br>死体は発見された。<br>火元は火精の間の<br>外だった……。

@char Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open01
@gosubModifyCamera 0
@printDebate "……ああ、間違いない。<br>調べたけど、<br>火事は<br><link=\"Objection_01_03_09_10\">外からの放火</link>だった。"

@char Nanoka.ArmR3,ArmL1,Eyes1_Normal_Open2,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "それによって私たちは<br>駆けつけた……。<br>……当然、事件後に<br>密室の中から<br><link=\"Objection_01_03_09_11\">出てきた人</link>は<br>いなかった。"

@char Nanoka.ArmR3,ArmL1,Eyes1_Normal_Open2,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "……被害者である<br><br><link=\"Objection_01_03_09_12\">遠野ハンナ</link>を除けばね。"

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 3-9議論後独白
# ==============================================================================

@print （これが昨日起こったこと……。<br>　一見すると誰にもできない密室殺人……） { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
@char Meruru.Normal2,ArmR1_2,ArmL3,Eyes2_Normal_Open1,Mouth2_Angry_Open2
@gosubSplitStageScreen 1
@Wait 0.2

@print エマさん……！<br>もしかしたら、まだ私たちの知らない情報が<br>あるのかもしれません……。 { author:Meruru speed:1 waitInput:true Wait:true }

@char Meruru.Normal2,ArmR1_2,ArmL3,Eyes2_Normal_Open1,Mouth2_Angry_Open2
@print もし事件の真相がわからないなら……<br>皆さんのお話を聞いてみましょう！ { author:Meruru speed:1 waitInput:true Wait:true }

@hideStageScreen 1
@Wait 0.3

@goto .Judge3-9-1
