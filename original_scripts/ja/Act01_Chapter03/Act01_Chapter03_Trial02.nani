@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-2: 💬 ハンナが自殺の理由
# ==================================================
# ＠ト書き▼議論3-2 ハンナが自殺の理由
# カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge3-2-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate "ハンナちゃんが<br>発見された時の<br>様子からして、<br>あれは<link=\"Objection_01_03_02_01\">【首吊り自殺】</link>よ。"

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate 現場にはロープもあったし、<br>踏み台になるような物も<br>あった……。

@char Margo.Smile1,ArmR4,ArmL5
@gosubModifyCamera 0
@printDebate "それにさっき<br>議論した通り<br>ハンナちゃんは<br><link=\"Objection_01_03_02_02\">浮くことができた</link>わ。"

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate ハンナちゃんは<br>踏み台なんて使わなくても<br>自分で縄をかけれたのよ。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "……まああえて言うなら、<br>多少部屋の中が<br><link=\"Objection_01_03_02_03\">荒らされていた</link>ことは<br>不自然といえば<br>不自然かしら？"

@char Margo.Default,ArmR1,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "でも自殺するぐらい<br><link=\"Objection_01_03_02_04\">錯乱</link>していたなら<br>ハンナちゃんがやったとしても<br>不自然ではないわね。"

@char Margo.Default,ArmR1,ArmL4,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "これらは全て<br>ハンナちゃんの自殺として<br>説明できること……<br>この事件、ゲストハウスには<br>それ以外何も<link=\"Objection_01_03_02_05\">おかしなこと</link>は<br>起きてないと思うけど？"


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

