@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-3: 💬 放火魔
# ==============================================================================
# ＠ト書き▼議論3-3 放火魔
# カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

@badId 5

# Judge3-3-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Coco.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate 放火って言ったら<br>簡単にできるヤツが<br>いるじゃん？<br>そいつなら火なんて<br>付け放題っしょ？

@char Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate てめぇ……<br>ウチがやったって<br>言ってんのか？

@char Coco.Default,ArmR4,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate だって一番<br>怪しいんだから、<br>疑うのは当然じゃん。

@char Coco.Default,ArmR4,ArmL1,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate ……あんだったら<br>好きなタイミングで<br>火を<br>燃え上がらせる事だって<br>できるわけだし？

@char Coco.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_03_03_01\">燃やして証拠隠滅</link><br>しようと思った<br>って、<br>簡単にできんのは<br>あんたしかいねーんだよ！"

@char Coco.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Gross_Open,Angle01/Facial/Mouth>Mouth_Smile_Open
@gosubModifyCamera 0
@printDebate "それとも<br><link=\"Objection_01_03_03_02\">勝手に燃え上がった</link><br>とか言うわけ！？<br>んなことあるわけ<br>ないじゃん！"

@char Alisa.Default,ArmR9,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Closed
@gosubModifyCamera 0
@printDebate "……燃える時間を<br>自由に<link=\"Objection_01_03_03_03\">調整</link><br>できるほど<br>器用じゃねーよ。"

@char Sherry.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate しかし、<br>現場には<br>燃やしたくなるほどの<br>重要な証拠があった……<br>……ということ<br>なんでしょうか？

@char Nanoka.ArmR3,ArmL1,Eyes1_Normal_Open2,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "……でもそんな<link=\"Objection_01_03_03_04\">証拠</link>、<br>本当に残されて<br>いたのかしら。"

@char Meruru.Head1,ArmR1_1,ArmL8,Eyes1_Pensive_Open2,Mouth1_Normal_Open2
@gosubModifyCamera 0
@printDebate なんにせよ……<br>部屋が燃え尽きなくて<br>良かったです。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

# ==============================================================================
# 3-3議論後独白
# ==============================================================================

@print （メルルちゃんの言う通り、<br>　証拠が燃えなくて良かった……） { author:Ema speed:1 waitInput:true Wait:true }

@ResetText 
@char Meruru.Head2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Surprised_Open2
@gosubSplitStageScreen 1
@Wait 0.2

@print ……あ、あの……エマさん。<br>【死体の状況】を考えると、<br>さっきの話に違和感がありませんか……？ { author:Meruru speed:1 waitInput:true Wait:true }

@char Ema.Surprised1
@print （違和感……？<br>　それって……） { author:Ema speed:1 waitInput:true Wait:true }

@hideStageScreen 1

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed
@print （もしハンナちゃんが他殺なら、<br>　みんなの話と食い違う部分があるのかも……） { author:Ema speed:1 waitInput:true Wait:true }

@goto .Judge3-3-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_01_03_03_01

@Skip false
@pauseTrial true

@choice 証拠隠滅が目的ではない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge3-3-2

@choice 犯人は火をつけるつもりはなかった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge3-3-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_01_03_03_02

@Skip false
@pauseTrial true

@choice 自動で発火した
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge3-3-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

