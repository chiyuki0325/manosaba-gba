@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-12: 💬 建物が動いた証拠
# ==============================================================================
# ＠ト書き▼議論3-12 建物が動いた証拠
# カットイン
@bgm Bgm_15_1

# Judge3-12-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Sherry.Default,ArmR9,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 写真から見える景色が<br>違うと言いますが、<br>それは本当に<br>同じ場所から<br>撮られたもの<br>なんでしょうか？

@char Sherry.Default,ArmR3,ArmL3,Angle01/Facial/Eyes>Eyes_Normal_Closed04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "私たちと看守さんは<br><link=\"Objection_01_03_12_01\">身長</link>が違います。<br>それに<br>まったく<link=\"Objection_01_03_12_02\">同じ場所</link>に立って<br>撮ったなんてこと、<br>断言できますかね～？"

@char Ema.Default,ArmR7,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open
@gosubModifyCamera 0
@printDebate ……でも、<br>中から見える景色は<br>明らかに違っているよ。<br>火精の間の<br>角度がズレてるんだ。

@char Ema.Default,ArmR7,ArmL10,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open
@gosubModifyCamera 0
@printDebate だからあの建物は……<br>動かされたに<br>違いないよ！

@char Sherry.Default,ArmR17,ArmL12,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate "いやいや、たしかに<br>動いた可能性はありますけど、<br>誰かが<link=\"Objection_01_03_12_03\">持ち上げた痕跡</link>は<br>ないじゃないですか！<br>地盤が不安定で、<br>角度がズレたのかも<br>しれませんよ？"

@char Sherry.Default,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_03_12_04\">トリックがあった</link><br>という推理は<br>私も同意します。<br>でも動かしたとまで<br>決めつけるのは、<br>早計だと思いますけどね～。"

@char Sherry.Default,ArmR3,ArmL12,Angle01/Facial/Eyes>Eyes_Normal_Closed02,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate たとえば……<br>現段階で<br>トリックの仕掛けが<br>見つけられてないだけの<br>可能性もあるじゃないですか。

@char Sherry.Default,ArmR3,ArmL1,Angle01/Facial/Eyes>Eyes_Flushed_Closed01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_03_12_05\">Ｘ線検査</link>を<br>したわけでもないですし<br>隠し通路なんかある<br>可能性はまだまだあると<br>思うんですよね！"

@char Sherry.Default,ArmR3,ArmL11,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "それとも……<br>私が<br><link=\"Objection_01_03_12_06\">ハンナさんを殺した</link>り、<br><link=\"Objection_01_03_12_07\">あの現場にいた</link><br>という証拠でも<br>あるんですか？"

@char Sherry.Default,ArmR11,ArmL10,Angle01/Facial/Eyes>Eyes_Wink_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate 全部エマさんの<br>推測で……<br>証拠なんて<br>何もありませんっ！

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Default,ArmR7,ArmL7,Angle01/Head01/Facial01/Eyes01>Eyes01_Pensive_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Nervous_Closed { time:0 }
@gosubModifyCamera 0
@Wait 0.2

