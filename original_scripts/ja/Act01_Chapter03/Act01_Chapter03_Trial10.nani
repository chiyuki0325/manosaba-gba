@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-10: 💬 ゲストハウスの秘密
# ==============================================================================
# ＠ト書き▼議論3-10 ゲストハウスの秘密
# カットイン
# BGM変更：AccUhEarts(Vocal無)
@bgm Bgm_15_1

@badId 4

# Judge3-10-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@gosubModifyCamera 0
@printDebate あの部屋には何か<br>特別な仕掛けがあったのは<br>間違いないよ……！

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate でも……<br>そんなん、<br>何も見つかってねーぞ。

@char Nanoka.ArmL5,Angle01/ArmR-,Eyes1_Normal_Open2,Mouth1_Surprised_Open1
@gosubModifyCamera 0
@printDebate ……私は<br>桜羽エマの意見に<br>賛成よ。<br>そうでないと、<br>密室に説明が<br>つかないもの。

@char Sherry.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open01,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "あるとすれば……<br>やっぱり<link=\"Objection_01_03_10_01\">隠し通路</link><br>でしょうか？<br>どこかに<br>繋がっているのかも<br>しれません！"

@char Meruru.Normal1
@gosubModifyCamera 0
@printDebate そんな大掛かりな<br>仕掛け……<br>本当に<br>ありえるんで<br>しょうか……？

@char Nanoka.ArmR3,ArmL1,Eyes1_Normal_Open2,Mouth1_Angry_Open1
@gosubModifyCamera 0
@printDebate "もっと簡単な仕掛けって<br>いうのなら……<br>実は扉の<br><link=\"Objection_01_03_10_02\">鍵の開閉</link>が<br>操作できたとか……<br><link=\"Objection_01_03_10_03\">スペアキー</link>が<br>あったとかかしら。"

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "他には、<br>部屋の一部が<br>透明になったり……<br><link=\"Objection_01_03_10_04\">視覚を誤魔化す</link>ような<br>仕掛けがあったとかはどう？<br>鏡とか……<br>屈折レンズの仕掛けとかね。"

@char Coco.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open02,Angle01/Facial/Mouth>Mouth_Gross_Open
@gosubModifyCamera 0
@printDebate "……そんなん言い出したら、<br>もうなんでもありじゃん！<br>だったらもういっそ<br><link=\"Objection_01_03_10_05\">ワープ装置</link>でも<br>あったって事にする！？<br><link=\"Objection_01_03_10_06\">入れ替わった</link>りするヤツ！"

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate "まあそこまでは<br>いかなくても……<br>あの建物自体、<br><link=\"Objection_01_03_10_07\">解体</link>が可能だった<br>とかはどうだ？<br>簡単に全部バラせるなら、<br>密室なんて関係ねーだろ。"


