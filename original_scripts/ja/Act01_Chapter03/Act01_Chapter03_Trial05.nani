@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-5: 💬 アリサの聞いた音
# ==============================================================================
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge3-5-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Alisa.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open
@gosubModifyCamera 0
@printDebate 最初の音は<br>夜の【１時】だったな。<br>ちょうどスマホで<br>時間を確認した時だったから<br>間違いないと思う。

@char Alisa.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open
@gosubModifyCamera 0
@printDebate 【１時】に<br>何かの【破裂音】、<br>もしくは【爆発音】<br>みたいな……。

@char Alisa.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_03_05_01\">爆竹</link>とか<br>そういうのに近い音が<br>【１回】した。"

@char Sherry.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Normal_Open03,Angle01/Facial/Mouth>Mouth_Surprised_Open
@gosubModifyCamera 0
@printDebate どこからした音とかは<br>わからないんですか？

@char Alisa.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open
@gosubModifyCamera 0
@printDebate "たしか<link=\"Objection_01_03_05_02\">倉庫</link>の方<br>だった気がするな……。<br>確証はねーけど。"

@char Alisa.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open
@gosubModifyCamera 0
@printDebate "もう１つの音は……<br>夜の【<link=\"Objection_01_03_05_03\">２時</link>】ぐらい<br>だったと思う。"

@char Alisa.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open
@gosubModifyCamera 0
@printDebate こっちは……<br>説明するのが<br>難しい音だったな。<br>爆発って感じじゃ<br>なかったが……<br>あまり間を置かず<br>２、３回……<br>何度かしたと思う。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "【<link=\"Objection_01_03_05_04\">直下型の地震</link>】でも<br>起こったのかしらね？<br>現場では<br>部屋の中の家具が<br>倒れてたりしたし。"

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@gosubModifyCamera 0
@printDebate ああ。<br>そんな感じが近いかな。<br>……ただ、<br>揺れた感じは<br>しなかったけどな。

@char Coco.Normal1,ArmR3,ArmL2
@gosubModifyCamera 0
@printDebate 地震なんてあったら<br>もっとみんな気付いてると<br>思うけど。<br>勘違いだったんじゃね？

@char Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Angry_Open02
@gosubModifyCamera 0
@printDebate "ああ……！？<br>んなわけねぇだろ……！<br>ウチの<br><link=\"Objection_01_03_05_05\">勘違いだった証拠</link>でも<br>あんのか！？"


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

