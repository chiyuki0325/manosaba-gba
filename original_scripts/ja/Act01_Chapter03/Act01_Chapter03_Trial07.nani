@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act01_Chapter03/Act01_Chapter03_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

@char Warden.1 { Position:,{hiddenCharacterPositionY} time:0 }
@char Jailer.1 { Position:,{hiddenCharacterPositionY} time:0 }
# ==============================================================================
# MARK: 3-7: 💬 アリサの落とし物
# ==============================================================================
# カットイン
# BGM変更：rAwTell Owk...
@bgm Bgm_7_1

# Judge3-7-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Normal_Closed
@gosubModifyCamera 0
@printDebate あれは昨日の魔法の……<br>勉強だか研究だかで<br>使ったもんだ。

@char Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@gosubModifyCamera 0
@printDebate "ええ、そうね。<br>たしかにそれが<br>地精の間にあるなんて<br><link=\"Objection_01_03_07_01\">おかしい</link>わ。<br>火精の間に<br>置いていったんですもの。"

@char Sherry.Default,ArmR2,ArmL4,Angle01/Facial/Eyes>Eyes_Normal_Open04,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate ゲストハウスは<br>昨晩どの部屋も<br>密室だったはずです。<br>だとすると、<br>人形は時空間を<br>超越したことに<br>なっちゃいますよ？

@char Meruru.Normal1
@gosubModifyCamera 0
@printDebate となると<br>考えられる可能性は……<br>【魔法】……<br>でしょうか……？

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_03_07_02\">【テレポート】</link>、<br><link=\"Objection_01_03_07_03\">【すり抜け】</link>、<br><link=\"Objection_01_03_07_04\">【透明化】</link>……<br>そのあたりの<br>魔法が使えたら<br>密室を無視することも<br>できるのかしら？"

@char Alisa.Default,ArmR9,ArmL2,Angle01/Facial/Eyes>Eyes_Angry_Closed
@gosubModifyCamera 0
@printDebate んなもん<br>誰が使えんだよ！

@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate さあ？<br>もしかするとこの中には<br>いないのかもしれないわ？

# ＠備考◆脅かす
@char Margo.Smile1,ArmR2,ArmL5
@gosubModifyCamera 0
@printDebate "<link=\"Objection_01_03_07_05\">【第三者】</link>や<br><link=\"Objection_01_03_07_06\">【幽霊】</link>……<br>昨日の実験で<br><link=\"Objection_01_03_07_07\">良くない者</link>を<br>呼び出したり<br>してしまったのかも<br>しれないわね？"

# ＠備考◆恐怖
@char Coco.Fearful1
@gosubModifyCamera 0
@printDebate そんなん……<br>嘘でしょぉ……。

@char Margo.Default,ArmR2,ArmL5,Angle01/Facial/Eyes>Eyes_Normal_Open,Angle01/Facial/Mouth>Mouth_Normal_Open
@gosubModifyCamera 0
@printDebate "でもそうでもないと、<br>あの<link=\"Objection_01_03_07_08\">部屋の状況</link>は<br>説明できないもの。"

@char Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open1,Mouth1_Normal_Open1
@gosubModifyCamera 0
@printDebate 超常現象を<br>否定はしないけれど、<br>何が起こったのか<br>わからずに<br>受け入れるわけには<br>いかないわ。

@char Meruru.Head2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Surprised_Open2
@gosubModifyCamera 0
@printDebate "なら……<br>逆にどんな<link=\"Objection_01_03_07_09\">現象</link>が<br>起こったのか<br>考えてみるのは<br>どうでしょう？<br>たとえば……<br>天気とか、風の影響とか……。"

# ＠備考◆悔しげ
@char Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open01
@gosubModifyCamera 0
@printDebate そんな自然現象に<br>遠野が殺されて……<br>たまるかよ。


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Ema.Pensive1 { time:0 }
@gosubModifyCamera 0
@Wait 0.2

