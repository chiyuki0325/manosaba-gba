# ==============================================================================
# テキストプリンター
# ==============================================================================

# TextPrinter

@back SolidColor

@print "Debug_Actors # TextPrinter" { speed:1 waitInput:true Wait:true }

# @char Sherry pos:50,50

@print 「ああそれは、良い情報ですね！<br>　１分しか浮けないなら、<br>　足跡残さず殺すのは無理だって言えるかも！」 { author:Sherry speed:1 waitInput:true Wait:true }

@print "-+<sprite name=\"DashLeft\">+<sprite name=\"DashMiddle\">+<sprite name=\"DashRight\">+-" { speed:1 waitInput:true Wait:true }

@print "戻る<sprite name=\"Return\">" { speed:1 waitInput:true Wait:true }

@print "第一話<sprite name=\"Sparkles\">" { speed:1 waitInput:true Wait:true }

@print "PRESS <sprite name=\"GamePadButton_A\"> Button" { speed:1 waitInput:true Wait:true }

@print aaa { speed:1 waitInput:true Wait:true }

@print bbb { speed:1 waitInput:true Wait:true }

@print ccc { speed:1 waitInput:true Wait:true }

@print ddd { speed:1 waitInput:true Wait:true }

@print eee { speed:1 waitInput:true Wait:true }

@HidePrinter 
@back SolidColor { time:1 }
@i 

@Return 

