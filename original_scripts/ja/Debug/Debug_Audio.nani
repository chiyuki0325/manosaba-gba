# Bgm

@print "Debug_Audio # Bgm" { speed:1 waitInput:true Wait:true }

@print "Bgm_1_1 を再生します。" { speed:1 waitInput:true Wait:true }

@bgm Bgm_1_1

@print "Bgm_1_1 を再生中です。" { speed:1 waitInput:true Wait:true }

@StopBgm 

@print "Bgm_1_1 を停止しました。" { speed:1 waitInput:true Wait:true }

@print "Bgm_2_1 を再生します。" { speed:1 waitInput:true Wait:true }

@bgm Bgm_2_1_Loop

@print "Bgm_2_1 を再生中です。" { speed:1 waitInput:true Wait:true }

@StopBgm 

@print "Bgm_2_1 を停止しました。" { speed:1 waitInput:true Wait:true }

@Return 

