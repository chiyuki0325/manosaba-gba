@set "stageName=\"Court\""
@set "courtStandCount = 13"

@set "emaIdx = 11"
@set "hiroIdx = 1"
@set "meruruIdx = 2"
@set "hannaIdx = 3"
@set "sherryIdx = 4"
@set "ananIdx = 5"
@set "leiaIdx = 6"
@set "cocoIdx = 7"
@set "miriaIdx = 8"
@set "margoIdx = 9"
@set "noahIdx = -1"
@set "nanokaIdx = -1"
@set "alisaIdx = -1"
@set "yukiIdx = 10"
@set "wardenIdx = 0"
@set "jailerIdx = 12"

@Gosub System/System_Subroutine.BeginTrial

@back Transparent { time:0 }
@ProcessInput true

@Gosub .PerspectiveStage
# @gosub .PresentEvidence
# @gosub .Map
# @gosub .Reenact
# @gosub .DebateText
# @gosub .Timer

@Stop 

# ==============================================================================
# ステージ
# ==============================================================================

# PerspectiveStage

@Skip true

@hideStageScreen 1 { time:0 }
@print "Debug_Trial # PerspectiveStage" { speed:1 waitInput:true Wait:true }

@stageCamera 0 { time:0 }
@print "Camera modified." { speed:1 waitInput:true Wait:true }

@Skip false
@hide Warden
@print "Hide warden." { speed:1 waitInput:true Wait:true }

@char Warden.2
@print "Re-show Warden." { speed:1 waitInput:true Wait:true }

@hide Warden
@print "Hide warden." { speed:1 waitInput:true Wait:true }

@char Warden.3
@print "Re-show Warden." { speed:1 waitInput:true Wait:true }

@ResetText 
@stageCamera 0 { time:1 }
@i 

@stageCamera 0 { time:1 }
@i 

@stageCamera 0 { time:1 }
@i 

@stageCamera 0 { time:1 }
@i 

@stageCamera 0 { time:1 }
@i 

@stageCamera 0 { time:1 }
@i 

@stageCamera 0 { Rotation:,{ (4 / courtStandCount * 360) } time:2 }
@i 

@char Ema.Angry { time:0 }
@stageCamera 1 { Rotation:-2,{ (0.16 / courtStandCount * 360) },5 time:0 }
@showStageScreen 1
@print "Another camera enabled." { speed:1 waitInput:true Wait:true }

@hideStageScreen 1
@print "Another camera disabled." { speed:1 waitInput:true Wait:true }

@ResetText 
@stageCamera 0 { Rotation:,{ (2.9 / courtStandCount * 360) } time:1.5 }
@i 

@splitStageScreen 1
@showStageScreen 1
@print "Another screen split and shown." { speed:1 waitInput:true Wait:true }

@hideStageScreen 1
@print "Hide another screen." { speed:1 waitInput:true Wait:true }

# --------------------------------------
# @back Transparent subId:Overlay tint:#ff6633 time:0
# @waitForNextFrame

# @back SolidColor subId:Overlay time:0.2 wait!

# @bgm Ambi_102_1 volume:0.2
# @shakeStageCamera 0 force:0.4,-0.2,0 frequency:50 damp:1 time:3
# @courtFire
# @back Transparent subId:Overlay time:1.2 wait!
# Enable fire vfx.

# @stopBgm Ambi_102_1
# @resetText
# @back SolidColor subId:Overlay time:0.2 wait!

# @courtFire false
# @back Transparent subId:Overlay time:0.6
# Disable fire vfx.

# @shakeStageCamera 0 force:0.5,0,0 frequency:5 damp:2 !random time:0.5
# Punch camera X.

# @shakeStageCamera 0 force:0,1,0 frequency:12 damp:1.5 !random time:1
# Punch camera Y.

# @shakeStageCamera 0 force:2,-1.5,0 frequency:70 damp:1 !random time:5
# Punch camera XY.

# @shakeStageCamera 0 force:0.5,0,0 frequency:5 damp:2 random! time:0.5
# Shake camera X.

# @shakeStageCamera 0 force:0,1,0 frequency:12 damp:1.5 random! time:1
# Shake camera Y.

# @shakeStageCamera 0 force:2,-1.5,0 frequency:70 damp:1 random! time:5
# Shake camera XY.
# --------------------------------------

@hideChars 

@print "Ccharacters hidden." { speed:1 waitInput:true Wait:true }

@unloadStage 

@print "Stage unloaded." { speed:1 waitInput:true Wait:true }

@print "Debug_Trial # PerspectiveStage ends." { speed:1 waitInput:true Wait:true }

@Return 

# ==============================================================================
# 証拠提示
# ==============================================================================

# PresentEvidence

@print "Debug_Trial # PresentEvidence" { speed:1 waitInput:true Wait:true }

@set "currentHp = maxHp"
@timer 4
@debate true

@print "Debug_Trial # PresentEvidence ends." { speed:1 waitInput:true Wait:true }

@Return 

# ==============================================================================
# マップ演出
# ==============================================================================

# Map

@set "timelineIdx = 0"

@print "Debug_Trial # Map" { speed:1 waitInput:true Wait:true }

# Map_A01C01_01

@set "map=\"Map_A01C01_01\""
@set "message=\"マップ表示：地下1F監獄エリア\""
@Gosub .MapSpawn

@set "message=\"アイコン配置：沢渡ココ、佐伯ミリア、蓮見レイア<br>——牢獄入口側\""
@Gosub .MapSpawn

@set "message=\"アイコン点滅：沢渡ココ、佐伯ミリア、蓮見レイア<br>——３回／２秒程度\""
@Gosub .MapSpawn

@set "message=\"アイコン移動：沢渡ココ、佐伯ミリア、蓮見レイア<br>——城ケ崎ノアの部屋前\""
@Gosub .MapSpawn

@Gosub .MapDespawn

# Map_A01C01_02

@set "map=\"Map_A01C01_02\""
@set "message=\"マップ表示：1F\""
@Gosub .MapSpawn

@set "message=\"アイコン配置：沢渡ココ、佐伯ミリア、蓮見レイア<br>——ラウンジ\""
@Gosub .MapSpawn

@Gosub .MapDespawn

# Map_A01C01_03

@set "map=\"Map_A01C01_03\""
@set "message=\"マップ表示：2F\""
@Gosub .MapSpawn

@set "message=\"アイコン配置：桜羽エマ、橘シェリー、遠野ハンナ、氷上メルル<br>——娯楽室\""
@Gosub .MapSpawn

@set "message=\"アイコン配置：宝生マーゴ、紫藤アリサ、黒部ナノカ<br>——娯楽室\""
@Gosub .MapSpawn

@Gosub .MapDespawn

# Map_A01C02_01

@set "map=\"Map_A01C02_01\""
@set "message=\"マップ表示：B1F<br>アイコン表示：遠野ハンナ、夏目アンアン\""
@Gosub .MapSpawn

@set "message=\"アイコン表示：遠野ハンナ、夏目アンアン\""
@Gosub .MapSpawn

@set "message=\"アイコン移動：遠野ハンナ、夏目アンアン<br>マップ表示切り替え：1F<br>アイコン移動：遠野ハンナ、夏目アンアン<br>——医務室\""
@Gosub .MapSpawn

@Gosub .MapDespawn

# Map_A01C02_02

@set "map=\"Map_A01C02_02\""
@set "message=\"アイコン移動：遠野ハンナ 医務室——地下への階段 アイコン表示：沢渡ココ 食堂側廊下 アイコン移動：遠野ハンナ、沢渡ココ 階段 マップ表示切り替え：B1F アイコン移動：遠野ハンナ、沢渡ココ 階段——懲罰房\""
@Gosub .MapSpawn

@Gosub .MapDespawn

# Map_A01C03_01

@set "map=\"Map_A01C03_01\""
@set "message=\"屋敷の見取り図表示\""
@Gosub .MapSpawn

@Gosub .MapDespawn

@print "Debug_Trial # Map ends." { speed:1 waitInput:true Wait:true }

@Return 

#
# マップ演出開始
# ------------------------------------------------------------------------------

# MapSpawn

@print "@spawn {map} params:{timelineIdx}<br>{message}"
@spawn "{map}" { Params:{timelineIdx} }
@set timelineIdx++
@i 

@Return 

#
# マップ演出終了
# ------------------------------------------------------------------------------

# MapDespawn

@print "@despawn {map}"
@despawn "{map}"
@set "timelineIdx = 0"
@i 

@Return 

