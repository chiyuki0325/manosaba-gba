# ==============================================================================
# 議論テキスト
# ==============================================================================

# DebateText

# @back Grid_1 time:0

@print "Debug_Trial # DebateText" { speed:1 waitInput:true Wait:true }

#
# 議論開始
# ------------------------------------------------------------------------------

# JudgeDebug1-1

@timer 600
@Gosub System/System_Subroutine.BeginDebate

@printDebate "死体の後ろ、そして周囲……<br>そこに<link=\"Objection_90_01_01_01\">血で描かれた</link>蝶の絵が<br>描かれているんです！"

# @printDebate もう一度現場に残された絵を<br>思い出してみてください。<br>立派な蝶の模様が描かれていますよね？|#Trial1001_Sherry0017| pos:40,40 roll:5

# @printDebate そしてマーゴさんの衣装には……<br>蝶があしらわれています|#Trial1001_Sherry0018| pos:60,60 roll:-5

# @printDebate たしかに用意された私の衣装には、<br>蝶をモチーフにした飾りがついているわね|#Trial1001_Margo0008| pos:50,50 roll:0

@printDebate "そう……つまりあの絵は<br><link=\"Objection_90_01_01_02\">ノアさん</link>が<link=\"Objection_90_01_01_02\">死に際</link>、<br><link=\"Objection_90_01_01_02\">犯人</link>であるマーゴさんを告発した<br>メッセージだったんですよ！"

@printDebate 犯人は宝生マーゴさん！<br>あなたで決まりです！

@printDebate あら、そうだったのね。<br>知らなかったわ♪

@Gosub System/System_Subroutine.EndDebate

@print "Debug_Trial # DebateText ends." { speed:1 waitInput:true Wait:true }

@goto .JudgeDebug1-1

# Objection_90_01_01_01

@choice 戻る
	@pauseTrial false
	@Wait "{debateWaitTime}"
	@Return 

@StopForChoice 

# Objection_90_01_01_02

@choice 絵はノアの描いたものではない
	@StopVoice 
	@CancelGosub 
	@goto .JudgeDebug1-2

@choice 絵が描かれたのは死に際ではない
	@StopVoice 
	@CancelGosub 
	@goto .JudgeDebug1-3

@choice 絵は犯人を示した物ではない
	@StopVoice 
	@CancelGosub 
	@goto .JudgeDebug1-4

@choice 戻る
	@pauseTrial false
	@Wait "{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 選択肢1
# ------------------------------------------------------------------------------

# JudgeDebug1-2

@pauseTrial false

@print 不正解：JudgeDebug1-2 { speed:1 waitInput:true Wait:true }

@Stop 

#
# 選択肢2
# ------------------------------------------------------------------------------

# JudgeDebug1-3

@pauseTrial false

@print 不正解：JudgeDebug1-3 { speed:1 waitInput:true Wait:true }

@Stop 

