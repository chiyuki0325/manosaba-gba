@pauseTrial false

@print 正解：JudgeDebug1-4 { speed:1 waitInput:true Wait:true }

@Stop 

# ==============================================================================
# タイマー
# ==============================================================================

# Timer

@print "Debug_Trial # Timer" { speed:1 waitInput:true Wait:true }

# @badId 9
@timer 1
@HideUI ControlPanel
@ShowUI DebateUI

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@Wait 2

@print "Debug_Trial # Timer ends." { speed:1 waitInput:true Wait:true }

@Return
