@ProcessInput false
@trialMode false
@HideUI ControlPanel,AutoToggle,WitchBookButtonUI
@back SolidColor { time:0 }

@back 1_1 { Scale:{g_backgroundDefaultScale} time:0 }
@back Transparent { time:0.5 }

# Top

@choice "第1章 第1話"
	@goto .Act01_Chapter01

@choice "第1章 第2話"
	@goto .Act01_Chapter02

@choice "第1章 第3話"
	@goto .Act01_Chapter03

@choice "第1章 第4話"
	@goto .Act01_Chapter04

@choice "第1章 第5話"
	@goto .Act01_Chapter05

@choice "第2章 第1話"
	@goto .Act02_Chapter01

@choice "第2章 第2話"
	@goto .Act02_Chapter02

@choice "第2章 第3話"
	@goto .Act02_Chapter03

@choice "第2章 第4話"
	@goto .Act02_Chapter04

@choice "第2章 第5話"
	@goto .Act02_Chapter05

@choice "第2章 第6話"
	@goto .Act02_Chapter06

@choice 共通
	@goto .Common

@choice サウンドテスト
	@set "nextScenario=\"Debug/Debug_SoundTest\""
	@goto .GoToChosenScenario

@choice 戻る
	@goto .ReturnToTitle

@Stop 

