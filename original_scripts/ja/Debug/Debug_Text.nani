# ==============================================================================
# 選択肢
# ==============================================================================

# Choice

@ResetText 
@QuickSave 2

@print "Debug_Text # Choice" { speed:1 waitInput:true Wait:true }

@choice "選択肢 A"
	@print "選択肢 A が選ばれました。" { speed:1 waitInput:true Wait:true }
	@goto .Choice1

@choice "選択肢 B"
	@print "選択肢 B が選ばれました。" { speed:1 waitInput:true Wait:true }
	@goto .Choice1

@choice "選択肢 C"
	@print "選択肢 C が選ばれました。" { speed:1 waitInput:true Wait:true }
	@goto Act01_Chapter01/Act01_Chapter01_Bad01

@Stop 

# Choice1

@choice "選択肢 D"
	@print "選択肢 D が選ばれました。" { speed:1 waitInput:true Wait:true }
