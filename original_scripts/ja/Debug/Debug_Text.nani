@Gosub System/System_Subroutine.BeginAdv

@back SolidColor { Scale:{g_backgroundDefaultScale} time:0 }
@char Ema.Normal1 { time:0 }
@back Transparent { time:0 }

@Gosub .Text
# @gosub .TextPrinter
# @gosub .Ruby
# @gosub .Author
# @gosub .Choice

@Stop 

# ==============================================================================
# Text
# ==============================================================================

# Text

@print "Debug_Text # Text" { speed:1 waitInput:true Wait:true }

@print "大したことないよ、大丈夫！<br>ああああああああああ<color=\"orange\">ああああああああああ</color>ああああああああああ<br>隝隯霳霻靃靍靏⾭靑顗顥飯飼餧館馞驎髙髜魵魲鮏鮱鮻鰀鵰鵫鶴鸙黑" { author:Unknown speed:1 waitInput:true Wait:true }

@ifLang ja ja
	@print 日本語です。 { speed:1 waitInput:true Wait:true }
@Else 
	@print 日本語ではありません。 { speed:1 waitInput:true Wait:true }

@ifLang zh-Hans zh-Hans
	@print 簡体字ではありません。 { speed:1 waitInput:true Wait:true }
@Else 
	@print 簡体字です。 { speed:1 waitInput:true Wait:true }

@print "Debug_Text # Text ends." { speed:1 waitInput:true Wait:true }

@Return 

