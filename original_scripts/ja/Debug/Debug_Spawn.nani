@Stop 

# ==============================================================================
# 絵文字
# ==============================================================================

# Emoticon

@print "Debug_Spawn # Emoticon" { speed:1 waitInput:true Wait:true }

@spawn Question
@i 

@spawn Exclamation
@i 

@spawn Happy
@i 

@spawn Joyful
@i 

@spawn Notice
@i 

@spawn Shy
@i 

@spawn Sigh
@i 

@spawn Sweat
@i 

@spawn Troubled
@i 

@Return 

# ==============================================================================
# マット
# ==============================================================================

# Matte

@print "Debug_Spawn # Matte" { speed:1 waitInput:true Wait:true }

@ShowMattes 
@ShowMattes 
@i 

@HideMattes 
@i 

@HideMattes 
@i 

@ShowMattes 
@i 

@HideMattes 
@i 

@Return 

# ==============================================================================
# テキスト
# ==============================================================================

# Text

@back SolidColor { time:0 }
@char Ema { time:0 }

@print "Debug_Spawn # Text" { speed:1 waitInput:true Wait:true }

@spawn SpawnableText
@i 

@despawn SpawnableText
@i 

@spawn TitleCutIn
@i 

@despawn TitleCutIn
@i 

@Return 

# ==============================================================================
# バッドエンド演出
# ==============================================================================

# BadEnd

@back SolidColor { time:0 }
@char Ema { time:0 }

@print "Debug_Spawn # BadEnd" { speed:1 waitInput:true Wait:true }

@Gosub System/System_Subroutine.BadEnd

@print "Debug_Spawn # BadEnd Ends." { speed:1 waitInput:true Wait:true }

@Return 

# ==============================================================================
# VFX
# ==============================================================================

# VFX

@print "Debug_Spawn # VFX" { speed:1 waitInput:true Wait:true }

@back 2_1
@char Hanna.Default

@print エフェクトオフ { speed:1 waitInput:true Wait:true }

@HidePrinter 
@blur MainBackground
@spawn VfxSample_1

@print エフェクトオン { speed:1 waitInput:true Wait:true }

@print 「ちょっとあなた、神経どうにかしてるんじゃありません？<br>　よくスキップなんかできますわね」 { author:Hanna speed:1 waitInput:true Wait:true }

@HidePrinter 
@i 

@hideChars 
@blur MainBackground
@despawn VfxSample_1
@back 3_1
@char Ema.Fearful
@char Sherry.Default

@print エフェクトオフ { speed:1 waitInput:true Wait:true }

@HidePrinter 
@blur MainBackground
@spawn VfxSample_2

@print エフェクトオン { speed:1 waitInput:true Wait:true }

@print 「ここが獄長の言ってた懲罰房でしょうね。<br>　規則を破った囚人はここに入れられる、と」 { author:Sherry speed:1 waitInput:true Wait:true }

@HidePrinter 
@i 

@Return 

