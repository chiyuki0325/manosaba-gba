# ==============================================================================
# 証拠品
# ==============================================================================

# Clue

@print "Debug_Spawn # Clue" { speed:1 waitInput:true Wait:true }

@spawn Clue
@Wait 0.2

@print 1-13 { speed:1 waitInput:true Wait:true }

@spawn Clue
@Wait 0.2

@print 1-14 { speed:1 waitInput:true Wait:true }

@despawn Clue
@Wait 0.2

@print "Debug_Spawn # Clue end." { speed:1 waitInput:true Wait:true }

@Return 

# ==============================================================================
# CutIn
# ==============================================================================

# CutIn

@print "Debug_Spawn # CutIn" { speed:1 waitInput:true Wait:true }

@print ObjectionCutIn_Ema<br>index:0 { speed:1 waitInput:true Wait:true }

@spawn ObjectionCutIn_Ema
@despawn ObjectionCutIn_Ema

@print ObjectionCutIn_Ema<br>index:1 { speed:1 waitInput:true Wait:true }

@spawn ObjectionCutIn_Ema
@despawn ObjectionCutIn_Ema

@print ObjectionCutIn_Ema<br>index:2 { speed:1 waitInput:true Wait:true }

@spawn ObjectionCutIn_Ema
@despawn ObjectionCutIn_Ema

@print ObjectionCutIn_Hiro<br>index:0 { speed:1 waitInput:true Wait:true }

@spawn ObjectionCutIn_Hiro
@despawn ObjectionCutIn_Hiro

@print ObjectionCutIn_Hiro<br>index:1 { speed:1 waitInput:true Wait:true }

@spawn ObjectionCutIn_Hiro
@despawn ObjectionCutIn_Hiro

@print ObjectionCutIn_Hiro<br>index:2 { speed:1 waitInput:true Wait:true }

@spawn ObjectionCutIn_Hiro
@despawn ObjectionCutIn_Hiro

@print ObjectionCutIn_CreatureHiro<br>index:0 { speed:1 waitInput:true Wait:true }

@spawn ObjectionCutIn_CreatureHiro
@despawn ObjectionCutIn_CreatureHiro

@print ObjectionCutIn_CreatureHiro<br>index:1 { speed:1 waitInput:true Wait:true }

