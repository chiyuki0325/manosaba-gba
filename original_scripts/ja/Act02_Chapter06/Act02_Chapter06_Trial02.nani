@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter06/Act02_Chapter06_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 11-2: 💬 魔法少女ノ魔女裁判
# ==============================================================================
# ＠ト書き▼議論11-2魔法少女ノ魔女裁判
# 議論開始カットイン
# BGM継続：yUki

@StopBgm { fade:3 }
@Wait 3
@bgm Bgm_48_1

# Judge11-2-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Yuki.8
@gosubModifyCamera 0
@printDebate では魔女裁判を始めます。

@char Yuki.9
@gosubModifyCamera 0
@printDebate まず人間たちの行った罪から<br>説明しますね。

@char Yuki.14
@gosubModifyCamera 0
@printDebate 人間はやりすぎました。

@char Yuki.14
@gosubModifyCamera 0
@printDebate 彼らはこの世界から、<br>原初の魔女たちを<br>消し去るという<br>蛮行を行った……。

@char Yuki.15
@gosubModifyCamera 0
@printDebate "その行為は身勝手かつ残忍で、<br><link=\"Objection_02_06_02_01\">情状酌量</link>の<br>余地すらありません。"

@char Yuki.15
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_06_02_02\">万死</link>をもっても<br>償いきれるものでは<br>ないんです。"

@char Yuki.14
@gosubModifyCamera 0
@printDebate ……よって、<br>人間を被告とした<br>裁判の判決を言い渡します。

@char Yuki.10
@gosubModifyCamera 0
@printDebate 判決は――死刑。

@char Yuki.6
@gosubModifyCamera 0
@printDebate "直ちに刑を執行します。<br><link=\"Objection_02_06_02_03\">反論</link>は受け付けません。"

# ==============================================================================
# 11-1議論後独白
# ==============================================================================

@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

#
# 議論終了
# ------------------------------------------------------------------------------

@ResetText 
@char Hiro.Normal1,Arms3,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@gosubModifyCamera 0
@Wait 0.2

@print （裁判とは名ばかりの一方的な宣告だな） { author:Hiro speed:1 waitInput:true Wait:true }

@print （彼女の言葉が正しければ、<br>　このままではすぐにでも人類への粛清が始まってしまう……） { author:Hiro speed:1 waitInput:true Wait:true }

@print （どんな手段を使ってでも、止めなければ……！） { author:Hiro speed:1 waitInput:true Wait:true }

@goto .Judge11-2-1

#
# 反論1
# ------------------------------------------------------------------------------

# Objection_02_06_02_01

@Skip false
@pauseTrial true

@choice 滅ぼす理由があった
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge11-2-3


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論2
# ------------------------------------------------------------------------------

# Objection_02_06_02_02

@Skip false
@pauseTrial true

@choice 平等ではない
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge11-2-4


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

#
# 反論3
# ------------------------------------------------------------------------------

# Objection_02_06_02_03

@Skip false
@pauseTrial true

@choice 弁護をする権利がある
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge11-2-5

@choice それでは人間と同じだ
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge11-2-6

@choice 【洗脳】
	@sfx Sfx_System_SaveData_001_2x
	@StopVoice 
	@CancelGosub 
	@goto .Judge11-2-2


@choice 戻る
	@pauseTrial false
	@Wait "i{debateWaitTime}"
	@Return 

@StopForChoice 

