@gosubResetBook System/System_ResetWitchBook

@if isDebugDirectJump
	@Gosub Act02_Chapter06/Act02_Chapter06_TrialInit
	@hideStageScreen 1 { time:0 }
	@back Transparent { time:0 }

@timer 900
@HideUI ControlPanel
@ShowUI DebateUI

# ==============================================================================
# MARK: 11-8: 💬 下等種との差
# ==============================================================================
# ＠ト書き▼議論11-8下等種との差
# 議論開始カットイン

# BGM変更：AccUhEarts(Vocal有)
@bgm Bgm_15_1

# Judge11-8-1

@Gosub System/System_Subroutine.BeginDebate-First
@Gosub System/System_Subroutine.BeginDebate-Effect
@Gosub System/System_Subroutine.BeginDebate-Last
@pauseTrial false

@hideStageScreen 1

@char Yuki.17
@gosubModifyCamera 0
@printDebate ……たとえ<br>島のみんなが<br>望んでいなかったとしても。

@char Yuki.17
@gosubModifyCamera 0
@printDebate 私は私のために<br>復讐を行います。

@char Yuki.17
@gosubModifyCamera 0
@printDebate 私から全てを奪った人間は<br>滅ぼされなくては<br>いけないんです。

@char Yuki.12
@gosubModifyCamera 0
@printDebate 何者も<br>人類に責任を取らせない<br>というのであれば、<br>私が代わって<br>裁きを与えましょう。

@char Yuki.10
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_06_08_01\">人間は愚か</link>です。<br>よってだれ１人として、<br>救うべきものなどおりません。"

@char Yuki.13
@gosubModifyCamera 0
@printDebate 古い魔女たちは<br>それに気付かなかった……<br>争いをしてはいけないという<br>古のしきたりに従って、<br>滅びました。

@char Yuki.17
@gosubModifyCamera 0
@printDebate "でも<link=\"Objection_02_06_08_02\">私は違います</link>。"

@char Yuki.16
@gosubModifyCamera 0
@printDebate "<link=\"Objection_02_06_08_03\">昔からわかって</link><br>いました。<br>人間は愚かだと……<br>信じる価値などないのだと。"

@char Yuki.17
@gosubModifyCamera 0
@printDebate "古い魔女たちは<br>人間が自分たちと同じように<br>知性ある存在だと<br><link=\"Objection_02_06_08_04\">勘違いしていた</link>んです。"

@char Yuki.13
@gosubModifyCamera 0
@printDebate 私は……<br>間違っていなかった。

@char Yuki.16
@gosubModifyCamera 0
@printDebate "それを証明するためにも……<br>私は<link=\"Objection_02_06_08_05\">後には引けない</link>んです。"


@Gosub System/System_Subroutine.EndDebate-First
@pauseTrial true
@Gosub System/System_Subroutine.EndDebate-Effect
@Gosub System/System_Subroutine.EndDebate-Last

